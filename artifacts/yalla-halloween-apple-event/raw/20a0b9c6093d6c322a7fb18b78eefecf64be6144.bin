es\":{\"href\":\"/v1/catalog/us/apps/1488887716/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1488887716/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731366032244,\"MZ_INDEXER\":1731721536956}}},{\"id\":\"1544887147\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1544887147?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/101-okey-yalla-live-voice/id1544887147\",\"userRating\":{\"value\":4.8,\"ratingCount\":231,\"ratingCountList\":[5,5,2,9,210],\"ariaLabelForRatings\":\"4.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.1\",\"genreDisplayName\":\"Board\",\"name\":\"101 Okey Yalla - Live \u0026 Voice\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"You can voice chat while playing games for free in 101 Okey Yalla, gaining more fun. Only in 101 Okey Yalla can you experience the same game atmosphere as the offline game.\\n\\n1. Free 101 Okey Game\\nExperience the classic 101 Okey game for free and battle with multiple players matched in real time.\\n\\n2. Real-Time Voice Chat\\nEnjoy real-time voice chat in the game scenes perfectly imitated as the real life. Offer you an easier way to make friends from all over the world.\\n\\n3. Self-Created Room\\nInvite friends to play together or team up to win the victory. Game modes can be chosen as you like: Team, multiple rounds, etc.\\n\\n4. In-Game Interaction\\nSend funny emojis to express your complement and collect free golds given by friends\\n\\n5. Plentiful Game Modes\\nTurbo mode: Experience the excitement of multiplying bets and win more free golds\\nLeague: Defeat the opponents to show your superb skills and realize your legend dream in 101 Okey Yalla! More gameplays are waiting for you to explore!\\n\\n101 Okey Yalla team will commit to creating a supreme game and social experience for you.\\n-------------------------------------------------------------------------------------------\\nIf you choose to subscribe to 101 Okey Yalla VIP, the purchase will be billed to your iTunes account. \\nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nCurrent 101 Okey Yalla VIP subscription price starts at 7.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S., and are subject to change without notice. \\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in 101 Okey Yalla without becoming a 101 Okey Yalla VIP.\\n\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\n\\nPrivacy Policy：https://www.yallaokey101.com/term/EN/TermOfService.html#PrivacyPolicy\\n\\nTerms of Service：https://www.yallaokey101.com/term/EN/TermOfService.html#TermsOfService\\n-------------------------------------------------------------------------------------------\\nNote: 101 Okey Yalla only offers online 101 Okey games for free and does not offer any form of real-money gambling or any in-kind rewards based on the games.\\n\\nFor more information or suggestions, please join our social media communities to get the latest game news!\\nFacebook: https://www.facebook.com/yallaokey/\\nİnstagram: https://www.instagram.com/yallaokey101/?igshid=YmMyMTA2M2Y=You can voice chat while playing games for free in 101 Okey Yalla, gaining more fun. Only in 101 Okey Yalla can you experience the same game atmosphere as the offline game.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.5.0\",\"releaseNotes\":\"1. New ranking competition: more competitive ranks are waiting for you to compete.\\r\\n2. New task system: simpler tasks, richer rewards.\\r\\n3. New treasure chest system: treasure chests are opened as soon as they are obtained, and the rewards are more generous.\\r\\n4. Medal system optimization: more dazzling medals, more levels.\\r\\n5. New room PK gameplay: you can team up in the room to PK and send gifts.\\r\\n6. New types of gifts: new naming and custom gift gameplay, come and experience it.\",\"releaseDate\":\"2024-11-14\",\"releaseTimestamp\":\"2024-11-14T01:31:20Z\"},{\"versionDisplay\":\"2.4.5\",\"releaseNotes\":\"1.Bug fixes and performance improvements.\",\"releaseDate\":\"2024-10-15\",\"releaseTimestamp\":\"2024-10-15T01:57:44Z\"},{\"versionDisplay\":\"2.4.4\",\"releaseNotes\":\"1.Fixed the issue that the app cannot be opened during watermelon activities\\r\\n2.Bug fixes and performance improvements.\",\"releaseDate\":\"2024-09-26\",\"releaseTimestamp\":\"2024-09-26T01:41:44Z\"},{\"versionDisplay\":\"2.4.3\",\"releaseNotes\":\"1.Fix some voice issues\\r\\n2.Fix chat history anomalies\\r\\n3.Bug fixes and performance improvements.\\r\\n\",\"releaseDate\":\"2024-09-13\",\"releaseTimestamp\":\"2024-09-13T01:41:35Z\"},{\"versionDisplay\":\"2.4.1\",\"releaseNotes\":\"2.4.0 Version Update\\r\\n1. Royal Rights Upgrade: More royal rights are waiting for you to experience!\\r\\n2. Novice Guidance Optimization: A simpler and more detailed novice guidance allows you to quickly get started with the game!\\r\\n3. Duel Mode Optimization: More multiple duel modes.\\r\\n4. 1 To 1 Chat: Match chat, making it easier to get friends.\\r\\n5. Royal users, please go to your profile page to check the new special effects in your backpack！\",\"releaseDate\":\"2024-08-31\",\"releaseTimestamp\":\"2024-08-31T02:13:55Z\"},{\"versionDisplay\":\"2.3.0\",\"releaseNotes\":\"2.3.0 Version Update\\r\\n1. Main interface module update: New team mode added, come and experience it with your friends!\\r\\n2. Quick Start Settings: Quick Start now allows you to set up the corresponding configuration yourself.\\r\\n3. Banning penalty: New banning penalty has been added. Those who entrust and abandon red dots and wild cards during the game will be banned!\\r\\n4. Wealth level optimization: add more level privileges!\\r\\n5. Easter Egg Gifts: Giving multiple gifts has a chance to trigger the Easter Egg Gift animation.\\r\\n6. Photo Wall: The profile page of the chat room can also display the photo wall\\r\\n7. Bugs fixed and performance improved.\",\"releaseDate\":\"2024-06-27\",\"releaseTimestamp\":\"2024-06-27T03:04:45Z\"},{\"versionDisplay\":\"2.2.2\",\"releaseNotes\":\"2.2.2 Version Update\\n\\r1. Bug fixes and performance improvements.\",\"releaseDate\":\"2024-05-15\",\"releaseTimestamp\":\"2024-05-15T10:33:17Z\"},{\"versionDisplay\":\"2.2.1\",\"releaseNotes\":\"2.2.1 Version Update\\r\\n1. Optimization of the card loading operation in the game: The card loading operation of the new version of the card game has been adjusted to make card loading more convenient!\\r\\n2. Bug fixes and performance improvements.\",\"releaseDate\":\"2024-05-14\",\"releaseTimestamp\":\"2024-05-14T01:26:58Z\"},{\"versionDisplay\":\"2.2.0\",\"releaseNotes\":\"2.2.0 Version Update\\n1. New Table Layout: New version of the table layout is online, you can switch between the old and new version freely, come and experience it now!\\n2. Skin Fragment Revision: Brand new universal skin fragment synthesis is online, come and get your favorite skin!\\n3. Flying Gift Optimization: Cooler flying gift effects is online, come and experience it now! \\n4. Microphone Layout Pattern: Brand new microphone layout pattern is online, takes your experience to new heights!\\n5.Bug fixes and performance improvements.\",\"releaseDate\":\"2024-03-21\",\"releaseTimestamp\":\"2024-03-21T01:45:07Z\"},{\"versionDisplay\":\"2.1.1\",\"releaseNotes\":\"2.1.1 Version Update\\r\\n1. Chat Room Weekly Report: Push the latest data report of your chat room to you every week.\\r\\n2. Bugs fixed and performance improved.\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T06:48:58Z\"},{\"versionDisplay\":\"2.1.0\",\"releaseNotes\":\"2.1 Version Update\\r\\n1. New Card Comparison: more exciting gameplay, come and experience it now!\\r\\n2. Mall Optimization: new version of store interface, richer mall.\\r\\n3. Advertising Optimization: richer advertising rewards.\\r\\n4. Lucky gifts: Give lucky gifts and have a chance to get generous rewards.\\r\\n5. Combo optimization: Different rating effects will appear after a combo.\\r\\n6. Welcome into the room: It can quickly and friendly welcome users who enter the room.\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T01:29:44Z\"},{\"versionDisplay\":\"2.0.1\",\"releaseNotes\":\"2.0.1 Version Update：\\r\\n1. Cancel restrictions on modification of personal information.\\r\\n2.Bug fixes and performance improvements.\",\"releaseDate\":\"2023-11-14\",\"releaseTimestamp\":\"2023-11-14T01:55:06Z\"},{\"versionDisplay\":\"2.0.0\",\"releaseNotes\":\"2.0.0 Version Update：\\r\\n1. Royal Level: more noble Royal level, more rich privileges are waiting for you!\\r\\n2. Personal Profile Page Optimization: richer profile page display content.\\r\\n3. Friends System Optimization: more convenient friend system.\\r\\n4. Blacklist System: Add a blacklist function to make the game environment more comfortable.\",\"releaseDate\":\"2023-10-31\",\"releaseTimestamp\":\"2023-10-31T01:57:47Z\"},{\"versionDisplay\":\"1.14.1\",\"releaseNotes\":\"Updates:                     \\n1. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T02:39:52Z\"},{\"versionDisplay\":\"1.14.0\",\"releaseNotes\":\"Updates:\\n1. Game interface with higher quality , more enjoyable game experience！                                  \\n2. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-09-27\",\"releaseTimestamp\":\"2023-09-27T06:04:41Z\"},{\"versionDisplay\":\"1.13.4\",\"releaseNotes\":\"Updates:\\r\\nBug fixes and performance improvements.\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T01:48:41Z\"},{\"versionDisplay\":\"1.13.2\",\"releaseNotes\":\"Updates:\\r\\nBug fixes and performance improvements.\",\"releaseDate\":\"2023-08-23\",\"releaseTimestamp\":\"2023-08-23T07:41:14Z\"},{\"versionDisplay\":\"1.13.1\",\"releaseNotes\":\"Updates:\\r\\nBug fixes and performance improvements.\",\"releaseDate\":\"2023-08-15\",\"releaseTimestamp\":\"2023-08-15T02:15:53Z\"},{\"versionDisplay\":\"1.13.0\",\"releaseNotes\":\"Version Update\\r\\n1. Main Interface Optimization: a new interface, more brilliant game special effects!\\r\\n2. League Optimization: The new season can show historical leagues'  milestones, come and upgrade to a higher league~\\r\\n3. Room Optimization: More comfortable room experience, more private password room~\\r\\n4. Chat Room Return Rewards: Rich return rewards are waiting for you!\\r\\n5. Chat Room Gift Optimization: More convenient gift combos, more cool effects of flying gifts!\",\"releaseDate\":\"2023-08-08\",\"releaseTimestamp\":\"2023-08-08T14:50:58Z\"},{\"versionDisplay\":\"1.12.2\",\"releaseNotes\":\"Updates:\\r\\nBug fixes and performance improvements.\",\"releaseDate\":\"2023-06-27\",\"releaseTimestamp\":\"2023-06-27T01:52:48Z\"},{\"versionDisplay\":\"1.12.0\",\"releaseNotes\":\"Updates:\\r\\n1.Car Race: Come to an exciting car race with other players!\\r\\n2.Duello Mode: 1v1 mode, fewer cards, faster wins!\\r\\n3.Return Package: Exclusive comeback rewards and gift packages are waiting for you!\\r\\n4.Tournament Optimization: Richer tournament gameplay, you can experience the fun of competition at anytime, anywhere!\\r\\n5. Chat Room Optimization: Brand new magic cards and more smoother chat experience. Hurry up and come together!\\r\\n6. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-06-20\",\"releaseTimestamp\":\"2023-06-20T01:59:54Z\"},{\"versionDisplay\":\"1.11.0\",\"releaseNotes\":\"Updates:\\r\\n1. Badge System: Come and collect various cool badges!\\r\\n2. Okey Team Mode: Gather with your friends and enjoy the team mode!\\r\\n3. Chat Room Optimization: We added new interface and new ranking. Come and experience it now!\\r\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-04-21\",\"releaseTimestamp\":\"2023-04-21T02:00:19Z\"},{\"versionDisplay\":\"1.10.1\",\"releaseNotes\":\"101 Okey Yalla wishes you and your loved ones a happy Ramadan! \\n\\n1. To welcome and celebrate the holy month of Ramadan, we have specially updated the new time-limited lobby theme.\\n2. A variety of fun activities where you can win great prizes by logging in every day or preparing special Ramadan dishes will be online soon.\\n3. We have prepared 3 new gifts design exclusively for Ramadan and fun room parties for you to attend in chatroom. Come and join us!\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T01:40:33Z\"},{\"versionDisplay\":\"1.10.0\",\"releaseNotes\":\"Updates:\\n1. Free Game Mode: don't worry for the coins, earn your rewards in the Free Game Mode!\\n2. Tournament: Compete with other players in the tournament and win the first place！\\n3. Member Group: join a group in Chat Room, exclusive badges and emojis are waiting for you!\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T02:45:21Z\"},{\"versionDisplay\":\"1.9.1\",\"releaseNotes\":\"Updates:\\n1. Optimized voice chat experience;\\n2. Added gift in Chat room;            \\n3. Bug fixes and performance improvements; \\nPray for Turkey! \",\"releaseDate\":\"2023-02-09\",\"releaseTimestamp\":\"2023-02-09T02:58:03Z\"}],\"websiteUrl\":\"https://www.yallaokey101.com/\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"editorialNotes\":{\"tagline\":\"Challenge your friends!\"},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1544887147\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=870381719\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":284413952}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1544887147\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=870381719\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":284413952}]}],\"requires32bit\":false,\"releaseDate\":\"2021-02-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.okey101yalla\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1