87776,\"iPad6,8\":339787776,\"iPad13,8\":328523776,\"iPad13,9\":328523776,\"iPad13,4\":328523776,\"iPad13,5\":328523776,\"iPad13,6\":328523776,\"iPad13,7\":328523776,\"iPad13,1\":328523776,\"iPad13,2\":328523776}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/us/apps/1317217120/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1317217120/developer?l=en-US\",\"data\":[{\"id\":\"1519958784\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1519958784?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Star Chat International Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/star-chat-international-limited/id1519958784\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731372494808,\"MZ_INDEXER\":1731695758598}}},{\"id\":\"1519557264\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1519557264?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/hawa-group-voice-chat-rooms/id1519557264\",\"userRating\":{\"value\":3.7,\"ratingCount\":70,\"ratingCountList\":[17,3,3,5,42],\"ariaLabelForRatings\":\"3.7 stars\"},\"genreDisplayName\":\"Entertainment\",\"name\":\"Hawa - Group Voice Chat Rooms\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Hawa Technology Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"hawa, come for love, meet by sound\\n\\nHawa offers a social space that focuses on sound, where you can not only get rid of the social pressure in reality, but also quickly meet new friends from various regions in the Middle East. Without social labels, use voice and thought to collide with strange souls to obtain purer friendship or love.\\n\\nIn Hawa, explore new worlds, explore love.\\n\\n【Make new friend】\\nCome to hawa to explore different themed voice rooms, use your voice to show your talent and personality, and meet people who understand you anytime, anywhere!\\n\\nNo need to show your face without social pressure, express yourself as much as you want and talk about topics you are interested in, such as food, sports events, fashion trends, etc. A variety of themes to meet all your preferences!\\n\\n【Fun Game】\\nHost an online party with new friends from all over the Middle East, and a large number of trendy room games will help you quickly break the ice and become the most popular party king!\\n\\n【special gift】\\nHawa, you can get customized gifts, luxury cars and gorgeous headwear. Come and light up your unique gift catalogue!\\n\\n【Ranking】\\nExclusive medals and privileges to show your status and position.\\n\\nMusic\\nListen to your favorite keep up with the world music trends. Share your song list, show your voice live!, this is your exclusive music party.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.37.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-12-03\",\"releaseTimestamp\":\"2024-12-03T06:20:06Z\"},{\"versionDisplay\":\"1.36.3\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-11-18\",\"releaseTimestamp\":\"2024-11-18T01:50:52Z\"},{\"versionDisplay\":\"1.36.2\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-11-04\",\"releaseTimestamp\":\"2024-11-04T13:47:05Z\"},{\"versionDisplay\":\"1.36.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-11-02\",\"releaseTimestamp\":\"2024-11-02T09:29:12Z\"},{\"versionDisplay\":\"1.36.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-10-31\",\"releaseTimestamp\":\"2024-10-31T08:41:33Z\"},{\"versionDisplay\":\"1.35.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-10-15\",\"releaseTimestamp\":\"2024-10-15T01:51:33Z\"},{\"versionDisplay\":\"1.34.0\",\"releaseNotes\":\"【1.34.0 Version Update Information】\\n1. We listened to your feedback and optimized the room list to give you a better experience.\\n2. In order to allow new friends to integrate into our big family faster, we have specially prepared a welcome party, and welcome new and old users to participate.\\n3. We have optimized the music player to ensure that you can easily control the music and enjoy a better party experience.\",\"releaseDate\":\"2024-09-18\",\"releaseTimestamp\":\"2024-09-18T02:02:27Z\"},{\"versionDisplay\":\"1.33.0\",\"releaseNotes\":\"【1.33.0 version Update Information 】\\nOld friends recall open, hand in hand to win the prize!\\nMedal system upgraded, five MEDALS waiting for you to conquer!\",\"releaseDate\":\"2024-09-01\",\"releaseTimestamp\":\"2024-09-01T10:29:58Z\"},{\"versionDisplay\":\"1.32.4\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-08-23\",\"releaseTimestamp\":\"2024-08-23T01:09:56Z\"},{\"versionDisplay\":\"1.32.3\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-08-20\",\"releaseTimestamp\":\"2024-08-20T01:18:21Z\"},{\"versionDisplay\":\"1.32.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-08-08\",\"releaseTimestamp\":\"2024-08-08T12:44:58Z\"},{\"versionDisplay\":\"1.32.0\",\"releaseNotes\":\"[1.32.0 version update information]\\n1. The new noble system brings you new rights and interests!\\n2. Guild invitations are upgraded to help you expand your guild!\\n3. UI and performance optimization to enhance your experience in Hawa!\",\"releaseDate\":\"2024-08-02\",\"releaseTimestamp\":\"2024-08-02T12:15:10Z\"},{\"versionDisplay\":\"1.31.4\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-07-22\",\"releaseTimestamp\":\"2024-07-22T02:28:56Z\"},{\"versionDisplay\":\"1.31.3\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-07-15\",\"releaseTimestamp\":\"2024-07-15T01:25:59Z\"},{\"versionDisplay\":\"1.31.2\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-07-05\",\"releaseTimestamp\":\"2024-07-05T01:48:34Z\"},{\"versionDisplay\":\"1.31.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-07-01\",\"releaseTimestamp\":\"2024-07-01T13:52:27Z\"},{\"versionDisplay\":\"1.31.0\",\"releaseNotes\":\"[1.31.0 version update information]\\n1. Room gift bar completely upgraded\\n2. Popular recommendations added to the home page\\n3. Fix known bugs\",\"releaseDate\":\"2024-06-30\",\"releaseTimestamp\":\"2024-06-30T05:52:36Z\"},{\"versionDisplay\":\"1.30.3\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-06-26\",\"releaseTimestamp\":\"2024-06-26T14:22:30Z\"},{\"versionDisplay\":\"1.30.2\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2024-06-23\",\"releaseTimestamp\":\"2024-06-23T07:45:34Z\"},{\"versionDisplay\":\"1.30.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you tu