fffff\",\"textColor2\":\"fcbc2b\",\"textColor3\":\"dcd5dd\",\"textColor4\":\"da9f34\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/b1/f9/92/b1f992f7-1528-9aab-8429-1342a2920c2b/e18106de-ca20-4237-b400-f83778001da5__U5b9d_U7bb1.png/{w}x{h}{c}.{f}\",\"bgColor\":\"52315b\",\"textColor1\":\"fabe29\",\"textColor2\":\"ca96e6\",\"textColor3\":\"d8a133\",\"textColor4\":\"b282ca\"}],\"ipadPro\":[{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/2d/2f/1e/2d2f1ea4-a74c-cc57-6adf-0f37515055b1/3cd87206-f76a-47fe-b599-93462628dd8b__U6e38_U620f_U5185.png/{w}x{h}{c}.{f}\",\"bgColor\":\"481c3a\",\"textColor1\":\"ffffff\",\"textColor2\":\"fcb52e\",\"textColor3\":\"dad1d7\",\"textColor4\":\"d89731\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/8c/6b/fa/8c6bfa36-f3ca-521c-fae7-1b9d5343a13a/9abc05a8-9a34-43e3-ad52-69e4dfa2fc15__U8bed_U97f3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"481c3a\",\"textColor1\":\"ffffff\",\"textColor2\":\"fcb52e\",\"textColor3\":\"dad1d7\",\"textColor4\":\"d89731\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/c2/32/ef/c232ef42-30fb-047e-92bd-c0a0bef4f680/7363e640-0dec-4610-bd56-98b80c61a647__U804a_U5929_U5ba4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"481c3a\",\"textColor1\":\"ffffff\",\"textColor2\":\"fcb52e\",\"textColor3\":\"dad1d7\",\"textColor4\":\"d89731\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/45/6d/b4/456db470-c5e9-f38f-fb16-762c64b6a3df/14cc06fe-9c27-4ae3-a8ca-84855d69b64d__U597d_U53cb.png/{w}x{h}{c}.{f}\",\"bgColor\":\"491c4a\",\"textColor1\":\"fcb52e\",\"textColor2\":\"df7d03\",\"textColor3\":\"d89734\",\"textColor4\":\"c16a11\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/f2/1d/4c/f21d4c1a-2d22-69b6-3dc6-cb67da5a9669/63d6ce01-914d-4ede-8bfd-7e3ca4cfbf3f__U7