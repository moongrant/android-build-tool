"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1519557264/developer?l=en-US\",\"data\":[{\"id\":\"1516091259\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1516091259?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Hawa Technology Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/hawa-technology-limited/id1516091259\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1733168699352,\"MZ_INDEXER\":1733206945304}}},{\"id\":\"1526086695\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1526086695?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Infrequent/Mild Sexual Content and Nudity\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humor\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/hiya-group-voice-chatroom/id1526086695\",\"userRating\":{\"value\":4.4,\"ratingCount\":1467,\"ratingCountList\":[122,49,87,123,1086],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.3\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Hiya - Group Voice Chatroom\",\"isPreorder\":false,\"artistName\":\"FUNI.PTE.LTD.\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Hiya is a fantastic voice chat app. You can share your life with people all over the world, talk freely to your friends, and enjoy an online party anytime and anywhere. Exciting in-app features are provided to enrich your experience. \\n\\nVoice Chat Room \\nJoin a group chat room and enjoy your live party with friends.  Hiya is an amazing app to let you talk to interesting people easily. Whatever you are passionate about, we have a chat room for you.\\n\\nGame Center\\nPlay games together in a chat group. With awesome leisure games, you will never get bored.\\n\\nVoice Match \\nCreate your own voice profile and find your perfect voice. \\n\\nRespectful Community\\nIn our community which is based on mutual respect among users, you can spend an enjoyable and relaxing time here.\\n\\nFast And Easy Login\\nHiya supports login with your Facebook, Google accounts or your phone number.\\n\\nGet ready to have an amazing voice chat with your friends.\\nIf you have any feedback or questions, please contact: support@mehiya.com\\nFeel free to leave any comments.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay