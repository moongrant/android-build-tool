er\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\",\"Unrestricted Web Access\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/bobo-group-voice-chat-rooms/id1489566586\",\"userRating\":{\"value\":3.9,\"ratingCount\":138,\"ratingCountList\":[24,9,5,17,83],\"ariaLabelForRatings\":\"3.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"BoBo - Group Voice Chat Rooms\",\"isPreorder\":false,\"artistName\":\"思伟 邹\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"BoBo is a global free voice chat app that supports Group voice chat rooms, you can chat and play games with your friends, even share your voice to make new friends.\\nDownload BoBo App and join the most interesting social party!\\n \\nWhy BoBo is the best social app for you?\\n \\nFree voice chat\\nYou can voice chat at any time, anywhere with a mobile data or WIFI, with us, you can meet the one you like.\\n \\nVoice chat rooms\\nChat with new friends all over the world.\\nJoin the most interesting magic social community in the world. Here you can introduce yourself to everyone, singing and sharing your interesting daily, and also make new friends all over the world.\\n \\nVirtual gifts\\nIf you meet someone but you don't know how to express your feelings? Just send a small gift to let him/her notice you.\\n \\nInteresting chat journey\\nBoBo has more than 6 types of rooms, you can find whatever you need\\nEmotional radio station: let you have a friend who will listen to you on the Internet and share your happiness; you will also meet new friends who have common interests with you here.\\nGame/Task room: let you relax and have fun with online games and some interesting task.\\nStill, there are other interesting chat rooms waiting for you to experience.\\n \\nBoBo requests the following permissions:\\nMicrophone: Delivering sound during live broadcast\\nCamera: Take photos and videos\\nAuthorization Request: BoBo needs your permission to obtain storage space that helps you to get a better experience and ensure the normal use of the app\\n \\nCome to join our big family and follow us to get the latest news, updates and also activity in the application. We Appreciate your support, And we will continue to improve and update BoBo to give you the best experience.\\nEmail: dev@chucp.mobi\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"4.12.0\",\"releaseNotes\":\"1. Video chat function launched, chat with friends\\n2. Interesting games updated, come and join us\",\"releaseDate\":\"2024-11-19\",\"releaseTimestamp\":\"2024-11-19T01:36:11Z\"},{\"versionDisplay\":\"4.11.0\",\"releaseNotes\":\"1. New more amazing gift bar effect Available now\\n2. Rare gifts are online, let's try it together\",\"releaseDate\":\"2024-10-24\",\"releaseTimestamp\":\"2024-10-24T01:42:45Z\"},{\"versionDisplay\":\"4.10.3\",\"releaseNotes\":\"1. Optimized the family function, let's play family PK together\\n2. The member points mall is online, and member points can be directly exchanged for goods\",\"releaseDate\":\"2024-10-16\",\"releaseTimestamp\":\"2024-10-16T09:56:16Z\"},{\"versionDisplay\":\"4.10.2\",\"releaseNotes\":\"1. Optimized the family function, let's play family PK together\\n2. The member points mall is online, and member points can be directly exchanged for goods\",\"releaseDate\":\"2024-10-11\",\"releaseTimestamp\":\"2024-10-11T01:44:16Z\"},{\"versionDisplay\":\"4.10.1\",\"releaseNotes\":\"1. Party room is now available, 16 people can get on the mic and party together.\\n2. More gift effects, invite your friends to play together.\",\"releaseDate\":\"2024-09-23\",\"releaseTimestamp\":\"2024-09-23T01:11:07Z\"},{\"versionDisplay\":\"4.10.0\",\"releaseNotes\":\"1. Party room is now available, 16 people can get on the mic and party together.\\n2. More gift effects, invite your friends to play together.\",\"releaseDate\":\"2024-09-17\",\"releaseTimestamp\":\"2024-09-17T12:58:36Z\"},{\"versionDisplay\":\"4.9.1\",\"releaseNotes\":\"1. Party room is now available, 16 people can get on the mic and party together.\\n2. More gift effects, invite your friends to play together.\",\"releaseDate\":\"2024-08-29\",\"releaseTimestamp\":\"2024-08-29T02:11:59Z\"},{\"versionDisplay\":\"4.9.0\",\"releaseNotes\":\"1. Party room is now available, 16 people can get on the mic and party together.\\n2. More gift effects, invite your friends to play together.\",\"releaseDate\":\"2024-08-27\",\"releaseTimestamp\":\"2024-08-27T10:20:01Z\"},{\"versionDisplay\":\"4.8.5\",\"releaseNotes\":\"The new version has been updated\\n1. A beautiful room for two people is now available, let's have love and good time together.\\n2. The room game-custom turntable and gift turntable are online. Call your friends to play\\n3. The new gift box is online. It is cooler to give gifts. It contains rare gifts\",\"releaseDate\":\"2024-08-20\",\"releaseTimestamp\":\"2024-08-20T01:29:37Z\"},{\"versionDisplay\":\"4.8.2\",\"releaseNotes\":\"The new version has been updated\\n1. A beautiful room for two people is now available, let's have love and good time together.\\n2. The room game-custom turntable and gift turntable are online. Call your friends to play\\n3. The new gift box is online. It is cooler to give gifts. It contains rare gifts\",\"releaseDate\":\"2024-08-03\",\"releaseTimestamp\":\"2024-08-03T14:56:37Z\"},{\"versionDisplay\":\"4.8.1\",\"releaseNotes\":\"The new version has been updated\\n1. A beautiful room for two people is now available, let's have love and good time together.\\n2. The room game-custom turntable and gift turntable are online. Call your friends to play\\n3. The new gift box is online. It is cooler to give gifts. It contains rare gifts\",\"releaseDate\":\"2024-07-31\",\"releaseTimestamp\":\"2024-07-31T01:46:35Z\"},{\"versionDisplay\":\"4.8.0\",\"releaseNotes\":\"The new version has been updated\\n1. A beautiful room for two people is now available, let's have love and good time together.\\n2. The room game-custom turntable and gift turntable are online. Call your friends to play\\n3. The new gift box is online. It is cooler to give gifts. It contains rare gifts\",\"releaseDate\":\"2024-07-22\",\"releaseTimestamp\":\"2024-07-22T06:08:24Z\"},{\"versionDisplay\":\"4.7.1\",\"releaseNotes\":\"1. The profil page has been improved, more cool, and editing the profile become more convenient~\\n2. BOBO events section has been added , activity notifications will be better!\\n3. Added the feature of inviting friends through the invitation code, which makes inviting friends even easier!\",\"releaseDate\":\"2024-07-04\",\"releaseTimestamp\":\"2024-07-04T08:45:40Z\"},{\"versionDisplay\":\"4.7.0\",\"releaseNotes\":\"1. The profil page has been improved, more cool, and editing the profile become more convenient~\\n2. BOBO events section has been added , activity notifications will be better!\\n3. Added the feature of inviting friends through the invitation code, which makes inviting friends even easier!\",\"releaseDate\":\"2024-07-02\",\"releaseTimestamp\":\"2024-07-02T09:42:33Z\"},{\"versionDisplay\":\"4.6.2\",\"releaseNotes\":\"1. New Eid al-Adha event\\n2. Fixed some bugs\",\"releaseDate\":\"2024-06-27\",\"releaseTimestamp\":\"2024-06-27T01:30:33Z\"},{\"versionDisplay\":\"4.6.1\",\"releaseNotes\":\"1. New Eid al-Adha event\\n2. Fixed some bugs\",\"releaseDate\":\"2024-06-18\",\"releaseTimestamp\":\"2024-06-18T06:51:21Z\"},{\"versionDisplay\":\"4.6.0\",\"releaseNotes\":\"1. New Eid al-Adha event\\n2. Fixed some bugs\",\"releaseDate\":\"2024-06-11\",\"releaseTimestamp\":\"2024-06-11T02:11:36Z\"},{\"versionDisplay\":\"4.5.1\",\"releaseNotes\":\"1. There are also a series of small updates\",\"releaseDate\":\"2024-05-25\",\"releaseTimestamp\":\"2024-05-25T00:47:11Z\"},{\"versionDisplay\":\"4.5.0\",\"releaseNotes\":\"1. There are also a series of small updates\",\"releaseDate\":\"2024-05-24\",\"releaseTimestamp\":\"2024-05-24T04:27:49Z\"},{\"versionDisplay\":\"4.4.0\",\"releaseNotes\":\"1. Added the function of binding WhatsApp and upgraded the account security\\n2. A new game, Knife Challenge, is added. Come and play with your friends.\\n3. There are also a series of small updates\",\"releaseDate\":\"2024-04-21\",\"releaseTimestamp\":\"2024-04-21T01:35:16Z\"},{\"versionDisplay\":\"4.3.1\",\"releaseNotes\":\"1. The lucky pack function has been greatly upgraded, not only can you send coins, but also gifts!\\n2. Newly added room sound effect function, go and give it a try!\\n3. Optimization of basic functions in the room for more convenient.\\n4. There are also a series of small updates.\",\"releaseDate\":\"2024-04-12\",\"releaseTimestamp\":\"2024-04-12T02:21:05Z\"},{\"versionDisplay\":\"4.3.0\",\"releaseNotes\":\"1. The lucky pack function has been greatly upgraded, not only can you send coins, but also gifts!\\n2. Newly added room sound effect function, go and give it a try!\\n3. Optimization of basic functions in the room for more convenient.\\n4. There are also a series of small updates.\",\"releaseDate\":\"2024-04-08\",\"releaseTimestamp\":\"2024-04-08T01:24:37Z\"},{\"versionDisplay\":\"4.2.0\",\"releaseNotes\":\"1. The Agency has been upgraded, making management more convenient~\\n2. Small upgrade of profile page, come and take a look !\\n3. There are also a series of small improvements.\",\"releaseDate\":\"2024-03-20\",\"releaseTimestamp\":\"2024-03-20T01:45:21Z\"},{\"versionDisplay\":\"4.1.1\",\"releaseNotes\":\"1. The glory wall of Agency and Hosts now online, come and compete to be on the list!\\n2. The return gift function has been updated, making returning gifts more convenient!\\n3. There are also a series of small improvements.\",\"releaseDate\":\"2024-02-28\",\"releaseTimestamp\":\"2024-02-28T04:20:01Z\"},{\"versionDisplay\":\"4.1.0\",\"releaseNotes\":\"1. The glory wall of Agency and Hosts now online, come and compete to be on the list!\\n2. The return gift function has been updated, making returning gifts more convenient!\\n3. There are also a series of small improvements.\",\"releaseDate\":\"2024-02-26\",\"releaseTimestamp\":\"2024-02-26T01:51:25Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1489566586\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=870419520\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":288845824}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1489566586\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=870419520\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":288845824}]}],\"requires32bit\":false,\"releaseDate\":\"2019-12-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.duidui.meetyo\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple2