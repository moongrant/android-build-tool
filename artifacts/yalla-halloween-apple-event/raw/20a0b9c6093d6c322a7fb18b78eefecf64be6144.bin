utes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1489566586/developer?l=en-US\",\"data\":[{\"id\":\"1242210509\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1242210509?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"思伟 邹\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/%E6%80%9D%E4%BC%9F-%E9%82%B9/id1242210509\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731934972508,\"MZ_INDEXER\":1733327286371}}},{\"id\":\"1581403512\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1581403512?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Sexual Content and Nudity\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humor\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/honey-jar-chat/id1581403512\",\"userRating\":{\"value\":3.5,\"ratingCount\":34,\"ratingCountList\":[11,1,1,3,18],\"ariaLabelForRatings\":\"3.5 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.9\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Honey Jar Chat\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"BIG GAME HUNTERS LIMITED\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"  عبارة عن تطبيق للدرشة الصوتية،  Honey Jar   يمكنك التواصل مع أصدقائك من مختلف انحاء العالم، كل ما عليك فعله  ، تحميل تطبيق Honey Jar\\n\\n\\n**غرفة الدردشة الصوتية**\\n  تعرف على اشخاص واستمع لأصوات جميلة من مختلف انحاء العالم، تواصل وتفاعل مع الأصدقاء\\nاحتفل في اي وقت واي مكان مع معجبيك و اصدقائك\\nتابع غرف الدردشة المفضلة لك و شارك في الدردشة\\n\\n**مجتمع محب ومحافظ**\\n تم  بناء هذا التطبيق بحب وشغف  ، جميع الخصائص في التطبيق مصممة لكي تناسبك  ونحن نسعى كل  جهدنا لكي نجعله مجتمع امن ومحافظ\\nلضمان المحافظة على مجتمع حضاري على الجميع احترام وقوانين  ولوائح التطبيق\\n التطبيق  مجاني هيا قم بنتزيل وتحميل التطبيق لاكتشاف جميع الخصائص المميزة ، يمكنك ايضا الانضمام الى الأعضاء الحصريين و الاستمتاع بمميزات النبلاء والحصول على العديد من الهدايا\\n\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.38.2\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-11-20\",\"releaseTimestamp\":\"2024-11-20T05:41:49Z\"},{\"versionDisplay\":\"1.38.1\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-11-15\",\"releaseTimestamp\":\"2024-11-15T05:24:18Z\"},{\"versionDisplay\":\"1.38.0\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-11-04\",\"releaseTimestamp\":\"2024-11-04T05:32:00Z\"},{\"versionDisplay\":\"1.37.0\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-09-26\",\"releaseTimestamp\":\"2024-09-26T23:51:43Z\"},{\"versionDisplay\":\"1.36.4\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-09-06\",\"releaseTimestamp\":\"2024-09-06T16:26:21Z\"},{\"versionDisplay\":\"1.36.3\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-08-24\",\"releaseTimestamp\":\"2024-08-24T05:55:58Z\"},{\"versionDisplay\":\"1.36.2\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-08-09\",\"releaseTimestamp\":\"2024-08-09T04:51:38Z\"},{\"versionDisplay\":\"1.36.1\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-08-06\",\"releaseTimestamp\":\"2024-08-06T06:17:33Z\"},{\"versionDisplay\":\"1.36.0\",\"releaseNotes\":\"1.تم تحديث ألعاب الغرفة بالكامل لتجربة لعب أكثر غمرًا وروعة.\\n2.تم تعديل وإصلاح المشاكل السابقة\\n3.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-07-26\",\"releaseTimestamp\":\"2024-07-26T05:31:43Z\"},{\"versionDisplay\":\"1.35.3\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-06-26\",\"releaseTimestamp\":\"2024-06-26T04:46:58Z\"},{\"versionDisplay\":\"1.35.2\",\"releaseNotes\":\"1. قم بالتحديث إلى أحدث إصدار لتجربة خدمة اجتماعية محسنة.\\n2.تم تعديل وإصلاح المشاكل السابقة\",\"releaseDate\":\"2024-06-12\",\"releaseTimestamp\":\"2024-06-12T04:32:10Z\"},{\"versionDisplay\":\"1.35.1\",\"releaseNotes\":\"1. قم بالتحديث إلى أحدث إصدار لتجربة خدمة اجتماعية محسنة.\\n2.تم تعديل وإصلاح المشاكل السابقة\",\"releaseDate\":\"2024-05-15\",\"releaseTimestamp\":\"2024-05-15T04:28:25Z\"},{\"versionDisplay\":\"1.35.0\",\"releaseNotes\":\"1. اربط بريدك الإلكتروني لتجربة تسجيل دخول أسهل\\n2. المفضلة لديك متاحة الآن، تابع أحدث الأخبار لأصدقائك في أي وقت\\n3. قم بالتحديث إلى أحدث إصدار لتجربة خدمة اجتماعية محسنة.\",\"releaseDate\":\"2024-05-13\",\"releaseTimestamp\":\"2024-05-13T04:29:07Z\"},{\"versionDisplay\":\"1.34.3\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-04-17\",\"releaseTimestamp\":\"2024-04-17T04:22:23Z\"},{\"versionDisplay\":\"1.34.2\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-04-16\",\"releaseTimestamp\":\"2024-04-16T04:10:14Z\"},{\"versionDisplay\":\"1.34.1\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T10:49:56Z\"},{\"versionDisplay\":\"1.34.0\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2024-03-06\",\"releaseTimestamp\":\"2024-03-06T02:41:28Z\"},{\"versionDisplay\":\"1.33.0\",\"releaseNotes\":\"1. ترقية شاملة لمستوى الثروة، بما في ذلك الامتيازات مثل ألوان اسم المستخدم، لتجربة فريدة وفخمة بالكامل\\n2. قم بالتحديث إلى أحدث إصدار لتجربة خدمة اجتماعية محسنة.\",\"releaseDate\":\"2024-01-29\",\"releaseTimestamp\":\"2024-01-29T03:59:41Z\"},{\"versionDisplay\":\"1.32.0\",\"releaseNotes\":\"1. انطلق في فتح الحالة الرفيعة VIP6 عبر الإنترنت، واستمتع بالعديد من الامتيازات الحصرية مثل مقعد السوبر ميكروفون، وانغمس في تجربة فريدة وفاخرة.\\n2. قم بالتحديث إلى أحدث إصدار لتجربة خدمة اجتماعية محسنة.\",\"releaseDate\":\"2023-12-06\",\"releaseTimestamp\":\"2023-12-06T09:19:19Z\"},{\"versionDisplay\":\"1.31.3\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2023-11-12\",\"releaseTimestamp\":\"2023-11-12T08:21:00Z\"},{\"versionDisplay\":\"1.31.2\",\"releaseNotes\":\"1.تم تعديل وإصلاح المشاكل السابقة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T03:37:17Z\"},{\"versionDisplay\":\"1.31.1\",\"releaseNotes\":\"1.تقديم ميزة تصفية غرف الدردشة لسهولة الوصول إلى المحتوى المفضل لديك.\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T08:27:20Z\"},{\"versionDisplay\":\"1.31.0\",\"releaseNotes\":\"1.  تم إضافة العاب جديدة داخل غرفة الدردشة، الان قم بتحميل الاصدار الجديد لكي تستمتع وتشارك في اللعبة\\n2.الرجاء تحميل اخر اصدار للتطبيق للحصول على تجربة افضل\",\"releaseDate\":\"2023-09-28\",\"releaseTimestamp\":\"2023-09-28T06:06:59Z\"},{\"versionDisplay\":\"1.30.1\",\"releaseNotes\":\"1.تم تعديل وإصلاح ا