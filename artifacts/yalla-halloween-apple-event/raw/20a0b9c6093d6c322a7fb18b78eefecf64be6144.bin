,\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/us/apps/1560121894/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1560121894/developer?l=en-US\",\"data\":[{\"id\":\"1560122166\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1560122166?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/shenzhen-yinguo-network-technology-co-ltd/id1560122166\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1733330862449,\"MZ_INDEXER\":1733330239516}}},{\"id\":\"1317217120\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1317217120?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/starchat-group-voice-chat-room/id1317217120\",\"userRating\":{\"value\":4.1,\"ratingCount\":861,\"ratingCountList\":[140,18,46,44,613],\"ariaLabelForRatings\":\"4.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"name\":\"StarChat-Group Voice Chat Room\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Star Chat International Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nStarChat provides a variety of in-app purchases and subscriptions.If you choose to purchase an StarChat subscription,payment will be charged to your iTunes account after purchase confirmation.Your account will be charged the subscription amount within 24-hours prior to the end of the currnent period unless auto-renewal is turned off.Auto-renewal may be turned off at any time by going to your settings in the iTunes Store after purchase.\\n\\nPrivacy Policy：https://www.starchat.live/help/policy/Privacy_Policy.html\\nTerms of Service：https://www.starchat.live/help/policy/Terms_of_Service.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.16\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-11-07\",\"releaseTimestamp\":\"2024-11-07T11:57:51Z\"},{\"versionDisplay\":\"8.15\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-10-30\",\"releaseTimestamp\":\"2024-10-30T09:03:23Z\"},{\"versionDisplay\":\"8.14.2\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-10-16\",\"releaseTimestamp\":\"2024-10-16T22:59:26Z\"},{\"versionDisplay\":\"8.14\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-09-30\",\"releaseTimestamp\":\"2024-09-30T13:45:45Z\"},{\"versionDisplay\":\"8.13\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T09:08:41Z\"},{\"versionDisplay\":\"8.12\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-09-05\",\"releaseTimestamp\":\"2024-09-05T11:16:19Z\"},{\"versionDisplay\":\"8.11\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-09-03\",\"releaseTimestamp\":\"2024-09-03T15:03:37Z\"},{\"versionDisplay\":\"8.10.0\",\"releaseNotes\":\"1. Add Superlike feature\\n2. Fix several bugs\\n\",\"releaseDate\":\"2024-08-23\",\"releaseTimestamp\":\"2024-08-23T00:35:46Z\"},{\"versionDisplay\":\"8.9.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-08-02\",\"releaseTimestamp\":\"2024-08-02T22:47:59Z\"},{\"versionDisplay\":\"8.8.0\",\"releaseNotes\":\"Add the feature of watching YouTube videos together in the room.\",\"releaseDate\":\"2024-07-19\",\"releaseTimestamp\":\"2024-07-19T20:24:52Z\"},{\"versionDisplay\":\"8.7.0\",\"releaseNotes\":\"1、Reorganized the features structure to make it more user-friendly.\\n2、Optimized UI.\\n3、Bugs fixed.\",\"releaseDate\":\"2024-07-05\",\"releaseTimestamp\":\"2024-07-05T22:09:19Z\"},{\"versionDisplay\":\"8.6.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-07-02\",\"releaseTimestamp\":\"2024-07-02T22:21:47Z\"},{\"versionDisplay\":\"8.4.3\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-06-11\",\"releaseTimestamp\":\"2024-06-11T21:50:58Z\"},{\"versionDisplay\":\"8.4.2\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-06-11\",\"releaseTimestamp\":\"2024-06-11T02:43:38Z\"},{\"versionDisplay\":\"8.4.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-05-30\",\"releaseTimestamp\":\"2024-05-30T15:11:42Z\"},{\"versionDisplay\":\"8.4.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-05-29\",\"releaseTimestamp\":\"2024-05-29T05:40:46Z\"},{\"versionDisplay\":\"8.3.0\",\"releaseNotes\":\"1. Fix several bugs\\n\",\"releaseDate\":\"2024-05-14\",\"releaseTimestamp\":\"2024-05-14T11:42:57Z\"},{\"versionDisplay\":\"8.2.0\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T22:11:33Z\"},{\"versionDisplay\":\"8.1.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-04-17\",\"releaseTimestamp\":\"2024-04-17T13:08:59Z\"},{\"versionDisplay\":\"8.1.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-04-16\",\"releaseTimestamp\":\"2024-04-16T18:33:44Z\"},{\"versionDisplay\":\"8.0.1\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2024-04-05\",\"releaseTimestamp\":\"2024-04-05T19:01:02Z\"},{\"versionDisplay\":\"8.0.0\",\"releaseNotes\":\"1、New UI, New experience. We have redesigned a new UI that will impress you more than ever!\\n2、Support using WhatsApp to receive verification code，Solve some user feedback issues of not receiving verification code.\",\"releaseDate\":\"2024-04-04\",\"releaseTimestamp\":\"2024-04-04T11:48:29Z\"},{\"versionDisplay\":\"7.11.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-03-20\",\"releaseTimestamp\":\"2024-03-20T19:45:47Z\"},{\"versionDisplay\":\"7.11.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-03-14\",\"releaseTimestamp\":\"2024-03-14T19:45:12Z\"},{\"versionDisplay\":\"7.10.