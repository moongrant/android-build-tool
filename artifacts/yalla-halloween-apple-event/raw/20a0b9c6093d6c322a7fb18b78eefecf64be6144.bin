d-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1733376926281,\"d\":[{\"id\":\"1091902866\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1091902866?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Profanity or Crude Humor\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/yalla-group-voice-chat-rooms/id1091902866\",\"userRating\":{\"value\":4.2,\"ratingCount\":7677,\"ratingCountList\":[1019,256,309,551,5542],\"ariaLabelForRatings\":\"4.2 stars\"},\"usesLocationBackgroundMode\":false,\"firstVersionSupportingInAppPurchaseApi\":\"2.4.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Yalla - Group Voice Chat Rooms\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":true,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"sellerLabel\":\"Seller\",\"hasEula\":true,\"platformAttributes\":{\"ios\":{\"seller\":\"Yalla Technology FZ-LLC\",\"copyright\":\"© 2024 Yalla Technology FZ-LLC\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla is the most popular Live Group Voice Talking and Entertaining Community. Voice Chat and play games with people from nearby or all over the world.\\n\\nMeet new friends is never easier:\\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries has already been covered, while tons of topics are available to choose.\\n\\nParty with friends with no distances:\\nGroup voice talk with friends no matter where they are, broadcast your favorite musics inside the room, sing karaokes together, and play a range of games directly in group chat. Let's get the party started.\\n\\nFEATURES:\\n\\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE or Wi-Fi.\\n\\nPUBLIC CHAT ROOMS — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \\n\\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\\n\\nCHAT GAMES — Play games together directly in your chat group!\\n\\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\\n\\nSHARE and FOLLOW — Share your favorite ROOMS on Facebook, Twitter, Instagram, Snapchat and more, inviting friends and new followers.\\n\\nFollow us to get the latest news, updates and events:\\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\\nWebsite: www.yalla.live\\n\\nDear YALLA users, your feedback and suggestions are welcomed to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"is32bitOnly\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.29.0\",\"releaseNotes\":\"1. تمت إضافة ميزة موضوع المايك - زين غرفتك بموضوعات مايك مختلفة.\\r\\n2. تحسين وتطوير برنامج VIP - رسوم متحركة حصرية للمايك وموضوع المايك لجميع مستخدمي VIP، وخفض متطلبات VIP9 - VIP4، وإجراء تغيير مهم: لن يتم إعادة تعيين نقاط VIP إلى 0 بعد ترقية مستوى VIP.\\r\\n3. تحسينات أخرى.\\n\\n1. Added Mic Theme feature - Decorate your room with different mic themes. \\r\\n2. Improved VIP program - Exclusive mic animation and mic theme for all VIP users, lowered VIP 4 - VIP 9 requirements, and an important change: VIP points won't be reset to 0 after a VIP level upgrade. \\r\\n3. Other improvements.\",\"releaseDate\":\"2024-11-27\",\"releaseTimestamp\":\"2024-11-27T01:54:10Z\"},{\"versionDisplay\":\"2.28.0\",\"releaseNotes\":\"1. البطاقة الشهرية - قم بشرائها لتحصل على المزيد من القطع الذهبية بتكلفة أقل.\\r\\n2. مكافآت استدعاء الأصدقاء - قم بدعوة أصدقائك للعودة إلى يلا للحصول على مكافآت مختلفة.\\r\\n3. تحسينات أخرى.\\n\\n1. Month Card - Buy it to get more golds with less money.\\r\\n2. Recall Friends Rewards - Invite your friends to return to Yalla to get various rewards.\\r\\n3. Other improvements.\",\"releaseDate\":\"2024-09-27\",\"releaseTimestamp\":\"2024-09-27T15:19:38Z\"},{\"versionDisplay\":\"2.27.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-07-29\",\"releaseTimestamp\":\"2024-07-29T01:36:13Z\"},{\"versionDisplay\":\"2.27.0\",\"releaseNotes\":\"1. تم إطلاق قاعة معرض الهدايا. قم بإضاءة هدايا المعرض لفتح شارات المعرض.\\r\\n2. تمت إضافة أخبار المنصة لعرض الأحداث المهمة في الوقت الفعلي مثل إرسال هدايا المنصة، وترقية مستوى VIP، وما إلى ذلك.\\r\\n3. تحسينات أخرى.\\n\\n1. Gift Exhibition Hall is launched. Light up exhibition gifts to unlock exhibition badges.\\r\\n2. Added platform news to display important real-time events like sending platform gifts, upgrading VIP level, etc.\\r\\n3. Other improvements.\",\"releaseDate\":\"2024-06-28\",\"releaseTimestamp\":\"2024-06-28T01:50:28Z\"},{\"versionDisplay\":\"2.26.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-06-06\",\"releaseTimestamp\":\"2024-06-06T01:47:13Z\"},{\"versionDisplay\":\"2.26.1\",\"releaseNotes\":\"1. يمكنك إرسال الهدايا لجميع أعضاء الفريق في وقت واحد في لعبة كرة القدم المجنونة.\\n2. تحسينات أخرى\\n\\n1. You can give gifts to all team members at once in the Crazy Football game.\\n2. Other improvements\",\"releaseDate\":\"2024-05-08\",\"releaseTimestamp\":\"2024-05-08T01:59:23Z\"},{\"versionDisplay\":\"2.26.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T01:56:32Z\"},{\"versionDisplay\":\"2.25.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T01:47:59Z\"},{\"versionDisplay\":\"2.24.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-24\",\"releaseTimestamp\":\"2024-01-24T01:47:39Z\"},{\"versionDisplay\":\"2.24.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T01:50:11Z\"},{\"versionDisplay\":\"2.23.7\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-24\",\"releaseTimestamp\":\"2023-12-24T01:44:57Z\"},{\"versionDisplay\":\"2.23.6\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-22\",\"releaseTimestamp\":\"2023-12-22T01:32:44Z\"},{\"versionDisplay\":\"2.23.5\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-19\",\"releaseTimestamp\":\"2023-12-19T13:43:38Z\"},{\"versionDisplay\":\"2.23.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-11-22\",\"releaseTimestamp\":\"2023-11-22T01:43:27Z\"},{\"versionDisplay\":\"2.23.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-24\",\"releaseTimestamp\":\"2023-10-24T01:23:56Z\"},{\"versionDisplay\":\"2.23.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T01:33:00Z\"},{\"versionDisplay\":\"2.23.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T01:29:21Z\"},{\"versionDisplay\":\"2.22.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-08-02\",\"releaseTimestamp\":\"2023-08-02T01:31:28Z\"},{\"versionDisplay\":\"2.22.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-16\",\"releaseTimestamp\":\"2023-06-16T16:14:48Z\"},{\"versionDisplay\":\"2.22.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-14\",\"releaseTimestamp\":\"2023-06-14T01:56:09Z\"},{\"versionDisplay\":\"2.21.0\",\"releaseNotes\":\"1. مستوى الثروة - افتح مستوى ثروتك واستمتع بامتيازات خاصة. \\r\\n2. تحسينات أخرى\\n\\n1. Wealth Level - Unlock your wealth level and enjoy distinguished privileges.\\r\\n2. Other improvements\",\"releaseDate\":\"2023-05-09\",\"releaseTimestamp\":\"2023-05-09T08:34:42Z\"},{\"versionDisplay\":\"2.20.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T01:28:32Z\"},{\"versionDisplay\":\"2.20.0\",\"releaseNotes\":\"1. VIP 6 -قم بالوصول إلى المستوى VIP 6 للاستمتاع بمزايا حصرية رائعة!                       \\r\\n2. تحسينات أخرى\\n\\n1. VIP 6 - Level up to VIP 6 to enjoy fantastic exclusive benefits!\\r\\n2. Other Improvements\",\"releaseDate\":\"2023-03-07\",\"releaseTimestamp\":\"2023-03-07T02:33:13Z\"},{\"versionDisplay\":\"2.19.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T01:10:00Z\"},{\"versionDisplay\":\"2.19.0\",\"releaseNotes\":\"1. تصميم لحظات جديدة: تمتع بتصميم محسّن وجمالي حديثًا.\\r\\n2. سجلات إجراءات الغرفة: تمت إضافة سجلات لحظر الدردشة / إلغاء الحظر وإزالة من الميكروفون.\\r\\n3. الإبلاغ عم طلبات الصداقة: يمكن للمستخدمين الآن الإبلاغ عن طلبات الصداقة من أسفل صفحة طلب الصداقة.\\n\\n1. New Moments design: Enjoy a newly improved and aesthetic design.\\r\\n2. Room action records: Added records for chat ban/unban and removal from the mic.\\r\\n3. Friend request report: Users can now report friend requests from the bottom of the friend request page.\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T01:32:16Z\"}],\"websiteUrl\":\"http://www.yalla.live\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Chat with friends\"},\"messagesScreenshots\":{},\"languageList\":[\"English\",\"Arabic\",\"Hindi\",\"Indonesian\",\"Portuguese\",\"Spanish\",\"Turkish\",\"Urdu\"],\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=870444729\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":336872448}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=870444729\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":336872448}]}],\"requires32bit\":false,\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"isSiriSupported\":false,\"isGameCenterEnabled\":false,\"releaseDate\":\"2016-04-19\",\"minimumOSVersion\":\"12.0\",\"hasInAppPurchases\":true,\"bundleId\":\"com.weieyu.yalla\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/e1/e2/cc/e1e2cccd-6dd8-0a57-6f59-309db09fcc88/AppIcon-Yalla-0-1x_U007ephone-0-0-0-sRGB-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00d8c8\",\"textColor1\":\"161616\",\"textColor2\":\"161616\",\"textColor3\":\"123d3a\",\"textColor4\":\"123d3a\"},\"supportsGameController\":false,\"privacyPolicyUrl\":\"https://apiv2.yalla.live/web/Agreement.html?type=2\",\"videoPreviewsByType\":{},\"hasFamilyShareableInAppPurchases\":false,\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"http://www.yalla.live\",\"isDeliveredInIOSAppForWatchOS\":false,\"hasPrivacyPolicyText\":true,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features125/v4/69/22/bb/6922bb60-5310-9efa-2580-59565aa0cd0b/QlUtQVAtV1ctWWFsbGFfR3JvdXBfVm9pY2VfQ2hhdC5wbmc.png/{w}x{h}sr.{f}\",\"bgColor\":\"1e4d5a\",\"textColor1\":\"90fdb1\",\"textColor2\":\"90f0cd\",\"textColor3\":\"76d69e\",\"textColor4\":\"76ccb4\"},\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9/df/22/b9df22e4-d410-273a-f990-87ef45dc326b/53b5c834-2546-4ab9-b26a-5c5126c6851e.png/{w}x{h}{c}.{f}\",\"bgColor\":\"b6030c\",\"textColor1\":\"febc00\",\"textColor2\":\"febc00\",\"textColor3\"