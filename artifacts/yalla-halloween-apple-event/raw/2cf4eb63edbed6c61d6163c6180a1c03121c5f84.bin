</div><script type="fastboot/shoebox" id="shoebox-language-code">"en-gb"</script><script type="fastboot/shoebox" id="shoebox-ember-data-store">{"data":{"type":"product/app","id":"1091902866","attributes":{"userRating":{"value":4.2,"ratingCount":1092,"ratingCountList":[153,34,54,71,780],"ariaLabelForRatings":"4.2 stars"},"deviceFamilies":["iphone","ipod"],"metricsBase":{"pageType":"Software","pageId":"1091902866","pageDetails":"Yalla Technology FZ-LLC_Yalla - Group Voice Chat Rooms","page":"Software_1091902866","serverInstance":"3016404","storeFrontHeader":"","language":"2","platformId":"8","platformName":"ItunesPreview","storeFront":"143480","environmentDataCenter":"MR22"},"contentRating":{"name":"17+","value":600,"rank":4,"advisories":["Infrequent/Mild Horror/Fear Themes","Infrequent/Mild Profanity or Crude Humour","Infrequent/Mild Mature/Suggestive Themes","Unrestricted Web Access","Infrequent/Mild Sexual Content and Nudity"]},"copyright":"© 2019 Yalla Technology FZ-LLC.","description":"Yalla is the No.1 Live Group Voice Talking and Entertaining Community. Voice Chat and play games with people from nearby or all over the world.\r\n\r\nMeet new friends is never easier:\r\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries has already been covered, while tons of topics are available to choose.\r\n\r\nParty with friends with no distances:\r\nGroup voice talking with friends no matter where they are, broadcasting your favorite musics inside the room, singing karaokes together, playing a range of games directly in group chat. Let's get the party started.\r\n\r\nFEATURES:\r\n\r\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE or Wi-Fi.\r\n\r\nPUBLIC CHAT ROOMS  — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \r\n\r\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\r\n\r\nCHAT GAMES -- Play games together directly in your chat group!\r\n\r\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\r\n\r\nSHARE and FOLLOW -- Share your favorite ROOMS on Facebook, Twitter, Instagram, Snapchat and more, inviting friends and new followers.\r\n\r\nFollow us to get the latest news, updates and events:\r\nFacebook: facebook.com/yalla2016/\r\nTwitter: twitter.com/yalladotlive\r\nWebsite: www.yalla.live\r\n\r\nDear YALLA users, your feedback and suggestions are welcomed to : support@yalla.live","familyShareEnabledDate":"0001-04-23T00:00:00Z","hasInAppPurchases":true,"kind":"iosSoftware","name":"Yalla - Group Voice Chat Rooms","ratingText":"You must be at least 17 years old to download this application.","advisories":["Infrequent/Mild Horror/Fear Themes","Infrequent/Mild Profanity or Crude Humour","Infrequent/Mild Mature/Suggestive Themes","Unrestricted Web Access","Infrequent/Mild Sexual Content and Nudity"],"releaseDate":"2016-04-19","softwareInfo":{"supportUrl":"http://www.yalla.live","privacyPolicyUrl":"http://www.yalla.live/tos.html","eulaUrl":null,"languagesDisplayString":"English, Arabic, Hindi, Indonesian, Portuguese, Spanish, Turkish, Urdu","privacyPolicyTextUrl":"https://itunes.apple.com/WebObjects/MZStore.woa/wa/viewPrivacyPolicy?cc=tr\u0026id=1091902866","requirementsString":"Requires iOS 9.0 or later. Compatible with iPhone, iPad and iPod touch.","hasInAppPurchases":true,"seller":"Yalla Technology FZ-LLC","websiteUrl":null},"url":"https://apps.apple.com/tr/app/yalla-group-voice-chat-rooms/id1091902866","versionHistory":[{"releaseNotes":"1. Fixed several bugs\r\n2. Improved user experience\r","versionString":"2.9.1","releaseDate":"2019-07-17T01:45:05Z"},{"releaseNotes":"1.New currency—Crystal\n2.New privileges and lower price for Aristocracy membership\n3.Improved layout and design of the “Theme” page\n4.Improved visual design of badges\n5.Two new language regions: Hindi and Urdu    \n6.Several performance improvements","versionString":"2.9.0","releaseDate":"2019-07-12T01:37:51Z"},{"releaseNotes":"1. “Me” section and user profile are redesigned.\n2.You can learn about your level on the“Level”page.\n3.You can now choose tags on your profile.\n4.You can see rooms you entered recently. \n5.Lucky gifts are upgraded.\n6.Two languages are added: Portuguese and Spanish.\n7.Several performance improvements\n\n1. تم إعادة تصميم قسم \"أنا\" وملف المعلومات الشخصية.\n2. يمكنك معرفة المزيد عن مستواك من خلال صفحة \" المستوى\".\n3. يمكنك اختيار إشاراتك في ملف المعلومات الشخصية.\n4. تم إضافة سجل للغرف التي دخلتها مؤخراً.\n5. تم ترقية هدايا الحظ.\n6. تم إضافة لغتين وهما: البرتغالية والإسبانية.\n7. إجراء العديد من التحسينات في الأداء.","versionString":"2.8.0","releaseDate":"2019-06-07T02:44:27Z"},{"releaseNotes":"Bugs are fixed and user experience is improved.\n\nيتم إصلاح الأخطاء وتحسين تجربة المستخدم","versionString":"2.7.6","releaseDate":"2019-04-07T00:03:29Z"},{"releaseNotes":"Bugs are fixed and user experience is improved.\n\nيتم إصلاح الأخطاء وتحسين تجربة المستخدم","versionString":"2.7.5","releaseDate":"2019-04-05T04:44:03Z"},{"releaseNotes":"1. “Lucky Gifts”are launched\n2. You can post GIFs in Moments\n3. You’ll get notifications when friends repost your posts.\n4. Making posts is easier and faster\n5. Log in \u0026 sign up via phone is easier\n6. Other feature improvements\n\n1. هدايا الحظ متوفرة الآن\n2. يمكنك نشر صور الـ GIF في اللحظات الآن\n3. ستحصل على إشعارات عند إعادة نشر اللحظات الخاصة بك من قبل أصدقائك\n4. نشر اللحظات أصبح أسهل وأسرع\n5. تسجيل الدخول والتسجيل عبر الهاتف أصبح أسهل\n6. تم تحسين ميزات أخرى","versionString":"2.7.4","releaseDate":"2019-03-19T06:35:40Z"},{"releaseNotes":"Bugs are fixed and user experience is improved.\n\nيتم إصلاح الأخطاء وتحسين تجربة المستخدم","versionString":"2.7.3","releaseDate":"2019-02-01T01:54:45Z"},{"releaseNotes":"1. Room game \"Lucky Number\" is back online.\n2. Special effects for sending gifts to everyone in the room are cooler.\n3. Replying to comments on your posts or replies to your comments is very easy now.\n4. Yalla posters in \"Moments\" are now online.\n5. Bugs are fixed and user experience is improved.\n\n1. لعبة الغرفة \"رقم الحظ\" عادت من جديد على الإنترنت الآن.\n2. تم تحسين المؤثرات الخاصة لإرسال هدايا لجميع أعضاء الغرفة.\n3. أصبح من السهل جداً الرد على التعليقات الخاصة بمنشورك أو الرد على الردود في التعليقات.\n4. فريق لحظات يلا متواجدين على الإنترنت الآن.\n5. تم إصلاح الثغرات وتم تحسين تجربة المستخدم.","versionString":"2.7.2","releaseDate":"2019-01-26T10:37:00Z"},{"releaseNotes":"Bugs are fixed and user experience is improved\n\nيتم إصلاح الأخطاء وتحسين تجربة المستخدم","versionString":"2.7.1","releaseDate":"2018-12-23T05:44:09Z"},{"releaseNotes":"1. Magic cards are upgraded\n2. You can now view messages in any room \n3. You can turn off your mic temporarily \n4. You can send gifts to everyone in the room at a time\n5. You can add topics when making posts\n6. You can report problems to Yalla Team on the Message page \n7. User interface and user experiences are improved\n\n1. تم تحديث البطاقات السحرية.\u2028\n2. يمكنك عرض الرسائل في أي غرفة.\u2028\n3. يمكنك قفل المايك مؤقتاً.\u2028\n4. يمكنك إرسال هدايا لجميع أعضاء الغرفة في وقت واحد.\u2028\n5. يمكنك إضافة مواضيع عند نشر اللحظات.\u2028\n6. يمكنك الإبلاغ عن المشاكل مباشرة لفريق يلا على صفحة الرسائل.\u2028\n7. تم تحسين واجهة المستخدم وتجارب المستخدم.","versionString":"2.7.0","releaseDate":"2018-12-18T07:54:19Z"},{"releaseNotes":"Bugs are fixed and user experience is improved\n\nيتم إصلاح الأخطاء وتحسين تجربة المستخدم","versionString":"2.6.3","releaseDate":"2018-10-24T02:35:35Z"},{"releaseNotes":"1. You can enter the room your friend is in on the friend list page\n2. Number of followers, number of following, and gifts received in the past six months are displayed in the profile\n3. Pin on Top cards are now for sale by auction\n4. Search history is added on the search page\n5. The design of aristocracy badges and achievement badges are improved\n6. Room sharing feature is improved\n7. Support is added for iOS 12\n8. Some other details are improved\n\n1. يمكنك الدخول إلى الغرفة التي يوجد فيها صديقك على صفحة قائمة الأصدقاء\u2028\n2. يتم عرض عدد المتابعين وعدد المتابعة لهم، وعدد الهدايا المستلمة في الأشهر الستة الماضية في الملف الشخصي\u2028\n3. بطاقات التثبيت في الأعلى معروضة للبيع عن طريق المزاد\u2028\n4. تم إضافة سجل البحث في صفحة البحث\u2028\n5. تم تحسين تصميم شارات الأرستقراطية وشارات الإنجازات\n6. تم تحسين طريقة مشاركة الغرفة\n7. تم إضافة الدعم لنظام التشغيل iOS 12  \u2028\n8. تم تحسين التفاصيل الأخرى","versionString":"2.6.2","releaseDate":"2018-10-10T03:05:36Z"},{"releaseNotes":"1.Music able to be uploaded from iTunes to the room playlist\n2.UI improvement of badges, room entrance effects and name cards for Aristocracy\n3.More eye-catching and a great number of Unique IDs available in store\n4.Other improvements made for better user experience\n\n1.دعم تحميل الموسيقى من اي تيونز إلى قائمة أغاني الغرفة. \n2.تحسين واجهة المستخدم لشارة الأرستقراطية وتأثيرات دخول الغرفة للأرستقراطية وبطاقة اسم الأرستقراطي.\n3.يتوفر الكثير من الأي دي المميز في المتجر ، وأيضاً تم تحسين شعار الأي دي\u2028\n4.تحسين تجارب الاستخدام الأخرى","versionString":"2.6.1","releaseDate":"2018-08-22T02:25:48Z"},{"releaseNotes":"1.Music able to be uploaded from iTunes to the room playlist\n2.UI improvement of badges, room entrance effects and name cards for Aristocracy\n3.More eye-catching and a great number of Unique IDs available in store\n4.Other improvements made for better user experience\n\n1.دعم تحميل الموسيقى من اي تيونز إلى قائمة أغاني الغرفة. \n2.تحسين واجهة المستخدم لشارة الأرستقراطية وتأثيرات دخول الغرفة للأرستقراطية وبطاقة اسم الأرستقراطي.\n3.يتوفر الكثير من الأي دي المميز في المتجر ، وأيضاً تم تحسين شعار الأي دي\u2028\n4.تحسين تجارب الاستخدام الأخرى","versionString":"2.6.0","releaseDate":"2018-08-15T22:45:35Z"},{"releaseNotes":"1.New Indonesian and English regions, free to change any region you like\n2.Easy to unbind your third-party account\n3.Check member online status on【Room Member】list\n4.New room types on 【Explore】page\n5.Other optimization\n1. المنطقة الاندونيسية والانجليزية، يمكنك تغيير أي منطقة تريد مجاناْ\n2. من السهل فك ربط حساب الطرف الثالث الخاص بك\n3. يمكنك التحقق من حالة تواجد الأعضاء على الأنترنت في قائمة أعضاء الغرفة\n4. أنواع الغرف الجديدة في صفحة \"الإستكشاف\"\n5. التحسينات الأخرى","versionString":"2.5.4","releaseDate":"2018-07-18T02:32:02Z"},{"releaseNotes":"1.New Indonesian and English regions, free to change any region you like\n2.Easy to unbind your third-party account\n3.Check member online status on【Room Member】list\n4.New room types on 【Explore】page\n5.Other optimization\n1. المنطقة الاندونيسية والانجليزية، يمكنك تغيير أي منطقة تريد مجاناْ\n2. من السهل فك ربط حساب الطرف الثالث الخاص بك\n3. يمكنك التحقق من حالة تواجد الأعضاء على الأنترنت في قائمة أعضاء الغرفة\n4. أنواع الغرف الجديدة في صفحة \"الإستكشاف\"\n5. التحسينات الأخرى","versionString":"2.5.3","releaseDate":"2018-07-15T02:30:35Z"},{"releaseNotes":"1.New Indonesian and English regions, free to change any region you like\n2.Easy to unbind your third-party account\n3.Check member online status on【Room Member】list\n4.New room types on 【Explore】page\n5.Other optimization\n\n1. المنطقة الاندونيسية والانجليزية، يمكنك تغيير أي منطقة تريد مجاناْ\n2. من السهل فك ربط حساب الطرف الثالث الخاص بك\n3. يمكنك التحقق من حالة تواجد الأعضاء على الأنترنت في قائمة أعضاء الغرفة\n4. أنواع الغرف الجديدة في صفحة \"الإستكشاف\"\n5. التحسينات الأخرى","versionString":"2.5.2","releaseDate":"2018-07-12T01:40:28Z"},{"releaseNotes":"Optimized functions and fixed bugs\n\nتحسين الوظائف وإصلاح الأخطاء","versionString":"2.5.1","releaseDate":"2018-06-01T15:47:34Z"},{"releaseNotes":"1. New function! Post on “Moments”\n2. New daily attendance，to get a random prize\n3. Activity can be shared\n4. Changed “Me” and “Top” positions\n5. Adjusted the permission of taking mic and member fee in room\n6. Optimized functions and fixed bugs\n\n1. الوظيفة الجديدة! يمكنك النشر في “اللحظات”\n2. الحضور اليومي الجديد للحصول على مكافأة عشوائية\n3. النشاطات متاحة للمشاركة\n4. الموقع الجديد ل”أنا” و”المرتبة”\n5. تعديل الإذن لأخذ الميكروفون ورسوم العضوية للغرفة\n6. تحسين الوظائف وإصلاح الأخطاء","versionString":"2.5.0","releaseDate":"2018-05-28T07:56:00Z"},{"releaseNotes":"Update：\n1. Personalized room themes\n2. Unique ID store online\n3. Aristocracy system online\n4. 3 newly-added login method\n5. Product experience optimized\n\nالتحديث:\n1. موضوعات الغرفة الشخصية\n2.متجرالاي ديهات المميزة \n3. نظام الأرستقراطية \n4. اضافة 3 طريق جديدة لتسجيل الدخول\n5. تحسين تجربة المستخدم","versionString":"2.4.3","releaseDate":"2018-02-06T18:29:15Z"},{"releaseNotes":"Update：\n1. Add the online user list in the room\n2. Adjust the broadcast style in the room\n3. Display the medal, make you more honorable\n4. Fix some bugs and improve user experience\n\nتحديث:\n1. إضافة قائمة المستخدمين المتواجدين في الغرفة\n2. ضبط نمط بث شريط الاعلانات في الغرفة\n3. عرض الشارة، تجعلك أكثرتميز\n4. إصلاح بعض الخلل وتحسين تجربة المستخدم","versionString":"2.4.2","releaseDate":"2017-12-08T22:48:34Z"},{"releaseNotes":"التحديث:\n1. التكيف مع IOS 11\n2. إصلاح بعض الخلل\n\nUpdate:\n1. Adapt to iOS11\n2. Fix some bugs","versionString":"2.4.1","releaseDate":"2017-11-08T01:44:34Z"},{"releaseNotes":"التحديثات:\n١-تصميم واجهة المستخدم الجديدة في الغرفة لتجربة فريدة\n٢-إدارة مريحة ( دعوة ، ازالة ، طرد ، الخ) لمالك الغرفة \n٣- إصلاح بعض الخلل \n\nUpdates:\n1. New UI Design in the room for Glorious Experience;\n2. Convenient Management(Invite, Remove, Kick out, etc) for Room Owner;\n3. Fix Some Bugs.","versionString":"2.4.0","releaseDate":"2017-11-02T02:09:00Z"},{"releaseNotes":"التحديثات :\n١-إضافة خاصية الغرف المقترحة .\n٢-يمكن للمستخدم النقر على شريط الإعلان لدخول غرفة الإرسال .\n٣-تحسين تجربة تسجيل رقم الهاتف .\n\nUpdates:\n1. Add recommended rooms;\n2. User can click on broadcasting message to enter the luxury gift sending room;\n3. Improve mobile number registration experience.","versionString":"2.3.7","releaseDate":"2017-09-19T00:21:46Z"},{"releaseNotes":"التحديثات :\n١-إضافة خاصية الغرف المقترحة .\n٢-يمكن للمستخدم النقر على شريط الإعلان لدخول غرفة الإرسال .\n٣-تحسين تجربة تسجيل رقم الهاتف .\n\nUpdates:\n1. Add recommended rooms;\n2. User can click on broadcasting message to enter the luxury gift sending room;\n3. Improve mobile number registration experience.","versionString":"2.3.6","releaseDate":"2017-08-30T13:02:22Z"}],"size":114309120,"subtitle":"Meet new friends \u0026 Enjoy party","chartPositionForStore":{"appStore":{"position":6,"genreName":"Entertainment","chartUrl":"https://itunes.apple.com/WebObjects/MZStore.woa/wa/viewTop?cc=tr\u0026genreId=6016\u0026popId=96"}},"minimumOSVersion":"9.0","sellerLabel":"Provider","iphoneScreenshotsVersion":"iphone_6_5"},"relationships":{"offers":{"data":[{"type":"offer","id":"st58237019"}]},"developer":{"data":{"type":"lockup/developer","id":"1444567250"}},"artwork":{"data":{"type":"image","id":"st58237020"}},"iphoneScreenshots":{"data":[{"type":"image","id":"st103565923"},{"type":"image","id":"st103565924"},{"type":"image","id":"st103565925"},{"type":"image","id":"st103565926"},{"type":"image","id":"st103565927"},{"type":"image","id":"st103565928"},{"type":"image","id":"st103565929"}]},"subscriptions":{"data":[]},"inAppPurchases":{"data":[]},"topInApps":{"data":[{"type":"product/app/in-app","id":"st54775232"},{"type":"product/app/in-app","id":"st54775233"},{"type":"product/app/in-app","id":"st54775234"},{"type":"product/app/in-app","id":"st54775235"},{"type":"product/app/in-app","id":"st54775236"}]},"genres":{"data":[{"type":"genre","id":"st148335"},{"type":"genre","id":"st148332"}]},"customersAlsoBoughtApps":{"data":[{"type":"lockup/app","id":"835880015"},{"type":"lockup/app","id":"1208922339"},{"type":"lockup/app","id":"1384325538"},{"type":"lockup/app","id":"879915134"},{"type":"lockup/app","id":"962284784"},{"type":"lockup/app","id":"543714948"},{"type":"lockup/app","id":"1201764998"