,{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/bobo-group-voice-chat-rooms/id1489566586\",\"userRating\":{\"value\":3.6,\"ratingCount\":12,\"ratingCountList\":[2,2,1,1,6],\"ariaLabelForRatings\":\"3.6 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"BoBo - Group Voice Chat Rooms\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"思伟 邹\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"BoBo is a global free voice chat app that supports Group voice chat rooms, you can chat and play games with your friends, even share your voice to make new friends.\\nDownload BoBo App and join the most interesting social party!\\n \\nWhy BoBo is the best social app for you?\\n \\nFree voice chat\\nYou can voice chat at any time, anywhere with a mobile data or WIFI, with us, you can meet the one you like.\\n \\nVoice chat rooms\\nChat with new friends all over the world.\\nJoin the most interesting magic social community in the world. Here you can introduce yourself to everyone, singing and sharing your interesting daily, and also make new friends all over the world.\\n \\nVirtual gifts\\nIf you meet someone but you don't know how to express your feelings? Just send a small gift to let him/her notice you.\\n \\nInteresting chat journey\\nBoBo has more than 6 types of rooms, you can find whatever you need\\nEmotional radio station: let you have a friend who will listen to you on the Internet and share your happiness; you will also meet new friends who have common interests with you here.\\nGame/Task room: let you relax and have fun with online games and some interesting task.\\nStill, there are other interesting chat rooms waiting for you to experience.\\n \\nBoBo requests the following permissions:\\nMicrophone: Delivering sound during live broadcast\\nCamera: Take photos and videos\\nAuthorization Request: BoBo needs your permission to obtain storage space that helps you to get a better experience and ensure the normal use of the app\\n \\nCome to join our big family and follow us to get the latest news, updates and also activity in the application. We Appreciate your support, And we will continue to improve and update BoBo to give you the best experience.\\nEmail: dev@chucp.mobi\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"4.21.0\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-07-18\",\"releaseTimestamp\":\"2025-07-18T11:05:19Z\"},{\"versionDisplay\":\"4.20.0\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-06-26\",\"releaseTimestamp\":\"2025-06-26T09:51:48Z\"},{\"versionDisplay\":\"4.19.3\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-06-24\",\"releaseTimestamp\":\"2025-06-24T08:33:23Z\"},{\"versionDisplay\":\"4.19.2\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-06-11\",\"releaseTimestamp\":\"2025-06-11T02:24:48Z\"},{\"versionDisplay\":\"4.19.1\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-06-10\",\"releaseTimestamp\":\"2025-06-10T06:55:39Z\"},{\"versionDisplay\":\"4.19.0\",\"releaseNotes\":\"More interesting games have been updated, come and join us\",\"releaseDate\":\"2025-06-06\",\"releaseTimestamp\":\"2025-06-06T09:19:47Z\"},{\"versionDisplay\":\"4.18.0\",\"releaseNotes\":\"1. The Honor nameplate is now online, come and experience it\\n2. Supports cool microphone animation, making the party atmosphere more exciting\",\"releaseDate\":\"2025-04-23\",\"releaseTimestamp\":\"2025-04-23T03:15:14Z\"},{\"versionDisplay\":\"4.17.0\",\"releaseNotes\":\"1. The Honor nameplate is now online, come and experience it\\n2. Supports cool microphone animation, making the party atmosphere more exciting\",\"releaseDate\":\"2025-03-27\",\"releaseTimestamp\":\"2025-03-27T08:50:41Z\"},{\"versionDisplay\":\"4.15.2\",\"releaseNotes\":\"1. The Honor nameplate is now online, come and experience it\\n2. Supports cool microphone animation, making the party atmosphere more exciting\",\"releaseDate\":\"2025-01-24\",\"releaseTimestamp\":\"2025-01-24T01:21:43Z\"},{\"versionDisplay\":\"4.15.1\",\"releaseNotes\":\"1. The Honor nameplate is now online, come and experience it\\n2. Supports cool microphone animation, making the party atmosphere more exciting\",\"releaseDate\":\"2025-01-22\",\"releaseTimestamp\":\"2025-01-22T09:45:32Z\"},{\"versionDisplay\":\"4.15.0\",\"releaseNotes\":\"1. The Honor nameplate is now online, come and experience it\\n2. Supports cool microphone animation, making the party atmosphere more exciting\",\"releaseDate\":\"2025-01-22\",\"releaseTimestamp\":\"2025-01-22T01:38:12Z\"},{\"versionDisplay\":\"4.14.0\",\"releaseNotes\":\"1. Some Optimize to provide better experience, let's play together\\n2. New activities are online, come and participate\",\"releaseDate\":\"2025-01-02\",\"releaseTimestamp\":\"2025-01-02T09:25:33Z\"},{\"versionDisplay\":\"4.13.1\",\"releaseNotes\":\"1. Lucky gifts are now online, let's play together\\n2. More interesting games have been updated, come and join us\",\"releaseDate\":\"2024-12-23\",\"releaseTimestamp\":\"2024-12-23T01:32:47Z\"},{\"versionDisplay\":\"4.13.0\",\"releaseNotes\":\"1. Lucky gifts are now online, let's play together\\n2. More interesting games have been updated, come and join us\",\"releaseDate\":\"2024-12-09\",\"releaseTimestamp\":\"2024-12-09T01:25:18Z\"},{\"versionDisplay\":\"4.12.0\",\"releaseNotes\":\"1. Video chat function launched, chat with friends\\n2. Interesting games updated, come and join us\",\"releaseDate\":\"2024-11-19\",\"releaseTimestamp\":\"2024-11-19T01:36:11Z\"},{\"versionDisplay\":\"4.11.0\",\"releaseNotes\":\"1. New more amazing gift bar effect Available now\\n2. Rare gifts are online, let's try it together\",\"releaseDate\":\"2024-10-24\",\"releaseTimestamp\":\"2024-10-24T01:42:45Z\"},{\"versionDisplay\":\"4.10.3\",\"releaseNotes\":\"1. Optimized the family function, let's play family PK together\\n2. The member points mall is online, and member points can be directly exchanged for goods\",\"releaseDate\":\"2024-10-16\",\"releaseTimestamp\":\"2024-10-16T09:56:16Z\"},{\"versionDisplay\":\"4.10.2\",\"releaseNotes\":\"1. Optimized the family function, let's play family PK together\\n2. The member points mall is online, and member points can be directly exchanged for goods\",\"releaseDate\":\"2024-10-11\",\"releaseTimestamp\":\"2024-10-11T01:44:16Z\"},{\"versionDisplay\":\"4.10.1\",\"releaseNotes\":\"1. Party room is now available, 16 people can get on the mic and party together.\\n2. More gift effects, invite your friends to play together.\",\"releaseDate\":\"2024-09-23\",\"releaseTimestamp\":\"2024-09-23T01:11:07Z\"},{\"versio