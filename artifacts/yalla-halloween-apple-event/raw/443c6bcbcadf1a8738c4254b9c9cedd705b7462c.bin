"ratingCountList\":[0,0,0,0,3],\"ariaLabelForRatings\":\"5.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.5\",\"genreDisplayName\":\"Puzzle\",\"name\":\"Yalla Match - Vogue Star\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"[FASHION QUEEN RISING]\\nBetrayed by the Fiance? Destroy the Cheater and Rise to Fame!\\nBackstabbed by the Fake Friend? Reclaim the Glory with the Match-3 Magic!\\n\\nCREATE FASHION MAGIC AT YOUR FINGERTIPS\\n1000+ Stunning Levels | Creative Dye Spray Effect\\nZero Ads | Play Offline Anytime\\nDress-Up Meets Match-3 Games | Story-Driven Gameplay\\n\\nMILLIONS OF OUTFITS IN THE WARDROBE AWAITS\\n3000+ Trendy Styles: Make the Character from Nobody to Fashion Icon\\nExclusive Style Battles: Outshine Villains with Show-Stopping Looks!\\n\\nDUAL STORYLINES PACKED WITH DRAMA\\n[CAREER PATH] Overcome Copycats → Rise from the Ashes → Conquer Four Major Fashion Weeks\\n[ROMANCE PATH] Reunite with First Love VS Fall for a Mysterious Designer\\n\\nDownload Now and Begin Your Journey to Fashion Royalty!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"websiteUrl\":\"https://www.yallamatch3.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Bug fixes and experience improvements.\",\"releaseDate\":\"2025-06-05\",\"releaseTimestamp\":\"2025-06-05T14:32:39Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"A Massive Update Redefining the Game: \\n· Added a brand-new themed dress-up gameplay element.\\n· Created a pathway to rising to an Influencer.\\n· Optimized the Social feature.\\n· Developed new stories, dramas, and exciting performances.\\n· Optimized the Club feature by adding Club Level and Work Plan.\",\"releaseDate\":\"2025-05-15\",\"releaseTimestamp\":\"2025-05-15T12:22:43Z\"},{\"versionDisplay\":\"1.0.6.1\",\"releaseNotes\":\"Comprehensive upgrade of the Game UI.\\nBug fixes and experience improvements.\\nPerformance optimization targeted for most devices.\",\"releaseDate\":\"2024-06-03\",\"releaseTimestamp\":\"2024-06-03T08:30:29Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Comprehensive upgrade of the Game UI.\\nAdded Mini Games.\\nBug fixes and experience improvements.\\nPerformance optimization targeted for most devices.\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T10:41:49Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":null,\"releaseDate\":\"2024-03-08\",\"releaseTimestamp\":\"2024-03-08T00:41:44Z\"}],\"isXROSCompatible\":false,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"editorialNotes\":{\"tagline\":\"Polish your look with every win\"},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=875341660\",\"type\":\"get\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":296394752}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=875341660\",\"type\":\"update\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":296394752}]}],\"requires32bit\":false,\"releaseDate\":\"2024-03-07\",\"hasInAppPurchases\":true,\"bundleId\":