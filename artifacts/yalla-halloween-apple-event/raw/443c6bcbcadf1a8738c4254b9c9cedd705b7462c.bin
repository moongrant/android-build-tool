"iPad13,4\":572053504,\"iPad13,5\":572053504,\"iPad13,6\":572053504,\"iPad13,7\":572053504,\"iPad13,1\":572053504,\"iPad13,2\":572053504}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/ae/apps/1377028992/developer?l=en-GB\",\"data\":[{\"id\":\"1720696037\",\"type\":\"developers\",\"href\":\"/v1/catalog/ae/developers/1720696037?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"GOOD ONLINE TECHNOLOGY PTE.LTD.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/ae/developer/good-online-technology-pte-ltd/id1720696037\"}}]},\"genres\":{\"href\":\"/v1/catalog/ae/apps/1377028992/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6016\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1753407609726,\"RTCI\":1753902391890}}},{\"id\":\"1519557264\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1519557264?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/hawa-group-voice-chat-rooms/id1519557264\",\"userRating\":{\"value\":3.1,\"ratingCount\":8,\"ratingCountList\":[3,1,0,0,4],\"ariaLabelForRatings\":\"3.1 stars\"},\"genreDisplayName\":\"Entertainment\",\"name\":\"Hawa - Group Voice Chat Rooms\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Hawa Technology Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"hawa, come for love, meet by sound\\n\\nHawa offers a social space that focuses on sound, where you can not only get rid of the social pressure in reality, but also quickly meet new friends from various regions in the Middle East. Without social labels, use voice and thought to collide with strange souls to obtain purer friendship or love.\\n\\nIn Hawa, explore new worlds, explore love.\\n\\n【Make new friend】\\nCome to hawa to explore different themed voice rooms, use your voice to show your talent and personality, and meet people who understand you anytime, anywhere!\\n\\nNo need to show your face without social pressure, express yourself as much as you want and talk about topics you are interested in, such as food, sports events, fashion trends, etc. A variety of themes to meet all your preferences!\\n\\n【Fun Game】\\nHost an online party with new friends from all over the Middle East, and a large number of trendy room games will help you quickly break the ice and become the most popular party king!\\n\\n【special gift】\\nHawa, you can get customized gifts, luxury cars and gorgeous headwear. Come and light up your unique gift catalogue!\\n\\n【Ranking】\\nExclusive medals and privileges to show your status and position.\\n\\nMusic\\nListen to your favorite keep up with the world music trends. Share your song list, show your voice live!, this is your exclusive music party.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.1.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-08-03\",\"releaseTimestamp\":\"2025-08-03T07:59:40Z\"},{\"versionDisplay\":\"2.0.2\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-07-21\",\"releaseTimestamp\":\"2025-07-21T11:33:26Z\"},{\"versionDisplay\":\"2.0.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-07-17\",\"releaseTimestamp\":\"2025-07-17T15:43:38Z\"},{\"versionDisplay\":\"2.0.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-07-15\",\"releaseTimestamp\":\"2025-07-15T01:40:00Z\"},{\"versionDisplay\":\"1.46.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-06-20\",\"releaseTimestamp\":\"2025-06-20T01:46:50Z\"},{\"versionDisplay\":\"1.45.1\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-06-09\",\"releaseTimestamp\":\"2025-06-09T07:47:54Z\"},{\"versionDisplay\":\"1.45.0\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseDate\":\"2025-