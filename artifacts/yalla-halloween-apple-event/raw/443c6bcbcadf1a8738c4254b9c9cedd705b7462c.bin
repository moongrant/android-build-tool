idth\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"url\":\"https://apps.apple.com/ae/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/ae/apps/1539388601/genres?l=en-GB\",\"data\":[{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6005\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6012?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6012\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1752749570915,\"RTCI\":1753902138612}}},{\"id\":\"1513504421\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1513504421?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":19,\"genreName\":\"Card\",\"genre\":7005,\"chart\":\"top-free\",\"genreShortName\":\"Card\",\"chartLink\":\"https://apps.apple.com/ae/charts/iphone/card-games/7005\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/yalla-baloot-hand/id1513504421\",\"userRating\":{\"value\":4,\"ratingCount\":56,\"ratingCountList\":[10,2,4,4,36],\"ariaLabelForRatings\":\"4.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.0\",\"name\":\"Yalla Baloot \u0026 Hand\",\"genreDisplayName\":\"Card\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 13.0.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0.0\",\"description\":{\"standard\":\"Welcome to Yalla Baloot \u0026 Hand, the ultimate mobile board game app that brings you the best of Baloot and Hand, two popular card games from the Arab region. Immerse yourself in the authentic gameplay, compete in fair thrilling tournaments, and connect with friends and family in real-time, all with smooth experience and rewarding wins.\\n\\nKey Features:\\n\\nAuthentic Baloot Experience:\\nExperience the timeless charm of Baloot, a beloved card game from the Middle East. Play with traditional rules and immerse yourself in the rich cultural heritage of this classic game with fair matchmaking for balanced competition.\\n\\nMultiple Modes of Hand:\\nExplore a variety of Hand game modes, including Hand and Hand Saudi. Each mode offers its own unique challenges and excitement, providing endless entertainment for both casual and competitive players with smooth, lag-free gameplay.\\n\\nCompetitive Tournaments and Rankings:\\nTest your skills and compete against players from around the world in intense tournaments and leagues. Climb the ranks, earn prestigious titles, and showcase your card-playing skills with plentiful rewards.\\n\\nSocial Rooms for Multiplayer Fun:\\nJoin public rooms and play Baloot and Hand with friends and other players. Create private rooms to invite your friends and enjoy hours of fun-filled gaming sessions together.\\n\\nVoice Chat Rooms for Real-Time Communication:\\nConnect with family and friends through real-time voice chat rooms. Enjoy seamless communication, host online parties, and share memorable moments as you engage in lively conversations.\\n\\nExquisite Personalization Options:\\nCustomize your gaming experience with a wide range of beautifully designed skins for cards, boards, and avatars. Stand out from the crowd and express your style with customizable elements that reflect your personality.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Baloot \u0026 Hand SVIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nYalla Baloot \u0026 Hand SVIP price is USD 24.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S., and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Baloot \u0026 Hand without becoming a Yalla Baloot \u0026 Hand SVIP.\\n\\nWe will try our best to improve your game experience, provide you with fun and excitement, and make your life full of joy.\\n\\nPrivacy Policy：https://h5.yallabaloot.com/balootActivity/privacy_baloot/UserAgreementEN.html?index=0\\n\\nTerms of Service：https://h5.yallabaloot.com/balootActivity/privacy_baloot/UserAgreementEN.html?index=1\\n\\nContact Us: \\nIf you have any questions or suggestions, please contact us.\\nFacebook:https://www.facebook.com/BalootYalla\\nWebsite:www.yallabaloot.com\\nEmail: balootsupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"accelerometer arm64 opengles-1 \",\"versionHistory\":[{\"versionDisplay\":\"1.5.17\",\"releaseNotes\":\"1. Royal System Upgrade - Royal Privileges have extended to the game lobby!\\n2. SVIP Feature Upgrade - GIF profile photo is now available for SVIP users.\\n3. Store Design Optimization - Brings a more convenient user experience.\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2025-06-01\",\"releaseTimestamp\":\"2025-06-01T02:54:51Z\"},{\"versionDisplay\":\"1.5.16\",\"releaseNotes\":\"1. Ramadan theme - Ramadan themed activities are coming soon, let's welcome Ramadan together.\\n2. New SVIP system - Become an SVIP, unlock exclusive privileges, and show your identity.\\n3. New gifts - New lucky gift in chatroom. Send gifts for a chance to get generous rewards!\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2025-03-07\",\"releaseTimestamp\":\"2025-03-07T02:05:45Z\"},{\"versionDisplay\":\"1.5.15.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2025-02-13\",\"releaseTimestamp\":\"2025-02-13T08:04:30Z\"},{\"versionDisplay\":\"1.5.15\",\"releaseNotes\":\"1. New Gifts - New flying-mic gifts in Chatroom, unlocking a more interesting way of sending gifts. Come and experience it now!\\n2. Royal Level - Royal 6 is now available in the Chatroom! More privileges are waiting for you to enjoy!\\n3. Game Benefits - Brand new permanent profile frames and chatroom gift packs. Enjoy a wonderful journey of the game!\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2025-01-14\",\"releaseTimestamp\":\"2025-01-14T01:36:51Z\"},{\"versionDisplay\":\"1.5.14\",\"releaseNotes\":\"1. Pass - Super value pass available, with generous rewards waiting for you!\\r\\n2. New gifts - New exclusive customization gifts showcase your unique glory.\\r\\n3. Baloot - League match upgrade with new interface and polished quality.\",\"releaseDate\":\"2024-11-12\",\"releaseTimestamp\":\"2024-11-12T01:48:12Z\"},{\"versionDisplay\":\"1.5.13\",\"releaseNotes\":\"1. Chatroom - The live room now offers top matches spectating. Watch high-level matches between top players.\\r\\n2. Game benefits - Brand new first recharge and limited-time gift pack, offering a more enjoyable gaming experience.\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-09-13\",\"releaseTimestamp\":\"2024-09-13T02:02:31Z\"},{\"versionDisplay\":\"1.5.12\",\"releaseNotes\":\"1. Chatroom - Enjoy Baloot tournaments while chatting with friends in the exclusive spectating room.\\n2. Game match - Optimized certain layouts in Baloot and Hand games to enhance your gaming experience!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-07-30\",\"releaseTimestamp\":\"2024-07-30T01:50:16Z\"},{\"versionDisplay\":\"1.5.11\",\"releaseNotes\":\"1. In-game message and Stickers - Optimized in-game messages and stickers interface. Enjoy free communication with your friends!\\r\\n2. Baloot Game Interface - Optimized the layout of personal information to further enhance the gaming experience.\\r\\n3. Interaction Optimization - Optimized the effect of interface transitions to provide a smoother experience.\",\"releaseDate\":\"2024-05-17\",\"releaseTimestamp\":\"2024-05-17T01:26:04Z\"},{\"versionDisplay\":\"1.5.10\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-04-19\",\"releaseTimestamp\":\"2024-04-19T01:47:12Z\"},{\"versionDisplay\":\"1.5.9\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-03-06\",\"releaseTimestamp\":\"2024-03-06T05:38:24Z\"},{\"versionDisplay\":\"1.5.8.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-02-08\",\"releaseTimestamp\":\"2024-02-08T02:42:19Z\"},{\"versionDisplay\":\"1.5.8\",\"releaseNotes\":\"1. Chatroom - Introducing our new Royal System! Become a royal member and unlock various privileges to stand out from the crowd!\\n2. New Baloot Gameplay - Experience the limited-time one-round mode and join the master showdown.\\n3. Ranking Display Upgrade - The top of each ranking will now have enhanced effects to show off the glory!\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T06:23:09Z\"},{\"versionDisplay\":\"1.5.7.1\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\r\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\r\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\\r\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\\r\",\"releaseDate\":\"2023-11-21\",\"releaseTimestamp\":\"2023-11-21T11:05:16Z\"},{\"versionDisplay\":\"1.5.7\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\",\"releaseDate\":\"2023-11-07\",\"releaseTimestamp\":\"2023-11-07T08:08:58Z\"},{\"versionDisplay\":\"1.5.6.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T07:36:26Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"1. New Room Prop - Magic Card is coming! Send it to each other in chatroom and it will be displayed on mic after sending!\\r\\n2. Quick Reply - Quick Reply in chatroom is available now. Reply directly to keep the relationship closer! \\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T01:37:00Z\"},{\"versionDisplay\":\"1.5.5\",\"releaseNotes\":\"1. Master Match - Engage in a thrilling competition and showcase your skills alongside the world's best Baloot players!\\r\\n2. World Top List - Work your way up the World Top Ranking List by earning points through competitive play in game. Only the best will reach the top!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-08-23\",\"releaseTimestamp\":\"2023-08-23T01:33:22Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-06-13\",\"releaseTimestamp\":\"2023-06-13T12:07:16Z\"},{\"versionDisplay\":\"1.5.3\",\"releaseNotes\":\"1. Game Sharing - Improved the sharing feature to help you easily showcase accomplishments with friends!\\n2. Chatroom Upgrade - Enjoy the newly added personal gift lists, which showcase leaderboards for sent and received gifts!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T07:06:49Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"1. Achievement Badges - Earn achievements to unlock badges, and show off your collection by wearing them!\\r\\n2. Chatroom Update - Member club feature added. Join with friends and make your room the most popular!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\"},{\"versionDisplay\":\"1.5.1.1\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"1. Upgraded Challenge - Two challenge matches of different levels have been added, giving users more exciting games to enjoy! \\r\\n2. Interface Optimization - Buttons on the main interface have been optimized to improve the user experience!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1. Chatrooms – Experience the newly added chatrooms! Create your own room or join a public one and make new friends! \\r\\n2. Upgraded Global Chat - Experience a smoother global chat with newly added message notifications! \\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\"},{\"versionDisplay\":\"1.4.9.11\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T01:50:12Z\"},{\"versionDisplay\":\"1.4.9.10\",\"releaseNotes\":\"1. New Game Rule - Enjoy the most authentic Baloot experience with the newly added \\\"Gaid\\\" rules in the Public Room!\\r\\n2. Chat Bubbles – Show off your bubble collection by using personalized chat bubbles!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\"