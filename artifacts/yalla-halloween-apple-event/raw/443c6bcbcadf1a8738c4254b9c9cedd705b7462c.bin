\u0026pricingParameters=STDQ\u0026pg=default\u0026offerName=com.yalla.apple.monthlycard.one\u0026appAdamId=1091902866\",\"type\":\"buy\",\"priceFormatted\":\"AED 49.99\",\"price\":49.99,\"priceString\":\"49.99\",\"currencyCode\":\"AED\",\"assets\":[]}],\"isSubscription\":false,\"offerName\":\"com.yalla.apple.monthlycard.one\",\"isMerchandisedVisibleByDefault\":false,\"isFamilyShareable\":false,\"releaseDate\":\"2009-06-17\",\"editorialArtwork\":{},\"isMerchandisedEnabled\":false,\"name\":\"Month Card\",\"description\":{\"standard\":\"Get a total of 2000 golds across 30 days\"},\"icuLocale\":\"en_AE@currency=AED\",\"url\":\"https://apps.apple.com/ae/app/month-card/id1091902866\"}},{\"id\":\"1567843595\",\"type\":\"in-apps\",\"href\":\"/v1/catalog/ae/in-apps/1567843595?l=en-GB\",\"attributes\":{\"offers\":[{\"buyParams\":\"productType=A\u0026price=149990\u0026salableAdamId=1567843595\u0026pricingParameters=STDQ\u0026pg=default\u0026offerName=com.weieyu.yalla.membership.two\u0026appAdamId=1091902866\",\"type\":\"buy\",\"priceFormatted\":\"AED 149.99\",\"price\":149.99,\"priceString\":\"149.99\",\"currencyCode\":\"AED\",\"assets\":[],\"recurringSubscriptionPeriod\":\"P1M\"}],\"subscriptionFamilyRank\":1,\"subscriptionFamilyName\":\"Yalla Premium Monthly Subscription\",\"offerName\":\"com.weieyu.yalla.membership.two\",\"releaseDate\":\"2009-06-17\",\"isMerchandisedEnabled\":false,\"description\":{\"standard\":\"Get monthly 4500 gold coins \u0026 many privileges\"},\"subscriptionFamilyId\":\"20608200\",\"icuLocale\":\"en_AE@currency=AED\",\"url\":\"https://apps.apple.com/ae/app/knight-premium-membership/id1091902866\",\"isSubscription\":true,\"isMerchandisedVisibleByDefault\":false,\"isFamilyShareable\":false,\"editorialArtwork\":{},\"name\":\"Knight - Premium Membership\"}}]},\"developer-other-apps\":{\"href\":\"/v1/catalog/ae/apps/1091902866/developer-other-apps?l=en-GB\",\"data\":[{\"id\":\"1419536376\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1419536376?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":5,\"genreName\":\"Family\",\"genre\":7009,\"chart\":\"top-free\",\"genreShortName\":\"Family\",\"chartLink\":\"https://apps.apple.com/ae/charts/iphone/family-games/7009\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/yalla-ludo-ludo-jackaroo/id1419536376\",\"userRating\":{\"value\":4.4,\"ratingCount\":4887,\"ratingCountList\":[453,143,168,321,3802],\"ariaLabelForRatings\":\"4.4 stars\"},\"genreDisplayName\":\"Board\",\"name\":\"Yalla Ludo - Ludo\u0026Jackaroo\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 13.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Yalla Ludo is a vibrant app that fuses classic board games—Ludo, Jackaroo, and Domino—with real-time voice chat! Whether you're in the mood for gameplay or hoping to connect with new friends in a lively voice chat room, Yalla Ludo delivers a truly immersive experience.\\n\\n[Voice Chat with Friends]\\nEnjoy real-time voice chat that lets you share tips and tricks with fellow gamers anytime, anywhere. Make new friends while having fun! Add personality to your gameplay with expressive voice chat.\\n\\n[Various Game Modes]\\nLudo: Choose between 2\u00264 Players mode and Team mode. Each mode has 4 gameplays: Classic, Master, Quick, and Arrow. You can also use Magic tools to make the game more fun! \\nDomino: Play in 2\u00264 Players mode, each featuring two gameplays: Draw Game and All Five.\\nOthers: More new games are waiting for you.\\n\\n[Brand New Jackaroo]\\nGet ready for fast-paced Jackaroo gameplay! Pick from a variety of game modes (Basic, Complex, and Quick), and team up with friends to claim victory. Make your moves even more fun by expressing yourself with lively game stickers!\\n\\n[Voice Chat Room]\\nJoin the global public chat room, where you can connect with people from all over the world. Chat freely, share ideas, and send cute gifts! Broaden your network of friends and enjoy a relaxing time.\\n\\n[Generous Rewards Await You]\\nYalla Ludo offers multiple daily activities. Complete game or chat room tasks to earn various rewards (such as golds, diamonds, skin fragments, and gifts, etc). With daily tasks and arrival chests, you'll always find something exciting!\\n\\nYalla Ludo connects you with others, so let's enjoy the joyful moments in Yalla Ludo!\\n\\nSubscribe to Yalla Ludo VIP to enjoy the extra advanced features:\\nCollect free daily golds, diamonds, and VIP daily benefits.\\nPrivileged game room: create your room in the VIP room, invite others to play together, and have more options for bets.\\n-----------------------------------\\nIf you choose to subscribe to Yalla Ludo VIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nLudo VIP includes two types: Knight and Baron. The price for Knight is USD 11.99/month and the price for Baron is USD 39.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo without becoming a Yalla Ludo VIP.\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\nPrivacy Policy: https://www.yallaludo.com/term/EN/TermOfService.html\\nTerms of Service: https://www.yallaludo.com/term/EN/TermOfService.html#TermsOfService\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.yallaludo.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.4.4.0\",\"releaseNotes\":\"Updates:\\n1.  New Quick Gameplay in Jackaroo Complex – Win by moving just two stones to the end! Team up with your friends for fast-paced, thrilling gameplay now!\\n2.  Dice Exhibition Now Available – Go to your profile page to set your favorite dice and showcase your unique style!\\n3.  New \\\"Buy the Same Skin\\\" Feature – Have you ever admired someone else's cool skin? Now you can buy the same one in-game!\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2025-07-30\",\"releaseTimestamp\":\"2025-07-30T02:13:56Z\"},{\"versionDisplay\":\"1.4.3.1\",\"releaseNotes\":\"Updates:\\n1. Game experience optimization and bug fixes.\\n \\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2025-07-16\",\"releaseTimestamp\":\"2025-07-16T12:09:18Z\"},{\"versionDisplay\":\"1.4.3.0\",\"releaseNotes\":\"Updates:\\n1. A new game - Jackaroo is now live! Team up with friends \u0026 race to victory! It's all about smart moves and seamless cooperation with friends via real-time chat!\\n2. Added daily limited gifts in the chat room. Check out the Daily Limited Shop to discover new exclusive gifts refreshed daily. Buy something cool before they're gone!\\n3. New mini-games are available! Tic Tac Toe and Football games just dropped in Fun Center! Challenge your buddies to a quick match in your room. \\n\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2025-06-09\",\"releaseTimestamp\":\"2025-06-09T10:06:13Z\"},{\"versionDisplay\":\"1.4.2.3\",\"releaseNotes\":\"Updates:\\r\\n1.Ramadan is coming, and with it comes an exclusive Ramadan-themed app icon and splash screen. Stay tuned for our Ramadan activities!\\r\\n2.Bug fixed\\r\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2025-02-18\",\"releaseTimestamp\":\"2025-02-18T10:00:24Z\"},{\"versionDisplay\":\"1.4.2.2\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2025-01-23\",\"releaseTimestamp\":\"2025-01-23T01:59:00Z\"},{\"versionDisplay\":\"1.4.2.1\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-12-23\",\"releaseTimestamp\":\"2024-12-23T01:51:50Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"Updates:\\r\\n1.New Royal Privileges: You can customize the room theme. Moreover, you can also set the room theme image you uploaded as the background for private chats. Go try it out now~\\r\\n2.Brand new items: Room entry effects. Use them to match your vehicles and become a superstar in the room.\\r\\n3.New ranking - Room Likes Ranking List is here! Give Likes to your favorite rooms and help them get on the list.\\r\\n \\r\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-12-05\",\"releaseTimestamp\":\"2024-12-05T08:52:18Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"Updates:\\n1. Royal 5 Super Privileges are coming: Exclusive skins, vehicles, profile cards, and other privileges!\\n2. Sign-in benefits: The higher your level, the more sign-in rewards you can collect daily.\\n3. Feed list for chat rooms is coming soon.\\n4. Fixed the issue of being unable to log in to the game with X account and optimized the gaming experience. \\n\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T00:01:14Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"Updates:\\n1. Great news! The Royal Level has been upgraded to include Holiday Surprises and the Fortune Store. Claim holiday rewards and redeem exclusive skins and items with Fortune Coins.\\n2. Skin Fragments Exchange: Now you can exchange your excess skin fragments for higher-tier skins or golds.\\n3. Room Battle mode is coming soon: Join your preferred team within rooms. Try to win more battle points to earn glory.\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-07-17\",\"releaseTimestamp\":\"2024-07-17T08:00:43Z\"},{\"versionDisplay\":\"1.3.9.5\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-06-18\",\"releaseTimestamp\":\"2024-06-18T06:02:54Z\"},{\"versionDisplay\":\"1.3.9.4\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-05-28\",\"releaseTimestamp\":\"2024-05-28T10:06:58Z\"},{\"versionDisplay\":\"1.3.9.3\",\"releaseNotes\":\"Updates:\\r\\n1.Great news! Unique IDs now include new animation effects and extra 8-digit IDs. You can purchase and switch Unique IDs more easily. \\r\\n2.Color-customized gifts are now available. You can customize the gift color to your liking!\\r\\n3. Mic numbers have increased. A mode with 15 microphones is now available. Invite more friends on the mic to chat and enjoy more fun!\\r\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-05-09\",\"releaseTimestamp\":\"2024-05-09T02:34:28Z\"},{\"versionDisplay\":\"1.3.9.2\",\"releaseNotes\":\"Updates:\\r\\n1. Get ready for Jungle Ludo! The jungle is packed with secrets and spectacular items. Warriors, gear up for some adventures!\\r\\n \\r\\n2. Double-tap to like a Chat Room! Want to show some love? Just double-tap on an empty spot in the room. The more taps, the bigger the combo effects. Help your favorite rooms shine!\\r\\n \\r\\n3. Introducing Crocodile Dentist, a new mini-game, in chat rooms! Gather your friends for a game, take turns, and see who’s daring enough to face the bite. Who will it be?\\r\\n \\r\\nRamadan's Coming! We've got lots of new stuff for you to check out and enjoy. Stay tuned!\",\"releaseDate\":\"2024-03-07\",\"releaseTimestamp\":\"2024-03-07T01:59:54Z\"},{\"versionDisplay\":\"1.3.9.1\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-01-18\",\"releaseTimestamp\":\"2024-01-18T06:43:30Z\"},{\"versionDisplay\":\"1.3.9.0\",\"releaseNotes\":\"Updates:\\r\\n1. Introducing a brand-new profile page! Decorate your profile page with ornaments, profile themes, and profile cards to express your personality. Explore additional details such as game records, gift walls, and badges when you visit your profile page.\\r\\n\\r\\n2. Visit the Rank list to view the Achievement badge wall. Check out the rankings and see who's on top.\\r\\n\\r\\n3. We've added Gift Scoring to the chat room! Earn points by receiving gifts while on the mic. Come and give it a try!\\r\\n\\r\\nThe 5th anniversary is approaching! Take a look at our new logo, launch page, and background image. Join us for our anniversary celebration. There's more content for you to explore and enjoy!\",\"releaseDate\":\"2023-12-26\",\"releaseTimestamp\":\"2023-12-26T00:35:11Z\"},{\"versionDisplay\":\"1.3.8.2\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-11-16\",\"releaseTimestamp\":\"2023-11-16T07:15:51Z\"},{\"versionDisplay\":\"1.3.8.1\",\"releaseNotes\":\"Updates:\\r\\n1. Fixed X login issues and game experience optimization.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-10-20\",\"releaseTimestamp\":\"2023-10-20T00:59:47Z\"},{\"versionDisplay\":\"1.3.8.0\",\"releaseNotes\":\"Updates:\\n1. Generous Login Rewards: Log in monthly for profile frames and collect 12 months to unlock a bonus permanent limited profile frame.\\n2. Room Activity Notice: Create notices for activities and invite others to join your party.\\n3. Personalized Playlists: Take control of your music with our playlist management feature. Organize your favorite songs effortlessly.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-09-25\",\"releaseTimestamp\":\"2023-09-25T02:51:33Z\"},{\"versionDisplay\":\"1.3.7.0\",\"releaseNotes\":\"Updates:\\n1. Fight Ludo - Kill the maximum tokens within a specific time limit and emerge as the champion!\\n2. Happy Birthday - Set your birthday, and come to Yalla Ludo on your birthday to collect gifts and throw joyous parties in the room! \\n3. Room Pass - Engage with your friends in the room for a chance to win special rewards! (Refreshed every 14 days)\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T02:31:32Z\"},{\"versionDisplay\":\"1.3.6.0\",\"releaseNotes\":\"Updates:\\r\\n1. Elite Rewards Tower - Unlock the Elite Reward Tower to receive even more rewards!\\r\\n2. New Stickers - Utilize stickers in games, private conversations, and chat rooms!\\r\\n3. Personalized Gifts - Send gifts that feature recipients' profile pictures to show your appreciation!\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T01:33:00Z\"},{\"versionDisplay\":\"1.3.5.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T10:38:09Z\"},{\"versionDisplay\":\"1.3.5.0\",\"releaseNotes\":\"Updates:\\r\\n1. Ramadan UI Design - Enjoy the new user interface designed for Ramadan and celebrate together!\\r\\n2. Arrow Mode - Experience a new game mode in Ludo that is more exciting!\\r\\n3. Higher Max Level - Play games to reach a higher max level of 80 at an optimized upgrade speed!\",\"releaseDate\":\"2023-03-17\",\"releaseTimestamp\":\"2023-03-17T06:26:34Z\"},{\"versionDisplay\":\"1.3.4.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T10:53:16Z\"},{\"versionDisplay\":\"1.3.4.0\",\"releaseNotes\":\"Updates:\\r\\n1. Snakes \u0026 Ladders - Enjoy the newly added classic game of Snakes \u0026 Ladders. You'll love the excitement and thrill of this timeless game!\\r\\n2. Champion Challenge - Get ready for the new Domino Champion Challenge! Play now and win free Domino skins!\\r\\n3. Random Wheel – This newly added mini-game lets you spin the wheel to have more fun with friends in the chat rooms!\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T01:57:38Z\"},{\"versionDisplay\":\"1.3.3.0\",\"releaseNotes\":\"Updates:\\r\\n1. Optimized Royal Privilege - You can choose the room theme you like as the private chat theme;\\r\\n2. Optimized Restart the Journey - More missions are waiting for you to explore;\\r\\n3. Added Backpack System - You can obtain gifts and magic cards in the backpacks through activities and tasks.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T05:47:02Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"editorialNotes\":{\"short\":\"Every day brings new rewards, just complete your tasks.\",\"tagline\":\"It's in the Cards\"},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=876464234\",\"type\":\"get\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":354531328}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=876464234\",\"type\":\"update\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":354531328}]}],\"requires32bit\":false,\"releaseDate\":\"2019-01-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallagame\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/5a/ea/74/5aea74b7-10d6-5174-3def-d8e12afb8b27/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"4b3175\",\"textColor1\":\"ebecf4\",\"textColor2\":\"96d4de\",\"textColor3\":\"cbc6db\",\"textColor4\":\"87b3c9\"},\"privacyPolicyUrl\":\"https://www.yallaludo.com/term/EN/TermOfService.html#TermsOfService\",\"videoPreviewsByType\":{\"iphone_d74\":[{\"previewFrame\":{\"width\":886,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo211/v4/da/f8/7f/daf87f81-b9a4-bdc0-c22d-67dad598e3f6/Job33e97c80-f627-4f4a-835e-6e413d09d050-198747139-PreviewImage_Preview_Image_Intermediate_nonvideo_389030263_2270672900-Time1753795358608.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f9fbfc\",\"textColor1\":\"4a1616\",\"textColor2\":\"5f1719\",\"textColor3\":\"6d4344\",\"textColor4\":\"7e4546\"},\"video\":\"https://apptrail