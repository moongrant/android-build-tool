\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d7/85/21/d785215f-4de1-6a7d-98c1-709ad70041da/_U53d7_U6b22_U8fce_U7684Parchis_U6e38_U620f1.png/{w}x{h}{c}.{f}\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/b2/0a/e6/b20ae667-76d5-949c-013a-21c8db04aa7d/_U5b9e_U65f6_U5728_U7ebf_U8bed_U97f3__U89c6_U9891_U804a_U5929_U5ba46.png/{w}x{h}{c}.{f}\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/f8/af/60/f8af6029-e058-51dc-18bc-7e044f8229cf/_U6392_U884c_U699c7.png/{w}x{h}{c}.{f}\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/09/d4/ff/09d4ff8a-d784-4317-2209-7cdae1ca4508/_U6bcf_U65e5_U8d85_U591a_U514d_U8d39_U91d1_U5e01_U53ef_U98865.png/{w}x{h}{c}.{f}\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/91/dc/33/91dc33a1-b526-9877-610c-95bd1d4445b3/_U751f_U52a8_U7684_U4e3b_U9898_U80cc_U666f_U548c_U76ae_U80a44.png/{w}x{h}{c}.{f}\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/c3/93/74/c39374b1-70ab-d878-2a04-d5b892482052/_U4e0e_U597d_U53cb_U7545_U73a9_U6e38_U620f3.png/{w}x{h}{c}.{f}\"}],\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/80/aa/b6/80aab6fa-c14e-2cfa-7e48-5232b18d039a/7e8260a6-4b55-420f-a442-9749408cbde4__U6e38_U620f_U5185.png/{w}x{h}{c}.{f}\",\"bgColor\":\"451b32\",\"textColor1\":\"ffffff\",\"textColor2\":\"fca800\",\"textColor3\":\"d9d1d6\",\"textColor4\":\"d78c0a\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/80/5a/25/805a2547-5ee8-c0b4-3cbd-f6aa3125a5b6/73dcddc0-4a2b-4a16-bf35-461ad4a3d456__U8bed_U97f3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"4b1f3c\",\"textColor1\":\"e8e6e8\",\"textColor2\":\"0cbaea\",\"textColor3\":\"c8bec5\",\"textColo