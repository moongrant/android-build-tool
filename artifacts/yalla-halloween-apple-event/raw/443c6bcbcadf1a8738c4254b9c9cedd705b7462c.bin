,\"url\":\"https://itunes.apple.com/ae/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6005\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1752755345989,\"RTCI\":1753894737803}}},{\"id\":\"1534252521\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1534252521?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Simulated Gambling\",\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Realistic Violence\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/4fun-live-voice-play-ludo/id1534252521\",\"userRating\":{\"value\":4.3,\"ratingCount\":35,\"ratingCountList\":[4,2,1,2,26],\"ariaLabelForRatings\":\"4.3 stars\"},\"genreDisplayName\":\"Entertainment\",\"name\":\"4Fun - Live Voice, Play Ludo\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"SPREADFUN\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"The app that people in Saudi Arabia and the UAE are paying attention to! 4Fun is a popular group voice chat app for arabs in KSA and UAE.\\n\\n\\nRAMADAN KAREEM! As Ramadhan approaches, 4Fun will add audio rooms for Quran recitation, hadith explanation, charity, zakat, and Ramadan content. Let's spend Ramadan online together, enjoy the peaceful Ramadan, and relax yourself.\\n\\n\\nRecommended community to make friends:\\nExplore friends and chat rooms that interest you. Make friends with interesting souls through your voice. It's a safe, warm and stress-free community.\\n\\n\\nOnline Party to entertain with your friends:\\nWhy not try to have a fun online party? You can chat with friends of the arab world anytime and anywhere about hot trends, emotions, fashion, football, work...\\n\\n\\nPlay Mdagsh with your friends:\\nMdagsh is a local KSA game. In the game, the banker need to choose question other players or not according to their own cards, while other players can choose to accept or increase. They compare the cards to decide which one is the winner, it’s depends on luck and their choices.\\n\\n\\nVarious Games that Saudis are playing:\\nLudo, , Uno……Nearly 10 popular local games for you to choose from! 4fun provides everyone with a wonderful gaming world.\\n\\n\\nFEATURES:\\n\\nMAKE FRIENDS- Meet friends that suit you instantly and easily! Friends are crowded into ROOMs, MOMENT \u0026 PRIVATE CHAT. On 4Fun, you never know who you might meet!\\n\\nDELICATE DESIGN- Stunning animated gifts, vehicles, headwears for you to show your taste and personality.\\n\\nUNIQUE HONOR-Special id, beautiful badges, SVIP, luxury ranking, Customized Gifts for you to show your uniqueness.\\n\\nROOM PARTY-Attend parties with different themes: Chat, Singles Club, Couples, Girls, Travel, AFC.\\n\\nGAMES- Play games with different arabs!\\n\\nMessage us: support@spread-fun.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://home.spread-fun.com\",\"versionHistory\":[{\"versionDisplay\":\"2.4.6\",\"releaseNotes\":\"User experience optimization\",\"releaseDate\":\"2025-07-19\",\"releaseTimestamp\":\"2025-07-19T16:13:24Z\"},{\"versionDisplay\":\"2.4.5\",\"releaseNotes\":\"User experience optimization\",\"releaseDate\":\"2025-07-12\",\"releaseTimestamp\":\"2025-07-12T08:06:14Z\"},{\"versionDisplay\":\"2.4.4\",\"releaseNotes\":\"User experience optimization\",\"releaseDate\":\"2025-07-07\",\"releaseTimestamp\":\"2025-07-07T02:27:17Z\"},{\"versionDisplay\":\"2.4.3\",\"releaseNotes\":\"उपयोगकर्ता अनुभव में सुधार करें\",\"releaseDate\":\"2025-07-02\",\"releaseTimestamp\":\"2025-07-02T14:24:53Z\"},{\"versionDisplay\":\"2.4.2\",\"releaseNotes\":\"User experience optimization\",\"releaseDate\":\"2025-06-30\",\"releaseTimestamp\":\"2025-06-30T02:06:42Z\"},{\"versionDisplay\":\"2.4.1\",\"releaseNotes\":\"User experience optimization\",\"releaseDate\":\"2025-06-16\",\"releaseTimestamp\":\"2025-06-16T04:09:22Z\"},{\"versionDisplay\":\"2.4.0\",\"releaseNot