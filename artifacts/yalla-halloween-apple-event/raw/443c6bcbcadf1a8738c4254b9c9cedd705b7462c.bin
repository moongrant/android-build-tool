22166?l=en-GB\",\"attributes\":{\"name\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"mediaType\":\"Mobile Software Applications\",\"genreNames\":[],\"editorialArtwork\":{},\"url\":\"https://apps.apple.com/ae/developer/shenzhen-yinguo-network-technology-co-ltd/id1560122166\"}}]},\"genres\":{\"href\":\"/v1/catalog/ae/apps/1560121894/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6005\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1754100036813,\"RTCI\":1753897978462}}},{\"id\":\"1317217120\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1317217120?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/starchat-group-voice-chat-room/id1317217120\",\"userRating\":{\"value\":4.1,\"ratingCount\":170,\"ratingCountList\":[27,6,8,3,126],\"ariaLabelForRatings\":\"4.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"genreDisplayName\":\"Entertainment\",\"name\":\"StarChat-Group Voice Chat Room\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Star Chat International Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nStarChat provides a variety of in-app purchases and subscriptions.If you choose to purchase an StarChat subscription,payment will be charged to your iTunes account after purchase confirmation.Your account will be charged the subscription amount within 24-hours prior to the end of the currnent period unless auto-renewal is turned off.Auto-renewal may be turned off at any time by going to your settings in the iTunes Store after purchase.\\n\\nPrivacy Policy：https://www.starchat.live/help/policy/Privacy_Policy.html\\nTerms of Service：https://www.starchat.live/help/policy/Terms_of_Service.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"http://www.starchat.live\",\"versionHistory\":[{\"versionDisplay\":\"8.27.2\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2025-07-23\",\"releaseTimestamp\":\"2025-07-23T16:59:31Z\"},{\"versionDisplay\":\"8.27.1\",\"releaseNotes\":\"1. Fix several 