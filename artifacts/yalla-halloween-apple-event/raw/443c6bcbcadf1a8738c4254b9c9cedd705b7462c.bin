r\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humour\",\"Unrestricted Web Access\",\"Frequent/Intense Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.4,\"ratingCount\":239,\"ratingCountList\":[14,13,13,15,184],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Falla-Make new friends\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"9.1.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-07-30\",\"releaseTimestamp\":\"2025-07-30T02:33:43Z\"},{\"versionDisplay\":\"9.0.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-07-14\",\"releaseTimestamp\":\"2025-07-14T02:18:42Z\"},{\"versionDisplay\":\"8.9.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-06-28\",\"releaseTimestamp\":\"2025-06-28T05:00:04Z\"},{\"versionDisplay\":\"8.9.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-06-20\",\"releaseTimestamp\":\"2025-06-20T02:33:48Z\"},{\"versionDisplay\":\"8.8.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-05-26\",\"releaseTimestamp\":\"2025-05-26T06:50:40Z\"},{\"versionDisplay\":\"8.7.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-04-29\",\"releaseTimestamp\":\"2025-04-29T02:15:14Z\"},{\"versionDisplay\":\"8.6.2\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-04-24\",\"releaseTimestamp\":\"2025-04-24T02:25:29Z\"},{\"versionDisplay\":\"8.6.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-04-18\",\