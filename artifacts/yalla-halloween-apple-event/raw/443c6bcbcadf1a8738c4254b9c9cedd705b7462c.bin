/3a/10763abb-d2b3-bc74-e4f4-40f380884a65/6.png/{w}x{h}{c}.{f}\"},{\"width\":1290,\"height\":2796,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/e1/99/7a/e1997ad2-394b-96c9-2c14-4224b9d009b2/7.png/{w}x{h}{c}.{f}\"}]},\"customVideoPreviewsByType\":{}}}}}},\"fileSizeByDevice\":{\"iPad14,11\":292530176,\"iPhone13,4\":292501504,\"iPad14,10\":292530176,\"iPhone13,3\":292501504,\"iPhone13,2\":292501504,\"iPhone13,1\":292501504,\"iPad8,12\":292530176,\"iPad8,11\":292530176,\"iPad8,10\":292530176,\"iPhone17,4\":292501504,\"iPad14,6-A\":292530176,\"iPhone17,3\":292501504,\"iPhone17,2\":292501504,\"iPhone17,1\":292501504,\"iPad14,6-B\":292530176,\"iPhone17,5\":292501504,\"iPad16,6-B\":292530176,\"iPad7,6\":292530176,\"iPad7,5\":292530176,\"iPad7,4\":292530176,\"iPad16,6-A\":292530176,\"iPad7,3\":292530176,\"iPad7,2\":292530176,\"RealityFamily22,1\":292530176,\"iPad7,1\":292530176,\"iPad14,8\":292530176,\"iPad14,9\":292530176,\"iPad14,1\":292530176,\"iPad14,2\":292530176,\"iPhone12,1\":292497408,\"iPhone9,4\":292501504,\"iPhone9,2\":292501504,\"iPhone16,1\":292501504,\"iPhone12,5\":292501504,\"iPhone9,3\":292419584,\"iPhone12,3\":292501504,\"iPhone9,1\":292419584,\"iPad7,12\":292530176,\"iPhone12,8\":292419584,\"iPad14,3-A\":292530176,\"iPad14,3-B\":292530176,\"iPhone16,2\":292501504,\"iPad8,5\":292530176,\"iPad8,4\":292530176,\"iPad8,3\":292530176,\"iPad11,1\":292530176,\"iPad8,2\":292530176,\"iPad16,3-A\":292530176,\"iPad8,1\":292530176,\"iPad16,3-B\":292530176,\"iPad8,9\":292530176,\"iPad8,8\":292530176,\"iPad8,7\":292530176,\"iPad8,6\":292530176,\"iPad7,11\":292530176,\"iPad15,6\":292530176,\"iPad15,7\":292530176,\"iPad15,8\":292530176,\"iPad11,6\":292530176,\"iPad15,3\":292530176,\"iPad11,7\":292530176,\"iPad15,4\":292530176,\"iPad15,5\":292530176,\"iPad11,2\":292530176,\"iPad11,3\":292530176,\"iPad11,4\":292530176,\"iPhone11,2\":292501504,\"iPhone11,6\":292501504,\"iPhone15,2\":292501504,\"iPhone8,4\":292419584,\"iPhone11,4\":292501504,\"iPhone8,1\"