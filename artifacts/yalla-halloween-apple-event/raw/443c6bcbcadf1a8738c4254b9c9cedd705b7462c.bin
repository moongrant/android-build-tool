rRating\":{\"value\":4.7,\"ratingCount\":74,\"ratingCountList\":[4,0,1,4,65],\"ariaLabelForRatings\":\"4.7 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Yalla Lite - Group Voice Chat\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Lite is the lightweight version of Yalla, which is the most popular Live Group Voice Talking and Entertaining Community.\\n\\nAdvantages of Yalla Lite:\\n- Less Size: Faster to install and saves space on your phone\\n- Faster Speed: Enjoy classic features at a faster speed\\n\\nMeet new friends is never easier:\\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries have already been covered, while tons of topics are available to choose from.\\n\\nParty with friends with no distance:\\nGroup voice talk with friends no matter where they are, broadcast your favorite music inside the room, sing karaoke together, and play a range of games directly in group chat. Let's get the party started.\\n\\nFEATURES:\\n\\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE, or Wi-Fi.\\n\\nPUBLIC CHAT ROOMS — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \\n\\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\\n\\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\\n\\nFollow us to get the latest news, updates and events:\\nWebsite: www.yalla.live\\n\\nDear users, your feedback and suggestions are welcomed to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-02-23\",\"releaseTimestamp\":\"2025-02-23T06:09:45Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-07-29\",\"releaseTimestamp\":\"2024-07-29T01:36:34Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-05-20\",\"releaseTimestamp\":\"2024-05-20T01:48:39Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T01:50:27Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-07-12\",\"releaseTimestamp\":\"2023-07-12T01:34:52Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2022-07-12\",\"releaseTimestamp\":\"2022-07-12T01:49:57Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"1. تمت إضافة عنصر جديد في المتجر: أي دي غرفة مميز.\\r\\n2. يمكنك تغيير اسم العرض لأصدقائك حتى تتمكن من التعرف عليهم بسهولة.\\r\\n3. يمكنك الآن تعيين سعر محدد ونطاق عدد لرقم الحظ في غرفتك.\\r\\n4. يمكنك الآن إرفاق ما يصل إلى 3 لقطات شاشة في وقت واحد عند إرسال اشتكاء أو الأسئلة الشائعة والانطباعات.\\r\\n5. تحسينات أخرى في الأداء.\\r\\n\\n1. Added a new item in the store: Unique Room ID\\n2. You can change the display name for your friends so you can easily recognize them.\\n3. You can now set the price and number range of Lucky Number in your room.\\n4. You can now attach up to 3 screenshots at a time when submitting report or feedback.\\n5. Other performance improvements.\",\"releaseDate\":\"2020-09-28\",\"releaseTimestamp\":\"2020-09-28T02:10:53Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"1. يحتوي مشغل موسيقى الغرفة الآن على شريط تحكم وزر تكرار الأغنية. \\r\\n2. تباع الآن أقفال الغرفة كعناصر اشتراك. \\r\\n3. يتم عرض أسعار عمليات الشراء داخل التطبيق بالعملة المحلية. \\r\\n4. تحسينات الأداء الأخرى\\n\\n1. The room music player now has a seekbar and a song repeat button.\\n2. Room locks are now sold as subscription items.\\n3. Prices for in-app purchases are displayed in local currency. \\n4. Other performance improvements.\\n\",\"releaseDate\":\"2020-06-22\",\"releaseTimestamp\":\"2020-06-22T01:52:12Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2020-01-14\",\"releaseTimestamp\":\"2020-01-14T01:54:01Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2020-01-06\",\"releaseTimestamp\":\"2020-01-06T01:51:21Z\"}],\"websiteUrl\":\"https://www.yalla.live\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1488887716\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=872559723\",\"type\":\"get\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":97649664}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1488887716\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=872559723\",\"type\":\"update\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":97649664}]}],\"requires32bit\":false,\"releaseDate\":\"2020-01-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallalite\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/cc/51/0e/cc510ebc-8a76-84e7-a9e3-50e857a12c3f/AppIcon-1x_U007emarketing-0-5-0-0-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00d8c8\",\"textColor1\":\"161616\",\"textColor2\":\"161616\",\"textColor3\":\"113d3a\",\"textColor4\":\"113d3a\"},\"privacyPolicyUrl\":\"https://liteapi.yalla.live/web/Agreement.html\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"supportURLForLanguage\":\"https://www.yalla.live\",\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features122/v4/fc/66/99/fc6699fa-3d54-7d24-9d78-7ab18d2a6b62/cbf2b92a-fdd8-46b1-bb83-f0087c93f7ea.png/{w}x{h}sr.{f}\",\"bgColor\":\"acf9c1\",\"textColor1\":\"031110\",\"textColor2\":\"0a100f\",\"textColor3\":\"1d332a\",\"textColor4\":\"21332a\"},\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":758,\"height\":1080,\"url\":\"htt