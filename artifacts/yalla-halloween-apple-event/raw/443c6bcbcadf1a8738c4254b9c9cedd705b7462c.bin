Color2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"url\":\"https://apps.apple.com/ae/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/ae/apps/6444792857/genres?l=en-GB\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6014?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6014\"}},{\"id\":\"7003\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/7003?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Casual\",\"url\":\"https://itunes.apple.com/ae/genre/id7003\",\"parentId\":\"6014\"}},{\"id\":\"7012\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/7012?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Puzzle\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/ae/genre/id7012\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1752720246728,\"RTCI\":1753905044916}}},{\"id\":\"1542713951\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1542713951?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/yalla-parchis/id1542713951\",\"userRating\":{\"value\":4.8,\"ratingCount\":4,\"ratingCountList\":[0,0,0,1,3],\"ariaLabelForRatings\":\"4.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0.4\",\"name\":\"Yalla Parchis\",\"genreDisplayName\":\"Board\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Parchis is a free online multiplayer Parchis game, Parchis is a very popular board game, especially in Spain and Latin America. The rules of the game evolved from Ludo, Parchisi and Parcheesi.\\n\\nFeatures:\\n\\n1. Multiple Parchis rules \u0026 modes - There are four rules: Classic, Spanish, Quick and Magic, and you can choose to play in 1v1, 4 players or in teams(2v2). \\n2. In-game voice chat \u0026 chat room - We offer a high-quality social experience where you can voice chat in real-time during the game and use the chat room function to chat with audio and video, send gifts, play games, and host parties with your friends in the room. Everyone here is friendly.\\n3. Collect diverse skins - Play for free and get a variety of skins of dice, theme, token, etc.\\n4. Various events - Festive events with local characteristics are held regularly.\\n5. Up to 30K free Golds every day.\\n\\nIn America and Spain, Parchisi is played with two dice, four tokens per player, and the first player who moves four tokens to the end wins. In Colombia, the Parchis board game is also called \\\"Parqués\\\".\\nAs one of the most popular Parchis games, we are not only committed to bringing the classic Parchis gameplay from memory to online, but also to innovating while respecting tradition.\\nOn the subway, in the park, at home, at any time and place, you can quickly start an amazing Parchis journey and make new friends in chat rooms, from online to offline. If you are looking for a high-quality casual game to enjoy your leisure time, Yalla Parchis will never disappoint you.\\n\\nEnjoy life, enjoy online Parchis!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"versionHistory\":[{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.New Royal system unleashed and more exclusive privileges await!\\n2.Experience Optimizations \u0026 Bug Fixes​.\",\"releaseDate\":\"2025-07-21\",\"releaseTimestamp\":\"2025-07-21T13:33:40Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. Intimacy System:​​ Come see how close you and your friends really are! \\r\\n2. ​​Friend Assistance:​​ Friends can help reduce your chest opening time!\\r\\n3. ​​Spectator Gifting:​​ Now you can cheer on your favorite players sending them gifts in the game broadcast!\\r\\n4. ​​Experience Optimizations \u0026 Bug Fixes​.\",\"releaseDate\":\"2025-06-01\",\"releaseTimestamp\":\"2025-06-01T02:56:52Z\"},{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. Fancy designs can be unlocked more easily: Higher entry fees grant better skin reward chests. Plus, some skin fragments are now available for instant purchase.\\n2.Game props storage: more new props with easier management!\\n3. Chatroom Bingo Party: venture to try your fortunes!\\n4.Game broadcast list: swipe through the vertical feed to find your favorite game streamer!\",\"releaseDate\":\"2025-04-07\",\"releaseTimestamp\":\"2025-04-07T06:57:47Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. New Offer for Beginners: a new token skin is waiting for you.\\n2. The games in chatrooms have been optimized.\\n3. Bugs fixed.\",\"releaseDate\":\"2025-01-20\",\"releaseTimestamp\":\"2025-01-20T15:31:43Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.The Store has been updated! Exciting items as UNDO Card are prepared for you!\\n2.More exclusive gifts and privileges are added for Club Members.\\n3.New exclusive privilege is added for the most generous sender of Weekly Gifts!\\n4.The experience has been optimized and bugs have been fixed.\",\"releaseDate\":\"2025-01-03\",\"releaseTimestamp\":\"2025-01-03T01:50:19Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.A new free Bingo game is added to the chatroom, where you can customize the numbers on the cards. Come play with your friends!\\n2.The step indicator feature is optimized for better clarity.\\n3.A new room mode is added. Come try out the new effects on the seats!\\n4.The experience has been optimized and bugs have been fixed.\",\"releaseDate\":\"2024-11-05\",\"releaseTimestamp\":\"2024-11-05T01:46:54Z\"},{\"versionDisplay\":\"1.2.4.1\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. The token position indicator has been optimized, and the operations have been facilitated. \\n2. The issue of receiving abnormal notifications about the game exiting when holding the second place in various modes has been resolved.\\n3. Room owners are now able to add specific users to the room's blacklist.\\n4. Bugs fixed.\",\"releaseDate\":\"2024-09-24\",\"releaseTimestamp\":\"2024-09-24T02:01:04Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"Welcome to Yalla Parchís. The updates are as follows:\\n1. The new function of tokens’ expected position is added, and when activating the option, users can know clearly the squares where the tokens will arrive with the numbers on the dices.\\n2. The room owners are able to add certain users in the room’s blacklist.\\n3. Bugs fixed.\",\"releaseDate\":\"2024-09-11\",\"releaseTimestamp\":\"2024-09-11T03:17:30Z\"},{\"versionDisplay\":\"1.2.3.1\",\"releaseNotes\":\"The updates are as follows:\\r\\n1. The new function S.T. Points is added, which can be used to redeem for items or in coming functions.\\r\\n2. The new functions \\\"Block all the micros\\\" and \\\"Eliminate inactive members in batches\\\" are accessible now as the privileges for Baron.\\r\\n3. The Racing rule is planned to be permanent in the app.\\r\\n4. The rewards for the current period in the Fragments Fusion will be displayed.\\r\\n5. Bugs fixed.\",\"releaseDate\":\"2024-07-19\",\"releaseTimestamp\":\"2024-07-19T01:54:14Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"The updates are as follows:\\r\\n1. The new function S.T. Points is added, which can be used to redeem for items or in coming functions.\\r\\n2. The new functions \\\"Block all the micros\\\" and \\\"Eliminate inactive members in batches\\\" are accessible now as the privileges for Baron.\\r\\n3. The Racing rule is planned to be permanent in the app.\\r\\n4. The rewards for the current period in the Fragments Fusion will be displayed.\\r\\n5. Bugs fixed.\",\"releaseDate\":\"2024-07-12\",\"releaseTimestamp\":\"2024-07-12T02:11:49Z\"},{\"versionDisplay\":\"1.2.2.1\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. The Racing mode is now available in VIP and private rooms.\\r\\n2. The new item Room Experience Card is added, which can be used to upgrade the level of the chatrooms.\\r\\n3. The new item Room Frame is added, which provides more styles of display.\\r\\n4. Bugs fixed.\",\"releaseDate\":\"2024-05-31\",\"releaseTimestamp\":\"2024-05-31T02:00:50Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. The Racing mode is now available in VIP and private rooms.\\r\\n2. The new item Room Experience Card is added, which can be used to upgrade the level of the chatrooms.\\r\\n3. The new item Room Frame is added, which provides more styles of display.\\r\\n4. Bugs fixed. \",\"releaseDate\":\"2024-05-27\",\"releaseTimestamp\":\"2024-05-27T02:00:38Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"Welcome to Yalla Parchís. The updates are as follows:\\r\\n1. The starting time has been optimized.\\r\\n2. The default option for the fragments fusion's filter has been changed to \\\"unlocked\\\" to avoid unintentional operations.\\r\\n3. The piggy banks can only be purchased when it's full to avoid unintentional operations.\\r\\n4. More levels and honor icons have been added to the member clubs.\\r\\n5. The chatroom list has been optimized to show more excelent rooms and more interesting contents.\\r\\n6. Some bugs has been fixed.\",\"releaseDate\":\"2024-04-03\",\"releaseTimestamp\":\"2024-04-03T01:56:16Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. The new game mode \\\"Racing\\\" has been added. More interesting props and exciting\\r rules are waiting for you to try. \\n2. New tools \\\"Stopwatch\\\" and \\\"Timer\\\" have been added to the Chatroom. \\n3. Optimized game experience and fixed bugs.\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T03:20:02Z\"},{\"versionDisplay\":\"1.1.9\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. You can spectate game matches in the chat room now. It's even more fun to chat with\\r\\nyour friends while spectating!\\r\\n2. Optimized game experience and fixed bugs.\",\"releaseDate\":\"2023-11-24\",\"releaseTimestamp\":\"2023-11-24T02:04:37Z\"},{\"versionDisplay\":\"1.1.8.1\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\n1. More rewards have been added for watching ads. For example, you can get bingo Power-Ups, the free chance to undo and accelerate unlocking treasure chests. \\n2. The new game \\\"Guess Numbers\\\" has been added to the Chatroom. Now try it with your friends!\\n3. Optimized game experience and fixed bugs.\",\"releaseDate\":\"2023-09-26\",\"releaseTimestamp\":\"2023-09-26T15:35:13Z\"},{\"versionDisplay\":\"1.1.8\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\n1. More rewards have been added for watching ads. For example, you can get bingo Power-Ups, the free chance to undo and accelerate unlocking treasure chests. \\n2. The new game \\\"Guess Numbers\\\" has been added to the Chatroom. Now try it with your friends!\\n3. Optimized game experience and fixed bugs.\",\"releaseDate\":\"2023-09-13\",\"releaseTimestamp\":\"2023-09-13T02:17:38Z\"},{\"versionDisplay\":\"1.1.7\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. Added \\\"Magic\\\" rule in the Parchis VIP room.\\n2. New \\\"Sound Wave Circle\\\" function in the Chatroom. \\n3. Optimized game experience and fixed bugs.\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T02:10:42Z\"},{\"versionDisplay\":\"1.1.6.2\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseDate\":\"2023-06-18\",\"releaseTimestamp\":\"2023-06-18T12:57:52Z\"},{\"versionDisplay\":\"1.1.6.1\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseDate\":\"2023-06-09\",\"releaseTimestamp\":\"2023-06-09T02:28:20Z\"},{\"versionDisplay\":\"1.1.6\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseDate\":\"2023-05-31\",\"releaseTimestamp\":\"2023-05-31T02:00:14Z\"},{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"1.Piggy Bank – Play Parchis or Bingo to earn diamonds, which are stored in your Piggy Bank. When it's full, you can open it to collect all the diamonds!\\n2.Fragments Fusion Optimization - You can now use fragments of locked skins to fuse them together!\\n3.Truth or Dare - Join in on the fun with our new in-room gameplay: \\\"Truth or Dare.\\\" Experience it with your friends today!\",\"releaseDate\":\"2023-03-30\",\"releaseTimestamp\":\"2023-03-30T07:00:59Z\"},{\"versionDisplay\":\"1.1.4.1\",\"releaseNotes\":\"1.New Game Mode: Experience the excitement of the newly added game mode, Magic - it's more fun and fast-paced!\\n2.Skin Fragment Fusion: Get the chance to receive skin fragments when you use the ‘Fusion’ function!\\n3.New In-Room Feature: Enjoy the newly added Light Show Ranking in the chat rooms.\",\"releaseDate\":\"2023-02-08\",\"releaseTimestamp\":\"2023-02-08T01:30:01Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"1.New Game Mode: Experience the excitement of the newly added game mode, Magic - it's more fun and fast-paced!\\r\\n2.Skin Fragment Fusion: Get the chance to receive skin fragments when you use the ‘Fusion’ function!\\r\\n3.New In-Room Feature: Enjoy the newly added Light Show Ranking in the chat rooms.\",\"releaseDate\":\"2023-01-18\",\"releaseTimestamp\":\"2023-01-18T14:37:19Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1.VIP3 Privileges: Become a VIP3 member to unlock exclusive benefits such as faster EXP gain, comments with special effects, and much more! \\r\\n2.VIP Room Gameplay: Now you have the option to play a Parchis game in the VIP Room without ‘undo’ or ‘block’.\\r\\n3.Chat Emoticons: You can now choose from a wide range of dynamic emoticons and use them in chat rooms!\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:19:50Z\"}],\"websiteUrl\":\"https://www.yallaparchis.com/\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Play and chat with friends\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=876568445\",\"type\":\"get\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":301636608}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=876568445\",\"type\":\"update\",\"priceFormatted\":\"AED 0.00\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"AED\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":301636608}]}],\"requires32bit\":false,\"releaseDate\":\"2021-02-02\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallaparchisi\",\"h