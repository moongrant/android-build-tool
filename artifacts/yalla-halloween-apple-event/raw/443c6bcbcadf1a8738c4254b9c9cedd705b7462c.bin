log/ae/apps/1317217120/developer?l=en-GB\",\"data\":[{\"id\":\"1519958784\",\"type\":\"developers\",\"href\":\"/v1/catalog/ae/developers/1519958784?l=en-GB\",\"attributes\":{\"name\":\"Star Chat International Limited\",\"mediaType\":\"Mobile Software Applications\",\"genreNames\":[],\"editorialArtwork\":{},\"url\":\"https://apps.apple.com/ae/developer/star-chat-international-limited/id1519958784\"}}]},\"genres\":{\"href\":\"/v1/catalog/ae/apps/1317217120/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/ae/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/ae/genre/id6005\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1753862275750,\"RTCI\":1753905406823}}},{\"id\":\"1377028992\",\"type\":\"apps\",\"href\":\"/v1/catalog/ae/apps/1377028992?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Medical/Treatment Information\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Frequent/Intense Profanity or Crude Humour\",\"Infrequent/Mild Realistic Violence\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/ae/app/youstar-group-voice-chat-room/id1377028992\",\"userRating\":{\"value\":3.9,\"ratingCount\":255,\"ratingCountList\":[54,7,15,19,160],\"ariaLabelForRatings\":\"3.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"7.5.8\",\"genreDisplayName\":\"Entertainment\",\"name\":\"YouStar-Group Voice Chat Room\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"GOOD ONLINE TECHNOLOGY PTE.LTD.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Youstar is a free multiplayer voice chat and entertainment community, chat with people nearby or around the world, and play a variety of interesting social games.\\n\\nFree voice chat room\\nYoustar has the safest and smoothest voice group chat room. No matter where you are, you can chat safely with Arab friends all over the world for free. Supports enjoying real-time voice chat using 3G, 4G, LTE or WI-FI networks.\\n\\n\\nFree online party\\nYou can hold free parties for birthdays, National Day, and Eid al-Fitr, or watch football matches in the room with like-minded friends for real-time commentary, or discuss the zodiac explanation to answer the zodiac password for you.\\n\\nCool virtual gifts\\nIn the chat room you can exchange cool gifts with your friends. There are stunning animated special effects to suit your needs.\\n\\nWonderful game\\nAlthough life is busy with trivial matters, Youstar will bring you a one-stop entertainment experience. In this app, you can play various exciting and fun mini-games such as Ludo, UMO, Crush, Lucky wheel, Fruit Party... and unlock endless gaming fun. From casual elimination to strategic competition, whether you are a newbie or an expert, you can find a game world that belongs to you.\\n\\nWatch rich video content\\nIn addition to games, YouStar can also enables you to watch various music MVs and video content from Youtube. Welcome to enjoy music from all over the world anytime and anywhere. Whether it is a popular hit or a retro classic, there is always a song that will suit your mood. The rich video content covers various fields such as comedy, food, tourism, technology, culture, etc., allowing you to travel around the world and experience different wonderful lives in just a few minutes.\\n\\nCommunity accessibility\\nYoustar is not only entertainment, but also a warm social circle. Here, you can meet like-minded friends and share the joy of entertainment and life with each other. Adding friends, instant chat, and interactive comments all reflect the warmth of friendship and the power of care. You can also show your talents here, share your mood text, and share the beauty of life with everyone.\\n\\nPersonalized recommendation\\nWe have carefully designed a personalized push function to recommend more entertainment content and social activities that suit your tastes based on your interests and usage habits. Whether you are a warrior who likes to challenge yourself, or an artistic youth who enjoys tranquility, YouStar can find the most suitable content for you, allowing you to find a sense of belonging and resonance here.\\n\\nLive video\\nAt the same time, our live broadcast function will also give you an immersive viewing experience. Watch the wonderful live broadcast, interact with everyone, become a member of the fan circle, and feel the real and beautiful emotional resonance.\\n\\nJoin Youstar now! Here, you will no longer be alone, because there is always a group of people in the world waiting to meet you and explore unlimited joy and passion together. Let us create our own new era of entertainment and social interaction together!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.3.8\",\"releaseNotes\":\" 1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-07-23\",\"releaseTimestamp\":\"2025-07-23T01:38:45Z\"},{\"versionDisplay\":\"8.3.6\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-07-02\",\"releaseTimestamp\":\"2025-07-02T10:28:15Z\"},{\"versionDisplay\":\"8.3.5\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-06-18\",\"releaseTimestamp\":\"2025-06-18T09:09:57Z\"},{\"versionDisplay\":\"8.3.4\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-06-16\",\"releaseTimestamp\":\"2025-06-16T01:24:54Z\"},{\"versionDisplay\":\"8.3.3\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-05-26\",\"releaseTimestamp\":\"2025-05-26T01:03:46Z\"},{\"versionDisplay\":\"8.3.2\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-05-08\",\"releaseTimestamp\":\"2025-05-08T06:42:23Z\"},{\"versionDisplay\":\"8.3.1\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-04-25\",\"releaseTimestamp\":\