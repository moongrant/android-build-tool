v.Title.Preview.Books":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.MAS":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.Podcasts":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.TV":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iBooks":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iTunes":"@@product@@ @@qualifier@@","WEA.MusicPages.Riaa.Explicit.AX":"Parental Advisory Explicit Content","WEA.PaddleNav.Next.AX":"Next","WEA.PaddleNav.Previous.AX":"Previous","WEA.StarRating.Separator":" • ","WFA.Common.Meta.Twitter.site":"@Apple"}}</script><script type="fastboot/shoebox" id="shoebox-media-api-cache-apps">{".v1.catalog.sa.apps.1091902866.l.en-gb.platform.web.additionalplatforms.appletv.2cipad.2ciphone.2cmac.2crealitydevice.extend.custompromotionaltext.2ccustomscreenshotsbytype.2ccustomvideopreviewsbytype.2cdescription.2cdeveloperinfo.2cdistributionkind.2ceditorialvideo.2cfilesizebydevice.2cmessagesscreenshots.2cprivacy.2cprivacypolicyurl.2crequirementsbydevicefamily.2csellerinfo.2csupporturlforlanguage.2cversionhistory.2cwebsiteurl.2cvideopreviewsbytype.include.app-events.2cgenres.2cdeveloper.2creviews.2cmerchandised-in-apps.2ccustomers-also-bought-apps.2cdeveloper-other-apps.2ctop-in-apps.2crelated-editorial-items.limit.5bmerchandised-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1716607249464,\"d\":[{\"id\":\"1091902866\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1091902866?l=en-GB\",\"attributes\":{\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":151,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"usesLocationBackgroundMode\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"hasEula\":true,\"distributionKind\":\"APP_STORE\",\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humour\"]}},\"url\":\"https://apps.apple.com/sa/app/yalla-group-voice-chat-rooms/id1091902866\",\"userRating\":{\"value\":4.2,\"ratingCount\":24846,\"ratingCountList\":[3393,912,1102,1873,17566],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"2.4.0\",\"name\":\"Yalla - Group Voice Chat Rooms\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"sellerLabel\":\"Provider\",\"platformAttributes\":{\"ios\":{\"seller\":\"Yalla Technology FZ-LLC\",\"copyright\":\"© 2024 Yalla Technology FZ-LLC\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla is the most popular Live Group Voice Talking and Entertaining Community. Voice Chat and play games with people from nearby or all over the world.\\n\\nMeet new friends is never easier:\\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries has already been covered, while tons of topics are available to choose.\\n\\nParty with friends with no distances:\\nGroup voice talk with friends no matter where they are, broadcast your favorite musics inside the room, sing karaokes together, and play a range of games directly in group chat. Let's get the party started.\\n\\nFEATURES:\\n\\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE or Wi-Fi.\\n\\nPUBLIC CHAT ROOMS — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \\n\\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\\n\\nCHAT GAMES — Play games together directly in your chat group!\\n\\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\\n\\nSHARE and FOLLOW — Share your favorite ROOMS on Facebook, Twitter, Instagram, Snapchat and more, inviting friends and new followers.\\n\\nFollow us to get the latest news, updates and events:\\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\\nWebsite: www.yalla.live\\n\\nDear YALLA users, your feedback and suggestions are welcomed to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"is32bitOnly\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.26.1\",\"releaseNotes\":\"1. يمكنك إرسال الهدايا لجميع أعضاء الفريق في وقت واحد في لعبة كرة القدم المجنونة.\\n2. تحسينات أخرى\\n\\n1. You can give gifts to all team members at once in the Crazy Football game.\\n2. Other improvements\",\"releaseDate\":\"2024-05-08\",\"releaseTimestamp\":\"2024-05-08T01:59:23Z\"},{\"versionDisplay\":\"2.26.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T01:56:32Z\"},{\"versionDisplay\":\"2.25.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T01:47:59Z\"},{\"versionDisplay\":\"2.24.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-24\",\"releaseTimestamp\":\"2024-01-24T01:47:39Z\"},{\"versionDisplay\":\"2.24.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T01:50:11Z\"},{\"versionDisplay\":\"2.23.7\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-24\",\"releaseTimestamp\":\"2023-12-24T01:44:57Z\"},{\"versionDisplay\":\"2.23.6\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-22\",\"releaseTimestamp\":\"2023-12-22T01:32:44Z\"},{\"versionDisplay\":\"2.23.5\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-19\",\"releaseTimestamp\":\"2023-12-19T13:43:38Z\"},{\"versionDisplay\":\"2.23.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-11-22\",\"releaseTimestamp\":\"2023-11-22T01:43:27Z\"},{\"versionDisplay\":\"2.23.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-24\",\"releaseTimestamp\":\"2023-10-24T01:23:56Z\"},{\"versionDisplay\":\"2.23.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T01:33:00Z\"},{\"versionDisplay\":\"2.23.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T01:29:21Z\"},{\"versionDisplay\":\"2.22.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-08-02\",\"releaseTimestamp\":\"2023-08-02T01:31:28Z\"},{\"versionDisplay\":\"2.22.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-16\",\"releaseTimestamp\":\"2023-06-16T16:14:48Z\"},{\"versionDisplay\":\"2.22.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-14\",\"releaseTimestamp\":\"2023-06-14T01:56:09Z\"},{\"versionDisplay\":\"2.21.0\",\"releaseNotes\":\"1. مستوى الثروة - افتح مستوى ثروتك واستمتع بامتيازات خاصة. \\r\\n2. تحسينات أخرى\\n\\n1. Wealth Level - Unlock your wealth level and enjoy distinguished privileges.\\r\\n2. Other improvements\",\"releaseDate\":\"2023-05-09\",\"releaseTimestamp\":\"2023-05-09T08:34:42Z\"},{\"versionDisplay\":\"2.20.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T01:28:32Z\"},{\"versionDisplay\":\"2.20.0\",\"releaseNotes\":\"1. VIP 6 -قم بالوصول إلى المستوى VIP 6 للاستمتاع بمزايا حصرية رائعة!                       \\r\\n2. تحسينات أخرى\\n\\n1. VIP 6 - Level up to VIP 6 to enjoy fantastic exclusive benefits!\\r\\n2. Other Improvements\",\"releaseDate\":\"2023-03-07\",\"releaseTimestamp\":\"2023-03-07T02:33:13Z\"},{\"versionDisplay\":\"2.19.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T01:10:00Z\"},{\"versionDisplay\":\"2.19.0\",\"releaseNotes\":\"1. تصميم لحظات جديدة: تمتع بتصميم محسّن وجمالي حديثًا.\\r\\n2. سجلات إجراءات الغرفة: تمت إضافة سجلات لحظر الدردشة / إلغاء الحظر وإزالة من الميكروفون.\\r\\n3. الإبلاغ عم طلبات الصداقة: يمكن للمستخدمين الآن الإبلاغ عن طلبات الصداقة من أسفل صفحة طلب الصداقة.\\n\\n1. New Moments design: Enjoy a newly improved and aesthetic design.\\r\\n2. Room action records: Added records for chat ban/unban and removal from the mic.\\r\\n3. Friend request report: Users can now report friend requests from the bottom of the friend request page.\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T01:32:16Z\"},{\"versionDisplay\":\"2.18.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2022-11-29\",\"releaseTimestamp\":\"2022-11-29T01:48:20Z\"},{\"versionDisplay\":\"2.18.0\",\"releaseNotes\":\"1. تصميم الصفحة الرئيسية - استمتع بتحسين تصميم الصفحة الرئيسية.\\n2. شارة الشرف - يمكن الآن لأفضل 10 مجموعات أعضاء الغرفة الحصول على شارات الشرف.\\n3. طلب الميكروفون - تمت إضافة ميزة التحكم في الميكروفون من خلال التقدم بطلب للحصول عليها!\\n\\n1. Home Page Design - Enjoy a newly upgraded and aesthetic design. \\n2. Honor Badge - The top 10 Room Member Groups can now get awarded honor badges. \\n3. Microphone Application - This new feature in the chat room allows users to apply for a mic!\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:49:18Z\"},{\"versionDisplay\":\"2.17.0\",\"releaseNotes\":\"1. مجموعة الأعضاء - من خلال الانضمام إلى مجموعة الأعضاء، يمكنك الحصول علي النقاط ورفع المستوى لكسب المزيد من امتيازات الأعضاء!\\r\\n2. الإبلاغ عن الرسائل الخاصة - يمكنك الآن الإبلاغ عن رسالة خاصة بالضغط عليها لفترة قصيرة.\\n\\n1. Member Group - By joining the member group, you can gain points and level up to earn more member privileges!\\r\\n2. Report Private Messages - You can now report a private message by holding down on it.\",\"releaseDate\":\"2022-09-21\",\"releaseTimestamp\":\"2022-09-21T01:44:47Z\"},{\"versionDisplay\":\"2.16.0\",\"releaseNotes\":\"1. الهدايا الجديدة، صناديق الدردشة ومزايا حصرية لأعضاء VIP - تم أضافة هدايا جديدة، والقدرة على شراء صناديق الدردشة، وصناديق الدردشة الحصرية للمستخدمين VIP.\\n2. تعديل المنشور - يمكن لأعضاء يلا بريميم تعديل المنشور ما يصل إلى 5 مرات.\\r\\n3. دردشة جماعية - يمكن لمضيفي المواضيع إنشاء دردشة جماعية على YallaChat.\\n\\n1. New Gifts, Chat Boxes and VIP Benefits - Added new gifts with the ability to purchase chat boxes, and exclusive chat boxes for VIP users.\\r\\n2. Edit your Posts - Yalla Premium members can edit a post up to 5 times.\\r\\n3. Group Chat - Topic hosts can create a YallaChat group chat.\",\"releaseDate\":\"2022-07-20\",\"releaseTimestamp\":\"2022-07-20T01:53:22Z\"},{\"versionDisplay\":\"2.15.0\",\"releaseNotes\":\"1. يمكن لمالك الغرفة الآن إنشاء ما يصل إلى 10 أنشطة يوميا، ويمكن منح المشرفين الإذن لإنشاء أنشطة.\\n2. يمكن للمستخدمين VIP3- VIP5 الحصول على أي دي شخصي مميز مجانًا.\\n3. ملصقات متحركة جديدة.\\n4. تحسينات أخرى في الأداء.\\n\\n1. Room owners can now create up to 10 events per day, and room admins can be given permission to create events.\\n2. VIP 3 - VIP 5 users can get a Unique Personal ID for free.\\n3. New animated stickers\\n4. Other performance improvements.\",\"releaseDate\":\"2022-05-17\",\"releaseTimestamp\":\"2022-05-17T01:42:08Z\"}],\"websiteUrl\":\"http://www.yalla.live\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"editorialNotes\":{\"tagline\":\"Chat with friends\"},\"languageList\":[\"English\",\"Arabic\",\"Hindi\",\"Indonesian\",\"Portuguese\",\"Spanish\",\"Turkish\",\"Urdu\"],\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=865314735\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":323894272}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=865314735\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":323894272}]}],\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"requires32bit\":false,\