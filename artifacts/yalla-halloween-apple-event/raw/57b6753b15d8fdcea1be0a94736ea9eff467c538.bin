me\":\"App Store\",\"name\":\"Games\",\"url\":\"https://itunes.apple.com/sa/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7004?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7004\"}},{\"id\":\"7009\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7009?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Family\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7009\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1716468464526,\"RTCI\":1716468923848}}},{\"id\":\"1513504421\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1513504421?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Cartoon or Fantasy Violence\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":11,\"genreName\":\"Card\",\"genre\":7005,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/card-games/7005\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/yalla-baloot-hand/id1513504421\",\"userRating\":{\"value\":4.4,\"ratingCount\":3439,\"ratingCountList\":[278,88,158,234,2681],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.0\",\"name\":\"Yalla Baloot \u0026 Hand\",\"genreDisplayName\":\"Card\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Welcome to Yalla Baloot\u0026Hand, the ultimate mobile board game app that brings you the best of Baloot and Hand, two popular card games from the Arab region. Immerse yourself in the authentic gameplay, compete in thrilling tournaments, and connect with friends and family in real-time.\\n\\nKey Features:\\n\\nAuthentic Baloot Experience:\\nExperience the timeless charm of Baloot, a beloved card game from the Middle East. Play with traditional rules and immerse yourself in the rich cultural heritage of this classic game.\\n\\nMultiple Modes of Hand:\\nExplore a variety of Hand game modes, including Hand and Hand Saudi. Each mode offers its own unique challenges and excitement, providing endless entertainment for both casual and competitive players.\\n\\nCompetitive Tournaments and Rankings:\\nTest your skills and compete against players from around the world in intense tournaments and leagues. Climb the ranks, earn prestigious titles, and showcase your card-playing prowess.\\n\\nSocial Rooms for Multiplayer Fun:\\nJoin public rooms and play Baloot and Hand with friends and other players. Create private rooms to invite your friends and enjoy hours of fun-filled gaming sessions together.\\n\\nVoice Chat Rooms for Real-Time Communication:\\nConnect with family and friends through real-time voice chat rooms. Enjoy seamless communication, host online parties, and share memorable moments as you engage in lively conversations.\\n\\nExquisite Personalization Options:\\nCustomize your gaming experience with a wide range of beautifully designed skins for cards, boards, and avatars. Stand out from the crowd and express your style with customizable elements that reflect your personality.\\n\\nWe will try our best to improve your game experience, provide you with fun and excitement, and make your life full of joy.\\n\\nAny suggestions or questions, please contact our feedback team: balootsupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"accelerometer arm64 opengles-1 \",\"versionHistory\":[{\"versionDisplay\":\"1.5.11\",\"releaseNotes\":\"1. In-game message and Stickers - Optimized in-game messages and stickers interface. Enjoy free communication with your friends!\\r\\n2. Baloot Game Interface - Optimized the layout of personal information to further enhance the gaming experience.\\r\\n3. Interaction Optimization - Optimized the effect of interface transitions to provide a smoother experience.\",\"releaseDate\":\"2024-05-17\",\"releaseTimestamp\":\"2024-05-17T01:26:04Z\"},{\"versionDisplay\":\"1.5.10\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-04-19\",\"releaseTimestamp\":\"2024-04-19T01:47:12Z\"},{\"versionDisplay\":\"1.5.9\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-03-06\",\"releaseTimestamp\":\"2024-03-06T05:38:24Z\"},{\"versionDisplay\":\"1.5.8.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2024-02-08\",\"releaseTimestamp\":\"2024-02-08T02:42:19Z\"},{\"versionDisplay\":\"1.5.8\",\"releaseNotes\":\"1. Chatroom - Introducing our new Royal System! Become a royal member and unlock various privileges to stand out from the crowd!\\n2. New Baloot Gameplay - Experience the limited-time one-round mode and join the master showdown.\\n3. Ranking Display Upgrade - The top of each ranking will now have enhanced effects to show off the glory!\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T06:23:09Z\"},{\"versionDisplay\":\"1.5.7.1\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\r\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\r\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\\r\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\\r\",\"releaseDate\":\"2023-11-21\",\"releaseTimestamp\":\"2023-11-21T11:05:16Z\"},{\"versionDisplay\":\"1.5.7\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\",\"releaseDate\":\"2023-11-07\",\"releaseTimestamp\":\"2023-11-07T08:08:58Z\"},{\"versionDisplay\":\"1.5.6.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T07:36:26Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"1. New Room Prop - Magic Card is coming! Send it to each other in chatroom and it will be displayed on mic after sending!\\r\\n2. Quick Reply - Quick Reply in chatroom is available now. Reply directly to keep the relationship closer! \\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T01:37:00Z\"},{\"versionDisplay\":\"1.5.5\",\"releaseNotes\":\"1. Master Match - Engage in a thrilling competition and showcase your skills alongside the world's best Baloot players!\\r\\n2. World Top List - Work your way up the World Top Ranking List by earning points through competitive play in game. Only the best will reach the top!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-08-23\",\"releaseTimestamp\":\"2023-08-23T01:33:22Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-06-13\",\"releaseTimestamp\":\"2023-06-13T12:07:16Z\"},{\"versionDisplay\":\"1.5.3\",\"releaseNotes\":\"1. Game Sharing - Improved the sharing feature to help you easily showcase accomplishments with friends!\\n2. Chatroom Upgrade - Enjoy the newly added personal gift lists, which showcase leaderboards for sent and received gifts!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T07:06:49Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"1. Achievement Badges - Earn achievements to unlock badges, and show off your collection by wearing them!\\r\\n2. Chatroom Update - Member club feature added. Join with friends and make your room the most popular!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\"},{\"versionDisplay\":\"1.5.1.1\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"1. Upgraded Challenge - Two challenge matches of different levels have been added, giving users more exciting games to enjoy! \\r\\n2. Interface Optimization - Buttons on the main interface have been optimized to improve the user experience!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1. Chatrooms – Experience the newly added chatrooms! Create your own room or join a public one and make new friends! \\r\\n2. Upgraded Global Chat - Experience a smoother global chat with newly added message notifications! \\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\"},{\"versionDisplay\":\"1.4.9.11\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T01:50:12Z\"},{\"versionDisplay\":\"1.4.9.10\",\"releaseNotes\":\"1. New Game Rule - Enjoy the most authentic Baloot experience with the newly added \\\"Gaid\\\" rules in the Public Room!\\r\\n2. Chat Bubbles – Show off your bubble collection by using personalized chat bubbles!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T09:05:56Z\"},{\"versionDisplay\":\"1.4.9.9\",\"releaseNotes\":\"1. New Game Rules - Enjoy the most authentic Baloot experience, with the newly added \\\"Kashu\\\" rules! \\r\\n2. Public Room - Create private or public \\\"Hand\\\" game rooms or join other user's rooms by accessing the game mode's \\\"Public Room\\\"!\\r\\n3. Challenge Notification Feature - With newly added notifications in global chat, you will never miss any challenge match!\",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T01:46:58Z\"},{\"versionDisplay\":\"1.4.9.8\",\"releaseNotes\":\"1. Interface Optimization - Enjoy the newly upgraded interface in \\\"Challenge mode\\\"!\\r\\n2. Challenge Registration Reminder - Never miss out on any of the daily rewards with the new Challenge registration reminder feature!\\r\\n3. Performance Optimization - Enjoy a much smoother gaming experience!\",\"releaseDate\":\"2022-09-01\",\"releaseTimestamp\":\"2022-09-01T01:05:52Z\"},{\"versionDisplay\":\"1.4.9.7\",\"releaseNotes\":\"1. New Challenge Match - Enjoy exciting competitions with plenty of rewards. Compete to become the champion!\\n2. Quick Play Upgrade - Experience faster Baloot games and choose different skill grades based on your own expertise!\\n3. New Rankings System - Play games to gain your spot on the ranking list and win exclusive profile frames!\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T10:55:25Z\"},{\"versionDisplay\":\"1.4.9.6\",\"releaseNotes\":\"1.Upgrade to Quick mode in championship tryouts, with more chances to hit the championship every day!\\r\\n2.Voice quality improvement and overall optimizations. Enter app in seconds and have a quick start!\",\"releaseDate\":\"2022-06-25\",\"releaseTimestamp\":\"2022-06-25T08:51:38Z\"},{\"versionDisplay\":\"1.4.9.5.1\",\"releaseNotes\":\"1. Team up with friends to join the new competitive championship.\\r\\n2. Public rooms have been enhanced to support multiple spectators.\\r\\n3.Voice quality improvement and overall optimization. \",\"releaseDate\":\"2022-06-06\",\"releaseTimestamp\":\"2022-06-06T12:34:09Z\"},{\"versionDisplay\":\"1.4.9.4\",\"releaseNotes\":\"1. Added New Star Rank. You can be the top even as a new player!\\n2. Get VIP when you bind your account!\\n3. New announcement after upgrading to Master and above. \\n4. Voice quality improvement and overall optimizations. \",\"releaseDate\":\"2022-04-20\",\"releaseTimestamp\":\"2022-04-20T02:05:26Z\"},{\"versionDisplay\":\"1.4.9.3\",\"releaseNotes\":\"1. Brand new Public Room. You can use golds now to play games.\\n2. App optimizations and voice quality improvement.\\n3. Enhanced user experience and added confirmation for golds exchange in Store.\",\"releaseDate\":\"2022-03-21\",\"releaseTimestamp\":\"2022-03-21T14:27:05Z\"}],\"websiteUrl\":\"https://www.yallabaloot.com/\",\"isXROSCompatible\":false,\"editorialNotes\":{\"tagline\":\"Play your cards right\"},\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=865817396\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":309851136}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=865817396\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":309851136}]}],\"requires32bit\":false,\"releaseDate\":\"2020-08-07\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallabaloot\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/5f/3b/65/5f3b654a-97c0-fc74-aef6-ca2b392f230b/AppIcon-1x_U007emarketing-0-7-0-0-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"38c01a\",\"textColor1\":\"061a01\",\"textColor2\":\"042700\",\"textColor3\":\"103b06\",\"textColor4\":\"0e4505\"},\"videoPreviewsByType\":{\"iphone_6_5\":[{\"previewFrame\":{\"width\":886,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/0d/c7/42/0dc74210-0ccd-b9a2-