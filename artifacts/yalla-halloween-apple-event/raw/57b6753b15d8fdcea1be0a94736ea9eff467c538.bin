{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/1444567250?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/sa/apps/6444792857/genres?l=en-GB\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6014?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"url\":\"https://itunes.apple.com/sa/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"7003\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7003?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Casual\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7003\"}},{\"id\":\"7012\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7012?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Puzzle\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7012\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1716326155274,\"RTCI\":1716326585132}}}]},\"related-editorial-items\":{\"href\":\"/v1/catalog/sa/apps/1091902866/related-editorial-items?l=en-GB\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/sa/apps/1091902866/customers-also-bought-apps?l=en-GB\",\"next\":\"/v1/catalog/sa/apps/1091902866/customers-also-bought-apps?l=en-GB\u0026offset=10\",\"data\":[{\"id\":\"1514418573\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1514418573?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Collected\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"The developer does not collect any data from this app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":49,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/%D9%88%D9%8A%D8%B3%D8%A8%D8%B1-%D8%AF%D8%B1%D8%AF%D8%B4%D8%A9-%D9%88-%D8%A3%D9%84%D8%B9%D8%A7%D8%A8/id1514418573\",\"userRating\":{\"value\":4.4,\"ratingCount\":3164,\"ratingCountList\":[246,92,163,247,2416],\"ariaLabelForRatings\":\"4.4 stars\"},\"name\":\"ويسبر - دردشة و ألعاب\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"BLAGOL TECHNOLOGY CO., LIMITED\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"\\nويسبر هو مجتمع ترفيهي مجاني و مباشر للدردشة الصوتية.\\n\\nالتواصل مع الأصدقاء بدون حواجز\\nويسبر هو مجتمع دردشة صوتية الأكثر شعبية، يمكنك هنا الدردشة بشكل آمن مع أصدقاء من جميع انحاء العالم، أمريكا، بريطانيا، السعودية، الإمارات، قطر، الصين، ألمانيا... لغة الدولة، او المسافات لا تعتبر أبداً حاجزاً لتواصلك معهم، مجاني كليا!\\n\\nالتعرف على أصدقاء بشكل آمن\\nفي ويسبر، يمكنك الدردشة مع العائلة، الأصدقاء و الغرباء، و الاحتفال بشكل مباشر معهم. عندما تشعر بالحاجة للسلام و الطمأنينة، الراحة النفسية، التحكم بالنفس، الثقة، الرضا او اي شيء آخر، يمكنك التحدث مع أصدقاءك هنا بشكل آمن و سري هنا، و سوف تحصل على الراحة.\\n\\nمميزات رائعة:\\nغرف محادثات صوتية مجانية - ويسبر هو تطبيق دردشة صوتية مجاني كليا! يمكنك التواصل مع الأصدقاء في ويسبر بإستخدام 3جي، 4جي ، إل تي إي أو شبكة إنترنت واي فاي، يمكنك التمتع بسرعة خارقة و محادثة صوت بجودة عالية في غرفة الدردشة.\\n\\nحفلة مباشرة مجانية - يمكنك عمل حفلة مجانية لعيد ميلاد، زواج، عيد، أو تعليقات في نفس التوقيت على ألعاب كرة القدم أو أي موضوع آخر، تمتع بوقتك هناك.\\n\\nدخول سريع و سهل - التسجيل فقط في 5 ثواني، يمكنك الدخول إلى ويسبر للتعرف على الأصدقاء بشكل سريع و سهل.\\n\\nلحظات رائعة - يمكنك مشاهدة اللحظات التي يتم نشرها بواسطة أصدقائك في ويسبر، و يمكنك مشاركة لحظاتك الرائعة أيضاً ليشاهد اصدقاؤك حياتك المميزة.\\n\\nهدايا مع تأثيرات مذهلة - في غرفة الدردشة المباشرة أو الدردشة المباشرة يمكنك تبادل الهدايا بتأثيراتها المميزة مع أصدقائك.\\n\\nتواصل خاص مباشر - يمكنك العثور على صديقك الجديد بالتواصل شخص لشخص بإضافة الأصدقاء و إرسال الرسائل لبعضكم البعض.\\n\\nألعاب مثيرة - يوجد الكثير من الألعاب الترفيهية المذهلة في ويسبر مجانا، يمكنك لعب الألعاب مع الأصدقاء في غرف الدردشة الصوتية. \\n\\nمجموعة دردشة \u0026 تواصل شخص لشخص\\nإذا كنت تفضل مجموعات الدردشة، إنضم إلى ويسبر و يمكنك التواصل مع العديد من الأصدقاء في نفس الوقت و في غرفة دردشة واحدة. يمكنك إقامة حفلات مباشرة، لعب الكثير من الألعاب المذهلة معهم، تبادل الهدايا و المحبة و الفرحة. إذا كنت تفضل الدردشة الخاصة شخص لشخص، إنضم إلى ويسبر و يمكنك العثور على أصدقاء من كل أنحاء العالم و التحدث معهم صوتيا بشكل آمن، دع قلبك و روحك ترتاح هنا.\\n\\nأفضل مجتمع تواصل إجتماعي أونلاين\\nماتزال تشعر بالخجل من التواصل مع الغرباء؟ ماتزال قلق على التعرف على أصدقاء جدد من مسافات بعيدة ؟ ماتزال منزعج من صعوبة التحدث باللغات المختلفة خلال الدردشة أونلاين مع الأصدقاء الجدد من دول أخرى و مختلفة؟ ويسبر قام بحل كل هذه الصعوبات و العوائق لك، انضم إلى ويسبر لتحصل على افضل تجربة اتصال مباشر اجتماعي، و دردش صوتيا مع الأصدقاء الجدد بحرية.\\n\\nالأصدقاء الأعزاء، يمكنكم متابعتنا من خلال متابعة صفحاتنا الرسمية:\\nhttps://www.facebook.com/Whisper-03177-108024924700488\\n\\nإذا كان لديك إقتراحات أو مراجعات، يرجى التواصل معنا:\\nwhisperfeedback@gmail.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.7.502\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\",\"releaseDate\":\"2024-05-24\",\"releaseTimestamp\":\"2024-05-24T02:12:26Z\"},{\"versionDisplay\":\"1.7.501\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\",\"releaseDate\":\"2024-05-21\",\"releaseTimestamp\":\"2024-05-21T01:59:20Z\"},{\"versionDisplay\":\"1.7.500\",\"releaseNotes\":\"تم تحسين التجربة\",\"releaseDate\":\"2024-05-08\",\"releaseTimestamp\":\"2024-05-08T11:26:26Z\"},{\"versionDisplay\":\"1.7.402\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\",\"releaseDate\":\"2024-04-28\",\"releaseTimestamp\":\"2024-04-28T11:33:46Z\"},{\"versionDisplay\":\"1.7.401\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\",\"releaseDate\":\"2024-04-28\",\"releaseTimestamp\":\"2024-04-28T01:58:45Z\"},{\"versionDisplay\":\"1.7.400\",\"releaseNotes\":\"تم تحسين التجربة\",\"releaseDate\":\"2024-04-18\",\"releaseTimestamp\":\"2024-04-18T02:47:17Z\"},{\"versionDisplay\":\"1.7.352\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\\n\",\"releaseDate\":\"2024-04-03\",\"releaseTimestamp\":\"2024-04-03T02:05:33Z\"},{\"versionDisplay\":\"1.7.351\",\"releaseNotes\":\"تم إصلاح الأخطاء لكي تحسين التجربة\",\"releaseDate\":\"2024-03-29\",\"releaseTimestamp\":\"2024-03-29T01:52:55Z\"},{\"versionDisplay\":\"1.7.350\",\"releaseNotes\":\"تم تحسين التجربة\",\"releaseDate\":\"2024-03-28\",\"releaseTimestamp\":\"2024-03-28T03:43:28Z\"},{\"versionDisplay\":\"1.7.30