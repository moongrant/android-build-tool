/apps/1489566586/developer?l=en-GB\",\"data\":[{\"id\":\"1242210509\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/1242210509?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"思伟 邹\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/%E6%80%9D%E4%BC%9F-%E9%82%B9/id1242210509\"}}]},\"genres\":{\"href\":\"/v1/catalog/sa/apps/1489566586/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1716598122057,\"RTCI\":1716598597836}}},{\"id\":\"1534252521\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1534252521?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Simulated Gambling\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Realistic Violence\",\"Infrequent/Mild Profanity or Crude Humour\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/4fun-live-voice-play-ludo/id1534252521\",\"userRating\":{\"value\":3.7,\"ratingCount\":112,\"ratingCountList\":[23,11,7,10,61],\"ariaLabelForRatings\":\"3.7 stars\"},\"name\":\"4Fun - Live Voice, Play Ludo\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"SPREADFUN\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"The app that people in Saudi Arabia and the UAE are paying attention to! 4Fun is a popular group voice chat app for arabs in KSA and UAE.\\n\\n\\nRAMADAN KAREEM! As Ramadhan approaches, 4Fun will add audio rooms for Quran recitation, hadith explanation, charity, zakat, and Ramadan content. Let's spend Ramadan online together, enjoy the peaceful Ramadan, and relax yourself.\\n\\n\\nRecommended community to make friends:\\nExplore friends and chat rooms that interest you. Make friends with interesting souls through your voice. It's a safe, warm and stress-free community.\\n\\n\\nOnline Party to entertain with your friends:\\nWhy not try to have a fun online party? You can chat with friends of the arab world anytime and anywhere about hot trends, emotions, fashion, football, work...\\n\\n\\nPlay Mdagsh with your friends:\\nMdagsh is a local KSA game. In the game, the banker need to choose question other players or not according to their own cards, while other players can choose to accept or increase. They compare the cards to decide which one is the winner, it’s depends on luck and their choices.\\n\\n\\nVarious Games that Saudis are playing:\\nLudo, , Uno……Nearly 10 popular local games for you to choose from! 4fun provides everyone with a wonderful gaming world.\\n\\n\\nFEATURES:\\n\\nMAKE FRIENDS- Meet friends that suit you instantly and easily! Friends are crowded into ROOMs, MOMENT \u0026 PRIVATE CHAT. On 4Fun, you never know who you might meet!\\n\\nDELICATE DESIGN- Stunning animated gifts, vehicles, headwears for you to show your taste and personality.\\n\\nUNIQUE HONOR-Special id, beautiful badges, SVIP, luxury ranking, Customized Gifts for you to show your uniqueness.\\n\\nROOM PARTY-Attend parties with different themes: Chat, Singles Club, Couples, Girls, Travel, AFC.\\n\\nGAMES- Play games with different arabs!\\n\\nMessage us: support@spread-fun.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://home.spread-fun.com\",\"versionHistory\":[{\"versionDisplay\":\"2.1.1\",\"releaseNotes\":\"We have optimized the performance of the chat room to make your experience better.\",\"releaseDate\":\"2024-05-18\",\"releaseTimestamp\":\"2024-05-18T07:01:09Z\"},{\"versionDisplay\":\"2.1.0\",\"releaseNotes\":\"In this version we have optimized the login function to make your experience even better.\",\"releaseDate\":\"2024-05-13\",\"releaseTimestamp\":\"2024-05-13T06:37:24Z\"},{\"versionDisplay\":\"2.0.9\",\"releaseNotes\":\"We have been working on making the 4Fun experience better, and in this version we have improved the design of the gift package,we hope this will bring you a better experience!\",\"releaseDate\":\"2024-04-25\",\"releaseTimestamp\":\"2024-04-25T03:45:33Z\"},{\"versionDisplay\":\"2.0.8\",\"releaseNotes\":\"We have added The Title to make your experience even better!\",\"releaseDate\":\"2024-04-23\",\"releaseTimestamp\":\"2024-04-23T03:49:27Z\"},{\"versionDisplay\":\"2.0.7\",\"releaseNotes\":\"In this version we have added the function of modify country, you can now update the version to experience it.\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T02:15:32Z\"},{\"versionDisplay\":\"2.0.6\",\"releaseNotes\":\"We have optimized the Item loading process to bring you a better experience.\",\"releaseDate\":\"2024-04-01\",\"releaseTimestamp\":\"2024-04-01T02:15:33Z\"},{\"versionDisplay\":\"2.0.5\",\"releaseNotes\":\"We've optimized the performance and loading experience to give you a better experience.\",\"releaseDate\":\"2024-03-21\",\"releaseTimestamp\":\"2024-03-21T01:59:14Z\"},{\"versionDisplay\":\"2.0.4\",\"releaseNotes\":\"We have added the in-room effects management to make your experience even better.\",\"releaseDate\":\"2024-03-13\",\"releaseTimestamp\":\"2024-03-13T02:16:41Z\"},{\"versionDisplay\":\"2.0.3\",\"releaseNotes\":\"We have added the in-room effects management to make your experience even better.\",\"releaseDate\":\"2024-03-08\",\"releaseTimestamp\":\"2024-03-08T03:56:09Z\"},{\"versionDisplay\":\"2.0.2\",\"releaseNotes\":\"We have optimized the user profile page to make your experience better.\",\"releaseDate\":\"2024-02-26\",\"releaseTimestamp\":\"2024-02-26T02:19:27Z\"},{\"versionDisplay\":\"2.0.1\",\"releaseNotes\":\"We've fixed some bugs to make your experience better!\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T12:03:38Z\"},{\"versionDisplay\":\"2.0.0\",\"releaseNotes\":\"We have optimized the display and experience of gifts to make your experience better.\",\"releaseDate\":\"2024-02-04\",\"releaseTimestamp\":\"2024-02-04T02:32:38Z\"},{\"versionDisplay\":\"1.9.8\",\"releaseNotes\":\"We've fixed the Chat Feature to make your experience even better!\",\"releaseDate\":\"2024-01-25\",\"releaseTimestamp\":\"2024-01-25T05:34:47Z\"},{\"versionDisplay\":\"1.9.7\",\"releaseNotes\":\"We've optimized the login feature to make your experience even better.\",\"releaseDate\":\"2024-01-18\",\"releaseTimestamp\":\"2024-01-18T04:10:38Z\"},{\"versionDisplay\":\"1.9.6\",\"releaseNotes\":\"We have optimized the room adaptation effect of the Arabic mode, which will make your experience better.\",\"releaseDate\":\"2024-01-15\",\"releaseTimestamp\":\"2024-01-15T03:46:01Z\"},{\"versionDisplay\":\"1.9.5\",\"releaseNotes\":\"We have optimised the user level function to make your experience better.\",\"releaseDate\":\"2024-01-08\",\"releaseTimestamp\":\"2024-01-08T12:26:04Z\"},{\"versionDisplay\":\"1.9.4\",\"releaseNotes\":\"We have upgraded the game's check-in feature to make it easier for you to experience.\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T02:58:39Z\"},{\"versionDisplay\":\"1.9.3\",\"releaseNotes\":\"We have redesigned the Treasure Box functions, we hope this update will bring you a better experience.\",\"releaseDate\":\"2023-12-27\",\"releaseTimestamp\":\"2023-12-27T03:19:32Z\"},{\"versionDisplay\":\"1.9.2\",\"releaseNotes\":\"In this version, we have optimized the badge function and many experiences, and we expect it to bring you a much better experience!\",\"releaseDate\":\"2023-12-06\",\"releaseTimestamp\":\"2023-12-06T19:50:14Z\"},{\"versionDisplay\":\"1.9.1\",\"releaseNotes\":\"We have adjusted the app's consumer experience, making it easier for you to send gifts.\",\"releaseDate\":\"2023-11-21\",\"releaseTimestamp\":\"2023-11-21T19:05:52Z\"},{\"versionDisplay\":\"1.9.0\",\"releaseNotes\":\"We have redesigned the badge function to show off your noble and honored.\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T16:50:00Z\"},{\"versionDisplay\":\"1.8.9\",\"releaseNotes\":\"We have optimized the experience of the Message function and fixed some bugs.\",\"releaseDate\":\"2023-09-27\",\"releaseTimestamp\":\"2023-09-27T17:34:58Z\"},{\"versionDisplay\":\"1.8.8\",\"releaseNotes\":\"We've redesigned the Room Party function, come host and join in!\",\"releaseDate\":\"2023-09-18\",\"releaseTimestamp\":\"2023-09-18T19:26:14Z\"},{\"versionDisplay\":\"1.8.7\",\"releaseNotes\":\"Messages are enhanced for a more interactive experience and we've fixed some crashes for a better experience.\",\"releaseDate\":\"2023-09-05\",\"releaseTimestamp\":\"2023-09-05T15:42:52Z\"},{\"versionDisplay\":\"1.8.6\",\"releaseNotes\":\"The Chat Function is newly redesigned to bring a more complete and rich experience of interaction.\",\"releaseDate\":\"2023-08-30\",\"releaseTimestamp\":\"2023-08-30T15:41:27Z\"}],\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1534252521\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=866022850\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":238660608}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1534252521\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=866022850\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":238660608}]}],\"requires32bit\":false,\"releaseDate\":\"2020-10-17\",\"hasInAppPurchases\":true,\"bundleId\":\"com.spreadfun.4fun\",\"hasMessagesExtension\":false,\"artwork\":{\"width\