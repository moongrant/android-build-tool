":\"ffffff\",\"textColor2\":\"e3ecf2\",\"textColor3\":\"ccdce2\",\"textColor4\":\"b6cdd8\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/e7/82/83/e7828335-8ef6-adca-ac60-f37b71077438/fdb808a1-c9e7-47ef-ba00-e6fdfa9fb757_6.png/{w}x{h}{c}.{f}\",\"bgColor\":\"076290\",\"textColor1\":\"ffffff\",\"textColor2\":\"13e7f4\",\"textColor3\":\"cddfe8\",\"textColor4\":\"10cce0\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/a3/d5/13/a3d513b5-7604-a27f-0ee6-f6f75b123fc2/6dbfc516-0c5b-4a96-b3d2-9ccf26497014_2.png/{w}x{h}{c}.{f}\",\"bgColor\":\"035070\",\"textColor1\":\"fbe368\",\"textColor2\":\"f6d31d\",\"textColor3\":\"cac66a\",\"textColor4\":\"c5b92d\"}],\"ipadPro_2018\":[{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/41/87/22/4187222a-f697-8695-3f8e-bd3a9a9efda9/8693b13f-3858-4442-982d-4eb8bb54244e_3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"090d1a\",\"textColor1\":\"ffffff\",\"textColor2\":\"f8f4eb\",\"textColor3\":\"cdced1\",\"textColor4\":\"c8c6c1\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource124/v4/c9/92/6d/c9926dfd-6280-5eff-1be9-1109950770e5/91f16f2b-ab2e-4389-8068-e4ed73830676_1.png/{w}x{h}{c}.{f}\",\"bgColor\":\"090d1a\",\"textColor1\":\"ffffff\",\"textColor2\":\"24cdc4\",\"textColor3\":\"cdced1\",\"textColor4\":\"1fa7a2\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/d9/4e/69/d94e6967-c00c-bbce-69ae-78556e6eccd4/5c066658-ca64-41e4-b1e1-a20ce9e85a46_5.png/{w}x{h}{c}.{f}\",\"bgColor\":\"090d1a\",\"textColor1\":\"eff1f2\",\"textColor2\":\"07a6db\",\"textColor3\":\"c1c3c7\",\"textColor4\":\"0787b4\"},{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/fd/4e/ef/fd4eef26-b912-c412-24af-c6d393453bdb/06d96c13-8543-4bfe-a310-54b66039a7f0_4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"090d1a\",\"textCo