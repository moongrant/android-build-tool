one14,6\":341840896,\"iPad14,5-B\":341840896,\"iPhone14,5\":367936512,\"iPad13,11\":341840896,\"iPhone14,4\":367936512,\"iPad13,17\":341840896,\"iPad13,18\":341840896,\"universal\":607025152,\"iPod9,1\":345200640,\"iPhone14,8\":367936512,\"iPad13,16\":341840896,\"iPad6,7\":359880704,\"iPad16,5-A\":341840896,\"iPad16,5-B\":341840896,\"iPad6,4\":359880704,\"iPad6,3\":359880704,\"iPad6,8\":359880704,\"iPad13,8\":341840896,\"iPad13,9\":341840896,\"iPad13,4\":341840896,\"iPad13,5\":341840896,\"iPad13,6\":341840896,\"iPad13,7\":341840896,\"iPad13,1\":341840896,\"iPad13,2\":341840896}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/sa/apps/1560121894/developer?l=en-GB\",\"data\":[{\"id\":\"1560122166\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/1560122166?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/shenzhen-yinguo-network-technology-co-ltd/id1560122166\"}}]},\"genres\":{\"href\":\"/v1/catalog/sa/apps/1560121894/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1716354154728,\"MZ_INDEXER\":1716353429526}}},{\"id\":\"1317217120\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1317217120?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/starchat-group-voice-chat-room/id1317217120\",\"userRating\":{\"value\":4,\"ratingCount\":1626,\"ratingCountList\":[284,68,79,107,1088],\"ariaLabelForRatings\":\"4.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"genreDisplayName\":\"Entertainment\",\"name\":\"StarChat-Group Voice Chat Room\",\"isPreorder\":false,\"artistName\":\"Star Chat International Limited\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nStarChat provides a variety of in-app purchases and subscriptions.If you choose to purchase an StarChat subscription,payment will be charged to your iTunes account after purchase confirmation.Your account will be charged the subscription amount within 24-hours prior to the end of the currnent period unless auto-renewal is turned off.Auto-renewal may be turned off at any time by going to your settings in the iTunes Store after purchase.\\n\\nPrivacy Policy：https://www.starchat.live/help/policy/Privacy_Policy.html\\nTerms of Service：https://www.starchat.live/help/policy/Terms_of_Service.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"http://www.starchat.live\",\"versionHistory\":[{\"versionDisplay\":\"8.3.0\",\"releaseNotes\":\"1. Fix several bugs\\n\",\"releaseDate\":\"2024-05-14\",\"releaseTimestamp\":\"2024-05-14T11:42:57Z\"},{\"versionDisplay\":\"8.2.0\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T22:11:33Z\"},{\"versionDisplay\":\"8.1.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-04-17\",\"releaseTimestamp\":\"2024-04-17T13:08:59Z\"},{\"versionDisplay\":\"8.1.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-04-16\",\"releaseTimestamp\":\"2024-04-16T18:33:44Z\"},{\"versionDisplay\":\"8.0.1\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2024-04-05\",\"releaseTimestamp\":\"2024-04-05T19:01:02Z\"},{\"versionDisplay\":\"8.0.0\",\"releaseNotes\":\"1、New UI, New experience. We have redesigned a new UI that will impress you more than ever!\\n2、Support using WhatsApp to receive verification code，Solve some user feedback issues of not receiving verification code.\",\"releaseDate\":\"2024-04-04\",\"releaseTimestamp\":\"2024-04-04T11:48:29Z\"},{\"versionDisplay\":\"7.11.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-03-20\",\"releaseTimestamp\":\"2024-03-20T19:45:47Z\"},{\"versionDisplay\":\"7.11.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-03-14\",\"releaseTimestamp\":\"2024-03-14T19:45:12Z\"},{\"versionDisplay\":\"7.10.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-02-22\",\"releaseTimestamp\":\"2024-02-22T14:19:03Z\"},{\"versionDisplay\":\"7.9.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T20:49:42Z\"},{\"versionDisplay\":\"7.8.0\",\"releaseNotes\":\"1. Optimize Couple function\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-01-25\",\"releaseTimestamp\":\"2024-01-25T16:42:11Z\"},{\"versionDisplay\":\"7.7.0\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2024-01-11\",\"releaseTimestamp\":\"2024-01-11T22:36:35Z\"},{\"versionDisplay\":\"7.6.1\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-11-21\",\"releaseTimestamp\":\"2023-11-21T13:03:58Z\"},{\"versionDisplay\":\"7.6\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-11-18\",\"releaseTimestamp\":\"2023-11-18T01:13:18Z\"},{\"versionDisplay\":\"7.5\",\"releaseNotes\":\"1. Added SVIP7 and SVIP8\\n2. Fix several bugs\",\"releaseDate\":\"2023-11-03\",\"releaseTimestamp\":\"2023-11-03T23:20:24Z\"},{\"versionDisplay\":\"7.4.1\",\"releaseNotes\":\"1. Fixed some bugs.\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T22:46:16Z\"},{\"versionDisplay\":\"7.4\",\"releaseNotes\":\"1. Add Premium subscription\\r\\n2. You can send voice messages in the channel now!\\r\\n\",\"releaseDate\":\"2023-10-19\",\"releaseTimestamp\":\"2023-10-19T12:55:21Z\"},{\"versionDisplay\":\"7.3\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-09-28\",\"releaseTimestamp\":\"2023-09-28T00:06:00Z\"},{\"versionDisplay\":\"7.2\",\"releaseNotes\":\"1. Added New Aristocracy level. The Sovereign comes！\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-09-21\",\"releaseTimestamp\":\"2023-09-21T23:25:06Z\"},{\"versionDisplay\":\"7.1\",\"releaseNotes\":\"1. Add Channel Medal\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-08-31\",\"releaseTime