f-4e17-b3f8-ea998012df1b__U514d_U8d39_U91d1_U5e01@2x.png/{w}x{h}{c}.{f}\",\"bgColor\":\"006f81\",\"textColor1\":\"faecae\",\"textColor2\":\"fdd43a\",\"textColor3\":\"c8d3a5\",\"textColor4\":\"cac048\"}]}}}}}},\"fileSizeByDevice\":{\"iPhone13,4\":252041216,\"iPhone13,3\":252041216,\"iPhone13,2\":252041216,\"iPhone13,1\":252041216,\"iPhone6,1\":240184320,\"iPhone6,2\":240184320,\"iPad8,12\":230651904,\"iPad8,11\":230651904,\"iPad8,10\":230651904,\"iPad14,6-A\":230232064,\"iPad14,6-B\":230232064,\"iPad7,6\":240663552,\"iPad7,5\":240663552,\"iPad7,4\":240671744,\"iPad7,3\":240671744,\"iPad7,2\":240671744,\"RealityFamily22,1\":230232064,\"iPad7,1\":240671744,\"iPad14,1\":230232064,\"iPad14,2\":230232064,\"iPhone12,1\":230209536,\"iPhone9,4\":262597632,\"iPhone16,1\":251621376,\"iPhone9,2\":262597632,\"iPhone12,5\":252041216,\"iPhone9,3\":240188416,\"iPhone12,3\":252041216,\"iPhone9,1\":240188416,\"iPad7,12\":230651904,\"iPhone12,8\":230184960,\"iPad14,3-A\":230232064,\"iPad14,3-B\":230232064,\"iPhone16,2\":251621376,\"iPod7,1\":240184320,\"iPad8,5\":240671744,\"iPad4,9\":240663552,\"iPad8,4\":240671744,\"iPad4,8\":240663552,\"iPad8,3\":240671744,\"iPad4,7\":240663552,\"iPad11,1\":232203264,\"iPad8,2\":240671744,\"iPad4,6\":240663552,\"iPad8,1\":240671744,\"iPad4,5\":240663552,\"iPad4,4\":240663552,\"iPad4,3\":240663552,\"iPad4,2\":240663552,\"iPad8,9\":230651904,\"iPad8,8\":240671744,\"iPad8,7\":240671744,\"iPad8,6\":240671744,\"iPad7,11\":230651904,\"iPad11,6\":230651904,\"iPad4,1\":240663552,\"iPad11,7\":230651904,\"iPad11,2\":232203264,\"iPad11,3\":232203264,\"iPad11,4\":232203264,\"iPhone11,2\":262597632,\"iPhone15,2\":251621376,\"iPhone11,6\":262597632,\"iPhone8,4\":240184320,\"iPhone8,1\":240184320,\"iPhone11,4\":262597632,\"iPhone8,2\":262593536,\"iPad14,4-B\":230232064,\"iPhone15,5\":251621376,\"iPhone15,4\":251621376,\"iPhone11,8\":240212992,\"iPad14,4-A\":230232064,\"iPhone15,3\":251621376,\"iPad5,4\":240663552,\"iPad13,10\":230651904,\"iPad5,3\":240663552,\"iP