vacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Infrequent/Mild Profanity or Crude Humour\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":128,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/higo-chat-meet-friends/id6448778488\",\"userRating\":{\"value\":4.1,\"ratingCount\":301,\"ratingCountList\":[54,7,11,24,205],\"ariaLabelForRatings\":\"4.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"4.1.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Higo-Chat \u0026 Meet Friends\",\"isPreorder\":false,\"artistName\":\"FUNI.PTE.LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Higo, provides a CHILL \u0026 CHAT space for us.  Join Higo's online party!\\nHave a great day with us!\\n\\nWhy Higo？\\nChat With Real People\\n-Higo is an app to chat with real people online, with users from all corners of the world! No matter which country, you can chat together.It’s easy and fun to meet firends on Higo. \\n\\nEntertaining  Community \\n-Create rooms more convenient     \\n-Higo is filled with diverse, voice content streaming every second!\\n\\nExperience  Avatars\\n-Make an avatar and make friends, live chat, \u0026 more with people from all over the world\\n\\nHealthy Community\\n-Many people will share their life moments here, let us thumsup for their wonderful moments. There are also many people who use their own voices to introduce themselves. You can directly listen to her/his voice or browse her/his photos before you know each other.\\n\\nSharing Moment\\n-No matter daily life or mood quotes, sharing your life,Send comments and express likes to your friends.\\n\\nWant more features? Get Higo right now!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"5.3.2\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-05-23\",\"releaseTimestamp\":\"2024-05-23T03:41:03Z\"},{\"versionDisplay\":\"5.3.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-05-15\",\"releaseTimestamp\":\"2024-05-15T02:41:41Z\"},{\"versionDisplay\":\"5.2.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-05-10\",\"releaseTimestamp\":\"2024-05-10T03:02:01Z\"},{\"versionDisplay\":\"5.1.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-04-25\",\"releaseTimestamp\":\"2024-04-25T03:13:54Z\"},{\"versionDisplay\":\"5.0.2\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-04-23\",\"releaseTimestamp\":\"2024-04-23T07:16:41Z\"},{\"versionDisplay\":\"5.0.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2024-04