m/sa/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/sa/apps/1544887147/genres?l=en-GB\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6014?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"url\":\"https://itunes.apple.com/sa/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7004?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7004\"}},{\"id\":\"7003\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/7003?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Casual\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/sa/genre/id7003\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1716339144499,\"RTCI\":1716538367385}}},{\"id\":\"6444792857\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/6444792857?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/yalla-match-vogue-star/id6444792857\",\"userRating\":{\"value\":5,\"ratingCount\":1,\"ratingCountList\":[0,0,0,0,1],\"ariaLabelForRatings\":\"5.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.5\",\"name\":\"Yalla Match - Vogue Star\",\"genreDisplayName\":\"Puzzle\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Features:\\n- No ADs\\n- No internet connection required, play offline anytime, anywhere!\\n- Enjoy a unique fashion-themed match-3 game with amusing obstacles and fun levels. It's suitable for both experts and beginners!\\n- Unlock and activate the powerful boosters! Experience the unique time freeze booster!\\n- Open mysterious treasure chests to get gold coins, unlimited lives and power-ups!\\n- Set up personal image studio and earn extra coins!\\n- Help helpless customers reshape their image and give them the confidence to pursue their dreams!\\n- Drama is everywhere, get ready to meet some dramatic characters!\\n\\n\\n\\nWelcome to Yalla Match – a personal fashion studio that gives customers new looks!\\n\\nAre you ready? College graduate new to society, music teacher chasing rock'n'roll dreams, painter who has lost his inspiration... helpless customers are waiting for your help! Start your career as a fashion stylist now! Develop a plan for each customer to help them rebuild their image, regain their confidence and start a new life full of hope! Stay alert of the conceited Kamila, she will interfere with your work, don't let her destroy your customers' confidence!\\n\\n\\nOn this fun-filled journey, you can earn coins by beating match-3 levels, complete makeovers to get props to continue your journey. You can also participate in activities such as Mystic Masquerade, Best Popularity, Club Battle, etc. to compete with other stylists and win rich rewards! There is no end to the fun and challenges!\\n\\n\\nEmbark on an epic journey as a stylist! Download now and start the challenge!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"versionHistory\":[{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Comprehensive upgrade of the Game UI.\\nAdded Mini Games.\\nBug fixes and experience improvements.\\nPerformance optimization targeted for most devices.\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T10:41:49Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":null,\"releaseDate\":\"2024-03-08\",\"releaseTimestamp\":\"2024-03-08T00:41:44Z\"}],\"websiteUrl\":\"https://www.yallamatch3.com/\",\"isXROSCompatible\":false,\"minimumXROSVersion\":\"1.0\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Polish your look with every win\"},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=865553337\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":256216064}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=865553337\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":256216064}]}],\"requires32bit\":false,\"releaseDate\":\"2024-03-07\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yallagame.yallamatch\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"ht