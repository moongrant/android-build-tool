,\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1716478263800,\"MZ_INDEXER\":1716477710995}}},{\"id\":\"1377028992\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1377028992?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Simulated Gambling\",\"Frequent/Intense Profanity or Crude Humour\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Horror/Fear Themes\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Medical/Treatment Information\",\"Infrequent/Mild Realistic Violence\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/youstar-group-voice-chat-room/id1377028992\",\"userRating\":{\"value\":4.2,\"ratingCount\":277,\"ratingCountList\":[29,11,22,36,179],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"7.5.8\",\"name\":\"YouStar-Group Voice Chat Room\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"GOOD ONLINE TECHNOLOGY PTE.LTD.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"In this busy digital age, let's step into a world of endless entertainment and a social network full of surprises for making friends. Welcome to YouStar - a new APP that combines a variety of entertainment content and social interaction!\\r\\n\\r\\nFree voice chat room\\r\\nYouStar has the safest and smoothest voice group chat room. No matter where you are, you can chat safely with Arab friends all over the world for free. Supports enjoying real-time voice chat using 3G, 4G, LTE or WI-FI networks.\\r\\n\\r\\nFree online party\\r\\nYou can hold free parties for birthdays, National Day, and Eid al-Fitr, or watch football matches in the room with like-minded friends for real-time commentary, or discuss the zodiac explanation to answer the zodiac password for you.\\r\\n\\r\\nCool virtual gifts\\r\\nIn the chat room you can exchange cool gifts with your friends. There are stunning animated special effects to suit your needs.\\r\\n\\r\\nWonderful game\\r\\nAlthough life is busy with trivial matters, YouStar will bring you a one-stop entertainment experience. In this app, you can play various exciting and fun mini-games such as Ludo, UMO, Crush, Lucky wheel, Fruit Roulette... and unlock endless gaming fun. From casual elimination to strategic competition, whether you are a newbie or an expert, you can find a game world that belongs to you.\\r\\n\\r\\nWatch rich video content\\r\\nIn addition to games, YouStar can also watch various music MVs and video content from Youtube. Welcome to enjoy music from all over the world anytime and anywhere. Whether it is a popular hit or a retro classic, there is always a song that will suit your mood. The rich video content covers various fields such as comedy, food, tourism, technology, culture, etc., allowing you to travel around the world and experience different wonderful lives in just a few minutes.\\r\\n\\r\\nCommunity accessibility\\r\\nYouStar is not only entertainment, but also a warm social circle. Here, you can meet like-minded friends and share the joy of entertainment and life with each other. Adding friends, instant chat, and interactive comments all reflect the warmth of friendship and the power of care. You can also show your talents here, share your mood text, and share the beauty of life with everyone.\\r\\n\\r\\nPersonalized recommendation\\r\\nWe have carefully designed a personalized push function to recommend more entertainment content and social activities that suit your tastes based on your interests and usage habits. Whether you are a warrior who likes to challenge yourself, or an artistic youth who enjoys tranquility, YouStar can find the most suitable content for you, allowing you to find a sense of belonging and resonance here.\\r\\n\\r\\nLive video\\r\\nAt the same time, our live broadcast function will also give you an immersive viewing experience. Watch the wonderful live broadcast, interact with everyone, become a member of the fan circle, and feel the real and beautiful emotional resonance.\\r\\n\\r\\nJoin YouStar now! Here, you will no longer be alone, because there is always a group of people in the world waiting to meet you and explore unlimited joy and passion together. Let us create our own new era of entertainment and social interaction together!\\n\\nMore information can be found here:\\nYouStar Terms of Service: https://www.youstar.top/about/terms_of_service.html\\nYouStar Privacy Policy: https://www.youstar.top/about/privacy.html\\n\\nFollow us\\nhttps://www.Facebook.com/youstarvideochatvlogsapp\\nhttps://www.Twitter.com/youstarvlogsapp\\nhttps://www.Instagram.com/youstar_videochat_vlogs_app/\\nhttps://www.Pinterest.com/youstarvideochatvlogs\u2028\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.0.2\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-05-21\",\"releaseTimestamp\":\"2024-05-21T01:24:13Z\"},{\"versionDisplay\":\"8.0.1\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T01:22:58Z\"},{\"versionDisplay\":\"8.0.0\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-04-26\",\"releaseTimestamp\":\"2024-04-26T01:32:46Z\"},{\"versionDisplay\":\"7.9.8\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-04-15\",\"releaseTimestamp\":\"2024-04-15T01:09:35Z\"},{\"versionDisplay\":\"7.9.6\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-03-12\",\"releaseTimestamp\":\"2024-03-12T19:07:10Z\"},{\"versionDisplay\":\"7.9.5\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-02-05\",\"releaseTimestamp\":\"2024-02-05T23:53:15Z\"},{\"versionDisplay\":\"7.9.4\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"re