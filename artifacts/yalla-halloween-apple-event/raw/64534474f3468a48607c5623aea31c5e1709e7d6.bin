35904,\"iPhone10,4\":72736768,\"iPhone7,1\":74235904,\"iPad13,19\":62737408,\"iPad14,5-A\":62737408,\"iPhone14,7\":64199680,\"iPhone14,6\":62737408,\"iPad14,5-B\":62737408,\"iPad13,11\":63157248,\"iPhone14,5\":64199680,\"iPhone14,4\":64199680,\"iPad13,17\":62737408,\"iPad13,18\":62737408,\"universal\":86962176,\"iPod9,1\":64176128,\"iPad13,16\":62737408,\"iPhone14,8\":64199680,\"iPad6,7\":72736768,\"iPad6,4\":72736768,\"iPad6,3\":72736768,\"iPad6,8\":72736768,\"iPad13,8\":63157248,\"iPad13,9\":63157248,\"iPad13,4\":63157248,\"iPad13,5\":63157248,\"iPad13,6\":63157248,\"iPad13,7\":63157248,\"iPad13,1\":63157248,\"iPad13,2\":63157248}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/us/apps/1488887716/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1488887716/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":0,\"MZ_INDEXER\":1698813466423}}},{\"id\":\"1594494132\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1594494132?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Profanity or Crude Humor\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/waha-3d-avatar-voice-chat/id1594494132\",\"userRating\":{\"value\":3.6,\"ratingCount\":28,\"ratingCountList\":[8,1,2,1,16],\"ariaLabelForRatings\":\"3.6 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Waha - 3D Avatar Voice Chat\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Discover a virtual world which connects friends with endless possibilities in Waha!\\n\\n\\nParty \u0026 meetup in virtual 3D scenes\\nExplore fascinating virtual locations curated for you. Start your party and roleplay games in a modern townhouse, isolated island, or in a stunning garden.\\n\\n\\nEnjoy your best times with real-time voice chat\\nFriendships are true in Waha. Join the voice chat, sing songs or discuss your favourite topics and share your feelings. All perfected to offer you the virtual life where you can be as unique as you wish.\\n\\n\\nCustomize the Avatar to express yourself\\nBe as you like, create your dream character, and keep up with fashion trends and dress up with a selection of various unique items, including shiny hairstyles, traditional thobes, trendy jeans, gorgeous one-piece dresses and many more to discover.\\n\\n\\nWe are dedicated to launching more enjoyable features for all of you in the upcoming days. Waha community is your virtual oasis where you will never be alone.\\n\\n\\nFollow us for more updates and news.\\nWebsite: www.wahachat.com\\n\\n\\nYour feedback and advice are vital for our development. Please contact us through Email at: support@wahachat.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.wahachat.com\",\"versionHistory\":[{\"versionDisplay\":\"1.3.3\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-24\",\"releaseTimestamp\":\"2023-10-24T01:25:06Z\"},{\"versionDisplay\":\"1.3.2\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-19\",\"releaseTimestamp\":\"2023-10-19T12:59:54Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2023-03-13\",\"releaseTimestamp\":\"2023-03-13T10:14:02Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"1) Interface Update: A brand-new user interface has been added to the rooms, providing a better chat experience.\\r\\n2) Room level: Room owners can now upgrade the levels of their rooms and increase their capacity.\\r\\n3) FAQ Shortcut: If you have any questions about how to use Waha, simply get the answer by clicking on the FAQ button in the Waha Team message.\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T02:03:22Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T06:03:41Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"1. Capture Photos: Now supporting the ability to capture wonderful moments inside rooms. You can save these photos as memories or set them as room previews!\\r\\n2. Guide Icons: These icons show you the items you can interact with inside the 3D scenes, allowing you to quickly explore Waha’s virtual worlds. \\r\\n3. Performance Enhancement: Bug fixes have been implemented to improve the Waha user experience.\",\"releaseDate\":\"2023-01-03\",\"releaseTimestamp\":\"2023-01-03T01:55:09Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"1. In-Room Message Notifications: Access your private messages from inside rooms and instantly find out who messaged you!\\r\\n2. Next-Day Login Reward: Receive \\\"Tomorrow's Login Invitation\\\" and claim your Next-Day Rewards.\\r\\n3. Bug Fixes: Fixed a few bugs to improve the Waha user experience.\",\"releaseDate\":\"2022-12-10\",\"releaseTimestamp\":\"2022-12-10T13:53:39Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-11-12\",\"releaseTimestamp\":\"2022-11-12T01:17:47Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"1. Face Customization: You can now customize your avatar's face and makeup to create a unique Waha avatar.\\r\\n\\r\\n2. Active Rooms \u0026 Users Rankings: You can now view rankings showcasing the most active rooms and users on the platform.\\r\\n\\r\\n3. Friends Rooms List: This newly added feature allows you to view and enter rooms where you and your friends can easily gather.\",\"releaseDate\":\"2022-11-04\",\"releaseTimestamp\":\"2022-11-04T05:47:14Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T02:35:00Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1-In-Room Features: Watch YouTube videos on a virtual screen, enjoy interactive dances and handshakes with your friends, and enjoy a better 3D gifting experience.\\n2-Level Progress \u0026 Rewards: Level up by completing tasks that get you more rewards and experience. You can also enjoy new rewards daily just by logging in!\\n3-Other Features: You can now find out which of your friends are online and you can also add personal labels to match your interests with that of others! \",\"releaseDate\":\"2022-09-17\",\"releaseTimestamp\":\"2022-09-17T11:06:38Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-08-06\",\"releaseTimestamp\":\"2022-08-06T04:41:18Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"1. Music Feature - Added a 'Play Music' feature in rooms.\\r\\n2. Private Conversations - Now supporting private conversations with users who are outside your friend list.\\r\\n3. Share with your friends - Now you can share Waha rooms via Facebook and WhatsApp.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T02:00:54Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. You can invite friends in Waha to gather in current room.\\n2. In-room Status: you can now have a quick access to rooms that other users have joined.\\n3. Search feature: you can use key words to search for rooms or users.\",\"releaseDate\":\"2022-04-29\",\"releaseTimestamp\":\"2022-04-29T03:36:49Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2022-03-10\",\"releaseTimestamp\":\"2022-03-10T02:29:28Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Create your own virtual world\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1594494132\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=860884725\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":269231104}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1594494132\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=860884725\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":269231104}]}],\"requires32bit\":false,\"releaseDate\":\"2022-03-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.wahachat3d\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/4f/9b/61/4f9b6153-630e-b037-7e0d-6090ca9773d8/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00ffa2\",\"textColor1\":\"190d0d\",\"textColor2\":\"231613\",\"textColor3\":\"143d2b\",\"textColor4\":\"1c4430\"},\"privacyPolicyUrl\":\"https://www.wahachat.com/policy\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.wahachat.com/\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9