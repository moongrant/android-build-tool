,\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"FUNI.PTE.LTD.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/funi-pte-ltd/id1526086697\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":0,\"MZ_INDEXER\":1698890542215}}},{\"id\":\"1489566586\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1489566586?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/bobo-group-voice-chat-rooms/id1489566586\",\"userRating\":{\"value\":4,\"ratingCount\":116,\"ratingCountList\":[18,5,5,20,68],\"ariaLabelForRatings\":\"4.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"BoBo - Group Voice Chat Rooms\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"思伟 邹\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"BoBo is a global free voice chat app that supports Group voice chat rooms, you can chat and play games with your friends, even share your voice to make new friends.\\nDownload BoBo App and join the most interesting social party!\\n \\nWhy BoBo is the best social app for you?\\n \\nFree voice chat\\nYou can voice chat at any time, anywhere with a mobile data or WIFI, with us, you can meet the one you like.\\n \\nVoice chat rooms\\nChat with new friends all over the world.\\nJoin the most interesting magic social community in the world. Here you can introduce yourself to everyone, singing and sharing your interesting daily, and also make new friends all over the world.\\n \\nVirtual gifts\\nIf you meet someone but you don't know how to express your feelings? Just send a small gift to let him/her notice you.\\n \\nInteresting chat journey\\nBoBo has more than 6 types of rooms, you can find whatever you need\\nEmotional radio station: let you have a friend who will listen to you on the Internet and share your happiness; you will also meet new friends who have common interests with you here.\\nGame/Task room: let you relax and have fun with online games and some interesting task.\\nStill, there are other interesting chat rooms waiting for you to experience.\\n \\nBoBo requests the following permissions:\\nMicrophone: Delivering sound during live broadcast\\nCamera: Take photos and videos\\nAuthorization Request: BoBo needs your permission to obtain storage space that helps you to get a better experience and ensure the normal use of the app\\n \\nCome to join our big family and follow us to get the latest news, updates and also activity in the application. We Appreciate your support, And we will continue to improve and update BoBo to give you the best experience.\\nEmail: dev@chucp.mobi\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"3.5.0\",\"releaseNotes\":\"1. You can now purchase a room number~\\n2. PK can customize the punishment avatar and nickname~\\n3. Added online customer service function\\n4. Added various levels of rewards\",\"releaseDate\":\"2023-11-07\",\"releaseTimestamp\":\"2023-11-07T01:28:00Z\"},{\"versionDisplay\":\"3.4.3\",\"releaseNotes\":\"1.Fixed crash\",\"releaseDate\":\"2023-10-28\",\"releaseTimestamp\":\"2023-10-28T17:33:45Z\"},{\"versionDisplay\":\"3.4.2\",\"releaseNotes\":\"1. The family can change its name\\n2. Added new games\\n3. Game currency can be exchanged for goods\\n4. You can report chat information\",\"releaseDate\":\"2023-10-27\",\"releaseTimestamp\":\"2023-10-27T12:32:11Z\"},{\"versionDisplay\":\"3.4.1\",\"releaseNotes\":\"1. The family can change its name\\n2. Added new games\\n3. Game currency can be exchanged for goods\\n4. You can report chat information\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T14:07:30Z\"},{\"versionDisplay\":\"3.4.0\",\"releaseNotes\":\"1. The family can change its name\\n2. Added new games\\n3. Game currency can be exchanged for goods\\n4. You can report chat information\",\"releaseDate\":\"2023-10-23\",\"releaseTimestamp\":\"2023-10-23T01:27:17Z\"},{\"versionDisplay\":\"3.3.3\",\"releaseNotes\":\"1.fix crash\",\"releaseDate\":\"2023-10-08\",\"releaseTimestamp\":\"2023-10-08T01:43:48Z\"},{\"versionDisplay\":\"3.3.2\",\"releaseNotes\":\"1. Add new gameplay, come and try it\\n2. Fixed some bugs\",\"releaseDate\":\"2023-10-02\",\"releaseTimestamp\":\"2023-10-02T16:25:56Z\"},{\"versionDisplay\":\"3.3.1\",\"releaseNotes\":\"1. Add new gameplay, come and try it\\n2. Fixed some bugs\",\"releaseDate\":\"2023-09-06\",\"releaseTimestamp\":\"2023-09-06T01:38:21Z\"},{\"versionDisplay\":\"3.2.3\",\"releaseNotes\":\"1. New in-room battle mode, come and play\\n2. Newly added interactive gifts for wheat bits, new interactive effects\\n3. Fixed some bugs\",\"releaseDate\":\"2023-08-30\",\"releaseTimestamp\":\"2023-08-30T01:26:43Z\"},{\"versionDisplay\":\"3.2.2\",\"releaseNotes\":\"1. New in-room battle mode, come and play\\n2. Newly added interactive gifts for wheat bits, new interactive effects\\n3. Fixed some bugs\",\"releaseDate\":\"2023-08-10\",\"releaseTimestamp\":\"2023-08-10T01:57:26Z\"},{\"versionDisplay\":\"3.2.1\",\"releaseNotes\":\"1. New in-room battle mode, come and play\\n2. Newly added interactive gifts for wheat bits, new interactive effects\\n3. Fixed some bugs\",\"releaseDate\":\"2023-07-24\",\"releaseTimestamp\":\"2023-07-24T01:52:02Z\"},{\"versionDisplay\":\"3.2.0\",\"releaseNotes\":\"1. New in-room battle mode, come and play\\n2. Newly added interactive gifts for wheat bits, new interactive effects\\n3. Fixed some bugs\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T08:34:55Z\"},{\"versionDisplay\":\"3.1.1\",\"releaseNotes\":\"1. New Eid al-Adha event\\n2. Fixed some bugs\",\"releaseDate\":\"2023-06-29\",\"releaseTimestamp\":\"2023-06-29T02:26:18Z\"},{\"versionDisplay\":\"3.1.0\",\"releaseNotes\":\"1. New Eid al-Adha event\\n2. Fixed some bugs\",\"releaseDate\":\"2023-06-24\",\"releaseTimestamp\":\"2023-06-24T16:22:13Z\"},{\"versionDisplay\":\"3.0.1\",\"releaseNotes\":\"1. The Mine page UI has been reworked\\n2. Posts can send voting content and @friends\\n3. The shopping mall page looks better\\n4. More gameplay is waiting for you to discover\",\"releaseDate\":\"2023-06-07\",\"releaseTimestamp\":\"2023-06-07T13:19:43Z\"},{\"versionDisplay\":\"3.0.0\",\"releaseNotes\":\"1. The Mine page UI has been reworked\\n2. Posts can send voting content and @friends\\n3. The shopping mall page looks better\\n4. More gameplay is waiting for you to discover\",\"releaseDate\":\"2023-06-05\",\"releaseTimestamp\":\"2023-06-05T23:51:30Z\"},{\"versionDisplay\":\"2.43.0\",\"releaseNotes\":\"1. The Mine page UI has been reworked\\n2. Posts can send voting content and @friends\\n3. The shopping mall page looks better\\n4. More gameplay is waiting for you to discover\",\"releaseDate\":\"2023-05-24\",\"releaseTimestamp\":\"2023-05-24T00:20:00Z\"},{\"versionDisplay\":\"2.42.1\",\"releaseNotes\":\"1. Added room level and fan level, come and upgrade~\\n2. The gift panel shows more content~\\n3. The new Hot homepage looks better\",\"releaseDate\":\"2023-05-09\",\"releaseTimestamp\":\"2023-05-09T01:16:44Z\"},{\"versionDisplay\":\"2.42.0\",\"releaseNotes\":\"1. Added room level and fan level, come and upgrade~\\n2. The gift panel shows more content~\\n3. The new Hot homepage looks better\",\"releaseDate\":\"2023-04-27\",\"releaseTimestamp\":\"2023-04-27T23:57:37Z\"},{\"versionDisplay\":\"2.41.0\",\"releaseNotes\":\"1. Added points mall, which can be exchanged for many new things\\n2. Added an official anchor, which can be exchanged for more gold coins, come and sign the contract\\n3. The room supports posting pictures\\n4. Posts can post videos\\n5. Egg optimization\",\"releaseDate\":\"2023-04-03\",\"releaseTimestamp\":\"2023-04-03T01:39:11Z\"},{\"versionDisplay\":\"2.40.1\",\"releaseNotes\":\"1. The room music has been greatly revised, and it is more convenient to play music\\n2. Optimize the gameplay of Ludo and other games\\n3. More new optimizations are waiting for you to discover\",\"releaseDate\":\"2023-03-17\",\"releaseTimestamp\":\"2023-03-17T01:40:53Z\"},{\"versionDisplay\":\"2.40.0\",\"releaseNotes\":\"1. The room music has been greatly revised, and it is more convenient to play music\\n2. Optimize the gameplay of Ludo and other games\\n3. More new optimizations are waiting for you to discover\",\"releaseDate\":\"2023-03-15\",\"releaseTimestamp\":\"2023-03-15T01:22:37Z\"},{\"versionDisplay\":\"2.39.1\",\"releaseNotes\":\"1. It is more convenient to select a country on the home page~\\n2. The wallet page looks better~\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-25\",\"releaseTimestamp\":\"2023-02-25T08:08:07Z\"},{\"versionDisplay\":\"2.39.0\",\"releaseNotes\":\"1. It is more convenient to select a country on the home page~\\n2. The wallet page looks better~\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T00:16:03Z\"},{\"versionDisplay\":\"2.38.0\",\"releaseNotes\":\"1. Gifts can be combo~\\n2. New way of smashing eggs\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T23:55:15Z\"}],\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1489566586\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=861270803\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":298815488}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1489566586\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=861270803\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":298815488}]}],\"requires32bit\":false,\"releaseDate\":\"2019-12-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.duidui.meetyo\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/95/82/ea/9582ea8f-a1fb-1be9-c491-5c7cfc502be2/AppIcon-1x_U007emarketing-0-7-0-0-0-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f436de\",\"textColor1\":\"0e0115\",\"textColor2\":\"161616\",\"textColor3\":\"3c0b3d\",\"textColor4\":\"431d3e\"},\"privacyPolicyUrl\":\"https://bobo-gift.nanshandjs.com/BoBoAgreementPrivacy/bobo_privacy.html\",\"videoPreviewsByType\":{},\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\"