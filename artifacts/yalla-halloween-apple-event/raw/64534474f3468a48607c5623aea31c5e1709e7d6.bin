taCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Frequent/Intense Simulated Gambling\",\"Infrequent/Mild Profanity or Crude Humor\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.2,\"ratingCount\":340,\"ratingCountList\":[40,10,22,22,246],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Falla-Make new friends\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"6.5.6\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-31\",\"releaseTimestamp\":\"2023-10-31T15:07:20Z\"},{\"versionDisplay\":\"6.5.5\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-30\",\"releaseTimestamp\":\"2023-10-30T03:01:25Z\"},{\"versionDisplay\":\"6.5.2\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T02:23:10Z\"},{\"versionDisplay\":\"6.5.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-12\",\"releaseTimestamp\":\"2023-10-12T02:28:17Z\"},{\"versionDisplay\":\"6.5.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T07:03:17Z\"},{\"versionDisplay\":\"6.4.6\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-08\",\"releaseTimestamp\":\"2023-10-08T10:05:11Z\"},{\"versionDisplay\":\"6.4.4\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-09-26\",\"releaseTimestamp\":\"2023-09-26T08:34:22Z\"},{\"versionDisplay\":\"6.4.3\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-09-18\",\"releaseTimestamp\":\"2023-09-18T02:41:34Z\"},{\"ve