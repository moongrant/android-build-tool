\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1589399089/developer?l=en-US\",\"data\":[{\"id\":\"1559722257\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1559722257?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"WEJOY PTE. LTD.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/wejoy-pte-ltd/id1559722257\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1698805477209,\"RTCI\":1698988282595}}},{\"id\":\"1377028992\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1377028992?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Frequent/Intense Profanity or Crude Humor\",\"Infrequent/Mild Realistic Violence\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Medical/Treatment Information\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Simulated Gambling\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/youstar-group-voice-chat-room/id1377028992\",\"userRating\":{\"value\":4.2,\"ratingCount\":201,\"ratingCountList\":[20,10,16,19,136],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"7.5.8\",\"name\":\"YouStar-Group Voice Chat Room\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Stonemobile India Private Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"In this busy digital age, let's step into a world of endless entertainment and a social network full of surprises for making friends. Welcome to YouStar - a new APP that combines a variety of entertainment content and social interaction!\\r\\n\\r\\nFree voice chat room\\r\\nYouStar has the safest and smoothest voice group chat room. No matter where you are, you can chat safely with Arab friends all over the world for free. Supports enjoying real-time voice chat using 3G, 4G, LTE or WI-FI networks.\\r\\n\\r\\nFree online party\\r\\nYou can hold free parties for birthdays, National Day, and Eid al-Fitr, or watch football matches in the room with like-minded friends for real-time commentary, or discuss the zodiac explanation to answer the zodiac password for you.\\r\\n\\r\\nCool virtual gifts\\r\\nIn the chat room you can exchange cool gifts with your friends. There are stunning animated special effects to suit your needs.\\r\\n\\r\\nWonderful game\\r\\nAlthough life is busy with trivial matters, YouStar will bring you a one-stop entertainment experience. In this app, you can play various exciting and fun mini-games such as Ludo, UMO, Crush, Lucky wheel, Fruit Roulette... and unlock endless gaming fun. From casual elimination to strategic competition, whether you are a newbie or an expert, you can find a game world that belongs to you.\\r\\n\\r\\nWatch rich video content\\r\\nIn addition to games, YouStar can also watch various music MVs and video content from Youtube. Welcome to enjoy music from all over the world anytime and anywhere. Whether it is a popular hit or a retro classic, there is always a song that will suit your mood. The rich video content covers various fields such as comedy, food, tourism, technology, culture, etc., allowing you to travel around the world and experience different wonderful lives in just a few minutes.\\r\\n\\r\\nCommunity accessibility\\r\\nYouStar is not only entertainment, but also a warm social circle. Here, you can meet like-minded friends and share the joy of entertainment and life with each other. Adding friends, instant chat, and interactive comments all reflect the warmth of friendship and the power of care. You can also show your talents here, share your mood text, and share the beauty of life with everyone.\\r\\n\\r\\nPersonalized recommendation\\r\\nWe have carefully designed a personalized push function to recommend more entertainment content and social activities that suit your tastes based on your interests and usage habits. Whether you are a warrior who likes to challenge yourself, or an artistic youth who enjoys tranquility, YouStar can find the most suitable content for you, allowing you to find a sense of belonging and resonance here.\\r\\n\\r\\nLive video\\r\\nAt the same time, our live broadcast function will also give you an immersive viewing experience. Watch the wonderful live broadcast, interact with everyone, become a member of the fan circle, and feel the real and beautiful emotional resonance.\\r\\n\\r\\nJoin YouStar now! Here, you will no longer be alone, because there is always a group of people in the world waiting to meet you and explore unlimited joy and passion together. Let us create our own new era of entertainment and social interaction together!\\n\\nMore information can be found here:\\nYouStar Terms of Service: https://www.youstar.top/about/terms_of_service.html\\nYouStar Privacy Policy: https://www.youstar.top/about/privacy.html\\n\\nFollow us\\nhttps://www.Facebook.com/youstarvideochatvlogsapp\\nhttps://www.Twitter.com/youstarvlogsapp\\nhttps://www.Instagram.com/youstar_videochat_vlogs_app/\\nhttps://www.Pinterest.com/youstarvideochatvlogs\u2028\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"7.8.8\",\"releaseNotes\":\"1）New Game online :Fishing Star\\n2) Optimize product experience and fix some issues\",\"releaseDate\":\"2023-11-07\",\"releaseTimestamp\":\"2023-11-07T08:59:27Z\"},{\"versionDisplay\":\"7.8.7\",\"releaseNotes\":\"1) New feature: Mission Center \\n2) Revision of daily task rewards\\n3) Feedback \u0026 reporting channel optimization\\n4) Optimize product experience and fix some issues\",\"releaseDate\":\"2023-10-19\",\"releaseTimestamp\":\"2023-10-19T16:54:16Z\"},{\"versionDisplay\":\"7.8.6\",\"releaseNotes\":\"1) New feature: Mission Center \\n2) Revision of daily task rewards\\n3) Feedback \u0026 reporting channel optimization\\n4) Optimize product experience and fix some issues\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T02:39:27Z\"},{\"versionDisplay\":\"7.8.5\",\"releaseNotes\":\"1.Fix Some Known Bugs\",\"releaseDate\":\"2023-10-03\",\"releaseTimestamp\":\"2023-10-03T07:00:01Z\"},{\"versionDisplay\":\"7.8.4\",\"releaseNotes\":\"1.Fix Some Known Bugs\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T07:13:20Z\"},{\"versionDisplay\":\"7.8.3\",\"releaseNotes\":\"1) Added like function in the room\\n2) Improve Lucky wheel\\n3) Optimization of Smash eggs UI interface\\n4) New games: Monster crush, slots\\n5) Big gift broadcast optimization: support broadcasting outside the room\\n6) Lucky gift optimization\\n7) Added new chat hall\\n8) Optimize some functions\\n9) Anniversary theme UI\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T01:25:27Z\"},{\"versionDisplay\":\"7.8.2\",\"releaseNotes\":\"1) Added like function in the room\\n2) Improve Lucky wheel\\n3) Optimization of Smash eggs UI interface\\n4) New games: Monster crush, slots\\n5) Big gift broadcast optimization: support broadcasting outside the room\\n6) Lucky gift optimization\\n7) Added new chat hall\\n8) Optimize some functions\\n9) Anniversary theme UI\",\"releaseDate\":\"2023-09-15\",\"releaseTimestamp\":\"2023-09-15T13:03:47Z\"},{\"versionDisplay\":\"7.8.0\",\"releaseNotes\":\"1) App UI upgrade\\n2) New games online: Rocket  、Horse Racing、Jackpot.\\n3) Dynamic gift icon show up in gift list.\\n4) Banner page optimization.\",\"releaseDate\":\"2023-08-18\",\"releaseTimestamp\":\"2023-08-18T15:11:02Z\"},{\"versionDisplay\":\"7.7.8\",\"releaseNotes\":\"1）Bug fixes and performance improvements\",\"releaseDate\":\"2023-07-28\",\"releaseTimestamp\":\"2023-07-28T05:49:35Z\"},{\"versionDisplay\":\"7.7.7\",\"releaseNotes\":\"1）Fix known issues\",\"releaseDate\":\"2023-07-09\",\"releaseTimestamp\":\"2023-07-09T11:14:20Z\"},{\"versionDisplay\":\"7.7.6\",\"releaseNotes\":\"1) The gift record of the user homepage has been added to give a gift title \\n2) The user homepage has added a guardian \\n3) Ludo and Umo games have added matching to join the game \\n4) The music playback function has been optimized\",\"releaseDate\":\"2023-06-15\",\"releaseTimestamp\":\"2023-06-15T08:23:32Z\"},{\"versionDisplay\":\"7.7.4\",\"releaseNotes\":\"1) Videos can be added to the first picture of the personal homepage\\r\\n2) You can upload GIF and MP4 as avatar  in personal information\\r\\n3) Random gift online\\r\\n4) User level optimization and sending gifts can show the experience value of increasing level\\r\\n5) Quality optimization of the Live Stream room\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T01:39:40Z\"},{\"versionDisplay\":\"7.7.3\",\"releaseNotes\":\"1)Roomowner/Vice owner Mute all mic.\\n2) VIP Lounge optimization.\\n3) Banner game:Treasure chest\\n4)  Add daily sign-in badge \u0026 add badge notifications.\\n5) Added gift voting function in the room.\\n6) Q\u0026A Vote.\\n7) Room blacklist + User blacklist.\\n8) New user gift package \u0026 room entry guide.\\n9) [Bonus] Gift package for The first recharge .\",\"releaseDate\":\"2023-04-23\",\"releaseTimestamp\":\"2023-04-23T01:39:08Z\"},{\"versionDisplay\":\"7.7.2\",\"releaseNotes\":\" 1)Roomowner/Vice owner Mute all mic.\\n 2) VIP Lounge optimization.\\n 3) Banner game:Treasure chest\\n 4)  Add daily sign-in badge \u0026 add badge notifications.\\n 5) Added gift voting function in the room.\\n 6) Q\u0026A Vote.\\n 7) Room blacklist + User blacklist.\\n 8) New user gift package \u0026 room entry guide.\\n 9) [Bonus] Gift package for The first recharge .\",\"releaseDate\":\"2023-04-14\",\"releaseTimestamp\":\"2023-04-14T03:25:56Z\"},{\"versionDisplay\":\"7.7.1\",\"releaseNotes\":\"1) New gift \\\"Voice changer card\\\"online.\\n2) Room function improved, like automatically repeat massage and so on.\\n3) Friend online notification.\\n4) Discover page can Display online user avatar.\",\"releaseDate\":\"2023-03-14\",\"releaseTimestamp\":\"2023-03-14T11:06:39Z\"},{\"versionDisplay\":\"7.7.0\",\"releaseNotes\":\"1. Room events : owners can create room events .\\n2. Email login\\n3. Fix bugs and optimize experience.\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T01:52:35Z\"},{\"versionDisplay\":\"7.6.9\",\"releaseNotes\":\"1) Store reconstruction\\r\\n2) [Room Game] Launch new game UMO.\\r\\n3) [Moment]support for gift rewards\\r\\n4) [Room] Added The energy rocket function \",\"releaseDate\":\"2023-02-05\",\"releaseTimestamp\":\"2023-02-05T06:59:12Z\"},{\"versionDisplay\":\"7.6.5\",\"releaseNotes\":\"Ludo game fee increased diamond currency.\",\"releaseDate\":\"2022-11-21\",\"releaseTimestamp\":\"2022-11-21T14:00:52Z\"},{\"versionDisplay\":\"7.6.4\",\"releaseNotes\":\"1) [Moment] Top content display and sorting.\\r\\n 2) Optimization of interface interaction without network status.\\r\\n 3) [Room function] Clear the chat information on the public screen of the room.\\r\\n 4) 2022 Qatar World Cup Theme UI.\\r\\n 5) [Room function] The background content of the room has been classified, and diamond purchase is supported.\\r\\n 6) [Relationship Chain] Delete friends, follow and unfollow, delete chat history.\\r\\n 7) Room optimization.\",\"releaseDate\":\"2022-11-11\",\"releaseTimestamp\":\"2022-11-11T01:31:28Z\"},{\"versionDisplay\":\"7.6.2\",\"releaseNotes\":\"Fix known issues\",\"releaseDate\":\"2022-11-02\",\"releaseTimestamp\":\"2022-11-02T10:38:09Z\"},{\"versionDisplay\":\"7.6.1\",\"releaseNotes\":\"fix some problems and add room text limitation\\nmoment updated，come and try it\",\"releaseDate\":\"2022-10-22\",\"releaseTimestamp\":\"2022-10-22T16:25:47Z\"},{\"versionDisplay\":\"7.6.0\",\"releaseNotes\":\"1. Optimize the effect of sending gifts and gift broadcasting\\r\\n2. Support sending 9999 gifts\\r\\n3. Add a game room and a video room on the home page\\r\\n4.Application 5th anniversary theme\\r\\n5. Fix known issues\",\"releaseDate\":\"2022-09-12\",\"releaseTimestamp\":\"2022-09-12T16:32:23Z\"},{\"versionDisplay\":\"7.5.9\",\"releaseNotes\":\"Fixed some bugs and improved user experience\",\"releaseDate\":\"2022-08-25\",\"releaseTimestamp\":\"2022-08-25T23:39:47Z\"},{\"versionDisplay\":\"7.5.8\",\"releaseNotes\":\"1. Heart changed  to Coins, which can be exchanged for diamonds. Added Coins flow record query.\\r\\n2. Modification of gift interface\\r\\n3. Added Room online user page, room contribution list, new room profile page \\r\\n4. We have re-launched the Ludo game, come and play it~\\r\\n5. Optimized the sound quality of the room and fixed bugs.\",\"releaseDate\":\"2022-08-19\",\"releaseTimestamp\":\"2022-08-19T08:08:27Z\"},{\"versionDisplay\":\"7.5.5\",\"releaseNotes\":\"Improve the sound quality and optimize the sound lagging problem\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T17:40:42Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1377028992\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=861270873\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":614115328}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1377028992\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=861270873\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":614115328}]}],\"requires32bit\":false,\"releaseDate\":\"2018-06-02\",\"hasInAppPurchases\":true,\"bundleId\":\"com.stonemobile.youstar\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/c3/82/af/c382af81-d78b-1576-43e1-a71a85aaefaa/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0a0a0a\",\"textColor2\":\"1d1d1d\",\"textColor3\":\"3b3b3b\",\"textColor4\":\"4a4a4a\"},\"privacyPolicyUrl\":\"https://static.youstar.live/about/privacy.html\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.youstar.live\",\"isHiddenFromSpringboard\":false,\"isStandal