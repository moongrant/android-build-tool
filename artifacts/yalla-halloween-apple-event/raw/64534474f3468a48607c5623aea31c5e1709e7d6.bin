href\":\"/v1/catalog/us/apps/1377028992/developer?l=en-US\",\"data\":[{\"id\":\"1377028991\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1377028991?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Stonemobile India Private Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/stonemobile-india-private-limited/id1377028991\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1699347812942,\"RTCI\":0}}},{\"id\":\"286274367\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/286274367?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Profanity or Crude Humor\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Unrestricted Web Access\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Sexual Content and Nudity\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/wolf-qanawat/id286274367\",\"userRating\":{\"value\":4.3,\"ratingCount\":8706,\"ratingCountList\":[931,276,489,567,6443],\"ariaLabelForRatings\":\"4.3 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"11.0\",\"name\":\"WOLF Qanawat\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"Palringo Limited\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 15.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 15.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 15.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"The most entertaining and engaging interactive audio channels created by the largest Arabic communities. \\n- Discover and join your favourite channels. Why not go the extra step and establish your OWN channel and create your own community. \\n- Have a verified channel. Get your channel verified and host the best talents and entertainers to interact with your community. Showcase your expertise, gather a team, and create memorable shows.\\n- Enjoy live audio \u0026 text chat. Engage in real-time chat with the largest Arab communities and find new like-minded friends. \\n- Connect with thousands of new fans on WOLF stages. Unleash your talent and connect with channel owners and WOLFStars, where countless opportunities await for you. \\n- Events around the clock, filled with different topics, competition and challenges and plenty of fun, choose from among 500+ average daily shows to attend.\\n- Level up and be at the top with achievements, charms, and badges. And show off your status within your community. \\n- Gift from our wide variety of charms to show appreciation to your favourite entertainers and community members.\\n- Get key notifications and updates. Stay in the loop about live events, promos and new charms. Never miss the fun happening in your favourite channels \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://wolf.live\",\"versionHistory\":[{\"versionDisplay\":\"12.3\",\"releaseNotes\":\"Get ready for the exciting WOLF Qanawat update! Here's what's new:\\n\\nChannel Roles: Channel owners can now assign roles to their channel members, making it easier for them to manage channels and encourage community building.\\nTags for Channel Roles: Members with assigned roles will now have tags displayed next to their names in the channel chat screen, making it easier for other users to engage with them.\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T14:41:24Z\"},{\"versionDisplay\":\"12.1.4\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-10-05\",\"releaseTimestamp\":\"2023-10-05T09:05:23Z\"},{\"versionDisplay\":\"12.1.3\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-09-26\",\"releaseTimestamp\":\"2023-09-26T09:15:39Z\"},{\"versionDisplay\":\"12.1.2\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-09-18\",\"releaseTimestamp\":\"2023-09-18T12:48:04Z\"},{\"versionDisplay\":\"12.1.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-09-04\",\"releaseTimestamp\":\"2023-09-04T09:10:31Z\"},{\"versionDisplay\":\"12.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-08-17\",\"releaseTimestamp\":\"2023-08-17T09:10:00Z\"},{\"versionDisplay\":\"12.0.3\",\"releaseNotes\":\"In this version of the WOLF app, we are pleased to announce that a group of selected channels will receive a gold verification badge for premium channels, and accordingly:\\n- Premium channels and their owners will be granted many new perks.\\n- A special section will be allocated to explain more information about premium channels.\\n\\nWork on expanding your channel community to reach premium verification and enjoy unique perks!\",\"releaseDate\":\"2023-07-31\",\"releaseTimestamp\":\"2023-07-31T08:47:12Z\"},{\"versionDisplay\":\"12.0.2\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T08:50:14Z\"},{\"versionDisplay\":\"12.0.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\\n\\nUpdated store information\",\"releaseDate\":\"2023-07-10\",\"releaseTimestamp\":\"2023-07-10T08:52:52Z\"},{\"versionDisplay\":\"12.0\",\"releaseNotes\":\"Get ready for the exciting WOLF Qanawat update! Here's what's new:\\n\\n- New logo: We've given the logo a fresh makeover with \\\"WOLF Qanawat\\\" as we prioritize empowering your channels to achieve new levels of excellence\\n- Verified badge: The best performing channels now have a special blue verification badge!\\n- New icons: Updated our menu icons with the new launch \\n- Experience the excitement of WOLF Qanawat. Enjoy the fun!\\n- Language options: Now you can easily change the content language of the \\\"Discover\\\" screen from the settings menu\",\"releaseDate\":\"2023-06-29\",\"releaseTimestamp\":\"2023-06-29T12:55:49Z\"},{\"versionDisplay\":\"11.4.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2023-06-13\",\"releaseTimestamp\":\"2023-06-13T14:53:19Z\"},{\"versionDisplay\":\"11.4\",\"releaseNotes\":\"We are introducing a brand new look for the News Feed, with the live feed tab showing personal activity notifications including: event reminders and unlocking achievements and notifications housing all the system notifications sent by WOLF.\",\"releaseDate\":\"2023-05-30\",\"releaseTimestamp\":\"2023-05-30T09:00:16Z\"},{\"versionDisplay\":\"11.3.2\",\"releaseNotes\":\"Get ready for two new exciting features to elevate your experience at WOLF. Don’t miss a beat with our new ‘Live Now’ section featuring all the live events taking place. And that’s not all - we made it easier for new users to take a tour of what WOLF can offer, with new pop ups guiding you every step of the way. We’re not just stopping at that we’ve also taken care of some bugs and enhancements. Upgrade your experience today!\",\"releaseDate\":\"2023-05-03\",\"releaseTimestamp\":\"2023-05-03T12:50:55Z\"},{\"versionDisplay\":\"11.3.1\",\"releaseNotes\":\"A number of bug fixes and improvements.\",\"releaseDate\":\"2023-03-13\",\"releaseTimestamp\":\"2023-03-13T09:44:51Z\"},{\"versionDisplay\":\"11.3\",\"releaseNotes\":\"A game-changing update for content creators and music enthusiasts! With the brand new WOLFStars section in Users Profiles featuring show performance stats and the improved DJ Deck which introduces new features such as music playback modules\",\"releaseDate\":\"2023-03-06\",\"releaseTimestamp\":\"2023-03-06T10:37:09Z\"},{\"versionDisplay\":\"11.2.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2022-12-19\",\"releaseTimestamp\":\"2022-12-19T10:31:16Z\"},{\"versionDisplay\":\"11.2\",\"releaseNotes\":\"Large Groups - We have made some changes behind the groups that will allow us to raise the group member limit in the future. Users will see some visual improvements to the members list.\",\"releaseDate\":\"2022-11-29\",\"releaseTimestamp\":\"2022-11-29T10:45:28Z\"},{\"versionDisplay\":\"11.1.4\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-10-05\",\"releaseTimestamp\":\"2022-10-05T11:01:08Z\"},{\"versionDisplay\":\"11.1.3\",\"releaseNotes\":\"A number of bug fixes and improvements.\",\"releaseDate\":\"2022-09-06\",\"releaseTimestamp\":\"2022-09-06T12:57:05Z\"},{\"versionDisplay\":\"11.1.2\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-08-18\",\"releaseTimestamp\":\"2022-08-18T14:28:56Z\"},{\"versionDisplay\":\"11.1.1\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T08:48:05Z\"},{\"versionDisplay\":\"11.1\",\"releaseNotes\":\"Group Controls - This new features gives Group owners better control on the type of content in their Group, including the rate this content is displayed.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T09:36:44Z\"},{\"versionDisplay\":\"11.0.3\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-06-15\",\"releaseTimestamp\":\"2022-06-15T13:04:23Z\"},{\"versionDisplay\":\"11.0.2\",\"releaseNotes\":\"Improvements to app stability and performance.\",\"releaseDate\":\"2022-05-16\",\"releaseTimestamp\":\"2022-05-16T14:09:05Z\"},{\"versionDisplay\":\"11.0.1\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-02-24\",\"releaseTimestamp\":\"2022-02-24T11:11:24Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=286274367\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=860425249\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":131848192}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=286274367\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=860425249\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currenc