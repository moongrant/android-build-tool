nres\":{\"href\":\"/v1/catalog/us/apps/1514418573/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/us/genre/id6016\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1514418573/developer?l=en-US\",\"data\":[{\"id\":\"1513786283\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1513786283?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"BLAGOL TECHNOLOGY CO., LIMITED\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/blagol-technology-co-limited/id1513786283\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":0,\"MZ_INDEXER\":1699351512067}}},{\"id\":\"1317217120\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1317217120?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/starchat-group-voice-chat-room/id1317217120\",\"userRating\":{\"value\":4.1,\"ratingCount\":846,\"ratingCountList\":[136,20,43,45,602],\"ariaLabelForRatings\":\"4.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"name\":\"StarChat-Group Voice Chat Room\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"Star Chat International Limited\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nStarChat provides a variety of in-app purchases and subscriptions.If you choose to purchase an StarChat subscription,payment will be charged to your iTunes account after purchase confirmation.Your account will be charged the subscription amount within 24-hours prior to the end of the currnent period unless auto-renewal is turned off.Auto-renewal may be turned off at any time by going to your settings in the iTunes Store after purchase.\\n\\nPrivacy Policy：https://www.starchat.live/help/policy/Privacy_Policy.html\\nTerms of Service：https://www.starchat.live/help/policy/Terms_of_Service.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"http://www.starchat.live\",\"versionHistory\":[{\"versionDisplay\":\"7.5\",\"releaseNotes\":\"1. Added SVIP7 and SVIP8\\n2. Fix several bugs\",\"releaseDate\":\"2023-11-03\",\"releaseTimestamp\":\"2023-11-03T23:20:24Z\"},{\"versionDisplay\":\"7.4.1\",\"releaseNotes\":\"1. Fixed some bugs.\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T22:46:16Z\"},{\"versionDisplay\":\"7.4\",\"releaseNotes\":\"1. Add Premium subscription\\r\\n2. You can send voice messages in the channel now!\\r\\n\",\"releaseDate\":\"2023-10-19\",\"releaseTimestamp\":\"2023-10-19T12:55:21Z\"},{\"versionDisplay\":\"7.3\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-09-28\",\"releaseTimestamp\":\"2023-09-28T00:06:00Z\"},{\"versionDisplay\":\"7.2\",\"releaseNotes\":\"1. Added New Aristocracy level. The Sovereign comes！\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-09-21\",\"releaseTimestamp\":\"2023-09-21T23:25:06Z\"},{\"versionDisplay\":\"7.1\",\"releaseNotes\":\"1. Add Channel Medal\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-08-31\",\"releaseTimestamp\":\"2023-08-31T13:40:21Z\"},{\"versionDisplay\":\"7.0\",\"releaseNotes\":\"1. Added Live Channel\\r\\n2. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-08-25\",\"releaseTimestamp\":\"2023-08-25T23:00:58Z\"},{\"versionDisplay\":\"6.42\",\"releaseNotes\":\"1. Fix several bugs\\r\\n\",\"releaseDate\":\"2023-08-05\",\"releaseTimestamp\":\"2023-08-05T01:41:14Z\"},{\"versionDisplay\":\"6.41.1\",\"releaseNotes\":\"1. New Game page\\r\\n2. Fix several bugs\\r\",\"releaseDate\":\"2023-07-27\",\"releaseTimestamp\":\"2023-07-27T08:34:32Z\"},{\"versionDisplay\":\"6.41.0\",\"releaseNotes\":\"Bug fixed.\",\"releaseDate\":\"2023-07-23\",\"releaseTimestamp\":\"2023-07-23T10:11:31Z\"},{\"versionDisplay\":\"6.40\",\"releaseNotes\":\"1. CP function update: CP privilege \\n2. Fixed some bugs\",\"releaseDate\":\"2023-07-14\",\"releaseTimestamp\":\"2023-07-14T22:16:24Z\"},{\"versionDisplay\":\"6.38\",\"releaseNotes\":\"1. Upgrade sayhi function\\r\\n2. Optimize the chat channel\\r\\n\",\"releaseDate\":\"2023-07-02\",\"releaseTimestamp\":\"2023-07-02T07:46:28Z\"},{\"versionDisplay\":\"6.37\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2023-06-22\",\"releaseTimestamp\":\"2023-06-22T09:50:00Z\"},{\"versionDisplay\":\"6.36\",\"releaseNotes\":\"1. New Chatting Channel. Funny magic spells are waiting for you!\\r\\n2. Fix several bugs\\n\",\"releaseDate\":\"2023-06-19\",\"releaseTimestamp\":\"2023-06-19T10:15:01Z\"},{\"versionDisplay\":\"6.35\",\"releaseNotes\":\"1. Upgrade CP Zone system\\n2. Added New Aristocracy level, the Emperor！\\n3. Fix several bugs\",\"releaseDate\":\"2023-05-24\",\"releaseTimestamp\":\"2023-05-24T09:15:18Z\"},{\"versionDisplay\":\"6.34.1\",\"releaseNotes\":\"Several bug fixed.\",\"releaseDate\":\"2023-05-04\",\"releaseTimestamp\":\"2023-05-04T23:06:10Z\"},{\"versionDisplay\":\"6.34\",\"releaseNotes\":\"1. Add proposal page\\r\\n2. Fixed several bugs.\\n\",\"releaseDate\":\"2023-04-26\",\"releaseTimestamp\":\"2023-04-26T11:33:26Z\"},{\"versionDisplay\":\"6.33.1\",\"releaseNotes\":\"bug fixed.\",\"releaseDate\":\"2023-04-07\",\"releaseTimestamp\":\"2023-04-07T11:38:03Z\"},{\"versionDisplay\":\"6.33\",\"releaseNotes\":\"Fix several bugs\\r\",\"releaseDate\":\"2023-04-04\",\"releaseTimestamp\":\"2023-04-04T18:13:14Z\"},{\"versionDisplay\":\"6.32.1\",\"releaseNotes\":\"Several Bugs fixed.\",\"releaseDate\":\"2023-03-25\",\"releaseTimestamp\":\"2023-03-25T00:59:24Z\"},{\"versionDisplay\":\"6.32\",\"releaseNotes\":\"1. Added CP Zone\\n2. Optimize special relationship function\",\"releaseDate\":\"2023-03-23\",\"releaseTimestamp\":\"2023-03-23T14:38:06Z\"},{\"versionDisplay\":\"6.31\",\"releaseNotes\":\"1. Added Province System\\r\\n2. Party moment is recorded now\\r\\n3. Optimize special relationship function\\n\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T01:24:48Z\"},{\"versionDisplay\":\"6.30.1\",\"releaseNotes\":\"Fix several bugs\\r\\n\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T17:22:17Z\"},{\"versionDisplay\":\"6.30\",\"releaseNotes\":\"bug fixed.\",\"releaseDate\":\"2023-02-14\",\"releaseTimestamp\":\"2023-02-14T23:07:09Z\"},{\"versionDisplay\":\"6.29\",\"releaseNotes\":\"1. Optimize group feature\\r\\n2. Fix several bugs\\n\",\"releaseDate\":\"2023-02-10\",\"releaseTimestamp\":\"2023-02-10T12:37:16Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1