e10,5\":167380992,\"iPhone10,4\":167290880,\"iPhone7,1\":167380992,\"iPad13,19\":157855744,\"iPad14,5-A\":157855744,\"iPhone14,7\":157847552,\"iPhone14,6\":157757440,\"iPad14,5-B\":157855744,\"iPad13,11\":157855744,\"iPhone14,5\":157847552,\"iPhone14,4\":157847552,\"iPad13,17\":157855744,\"iPad13,18\":157855744,\"universal\":169469952,\"iPod9,1\":158973952,\"iPad13,16\":157855744,\"iPhone14,8\":157847552,\"iPad6,7\":167389184,\"iPad6,4\":167389184,\"iPad6,3\":167389184,\"iPad6,8\":167389184,\"iPad13,8\":157855744,\"iPad13,9\":157855744,\"iPad13,4\":157855744,\"iPad13,5\":157855744,\"iPad13,6\":157855744,\"iPad13,7\":157855744,\"iPad13,1\":157855744,\"iPad13,2\":157855744}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/us/apps/1527518551/genres?l=en-US\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6014?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"url\":\"https://itunes.apple.com/us/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"7009\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7009?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Family\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/us/genre/id7009\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7004?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"url\":\"https://itunes.apple.com/us/genre/id7004\",\"parentId\":\"6014\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1527518551/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":0,\"MZ_INDEXER\":1698821965687}}},{\"id\":\"1539388601\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1539388601?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Contacts\",\"identifier\":\"CONTACTS\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Frequent/Intense Contests\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Profanity or Crude Humor\",\"Infrequent/Mild Medical/Treatment Information\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/yallachat/id1539388601\",\"userRating\":{\"value\":4.4,\"ratingCount\":218,\"ratingCountList\":[21,3,13,16,165],\"ariaLabelForRatings\":\"4.4 stars\"},\"name\":\"YallaChat\",\"genreDisplayName\":\"Social Networking\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"YallaChat is an instant messaging app. Simple and fast, it can be downloaded and used for free. YallaChat allows you to safely communicate with your friends or family by sharing important moments, sending and receiving messages, photos, and superior voice \u0026 video messages and calls.\\n\\n【Secure Messaging】\\nCommunicate with your friends and family at any time by sending various types of messages such as stickers, photos, text, and voice and video messages. All messages are well-protected with end-to-end encryption on YallaChat.\\n\\n【Voice \u0026 Video Calls】\\nHigh-quality audio and instant video calls with friends and family, no matter where you are; 1v1 or group calls are all available.\\n\\n【Interactive Games】\\nPlay Ludo or plant your date-palm tree to get mobile credits, you can also make new friends and interact with old friends easily.\\n\\n【Athan Reminders】\\nThe Athan times are generated according to arithmetic methods adopted in most of the Islamic world. By automatically determining your location, this application can remind you of accurate prayer times as well as determine the direction of the Qibla.\\n\\n【Share Moments】\\nInteract with your friends by sharing your important moments. Post photos, videos, and more to your Moments.\\n\\n\\n*Data charges may apply. Contact your provider for details.\\n\\n---------------------------------------------------------\\n\\nIf you have any feedback, questions, or concerns, please email us at:\\nyallachatsupport@yalla.com\\n\\nLearn more about YallaChat at:\\nhttps://www.yallachat.com\\n---------------------------------------------------------\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.yallachat.com\",\"versionHistory\":[{\"versionDisplay\":\"1.8.0\",\"releaseNotes\":\"Spot Feature: launch of a vast public community centered around shared interests:\\n1. Personalized tags: Attract like-minded friends with visible tags on the platform.\\n2. Maximum 30,000 users allowed per Spot.\\n3. Roaming enabled for messages in Spot.\\n4. Exclusive voice chat group: Enjoy free chat with Spot members and visitors.\",\"releaseDate\":\"2023-08-29\",\"releaseTimestamp\":\"2023-08-29T08:21:00Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"1. Sticker Shop: You can download more fascinating stickers.\\n2. Broadcast: sending messages to multiple friends at once with a single action. \\n3. Bug fixes and improvements.\",\"releaseDate\":\"2023-05-22\",\"releaseTimestamp\":\"2023-05-22T01:46:22Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"1.Nearby Feature – Enjoy this new feature that allows you to easily find people in your vicinity to chat with.\\n2.News Feature – Stay up to date with this new feature which enables you to browse popular news from various countries.\\n3.Discover – You can now access the Moments, Games \u0026 Minis, Athan, News, and Nearby features from the ‘Discover’ page.\",\"releaseDate\":\"2023-04-17\",\"releaseTimestamp\":\"2023-04-17T01:46:45Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"Bug fixes and improvements.\",\"releaseDate\":\"2023-02-15\",\"releaseTimestamp\":\"2023-02-15T09:01:27Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1-Send documents: Now you can send documents in chats.\\n2-Group Call: Enhancements to the Group call page.\\n3-Screen lock feature: To protect account privacy, you can now use Face ID or Touch ID to unlock YallaChat.\",\"releaseDate\":\"2023-02-06\",\"releaseTimestamp\":\"2023-02-06T10:04:12Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\" Bug fixes and improvements.\",\"releaseDate\":\"2022-11-30\",\"releaseTimestamp\":\"2022-11-30T01:56:02Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"1. New Athan page design: Dhikr and Tasbih features have been added.\\n2. Live location: Users can now share their real-time location with their friends.\\n3. Message reactions: users can react to messages in chats using emojis.\",\"releaseDate\":\"2022-11-24\",\"releaseTimestamp\":\"2022-11-24T08:47:56Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Bug fixes and improvements.\",\"releaseDate\":\"2022-10-12\",\"releaseTimestamp\":\"2022-10-12T10:15:07Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"1. Added dark mode: Users can now switch between dark and light modes at any time.\\n2. Added wallpaper feature: Users can now customize their favorite chat background.\\n3. Bug fixes and improvements.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T09:34:36Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"1. Optimized user experience: Users can view unread messages and mentions \\\"@\\\" more easily.\\n2. Video customization: Videos can now be customized by users through cropping, texting, and applying stickers.\\n3. Added \\\"Location\\\" feature: Users can now share current or nearby locations with friends.\",\"releaseDate\":\"2022-08-26\",\"releaseTimestamp\":\"2022-08-26T02:08:27Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"1. Bug fixes and improvements.\",\"releaseDate\":\"2022-06-29\",\"releaseTimestamp\":\"2022-06-29T02:46:04Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1. Added  Athan function that provides accurate prayer times and Qibla directions.\\n2. Added GIF library.\\n3. New design adjusts for the Me page.\\n4. Bug fixes and improvements.\",\"releaseDate\":\"2022-06-23\",\"releaseTimestamp\":\"2022-06-23T02:04:44Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2022-05-20\",\"releaseTimestamp\":\"2022-05-20T03:49:24Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":\"1. Added moments feature, you can share moments with your friends.\\n2. Added a new \\\"Hop up\\\" mini game. \\n3. Added new Arabian stickers and emojis.\\n4. Enhanced design for single emojis.\",\"releaseDate\":\"2022-04-28\",\"releaseTimestamp\":\"2022-04-28T12:23:17Z\"},{\"versionDisplay\":\"0.3.0\",\"releaseNotes\":\"1. Added temporary conversation feature to quickly get in touch with your contacts.\\n2. Added new Arabian animated stickers.\\n3. Added group calling feature, you can call groups’ participants anytime.\\n4. If you turn on Auto-add contacts, your contacts will be automatically added as friends.\\n5. Added the group cover. You can upload any wallpaper as a group+ cover.\\n6. Bug fixes and improvements.\",\"releaseDate\":\"2022-01-20\",\"releaseTimestamp\":\"2022-01-20T03:05:05Z\"},{\"versionDisplay\":\"0.2.1\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2021-12-01\",\"releaseTimestamp\":\"2021-12-01T01:50:22Z\"},{\"versionDisplay\":\"0.2.0\",\"releaseNotes\":\"1. Now we have the group chat feature. You can contact your family or friends at any time by creating a group, search for interested groups to join, and make more friends;\\n2. Add personal and group QR codes. Now you can quickly add friends or enter groups, and create new chats;\\n3. Long press to reply, copy, forward and delete messages;\\n4. Repair and improve user experience;\",\"releaseDate\":\"2021-10-29\",\"releaseTimestamp\":\"2021-10-29T03:26:46Z\"},{\"versionDisplay\":\"0.1.1\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\\r\",\"releaseDate\":\"2021-04-08\",\"releaseTimestamp\":\"2021-04-08T02:26:27Z\"},{\"versionDisplay\":\"0.1.0\",\"releaseNotes\":null,\"releaseDate\":\"2021-03-25\",\"releaseTimestamp\":\"2021-03-25T02:41:12Z\"}],\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Chat with friends and family\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"bu