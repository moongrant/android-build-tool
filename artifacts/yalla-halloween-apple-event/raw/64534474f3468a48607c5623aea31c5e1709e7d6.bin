url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/0a/e5/95/0ae595ab-9f63-7651-0ddc-fc5007e66c1c/566f095f-6d97-402a-92f4-a0b570b26dc9_3_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"aff7e0\",\"textColor1\":\"0b0d08\",\"textColor2\":\"2f1f66\",\"textColor3\":\"2c3b33\",\"textColor4\":\"484a7e\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/3e/76/b0/3e76b0ac-83cf-5cee-be84-c4c64d479adf/8284cf98-643d-47af-8792-6af0d0201367_4_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fde1ca\",\"textColor1\":\"000000\",\"textColor2\":\"400101\",\"textColor3\":\"322d28\",\"textColor4\":\"662e29\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/b6/c7/4d/b6c74d08-deaa-b158-d834-0bbf763755b5/0b4ebb57-2600-41b6-8869-db361936831d_5_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fdf3a9\",\"textColor1\":\"040115\",\"textColor2\":\"3d1f14\",\"textColor3\":\"363233\",\"textColor4\":\"634932\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/b9/6c/13/b96c1333-e4cc-9ddb-9dd4-86dace3fa10d/0f27b7e3-e061-49c9-90e6-eeb0af8668e9_6_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fbeca7\",\"textColor1\":\"0a021f\",\"textColor2\":\"3d1f14\",\"textColor3\":\"3a313a\",\"textColor4\":\"634831\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/97/05/86/97058606-5683-0328-f6e2-b91ac8d6b5e4/c3b33b36-9e8f-46cf-bd81-2de4c5d4e8be_7_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fdecbb\",\"textColor1\":\"0e0608\",\"textColor2\":\"3c2805\",\"textColor3\":\"3e342c\",\"textColor4\":\"634f2a\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/a6/c2/7c/a6c27c48-9ef0-5603-286e-0ad958c35578/119c30d8-8622-4d09-986b-1cbbaca05b22_8_en.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f5f5f6\",\"textColor1\":\"2e1a0e\",\"textColor2\":\"052d3c\",\"textColor3\":\"56453d\",\"textColor4\":\"355561\"}]