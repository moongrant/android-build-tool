,\"iPod9,1\":280421376,\"iPad13,16\":278055936,\"iPhone14,8\":278109184,\"iPad6,7\":288738304,\"iPad6,4\":288738304,\"iPad6,3\":288738304,\"iPad6,8\":288738304,\"iPad13,8\":278055936,\"iPad13,9\":278055936,\"iPad13,4\":278055936,\"iPad13,5\":278055936,\"iPad13,6\":278055936,\"iPad13,7\":278055936,\"iPad13,1\":278055936,\"iPad13,2\":278055936}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/us/apps/1544887147/genres?l=en-US\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6014?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"url\":\"https://itunes.apple.com/us/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7004?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"url\":\"https://itunes.apple.com/us/genre/id7004\",\"parentId\":\"6014\"}},{\"id\":\"7003\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7003?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Casual\",\"url\":\"https://itunes.apple.com/us/genre/id7003\",\"parentId\":\"6014\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1544887147/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1698988607276,\"MZ_INDEXER\":1698812906176}}}]},\"related-editorial-items\":{\"href\":\"/v1/catalog/us/apps/1091902866/related-editorial-items?l=en-US\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/us/apps/1091902866/customers-also-bought-apps?l=en-US\",\"next\":\"/v1/catalog/us/apps/1091902866/customers-also-bought-apps?l=en-US\u0026offset=11\",\"data\":[{\"id\":\"1514418573\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1514418573?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Collected\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"The developer does not collect any data from this app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/whisper-group-voice-chat-room/id1514418573\",\"userRating\":{\"value\":4.4,\"ratingCount\":664,\"ratingCountList\":[55,22,31,53,503],\"ariaLabelForRatings\":\"4.4 stars\"},\"genreDisplayName\":\"Entertainment\",\"name\":\"Whisper-Group Voice Chat Room\",\"isPreorder\":false,\"artistName\":\"BLAGOL TECHNOLOGY CO., LIMITED\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Connection with friends without barriers\\nWhisper is the most popular voice chat community, here you can chat safely with friends from all over the world, USA, UK, Saudi Arabia, UAE, Qatar, China, Germany... Language speaking, distance is never a barrier for your connection with them, totally free!\\n\\nMake friends safely\\nIn Whisper, you can chat with family, friends, and strangers, and have live party with them. Whenever you feel the need for peace, spiritual comfort, self-control, confidence, contentment or anything else, you can talk to your friends here secretly and safely, and you will get comforted.\\n\\nDistinctive features:\\nFree voice chat room – Whisper is an absolutely free voice chat app! you can connect with friends in Whisper using 3G, 4G, LTE or Wi-Fi internet, you can enjoy a super-fast, high-quality voice chat in the chat room.\\nFree online party – You can hold free party for birthday, wedding, Eid, or just real-time comments on football games or any other topic, enjoy your time here!\\nFast entry – registration will be done in 5 seconds, you can enter into Whisper to have fun with friends fastly.\\nWonderful moments – You can view moments posted by Whisper friends, and you can post your own to show your cool life moments.\\nCool effect gifts – In live chat room or direct chatting you can exchange cool effect gifts with your friends.\\nText message communication – you can communicate with people by adding friends and sending text messages to each other.\\nExciting games – There are many wonderful entertainment games in Whisper for free, you can play games with friends in voice chat room. \\nSpecific leaderboards – you can find the most popular Whisper users/rooms in leaderboards easily, and you can make yourself on the leaderboards also.\\n\\nGroup chat \u0026 direct connection\\nIf you prefer group chatting, join Whisper and you can connect with many friends at the same time and in one chat room. You can hold live parties, play awesome games with them, exchange gifts and happiness. If you prefer direct chat, join Whisper and you can make friends and talk with him by voice or text safely, let your heart to be comforted here.\\n\\nBest online social connection community\\nStill feeling shy to talk with strangers? Still worrying about long distance communication with friends? Still annoyed by language speaking difficulties during online chat with new friends from other countries? Whisper has solved these inconvenient connections for you, join Whisper to have the best online social connection, and have voice chat with new friends freely.\\n\\nDear friends, you can follow us by following official pages: \\nFacebook: https://www.facebook.com/Whisper-03177-108024924700488\\n\\nIf you have any suggestions or feedback, please feel free to contact us at: whisperfeedback@gmail.com\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.6.701\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-10-26\",\"releaseTimestamp\":\"2023-10-26T12:43:28Z\"},{\"versionDisplay\":\"1.6.700\",\"releaseNotes\":\"1. Added \\\"Apply for mic\\\" feature in room.\\n2. Optimized user experience.\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T10:28:10Z\"},{\"versionDisplay\":\"1.6.601\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-09-30\",\"releaseTimestamp\":\"2023-09-30T13:03:06Z\"},{\"versionDisplay\":\"1.6.600\",\"releaseNotes\":\"1. Added Wuno skins in store.\\n2. Optimized user experience.\",\"releaseDate\":\"2023-09-27\",\"releaseTimestamp\":\"2023-09-27T05:56:42Z\"},{\"versionDisplay\":\"1.6.505\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-09-19\",\"releaseTimestamp\":\"2023-09-19T14:37:38Z\"},{\"versionDisplay\":\"1.6.504\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-09-12\",\"releaseTimestamp\":\"2023-09-12T01:39:11Z\"},{\"versionDisplay\":\"1.6.503\",\"releaseNotes\":\"Fix some bugs\",\"releaseDate\":\"2023-09-08\",\"releaseTimestamp\":\"2023-09-08T14:02:50Z\"},{\"versionDisplay\":\"1.6.502\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-09-01\",\"releaseTimestamp\":\"2023-09-01T02:02:03Z\"},{\"versionDisplay\":\"1.6.501\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-08-31\",\"releaseTimestamp\":\"2023-08-31T01:56:42Z\"},{\"versionDisplay\":\"1.6.500\",\"releaseNotes\":\"1. Baloot game in room.\\n2. Improved user experience.\",\"releaseDate\":\"2023-08-30\",\"releaseTimestamp\":\"2023-08-30T09:11:41Z\"},{\"versionDisplay\":\"1.6.401\",\"releaseNotes\":\"Bugs fixed to improve user experience\\n\",\"releaseDate\":\"2023-08-14\",\"releaseTimestamp\":\"2023-08-14T08:26:08Z\"},{\"versionDisplay\":\"1.6.400\",\"releaseNotes\":\"1. Added exclusive gifts for the pass.\\n2. Added new function: You can edit the moments that have been published.\\n3. Optimized user experience.\",\"releaseDate\":\"2023-08-11\",\"releaseTimestamp\":\"2023-08-11T09:16:21Z\"},{\"versionDisplay\":\"1.6.311\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-08-07\",\"releaseTimestamp\":\"2023-08-07T12:48:49Z\"},{\"versionDisplay\":\"1.6.310\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-08-03\",\"releaseTimestamp\":\"2023-08-03T11:05:22Z\"},{\"versionDisplay\":\"1.6.309\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-08-02\",\"releaseTimestamp\":\"2023-08-02T06:19:38Z\"},{\"versionDisplay\":\"1.6.308\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-07-31\",\"releaseTimestamp\":\"2023-07-31T09:47:38Z\"},{\"versionDisplay\":\"1.6.307\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-07-28\",\"releaseTimestamp\":\"2023-07-28T06:24:13Z\"},{\"versionDisplay\":\"1.6.306\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-07-27\",\"releaseTimestamp\":\"2023-07-27T06:29:12Z\"},{\"versionDisplay\":\"1.6.305\",\"releaseNotes\":\"Bugs fixed to improve user experience\"