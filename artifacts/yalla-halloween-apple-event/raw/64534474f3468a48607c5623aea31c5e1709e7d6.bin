res\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/us/genre/id6005\",\"parentId\":\"36\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6012?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6012\"}}]},\"developer\":{\"href\":\"/v1/catalog/us/apps/1539388601/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":0,\"MZ_INDEXER\":1698914630122},\"experimentData\":{\"default\":{\"experimentId\":\"4731f3da-dbd2-40a2-b112-acc634530fc4\",\"experimentLocale\":\"en-US\",\"trafficAllocation\":{\"e6c957fa-4a97-4201-a04e-ac1c1b3a4425\":[\"xSb5Dsb00\",\"xSb5Dsb01\",\"xSb5Dsb02\",\"xSb5Dsb07\",\"xSb5Dsb08\",\"xSb5Dsb12\",\"xSb5Dsb14\",\"xSb5Dsb15\",\"xSb5Dsb17\",\"xSb5Dsb18\",\"xSb5Dsb21\",\"xSb5Dsb22\",\"xSb5Dsb23\",\"xSb5Dsb24\",\"xSb5Dsb27\",\"xSb5Dsb28\",\"xSb5Dsb30\",\"xSb5Dsb31\",\"xSb5Dsb32\",\"xSb5Dsb34\",\"xSb5Dsb36\",\"xSb5Dsb40\",\"xSb5Dsb45\",\"xSb5Dsb48\",\"xSb5Dsb49\",\"xSb5Dsb53\",\"xSb5Dsb55\",\"xSb5Dsb57\",\"xSb5Dsb58\",\"xSb5Dsb61\",\"xSb5Dsb63\",\"xSb5Dsb64\",\"xSb5Dsb65\",\"xSb5Dsb67\",\"xSb5Dsb68\",\"xSb5Dsb70\",\"xSb5Dsb71\",\"xSb5Dsb73\",\"xSb5Dsb75\",\"xSb5Dsb76\",\"xSb5Dsb77\",\"xSb5Dsb79\",\"xSb5Dsb81\",\"xSb5Dsb82\",\"xSb5Dsb83\",\"xSb5Dsb85\",\"xSb5Dsb91\",\"xSb5Dsb93\",\"xSb5Dsb95\",\"xSb5Dsb96\"]}}}}},{\"id\":\"1513504421\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1513504421?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Cartoon or Fantasy Violence\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/yalla-baloot-hand/id1513504421\",\"userRating\":{\"value\":4.4,\"ratingCount\":575,\"ratingCountList\":[45,20,31,59,420],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.0\",\"name\":\"Yalla Baloot \u0026 Hand\",\"genreDisplayName\":\"Card\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Welcome to Yalla Baloot\u0026Hand, the ultimate mobile board game app that brings you the best of Baloot and Hand, two popular card games from the Arab region. Immerse yourself in the authentic gameplay, compete in thrilling tournaments, and connect with friends and family in real-time.\\n\\nKey Features:\\n\\nAuthentic Baloot Experience:\\nExperience the timeless charm of Baloot, a beloved card game from the Middle East. Play with traditional rules and immerse yourself in the rich cultural heritage of this classic game.\\n\\nMultiple Modes of Hand:\\nExplore a variety of Hand game modes, including Hand and Hand Saudi. Each mode offers its own unique challenges and excitement, providing endless entertainment for both casual and competitive players.\\n\\nCompetitive Tournaments and Rankings:\\nTest your skills and compete against players from around the world in intense tournaments and leagues. Climb the ranks, earn prestigious titles, and showcase your card-playing prowess.\\n\\nSocial Rooms for Multiplayer Fun:\\nJoin public rooms and play Baloot and Hand with friends and other players. Create private rooms to invite your friends and enjoy hours of fun-filled gaming sessions together.\\n\\nVoice Chat Rooms for Real-Time Communication:\\nConnect with family and friends through real-time voice chat rooms. Enjoy seamless communication, host online parties, and share memorable moments as you engage in lively conversations.\\n\\nExquisite Personalization Options:\\nCustomize your gaming experience with a wide range of beautifully designed skins for cards, boards, and avatars. Stand out from the crowd and express your style with customizable elements that reflect your personality.\\n\\nWe will try our best to improve your game experience, provide you with fun and excitement, and make your life full of joy.\\n\\nAny suggestions or questions, please contact our feedback team: balootsupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"accelerometer arm64 opengles-1 \",\"versionHistory\":[{\"versionDisplay\":\"1.5.7\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\",\"releaseDate\":\"2023-11-07\",\"releaseTimestamp\":\"2023-11-07T08:08:58Z\"},{\"versionDisplay\":\"1.5.6.1\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T07:36:26Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"1. New Room Prop - Magic Card is coming! Send it to each other in chatroom and it will be displayed on mic after sending!\\r\\n2. Quick Reply - Quick Reply in chatroom is available now. Reply directly to keep the relationship closer! \\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-09-20\",\"releaseTimestamp\":\"2023-09-20T01:37:00Z\"},{\"versionDisplay\":\"1.5.5\",\"releaseNotes\":\"1. Master Match - Engage in a thrilling competition and showcase your skills alongside the world's best Baloot players!\\r\\n2. World Top List - Work your way up the World Top Ranking List by earning points through competitive play in game. Only the best will reach the top!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-08-23\",\"releaseTimestamp\":\"2023-08-23T01:33:22Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-06-13\",\"releaseTimestamp\":\"2023-06-13T12:07:16Z\"},{\"versionDisplay\":\"1.5.3\",\"releaseNotes\":\"1. Game Sharing - Improved the sharing feature to help you easily showcase accomplishments with friends!\\n2. Chatroom Upgrade - Enjoy the newly added personal gift lists, which showcase leaderboards for sent and received gifts!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T07:06:49Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"1. Achievement Badges - Earn achievements to unlock badges, and show off your collection by wearing them!\\r\\n2. Chatroom Update - Member club feature added. Join with friends and make your room the most popular!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\"},{\"versionDisplay\":\"1.5.1.1\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"1. Upgraded Challenge - Two challenge matches of different levels have been added, giving users more exciting games to enjoy! \\r\\n2. Interface Optimization - Buttons on the main interface have been optimized to improve the user experience!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1. Chatrooms – Experience the newly added chatrooms! Create your own room or join a public one and make new friends! \\r\\n2. Upgraded Global Chat - Experience a smoother global chat with newly added message notifications! \\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\"},{\"versionDisplay\":\"1.4.9.11\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T01:50:12Z\"},{\"versionDisplay\":\"1.4.9.10\",\"releaseNotes\":\"1. New Game Rule - Enjoy the most authentic Baloot experience with the newly added \\\"Gaid\\\" rules in the Public Room!\\r\\n2. Chat Bubbles – Show off your bubble collection by using personalized chat bubbles!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T09:05:56Z\"},{\"versionDisplay\":\"1.4.9.9\",\"releaseNotes\":\"1. New Game Rules - Enjoy the most authentic Baloot experience, with the newly added \\\"Kashu\\\" rules! \\r\\n2. Public Room - Create private or public \\\"Hand\\\" game rooms or join other user's rooms by accessing the game mode's \\\"Public Room\\\"!\\r\\n3. Challenge Notification Feature - With newly added notifications in global chat, you will never miss any challenge match!\",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T01:46:58Z\"},{\"versionDisplay\":\"1.4.9.8\",\"releaseNotes\":\"1. Interface Optimization - Enjoy the newly upgraded interface in \\\"Challenge mode\\\"!\\r\\n2. Challenge Registration Reminder - Never miss out on any of the daily rewards with the new Challenge registration reminder feature!\\r\\n3. Performance Optimization - Enjoy a much smoother gaming experience!\",\"releaseDate\":\"2022-09-01\",\"releaseTimestamp\":\"2022-09-01T01:05:52Z\"},{\"versionDisplay\":\"1.4.9.7\",\"releaseNotes\":\"1. New Challenge Match - Enjoy exciting competitions with plenty of rewards. Compete to become the champion!\\n2. Quick Play Upgrade - Experience faster Baloot games and choose different skill grades based on your own expertise!\\n3. New Rankings System - Play games to gain your spot on the ranking list and win exclusive profile frames!\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T10:55:25Z\"},{\"versionDisplay\":\"1.4.9.6\",\"releaseNotes\":\"1.Upgrade to Quick mode in championship tryouts, with more chances to hit the championship every day!\\r\\n2.Voice quality improvement and overall optimizations. Enter app in seconds and have a quick start!\",\"releaseDate\":\"2022-06-25\",\"releaseTimestamp\":\"2022-06-25T08:51:38Z\"},{\"versionDisplay\":\"1.4.9.5.1\",\"releaseNotes\":\"1. Team up with friends to join the new competitive championship.\\r\\n2. Public rooms have been enhanced to support multiple spectators.\\r\\n3.Voice quality improvement and overall optimization. \",\"releaseDate\":\"2022-06-06\",\"releaseTimestamp\":\"2022-06-06T12:34:09Z\"},{\"versionDisplay\":\"1.4.9.4\",\"releaseNotes\":\"1. Added New Star Rank. You can be the top even as a new player!\\n2. Get VIP when you bind your account!\\n3. New announcement after upgrading to Master and above. \\n4. Voice quality improvement and overall optimizations. \",\"releaseDate\":\"2022-04-20\",\"releaseTimestamp\":\"2022-04-20T02:05:26Z\"},{\"versionDisplay\":\"1.4.9.3\",\"releaseNotes\":\"1. Brand new Public Room. You can use golds now to play games.\\n2. App optimizations and voice quality improvement.\\n3. Enhanced user experience and added confirmation for golds exchange in Store.\",\"releaseDate\":\"2022-03-21\",\"releaseTimestamp\":\"2022-03-21T14:27:05Z\"},{\"versionDisplay\":\"1.4.9.2\",\"releaseNotes\":\"1. Added Global Chat. You can now chat with more friends;\\r\\n2. You can now get the chests immediately once you win a \\\"Quick Play\\\";\\r\\n3. Free Public Room for all players. Create or join any public room to play with friends;\\r\\n4. Overall optimization of the game;\\r\\n5. Bug fixed.\",\"releaseDate\":\"2022-03-08\",\"releaseTimestamp\":\"2022-03-08T01:46:12Z\"},{\"versionDisplay\":\"1.4.9.1\",\"releaseNotes\":\"Some bugs were fixed according to user feedback. The quality of Voice Chat is optimized.\",\"releaseDate\":\"2022-02-09\",\"releaseTimestamp\":\"2022-02-09T00:47:18Z\"},{\"versionDisplay\":\"1.4.9\",\"releaseNotes\":\"Yalla Baloot team sincerely invites you to experience the new version of Baloot in 2022.\\r\\n1.Add Hand game. Variety of Hand games for 2 \u0026 4 players;\\r\\n2.Users can send interactive props in the game;\\r\\n3.Add winning streak chests in CASUAL. The more you win, the better rewards you will get;\\r\\n4.Overall optimization of the game;\\r\\n5.Bug fixed\\r\\nThanks for your patience in reading this. See you in the next version.\",\"releaseDate\":\"2022-01-28\",\"releaseTimestamp\":\"2022-01-28T13:56:23Z\"},{\"versionDisplay\":\"1.4.8.1\",\"releaseNotes\":\"1.Brand new UI design, better game experience;\\r\\n2.Overall optimization of the game;\\r\\n3.Bug fixed\",\"releaseDate\":\"2021-12-11\",\"releaseTimestamp\":\"2021-12-11T10:25:37Z\"},{\"versionDisplay\":\"1.4.8\",\"releaseNotes\":\"1.Added Novice Pass. You can get plentiful rewards by playing games, including golds, diamonds, skins, and VIP;\\r\\n2.Added Level Reward with brand-new level badges. You can check it on Events page;\\r\\n3.Added friends Spectating;\\r\\n4.Added Bubble Skins;\\r\\n5.Overall optimization of the game;\\r\\n6.Bug fixed\",\"releaseDate\":\"2021-10-01\",\"releaseTimestamp\":\"2021-10-01T00:46:55Z\"},{\"versionDisplay\":\"1.4.7\",\"releaseNotes\":\"1.Brand-new League: change participation rules. More free challenge times and more plentiful rewards;\\r\\n2.Exquisite Skins: a variety of personalized skins. You can choose your favorite card and theme, and use them in the game;\\r\\n3.Rank upgrade: add Game Star rank and limited-time profile frame reward;\\r\\n4.Overall optimization of the game: smoother game experience;\\r\\n5.Bug fixed.\",\"releaseDate\":\"2021-08-09\",\"releaseTimestamp\":\"2021-08-09T14:25:07Z\"}],\"websiteUrl\":\"https://www.yallabaloot.com/\",\"isXROSCompatible\":false,\"hasSafariExtension\":false,\"editorialNotes\":{\"tagline\":\"Play your cards right\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=861019704\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":3355