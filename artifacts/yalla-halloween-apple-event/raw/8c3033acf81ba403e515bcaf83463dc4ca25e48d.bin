null,"backgroundColor":{"red":0.8117647058823529,"green":0.43137254901960786,"blue":0.12549019607843137,"type":"rgb"},"textColor":{"red":0.08235294117647059,"green":0.08235294117647059,"blue":0.07058823529411765,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/31/88/72/318872e5-7929-4a5d-b86b-a45f8ad022f1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla Jackaroo - Classic","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Jackaroo game with voice chat","tertiaryTitle":"Designed for iPad","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Jackaroo game with voice chat","editorialTagline":null,"editorialDescription":null,"shortEditorialDescription":null,"ageRating":"9+","productDescription":"Welcome to Yalla Jackaroo! - The ORIGINAL Jackaroo Game!\n\nJump into the ORIGINAL Jackaroo experience where tradition meets modern fun! Play like a KING, chat with friends, and dominate the Jackaroo world. Yalla - let's game!\n\nWhy pick Yalla Jackaroo?\nReal vibes: Feel the original feeling of offline games with real-time voice chat & interactive emojis!\nMultiple Game Modes: Quick, 1v1, Crazy, Complex or Basic - Rich and fun game modes! Let you experience a different Jackaroo game in Yalla Jackaroo!\nAmazing Rewards: Free coins, daily rewards, Pass rewards, and more—real gifts are waiting for you!\nGlory Rankings: Exclusive Jackaroo honors just for you! Climb the Wealth Rank, XP Rank, and more! Earn medals and honors that show the world your true king-level skills.\nExquisite Design: Every detail is carefully crafted to deliver a king-level visual experience.\n\nWhat Makes Us Special?\nBeginner-Friendly: New to Jackaroo? Our tutorials make you a top player fast! Master king-level skills in no time!\nLive Matching: Play Jackaroo with global players, chat while you play, double the fun in one game.\nSocial Play: Team up with friends, create private rooms, and enjoy voice chat – perfect for online hangouts!\nRoyal Privileges: Unlock exclusive status symbols and rare privileges. Showcase your nobility and enjoy a distinguished gaming experience.\n\nParty\nGrab your mic, join the conversation, and dive into lively chat! Show off your charm, meet new friends, and enjoy free real-time multiplayer voice chat! Ready to rule the chat? Be the King of Social!\n\n\nDownload Yalla Jackaroo NOW!\nYalla Jackaroo - The ORIGINAL game for KING-level fun! Begin your legendary journey! Play Like a King, we look forward to meeting you! \n\nContact Us:\nEmail: jackaroo.support@yalla.com\nFacebook & TikTok: Yalla Jackaroo - يلا جاكارو","rating":4.7,"ratingCount":"267","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6737796366&pricingParameters=STDQ&pg=default&appExtVrsId=878502611"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"6737796366"},{"locationPosition":5,"locationType":"lockup","name":"Yalla Jackaroo - Classic","idType":"its_id","id":"6737796366"},{"locationPosition":12,"locationType":"swoosh","name":"More by Yalla Technology FZ-LLC","idType":"sequential","id":"30"}],"jet_adamId":"6737796366","eventType":"click","targetType":"button","targetId":"6737796366","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"6737796366"}},"adamId":"6737796366","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=6737796366&pric