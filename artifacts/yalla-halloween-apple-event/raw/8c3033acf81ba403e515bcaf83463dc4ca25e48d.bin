pressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":7,"variantId":"default","experimentId":"81c7c1f2-5611-46b3-81f6-9c6d362b4ab8","experimentLocale":"en-US","contentRating":313,"bundleId":"com.yalla.okey101yalla"}},"productVariantID":null,"adamId":"1544887147","bundleId":"com.yalla.okey101yalla","decorations":[],"icon":{"checksum":null,"backgroundColor":{"red":0.9764705882352941,"green":0.9647058823529412,"blue":0.9254901960784314,"type":"rgb"},"textColor":{"red":0.08627450980392157,"green":0.03137254901960784,"blue":0.01568627450980392,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/18/ba/24/18ba240d-5a48-7633-5668-ed8ed575362b/AppIcon-1x_U007emarketing-0-6-0-85-220-0.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"101 Okey Yalla: Live & Chat","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Play Party Game with Friends!","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Play Party Game with Friends!","editorialTagline":"Challenge your friends!","editorialDescription":null,"shortEditorialDescription":null,"ageRating":"13+","productDescription":"Welcome to 101 Okey Yalla! You've stepped into Türkiye's most entertaining okey game platform! Here, gaming and voice chat are combined. Join now and join the fun!\n\nWhy 101 Okey Yalla?\nClassic yet always innovative!\nAll the okey modes you want are here. And with free in-game voice chat, play and talk—twice the fun!\n\nDon't want the chat to never end?\nNot enough chat in Okey? Unlimited chat awaits you in voice rooms! Make new friends, share the fun, and have fun chatting!\n\nThe best experience, the best you!\nRankings, league system, medals, and titles… All the details are here to showcase your mastery!\n\nA world full of surprises!\nFree gold, daily rewards, seasonal Battle Passes, and more! Have fun all day long and keep winning!\n\nAll in One App!\nMultiple Game Modes\n- Real-time matchmaking, instant competition! Team modes, high-stakes games, and plenty of winnings await!\n- Special co-op mode: Team up with a friend, swap tiles, strategize, and achieve victory together!\n- Turbo mode: Increase your bets with a fast pace and multiply your winnings!\n- Table mode: Open your own private table, play with your friends, and share the joy of victory!\n- Competition system: Grand tournaments with all players, arenas where power and luck collide!\n\nReal-Time Voice Chat\nChat in a real table atmosphere, as if you were in the same place!\nJoin any room, step up to the microphone, socialize naturally, and make new friends now!\n\n101 Okey Yalla offers you a pure, free okey experience filled with real players. Enjoy the world of voice chat!\nWe solemnly declare that: 101 Okey Yalla does not involve gambling with real money, in-game prizes are completely virtual.\n\nIf you choose to subscribe to 101 Okey Yalla VIP, the purchase will be billed to your iTunes account. \nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\nCurrent 101 Okey Yalla VIP subscription price starts at 7.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice. \nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in 101 Okey Yalla without becoming a 101 Okey Yalla VIP.\n\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\n\n\nPrivacy Policy：https://www.yallaokey101.com/term/EN/TermOfService.html#PrivacyPolicy\n\nTerms of Service：https://www.yallaokey101.com/term/EN/TermOfService.html#TermsOfService\n\nFollow us on Instagram: @yallaokey101. Don't miss the latest events and opportunities!\nFor any questions or suggestions: yallaokey101@yalla.com","rating":4.5,"ratingCount":"26","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1544887147&pricingParameters=STDQ&pg=default&appExtVrsId=878380756"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1544887147","variantId":"default","experimentId":"81c7c1f2-5611-46b3-81f6-9c6d362b4ab8","experimentLocale":"en-US"},{"locationPosition":7,"locationType":"lockup","name":"101 Okey Yalla: Live & Chat","idType":"its_id","id":"1544887147","variantId":"default","experimentId":"81c7c1f2-5611-46b3-81f6-9c6d362b4ab8","experimentLocale":"en-US"},{"locationPosition":12,"locationType":"swoosh","name":"More by Yalla Technology FZ-LLC","idType":"sequential","id":"30"}],"jet_adamId":"1544887147","eventType":"click","targetType":"button","targetId":"1544887147","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1544887147"}},"adamId":"1544887147","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1544887147&pricingParameters=STDQ&pg=default&appExtVrsId=878380756","vendor":"Yalla Technology FZ-LLC","appName":"101 Okey Yalla: Live & Chat","bundleId":"com.yalla.okey101yalla","appPlatforms":["phone"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"lineItem":null,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":false,"supportsVisionOSCompatibleIOSBinar