}},"productVariantID":null,"adamId":"1419536376","bundleId":"com.yalla.yallagame","decorations":[],"icon":{"checksum":null,"backgroundColor":{"red":0.29411764705882354,"green":0.19215686274509805,"blue":0.4588235294117647,"type":"rgb"},"textColor":{"red":0.9215686274509803,"green":0.9254901960784314,"blue":0.9568627450980393,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/28/1c/73/281c7335-5d95-d9b7-82c4-d438ea26f74c/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla Ludo - Ludo&Jackaroo","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Game On, Chat On!","tertiaryTitle":"Designed for iPad","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Game On, Chat On!","editorialTagline":"It's in the Cards","editorialDescription":null,"shortEditorialDescription":"Every day brings new rewards, just complete your tasks.","ageRating":"13+","productDescription":"Yalla Ludo is a vibrant app that fuses classic board games—Ludo, Jackaroo, and Domino—with real-time voice chat! Whether you're in the mood for gameplay or hoping to connect with new friends in a lively voice chat room, Yalla Ludo delivers a truly immersive experience.\n\n[Voice Chat with Friends]\nEnjoy real-time voice chat that lets you share tips and tricks with fellow gamers anytime, anywhere. Make new friends while having fun! Add personality to your gameplay with expressive voice chat.\n\n[Various Game Modes]\nLudo: Choose between 2&4 Players mode and Team mode. Each mode has 4 gameplays: Classic, Master, Quick, and Arrow. You can also use Magic tools to make the game more fun! \nDomino: Play in 2&4 Players mode, each featuring two gameplays: Draw Game and All Five.\nOthers: More new games are waiting for you.\n\n[Brand New Jackaroo]\nGet ready for fast-paced Jackaroo gameplay! Pick from a variety of game modes (Basic, Complex, and Quick), and team up with friends to claim victory. Make your moves even more fun by expressing yourself with lively game stickers!\n\n[Voice Chat Room]\nJoin the global public chat room, where you can connect with people from all over the world. Chat freely, share ideas, and send cute gifts! Broaden your network of friends and enjoy a relaxing time.\n\n[Generous Rewards Await You]\nYalla Ludo offers multiple daily activities. Complete game or chat room tasks to earn various rewards (such as golds, diamonds, skin fragments, and gifts, etc). With daily tasks and arrival chests, you'll always find something exciting!\n\nYalla Ludo connects you with others, so let's enjoy the joyful moments in Yalla Ludo!\n\nSubscribe to Yalla Ludo VIP to enjoy the extra advanced features:\nCollect free daily golds, diamonds, and VIP daily benefits.\nPrivileged game room: create your room in the VIP room, invite others to play together, and have more options for bets.\n-----------------------------------\nIf you choose to subscribe to Yalla Ludo VIP, the purchase will be billed to your iTunes account.\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\nLudo VIP includes two types: Knight and Baron. The price for Knight is USD 11.99/month and the price for Baron is USD 39.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice.\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo without becoming a Yalla Ludo VIP.\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\n\nPrivacy Policy: https://www.yallaludo.com/term/EN/TermOfService.html\nTerms of Service: https://www.yallaludo.com/term/EN/TermOfService.html#TermsOfService","rating":4.1,"ratingCount":"47K","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1419536376&pricingParameters=STDQ&pg=default&appExtVrsId=880600488"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1419536376"},{"locationPosition":0,"locationType":"lockup","name":"Yalla Ludo - Ludo&Jackaroo","idType":"its_id","id":"1419536376"},{"locationPosition":12,"locationType":"swoosh","name":"More by Yalla Technology FZ-LLC","idType":"sequential","id":"30"}],"jet_adamId":"1419536376","eventType":"click","targetType":"button","targetId":"1419536376","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1419536376"}},"adamId":"1419536376","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1419536376&pricingParameters=STDQ&pg=default&appExtVrsId=880600488","vendor":"Yalla Technology FZ-LLC","appName":"Yalla Ludo - Ludo&Jackaroo","bundleId":"com.yalla.yallagame","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"lineItem":null,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":false,"supportsVisionOSCompatibleIOSBinary":false,"extRefApp2":null,"extRefUrl2":null,"remoteDownloadIdentifiers":[],"hasMacIPAPackage":false,"contentRating":313,"pageInformation":{"baseFields":{"serverInstance":"10001","storeFrontHeader":"sa","language":"en","storeFront":"sa","environmentDataCenter":"PV00-RDC","pageType":"Software",