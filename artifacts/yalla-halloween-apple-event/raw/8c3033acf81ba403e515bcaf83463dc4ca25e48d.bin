,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f4/fd/ed/f4fded05-064e-f1cc-b35a-d8b93147210d/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla Ludo HD — For iPad","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Ultimate Ludo & Domino","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Ultimate Ludo & Domino","editorialTagline":null,"editorialDescription":null,"shortEditorialDescription":null,"ageRating":"9+","productDescription":"Yalla Ludo HD, an app with voice chat, is specially designed for iPad. It enables players to enjoy smooth game experience and fancy game graphics.\n\nReal-time voice chat\nTalk with players via voice chat at any time, meet new friends and enjoy the game!\n\nGreat game experience\nHigh-quality visuals and delicate UI design. Besides, you may have a better experience on the Pad.\n\nPlay with friends easily\nLocal rooms enable you to play with buddies offline. Come and have fun in games together！\n\nMore game bonus? Find them in Yalla Ludo VIP\nSubscribe to Yalla Ludo HD VIP to enjoy the extra advanced features:\nCollect free daily coins, diamonds and VIP chests.\nPrivileged game room: create your  room in the VIP room, invite others to play together and more options for bets.\n\n-----------------------------------\n\nIf you choose to subscribe to Yalla Ludo HD VIP, the purchase will be billed to your iTunes account. \nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\nCurrent Yalla Ludo HD VIP subscription price starts at 11.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice. \nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo HD without becoming a Yalla Ludo HD VIP.\n\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\n\n\nPrivacy Policy：https://www.fyxtechhk.com/term/EN/TermOfService.html\n\nTerms of Service：https://www.fyxtechhk.com/term/EN/TermOfService.html#TermsOfService","rating":3.8,"ratingCount":"366","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1527518551&pricingParameters=STDQ&pg=default&appExtVrsId=874354980"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1527518551"},{"locationPosition":2,"locationType":"lockup","name":"Yalla Ludo HD — For iPad","idType":"its_id","id":"1527518551"},{"locationPosition":12,"locationType":"swoosh","name":"More by Yalla Technology FZ-LLC","idType":"sequential","id":"30"}],"jet_adamId":"1527518551","eventType":"click","targetType":"button","targetId":"1527518551","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1527518551"}},"adamId":"1527518551","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1527518551&pricingParameters=STDQ&pg=default&appExtVrsId=874354980","vendor":"Yalla Technology FZ-LLC","appName":"Yalla Ludo HD — For iPad","bundleId":"com.yallagames.hd","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload