4705882353,"blue":0.9725490196078431,"type":"rgb"},"darkColor":{"red":0.18823529411764706,"green":0.18823529411764706,"blue":0.19215686274509805,"type":"rgb"},"type":"dynamic"}},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"moreByDeveloper"},"similarItems":{"impressionMetrics":{"fields":{"id":"customers-also-bought-apps","name":"You Might Also Like","impressionType":"similarItems","idType":"relationship","impressionIndex":13}},"contentType":"smallLockup","marker":null,"items":[{"impressionMetrics":{"fields":{"id":"1514418573","name":"ويسبر - دردشة و ألعاب","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":0,"contentRating":416,"bundleId":"com.chatvoice.whisper"}},"productVariantID":null,"adamId":"1514418573","bundleId":"com.chatvoice.whisper","decorations":[],"icon":{"checksum":null,"backgroundColor":{"red":0.29411764705882354,"green":0.23921568627450981,"blue":0.10980392156862745,"type":"rgb"},"textColor":{"red":0.9764705882352941,"green":0.9686274509803922,"blue":0.792156862745098,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/6a/a1/9d/6aa19d2a-2f3c-b701-82b8-79fbdb87dbe2/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"ويسبر - دردشة و ألعاب","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Entertainment","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":null,"editorialTagline":null,"editorialDescription":null,"shortEditorialDescription":null,"ageRating":"16+","productDescription":"التواصل مع الأصدقاء بدون حواجز\nويسبر هو مجتمع دردشة صوتية الأكثر شعبية، يمكنك هنا الدردشة بشكل آمن مع أصدقاء من جميع انحاء العالم، أمريكا، بريطانيا، السعودية، الإمارات، قطر، ألمانيا... لغة الدولة، او المسافات لا تعتبر أبداً حاجزاً لتواصلك معهم، مجاني كليا!\n\nالتعرف على أصدقاء بشكل آمن\nعندما تشعر بالحاجة للسلام و الطمأنينة، الراحة النفسية، التحكم بالنفس، الثقة، الرضا او اي شيء آخر، يمكنك التحدث مع أصدقاءك هنا بشكل آمن و سري هنا، و سوف تحصل على الراحة.\n\nمميزات رائعة:\nغرف محادثات صوتية مجانية - ويسبر هو تطبيق دردشة صوتية مجاني كليا! يمكنك التواصل مع الأصدقاء في ويسبر بإستخدام 3جي، 4جي ، إل تي إي أو شبكة إنترنت واي فاي، يمكنك التمتع بسرعة خارقة و محادثة صوت بجودة عالية في غرفة الدردشة.\n\nحفلة مباشرة مجانية - يمكنك عمل حفلة مجانية لعيد ميلاد، زواج، عيد، أو تعليقات في نفس التوقيت على ألعاب كرة القدم أو أي موضوع آخر، تمتع بوقتك هناك.\n\nدخول سريع و سهل - التسجيل فقط في 5 ثواني، يمكنك الدخول إلى ويسبر للتعرف على الأصدقاء بشكل سريع و سهل.\n\nلحظات رائعة - يمكنك مشاهدة اللحظات التي يتم نشرها بواسطة أصدقائك في ويسبر، و يمكنك مشاركة لحظاتك الرائعة أيضاً ليشاهد اصدقاؤك حياتك المميزة.\n\nهدايا مع تأثيرات مذهلة - في غرفة الدردشة المباشرة أو الدردشة المباشرة يمكنك تبادل الهدايا بتأثيراتها المميزة مع أصدقائك.\n\nتواصل خاص مباشر - يمكنك العثور على صديقك الجديد بالتواصل شخص لشخص بإضافة الأصدقاء و إرسال الرسائل لبعضكم البعض.\n\nألعاب مثيرة - يوجد الكثير من الألعاب الترفيهية المذهلة في ويسبر مجانا، يمكنك لعب الألعاب مع الأصدقاء في غرف الدردشة الصوتية.\n\nمجموعة دردشة & تواصل شخص لشخص\nإذا كنت تفضل مجموعات الدردشة، إنضم إلى ويسبر و يمكنك التواصل مع العديد من الأصدقاء في نفس الوقت و في غرفة دردشة واحدة. يمكنك إقامة حفلات مباشرة، لعب الكثير من الألعاب المذهلة معهم، تبادل الهدايا و المحبة و الفرحة. إذا كنت تفضل الدردشة الخاصة شخص لشخص، إنضم إلى ويسبر و يمكنك العثور على أصدقاء من كل أنحاء العالم و التحدث معهم صوتيا بشكل آمن، دع قلبك و روحك ترتاح هنا.\n\nأفضل مجتمع تواصل إجتماعي أونلاين\nماتزال تشعر بالخجل من التواصل مع الغرباء؟ ماتزال قلق على التعرف على أصدقاء جدد من مسافات بعيدة ؟ ماتزال منزعج من صعوبة التحدث باللغات المختلفة خلال الدردشة أونلاين مع الأصدقاء الجدد من دول أخرى و مختلفة؟ ويسبر قام بحل كل هذه الصعوبات و العوائق لك، انضم إلى ويسبر لتحصل على افضل تجربة اتصال مباشر اجتماعي، و دردش صوتيا مع الأصدقاء الجدد بحرية.\n\nإذا كان لديك إقتراحات أو مراجعات، يرجى التواصل معنا:\nwhisperfeedback@gmail.com","rating":4.4,"ratingCount":"4.5K","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1514418573&pricingParameters=STDQ&pg=default&appExtVrsId=880911656"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1514418573"},{"locationPosition":0,"locationType":"lockup","name":"ويسبر - دردشة و ألعاب","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1514418573"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1514418573","eventType":"click","targetType":"button","targetId":"1514418573","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1514418573"}},"adamId":"1514418573","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1514418573&pricingParameters=STDQ&pg=default&appExtVrsId=880911656","vendor":"BLAGOL TECHNOLOGY CO., LIMITED","appName":"ويسبر - دردشة و ألعاب","bundleId":"com.chatvoice.whisper","appPlatforms":["phone"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"lineItem":null,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":false,"supportsVisionOSCompatibleIOSBinary":false,"extRefApp