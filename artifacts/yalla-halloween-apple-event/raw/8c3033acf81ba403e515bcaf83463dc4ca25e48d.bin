static.com/image/thumb/Purple211/v4/ad/a3/19/ada319fc-027e-1017-2fb2-40092e30c3c9/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Honey Jar Chat","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Entertainment","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":null,"editorialTagline":null,"editorialDescription":null,"shortEditorialDescription":null,"ageRating":"16+","productDescription":"  عبارة عن تطبيق للدرشة الصوتية،  Honey Jar   يمكنك التواصل مع أصدقائك من مختلف انحاء العالم، كل ما عليك فعله  ، تحميل تطبيق Honey Jar\n\n\n**غرفة الدردشة الصوتية**\n  تعرف على اشخاص واستمع لأصوات جميلة من مختلف انحاء العالم، تواصل وتفاعل مع الأصدقاء\nاحتفل في اي وقت واي مكان مع معجبيك و اصدقائك\nتابع غرف الدردشة المفضلة لك و شارك في الدردشة\n\n**مجتمع محب ومحافظ**\n تم  بناء هذا التطبيق بحب وشغف  ، جميع الخصائص في التطبيق مصممة لكي تناسبك  ونحن نسعى كل  جهدنا لكي نجعله مجتمع امن ومحافظ\nلضمان المحافظة على مجتمع حضاري على الجميع احترام وقوانين  ولوائح التطبيق\n التطبيق  مجاني هيا قم بنتزيل وتحميل التطبيق لاكتشاف جميع الخصائص المميزة ، يمكنك ايضا الانضمام الى الأعضاء الحصريين و الاستمتاع بمميزات النبلاء والحصول على العديد من الهدايا\n\n","rating":4.1,"ratingCount":"263","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1581403512&pricingParameters=STDQ&pg=default&appExtVrsId=881010594"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1581403512"},{"locationPosition":5,"locationType":"lockup","name":"Honey Jar Chat","reco_algo