perfect voice. \n\nRespectful Community\nIn our community which is based on mutual respect among users, you can spend an enjoyable and relaxing time here.\n\nFast And Easy Login\nHiya supports login with your Facebook, Google accounts or your phone number.\n\nGet ready to have an amazing voice chat with your friends.\nIf you have any feedback or questions, please contact: support@mehiya.com\nFeel free to leave any comments.","rating":4.3,"ratingCount":"1.9K","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1526086695&pricingParameters=STDQ&pg=default&appExtVrsId=880666421"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1526086695"},{"locationPosition":2,"locationType":"lockup","name":"Hiya - Group Voice Chatroom","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1526086695"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1526086695","eventType":"click","targetType":"button","targetId":"1526086695","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1526086695"}},"adamId":"1526086695","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1526086695&pricingParameters=STDQ&pg=default&appExtVrsId=880666421","vendor":"FUNI.PTE.LTD.","appName":"Hiya - Group Voice Chatroom","bundleId":"com.global.live.hiya","appPlatforms":["phone"],"isPreorder