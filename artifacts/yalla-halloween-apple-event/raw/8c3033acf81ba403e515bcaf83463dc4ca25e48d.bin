ctionsConfiguration":null},{"impressionMetrics":{"fields":{"id":"1377028992","name":"YouStar-Group Voice Chat Room","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":6,"contentRating":416,"bundleId":"com.stonemobile.youstar"}},"productVariantID":null,"adamId":"1377028992","bundleId":"com.stonemobile.youstar","decorations":[],"icon":{"checksum":null,"backgroundColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"textColor":{"red":0.050980392156862744,"green":0.050980392156862744,"blue":0.050980392156862744,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/d4/5b/6b/d45b6b43-ab0b-921f-3de4-c61d59e404da/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"YouStar-Group Voice Chat Room","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Make new friends & meet party","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Make new friends & meet party","editorialTagline":null,"editorialDescription":null,"shortEditorialDescription":null,"ageRating":"16+","productDescription":"Youstar is a free multiplayer voice chat and entertainment community, chat with people nearby or around the world, and play a variety of interesting social games.\n\nFree voice chat room\nYoustar has the safest and smoothest voice group chat room. No matter where you are, you can chat safely with Arab friends all over the world for free. Supports enjoying real-time voice chat using 3G, 4G, LTE or WI-FI networks.\n\nFree online party\nYou can hold free parties for birthdays, National Day, and Eid al-Fitr, or watch football matches in the room with like-minded friends for real-time commentary, or discuss the zodiac explanation to answer the zodiac password for you.\n\nCool virtual gifts\nIn the chat room you can exchange cool gifts with your friends. There are stunning animated special effects to suit your needs.\n\nWonderful game\nAlthough life is busy with trivial matters, Youstar will bring you a one-stop entertainment experience. In this app, you can play various exciting and fun mini-games such as Ludo, UMO, Crush, Lucky wheel, Fruit Party... and unlock endless gaming fun. From casual elimination to strategic competition, whether you are a newbie or an expert, you can find a game world that belongs to you.\n\nWatch rich video content\nIn addition to games, YouStar can also enables you to watch various music MVs and video content from Youtube. Welcome to enjoy music from all over the world anytime and anywhere. Whether it is a popular hit or a retro classic, there is always a song that will suit your mood. The rich video content covers various fields such as comedy, food, tourism, technology, culture, etc., allowing you to travel around the world and experience different wonderful lives in just a few minutes.\n\nCommunity accessibility\nYoustar is not only entertainment, but also a warm social circle. Here, you can meet like-minded friends and share the joy of entertainment and life with each other. Adding friends, instant chat, and interactive comments all reflect the warmth of friendship and the power of care. You can also show your talents here, share your mood text, and share the beauty of life with everyone.\n\nPersonalized recommendation\nWe have carefully designed a personalized push function to recommend more entertainment content and social activities that suit your tastes based on your interests and usage habits. Whether you are a warrior who likes to challenge yourself, or an artistic youth who enjoys tranquility, YouStar can find the most suitable content for you, allowing you to find a sense of belonging and resonance here.\n\nLive video\nAt the same time, our live broadcast function will also give you an immersive viewing experience. Watch the wonderful live broadcast, interact with everyone, become a member of the fan circle, and feel the real and beautiful emotional resonance.\n\nJoin Youstar now! Here, you will no longer be alone, because there is always a group of people in the world waiting to meet you and explore unlimited joy and passion together. Let us create our own new era of entertainment and social interaction together!","rating":4.2,"ratingCount":"336","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1377028992&pricingParameters=STDQ&pg=default&appExtVrsId=880726463"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1377028992"},{"locationPosition":6,"locationType":"lockup","name":"YouStar-Group Voice Chat Room","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1377028992"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1377028992","eventType":"click","targetType":"button","targetId":"1377028992","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1377028992"}},"adamId":"1377028992","purchaseConfiguration":{"buyParams":"productType=C&price=0&salableAdamId=1377028992&pricingParameters=STDQ&pg=default&appExtVrsId=880726463","vendor":"GOOD ONLINE TECHNOLOGY PTE.LTD.","appName":"YouStar-Gro