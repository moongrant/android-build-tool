":1080,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"2026 New Year Celebration","subtitle":"Join in Yalla Season for Surprise Benefits!","detail":"The limited-time event has begun. Join in the carnival, and win exclusive rewards in the Yalla Season!","startDate":"2025-12-25T02:00:00.000Z","endDate":"2026-01-07T22:00:00.000Z","kind":"SPECIAL EVENT","appEventBadgeKind":"happening","lockup":{"impressionMetrics":{"fields":{"id":"1091902866","name":"Yalla - Play Game & Voice Chat","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":0,"inAppEventId":"6755461263","relatedSubjectIds":["1091902866"],"contentRating":313,"bundleId":"com.weieyu.yalla"}},"productVariantID":null,"adamId":"1091902866","bundleId":"com.weieyu.yalla","decorations":[],"icon":{"checksum":null,"backgroundColor":{"red":0.5176470588235295,"green":0.984313725490196,"blue":0.6666666666666666,"type":"rgb"},"textColor":{"red":0.23137254901960785,"green":0.3215686274509804,"blue":0.2627450980392157,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/7c/ee/33/7cee33a6-4a7d-742d-31cc-ed4ee78bc5f2/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla - Play Game & Voice Chat","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Game Together, Chat Anytime","tertiaryTitle":"Designed for iPhone","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Game Together, Chat Anytime","editorialTagline":"Chat with friends","editorialDescription":null,"shortEditorialDescription":null,"ageRating":"13+","productDescription":"Play, Chat, and Connect – All in One Place!\nLooking for a fun, engaging way to play games and chat with friends? Yalla brings together casual games and voice chat rooms, creating an unmatched social experience. Whether you're a fan of classic games or love connecting with new people, we’ve got you covered!\n\nKey Features:\nCasual Games to Enjoy Anytime\n- Play popular games like Ludo, Carrom, UMO, and Baloot with friends or other players worldwide.\n- Immerse yourself in friendly competitions, challenge players worldwide, and climb the leaderboards to prove your skills.\n- Stay tuned—more exciting games are coming soon!\n\nVoice Chat Rooms\n- Join voice chat rooms to talk, laugh, and make new friends. Thousands of voice chat rooms are waiting for you.\n- Go on the mic, send messages in chat, or exchange virtual gifts to enhance the fun.\n- Play mini-games directly in the room for a lively group experience.\n\n1-on-1 Private Chat\n- Connect deeper with friends through private chat. Share messages, voice notes, and more in a personal space.\n\nPost and Share\n- Share your thoughts, game achievements, or fun moments with the community posts feature. Let others know what you're up to!\n\nWhy Choose Our App?\n- All-in-One Experience: Play games, chat, and socialize in one seamless app.\n- Global Community: Meet and interact with people from around the world.\n- Fun and Interactive: Voice chat, gifts, and games make every moment exciting.\n\nFollow us to get the latest news, updates and events:\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\nWebsite: www.yalla.live\nDear YALLA users, your feedback and suggestions are welcome to: yallasupport@yalla.com","rating":4.2,"ratingCount":"25K","buttonAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferStateAction","$kind":"OfferStateAction","actionMetrics":{"data":[],"custom":{}},"adamId":"1091902866","defaultAction":{"impressionMetrics":null,"title":"Get","artwork":null,"presentationStyle":[],"actionClass":"OfferAction","$kind":"OfferAction","actionMetrics":{"data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1091902866&pri