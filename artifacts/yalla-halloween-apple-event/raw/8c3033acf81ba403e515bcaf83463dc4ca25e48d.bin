you all special thanks to the management of Yalla Life and add only those pieces of gold price is very beautiful will not exploit any new person.","rating":5,"reviewerName":"7so .","dateAuthorText":"* null * · 7so .","response":{"id":"11722507","contents":"welcome! We are happy to be with you at yalla. Yalla is an original application that allows you to meet new friends from around the Arab world. We hope that your next comment will be five stars. If you have suggestions, you can contact yallasupport@yalla.live","date":"2019-11-08T02:05:17.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"instructions":[],"custom":{}},"adamId":"1091902866","targetReviewId":"5098790143"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}}},{"impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":4}},"componentType":"productReview","sourceType":"user","review":{"impressionMetrics":null,"id":"12929154971","title":"O","date":"2025-07-24T03:33:10.000Z","dateText":"* null *","contents":"My Yalla account was linked to my Twitter (@3jmi*7_7) and it worked before, but now it says “invalid link” and won’t open the app.\nI don’t own the phone number linked to the account and I can’t log in. Please help me recover or protect my account before I lose it","rating":5,"reviewerName":"Hwhw67","dateAuthorText":"* null * · Hwhw67","response":{"id":"54458628","contents":"Dear user, the account login function of Yalla has been adjusted. You can also register and log in through third-party applications. Sorry for the inconvenience. If you have any questions, please contact us through the yallasupport customer service email. wish you a happy experience in Yalla.","date":"2025-07-28T02:56:11.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null,"moreAction":{"impressionMetrics":null,"title":"Ratings & Reviews","artwork":null,"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowAction","actionMetrics":{"data":[],"custom":{}},"page":"reviews","pageData":{"shelves":[{"impressionMetrics":{"fields":{"id":"14","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"impressionMetrics":null,"id":"12929154971","title":"O","date":"2025-07-24T03:33:10.000Z","dateText":"* null *","contents":"My Yalla account was linked to my Twitter (@3jmi*7_7) and it worked before, but now it says “invalid link” and won’t open the app.\nI don’t own the phone number linked to the account and I can’t log in. Please help me recover or protect my account before I lose it","rating":5,"reviewerName":"Hwhw67","dateAuthorText":"* null * · Hwhw67","response":{"id":"54458628","contents":"Dear user, the account login function of Yalla has been adjusted. You can also register and log in through third-party applications. Sorry for the inconvenience. If you have any questions, please contact us through the yallasupport customer service email. wish you a happy experience in Yalla.","date":"2025-07-28T02:56:11.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"instructions":[],"custom":{}},"adamId":"1091902866","targetReviewId":"12929154971"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}}},{"impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":5}},"componentType":"productReview","sourceType":"user","review":{"impressionMetrics":null,"id":"3930709153","title":"Stealing money","date":"2019-03-26T22:39:24.000Z","dateText":"* null *","contents":"I paid 8.99$ for recharging 1000 coins and didn’t get it until now for the fourth day of waiting and app support didn’t help for this problem they asked me to contact their EMAIL and never respond I contact apple support and waiting for action.","rating":5,"reviewerName":"raed al enazi","dateAuthorText":"* null * · raed al enazi","response":{"id":"7924420","contents":"Dear user,sorry for the inconvenience , please send the payment receipt and attach your ID to yallasupport@yalla.live And I will remind the relevant staff to deal with it as soon as possible.We're always here to help you solve any app problem.","date":"2019-03-27T05:26:29.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null,"moreAction":{"impressionMetrics":null,"title":"Ratings & Reviews","artwork":null,"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowAction","actionMetrics":{"data":[],"custom":{}},"page":"reviews","pageData":{"shelves":[{"impressionMetrics":{"fields":{"id":"15","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"impressionMetrics":null,"id":"3930709153","title":"Stealing money","date":"2019-03-26T22:39:24.000Z","dateText":"* null *","contents":"I paid 8.99$ for recharging 1000 coins and didn’t get it until now for the fourth day of waiting and app support didn’t help for this problem they asked me to contact their EMAIL and never respond I contact apple support and waiting for action.","rating":5,"reviewerName":"raed al enazi","dateAuthorText":"* null * · raed al enazi","response":{"id":"7924420","contents":"Dear user,sorry for the inconvenience , please send the payment receipt and attach your ID to yallasupport@yalla.live And I will remind the relevant staff to deal with it as soon as possible.We're always here to help you solve any app problem.","date":"2019-03-27T05:26:29.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"instructions":[],"custom":{}},"adamId":"1091902866","targetReviewId":"3930709153"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}}},{"impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":6}},"componentType":"productReview","sourceType":"user","review":{"impressionMetrics":null,"id":"5685283736","title":"Complaint","date":"2020-03-20T05:02:20.000Z","dateText":"* null *","contents":"Physically and morally damaged without the administration to solve the problem !!!\n\nI am very dissatisfied with what happened and I want to recover the amount paid and fixed with compensation for moral damages.\n\nBest  wish","rating":5,"reviewerName":"الحفظي","dateAuthorText":"* null * · الحفظي","response":{"id":"14151224","contents":"Hi, most users (more than 99%) enjoy Yalla for free and they love to have fun with many friends together. Let us work together to develop Yalla to be the best Arab community for our b