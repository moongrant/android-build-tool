ata":[],"custom":{}},"page":"writeReview","pageUrl":"?id=1091902866","pageData":"1091902866","presentationContext":"presentModal","animationBehavior":"infer","origin":"inapp"},"supportAction":{"impressionMetrics":null,"title":"App Support","artwork":null,"presentationStyle":[],"actionClass":"ExternalUrlAction","$kind":"ExternalUrlAction","actionMetrics":{"data":[],"custom":{}},"url":"http://www.yalla.live","isSensitive":false},"alwaysAllowReviews":false}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false},{"impressionMetrics":{"fields":{"id":"23","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":2}},"contentType":"reviews","marker":null,"items":[{"impressionMetrics":null,"id":"5736592459","title":"Complain issue","date":"2020-03-30T16:55:40.000Z","dateText":"* null *","contents":"I buy by Visa but I didn’t received a coins since 5 days. I already sent an Email back and forth through Yalla support team with no action. How i can got my coins to my user account if no one from support team did their job. Till now the issue not resolved. Please advise.","rating":5,"reviewerName":"BAQ1010","dateAuthorText":"* null * · BAQ1010","response":{"id":"14373812","contents":"Hi, most users (more than 99%) enjoy Yalla for free and they love to have fun with many friends together. Let us work together to develop Yalla to be the best Arab community for our brothers and sisters. If you have any suggestions, you can contact yallasupport@yalla.live and we hope to see your distinguished comment with the five stars. Thank you!","date":"2020-04-01T01:39:44.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"5786496462","title":"VIP agents and customers service cannot help me","date":"2020-04-09T15:29:29.000Z","dateText":"* null *","contents":"Dear sir,\n\nI am almost 2 years using Yalla live, last year a\nI lost my phone number that I paired with my account, And I forgot the password and now i am using WeChat to login to my account. I am VIP member and I charge my account over ( 8000 SAR ) I tried to communicate with VIP AGENTS and VIP customers service in WhatsApp they told me to give them the required to change the old phone number to the new phone number, at the end they told me to remember my password when I told them that I cannot remember, they told me that they cannot help me. After I give them all the bill of my charge in the app and I record from inside the app and I prove that I am using the account, and after I give them a lot of what they require from me they side ( we cannot help you ) I stooped buying coin from the app until you change my phone number.","rating":1,"reviewerName":"0552758306","dateAuthorText":"* null * · 0552758306","flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"3543235211","title":"How","date":"2018-12-18T03:17:04.000Z","dateText":"edited * null *","contents":"How can i know the facebook account linked with my yalla live account?\nI don’t know is there any support for this APP because i send request many requests to provide me facebook account linked with my yalla live account & i don’t have option to see it throw APP !!\n\nDear developer,\n\nThis high importance &urgent please i need to contact with you ?\n\nBad App it doesn’t have support team more than one month there isn’t any body reply to me or close my request\n\nNew note:\nWhy you don’t have authorized to see it you are support & developer \n\nIf you don’t have that add option to user to see the accounts linked with his App account\n\nMy App account is under my mobile no but there is facebook account linked with it i need to know this facebook account!!!\n\nNew note:\nIdo not need to cancel facebook account i asked to provide me the facebook account linked with my yalla account !!!!\n\nNew note:\n\nThere isn’t response\n\nUpdate:\n\nللامانه.   تطبيق خايس ويفتقر للدعم الفني   لم تحل مشكلتي.   ومع كثر الالحاح مني والمتابعه تم حذف حسابي من قبلكم ودون علمي او طلب مني\n\nتطبيق ودعم فني لايستاهل التقييم","rating":1,"reviewerName":"فلاح اليامي","dateAuthorText":"edited * null * · فلاح اليامي","response":{"id":"3167223","contents":"Please send more details about your user ID and screenshot to support@yalla.live, reset your password by mobile number, and we will cancel the link with Facebook account. We hope you enjoy with your friends in Yalla. \nWarm Regards","date":"2018-04-18T03:48:12.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"5098790143","title":"About Yalla Live application","date":"2019-11-07T13:30:14.000Z","dateText":"* null *","contents":"My opinion in the program Yalla Life is very beautiful and its internal coordination is attractive and wonderful and the most beautiful of that management deal with members Thank you all special thanks to the management of Yalla Life and add only those pieces of gold price is very beautiful will not exploit any new person.","rating":5,"reviewerName":"7so .","dateAuthorText":"* null * · 7so .","response":{"id":"11722507","contents":"welcome! We are happy to be with you at yalla. Yalla is an original application that allows you to meet new friends from around the Arab world. We hope that your next comment will be five stars. If you have suggestions, you can contact yallasupport@yalla.live","date":"2019-11-08T02:05:17.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"12929154971","title":"O","date":"2025-07-24T03:33:10.000Z","dateText":"* null *","contents":"My Yalla account was linked to my Twitter (@3jmi*7_7) and it worked before, but now it says “invalid link” and won’t open the app.\nI don’t own the phone number linked to the account and I can’t log in. Please help me recover or protect my account before I lose it","rating":5,"reviewerName":"Hwhw67","dateAuthorText":"* null * · Hwhw67","response":{"id":"54458628","contents":"Dear user, the account login function of Yalla has been adjusted. You can also register and log in through third-party applications. Sorry for the inconvenience. If you have any questions, please contact us through the yallasupport customer service email. wish you a happy experience in Yalla.","date":"2025-07-28T02:56:11.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"3930709153","title":"Stealing money","date":"2019-03-26T22:39:24.000Z","dateText":"* null *","contents":"I paid 8.99$ for recharging 1000 coins and didn’t get it until now for the fourth day of waiting and app support didn’t help for this problem they asked me to contact their EMAIL and never respond I contact apple support and waiting for action.","rating":5,"reviewerName":"raed al enazi","dateAuthorText":"* null * · raed al enazi","response":{"id":"7924420","contents":"Dear user,sorry for the inconvenience , please send the payment receipt and attach your ID to yallasupport@yalla.live And I will remind the relevant staff to deal with it as soon as possible.We're always here to help you solve any app problem.","date":"2019-03-27T05:26:29.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"5685283736","title":"Complaint","date":"2020-03-20T05:02:20.000Z","dateText":"* null *","contents":"Physically and morally damaged without the administration to solve the problem !!!\n\nI am very dissatisfied with what happened and I want to recover the amount paid and fixed with compensation for moral damages.\n\nBest  wish","rating":5,"reviewerName":"الحفظي","dateAuthorText":"* null * · ا