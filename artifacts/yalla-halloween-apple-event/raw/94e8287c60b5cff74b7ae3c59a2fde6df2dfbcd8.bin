fd9faaf52/ea2b9e7d-4cc9-4c6a-8a93-bef6a6d0479e_05-_Uff081242_U002a2688_Uff09.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"71fefd\",\"height\":2688,\"textColor1\":\"140b04\",\"textColor2\":\"3c0a02\",\"textColor3\":\"273c36\",\"textColor4\":\"473b34\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/8f/3b/c9/8f3bc9e6-a701-ca3a-201c-ae74943224bc/ca86ef5c-b612-48a3-adf0-2c5898298d1c_06-_Uff081242_U002a2688_Uff09.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"71fefd\",\"height\":2688,\"textColor1\":\"0e070b\",\"textColor2\":\"001423\",\"textColor3\":\"22383b\",\"textColor4\":\"16434e\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/fb/7f/9e/fb7f9e8b-3dbf-c11b-9c0f-f04f792d8810/cb41b026-0f33-4cf4-9941-5b544a092dc4_07-_Uff081242_U002a2688_Uff09.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"71fefd\",\"height\":2688,\"textColor1\":\"0d0d0d\",\"textColor2\":\"2e2420\",\"textColor3\":\"213d3d\",\"textColor4\":\"3c4f4c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/09/16/fd/0916fd49-face-5323-e0c6-2134aca84dfe/1c5ad2d5-724c-4c9a-990f-4edcffc0d0d2_08-_Uff081242_U002a2688_Uff09.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"71fefd\",\"height\":2688,\"textColor1\":\"110e09\",\"textColor2\":\"001520\",\"textColor3\":\"243e39\",\"textColor4\":\"16434c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/97/c8/d4/97c8d4ad-2d1a-2a30-2780-f58f37b091ff/5f94b803-b427-4638-ac76-69d3111062dd_09-_Uff081242_U002a2688_Uff09.jpg/{w}x{h}{c}.{f}\",\"width\":1242}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/28/59/ee/2859eebe-20ac-7814-ec46-0fce7ce3d567/12fc09db-ce0f-4c5f-a841-6866788e0179.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"b6030c\",\"height\":1080,\"textColor1\":\"febc00\",\"textColor2\":\"febc00\",\"textColor3\":\"f09702\",\"textColor4\":\"f09702\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9/df/22/b9df22e4-d410-273a-f990-87ef45dc326b/53b5c834-2546-4ab9-b26a-5c5126c6851e.png/{w}x{h}{c}.{f}\",\"width\":758},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"width\":758}},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":550161408}],\"buyParams\":\"produc