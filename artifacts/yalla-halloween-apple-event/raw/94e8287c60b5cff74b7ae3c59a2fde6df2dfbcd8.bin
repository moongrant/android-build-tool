7_U7248-6.7_U82f1_U65874Fun-iOS-6.7-_U56fe2.jpg/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"006931\",\"height\":2796,\"textColor1\":\"fffcfa\",\"textColor2\":\"f9e67d\",\"textColor3\":\"cbded1\",\"textColor4\":\"c7cd6e\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/62/06/ae/6206ae14-cc43-d8b4-25f5-5eb5eb9c72c4/abf922b8-5c16-4581-beb8-d14f10006e63_1_U6c99_U7279UGC_U4e13_U5c5e_U5546_U5e97_U9875-iOS_U82f1_U6587_U7248-6.7_U82f1_U65874Fun-iOS-6.7-_U56fe2.jpg/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"0c150a\",\"height\":2796,\"textColor1\":\"fffcfb\",\"textColor2\":\"00d26f\",\"textColor3\":\"cecdca\",\"textColor4\":\"02ac5b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/6a/8a/65/6a8a651c-f235-3948-beea-40a9ecfc7120/ca879b58-522b-406f-8065-3f5637c910a9_1_U6c99_U7279UGC_U4e13_U5c5e_U5546_U5e97_U9875-iOS_U82f1_U6587_U7248-6.7_U82f1_U65874Fun-iOS-6.7-_U56fe4.jpg/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"0c150a\",\"height\":2796,\"textColor1\":\"fffcfb\",\"textColor2\":\"00d26f\",\"textColor3\":\"cecdca\",\"textColor4\":\"02ac5b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/5b/70/91/5b7091a3-07f0-3bcc-adfd-3ed084625393/3da11848-3b43-44b5-a13a-f5fe9f5643a7_1_U6c99_U7279UGC_U4e13_U5c5e_U5546_U5e97_U9875-iOS_U82f1_U6587_U7248-6.7_U82f1_U65874Fun-iOS-6.7-_U56fe5.jpg/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"006931\",\"height\":2796,\"textColor1\":\"fffcfb\",\"textColor2\":\"e9dedb\",\"textColor3\":\"cbded2\",\"textColor4\":\"bac6b9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/76/10/55/7610558e-0630-b111-7770-f8ad4e0ca587/1f8fcea8-5476-43da-b912-0f69af0019e8_1_U6c99_U7279UGC_U4e13_U5c5e_U5546_U5e97_U9875-iOS_U82f1_U6587_U7248-6.7_U82f1_U65874Fun-iOS-6.7-_U56fe3.jpg/{w}x{h}{c}.{f}\",\"width\":1290}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"The app that people in Saudi Arabia and the UAE are paying attention to! 4Fun is a popular group voice chat app for arabs in KSA and UAE.\\n\\n\\nRAMADAN KAREEM! As Ramadhan approaches, 4Fun will add audio rooms for Quran recitation, hadith explanation, charity, zakat, and Ramadan content. Let's spend Ramadan online together, enjoy the peaceful Ramadan, and relax yourself.\\n\\n\\nRecommended community to make friends:\\nExplore friends and chat rooms that interest you. Make friends with interesting souls through your voice. It's a safe, warm and stress-free community.\\n\\n\\nOnline Party to entertain with your friends:\\nWhy not try to have a fun online party? You can chat with friends of the arab world anytime and anywhere about hot trends, emotions, fashion, football, work...\\n\\n\\nPlay Mdagsh with your friends:\\nMdagsh is a local KSA game. In the game, the banker need to choose question other players or not according to their own cards, while other players can choose to accept or increase. They compare the cards to decide which one is the winner, it’s depends on luck and their choices.\\n\\n\\nVarious Games that Saudis are playing:\\nLudo, , Uno……Nearly 10 popular local games for you to choose from! 4fun provides everyone with a wonderful gaming world.\\n\\n\\nFEATURES:\\n\\nMAKE FRIENDS- Meet friends that suit you instantly and easily! Friends are crowded into ROOMs, MOMENT \u0026 PRIVATE CHAT. On 4Fun, you never know who you might meet!\\n\\nDELICATE DESIGN- Stunning animated gifts, vehicles, headwears for you to show your taste and personality.\\n\\nUNIQUE HONOR-Special id, beautiful badges, SVIP, luxury ranking, Customized Gifts for you to show your uniqueness.\\n\\nROOM PARTY-Attend parties with different themes: Chat, Singles Club, Couples, Girls, Travel, AFC.\\n\\nGAMES- Play games with different arabs!\\n\\nMessage us: support@spread-fun.com\"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is