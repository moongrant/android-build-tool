idth\":1242},{\"bgColor\":\"4b1f3c\",\"height\":2208,\"textColor1\":\"fbf1e6\",\"textColor2\":\"ece5f0\",\"textColor3\":\"d8c7c4\",\"textColor4\":\"ccbdcc\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a0/c3/35/a0c335cc-7032-4578-24f0-b5fc4560df08/a52dcbef-b0ed-4ece-985f-fae93a27298f__U804a_U5929_U5ba4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"491e4b\",\"height\":2208,\"textColor1\":\"ffffff\",\"textColor2\":\"ffc430\",\"textColor3\":\"dad1da\",\"textColor4\":\"daa236\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/40/e8/18/40e818f0-f195-459c-0177-823b8042405b/8b9b2137-667f-4e98-991d-33c0dfe2b40a__U597d_U53cb.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"4b1c36\",\"height\":2208,\"textColor1\":\"f6f0f4\",\"textColor2\":\"febd2e\",\"textColor3\":\"d4c5ce\",\"textColor4\":\"da9d2f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/cf/50/61/cf506194-a597-aa88-163f-1881a031000f/df390d95-77f9-4445-b5fe-1adffa2aa0ec__U76ae_U80a4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"431b3a\",\"height\":2208,\"textColor1\":\"ffee77\",\"textColor2\":\"fcb82c\",\"textColor3\":\"d9c36a\",\"textColor4\":\"d7982f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/28/51/c7/2851c789-9dea-0436-4628-fb83e9f7f9ed/43122e5d-53f1-423c-9552-97cc14623c22__U5b9d_U7bb1.png/{w}x{h}{c}.{f}\",\"width\":1242}],\"iphone_6_5\":[{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/4f/16/e8/4f16e845-ef62-310d-54c9-003766ae9042/_U968f_U65f6_U968f_U5730_U8bed_U97f3_U804a_U59292.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d7/85/21/d785215f-4de1-6a7d-98c1-709ad70041da/_U53d7_U6b22_U8fce_U7684Parchis_U6e38_U620f1.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/b2/0a/e6/b20ae667-76d5-949c-013a-21c8db04aa7d/_U5b9e_U65f6_U5728_U7ebf_U8bed_U97f3__U89c6_U9891_U804a_U5929_U5ba46.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/f8/af/60/f8af6029-e058-51dc-18bc-7e044f8229cf/_U6392_U884c_U699c7.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/09/d4/ff/09d4ff8a-d784-4317-2209-7cdae1ca4508/_U6bcf_U65e5_U8d85_U591a_U514d_U8d39_U91d1_U5e01_U53ef_U98865.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/91/dc/33/91dc33a1-b526-9877-610c-95bd1d4445b3/_U751f_U52a8_U7684_U4e3b_U9898_U80cc_U666f_U548c_U76ae_U80a44.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/c3/93/74/c39374b1-70ab-d878-2a04-d5b892482052/_U4e0e_U597d_U53cb_U7545_U73a9_U6e38_U620f3.png/{w}x{h}{c}.{f}\",\"width\":1242}]},\"customVideoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"4d315d\",\"height\":1920,\"textColor1\":\"dfb8f0\",\"textColor2\":\"ab99e4\",\"textColor3\":\"c29dd2\",\"textColor4\":\"9884c9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo126/v4/da/fb/79/dafb79e4-4812-d15f-3f33-0e32d63e55d8/Job7fe8f74a-5fe9-4bdd-91ab-b5509ac196e5-152902508-PreviewImage_preview_image_nonvideo_sdr-Time1689580811587.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/00/11/a9/0011a9fd-a5d3-73a9-ea00-7244351655f8/P602517787_default.m3u8\"}]}}}},\"description\":{\"standard\":\"Yalla Parchis is a free online multiplayer Parchis game, Parchis is a very popular board game, especially in Spain and Latin America. The rules of the game evolved from Ludo, Parchisi and Parcheesi.\\n\\nFeatures:\\n\\n1. Multiple Parchis rules \u0026 modes - There are four rules: Classic, Spanish, Quick and Magic, and you can choose to play in 1v1, 4 players or in teams(2v2). \\n2. In-game voice chat \u0026 chat room - We offer a high-quality social experience where you can voice chat in real-time during the game and use the chat room function to chat with audio and video, send gifts, play games, and host parties with your friends in the room. Everyone here is friendly.\\n3. Collect diverse skins - Play for free and get a variety of skins of dice, theme, token, etc.\\n4. Various events - Festive events with local characteristics are held regularly.\\n5. Up to 30K free Golds every day.\\n\\nIn America and Spain, Parchisi is played with two dice, four tokens per player, and the first player who moves four tokens to the end wins. In Colombia, the Parchis board game is also called \\\"Parqués\\\".\\nAs one of the most popular Parchis games, we are not only committed to bringing the classic Parchis gameplay from memory to online, but also to innovating while respecting tradition.\\nOn the subway, in the park, at home, at any time and place, you can quickly start an amazing Parchis journey and make new friends in chat rooms, from online to offline. If you are looking for a high-quality casual game to enjoy your leisure time, Yalla Parchis will never disappoint you.\\n\\nEnjoy life, enjoy online Parchis!\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"582f3e\",\"height\":1080,\"textColor1\":\"dad8e3\",\"textColor2\":\"e2a343\",\"textColor3\":\"beb2be\",\"textColor4\":\"c48a42\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/1f/b0/1a/1fb01a74-caeb-c9e8-8c83-22f60df0d043/26f15936-a869-4917-9e9b-914c992f97be.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/31/ed/0b/31ed0bc0-e686-add2-cce7-3fda494d0984/51883c2e-f530-4ea9-81da-8cd5059fe433.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"565b60\",\"height\":1080,\"textColor1\":\"f6f6f7\",\"textColor2\":\"eeeeef\",\"textColor3\":\"d6d7d8\",\"textColor4\":\"cfd1d2\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/65/41/e7/6541e712-8b83-d508-d7d9-d3aa0e1a1587/48ea4906-d589-4a63-bd8f-303e0ab31b62.png/{w}x{h}{c}.{f}\",\"width\":752},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/3b/4c/3a/3b4c3a0e-ef75-c62a-4d37-fef9fb40d32a/348534c3-7a59-4176-bc29-dad788ebade7.png/{w}x{h}{c}.{f}\",\"width\":752},\"subscriptionHero\":{\"bgColor\":\"1b102d\",\"height\":1080,\"textColor1\":\"eba545\",\"textColor2\":\"e27175\",\"textColor3\":\"ba8240\",\"textColor4\":\"b45a66\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/5f/2d/39/5f2d39e7-7445-b208-641d-0ea94d1ca008/3d0596e1-3ea5-4284-bf20-e51d23906b2a.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"tagline\":\"Play and chat with friends\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":309112832}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878069982\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":309112832}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878069982\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://www.yallaparchis.com/term/EN/TermOfService.html\",\"releaseDate\":\"2021-02-02\",\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Parchis with voice chat\",\"supportURLForLanguage\":\"https://www.yallaparchis.com/\",\"versionHistory\":[{\"releaseDate\":\"2025-09-25\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\nExperience Optimizations \u0026 Bug Fixes.\",\"releaseTimestamp\":\"2025-09-25T01:49:45Z\",\"versionDisplay\":\"1.3.2\"},{\"releaseDate\":\"2025-08-11\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.Experience Optimizations \u0026 Bug Fixes​.\",\"releaseTimestamp\":\"2025-08-11T12:37:24Z\",\"versionDisplay\":\"1.3.1\"},{\"releaseDate\":\"2025-07-21\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.New Royal system unleashed and more exclusive privileges await!\\n2.Experience Optimizations \u0026 Bug Fixes​.\",\"releaseTimestamp\":\"2025-07-21T13:33:40Z\",\"versionDisplay\":\"1.3.0\"},{\"releaseDate\":\"2025-06-01\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. Intimacy System:​​ Come see how close you and your friends really are! \\r\\n2. ​​Friend Assistance:​​ Friends can help reduce your chest opening time!\\r\\n3. ​​Spectator Gifting:​​ Now you can cheer on your favorite players sending them gifts in the game broadcast!\\r\\n4. ​​Experience Optimizations \u0026 Bug Fixes​.\",\"releaseTimestamp\":\"2025-06-01T02:56:52Z\",\"versionDisplay\":\"1.2.9\"},{\"releaseDate\":\"2025-04-07\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. Fancy designs can be unlocked more easily: Higher entry fees grant better skin reward chests. Plus, some skin fragments are now available for instant purchase.\\n2.Game props storage: more new props with easier management!\\n3. Chatroom Bingo Party: venture to try your fortunes!\\n4.Game broadcast list: swipe through the vertical feed to find your favorite game streamer!\",\"releaseTimestamp\":\"2025-04-07T06:57:47Z\",\"versionDisplay\":\"1.2.8\"},{\"releaseDate\":\"2025-01-20\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. New Offer for Beginners: a new token skin is waiting for you.\\n2. The games in chatrooms have been optimized.\\n3. Bugs fixed.\",\"releaseTimestamp\":\"2025-01-20T15:31:43Z\",\"versionDisplay\":\"1.2.7\"},{\"releaseDate\":\"2025-01-03\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.The Store has been updated! Exciting items as UNDO Card are prepared for you!\\n2.More exclusive gifts and privileges are added for Club Members.\\n3.New exclusive privilege is added for the most generous sender of Weekly Gifts!\\n4.The experience has been optimized and bugs have been fixed.\",\"releaseTimestamp\":\"2025-01-03T01:50:19Z\",\"versionDisplay\":\"1.2.6\"},{\"releaseDate\":\"2024-11-05\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1.A new free Bingo game is added to the chatroom, where you can customize the numbers on the cards. Come play with your friends!\\n2.The step indicator feature is optimized for better clarity.\\n3.A new room mode is added. Come try out the new effects on the seats!\\n4.The experience has been optimized and bugs have been fixed.\",\"releaseTimestamp\":\"2024-11-05T01:46:54Z\",\"versionDisplay\":\"1.2.5\"},{\"releaseDate\":\"2024-09-24\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\n1. The token position indicator has been optimized, and the operations have been facilitated. \\n2. The issue of receiving abnormal notifications about the game exiting when holding the second place in various modes has been resolved.\\n3. Room owners are now able to add specific users to the room's blacklist.\\n4. Bugs fixed.\",\"releaseTimestamp\":\"2024-09-24T02:01:04Z\",\"versionDisplay\":\"1.2.4.1\"},{\"releaseDate\":\"2024-09-11\",\"releaseNotes\":\"Welcome to Yalla Parchís. The updates are as follows:\\n1. The new function of tokens’ expected position is added, and when activating the option, users can know clearly the squares where the tokens will arrive with the numbers on the dices.\\n2. The room owners are able to add certain users in the room’s blacklist.\\n3. Bugs fixed.\",\"releaseTimestamp\":\"2024-09-11T03:17:30Z\",\"versionDisplay\":\"1.2.4\"},{\"releaseDate\":\"2024-07-19\",\"releaseNotes\":\"The updates are as follows:\\r\\n1. The new function S.T. Points is added, which can be used to redeem for items or in coming functions.\\r\\n2. The new functions \\\"Block all the micros\\\" and \\\"Eliminate inactive members in batches\\\" are accessible now as the privileges for Baron.\\r\\n3. The Racing rule is planned to be permanent in the app.\\r\\n4. The rewards for the current period in the Fragments Fusion will be displayed.\\r\\n5. Bugs fixed.\",\"releaseTimestamp\":\"2024-07-19T01:54:14Z\",\"versionDisplay\":\"1.2.3.1\"},{\"releaseDate\":\"2024-07-12\",\"releaseNotes\":\"The updates are as follows:\\r\\n1. The new function S.T. Points is added, which can be used to redeem for items or in coming functions.\\r\\n2. The new functions \\\"Block all the micros\\\" and \\\"Eliminate inactive members in batches\\\" are accessible now as the privileges for Baron.\\r\\n3. The Racing rule is planned to be permanent in the app.\\r\\n4. The rewards for the current period in the Fragments Fusion will be displayed.\\r\\n5. Bugs fixed.\",\"releaseTimestamp\":\"2024-07-12T02:11:49Z\",\"versionDisplay\":\"1.2.3\"},{\"releaseDate\":\"2024-05-31\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. The Racing mode is now available in VIP and private rooms.\\r\\n2. The new item Room Experience Card is added, which can be used to upgrade the level of the chatrooms.\\r\\n3. The new item Room Frame is added, which provides more styles of display.\\r\\n4. Bugs fixed.\",\"releaseTimestamp\":\"2024-05-31T02:00:50Z\",\"versionDisplay\":\"1.2.2.1\"},{\"releaseDate\":\"2024-05-27\",\"releaseNotes\":\"Welcome to Yalla Parchis. The updates are as follows:\\r\\n1. The Racing mode is now available in VIP and private rooms.\\r\\n2. The new item Room Experience Card is added, which can be used to upgrade the level of the chatrooms.\\r\\n3. The new item Room Frame is added, which provides more styles of display.\\r\\n4. Bugs fixed. \",\"releaseTimestamp\":\"2024-05-27T02:00:38Z\",\"versionDisplay\":\"1.2.2\"},{\"releaseDate\":\"2024-04-03\",\"releaseNotes\":\"Welcome to Yalla Parchís. The updates are as follows:\\r\\n1. The starting time has been optimized.\\r\\n2. The default option for the fragments fusion's filter has been changed to \\\"unlocked\\\" to avoid unintentional operations.\\r\\n3. The piggy banks can only be purchased when it's full to avoid unintentional operations.\\r\\n4. More levels and honor icons have been added to the member clubs.\\r\\n5. The chatroom list has been optimized to show more excelent rooms and more interesting contents.\\r\\n6. Some bugs has been fixed.\",\"releaseTimestamp\":\"2024-04-03T01:56:16Z\",\"versionDisplay\":\"1.2.1\"},{\"releaseDate\":\"2024-02-01\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. The new game mode \\\"Racing\\\" has been added. More interesting props and exciting\\r rules are waiting for you to try. \\n2. New tools \\\"Stopwatch\\\" and \\\"Timer\\\" have been added to the Chatroom. \\n3. Optimized game experience and fixed bugs.\",\"releaseTimestamp\":\"2024-02-01T03:20:02Z\",\"versionDisplay\":\"1.2.0\"},{\"releaseDate\":\"2023-11-24\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. You can spectate game matches in the chat room now. It's even more fun to chat with\\r\\nyour friends while spectating!\\r\\n2. Optimized game experience and fixed bugs.\",\"releaseTimestamp\":\"2023-11-24T02:04:37Z\",\"versionDisplay\":\"1.1.9\"},{\"releaseDate\":\"2023-09-26\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\n1. More rewards have been added for watching ads. For example, you can get bingo Power-Ups, the free chance to undo and accelerate unlocking treasure chests. \\n2. The new game \\\"Guess Numbers\\\" has been added to the Chatroom. Now try it with your friends!\\n3. Optimized game experience and fixed bugs.\",\"releaseTimestamp\":\"2023-09-26T15:35:13Z\",\"versionDisplay\":\"1.1.8.1\"},{\"releaseDate\":\"2023-09-13\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\n1. More rewards have been added for watching ads. For example, you can get bingo Power-Ups, the free chance to undo and accelerate unlocking treasure chests. \\n2. The new game \\\"Guess Numbers\\\" has been added to the Chatroom. Now try it with your friends!\\n3. Optimized game experience and fixed bugs.\",\"releaseTimestamp\":\"2023-09-13T02:17:38Z\",\"versionDisplay\":\"1.1.8\"},{\"releaseDate\":\"2023-07-20\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1. Added \\\"Magic\\\" rule in the Parchis VIP room.\\n2. New \\\"Sound Wave Circle\\\" function in the Chatroom. \\n3. Optimized game experience and fixed bugs.\",\"releaseTimestamp\":\"2023-07-20T02:10:42Z\",\"versionDisplay\":\"1.1.7\"},{\"releaseDate\":\"2023-06-18\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseTimestamp\":\"2023-06-18T12:57:52Z\",\"versionDisplay\":\"1.1.6.2\"},{\"releaseDate\":\"2023-06-09\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseTimestamp\":\"2023-06-09T02:28:20Z\",\"versionDisplay\":\"1.1.6.1\"},{\"releaseDate\":\"2023-05-31\",\"releaseNotes\":\"1. Improved User Experience - Enhanced the sign-up rewards for new users. \\r\\n2. Free Benefits - This newly added component allows users to earn additional rewards by viewing advertisements. \\r\\n3. Member Club Rewards - Improved the reward structure for tasks within the Member Club.\",\"releaseTimestamp\":\"2023-05-31T02:00:14Z\",\"versionDisplay\":\"1.1.6\"},{\"releaseDate\":\"2023-03-30\",\"releaseNotes\":\"1.Piggy Bank – Play Parchis or Bingo to earn diamonds, which are stored in your Piggy Bank. When it's full, you can open it to collect all the diamonds!\\n2.Fragments Fusion Optimization - You can now use fragments of locked skins to fuse them together!\\n3.Truth or Dare - Join in on the fun with our new in-room gameplay: \\\"Truth or Dare.\\\" Experience it with your friends today!\",\"releaseTimestamp\":\"2023-03-30T07:00:59Z\",\"versionDisplay\":\"1.1.5\"},{\"releaseDate\":\"2023-02-08\",\"releaseNotes\":\"1.New Game Mode: Experience the excitement of the newly added game mode, Magic - it's more fun and fast-paced!\\n2.Skin Fragment Fusion: Get the chance to receive skin fragments when you use the ‘Fusion’ function!\\n3.New In-Room Feature: Enjoy the newly added Light Show Ranking in the chat rooms.\",\"releaseTimestamp\":\"2023-02-08T01:30:01Z\",\"versionDisplay\":\"1.1.4.1\"}],\"videoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"4d315d\",\"height\":1920,\"textColor1\":\"dfb8f0\",\"textColor2\":\"ab99e4\",\"textColor3\":\"c29dd2\",\"textColor4\":\"9884c9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo126/v4/da/fb/79/dafb79e4-4812-d15f-3f33-0e32d63e55d8/Job7fe8f74a-5fe9-4bdd-91ab-b5509ac196e5-152902508-PreviewImage_preview_image_nonvideo_sdr-Time1689580811587.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/00/11/a9/0011a9fd-a5d3-73a9-ea00-7244351655f8/P602517787_default.m3u8\"}]},\"websiteUrl\":\"https://www.yallaparchis.com/\"}},\"privacy\":{\"privacyTypes\":[{\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}],\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"privacyType\":\"Data Used to Track You\"},{\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}],\"description\":\"The following data may be collected and linked to your identity:\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"privacyType\":\"Data Linked to You\"},{\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}],\"description\":\"The following data may be collected but it is not linked to your identity:\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"privacyType\":\"Data Not Linked to You\"}]},\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 13.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"reviewsRestricted\":false,\"supportsArcade\":false,\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/yalla-parchis/id1542713951\",\"userRating\":{\"ariaLabelForRat