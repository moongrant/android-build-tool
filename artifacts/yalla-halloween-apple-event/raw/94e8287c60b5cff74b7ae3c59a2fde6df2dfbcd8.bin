wnload Now and Begin Your Journey to Fashion Royalty!\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"c89a6f\",\"height\":1080,\"textColor1\":\"0a0805\",\"textColor2\":\"191716\",\"textColor3\":\"30251a\",\"textColor4\":\"3c3127\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/3e/12/b2/3e12b2af-eb9f-d525-ef9f-fae9d3eefd96/94b01018-1435-40f9-a84c-4d164355c1d6.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/dd/2a/ac/dd2aac8d-541a-e063-b864-ca0c6d4d53c5/c43e2752-6af2-42e8-81ca-06fab657982a.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"32cbff\",\"height\":1080,\"textColor1\":\"020a0c\",\"textColor2\":\"051419\",\"textColor3\":\"0c303d\",\"textColor4\":\"0e3847\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/3f/1d/f4/3f1df490-0758-7373-f8a0-f1d7f4d2efef/05bb8930-f3bd-415c-991e-1de761c504d7.png/{w}x{h}{c}.{f}\",\"width\":1354},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/96/20/06/962006cc-fb81-f85e-4598-7d094a233d8c/134060f3-bfe0-45ad-b67c-d5b73181abaf.png/{w}x{h}{c}.{f}\",\"width\":1354},\"subscriptionHero\":{\"bgColor\":\"e4e0dc\",\"height\":1080,\"textColor1\":\"362121\",\"textColor2\":\"2c2623\",\"textColor3\":\"594746\",\"textColor4\":\"514b48\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/d3/df/7f/d3df7ff0-0140-c030-0d39-fb1a846dc4bd/36bd21d7-805e-457f-8e48-2c67cb840627.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"tagline\":\"Polish your look with every win\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isApple