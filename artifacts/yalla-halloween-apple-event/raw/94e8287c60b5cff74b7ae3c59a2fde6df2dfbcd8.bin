t\":2778,\"textColor1\":\"33281d\",\"textColor2\":\"372b25\",\"textColor3\":\"5b503e\",\"textColor4\":\"5e5345\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/4a/6e/41/4a6e41b5-030b-b2a5-6dcc-b94d134aa48c/en-5.jpg/{w}x{h}{c}.{f}\",\"width\":1284},{\"bgColor\":\"cde4fe\",\"height\":2778,\"textColor1\":\"1b2d36\",\"textColor2\":\"253241\",\"textColor3\":\"3e525e\",\"textColor4\":\"475666\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/e7/95/5c/e7955cac-d968-10f4-dfc9-1f5914197207/a00c086a-ef5e-4a33-9a7c-e34013d1cc15__U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"width\":1284},{\"bgColor\":\"ffd7d5\",\"height\":2778,\"textColor1\":\"0b0804\",\"textColor2\":\"3e1619\",\"textColor3\":\"3c312d\",\"textColor4\":\"643d3e\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/c7/b4/98/c7b4986b-1132-cff5-e2ca-a2a1370f3449/4b6ca097-e775-4316-af46-15afa7cec6aa_en-1.jpg/{w}x{h}{c}.{f}\",\"width\":1284},{\"bgColor\":\"e6eae8\",\"height\":2778,\"textColor1\":\"080910\",\"textColor2\":\"141629\",\"textColor3\":\"35363b\",\"textColor4\":\"3e404f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/79/af/ac/79afacf2-26bd-ede6-20de-61da49f80591/49983b1e-b7fb-453f-b586-46759093c5b6_en-3.jpg/{w}x{h}{c}.{f}\",\"width\":1284},{\"bgColor\":\"e1cdfd\",\"height\":2778,\"textColor1\":\"2a282b\",\"textColor2\":\"2e2827\",\"textColor3\":\"4e4955\",\"textColor4\":\"524951\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/7b/40/a3/7b40a3f0-ace8-ef9a-d9ea-7aaff511d5f1/7cfe4dea-b800-4097-b816-ec75e7a8c92d_en-5.jpg/{w}x{h}{c}.{f}\",\"width\":1284}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"Play, Chat, and Connect – All in One Place!\\nLooking for a fun, engaging way to play games and chat with friends? Yalla brings together casual games and voice chat rooms, creating an unmatched social experience. Whether you're a fan of classic games or love connecting with new people, we’ve got you covered!\\n\\nKey Features:\\nCasual Games to Enjoy Anytime\\n- Play popular games like Ludo, Carrom, UMO, and Baloot with friends or other players worldwide.\\n- Immerse yourself in friendly competitions, challenge players worldwide, and climb the leaderboards to prove your skills.\\n- Stay tuned—more exciting games are coming soon!\\n\\nVoice Chat Rooms\\n- Join voice chat rooms to talk, laugh, and make new friends. Thousands of voice chat rooms are waiting for you.\\n- Go on the mic, send messages in chat, or exchange virtual gifts to enhance the fun.\\n- Play mini-games directly in the room for a lively group experience.\\n\\n1-on-1 Private Chat\\n- Connect deeper with friends through private chat. Share messages, voice notes, and more in a personal space.\\n\\nPost and Share\\n- Share your thoughts, game achievements, or fun moments with the community posts feature. Let others know what you're up to!\\n\\nWhy Choose Our App?\\n- All-in-One Experience: Play games, chat, and socialize in one seamless app.\\n- Global Community: Meet and interact with people from around the world.\\n- Fun and Interactive: Voice chat, gifts, and games make every moment exciting.\\n\\nFollow us to get the latest news, updates and events:\\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\\nWebsite: www.yalla.live\\nDear YALLA users, your feedback and suggestions are welcome to: yallasupport@yalla.com\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"471b6e\",\"height\":1080,\"textColor1\":\"88dae9\",\"textColor2\":\"acc3e9\",\"textColor3\":\"7bb4d0\",\"textColor4\":\"97a1d1\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features211/v4/bf/98/3a/bf983a22-6eda-3f82-50f9-1d8756af9673/fa4af431-57dd-46cb-91a6-4fd6b66df0b8.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/28/59/ee/2859eebe-20ac-7814-ec46-0fce7ce3d567/12fc09db-ce0f-4c5f-a841-6866788e0179.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"b6030c\",\"height\":1080,\"textColor1\":\"febc00\",\"textColor2\":\"febc00\",\"textColor3\":\"f09702\",\"textColor4\":\"f09702\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9/df/22/b9df22e4-d410-273a-f990-87ef45dc326b/53b5c834-2546-4ab9-b26a-5c5126c6851e.png/{w}x{h}{c}.{f}\",\"width\":758},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"width\":758},\"subscriptionHero\":{\"bgColor\":\"1a174e\",\"height\":1080,\"textColor1\":\"d4b6c5\",\"textColor2\":\"dfa585\",\"textColor3\":\"a892ab\",\"textColor4\":\"b18579\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features113/v4/e2/15/c7/e215c777-1fd0-d096-9981-98caeadcbcdb/5748cf7d-7dd4-4c9e-8919-5c2a2ca5e4f1.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"tagline\":\"Chat with friends\"},\"externalVersionId\":878187179,\"hasFamilyShareableInAppPurchases\":false,\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasPrivacyPolicyText\":true,\"hasSafariExtension\":false,\"is32bitOnly\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isGameCenterEnabled\":false,\"isHiddenFromSpringboard\":false,\"isSiriSupported\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"languageList\":[\"English\",\"Arabic\",\"Hindi\",\"Indonesian\",\"Portuguese\",\"Spanish\",\"Turkish\",\"Urdu\"],\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumOSVersion\":\"13.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":289672192}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878187179\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":289672192}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878187179\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://apiv2.yalla.live/web/Agreement.html?type=2\",\"releaseDate\":\"2016-04-19\",\"requiredCapabilities\":\"arm64 \",\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"requirementsString\":\"Requires iOS 13.0 or later. Compatible with iPhone, iPad, and iPod touch.\",\"requires32bit\":false,\"requiresGameController\":false,\"seller\":\"Yalla Technology FZ-LLC\",\"subtitle\":\"Game Together, Chat Anytime\",\"supportURLForLanguage\":\"http://www.yalla.live\",\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"supportsGameController\":false,\"supportsPassbook\":false,\"versionHistory\":[{\"releaseDate\":\"2025-09-25\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-09-25T01:44:35Z\",\"versionDisplay\":\"3.0.4\"},{\"releaseDate\":\"2025-09-11\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-09-11T10:34:20Z\",\"versionDisplay\":\"3.0.3\"},{\"releaseDate\":\"2025-09-03\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-09-03T01:50:45Z\",\"versionDisplay\":\"3.0.2\"},{\"releaseDate\":\"2025-08-27\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-08-27T01:45:32Z\",\"versionDisplay\":\"3.0.1\"},{\"releaseDate\":\"2025-07-23\",\"releaseNotes\":\"1. تم إطلاق ألعاب جديدة رائعة، اجعل وقت فراغك أكثر تنوعًا ومتعة!\\r\\n2. أصبح من الأسهل الآن اختيار الغرف في بلدان مختلفة.\\n\\n1. New casual games are launched, enriching your entertainment time!\\r\\n2. It's more convenient to select rooms in different countries.\",\"releaseTimestamp\":\"2025-07-23T01:45:58Z\",\"versionDisplay\":\"3.0.0\"},{\"releaseDate\":\"2025-05-24\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-05-24T03:55:37Z\",\"versionDisplay\":\"2.31.3\"},{\"releaseDate\":\"2025-05-19\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-05-19T01:54:02Z\",\"versionDisplay\":\"2.31.2\"},{\"releaseDate\":\"2025-04-16\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-04-16T01:52:57Z\",\"versionDisplay\":\"2.31.1\"},{\"releaseDate\":\"2025-03-26\",\"releaseNotes\":\"1. تم تحسين صفحة الغرف.\\r\\n2. يمكن لمستخدمي VIP تخصيص أيديات خاصة بهم.\\r\\n3. تحسينات أخرى.\\n\\n1. Room page has been optimized.\\r\\n2. VIP users can customize their own IDs.\\r\\n3. Other improvements.\",\"releaseTimestamp\":\"2025-03-26T01:52:43Z\",\"versionDisplay\":\"2.31.0\"},{\"releaseDate\":\"2025-02-23\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-02-23T06:09:58Z\",\"versionDisplay\":\"2.30.1\"},{\"releaseDate\":\"2025-02-05\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2025-02-05T08:26:33Z\",\"versionDisplay\":\"2.30.0\"},{\"releaseDate\":\"2025-01-08\",\"releaseNotes\":\"1. التسجيل عبر البريد الإلكتروني وتسجيل الدخول متاح الآن.\\n2. تمت إضافة منشور الشرف عند ترقية الـ VIP والحفاظ على المستوى.\\n3. تحسينات أخرى.\\n\\n1. Registration and login via email are supported now.\\n2. Added VIP upgrade and maintenance honor post.\\n3. Other improvements.\",\"releaseTimestamp\":\"2025-01-08T01:45:17Z\",\"versionDisplay\":\"2.29.2\"},{\"releaseDate\":\"2024-12-09\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-12-09T01:47:23Z\",\"versionDisplay\":\"2.29.1\"},{\"releaseDate\":\"2024-11-27\",\"releaseNotes\":\"1. تمت إضافة ميزة موضوع المايك - زين غرفتك بموضوعات مايك مختلفة.\\r\\n2. تحسين وتطوير برنامج VIP - رسوم متحركة حصرية للمايك وموضوع المايك لجميع مستخدمي VIP، وخفض متطلبات VIP9 - VIP4، وإجراء تغيير مهم: لن يتم إعادة تعيين نقاط VIP إلى 0 بعد ترقية مستوى VIP.\\r\\n3. تحسينات أخرى.\\n\\n1. Added Mic Theme feature - Decorate your room with different mic themes. \\r\\n2. Improved VIP program - Exclusive mic animation and mic theme for all VIP users, lowered VIP 4 - VIP 9 requirements, and an important change: VIP points won't be reset to 0 after a VIP level upgrade. \\r\\n3. Other improvements.\",\"releaseTimestamp\":\"2024-11-27T01:54:10Z\",\"versionDisplay\":\"2.29.0\"},{\"releaseDate\":\"2024-09-27\",\"releaseNotes\":\"1. البطاقة الشهرية - قم بشرائها لتحصل على المزيد من القطع الذهبية بتكلفة أقل.\\r\\n2. مكافآت استدعاء الأصدقاء - قم بدعوة أصدقائك للعودة إلى يلا للحصول على مكافآت مختلفة.\\r\\n3. تحسينات أخرى.\\n\\n1. Month Card - Buy it to get more golds with less money.\\r\\n2. Recall Friends Rewards - Invite your friends to return to Yalla to get various rewards.\\r\\n3. Other improvements.\",\"releaseTimestamp\":\"2024-09-27T15:19:38Z\",\"versionDisplay\":\"2.28.0\"},{\"releaseDate\":\"2024-07-29\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-07-29T01:36:13Z\",\"versionDisplay\":\"2.27.1\"},{\"releaseDate\":\"2024-06-28\",\"releaseNotes\":\"1. تم إطلاق قاعة معرض الهدايا. قم بإضاءة هدايا المعرض لفتح شارات المعرض.\\r\\n2. تمت إضافة أخبار المنصة لعرض الأحداث المهمة في الوقت الفعلي مثل إرسال هدايا المنصة، وترقية مستوى VIP، وما إلى ذلك.\\r\\n3. تحسينات أخرى.\\n\\n1. Gift Exhibition Hall is launched. Light up exhibition gifts to unlock exhibition badges.\\r\\n2. Added platform news to display important real-time events like sending platform gifts, upgrading VIP level, etc.\\r\\n3. Other improvements.\",\"releaseTimestamp\":\"2024-06-28T01:50:28Z\",\"versionDisplay\":\"2.27.0\"},{\"releaseDate\":\"2024-06-06\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-06-06T01:47:13Z\",\"versionDisplay\":\"2.26.2\"},{\"releaseDate\":\"2024-05-08\",\"releaseNotes\":\"1. يمكنك إرسال الهدايا لجميع أعضاء الفريق في وقت واحد في لعبة كرة القدم المجنونة.\\n2. تحسينات أخرى\\n\\n1. You can give gifts to all team members at once in the Crazy Football game.\\n2. Other improvements\",\"releaseTimestamp\":\"2024-05-08T01:59:23Z\",\"versionDisplay\":\"2.26.1\"},{\"releaseDate\":\"2024-04-11\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-04-11T01:56:32Z\",\"versionDisplay\":\"2.26.0\"},{\"releaseDate\":\"2024-02-06\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-02-06T01:47:59Z\",\"versionDisplay\":\"2.25.0\"},{\"releaseDate\":\"2024-01-24\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-01-24T01:47:39Z\",\"versionDisplay\":\"2.24.1\"},{\"releaseDate\":\"2024-01-03\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2024-01-03T01:50:11Z\",\"versionDisplay\":\"2.24.0\"},{\"releaseDate\":\"2023-12-24\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2023-12-24T01:44:57Z\",\"versionDisplay\":\"2.23.7\"},{\"releaseDate\":\"2023-12-22\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseTimestamp\":\"2023-12-22T01:32:44Z\",\"versionDisplay\":\"2.23.6\"}],\"videoPreviewsByType\":{},\"websiteUrl\":\"http://www.yalla.live\"}},\"privacy\":{\"privacyTypes\":[{\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}],\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"privacyType\":\"Data Used to Track You\"},{\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory