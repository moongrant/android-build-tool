om/image/thumb/PurpleSource211/v4/a7/fd/71/a7fd7150-956f-701d-b99e-2e2ff1566ee0/_U52a8_U6001_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1a0034\",\"height\":2688,\"textColor1\":\"d5fcf2\",\"textColor2\":\"b4fde5\",\"textColor3\":\"b0c9cc\",\"textColor4\":\"95cac2\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/32/33/95/32339529-f466-0c53-e8c8-363bf77d8e8f/1242x2688P3.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"d4faef\",\"height\":2688,\"textColor1\":\"332c29\",\"textColor2\":\"3e3229\",\"textColor3\":\"535551\",\"textColor4\":\"5c5a51\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/f1/0d/b1/f10db13b-6b19-2b65-d512-45004ed9921a/1242x2688P4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"d4faef\",\"height\":2688,\"textColor1\":\"21180d\",\"textColor2\":\"2e2214\",\"textColor3\":\"45453a\",\"textColor4\":\"4f4d40\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/34/3e/ae/343eae9a-2aa9-42d0-b3e8-cccebdd3e069/1242x2688P5.png/{w}x{h}{c}.{f}\",\"width\":1242}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"hawa, come for love, meet by sound\\n\\nHawa offers a social space that focuses on sound, where you can not only get rid of the social pressure in reality, but also quickly meet new friends from various regions in the Middle East. Without social labels, use voice and thought to collide with strange souls to obtain purer friendship or love.\\n\\nIn Hawa, explore new worlds, explore love.\\n\\n【Make new friend】\\nCome to hawa to explore different themed voice rooms, use your voice to show your talent and personality, and meet people who understand you anytime, anywhere!\\n\\nNo need to show your face without social pressure, express yourself as much as you want and talk about topics you are interested in, such as food, sports events, fashion trends, etc. A variety of themes to meet all your preferences!\\n\\n【Fun Game】\\nHost an online party with new friends from all over the Middle East, and a large number of trendy room games will help you quickly break the ice and become the most popular party king!\\n\\n【special gift】\\nHawa, you can get customized gifts, luxury cars and gorgeous headwear. Come and light up your unique gift catalogue!\\n\\n【Ranking】\\nExclusive medals and privileges to show your status and position.\\n\\nMusic\\nListen to your favorite keep up with the world music trends. Share your song list, show your voice live!, this is your exclusive music party.\"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/28/59/ee/2859eebe-20ac-7814-ec46-0fce7ce3d567/12fc09db-ce0f-4c5f-a841-6866788e0179.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"b6030c\",\"height\":1080,\"textColor1\":\"febc00\",\"textColor2\":\"febc00\",\"textColor3\":\"f09702\",\"textColor4\":\"f09702\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9/df/22/b9df22e4-d410-273a-f990-87ef45dc326b/53b5c834-2546-4ab9-b26a-5c5126c6851e.png/{w}x{h}{c}.{f}\",\"width\":758},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"width\":758}},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":false,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":305836032}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1519557264\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878957403\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":305836032}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1519557264\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878957403\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://www.hawatalk.com/front/agreement/agreementen.html\",\"releaseDate\":\"2020-09-28\",\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Live,Voice,Group Chat Room\",\"supportURLForLanguage\":\"http://www.hawatalk.com\",\"versionHistory\":[{\"releaseDate\":\"2025-10-17\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseTimestamp\":\"2025-10-17T02:01:31Z\",\"versionDisplay\":\"2.5.5\"},{\"releaseDate\":\"2025-10-12\",\"releaseNotes\":\"The latest version of Hawa is here!\\nThis update: Solves some experience issues and provides a smoother room chat experience.\\nIn order to provide a better experience, Hawa will be updated regularly in the App Store, and we recommend that you turn on automatic updates in your Settings to ensure a better Hawa experience for the first time.\",\"releaseTimestamp\":\"2025-10-12T06:08:02Z\",\"versionDisplay\":\"2.5.2\"},{\"releaseDate\":\"2025-10-07\",\"releaseNotes\":\"The lat