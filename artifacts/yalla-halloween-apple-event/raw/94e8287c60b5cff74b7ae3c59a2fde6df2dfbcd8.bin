b0\",\"height\":2208,\"textColor1\":\"ffffff\",\"textColor2\":\"00caf7\",\"textColor3\":\"cfddef\",\"textColor4\":\"04b3e9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/88/15/7e/88157eea-f088-8c8a-8070-327ea7e9edac/67798e30-b15d-43de-9e13-38430232d426__U76ae_U80a4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"135ab0\",\"height\":2208,\"textColor1\":\"ffffff\",\"textColor2\":\"00caf7\",\"textColor3\":\"cfddef\",\"textColor4\":\"04b3e9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/9b/ba/d6/9bbad6a2-602e-144b-8cdc-96582ab94b08/95ac59dd-7a04-414c-aa24-83cc6d691b86__U9526_U6807_U8d5b.png/{w}x{h}{c}.{f}\",\"width\":1242}],\"iphone_d74\":[{\"bgColor\":\"6996f5\",\"height\":2796,\"textColor1\":\"090909\",\"textColor2\":\"24162b\",\"textColor3\":\"1d2538\",\"textColor4\":\"323053\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/7b/fd/11/7bfd11cf-7040-2cf7-15d8-9934605cea46/4e1a620d-4f21-4ae2-98f7-c69311e87876__U8bed_U97f3.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"00c3f1\",\"height\":2796,\"textColor1\":\"0b202b\",\"textColor2\":\"0b281f\",\"textColor3\":\"084153\",\"textColor4\":\"084749\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/9b/be/fd/9bbefd4b-789a-c565-18b9-810b5c503ae7/1290X2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"005598\",\"height\":2796,\"textColor1\":\"f4fcff\",\"textColor2\":\"84c0fd\",\"textColor3\":\"c3daea\",\"textColor4\":\"69abe8\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/6b/2a/d5/6b2ad533-87b9-cf3f-11dc-8db5e86b41f9/6e08eb2a-48a6-4966-82eb-4241d036a292__U591a_U7c73_U8bfa.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"6996f5\",\"height\":2796,\"textColor1\":\"090909\",\"textColor2\":\"0b222d\",\"textColor3\":\"1d2538\",\"textColor4\":\"1e3955\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/01/8a/6c/018a6c56-ed97-eebc-5fc9-43e3be9f51c9/d50cdde8-e4b4-475f-b86a-c906b806ae35__U5176_U4ed6_U6a21_U5f0f.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"005598\",\"height\":2796,\"textColor1\":\"f4fcff\",\"textColor2\":\"00c9f8\",\"textColor3\":\"c3daea\",\"textColor4\":\"00b2e5\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/65/3b/19/653b1977-c1bc-6e34-ff1b-070d6a99d698/2dfbc703-b563-4b06-81f7-a1b6eef4b146__U804a_U5929_U5ba4.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"6996f5\",\"height\":2796,\"textColor1\":\"090909\",\"textColor2\":\"1c1a33\",\"textColor3\":\"1d2538\",\"textColor4\":\"2c335a\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/1b/5f/2e/1b5f2e14-6e29-df47-db8e-6972adb73f5a/151288be-3458-4363-80e3-62064a0c4ff9__U597d_U53cb.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"005598\",\"height\":2796,\"textColor1\":\"f4fcff\",\"textColor2\":\"a0ddfd\",\"textColor3\":\"c3daea\",\"textColor4\":\"80c2e9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/4d/64/d2/4d64d276-23a4-d82a-7779-799e4039f49a/fee07898-d8c9-4550-9008-d351eca194dc__U76ae_U80a4.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"6996f5\",\"height\":2796,\"textColor1\":\"090909\",\"textColor2\":\"161935\",\"textColor3\":\"1d2538\",\"textColor4\":\"26325b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/ee/fb/7a/eefb7a0f-5611-a3ef-92e1-7dd29e889242/a8b67e19-ecb1-48c1-9d73-cdfaae8d9c62__U9526_U6807_U8d5b.png/{w}x{h}{c}.{f}\",\"width\":1290}]},\"customVideoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"f5f5f5\",\"height\":1920,\"textColor1\":\"4b1111\",\"textColor2\":\"641214\",\"textColor3\":\"6d3e3e\",\"textColor4\":\"813f41\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo221/v4/eb/85/3c/eb853ca7-1feb-b723-94ea-fe1ddaf0c9ce/Job951f96e5-ca3c-460e-831d-32071ff31ede-198746922-PreviewImage_Preview_Image_Intermediate_nonvideo_389040169_2270742685-Time1753795238200.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo211/v4/d8/76/73/d87673a6-84c8-50e0-9734-de51952895f6/P1159965934_default.m3u8\"}],\"iphone_d74\":[{\"previewFrame\":{\"bgColor\":\"f9fbfc\",\"height\":1920,\"textColor1\":\"4a1616\",\"textColor2\":\"5f1719\",\"textColor3\":\"6d4344\",\"textColor4\":\"7e4546\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo211/v4/da/f8/7f/daf87f81-b9a4-bdc0-c22d-67dad598e3f6/Job33e97c80-f627-4f4a-835e-6e413d09d050-198747139-PreviewImage_Preview_Image_Intermediate_nonvideo_389030263_2270672900-Time1753795358608.png/{w}x{h}{c}.{f}\",\"width\":886},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo211/v4/27/39/af/2739af93-058d-b4b7-3598-a49e8e042dd8/P1159938622_default.m3u8\"}]}}}},\"description\":{\"standard\":\"Yalla Ludo is a vibrant app that fuses classic board games—Ludo, Jackaroo, and Domino—with real-time voice chat! Whether you're in the mood for gameplay or hoping to connect with new friends in a lively voice chat room, Yalla Ludo delivers a truly immersive experience.\\n\\n[Voice Chat with Friends]\\nEnjoy real-time voice chat that lets you share tips and tricks with fellow gamers anytime, anywhere. Make new friends while having fun! Add personality to your gameplay with expressive voice chat.\\n\\n[Various Game Modes]\\nLudo: Choose between 2\u00264 Players mode and Team mode. Each mode has 4 gameplays: Classic, Master, Quick, and Arrow. You can also use Magic tools to make the game more fun! \\nDomino: Play in 2\u00264 Players mode, each featuring two gameplays: Draw Game and All Five.\\nOthers: More new games are waiting for you.\\n\\n[Brand New Jackaroo]\\nGet ready for fast-paced Jackaroo gameplay! Pick from a variety of game modes (Basic, Complex, and Quick), and team up with friends to claim victory. Make your moves even more fun by expressing yourself with lively game stickers!\\n\\n[Voice Chat Room]\\nJoin the global public chat room, where you can connect with people from all over the world. Chat freely, share ideas, and send cute gifts! Broaden your network of friends and enjoy a relaxing time.\\n\\n[Generous Rewards Await You]\\nYalla Ludo offers multiple daily activities. Complete game or chat room tasks to earn various rewards (such as golds, diamonds, skin fragments, and gifts, etc). With daily tasks and arrival chests, you'll always find something exciting!\\n\\nYalla Ludo connects you with others, so let's enjoy the joyful moments in Yalla Ludo!\\n\\nSubscribe to Yalla Ludo VIP to enjoy the extra advanced features:\\nCollect free daily golds, diamonds, and VIP daily benefits.\\nPrivileged game room: create your room in the VIP room, invite others to play together, and have more options for bets.\\n-----------------------------------\\nIf you choose to subscribe to Yalla Ludo VIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nLudo VIP includes two types: Knight and Baron. The price for Knight is USD 11.99/month and the price for Baron is USD 39.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo without becoming a Yalla Ludo VIP.\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\nPrivacy Policy: https://www.yallaludo.com/term/EN/TermOfService.html\\nTerms of Service: https://www.yallaludo.com/term/EN/TermOfService.html#TermsOfService\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"c28066\",\"height\":1080,\"textColor1\":\"0b0704\",\"textColor2\":\"101414\",\"textColor3\":\"301f17\",\"textColor4\":\"342925\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/d3/4e/ca/d34ecacb-4231-c606-bd0d-daeb838d53c3/afe0512f-cea2-4cae-ae0b-a70b5d834ec6.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/31/ed/0b/31ed0bc0-e686-add2-cce7-3fda494d0984/51883c2e-f530-4ea9-81da-8cd5059fe433.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"565b60\",\"height\":1080,\"textColor1\":\"f6f6f7\",\"textColor2\":\"eeeeef\",\"textColor3\":\"d6d7d8\",\"textColor4\":\"cfd1d2\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/65/41/e7/6541e712-8b83-d508-d7d9-d3aa0e1a1587/48ea4906-d589-4a63-bd8f-303e0ab31b62.png/{w}x{h}{c}.{f}\",\"width\":752},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/3b/4c/3a/3b4c3a0e-ef75-c62a-4d37-fef9fb40d32a/348534c3-7a59-4176-bc29-dad788ebade7.png/{w}x{h}{c}.{f}\",\"width\":752},\"subscriptionHero\":{\"bgColor\":\"543976\",\"height\":1080,\"textColor1\":\"f4d5f1\",\"textColor2\":\"fab4f3\",\"textColor3\":\"d4b6d8\",\"textColor4\":\"d89bda\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features221/v4/eb/1f/3d/eb1f3d07-a2ff-1d96-8702-cf41e58e1501/ac3c6d00-a08a-49eb-947c-2c7e01373041.png/{w}x{h}{c}.{f}\",\"width\":4320},\"universalAStatic16x9\":{\"bgColor\":\"45388f\",\"height\":2950,\"textColor1\":\"f7baf5\",\"textColor2\":\"e2acd5\",\"textColor3\":\"d4a0e1\",\"textColor4\":\"c395c7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features221/v4/bb/b1/63/bbb16391-fd79-80fc-67f4-998d9d507083/fde798c5-f81f-4ca1-aa14-9c3720980d76.png/{w}x{h}{c}.{f}\",\"width\":5244}},\"editorialNotes\":{\"short\":\"Every day brings new rewards, just complete your tasks.\",\"tagline\":\"It's in the Cards\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"13.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":367931392}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878451230\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":367931392}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878451230\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://www.yallaludo.com/term/EN/TermOfService.html#TermsOfService\",\"releaseDate\":\"2018-09-27\",\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Game On, Chat On!\",\"supportURLForLanguage\":\"https://www.yallaludo.com/\",\"versionHistory\":[{\"releaseDate\":\"2025-10-14\",\"releaseNotes\":\"Updates:\\n1. Added a Gallery exclusively for Royal users. Upgrade to Royal Level 2 to instantly enjoy your personal Gallery privilege and showcase your charm and style!\\n2. Lucky draw coming soon to the Fortune Store! Limited skins, exclusive gifts, and more prizes are waiting for you! \\n3. Quick recharge is available in the chatroom. If you run out of gold or diamonds while chatting in the room, you can now recharge instantly without leaving the room!\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-10-14T07:52:27Z\",\"versionDisplay\":\"1.4.6.0\"},{\"releaseDate\":\"2025-09-10\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2025-09-10T02:05:23Z\",\"versionDisplay\":\"1.4.5.1\"},{\"releaseDate\":\"2025-09-03\",\"releaseNotes\":\"Updates:\\r\\n1. New 1 VS 1 Mode in Jackaroo — Play a two-player battle! Trigger key game actions to earn bonus cards. Come and try it now!\\r\\n2. New Royal Profile Page — Equip your exclusive Royal profile page skin to show off your unique style!\\r\\n3. All Games in \\\"Others\\\" Now Unlocked — Enjoy a variety of modes: Jungle Ludo, Night Ludo, and Fight Ludo. Pick your favorite and start playing!\\r\\n4. Added \\\"You Say, I Guess\\\" in the Chat Room — Choose a word you like, and describe it out loud. Let others guess what it is. Give it a try—don't forget to include key hints in your description!\\r\\n5. Added Club Tier in the Chat Room — Participate in room activities and interact more. Every little effort will help you level up your Club.\\r\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-09-03T02:15:54Z\",\"versionDisplay\":\"1.4.5.0\"},{\"releaseDate\":\"2025-08-19\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2025-08-19T07:53:18Z\",\"versionDisplay\":\"1.4.4.1\"},{\"releaseDate\":\"2025-07-30\",\"releaseNotes\":\"Updates:\\n1.  New Quick Gameplay in Jackaroo Complex – Win by moving just two stones to the end! Team up with your friends for fast-paced, thrilling gameplay now!\\n2.  Dice Exhibition Now Available – Go to your profile page to set your favorite dice and showcase your unique style!\\n3.  New \\\"Buy the Same Skin\\\" Feature – Have you ever admired someone else's cool skin? Now you can buy the same one in-game!\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-07-30T02:13:56Z\",\"versionDisplay\":\"1.4.4.0\"},{\"releaseDate\":\"2025-07-16\",\"releaseNotes\":\"Updates:\\n1. Game experience optimization and bug fixes.\\n \\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-07-16T12:09:18Z\",\"versionDisplay\":\"1.4.3.1\"},{\"releaseDate\":\"2025-06-09\",\"releaseNotes\":\"Updates:\\n1. A new game - Jackaroo is now live! Team up with friends \u0026 race to victory! It's all about smart moves and seamless cooperation with friends via real-time chat!\\n2. Added daily limited gifts in the chat room. Check out the Daily Limited Shop to discover new exclusive gifts refreshed daily. Buy something cool before they're gone!\\n3. New mini-games are available! Tic Tac Toe and Football games just dropped in Fun Center! Challenge your buddies to a quick match in your room. \\n\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-06-09T10:06:13Z\",\"versionDisplay\":\"1.4.3.0\"},{\"releaseDate\":\"2025-02-18\",\"releaseNotes\":\"Updates:\\r\\n1.Ramadan is coming, and with it comes an exclusive Ramadan-themed app icon and splash screen. Stay tuned for our Ramadan activities!\\r\\n2.Bug fixed\\r\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2025-02-18T10:00:24Z\",\"versionDisplay\":\"1.4.2.3\"},{\"releaseDate\":\"2025-01-23\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2025-01-23T01:59:00Z\",\"versionDisplay\":\"1.4.2.2\"},{\"releaseDate\":\"2024-12-23\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2024-12-23T01:51:50Z\",\"versionDisplay\":\"1.4.2.1\"},{\"releaseDate\":\"2024-12-05\",\"releaseNotes\":\"Updates:\\r\\n1.New Royal Privileges: You can customize the room theme. Moreover, you can also set the room theme image you uploaded as the background for private chats. Go try it out now~\\r\\n2.Brand new items: Room entry effects. Use them to match your vehicles and become a superstar in the room.\\r\\n3.New ranking - Room Likes Ranking List is here! Give Likes to your favorite rooms and help them get on the list.\\r\\n \\r\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2024-12-05T08:52:18Z\",\"versionDisplay\":\"1.4.2\"},{\"releaseDate\":\"2024-09-16\",\"releaseNotes\":\"Updates:\\n1. Royal 5 Super Privileges are coming: Exclusive skins, vehicles, profile cards, and other privileges!\\n2. Sign-in benefits: The higher your level, the more sign-in rewards you can collect daily.\\n3. Feed list for chat rooms is coming soon.\\n4. Fixed the issue of being unable to log in to the game with X account and optimized the gaming experience. \\n\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2024-09-16T00:01:14Z\",\"versionDisplay\":\"1.4.1\"},{\"releaseDate\":\"2024-07-17\",\"releaseNotes\":\"Updates:\\n1. Great news! The Royal Level has been upgraded to include Holiday Surprises and the Fortune Store. Claim holiday rewards and redeem exclusive skins and items with Fortune Coins.\\n2. Skin Fragments Exchange: Now you can exchange your excess skin fragments for higher-tier skins or golds.\\n3. Room Battle mode is coming soon: Join your preferred team within rooms. Try to win more battle points to earn glory.\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2024-07-17T08:00:43Z\",\"versionDisplay\":\"1.4.0\"},{\"releaseDate\":\"2024-06-18\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2024-06-18T06:02:54Z\",\"versionDisplay\":\"1.3.9.5\"},{\"releaseDate\":\"2024-05-28\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2024-05-28T10:06:58Z\",\"versionDisplay\":\"1.3.9.4\"},{\"releaseDate\":\"2024-05-09\",\"releaseNotes\":\"Updates:\\r\\n1.Great news! Unique IDs now include new animation effects and extra 8-digit IDs. You can purchase and switch Unique IDs more easily. \\r\\n2.Color-customized gifts are now available. You can customize the gift color to your liking!\\r\\n3. Mic numbers have increased. A mode with 15 microphones is now available. Invite more friends on the mic to chat and enjoy more fun!\\r\\nThere's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2024-05-09T02:34:28Z\",\"versionDisplay\":\"1.3.9.3\"},{\"releaseDate\":\"2024-03-07\",\"releaseNotes\":\"Updates:\\r\\n1. Get ready for Jungle Ludo! The jungle is packed with secrets and spectacular items. Warriors, gear up for some adventures!\\r\\n \\r\\n2. Double-tap to like a Chat Room! Want to show some love? Just double-tap on an empty spot in the room. The more taps, the bigger the combo effects. Help your favorite rooms shine!\\r\\n \\r\\n3. Introducing Crocodile Dentist, a new mini-game, in chat rooms! Gather your friends for a game, take turns, and see who’s daring enough to face the bite. Who will it be?\\r\\n \\r\\nRamadan's Coming! We've got lots of new stuff for you to check out and enjoy. Stay tuned!\",\"releaseTimestamp\":\"2024-03-07T01:59:54Z\",\"versionDisplay\":\"1.3.9.2\"},{\"releaseDate\":\"2024-01-18\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2024-01-18T06:43:30Z\",\"versionDisplay\":\"1.3.9.1\"},{\"releaseDate\":\"2023-12-26\",\"releaseNotes\":\"Updates:\\r\\n1. Introducing a brand-new profile page! Decorate your profile page with ornaments, profile themes, and profile cards to express your personality. Explore additional details such as game records, gift walls, and badges when you visit your profile page.\\r\\n\\r\\n2. Visit the Rank list to view the Achievement badge wall. Check out the rankings and see who's on top.\\r\\n\\r\\n3. We've added Gift Scoring to the chat room! Earn points by receiving gifts while on the mic. Come and give it a try!\\r\\n\\r\\nThe 5th anniversary is approaching! Take a look at our new logo, launch page, and background image. Join us for our anniversary celebration. There's more content for you to explore and enjoy!\",\"releaseTimestamp\":\"2023-12-26T00:35:11Z\",\"versionDisplay\":\"1.3.9.0\"},{\"releaseDate\":\"2023-11-16\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2023-11-16T07:15:51Z\",\"versionDisplay\":\"1.3.8.2\"},{\"releaseDate\":\"2023-10-20\",\"releaseNotes\":\"Updates:\\r\\n1. Fixed X login issues and game experience optimization.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2023-10-20T00:59:47Z\",\"versionDisplay\":\"1.3.8.1\"},{\"releaseDate\":\"2023-09-25\",\"releaseNotes\":\"Updates:\\n1. Generous Login Rewards: Log in monthly for profile frames and collect 12 months to unlock a bonus permanent limited profile frame.\\n2. Room Activity Notice: Create notices for activities and invite others to join your party.\\n3. Personalized Playlists: Take control of your music with our playlist management feature. Organize your favorite songs effortlessly.\\nExplore more updates in Yalla Ludo!\",\"releaseTimestamp\":\"2023-09-25T02:51:33Z\",\"versionDisplay\":\"1.3.8.0\"},{\"releaseDate\":\"2023-07-20\",\"releaseNotes\":\"Updates:\\n1. Fight Ludo - Kill the maximum tokens within a specific time limit and emerge as the champion!\\n2. Happy Birthday - Set your birthday, and come to Yalla Ludo on your birthday to collect gifts and throw joyous parties in the room! \\n3. Room Pass - Engage with your friends in the room for a chance to win special rewards! (Refreshed every 14 days)\",\"releaseTimestamp\":\"2023-07-20T02:31:32Z\",\"versionDisplay\":\"1.3.7.0\"},{\"releaseDate\":\"2023-05-16\",\"releaseNotes\":\"Updates:\\r\\n1. Elite Rewards Tower - Unlock the Elite Reward Tower to receive even more rewards!\\r\\n2. New Stickers - Utilize stickers in games, private conversations, and chat rooms!\\r\\n3. Personalized Gifts - Send gifts that feature recipients' profile pictures to show your appreciation!\",\"releaseTimestamp\":\"2023-05-16T01:33:00Z\",\"versionDisplay\":\"1.3.6.0\"},{\"releaseDate\":\"2023-03-29\",\"releaseNotes\":\"Bug fixed\",\"releaseTimestamp\":\"2023-03-29T10:38:09Z\",\"versionDisplay\":\"1.3.5.1\"}],\"videoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"f5f5f5\",\"height\":1920,\"textColor1\":\"4b1111\",\"textColor2\":\"641214\",\"textColor3\":\"6d3e3e\",\"textColor4\":\"813f41\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo221/v4/eb/85/3c/eb853ca7-1feb-b723-94ea-fe1ddaf0c9ce/Job951f96e5-ca3c-460e-831d-32071ff31ede-198746922-PreviewImage_Preview_Image_Intermediate_nonvideo_389040169_2270742685-Time1753795238200.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo211/v4/d8/76/73/d87673a6-84c8-50e0-9734-de51952895f6/P1159965934_default.m3u8\"}],\"iphone_d74\":[{\"previewFrame\":{\"bgColor\":\"f9fbfc\",\"height\":1920,\"textColor1\":\"4a1616\",\"textColor2\":\"5f1719\",\"textColor3\":\"6d4344\",\"textColor4\":\"7e4546\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo211/v4/da/f8/7f/daf87f81-b9a4-bdc0-c22d-67dad598e3f6/Job33e97c80-f627-4f4a-835e-6e413d09d050-198747139-PreviewImage_Preview_Image_Intermediate_nonvideo_389030263_2270672900-Time1753795358608.png/{w}x{h}{c}.{f}\",\"width\":886},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo211/v4/27/39/af/2739af93-058d-b4b7-3598-a49e8e042dd8/P1159938622_default.m3u8\"}]},\"websiteUrl\":\"https://www.yallaludo.com/\"}},\"privacy\":{\"privacyTypes\":[{\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}],\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"privacyType\":\"Data Used to Track You\"},{\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTEN