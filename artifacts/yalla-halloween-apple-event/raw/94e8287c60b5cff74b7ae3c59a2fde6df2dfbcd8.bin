/ef/9d22efce-f6a9-cd4c-5882-725d21d9bfbb/bb374a9c-aca3-4423-bb4b-32b6607461c3_5.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"03516f\",\"height\":2688,\"textColor1\":\"ffffff\",\"textColor2\":\"e3ecf2\",\"textColor3\":\"ccdce2\",\"textColor4\":\"b6cdd8\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/b4/40/b2/b440b2e4-2f03-e1a2-e8f5-9723b69674d5/74968ce2-075a-4521-816d-b85033f48021_4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"076290\",\"height\":2688,\"textColor1\":\"ffffff\",\"textColor2\":\"13e7f4\",\"textColor3\":\"cddfe8\",\"textColor4\":\"10cce0\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/ce/ec/26/ceec262d-b377-4ba6-6156-621d775c0bf2/fdb808a1-c9e7-47ef-ba00-e6fdfa9fb757_6.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"035070\",\"height\":2688,\"textColor1\":\"fbe368\",\"textColor2\":\"f6d31d\",\"textColor3\":\"cac66a\",\"textColor4\":\"c5b92d\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/2e/d9/e1/2ed9e1da-2e05-5ffc-db30-01a63d08cf48/6dbfc516-0c5b-4a96-b3d2-9ccf26497014_2.png/{w}x{h}{c}.{f}\",\"width\":1242}],\"iphone_d74\":[{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/2a/9d/99/2a9d99d6-9dc8-8a89-03c1-fd084744e2e3/0x0ss_U00285_U0029.png/{w}x{h}{c}.{f}\",\"width\":1320},{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/86/37/79/8637796f-132f-5918-cf02-8385c1c85aab/0x0ss.png/{w}x{h}{c}.{f}\",\"width\":1320},{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/fe/88/57/fe8857c6-a0f9-bf97-2a2e-cc5e6eb604eb/0x0ss_U00281_U0029.png/{w}x{h}{c}.{f}\",\"width\":1320},{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/75/86/d3/7586d390-d91b-69b1-92ce-0ffa973026e3/0x0ss_U00282_U0029.png/{w}x{h}{c}.{f}\",\"width\":1320},{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/4a/9e/d2/4a9ed2c7-c09e-5177-04fe-37f07f7b7f3d/0x0ss_U00283_U0029.png/{w}x{h}{c}.{f}\",\"width\":1320},{\"height\":2868,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/ac/53/bb/ac53bb5e-b8ac-d528-9bc2-e3642380e574/0x0ss_U00284_U0029.png/{w}x{h}{c}.{f}\",\"width\":1320}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"Yalla Ludo HD, an app with voice chat, is specially designed for iPad. It enables players to enjoy smooth game experience and fancy game graphics.\\n\\nReal-time voice chat\\nTalk with players via voice chat at any time, meet new friends and enjoy the game!\\n\\nGreat game experience\\nHigh-quality visuals and delicate UI design. Besides, you may have a better experience on the Pad.\\n\\nPlay with friends easily\\nLocal rooms enable you to play with buddies offline. Come and have fun in games together！\\n\\nMore game bonus? Find them in Yalla Ludo VIP\\nSubscribe to Yalla Ludo HD VIP to enjoy the extra advanced features:\\nCollect free daily coins, diamonds and VIP chests.\\nPrivileged game room: create your  room in the VIP room, invite others to play together and more options for bets.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Ludo HD VIP, the purchase will be billed to your iTunes account. \\nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nCurrent Yalla Ludo HD VIP subscription price starts at 11.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice. \\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo HD without becoming a Yalla Ludo HD VIP.\\n\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\n\\nPrivacy Policy：https://www.fyxtechhk.com/term/EN/TermOfService.html\\n\\nTerms of Service：https://www.fyxtechhk.com/term/EN/TermOfService.html#TermsOfService\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"2e575c\",\"height\":1080,\"textColor1\":\"e3f3fc\",\"textColor2\":\"fbe9be\",\"textColor3\":\"bad1d9\",\"textColor4\":\"cccaa9\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/da/b2/1e/dab21e51-3741-91b3-0a6e-6fc28c4451a0/6ef6f085-da99-4007-a40d-cacde335995a.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/31/ed/0b/31ed0bc0-e686-add2-cce7-3fda494d0984/51883c2e-f530-4ea9-81da-8cd5059fe433.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"565b60\",\"height\":1080,\"textColor1\":\"f6f6f7\",\"textColor2\":\"eeeeef\",\"textColor3\":\"d6d7d8\",\"textColor4\":\"cfd1d2\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/65/41/e7/6541e712-8b83-d508-d7d9-d3aa0e1a1587/48ea4906-d589-4a63-bd8f-303e0ab31b62.png/{w}x{h}{c}.{f}\",\"width\":752},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/3b/4c/3a/3b4c3a0e-ef75-c62a-4d37-fef9fb40d32a/348534c3-7a59-4176-bc29-dad788ebade7.png/{w}x{h}{c}.{f}\",\"width\":752}},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\