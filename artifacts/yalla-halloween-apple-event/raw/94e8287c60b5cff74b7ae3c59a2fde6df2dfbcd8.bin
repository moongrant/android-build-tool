image/thumb/PurpleSource116/v4/47/d9/a4/47d9a4ec-4be3-831f-f656-82bf5c34be34/99f9d7ca-21a1-4175-830b-901fac8132ab_2688__6.5_6.7_U82f1_U5bf8__U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"efa31f\",\"textColor2\":\"e2842e\",\"textColor3\":\"c4841b\",\"textColor4\":\"ba6b27\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/fb/24/00/fb240023-13f5-38d3-d986-fbd24624b2f0/e1242796-2ba4-4fe7-b0e7-a23bf764eec8__U8bed_U97f3_U623f2688_U82f1_U8bed_6.5_6.7_U82f1_U5bf8.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"feffec\",\"textColor2\":\"e7b85a\",\"textColor3\":\"d0cebf\",\"textColor4\":\"be954a\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/01/f1/43/01f143ce-b46c-7104-08c0-c2c18b45b4a2/bedaddfc-ce68-47a9-8466-c9e01ee6358c_2688_U5e7f_U544a1-_U6e38_U620f_U5185.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"eece42\",\"textColor2\":\"efa31f\",\"textColor3\":\"c4a737\",\"textColor4\":\"c4841b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/fc/53/f4/fc53f49a-54f8-df5b-4bf4-e18f29d08f1f/0acf49cf-15ec-4d3e-8a36-99e79b649d81_2688_U5e7f_U544a5-_U6d3b_U52a8.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"eece42\",\"textColor2\":\"efa31f\",\"textColor3\":\"c4a737\",\"textColor4\":\"c4841b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/da/53/6e/da536e7e-c2da-a88f-5f94-6d1ae1461189/f03a2442-a4a7-4ca3-a652-864e49156fdf_2688_U5e7f_U544a7-_U76ae_U80a4_U5546_U57ce.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"fac22f\",\"textColor2\":\"efa31f\",\"textColor3\":\"ce9e28\",\"textColor4\":\"c4841b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/8d/1b/8f/8d1b8f3e-22c4-e740-65ac-fe64ed19f004/98482368-0e8d-4a66-b93a-52c3776fb062_2688_U5e7f_U544a6-_U597d_U53cb_U5217_U8868.jpg/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"1b0b0c\",\"height\":2688,\"textColor1\":\"eece42\",\"textColor2\":\"efa31f\",\"textColor3\":\"c4a737\",\"textColor4\":\"c4841b\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/c4/a6/7e/c4a67e98-9834-66de-bd77-c400bd8670e8/4ea00067-6ae8-4eef-a2b3-cae28b0ffc58_2688_U5e7f_U544a4-_U4e16_U754c_U804a_U5929.jpg/{w}x{h}{c}.{f}\",\"width\":1242}]},\"customVideoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"56201c\",\"height\":1920,\"textColor1\":\"e8edfc\",\"textColor2\":\"e6ba97\",\"textColor3\":\"cbc4cf\",\"textColor4\":\"c99b7f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/3b/59/82/3b59822f-5823-057c-b904-28d74095ded9/Job82aa08b0-b034-459b-af39-8e1fbecacd71-149790288-PreviewImage_preview_image_nonvideo_sdr-Time1683596553848.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/4c/85/bf/4c85bf42-15f4-1ded-fccf-c4c6d0cde4c9/P578429909_default.m3u8\"}],\"iphone_6_5\":[{\"previewFrame\":{\"bgColor\":\"7d5a52\",\"height\":1920,\"textColor1\":\"dfebfa\",\"textColor2\":\"efc59f\",\"textColor3\":\"cbced9\",\"textColor4\":\"d8b090\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/0d/c7/42/0dc74210-0ccd-b9a2-0d41-228888e85571/Job1da27fed-fb8a-4803-b39b-6d85d0f4591f-151224520-PreviewImage_preview_image_nonvideo_sdr-Time1686306264836.png/{w}x{h}{c}.{f}\",\"width\":886},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/ef/1c/a9/ef1ca979-70e4-4000-5b3f-14a2558994fb/P588838715_default.m3u8\"}]}}}},\"description\":{\"standard\":\"Welcome to Yalla Baloot \u0026 Hand, the ultimate mobile board game app that brings you the best of Baloot and Hand, two popular card games from the Arab region. Immerse yourself in the authentic gameplay, compete in fair thrilling tournaments, and connect with friends and family in real-time, all with smooth experience and rewarding wins.\\n\\nKey Features:\\n\\nAuthentic Baloot Experience:\\nExperience the timeless charm of Baloot, a beloved card game from the Middle East. Play with traditional rules and immerse yourself in the rich cultural heritage of this classic game with fair matchmaking for balanced competition.\\n\\nMultiple Modes of Hand:\\nExplore a variety of Hand game modes, including Hand and Hand Saudi. Each mode offers its own unique challenges and excitement, providing endless entertainment for both casual and competitive players with smooth, lag-free gameplay.\\n\\nCompetitive Tournaments and Rankings:\\nTest your skills and compete against players from around the world in intense tournaments and leagues. Climb the ranks, earn prestigious titles, and showcase your card-playing skills with plentiful rewards.\\n\\nSocial Rooms for Multiplayer Fun:\\nJoin public rooms and play Baloot and Hand with friends and other players. Create private rooms to invite your friends and enjoy hours of fun-filled gaming sessions together.\\n\\nVoice Chat Rooms for Real-Time Communication:\\nConnect with family and friends through real-time voice chat rooms. Enjoy seamless communication, host online parties, and share memorable moments as you engage in lively conversations.\\n\\nExquisite Personalization Options:\\nCustomize your gaming experience with a wide range of beautifully designed skins for cards, boards, and avatars. Stand out from the crowd and express your style with customizable elements that reflect your personality.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Baloot \u0026 Hand SVIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nYalla Baloot \u0026 Hand SVIP price is USD 24.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S., and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Baloot \u0026 Hand without becoming a Yalla Baloot \u0026 Hand SVIP.\\n\\nWe will try our best to improve your game experience, provide you with fun and excitement, and make your life full of joy.\\n\\nPrivacy Policy：https://h5.yallabaloot.com/balootActivity/privacy_baloot/UserAgreementEN.html?index=0\\n\\nTerms of Service：https://h5.yallabaloot.com/balootActivity/privacy_baloot/UserAgreementEN.html?index=1\\n\\nContact Us: \\nIf you have any questions or suggestions, please contact us.\\nFacebook:https://www.facebook.com/BalootYalla\\nWebsite:www.yallabaloot.com\\nEmail: balootsupport@yalla.com\"},\"editorialArtwork\":{\"bannerUber\":{\"bgColor\":\"b7b09b\",\"height\":1080,\"textColor1\":\"220e10\",\"textColor2\":\"171e17\",\"textColor3\":\"3a2626\",\"textColor4\":\"30362c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/4e/4d/f5/4e4df550-9c55-2fc9-2d53-2474e7512256/6d92734e-6dd9-4a6b-b027-85c88e95075c.png/{w}x{h}sr.{f}\",\"width\":4320},\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/c0/da/49/c0da49fe-c07e-116f-0619-02fc3283c631/e8f77579-8a79-4b3d-8a08-1dd0a7f102aa.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"575a60\",\"height\":1080,\"textColor1\":\"f2f4f5\",\"textColor2\":\"e9eef6\",\"textColor3\":\"d3d5d7\",\"textColor4\":\"ccd0d8\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/74/52/c5/7452c527-f1ad-8341-ee2d-869278222df8/5f0f30fd-7937-49f6-b2bd-2854aef61773.png/{w}x{h}{c}.{f}\",\"width\":985},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"ececec\",\"textColor2\":\"cdcdcd\",\"textColor3\":\"bcbcbc\",\"textColor4\":\"a4a4a4\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/bf/22/0c/bf220c2c-ba6d-df5f-fb5c-2a8b8d96fcb8/8c54b2db-cb72-4d1a-bac8-9ae9e8b7741c.png/{w}x{h}{c}.{f}\",\"width\":985},\"subscriptionHero\":{\"bgColor\":\"beb295\",\"height\":1080,\"textColor1\":\"251013\",\"textColor2\":\"111a15\",\"textColor3\":\"3e2928\",\"textColor4\":\"2c332a\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features112/v4/ff/4d/5c/ff4d5cea-69eb-8ec1-6e24-4b853c272fc5/f1b6888a-29f4-44ba-b84d-b058de33958f.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"tagline\":\"Play your cards right\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":false,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"13.0.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":326154240}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878379939\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":326154240}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878379939\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://h5.yallabaloot.com/balootActivity/privacy_baloot/UserAgreementEN.html?index=0\",\"releaseDate\":\"2020-08-07\",\"requiredCapabilitiesForRealityDevice\":\"accelerometer arm64 opengles-1 \",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Baloot \u0026 Hand with voice chat\",\"supportURLForLanguage\":\"https://www.yallabaloot.com/\",\"versionHistory\":[{\"releaseDate\":\"2025-09-25\",\"releaseNotes\":\"1. Royal Privileges Upgrade - Unlock more exclusive perks and showcase your distinguished status!\\n2. Medal System Upgrade - A refreshed interface design, an expanded chat room medal, and more honors waiting for you to unlock!\\n3. Chat Room Exclusive Packs - Daily exclusive benefits featuring super value offers + free gift packs. Remember to claim yours daily!\",\"releaseTimestamp\":\"2025-09-25T01:44:13Z\",\"versionDisplay\":\"1.5.19\"},{\"releaseDate\":\"2025-08-11\",\"releaseNotes\":\"1. Royal Privilege Upgrade - Unlock more exclusive Royal privileges and highlight your status!\\n2. Store Optimization - Gem recharge is now available for a better experience.\\n3. Wealth Level Expansion - Chatroom's Wealth Level has been expanded to Level 80, with more privileges unlocked!\\n4. Chatroom Event Preview - Room owners can create exclusive room events to host your personalized parties!\\n5. Lucky Chest - Participate in to win a brand-new entry vehicle and be the center of attention!\",\"releaseTimestamp\":\"2025-08-11T01:52:26Z\",\"versionDisplay\":\"1.5.18\"},{\"releaseDate\":\"2025-06-01\",\"releaseNotes\":\"1. Royal System Upgrade - Royal Privileges have extended to the game lobby!\\n2. SVIP Feature Upgrade - GIF profile photo is now available for SVIP users.\\n3. Store Design Optimization - Brings a more convenient user experience.\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2025-06-01T02:54:51Z\",\"versionDisplay\":\"1.5.17\"},{\"releaseDate\":\"2025-03-07\",\"releaseNotes\":\"1. Ramadan theme - Ramadan themed activities are coming soon, let's welcome Ramadan together.\\n2. New SVIP system - Become an SVIP, unlock exclusive privileges, and show your identity.\\n3. New gifts - New lucky gift in chatroom. Send gifts for a chance to get generous rewards!\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2025-03-07T02:05:45Z\",\"versionDisplay\":\"1.5.16\"},{\"releaseDate\":\"2025-02-13\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2025-02-13T08:04:30Z\",\"versionDisplay\":\"1.5.15.1\"},{\"releaseDate\":\"2025-01-14\",\"releaseNotes\":\"1. New Gifts - New flying-mic gifts in Chatroom, unlocking a more interesting way of sending gifts. Come and experience it now!\\n2. Royal Level - Royal 6 is now available in the Chatroom! More privileges are waiting for you to enjoy!\\n3. Game Benefits - Brand new permanent profile frames and chatroom gift packs. Enjoy a wonderful journey of the game!\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2025-01-14T01:36:51Z\",\"versionDisplay\":\"1.5.15\"},{\"releaseDate\":\"2024-11-12\",\"releaseNotes\":\"1. Pass - Super value pass available, with generous rewards waiting for you!\\r\\n2. New gifts - New exclusive customization gifts showcase your unique glory.\\r\\n3. Baloot - League match upgrade with new interface and polished quality.\",\"releaseTimestamp\":\"2024-11-12T01:48:12Z\",\"versionDisplay\":\"1.5.14\"},{\"releaseDate\":\"2024-09-13\",\"releaseNotes\":\"1. Chatroom - The live room now offers top matches spectating. Watch high-level matches between top players.\\r\\n2. Game benefits - Brand new first recharge and limited-time gift pack, offering a more enjoyable gaming experience.\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2024-09-13T02:02:31Z\",\"versionDisplay\":\"1.5.13\"},{\"releaseDate\":\"2024-07-30\",\"releaseNotes\":\"1. Chatroom - Enjoy Baloot tournaments while chatting with friends in the exclusive spectating room.\\n2. Game match - Optimized certain layouts in Baloot and Hand games to enhance your gaming experience!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2024-07-30T01:50:16Z\",\"versionDisplay\":\"1.5.12\"},{\"releaseDate\":\"2024-05-17\",\"releaseNotes\":\"1. In-game message and Stickers - Optimized in-game messages and stickers interface. Enjoy free communication with your friends!\\r\\n2. Baloot Game Interface - Optimized the layout of personal information to further enhance the gaming experience.\\r\\n3. Interaction Optimization - Optimized the effect of interface transitions to provide a smoother experience.\",\"releaseTimestamp\":\"2024-05-17T01:26:04Z\",\"versionDisplay\":\"1.5.11\"},{\"releaseDate\":\"2024-04-19\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2024-04-19T01:47:12Z\",\"versionDisplay\":\"1.5.10\"},{\"releaseDate\":\"2024-03-06\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2024-03-06T05:38:24Z\",\"versionDisplay\":\"1.5.9\"},{\"releaseDate\":\"2024-02-08\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2024-02-08T02:42:19Z\",\"versionDisplay\":\"1.5.8.1\"},{\"releaseDate\":\"2024-02-01\",\"releaseNotes\":\"1. Chatroom - Introducing our new Royal System! Become a royal member and unlock various privileges to stand out from the crowd!\\n2. New Baloot Gameplay - Experience the limited-time one-round mode and join the master showdown.\\n3. Ranking Display Upgrade - The top of each ranking will now have enhanced effects to show off the glory!\",\"releaseTimestamp\":\"2024-02-01T06:23:09Z\",\"versionDisplay\":\"1.5.8\"},{\"releaseDate\":\"2023-11-21\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\r\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\r\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\\r\\n4. Performance optimization - Enjoy an enhanced and smoother gaming experience!\\r\",\"releaseTimestamp\":\"2023-11-21T11:05:16Z\",\"versionDisplay\":\"1.5.7.1\"},{\"releaseDate\":\"2023-11-07\",\"releaseNotes\":\"1. Gaid Optimization - The rules and process of gaid have been upgraded. Go to the public room to compete with your friends!\\n2. Spectating Feature Upgrade - You can now show your cards to spectators, come and experience it!\\n3. Chatroom Upgrade - Added backpack. You can check the frame, bubbles and other items in it. Use them to stand out in the crowd!\",\"releaseTimestamp\":\"2023-11-07T08:08:58Z\",\"versionDisplay\":\"1.5.7\"},{\"releaseDate\":\"2023-10-10\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-10-10T07:36:26Z\",\"versionDisplay\":\"1.5.6.1\"},{\"releaseDate\":\"2023-09-20\",\"releaseNotes\":\"1. New Room Prop - Magic Card is coming! Send it to each other in chatroom and it will be displayed on mic after sending!\\r\\n2. Quick Reply - Quick Reply in chatroom is available now. Reply directly to keep the relationship closer! \\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-09-20T01:37:00Z\",\"versionDisplay\":\"1.5.6\"},{\"releaseDate\":\"2023-08-23\",\"releaseNotes\":\"1. Master Match - Engage in a thrilling competition and showcase your skills alongside the world's best Baloot players!\\r\\n2. World Top List - Work your way up the World Top Ranking List by earning points through competitive play in game. Only the best will reach the top!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-08-23T01:33:22Z\",\"versionDisplay\":\"1.5.5\"},{\"releaseDate\":\"2023-06-13\",\"releaseNotes\":\"1. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-06-13T12:07:16Z\",\"versionDisplay\":\"1.5.4\"},{\"releaseDate\":\"2023-05-16\",\"releaseNotes\":\"1. Game Sharing - Improved the sharing feature to help you easily showcase accomplishments with friends!\\n2. Chatroom Upgrade - Enjoy the newly added personal gift lists, which showcase leaderboards for sent and received gifts!\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-05-16T07:06:49Z\",\"versionDisplay\":\"1.5.3\"},{\"releaseDate\":\"2023-03-21\",\"releaseNotes\":\"1. Achievement Badges - Earn achievements to unlock badges, and show off your collection by wearing them!\\r\\n2. Chatroom Update - Member club feature added. Join with friends and make your room the most popular!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\",\"versionDisplay\":\"1.5.2\"},{\"releaseDate\":\"2023-01-26\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\",\"versionDisplay\":\"1.5.1.1\"},{\"releaseDate\":\"2023-01-17\",\"releaseNotes\":\"1. Upgraded Challenge - Two challenge matches of different levels have been added, giving users more exciting games to enjoy! \\r\\n2. Interface Optimization - Buttons on the main interface have been optimized to improve the user experience!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\",\"versionDisplay\":\"1.5.1\"},{\"releaseDate\":\"2022-12-23\",\"releaseNotes\":\"1. Chatrooms – Experience the newly added chatrooms! Create your own room or join a public one and make new friends! \\r\\n2. Upgraded Global Chat - Experience a smoother global chat with newly added message notifications! \\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\",\"versionDisplay\":\"1.5.0\"}],\"videoPreviewsByType\":{\"iphone6+\":[{\"previewFrame\":{\"bgColor\":\"56201c\",\"height\":1920,\"textColor1\":\"e8edfc\",\"textColor2\":\"e6ba97\",\"textColor3\":\"cbc4cf\",\"textColor4\":\"c99b7f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/3b/59/82/3b59822f-5823-057c-b904-28d74095ded9/Job82aa08b0-b034-459b-af39-8e1fbecacd71-149790288-PreviewImage_preview_image_nonvideo_sdr-Time1683596553848.png/{w}x{h}{c}.{f}\",\"width\":1080},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/4c/85/bf/4c85bf42-15f4-1ded-fccf-c4c6d0cde4c9/P578429909_default.m3u8\"}],\"iphone_6_5\":[{\"previewFrame\":{\"bgColor\":\"7d5a52\",\"height\":1920,\"textColor1\":\"dfebfa\",\"textColor2\":\"efc59f\",\"textColor3\":\"cbced9\",\"textColor4\":\"d8b090\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/0d/c7/42/0dc74210-0ccd-b9a2-0d41-228888e85571/Job1da27fed-fb8a-4803-b39b-6d85d0f4591f-151224520-PreviewImage_preview_image_nonvideo_sdr-Time1686306264836.png/{w}x{h}{c}.{f}\",\"width\":886},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/ef/1c/a9/ef1ca979-70e4-4000-5b3f-14a2558994fb/P588838715_default.m3u8\"}]},\"websiteUrl\":\"https://www.yallabaloot.com/\"}},\"privacy\":{\"privacyTypes\":[{\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}],\"description\":\"The following data may be collected and linked to your identity:\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"privacyType\":\"Data Linked to You\"}]},\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"},\"iphone\":{\"deviceFamily\":\