Store\",\"name\":\"Réseaux sociaux\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/fr/genre/id6005\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/7004?l=fr-FR\",\"attributes\":{\"parentName\":\"Jeux\",\"name\":\"Jeux de société\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/fr/genre/id7004\"}},{\"id\":\"7005\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/7005?l=fr-FR\",\"attributes\":{\"parentName\":\"Jeux\",\"name\":\"Cartes\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/fr/genre/id7005\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1752737728380,\"RTCI\":1753098234535}}},{\"id\":\"6737796366\",\"type\":\"apps\",\"href\":\"/v1/catalog/fr/apps/6737796366?l=fr-FR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données établissant un lien avec vous\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Contenu utilisateur\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Données n’établissant aucun lien avec vous\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées, mais elles ne sont pas liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Concours rares/modérés\",\"Scènes rares/modérées de violence (animation ou fantastique)\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"sellerInfo\":{\"isTrader\":true,\"name\":\"Yalla Technology FZ-LLC\",\"dunsNumber\":\"561428789\",\"address\":\"Premises 234 \u0026 235\\nFloor 02, Building 16\\nDuibai Internet City\\nÉmirats Arabes Unis\",\"phoneNumber\":\"+971 561883079\",\"email\":\"application@yalla.com\"},\"url\":\"https://apps.apple.com/fr/app/yalla-jackaroo/id6737796366\",\"userRating\":{\"value\":4,\"ratingCount\":2,\"ratingCountList\":[0,0,1,0,1],\"ariaLabelForRatings\":\"4.0 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Yalla Jackaroo\",\"genreDisplayName\":\"Jeux de société\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Nécessite macOS 11.0 ou une version ultérieure et un Mac doté d’une puce Apple M1 ou une version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"أهلا بك في يلا جاكارو! - لعبة جاكارو الأصلية!\\n\\nاختبر متعة جاكارو الأصلية، حيث يلتقي التقليد بالمتعة الحديثة! العب كالملك، دردش مع أصدقائك، وسيطر على عالم جاكارو! يلا - لنبدأ اللعب!\\n\\nلماذا تختار يلا جاكارو؟\\nالأجواء الحقيقية: الدردشة الصوتية المباشرة والملصقات التفاعلية، تمنحك الإحساس الأصلي لأجواء الألعاب الواقعية!\\nأوضاع اللعب المتعددة: سريع، 1v1، مجنون، كمبلكس، عادي - تشكيلة غنية من أوضاع اللعب الممتعة! اختبر تجربة فريدة من نوعها في يلا جاكارو!\\nالمكافآت الضخمة: كوينزات مجانية، مكافآت يومية، مكافآت الرخصة، والمزيد - المكافآت الحقيقية بانتظارك!\\nترتيب المجد: شرف جاكارو الحصري لك فقط! تصدر ترتيب الثروة وترتيب XP! فز بالشارات والمجد، وأظهر للعالم مهاراتك الملك الحقيقية!\\nالتصميم الفاخر: كل تفصيل مُصمم بدقة فائقة، لتقديم تجربة ملكية بامتياز.\\n\\nما الذي يميزنا؟ \\nمناسب للمبتدئين: جديد في جاكارو؟ دليلنا التعليمي يساعدك لتصبح لاعبا محترفا بسرعة! أتقن مهارات المستوى الملكي بسرعة!\\nالمطابقة المباشرة: العب جاكارو مع لاعبين من جميع أنحاء العالم، ودردش أثناء اللعب، وضاعف المتعة في لعبة واحدة.\\nاللعب الاجتماعي: كون فريقا مع أصدقائك، وأنشئ غرفة خاصة، واستمتع بالدردشة الصوتية - مثالية للقاءات الأونلاين!\\n\\nالمجلس\\nامسك المايك الخاص بك، وانضم إلى الدردشة، أظهر سحرك الشخصي، تعرف على أصدقاء جدد، واستمتع بمحادثة صوتية جماعية مجانية مباشرة! هل أنت مستعد للسيطرة على الدردشة؟ كن ملك التواصل الاجتماعي!\\n\\n\\nحمل يلا جاكارو الآن!\\nيلا جاكارو - اللعبة الأصلية لمتعة بمستوى الملك! ابدأ رحلتك الأسطورية! العب كالملك، ونحن نتطلع لرؤيتك!\\n\\n\\nتواصل معنا:\\nالبريد الإلكتروني: jackaroo.support@yalla.com\\nفيسبوك وتيك توك: Yalla Jackaroo - يلا جاكارو\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"websiteUrl\":\"https://www.yallajackaroo.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.1.3.1\",\"releaseNotes\":\"[تحديث v1.1.3.1]\\n1. تمت إضافة وضع 1vs1، لنستمتع معا بتجربة جاكارو أكثر إثارة!\\n2. تمت إضافة ترتيب XP، حاول أن تصبح أكثر لاعب جاكارو خبرة.\\n3. تمت إضافة الشارة. افتح وارتدِ الشارات لتظهر قوتك.\\n4. تمت إضافة المزيد من تأثيرات اللعبة الرائعة، تعال واستكشف في اللعبة!\\n5. تحسين تجربة اللعب.\\n6. إصلاحات للأخطاء.\",\"releaseDate\":\"2025-07-08\",\"releaseTimestamp\":\"2025-07-08T01:52:37Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"[تحديث v1.1.3]\\n1. ترتيب الاستيلاء: سجل لحظاتك المميزة في الاستيلاء الشرس!\\n2. تحسين تجربة اللعب.\\n3. إصلاحات للأخطاء.\",\"releaseDate\":\"2025-06-23\",\"releaseTimestamp\":\"2025-06-23T08:55:29Z\"},{\"versionDisplay\":\"1.1.2.3\",\"releaseNotes\":\"[تحديث v1.1.2.3]\\n1. وضع سريع: جرب لعب جاكارو بوتيرة جديدة أسرع الآن!\\n2. تحسين دليل اللعبة.\\n3. تحسين تجربة الرخصة.\\n4. إصلاحات للأخطاء.\",\"releaseDate\":\"2025-06-05\",\"releaseTimestamp\":\"2025-06-05T01:53:02Z\"},{\"versionDisplay\":\"1.1.2.2\",\"releaseNotes\":\"[تحديث v1.1.2.2]\\n1. وضع سريع: جرب لعب جاكارو بوتيرة جديدة أسرع الآن!\\n2. تحسين دليل اللعبة.\\n3. تحسين تجربة الرخصة.\\n4. إصلاحات للأخطاء.\",\"releaseDate\":\"2025-06-03\",\"releaseTimestamp\":\"2025-06-03T01:42:59Z\"},{\"versionDisplay\":\"1.1.2.1\",\"releaseNotes\":\"[تحديث v1.1.2.1]\\n1. وضع سريع: جرب لعب جاكارو بوتيرة جديدة أسرع الآن!\\n2. تحسينات وإصلاحات للأخطاء.\",\"releaseDate\":\"2025-05-22\",\"releaseTimestamp\":\"2025-05-22T02:13:16Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"[تحديث v1.1.2]\\n1. وضع سريع: جرب لعب جاكارو بوتيرة جديدة أسرع الآن!\\n2. تحسينات وإصلاحات للأخطاء.\",\"releaseDate\":\"2025-05-21\",\"releaseTimestamp\":\"2025-05-21T05:35:19Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"[تحديث v1.1.1]\\n1. المهام اليومية: أكمل المهام لتكسب الكوينزات.  \\n2. مكافآت المستوى: الكوينزات، الألماس، والمظاهر تنتظرك.\\n3. تحسينات وإصلاحات للأخطاء.\",\"releaseDate\":\"2025-04-26\",\"releaseTimestamp\":\"2025-04-26T07:43:29Z\"},{\"versionDisplay\":\"1.1.0.1\",\"releaseNotes\":\"[تحديث v1.1.0.1]\\n\\n1. غرفة الدردشة: تحدث والعب مع أصدقائك مباشرة!\\n2. الوضع السريع: حركة أسرع وأكثر تشويقا!\\n3. غرف VIP: تنافس مع أفضل اللاعبين حول العالم!\\n4. تحسينات وإصلاحات للأخطاء.\",\"releaseDate\":\"2025-03-29\",\"releaseTimestamp\":\"2025-03-29T08:15:41Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"[تحديث v1.1.0]\\n\\n1. غرفة الدردشة: تحدث والعب مع أصدقائك مباشرة!\\n2. الوضع السريع: حركة أسرع وأكثر تشويقا!\\n3. غرف VIP: تنافس مع أفضل اللاعبين حول العالم!\\n4. تحسينات وإصلاحات للأخطاء.\",\"releaseDate\":\"2025-03-25\",\"releaseTimestamp\":\"2025-03-25T01:41:32Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2025-01-27\",\"releaseTimestamp\":\"2025-01-27T15:07:38Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"usesExternalPurchase\":false,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\