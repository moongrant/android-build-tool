",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données utilisées pour vous suivre\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Les données suivantes peuvent être utilisées pour vous suivre dans plusieurs apps et sites web appartenant à d’autres sociétés :\",\"dataCategories\":[{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Données n’établissant aucun lien avec vous\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées, mais elles ne sont pas liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsFrance\":{\"name\":\"France 18\",\"value\":600,\"rank\":47,\"advisories\":[\"Scènes fréquentes/intenses réservées aux adultes (suggestives)\"]},\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Scènes fréquentes/intenses réservées aux adultes (suggestives)\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"sellerInfo\":{\"isTrader\":true,\"name\":\"Star Chat International Limited\",\"dunsNumber\":\"686267108\",\"address\":\"Hong Kong\\nWan Chai\\nRm 19C LOCKHART CTR\\n301-307 LOCKHART RD\",\"phoneNumber\":\"+86 15013072660\",\"email\":\"silence@starchat.live\"},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/fr/app/starchat-group-voice-chat-room/id1317217120\",\"userRating\":{\"value\":4.2,\"ratingCount\":69,\"ratingCountList\":[11,1,3,4,50],\"ariaLabelForRatings\":\"4.2 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"name\":\"StarChat-Group Voice Chat Room\",\"genreDisplayName\":\"Divertissement\",\"isPreorder\":false,\"artistName\":\"Star Chat International Limited\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Nécessite macOS 11.0 ou une version ultérieure et un Mac doté d’une puce Apple M1 ou une version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nStarChat provides a variety of in-app purchases and subscriptions.If you choose to purchase an StarChat subscription,payment will be charged to your iTunes account after purchase confirmation.Your account will be charged the subscription amount within 24-hours prior to the end of the currnent period unless auto-renewal is turned off.Auto-renewal may be turned off at any time by going to your settings in the iTunes Store after purchase.\\n\\nPrivacy Policy：https://www.starchat.live/help/policy/Privacy_Policy.html\\nTerms of Service：https://www.starchat.live/help/policy/Terms_of_Service.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.27.2\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2025-07-23\",\"releaseTimestamp\":\"2025-07-23T16:59:31Z\"},{\"versionDisplay\":\"8.27.1\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2025-07-18\",\"releaseTimestamp\":\"2025-07-18T18:09:42Z\"},{\"versionDisplay\":\"8.27.0\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2025-07-01\",\"releaseTimestamp\":\"2025-07-01T09:37:10Z\"},{\"versionDisplay\":\"8.26.0\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2025-05-28\",\"releaseTimestamp\":\"2025-05-28T11:21:05Z\"},{\"versionDisplay\":\"8.25.0\",\"releaseNotes\":