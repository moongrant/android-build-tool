ef\":\"/v1/catalog/fr/genres/7009?l=fr-FR\",\"attributes\":{\"parentName\":\"Jeux\",\"name\":\"Famille\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/fr/genre/id7009\"}},{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/6016?l=fr-FR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Divertissement\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/fr/genre/id6016\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1753133211800,\"RTCI\":1752762673854}}},{\"id\":\"1539388601\",\"type\":\"apps\",\"href\":\"/v1/catalog/fr/apps/1539388601?l=fr-FR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données établissant un lien avec vous\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Coordonnées\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Contacts\",\"identifier\":\"CONTACTS\"},{\"dataCategory\":\"Contenu utilisateur\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Données n’établissant aucun lien avec vous\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées, mais elles ne sont pas liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Localisation\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Concours fréquents/intenses\",\"Scènes rares/modérées de violence (animation ou fantastique)\",\"Scènes rares/modérées de contenu à caractère médical\",\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"sellerInfo\":{\"isTrader\":true,\"name\":\"Yalla Technology FZ-LLC\",\"dunsNumber\":\"561428789\",\"address\":\"Premises 234 \u0026 235\\nFloor 02, Building 16\\nDuibai Internet City\\nÉmirats Arabes Unis\",\"phoneNumber\":\"+971 561883079\",\"email\":\"application@yalla.com\"},\"url\":\"https://apps.apple.com/fr/app/yallachat/id1539388601\",\"userRating\":{\"value\":4.3,\"ratingCount\":10,\"ratingCountList\":[1,0,1,1,7],\"ariaLabelForRatings\":\"4.3 étoiles\"},\"name\":\"YallaChat\",\"genreDisplayName\":\"Réseaux sociaux\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Nécessite macOS 11.0 ou une version ultérieure et un Mac doté d’une puce Apple M1 ou une version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"YallaChat is an instant messaging app. Simple and fast, it can be downloaded and used for free. YallaChat allows you to safely communicate with your friends or family by sharing important moments, sending and receiving messages, photos, and superior voice \u0026 video messages and calls.\\n\\n【Secure Messaging】\\nCommunicate with your friends and family at any time by sending various types of messages such as stickers, photos, text, and voice and video messages. All messages are well-protected with end-to-end encryption on YallaChat.\\n\\n【Voice \u0026 Video Calls】\\nHigh-quality audio and instant video calls with friends and family, no matter where you are; 1v1 or group calls are all available.\\n\\n【Voice Chat Room】\\n 24-hour online voice chat room and group chats on multiple topics to meet your abundant interests. You can create your own room to meet more new friends with shared hobbies.\\n\\n【Interactive Games】\\nPlay Ludo, plant your date-palm tree to get mobile credits or challenge the super difficult game Alpaca....more interesting games are waiting for you.\\n\\n【Athan Reminders】\\nThe Athan times are generated according to arithmetic methods adopted in most of the Islamic world. By automatically determining your location, this application can remind you of accurate prayer times as well as determine the direction of the Qibla.\\n\\n【Share Moments】\\nInteract with your friends by sharing your important moments. Post photos, videos, and more to your Moments.\\n\\n\\n*Data charges may apply. Contact your provider for details.\\n\\n---------------------------------------------------------\\n\\nIf you have any feedback, questions, or concerns, please email us at:\\nyallachatsupport@yalla.com\\n\\nLearn more about YallaChat at:\\nhttps://www.yallachat.com\\n---------------------------------------------------------\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.yallachat.com\",\"versionHistory\":[{\"versionDisplay\":\"1.13.0\",\"releaseNotes\":\"Bug fixes and improvements.\",\"releaseDate\":\"2025-03-23\",\"releaseTimestamp\":\"2025-03-23T23:34:49Z\"},{\"versionDisplay\":\"1.12.0\",\"releaseNotes\":\"1. Account security upgrade: support binding with e-mail;\\n2. Bug fixes and improvements.\",\"releaseDate\":\"2024-05-30\",\"releaseTimestamp\":\"2024-05-30T01:42:12Z\"},{\"versionDisplay\":\"1.11.0\",\"releaseNotes\":\" Bug fixes and improvements.\",\"releaseDate\":\"2024-04-19\",\"releaseTimestamp\":\"2024-04-19T01:44:25Z\"},{\"versionDisplay\":\"1.10.1\",\"releaseNotes\":\"1. Muslim Room: A room designed for the Quran, to listen to the Quran and participate in discussions of worship.\\n2. Room Music: You can play music in the room and enhance the ambiance.\\n3. Spot Optimization: Add location to Spot and discover more local friends.\",\"releaseDate\":\"2024-01-25\",\"releaseTimestamp\":\"2024-01-25T01:47:18Z\"},{\"versionDisplay\":\"1.10.0\",\"releaseNotes\":\"1. Muslim Room: A room designed for the Quran, to listen to the Quran and participate in discussions of worship.\\n2. Room Music: You can play music in the room and enhance the ambiance.\\n3. Spot Optimization: Add location to Spot and discover more local friends.\",\"releaseDate\":\"2024-01-17\",\"releaseTimestamp\":\"2024-01-17T02:08:27Z\"},{\"versionDisplay\":\"1.9.1\",\"releaseNotes\":\" Bug fixes and improvements.\",\"releaseDate\":\"2023-11-15\",\"releaseTimestamp\":\"2023-11-15T09:03:22Z\"},{\"versionDisplay\":\"1.9.0\",\"releaseNotes\":\"1. Drift Bottle: Discover new friends by exchanging letters using the Drift Bottle Feature.\\n2. Spot Optimization: Users can Set wallpapers, access links, and view files within Spot.\\n3. Nearby Feature: Brand new design simplifies the process of finding people nearby to chat with.\",\"releaseDate\":\"2023-11-09\",\"releaseTimestamp\":\"2023-11-09T01:58:04Z\"},{\"versionDisplay\":\"1.8.0\",\"releaseNotes\":\"Spot Feature: launch of a vast public community centered around shared interests:\\n1. Personalized tags: Attract like-minded friends with visible tags on the platform.\\n2. Maximum 30,000 users allowed per Spot.\\n3. Roaming enabled for messages in Spot.\\n4. Exclusive voice chat group: Enjoy free chat with Spot members and visitors.\",\"releaseDate\":\"2023-08-29\",\"releaseTimestamp\":\"2023-08-29T08:21:00Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"1. Sticker Shop: You can download more fascinating stickers.\\n2. Broadcast: sending messages to multiple friends at once with a single action. \\n3. Bug fixes and improvements.\",\"releaseDate\":\"2023-05-22\",\"releaseTimestamp\":\"2023-05-22T01:46:22Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"1.Nearby Feature – Enjoy this new feature that allows you to easily find people in your vicinity to chat with.\\n2.News Feature – Stay up to date with this new feature which enables you to browse popular news from various countries.\\n3.Discover – You can now access the Moments, Games \u0026 Minis, Athan, News, and Nearby features from the ‘Discover’ page.\",\"releaseDate\":\"2023-04-17\",\"releaseTimestamp\":\"2023-04-17T01:46:45Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"Bug fixes and improvements.\",\"releaseDate\":\"2023-02-15\",\"releaseTimestamp\":\"2023-02-15T09:01:27Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1-Send documents: Now you can send documents in chats.\\n2-Group Call: Enhancements to the Group call page.\\n3-Screen lock feature: To protect account privacy, you can now use Face ID or Touch ID to unlock YallaChat.\",\"releaseDate\":\"2023-02-06\",\"releaseTimestamp\":\"2023-02-06T10:04:12Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\" Bug fixes and improvements.\",\"releaseDate\":\"2022-11-30\",\"releaseTimestamp\":\"2022-11-30T01:56:02Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"1. New Athan page design: Dhikr and Tasbih features have been added.\\n2. Live location: Users can now share their real-time location with their friends.\\n3. Message reactions: users can react to messages in chats using emojis.\",\"releaseDate\":\"2022-11-24\",\"releaseTimestamp\":\"2022-11-24T08:47:56Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Bug fixes and improvements.\",\"releaseDate\":\"2022-10-12\",\"releaseTimestamp\":\"2022-10-12T10:15:07Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"1. Added dark mode: Users can now switch between dark and light modes at any time.\\n2. Added wallpaper feature: Users can now customize their favorite chat background.\\n3. Bug fixes and improvements.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T09:34:36Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"1. Optimized user experience: Users can view unread messages and mentions \\\"@\\\" more easily.\\n2. Video customization: Videos can now be customized by users through cropping, texting, and applying stickers.\\n3. Added \\\"Location\\\" feature: Users can now share current or nearby locations with friends.\",\"releaseDate\":\"2022-08-26\",\"releaseTimestamp\":\"2022-08-26T02:08:27Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"1. Bug fixes and improvements.\",\"releaseDate\":\"2022-06-29\",\"releaseTimestamp\":\"2022-06-29T02:46:04Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1. Added  Athan function that provides accurate prayer times and Qibla directions.\\n2. Added GIF library.\\n3. New design adjusts for the Me page.\\n4. Bug fixes and improvements.\",\"releaseDate\":\"2022-06-23\",\"releaseTimestamp\":\"2022-06-23T02:04:44Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2022-05-20\",\"releaseTimestamp\":\"2022-05-20T03:49:24Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":\"1. Added moments feature, you can share moments with your friends.\\n2. Added a new \\\"Hop up\\\" mini game. \\n3. Added new Arabian stickers and emojis.\\n4. Enhanced design for single emojis.\",\"releaseDate\":\"2022-04-28\",\"releaseTimestamp\":\"2022-04-28T12:23:17Z\"},{\"versionDisplay\":\"0.3.0\",\"releaseNotes\":\"1. Added temporary conversation feature to quickly get in touch with your contacts.\\n2. Added new Arabian animated stickers.\\n3. Added group calling feature, you can call groups’ participants anytime.\\n4. If you turn on Auto-add contacts, your contacts will be automatically added as friends.\\n5. Added the group cover. You can upload any wallpaper as a group+ cover.\\n6. Bug fixes and improvements.\",\"releaseDate\":\"2022-01-20\",\"releaseTimestamp\":\"2022-01-20T03:05:05Z\"},{\"versionDisplay\":\"0.2.1\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2021-12-01\",\"releaseTimestamp\":\"2021-12-01T01:50:22Z\"},{\"versionDisplay\":\"0.2.0\",\"releaseNotes\":\"1. Now we have the group chat feature. You can contact your family or friends at any time by creating a group, search for interested groups to join, and make more friends;\\n2. Add personal and group QR codes. Now you can quickly add friends or enter groups, and create new chats;\\n3. Long press to reply, copy, forward and delete messages;\\n4. Repair and improve user experience;\",\"releaseDate\":\"2021-10-29\",\"releaseTimestamp\":\"2021-10-29T03:26:46Z\"},{\"versionDisplay\":\"0.1.1\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\\r\",\"releaseDate\":\"2021-04-08\",\"releaseTimestamp\":\"2021-04-08T02:26:27Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"usesExternalPurchase\":false,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1539388601\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=873171505\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":237207552}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1539388601\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=873171505\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":237207552}]}],\"requires32bit\":false,\"usesExternalLinkPurchase\":false,\"releaseDate\":\"2021-03-24\",\"hasInAppPurchases\":false,\"bundleId\":\"com.yallatech.yallachat\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1