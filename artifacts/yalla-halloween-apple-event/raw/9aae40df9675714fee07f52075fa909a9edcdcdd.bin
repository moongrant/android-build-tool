\":284139520,\"iPad13,16\":284073984,\"iPad6,7\":294486016,\"iPad16,5-A\":284073984,\"iPad16,5-B\":284073984,\"iPad6,4\":294486016,\"iPad6,3\":294486016,\"iPad6,8\":294486016,\"iPad13,8\":284073984,\"iPad13,9\":284073984,\"iPad13,4\":284073984,\"iPad13,5\":284073984,\"iPad13,6\":284073984,\"iPad13,7\":284073984,\"iPad13,1\":284073984,\"iPad13,2\":284073984}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/fr/apps/1544887147/developer?l=fr-FR\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/fr/developers/1444567250?l=fr-FR\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/fr/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/fr/apps/1544887147/genres?l=fr-FR\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/6014?l=fr-FR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Jeux\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/fr/genre/id6014\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/7004?l=fr-FR\",\"attributes\":{\"parentName\":\"Jeux\",\"name\":\"Jeux de société\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/fr/genre/id7004\"}},{\"id\":\"7003\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/7003?l=fr-FR\",\"attributes\":{\"parentName\":\"Jeux\",\"name\":\"Parties rapides\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/fr/genre/id7003\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/fr/genres/6005?l=fr-FR\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Réseaux sociaux\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/fr/genre/id6005\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1752727939289,\"RTCI\":1752386443875}}},{\"id\":\"1542713951\",\"type\":\"apps\",\"href\":\"/v1/catalog/fr/apps/1542713951?l=fr-FR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données utilisées pour vous suivre\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Les données suivantes peuvent être utilisées pour vous suivre dans plusieurs apps et sites web appartenant à d’autres sociétés :\",\"dataCategories\":[{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"}]},{\"privacyType\":\"Données établissant un lien avec vous\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Contenu utilisateur\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Données n’établissant aucun lien avec vous\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées, mais elles ne sont pas liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Contenu utilisateur\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Scènes rares/modérées réservées aux adultes (suggestives)\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"sellerInfo\":{\"isTrader\":true,\"name\":\"Yalla Technology FZ-LLC\",\"dunsNumber\":\"561428789\",\"address\":\"Premises 234 \u0026 235\\nFloor 02, Building 16\\nDuibai Internet City\\nÉmirats Arabes Unis\",\"phoneNumber\":\"+971 561883079\",\"email\":\"application@yalla.com\"},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/fr/app/yalla-parch%C3%ADs/id1542713951\",\"userRating\":{\"value\":4.7,\"ratingCount\":42,\"ratingCountList\":[2,1,0,2,37],\"ariaLabelForRatings\":\"4.7 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0.4\",\"genreDisplayName\":\"Jeux de société\",\"name\":\"Yalla Parchís\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Nécessite iPadOS 13.0 ou version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Parchís es un juego gratis de Parchís multijugador que es muy popular en España y América Latina. Las reglas del juego evolucionaron a partir de Ludo, Parchisi y Parcheesi.\\n \\nCaracterísticas:\\n \\n1. Múltiples modos de juego - El juego tiene cuatro reglas: Clásico, Español, Rápido y Mágico. Puedes elegir jugar el modo de 1VS1, 4 Jugadores o Formar equipo.\\n2. Juego con voz y salas de chat - Proporcionamos una experiencia social de alta calidad donde puedes chatear por voz en tiempo real durante el juego y usar las funciones de las salas de chat para conversar con amigos a través de video y audio, enviar regalos, jugar juegos y organizar fiestas. Todos aquí son muy amables.\\n3. Coleccionar diferentes diseños - Puedes jugar gratis y obtener los dados, temas y fichas con diseños variados.\\n4. Actividades ricas - Organizamos regularmente eventos festivos localizados.\\n5. Hasta 30K oros gratis como premios todos los días.\\n\\n En USA y España, el Parchisi se juega con dos dados, y cada jugador tiene cuatro fichas. Los jugadores mueven sus fichas lanzando los dados, y el jugador que mueva las cuatro fichas hasta el final primero gana. En Colombia, también se conoce como Parqués.\\nComo uno de los juegos de Parchís más populares, estamos comprometidos en llevar la jugabilidad clásica del Parchís de la memoria al mundo en línea, con innovación basada en el respeto a la tradición.\\nPuedes comenzar rápidamente un maravilloso viaje de Parchís en cualquier momento y lugar, en el metro, en el parque o en casa, haciendo nuevos amigos en las salas de chat, desde lo online hasta lo offline. Si buscas un juego casual de alta calidad para disfrutar tu tiempo libre, ¡Yalla Parchís no te decepcionará!\\n \\n¡Disfruta la vida, disfruta del Parchís en línea!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"websiteUrl\":\"https://www.yallaparchis.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1.Descubre el nuevo Sistema de Aristocracia y empieza a disfrutar de todos sus beneficios.\\n2.Optimización de experiencia y corrección de errores.\",\"releaseDate\":\"2025-07-21\",\"releaseTimestamp\":\"2025-07-21T13:33:40Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\r\\n1. Sistema de Amistad: ¡Ven a descubrir qué tan cercanos son tú y tus amigos! \\r\\n2. Ayuda entre amigos: ¡Tus amigos pueden ayudarte a reducir el tiempo de espera de los cofres!\\r\\n3. Enviar regalos al observar: Apoya a tu jugador favorito enviándole regalos durante la transmisión de juego en las salas de chat.\\r\\n4. Optimización de experiencia y corrección de errores.\",\"releaseDate\":\"2025-06-01\",\"releaseTimestamp\":\"2025-06-01T02:56:52Z\"},{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Diseños más fáciles de conseguir: Partidas de entradas más altas otorgan cofres de tesoro con mejores diseños. Además, algunas piezas de diseño ya están disponibles para compra directa.\\n2. Almacenamiento de accesorios: ¡Más accesorios nuevos y una gestión más sencilla!\\n3. Fiesta Bingo en las salas de chat: ¡Participa y encuentra tu fortuna!\\n4. Nueva función “Transmisiones de Juegos\\\": ¡Desliza y descubre tu sala favorita! \",\"releaseDate\":\"2025-04-07\",\"releaseTimestamp\":\"2025-04-07T06:57:47Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Nueva oferta para principiantes: un diseño exclusivo de ficha te está esperando.\\n2. Optimización de la experiencia en los minijuegos de las salas de chat.\\n3. Corrección de errores.\",\"releaseDate\":\"2025-01-20\",\"releaseTimestamp\":\"2025-01-20T15:31:43Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. ¡La tienda ha sido renovada! Se han añadido artículos como la tarjeta de Deshacer.\\n2. Se han agregado más regalos exclusivos y privilegios al Club de Miembros.\\n3. Nuevo privilegio exclusivo para el ganador de Estrella Semanal de Regalos.\\n4. Correción de errores.\",\"releaseDate\":\"2025-01-03\",\"releaseTimestamp\":\"2025-01-03T01:50:19Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Se ha añadido el juego “Bingo” en las salas de chat, es GRATIS y se puede personalizar los números. ¡Jueguen juntos!\\n2. Se ha optimizado la indicación de pasos de Parchís, ahora se ve con más claridad.\\n3. Se ha añadido un nuevo modo de sala. ¡Más efectos dinámicos y más diversión!\\n4. Correción de errores.\",\"releaseDate\":\"2024-11-05\",\"releaseTimestamp\":\"2024-11-05T01:46:54Z\"},{\"versionDisplay\":\"1.2.4.1\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Optimizar el movimiento de las fichas y facilitar la operación.\\n2. Solucionar el problema de recibir notificación anormal cuando intenta salir con anticipación al ganar en varios modos. \\n3. Ahora los dueñ@s de sala pueden agregar usuarios a la lista negra introduciendo sus IDs.\\n4. Correción de errores.\",\"releaseDate\":\"2024-09-24\",\"releaseTimestamp\":\"2024-09-24T02:01:04Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Se ha añadido pista de paso en Parchís, con lo cual se ve más claro a cuál casilla llegará la ficha.\\n2. Ahora los dueñ@s de sala pueden agregar usuarios a la lista negra introduciendo sus IDs.\\n3. Correción de errores.\",\"releaseDate\":\"2024-09-11\",\"releaseTimestamp\":\"2024-09-11T03:17:30Z\"},{\"versionDisplay\":\"1.2.3.1\",\"releaseNotes\":\"Las actualizaciones son las siguientes:\\r\\n1. Se ha añadido S.T. puntos en sala de chat y puedes utilizarlos para canjear objetos y en futuras funciones.\\r\\n2. Se ha añadido privilegio de Barón en sala de chat, permitiendo bloquear todos los asientos y eliminar miembros inactivos por lote.\\r\\n3. La regla Carrera ahora es permanente.\\r\\n4. Se ha añadido una visualización de la recompensa en Fusión de Fragmentos.\\r\\n5. Corrección de errores.\",\"releaseDate\":\"2024-07-19\",\"releaseTimestamp\":\"2024-07-19T01:54:14Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"Las actualizaciones son las siguientes:\\r\\n1. Se ha añadido S.T. puntos en sala de chat y puedes utilizarlos para canjear objetos y en futuras funciones.\\r\\n2. Se ha añadido privilegio de Barón en sala de chat, permitiendo bloquear todos los asientos y eliminar miembros inactivos por lote.\\r\\n3. La regla Carrera ahora es permanente.\\r\\n4. Se ha añadido una visualización de la recompensa en Fusión de Fragmentos.\\r\\n5. Corrección de errores.\",\"releaseDate\":\"2024-07-12\",\"releaseTimestamp\":\"2024-07-12T02:11:49Z\"},{\"versionDisplay\":\"1.2.2.1\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\r\\n1. Se ha añadido el modo “Carrera” en las salas VIP y privadas. ¡Invita a tus amigos y ven a experimentar juntos!\\r\\n2. Se ha añadido Tarjeta de EXP de Sala, la cual permite subir el nivel de tu sala.\\r\\n3. Se han añadido marcos de sala, ofreciendo más estilos de exhibición.\\r\\n4. Corrección de errores.\",\"releaseDate\":\"2024-05-31\",\"releaseTimestamp\":\"2024-05-31T02:00:50Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"Bienvenido a Yalla Parchís, las actualizaciones son las siguientes:\\n1. Se ha añadido el modo “Carrera” en las salas VIP y privadas. ¡Invita a tus amigos y ven a experimentar juntos!\\n2. Se ha añadido Tarjeta de EXP de Sala, la cual permite subir el nivel de tu sala.\\n3. Se han añadido marcos de sala, ofreciendo más estilos de exhibición.\\n4. Corrección de errores.\",\"releaseDate\":\"2024-05-27\",\"releaseTimestamp\":\"2024-05-27T02:00:38Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"Bienvenidos a Yalla Parchis, las actualizaciones son las siguientes:\\n1.Optimización del inicio de la aplicación para reducir el tiempo de carga.\\n2. Cambio del filtro por defecto a \\\"Desbloqueado\\\", para reducir operaciones accidentales.\\n3. Compra de alcancía solo disponible cuando esté llena, para reducir las compras errónea.\\n4. Más niveles y iconos de honor de Club de Miembros.\\n5. Optimización de la lista de salas para mostrar más salas destacadas y contenidos interesantes.\\n6. Corrección de errores.\",\"releaseDate\":\"2024-04-03\",\"releaseTimestamp\":\"2024-04-03T01:56:16Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Bienvenido a Yalla Parchis, las actualizaciones son las siguientes:\\r\\n1. Se ha añadido el nuevo modo \\\"Carrera\\\": ¡te esperan más accesorios interesantes y\\r reglas emocionantes!\\n\\n2. Se han añadido nuevas herramientas a las salas de chat: Temporizador y\\r Cronómetro. \\n3.Se ha mejorado la experiencia del juego y arreglado ciertos errores.\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T03:20:02Z\"},{\"versionDisplay\":\"1.1.9\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. La última actualización contiene los siguientes mejoramientos:\\n1. Ahora puedes ver los partidos en la sala de chat. Es aún más divertido chatear con tus amigos mientras ves los partidos. \\n2. Se ha mejorado la experiencia del juego y arreglado ciertos errores.\",\"releaseDate\":\"2023-11-24\",\"releaseTimestamp\":\"2023-11-24T02:04:37Z\"},{\"versionDisplay\":\"1.1.8.1\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. La última actualización contiene los siguientes mejoramientos:\\n1. Se han agregado más premios de ver anuncios. Concretamente, se pueden obtener pontenciadores de bingo, oportunidades gratis de deshacer y acelerar la apertura de los cofres. \\n2. Se ha agregado un nuevo juego: adivinar números. ¡Ahora inténtalo con tus amigos!\\n3. Se ha mejorado la experiencia del juego y arreglado ciertos errores.\",\"releaseDate\":\"2023-09-26\",\"releaseTimestamp\":\"2023-09-26T15:35:13Z\"},{\"versionDisplay\":\"1.1.8\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. La última actualización contiene los siguientes mejoramientos:\\n1. Se han agregado más premios de ver anuncios. Concretamente, se pueden obtener pontenciadores de bingo, \\noportunidades gratis de deshacer y acelerar la apertura de los cofres. \\n2. Se ha agregado un nuevo juego: adivinar números. ¡Ahora inténtalo con tus amigos!\\n3. Se ha mejorado la experiencia del juego y arreglado ciertos errores.\",\"releaseDate\":\"2023-09-13\",\"releaseTimestamp\":\"2023-09-13T02:17:38Z\"},{\"versionDisplay\":\"1.1.7\",\"releaseNotes\":\"¡Bienvenidos a Yalla Parchís! He aquí los contenidos de la actualización:\\r\\n1. Se añadió la regla \\\" Mágica\\\" en salas VIP. \\n2. Nueva función \\\"Circulo de Ondas Soronas\\\" en salas de chat. \\n3. Optimizar la experiencia de juego y corregir los errores.\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T02:10:42Z\"},{\"versionDisplay\":\"1.1.6.2\",\"releaseNotes\":\"1.Optimizar los premios de registrar de novatos.\\n2.Nueva función \\\"Beneficios Gratis\\\" - Ver anuncio para obtener más premios.\\n3.Optimizar los premios de tareas de Club de Miembros. \",\"releaseDate\":\"2023-06-18\",\"releaseTimestamp\":\"2023-06-18T12:57:52Z\"},{\"versionDisplay\":\"1.1.6.1\",\"releaseNotes\":\"1.Optimizar los premios de registrar de novatos.\\n2.Nueva función \\\"Beneficios Gratis\\\" - Ver anuncio para obtener más premios.\\n3.Optimizar los premios de tareas de Club de Miembros. \",\"releaseDate\":\"2023-06-09\",\"releaseTimestamp\":\"2023-06-09T02:28:20Z\"},{\"versionDisplay\":\"1.1.6\",\"releaseNotes\":\"1.Optimizar los premios de registrar de novatos.\\n2.Nueva función \\\"Beneficios Gratis\\\" - Ver anuncio para obtener más premios.\\n3.Optimizar los premios de tareas de Club de Miembros. \",\"releaseDate\":\"2023-05-31\",\"releaseTimestamp\":\"2023-05-31T02:00:14Z\"},{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"1.Se añadió la nueva función \\\"Alcancía\\\". Puede depositar diamantes con jugar Parchís y Bingo en la Alcancía. Cuando está llenada, puede abrirlo y ganar un montón de diamantes.\\n2.Se mejoró la función de \\\"Fusión de Fragmentos\\\". Ya puede usar piezas de diseños bloqueos para fusinar.\\n3.Se añadió la nueva función \\\"Verdad o Reto\\\" en Salas de Chat. No dude en intentarlo con sus amigos.\",\"releaseDate\":\"2023-03-30\",\"releaseTimestamp\":\"2023-03-30T07:00:59Z\"},{\"versionDisplay\":\"1.1.4.1\",\"releaseNotes\":\"1.Se añadió la nueva regla Mágico en Parchís, ¡es una regla más rápida y divertida!\\n2.Se añadió la Fusión de Fragmentos de diseños. \\n3.Se añadió el ranking de Show de Luces en salas de chat.\",\"releaseDate\":\"2023-02-08\",\"releaseTimestamp\":\"2023-02-08T01:30:01Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"1.Se añadió la nueva regla Mágico en Parchís, ¡es una regla más rápida y divertida!\\r\\n2.Se añadió la Fusión de Fragmentos de diseños. \\r\\n3.Se añadió el ranking de Show de Luces en salas de chat.\",\"releaseDate\":\"2023-01-18\",\"releaseTimestamp\":\"2023-01-18T14:37:19Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"¡Bienvenidos a Yalla Parchís! he aquí los contenidos de actualización:\\r\\n1.Privilegios VIP3: ¡Hazte VIP3 para desbloquear beneficios exclusivos como una ganancia de EXP más rápida, comentarios con efectos especiales y mucho más!\\r\\n2.Juego en Salas VIP: Ahora puedes jugar Parchís en Salas VIP sin 'deshacer' ni 'bloquear'.\\r\\n3.Emoticonos del chat: Ahora puedes elegir y enviar varios emoticones dinámicos en las salas de chat.\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:19:50Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"usesExternalPurchase\":false,\"editorialNotes\":{\"tagline\":\"Jouez et discutez entre amis\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=876568445\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":301636608}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=876568445\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":301636608}]}],\"requires32bit\":false,\"usesExternalLinkPurchase\":false,\"releas