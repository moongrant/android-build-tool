erName\":\"سمسم@$\",\"title\":\"Déçue\"}},{\"id\":\"1637551115\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2017-06-08T13:02:22Z\",\"developerResponse\":{\"id\":919949,\"body\":\"Teşekkür ederiz. Umarım yalla ile hayatınıza renk katmışızdır.\",\"modified\":\"2017-08-02T03:00:10Z\"},\"review\":\"C'est super on rencontre plein de gens extra\",\"rating\":4,\"isEdited\":false,\"title\":\"Super\",\"userName\":\"Himmaa\"}},{\"id\":\"9205041817\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2022-10-20T22:23:56Z\",\"developerResponse\":{\"id\":32811047,\"body\":\"Dear users, Yalla supports multiple top-up payments: Visa/Mastercard/Google Card/iTunes/PayPal/Phone Balance. You can add payment methods to your store account and click your profile in Yalla Picture to enter the \\\"Wallet\\\" page and top up. If you still have questions, you can contact us through Feedback, hope to get your five-star evaluation, and wish you a happy life\",\"modified\":\"2022-10-27T06:11:50Z\"},\"review\":\"Purchase could not be completed while I am\\nTrying to buy\",\"rating\":1,\"isEdited\":false,\"title\":\"Unable to purchase\",\"userName\":\"jerryyyy07\"}},{\"id\":\"2422771885\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2018-04-14T18:29:14Z\",\"review\":\"The best app 👑👑\",\"rating\":5,\"isEdited\":false,\"title\":\"Amazing\",\"userName\":\"Chouroukdz\"}},{\"id\":\"2221819907\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2018-02-18T13:54:51Z\",\"review\":\"B1\",\"rating\":5,\"isEdited\":false,\"userName\":\"•H•B•H•\",\"title\":\"B1\"}},{\"id\":\"1641253307\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2017-06-11T22:11:09Z\",\"review\":\"Thanks\",\"rating\":5,\"isEdited\":false,\"title\":\"Good program\",\"userName\":\"Azert-123\"}},{\"id\":\"1596469861\",\"type\":\"user-reviews\",\"attributes\":{\"date\":\"2017-04-24T10:24:40Z\",\"review\":\"Tooooop\",\"rating\":5,\"isEdited\":false,\"title\":\"Top\",\"userName\":\"Kemptreez 111\"}},{\"id\":\"842