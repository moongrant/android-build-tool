ore.iTunes":"iTunes","WEA.LocalNav.Title.Preview.AM":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.AppStore":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.Books":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.MAS":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.Podcasts":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.TV":"@@qualifier@@@@product@@","WEA.LocalNav.Title.Preview.iBooks":"@@qualifier@@ @@product@@","WEA.LocalNav.Title.Preview.iTunes":"@@qualifier@@ @@product@@","WEA.MusicPages.Riaa.Explicit.AX":"Avis parental contenu explicite","WEA.PaddleNav.Next.AX":"Suivant","WEA.PaddleNav.Previous.AX":"Retour","WEA.StarRating.Separator":" • ","WEA.WinBack.Body":"Une fois mis à jour, vous pouvez utiliser le lien de l’offre promotionnelle pour activer cet abonnement.","WEA.WinBack.DirectionalTitle":"Pour mettre à jour votre logiciel, suivez ces étapes :","WEA.WinBack.Subhead":"Cette offre est réservée aux appareils Apple utilisant la dernière version d’iOS, d’iPadOS ou de macOS.","WEA.WinBack.Title":"Impossible d’utiliser cette offre","WEA.WinBack.Update.ios":"Sur iPhone et iPad, accédez à Réglages \u003e Général \u003e Mise à jour logicielle.","WEA.WinBack.Update.macos":"Sur Mac, accédez à Réglages Système \u003e Général \u003e Mise à jour de logiciels.","WFA.Common.Meta.Twitter.site":"@Apple"}}</script><script type="fastboot/shoebox" id="shoebox-media-api-cache-apps">{".v1.catalog.fr.apps.1091902866.l.fr-fr.platform.web.additionalplatforms.appletv.2cipad.2ciphone.2cmac.2crealitydevice.extend.custompromotionaltext.2ccustomscreenshotsbytype.2ccustomvideopreviewsbytype.2cdescription.2cdeveloperinfo.2cdistributionkind.2ceditorialvideo.2cfilesizebydevice.2cmessagesscreenshots.2cprivacy.2cprivacypolicyurl.2crequirementsbydevicefamily.2csellerinfo.2csupporturlforlanguage.2cversionhistory.2cwebsiteurl.2cvideopreviewsbytype.include.app-events.2cgenres.2cdeveloper.2creviews.2cmerchandised-in-apps.2ccustomers-also-bought-apps.2cdeveloper-other-apps.2ctop-in-apps.2crelated-editorial-items.limit.5bmerchandised-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1753308830070,\"d\":[{\"id\":\"1091902866\",\"type\":\"apps\",\"href\":\"/v1/catalog/fr/apps/1091902866?l=fr-FR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données utilisées pour vous suivre\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Les données suivantes peuvent être utilisées pour vous suivre dans plusieurs apps et sites web appartenant à d’autres sociétés :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Données établissant un lien avec vous\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Achats\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Localisation\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Coordonnées\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Contenu utilisateur\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Historique de recherche\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Données d’utilisation\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\",\"Scènes rares/modérées réservées aux adultes (suggestives)\",\"Scènes rares/modérées d’horreur ou d’épouvante\",\"Scènes rares/modérées à caractère sexuel ou de nudité\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"sellerInfo\":{\"isTrader\":true,\"name\":\"Yalla Technology FZ-LLC\",\"dunsNumber\":\"561428789\",\"address\":\"Premises 234 \u0026 235\\nFloor 02, Building 16\\nDuibai Internet City\\nÉmirats Arabes Unis\",\"phoneNumber\":\"+971 561883079\",\"email\":\"application@yalla.com\"},\"usesLocationBackgroundMode\":false,\"url\":\"https://apps.apple.com/fr/app/yalla-play-game-voice-chat/id1091902866\",\"userRating\":{\"value\":4.2,\"ratingCount\":159,\"ratingCountList\":[19,6,7,21,106],\"ariaLabelForRatings\":\"4.2 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"2.4.0\",\"genreDisplayName\":\"Divertissement\",\"name\":\"Yalla - Play Game \u0026 Voice Chat\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"sellerLabel\":\"Fournisseur\",\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 13.0 ou version ultérieure.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Nécessite macOS 11.0 ou une version ultérieure et un Mac doté d’une puce Apple M1 ou une version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"hasEula\":true,\"platformAttributes\":{\"ios\":{\"seller\":\"Yalla Technology FZ-LLC\",\"copyright\":\"© 2025 Yalla Technology FZ-LLC\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Play, Chat, and Connect – All in One Place!\\nLooking for a fun, engaging way to play games and chat with friends? Yalla brings together casual games and voice chat rooms, creating an unmatched social experience. Whether you're a fan of classic games or love connecting with new people, we’ve got you covered!\\n\\nKey Features:\\nCasual Games to Enjoy Anytime\\n- Play popular games like Ludo, Carrom, UMO, and Baloot with friends or other players worldwide.\\n- Immerse yourself in friendly competitions, challenge players worldwide, and climb the leaderboards to prove your skills.\\n- Stay tuned—more exciting games are coming soon!\\n\\nVoice Chat Rooms\\n- Join voice chat rooms to talk, laugh, and make new friends. Thousands of voice chat rooms are waiting for you.\\n- Go on the mic, send messages in chat, or exchange virtual gifts to enhance the fun.\\n- Play mini-games directly in the room for a lively group experience.\\n\\n1-on-1 Private Chat\\n- Connect deeper with friends through private chat. Share messages, voice notes, and more in a personal space.\\n\\nPost and Share\\n- Share your thoughts, game achievements, or fun moments with the community posts feature. Let others know what you're up to!\\n\\nWhy Choose Our App?\\n- All-in-One Experience: Play games, chat, and socialize in one seamless app.\\n- Global Community: Meet and interact with people from around the world.\\n- Fun and Interactive: Voice chat, gifts, and games make every moment exciting.\\n\\nFollow us to get the latest news, updates and events:\\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\\nWebsite: www.yalla.live\\nDear YALLA users, your feedback and suggestions are welcome to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"is32bitOnly\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"3.0.0\",\"releaseNotes\":\"1. تم إطلاق ألعاب جديدة رائعة، اجعل وقت فراغك أكثر تنوعًا ومتعة!\\r\\n2. أصبح من الأسهل الآن اختيار الغرف في بلدان مختلفة.\\n\\n1. New casual games are launched, enriching your entertainment time!\\r\\n2. It's more convenient to select rooms in different countries.\",\"releaseDate\":\"2025-07-23\",\"releaseTimestamp\":\"2025-07-23T01:45:58Z\"},{\"versionDisplay\":\"2.31.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-05-24\",\"releaseTimestamp\":\"2025-05-24T03:55:37Z\"},{\"versionDisplay\":\"2.31.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-05-19\",\"releaseTimestamp\":\"2025-05-19T01:54:02Z\"},{\"versionDisplay\":\"2.31.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-04-16\",\"releaseTimestamp\":\"2025-04-16T01:52:57Z\"},{\"versionDisplay\":\"2.31.0\",\"releaseNotes\":\"1. تم تحسين صفحة الغرف.\\r\\n2. يمكن لمستخدمي VIP تخصيص أيديات خاصة بهم.\\r\\n3. تحسينات أخرى.\\n\\n1. Room page has been optimized.\\r\\n2. VIP users can customize their own IDs.\\r\\n3. Other improvements.\",\"releaseDate\":\"2025-03-26\",\"releaseTimestamp\":\"2025-03-26T01:52:43Z\"},{\"versionDisplay\":\"2.30.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-02-23\",\"releaseTimestamp\":\"2025-02-23T06:09:58Z\"},{\"versionDisplay\":\"2.30.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2025-02-05\",\"releaseTimestamp\":\"2025-02-05T08:26:33Z\"},{\"versionDisplay\":\"2.29.2\",\"releaseNotes\":\"1. التسجيل عبر البريد الإلكتروني وتسجيل الدخول متاح الآن.\\n2. تمت إضافة منشور الشرف عند ترقية الـ VIP والحفاظ على المستوى.\\n3. تحسينات أخرى.\\n\\n1. Registration and login via email are supported now.\\n2. Added VIP upgrade and maintenance honor post.\\n3. Other improvements.\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T01:45:17Z\"},{\"versionDisplay\":\"2.29.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-12-09\",\"releaseTimestamp\":\"2024-12-09T01:47:23Z\"},{\"versionDisplay\":\"2.29.0\",\"releaseNotes\":\"1. تمت إضافة ميزة موضوع المايك - زين غرفتك بموضوعات مايك مختلفة.\\r\\n2. تحسين وتطوير برنامج VIP - رسوم متحركة حصرية للمايك وموضوع المايك لجميع مستخدمي VIP، وخفض متطلبات VIP9 - VIP4، وإجراء تغيير مهم: لن يتم إعادة تعيين نقاط VIP إلى 0 بعد ترقية مستوى VIP.\\r\\n3. تحسينات أخرى.\\n\\n1. Added Mic Theme feature - Decorate your room with different mic themes. \\r\\n2. Improved VIP program - Exclusive mic animation and mic theme for all VIP users, lowered VIP 4 - VIP 9 requirements, and an important change: VIP points won't be reset to 0 after a VIP level upgrade. \\r\\n3. Other improvements.\",\"releaseDate\":\"2024-11-27\",\"releaseTimestamp\":\"2024-11-27T01:54:10Z\"},{\"versionDisplay\":\"2.28.0\",\"releaseNotes\":\"1. البطاقة الشهرية - قم بشرائها لتحصل على المزيد من القطع الذهبية بتكلفة أقل.\\r\\n2. مكافآت استدعاء الأصدقاء - قم بدعوة أصدقائك للعودة إلى يلا للحصول على مكافآت مختلفة.\\r\\n3. تحسينات أخرى.\\n\\n1. Month Card - Buy it to get more golds with less money.\\r\\n2. Recall Friends Rewards - Invite your friends to return to Yalla to get various rewards.\\r\\n3. Other improvements.\",\"releaseDate\":\"2024-09-27\",\"releaseTimestamp\":\"2024-09-27T15:19:38Z\"},{\"versionDisplay\":\"2.27.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-07-29\",\"releaseTimestamp\":\"2024-07-29T01:36:13Z\"},{\"versionDisplay\":\"2.27.0\",\"releaseNotes\":\"1. تم إطلاق قاعة معرض الهدايا. قم بإضاءة هدايا المعرض لفتح شارات المعرض.\\r\\n2. تمت إضافة أخبار المنصة لعرض الأحداث المهمة في الوقت الفعلي مثل إرسال هدايا المنصة، وترقية مستوى VIP، وما إلى ذلك.\\r\\n3. تحسينات أخرى.\\n\\n1. Gift Exhibition Hall is launched. Light up exhibition gifts to unlock exhibition badges.\\r\\n2. Added platform news to display important real-time events like sending platform gifts, upgrading VIP level, etc.\\r\\n3. Other improvements.\",\"releaseDate\":\"2024-06-28\",\"releaseTimestamp\":\"2024-06-28T01:50:28Z\"},{\"versionDisplay\":\"2.26.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-06-06\",\"releaseTimestamp\":\"2024-06-06T01:47:13Z\"},{\"versionDisplay\":\"2.26.1\",\"releaseNotes\":\"1. يمكنك إرسال الهدايا لجميع أعضاء الفريق في وقت واحد في لعبة كرة القدم المجنونة.\\n2. تحسينات أخرى\\n\\n1. You can give gifts to all team members at once in the Crazy Football game.\\n2. Other improvements\",\"releaseDate\":\"2024-05-08\",\"releaseTimestamp\":\"2024-05-08T01:59:23Z\"},{\"versionDisplay\":\"2.26.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T01:56:32Z\"},{\"versionDisplay\":\"2.25.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T01:47:59Z\"},{\"versionDisplay\":\"2.24.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-24\",\"releaseTimestamp\":\"2024-01-24T01:47:39Z\"},{\"versionDisplay\":\"2.24.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2024-01-03\",\"releaseTimestamp\":\"2024-01-03T01:50:11Z\"},{\"versionDisplay\":\"2.23.7\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-24\",\"releaseTimestamp\":\"2023-12-24T01:44:57Z\"},{\"versionDisplay\":\"2.23.6\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-22\",\"releaseTimestamp\":\"2023-12-22T01:32:44Z\"},{\"versionDisplay\":\"2.23.5\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-12-19\",\"releaseTimestamp\":\"2023-12-19T13:43:38Z\"},{\"versionDisplay\":\"2.23.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-11-22\",\"releaseTimestamp\":\"2023-11-22T01:43:27Z\"},{\"versionDisplay\":\"2.23.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-24\",\"releaseTimestamp\":\"2023-10-24T01:23:56Z\"},{\"versionDisplay\":\"2.23.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T01:33:00Z\"}],\"websiteUrl\":\"http://www.yalla.live\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"usesExternalPurchase\":false,\"hasSafariExtension\":false,\"languageList\":[\"Anglais\",\"Arabe\",\"Espagnol\",\"Hindi\",\"Indonésien\",\"Ourdou\",\"Portugais\",\"Turc\"],\"messagesScreenshots\":{},\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=876209210\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"priceString\":\"0.00\",\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\"