",\"href\":\"/v1/catalog/fr/apps/1526086695?l=fr-FR\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Données utilisées pour vous suivre\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Les données suivantes peuvent être utilisées pour vous suivre dans plusieurs apps et sites web appartenant à d’autres sociétés :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Données établissant un lien avec vous\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsFrance\":{\"name\":\"France 18\",\"value\":600,\"rank\":47,\"advisories\":[\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\",\"Scènes rares/modérées de consommation ou de référence à l’alcool, au tabac ou à la drogue\",\"Scènes fréquentes/intenses réservées aux adultes (suggestives)\",\"Scènes rares/modérées à caractère sexuel ou de nudité\"]},\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\",\"Scènes rares/modérées de consommation ou de référence à l’alcool, au tabac ou à la drogue\",\"Scènes fréquentes/intenses réservées aux adultes (suggestives)\",\"Scènes rares/modérées à caractère sexuel ou de nudité\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"sellerInfo\":{\"isTrader\":true,\"name\":\"FUNI. PTE. LTD.\",\"dunsNumber\":\"659773336\",\"address\":\"21 Bukit Batok Crescent\\n#029-84 Wcega Tower\\nSingapore  658065\\nSingapour\",\"phoneNumber\":\"+65 81572579\",\"email\":\"melive20200715@gmail.com\"},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/fr/app/hiya-group-voice-chatroom/id1526086695\",\"userRating\":{\"value\":3.9,\"ratingCount\":105,\"ratingCountList\":[24,2,3,10,66],\"ariaLabelForRatings\":\"3.9 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.3\",\"genreDisplayName\":\"Divertissement\",\"name\":\"Hiya - Group Voice Chatroom\",\"isPreorder\":false,\"artistName\":\"FUNI.PTE.LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Hiya is a fantastic voice chat app. You can share your life with people all over the world, talk freely to your friends, and enjoy an online party anytime and anywhere. Exciting in-app features are provided to enrich your experience. \\n\\nVoice Chat Room \\nJoin a group chat room and enjoy your live party with friends.  Hiya is an amazing app to let you talk to interesting people easily. Whatever you are passionate about, we have a chat room for you.\\n\\nGame Center\\nPlay games together in a chat group. With awesome leisure games, you will never get bored.\\n\\nVoice Match \\nCreate your own voice profile and find your perfect voice. \\n\\nRespectful Community\\nIn our community which is based on mutual respect among users, you can spend an enjoyable and relaxing time here.\\n\\nFast And Easy Login\\nHiya supports login with your Facebook, Google accounts or your phone number.\\n\\nGet ready to have an amazing voice chat with your friends.\\nIf you have any feedback or questions, please contact: support@mehiya.com\\nFeel free to leave any comments.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabiliti