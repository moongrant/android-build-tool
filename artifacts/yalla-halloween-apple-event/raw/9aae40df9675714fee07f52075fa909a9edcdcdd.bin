Ratings\":\"3.9 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.3\",\"name\":\"Рlаnq Rencontre libеrtine Line\",\"genreDisplayName\":\"Divertissement\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Top dating apps\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 9.0 ou version ultérieure.\",\"devices\":[\"iPhone 5S\",\"iPhone 6\",\"iPhone 6 Plus\",\"iPhone 6S\",\"iPhone 6S Plus\",\"iPhone SE (1re génération)\",\"iPhone 7\",\"iPhone 7 Plus\",\"iPhone 8\",\"iPhone 8 Plus\",\"iPhone X\",\"iPhone XS\",\"iPhone XS Max\",\"iPhone XR\",\"iPhone 11\",\"iPhone 11 Pro\",\"iPhone 11 Pro Max\",\"iPhone SE (2e génération)\",\"iPhone 12 mini\",\"iPhone 12\",\"iPhone 12 Pro\",\"iPhone 12 Pro Max\",\"iPhone 13 Pro\",\"iPhone 13 Pro Max\",\"iPhone 13 mini\",\"iPhone 13\",\"iPhone SE (3ᵉ génération)\",\"iPhone 14\",\"iPhone 14 Plus\",\"iPhone 14 Pro\",\"iPhone 14 Pro Max\",\"iPhone 15\",\"iPhone 15 Plus\",\"iPhone 15 Pro\",\"iPhone 15 Pro Max\",\"iPhone 16\",\"iPhone 16 Plus\",\"iPhone 16 Pro\",\"iPhone 16 Pro Max\",\"iPhone 16e\"]},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 9.0 ou version ultérieure.\",\"devices\":[\"iPod touch (6e génération)\",\"iPod touch (7e génération)\"]},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Nécessite macOS 11.0 ou une version ultérieure et un Mac doté d’une puce Apple M1 ou une version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Create stories, meet new people, enjoy live connection - it’s all about Video Line. Cool experience to express yourself and connect with friends.\\n\\nWe want you to be entertained and inspired. Post photos and videos, share what you’re up to and see what's new from others. Explore our global community and top content.\\n\\nBe in touch. Be close. Be cool. Enjoy the content and skip boring pics. Manage your own video space. Get likes and attention.\\n\\nVideo Line is a perfect spot to meet people by video calls and endless stories to share every moment of your life.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2.8\",\"releaseNotes\":\"Localizations\",\"releaseDate\":\"2025-07-11\",\"releaseTimestamp\":\"2025-07-11T14:18:34Z\"},{\"versionDisplay\":\"2.7\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2023-01-05\",\"releaseTimestamp\":\"2023-01-05T13:36:28Z\"},{\"versionDisplay\":\"2.5\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-08-27\",\"releaseTimestamp\":\"2022-08-27T20:44:32Z\"},{\"versionDisplay\":\"2.4\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-08-19\",\"releaseTimestamp\":\"2022-08-19T00:09:42Z\"},{\"versionDisplay\":\"2.3\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-06-24\",\"releaseTimestamp\":\"2022-06-24T20:28:28Z\"},{\"versionDisplay\":\"2.2\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-05-25\",\"releaseTimestamp\":\"2022-05-25T16:57:07Z\"},{\"versionDisplay\":\"2.1\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-05-19\",\"releaseTimestamp\":\"2022-05-19T23:46:24Z\"},{\"versionDisplay\":\"2.0\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-04-26\",\"releaseTimestamp\":\"2022-04-26T22:59:52Z\"},{\"versionDisplay\":\"1.9\",\"releaseNotes\":\"This update contains stability improvements and bug fixes.\",\"releaseDate\":\"2022-03-25\",\"releaseTimestamp\":\"2022-03-25T03:00:32Z\"},{\"versionDisplay\":\"1.8\",\"r