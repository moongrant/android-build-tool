fier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées et liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Données n’établissant aucun lien avec vous\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Les données suivantes peuvent être collectées, mais elles ne sont pas liées à votre identité :\",\"dataCategories\":[{\"dataCategory\":\"Identifiants\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostic\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsFrance\":{\"name\":\"France 18\",\"value\":600,\"rank\":47,\"advisories\":[\"Accès au Web non contrôlé.\",\"Scènes rares/modérées réservées aux adultes (suggestives)\",\"Simulations fréquentes/intenses de jeu de hasard\",\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\"]},\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Accès au Web non contrôlé.\",\"Scènes rares/modérées réservées aux adultes (suggestives)\",\"Simulations fréquentes/intenses de jeu de hasard\",\"Scènes rares/modérées d’humour vulgaire ou blasphématoire\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"sellerInfo\":{\"isTrader\":true,\"name\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"dunsNumber\":\"412499342\",\"address\":\"Chine Continentale\\nGUANGDONG\\nShenzhen\\nA1901,Building 10,No.10,Gaoxin South 9th Road\\nHigh tech District Community,Nanshan District\\n518001\",\"phoneNumber\":\"+86 18814226632\",\"email\":\"HKhuanyu@iyinguo.com\"},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/fr/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.2,\"ratingCount\":45,\"ratingCountList\":[7,1,0,4,33],\"ariaLabelForRatings\":\"4.2 étoiles\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Divertissement\",\"name\":\"Falla-Make new friends\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Nécessite iOS 12.0 ou version ultérieure.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Nécessite visionOS 1.0 ou version ultérieure.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"9.0.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-07-14\",\"releaseTimestamp\":\"2025-07-14T02:18:42Z\"},{\"versionDisplay\":\"8.9.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-06-28\",\"releaseTimestamp\":\"2025-06-28T05:00:04Z\"},{\"versionDisplay\":\"8.9.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixe