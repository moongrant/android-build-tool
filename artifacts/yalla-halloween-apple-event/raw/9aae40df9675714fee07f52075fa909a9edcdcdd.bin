.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"400f0b\",\"textColor1\":\"f2bf2d\",\"textColor2\":\"d39322\",\"textColor3\":\"ce9b26\",\"textColor4\":\"b6791d\"}]},\"customVideoPreviewsByType\":{\"iphone_6_5\":[{\"previewFrame\":{\"width\":886,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo126/v4/82/22/2f/82222fc5-84cd-e46a-f4cc-7689b958b0ab/Jobffaf0578-8c5f-4c2d-ade9-4ac1fbffd2c4-151218832-PreviewImage_preview_image_nonvideo_sdr-Time1686297589634.png/{w}x{h}{c}.{f}\",\"bgColor\":\"775852\",\"textColor1\":\"e2edfb\",\"textColor2\":\"f0c8a0\",\"textColor3\":\"cdcfd9\",\"textColor4\":\"d8b291\"},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo126/v4/73/ee/b6/73eeb6a9-a125-e962-2746-c830e1b9466e/P588793136_default.m3u8\"}],\"iphone6+\":[{\"previewFrame\":{\"width\":1080,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/ca/a3/72/caa372cd-5b12-1faf-996d-90130d9824e9/Job0b3881e4-fbe4-4f35-9d5f-0e99686a99d1-149790423-PreviewImage_preview_image_nonvideo_sdr-Time1683596522475.png/{w}x{h}{c}.{f}\",\"bgColor\":\"3a1516\",\"textColor1\":\"e8edfc\",\"textColor2\":\"e4ba94\",\"textColor3\":\"c5c1ce\",\"textColor4\":\"c2997b\"},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo116/v4/33/f9/66/33f9665f-9510-ae20-4016-d31bdd84aa34/P578436381_default.m3u8\"}]}}}}}},\"fileSizeByDevice\":{\"iPad14,11\":269528064,\"iPhone13,4\":274551808,\"iPad14,10\":269528064,\"iPhone13,3\":274551808,\"iPhone13,2\":274551808,\"iPhone13,1\":274551808,\"iPhone6,1\":279865344,\"iPhone6,2\":279865344,\"iPad8,12\":269943808,\"iPad8,11\":269943808,\"iPad8,10\":269943808,\"iPhone17,4\":274131968,\"iPhone17,3\":274131968,\"iPad14,6-A\":269528064,\"iPhone17,2\":274131968,\"iPhone17,1\":274131968,\"iPad14,6-B\":269528064,\"iPhone17,5\":274131968,\"iPad16,6-B\":269528064,\"iPad7,6\":279934976,\"iPad7,5\":279934976,\"iPad7,4\":279934976,\"iPad16,6-A\":269528064,\"iPad7,3\":279934976,\"iPad7,2\":279934976,\"Real