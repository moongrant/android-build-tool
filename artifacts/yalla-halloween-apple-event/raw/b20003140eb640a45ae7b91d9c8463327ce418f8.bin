":"com.chatvoice.whisper","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9254901960784314,"green":0.47843137254901963,"blue":0.6078431372549019,"type":"rgb"},"textColor":{"red":0.08627450980392157,"green":0.0784313725490196,"blue":0.0784313725490196,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/c7/56/95/c7569552-dc3d-2ba2-3d77-507b6d0079ce/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"ويسبر - دردشة و ألعاب","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Entertainment","tertiaryTitle":"Designed for iPhone.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"ageRating":"16+","productDescription":"\"التواصل مع الأصدقاء بدون حواجز\nويسبر هو مجتمع دردشة صوتية الأكثر شعبية، يمكنك هنا الدردشة بشكل آمن مع أصدقاء من جميع انحاء العالم، أمريكا، بريطانيا، السعودية، الإمارات، قطر، ألمانيا... لغة الدولة، او المسافات لا تعتبر أبداً حاجزاً لتواصلك معهم، مجاني كليا!\n\nالتعرف على أصدقاء بشكل آمن\nعندما تشعر بالحاجة للسلام و الطمأنينة، الراحة النفسية، التحكم بالنفس، الثقة، الرضا او اي شيء آخر، يمكنك التحدث مع أصدقاءك هنا بشكل آمن، و سوف تحصل على الراحة.\n\nمميزات رائعة:\nغرف محادثات صوتية مجانية - ويسبر هو تطبيق دردشة صوتية مجاني كليا! يمكنك التواصل مع الأصدقاء في ويسبر بإستخدام 3جي، 4جي ، إل تي إي أو شبكة إنترنت واي فاي، يمكنك التمتع بسرعة خارقة و محادثة صوت بجودة عالية في غرفة الدردشة.\n\nحفلة مجانية - يمكنك عمل حفلة مجانية لعيد ميلاد، زواج، عيد، أو تعليقات في نفس التوقيت على ألعاب كرة القدم أو أي موضوع آخر، تمتع بوقتك هناك.\n\nدخول سريع و سهل - التسجيل فقط في 5 ثواني، يمكنك الدخول إلى ويسبر للتعرف على الأصدقاء بشكل سريع و سهل.\n\nلحظات رائعة - يمكنك مشاهدة اللحظات التي يتم نشرها بواسطة أصدقائك في ويسبر، و يمكنك مشاركة لحظاتك الرائعة أيضاً ليشاهد اصدقاؤك حياتك المميزة.\n\nهدايا مع تأثيرات مذهلة - في غرفة الدردشة يمكنك تبادل الهدايا بتأثيراتها المميزة مع أصدقائك.\n\nالتواصل مع الأصدقاء - يمكنك العثور على صديق جديد من خلال إضافة الأصدقاء وإرسال الرسائل لبعضكم البعض.\n\nألعاب مثيرة - يوجد الكثير من الألعاب الترفيهية المذهلة في ويسبر مجانا، يمكنك لعب الألعاب مع الأصدقاء في غرف الدردشة الصوتية.\n\nمجموعة دردشة\nإذا كنت تفضل مجموعات الدردشة، إنضم إلى ويسبر و يمكنك التواصل مع العديد من الأصدقاء في نفس الوقت و في غرفة دردشة واحدة. يمكنك إقامة حفلات، لعب الكثير من الألعاب المذهلة معهم، تبادل الهدايا و المحبة و الفرحة. إذا كنت تفضل الدردشة مع الأصدقاء، انضم إلى ويسبر ويمكنك العثور على أصدقاء من كل أنحاء العالم والتحدث معهم صوتياً بشكل آمن، دع قلبك وروحك ترتاح هنا.\n\nأفضل مجتمع تواصل إجتماعي أونلاين\nماتزال تشعر بالخجل من التواصل مع الغرباء؟ ماتزال قلقًا على التعرف على أصدقاء جدد من مسافات بعيدة؟ ماتزال منزعج من صعوبة التحدث باللغات المختلفة خلال الدردشة أونلاين مع الأصدقاء الجدد من دول أخرى و مختلفة؟ ويسبر قام بحل كل هذه الصعوبات والعوائق لك، انضم إلى ويسبر لتحصل على افضل تجربة اتصال اجتماعي، و دردش صوتيا مع الأصدقاء الجدد بحرية.\n\nإذا كان لديك إقتراحات أو مراجعات، يرجى التواصل معنا:\"","rating":4.4,"ratingCount":"368","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1514418573&pricingParameters=STDQ&pg=default&appExtVrsId=885070502"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1514418573"},{"locationPosition":0,"locationType":"lockup","name":"ويسبر - دردشة و ألعاب","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1514418573"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1514418573","eventType":"cl