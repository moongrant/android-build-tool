8c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li> </ol></div></div> <div class="review-header svelte-1hjpbwc"><time class="date svelte-1hjpbwc" datetime="2019-06-07T03:13:37.000Z">07/06/2019</time>  <div class="multiline-clamp svelte-1dta22y" style="--mc-lineClamp: var(--defaultClampOverride, 1);" role="text"> <span class="multiline-clamp__text svelte-1dta22y"><p class="author svelte-1hjpbwc">Taleigha Titchen</p></span> </div></div></div> <div class="content svelte-1hjpbwc">  <div class="truncate-wrapper svelte-10e6dbh"><p data-testid="truncate-text" dir="auto" class="content svelte-10e6dbh" style="--lines: 5; --line-height: var(--lineHeight, 16); --link-length: 4;"><!-- HTML_TAG_START -->I really like this app because I recently moved schools and I miss all of my friends and especially my best friends. And before I knew about this I wanted to talk to another friend but then someone else wanted to talk to me and FaceTime didn’t have that feature at that time so all of my friends told me to get it and I got it and it was nice because I finally got to talk to all of my best friends that I was missing sooooo much!!!! Although sometimes it would cause me and my friends to get in fights and it wasn’t fun. But other than that it has helped me and my close friends that were drifting apart come together even more!!!!<!-- HTML_TAG_END --></p> </div>  </div></div>  <dialog data-testid="dialog" class="svelte-1p01z7" id="" aria-hidden="true"><div data-testid="content-modal" class="content-modal-container svelte-1ih6d3u" dir="auto"><div class="button-container svelte-1ih6d3u"><button data-testid="content-modal-close-button" class="close-button svelte-1ih6d3u" type="button" aria-label="Close"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" data-testid="content-modal-close-button-svg"><path d="M1.2 18C.6 18 0 17.5 0 16.8c0-.4.1-.6.4-.8l7-7-7-7c-.3-.2-.4-.5-.4-.8C0 .5.6 0 1.2 0c.3 0 .6.1.8.3l7 7 7-7c.2-.2.5-.3.8-.3.6 0 1.2.5 1.2 1.2 0 .3-.1.6-.4.8l-7 7 7 7c.2.2.4.5.4.8 0 .7-.6 1.2-1.2 1.2-.3 0-.6-.1-.8-.3l-7-7-7 7c-.2.1-.5.3-.8.3z"></path></svg></button> </div> <div class="header-container svelte-1ih6d3u"><h1 data-testid="content-modal-title" class="title svelte-1ih6d3u">My Opinion of Houseparty</h1> </div> <div class="content-container svelte-1ih6d3u"><div class="container svelte-1hjpbwc is-detail-view" aria-labelledby="review-4275586546-title" dir="ltr"><div class="header svelte-1hjpbwc"><div class="title-and-rating-container svelte-1hjpbwc"> <div style="display: contents; --fill-color:var(--systemOrange); --star-size:24px;"><ol class="stars svelte-1fdd9o7" aria-label="5 Stars"><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718