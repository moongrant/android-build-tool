extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=top-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-GB","destination":{"storefront":"ae","language":"en-GB","$kind":"ProductPageIntent","id":"1544887147","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1544887147","name":"101 Okey Yalla: Live & Chat","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":7,"contentRating":313,"bundleId":"com.yalla.okey101yalla"}}},{"$kind":"Lockup","adamId":"6752764540","bundleId":"com.yalla.yallajalsat","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.44313725490196076,"green":0.8901960784313725,"blue":0.6274509803921569,"type":"rgb"},"textColor":{"red":0.10196078431372549,"green":0.11372549019607843,"blue":0.11372549019607843,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/75/e9/d1/75e9d147-9b31-f0d1-3e2a-c50a040df7d6/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Jalsat: Play & Chat","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Play Hand,Ludo,Tarneeb&Trix","tertiaryTitle":"Designed for iPhone.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Play Hand,Ludo,Tarneeb&Trix","ageRating":"9+","productDescription":"Enjoy great gaming time with Jalsat – a vast selection of fun card and board games, no ads included! Connect with millions of players worldwide, play with real opponents anytime, and enjoy non-stop fun. It also has chat rooms to meet cool friends.\n\nJalsat brings you beloved popular games — with various exciting modes to suit every mood! \nHand - Hand & Hand Saudi\nDomino - Draw & All Five\nLudo - Classic & Quick & Master\nJackaroo - Quick & Complex & 1v1\nTrix, Trix Complex & Complex CC - Standard & Partner\nBaloot - Classic & Quick\nTarneeb - Standard\nSolitaire - 1v1\nUMO - Standard & Plus\nSnakes and Ladders - Magic\nBanakil - Standard\n\nJalsat offers standout highlights that elevate your gaming experience, such as:\n- Immersive gaming experience: Real-time voice chat paired with lively interactive emojis recreates the thrilling atmosphere of offline gaming!\n- Smooth & Engaging Matches: With clear rules and straightforward controls, you can focus purely on the joy of competing.\n- VIP System: Unlock exclusive badges and rare privileges to showcase your distinguished status and enjoy a unique gaming experience.\n- Proficiency ranking: Track your progress clearly and witness your journey from beginner to Card & Board Master!\n- Wealth Ranking: Climb to the top, showcase your fortune, and earn exclusive rewards and supreme honors!\n- Generous Rewards: Daily login gifts, level-up rewards, and more amazing benefits just keep coming!\n- Exquisite Design: Every detail is carefully crafted to deliver a king-level visual experience.\n- Collector's Edition Skins: Own rare and exclusive designs that showcase your dedication and unique style.\n\n\nJalsat gives you more than just games — you can also enjoy lively chats in our dedicated chat rooms!\nGrab your mic, join the conversation, and dive into vibrant chat sessions! Show off your charm, meet new friends, and enjoy real-time multiplayer voice chat. Ready to rule the chat?\n\nConnect us:\n- Facebook: Jalsat - جلسات\n- Email: jalsat.support@yalla.com","rating":4,"