nguage":"en-GB","$kind":"ProductPageIntent","id":"6737796366","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"6737796366","name":"Yalla Jackaroo - Classic","impressionType":"lockup","idType":"its_id","platformDisplayStyle":"ios","impressionIndex":5,"contentRating":200,"bundleId":"com.yalla.yallajackaroo"}}},{"$kind":"Lockup","adamId":"1542713951","bundleId":"com.yalla.yallaparchisi","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.3568627450980392,"green":0.23137254901960785,"blue":0.4980392156862745,"type":"rgb"},"textColor":{"red":0.8509803921568627,"green":0.8823529411764706,"blue":0.9294117647058824,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/86/c7/88/86c788c3-ed9e-dcce-4106-a51c611a4808/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla Parchis","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Parchis with voice chat","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Parchis with voice chat","editorialTagline":"Play and chat with friends","ageRating":"9+","productDescription":"Yalla Parchis is a free online multiplayer Parchis game, Parchis is a very popular board game, especially in Spain and Latin America. The rules of the game evolved from Ludo, Parchisi and Parcheesi.\n\nFeatures:\n\n1. Multiple Parchis rules & modes - There are four rules: Classic, Spanish, Quick and Magic, and you can choose to play in 1v1, 4 players or in teams(2v2). \n2. In-game voice chat & chat room - We offer a high-quality social experience where you can voice chat in real-time during the game and use the chat room function to chat with audio and video, send gifts, play games, and host parties with your friends in the room. Everyone here is friendly.\n3. Collect diverse skins - Play for free and get a variety of skins of dice, theme, token, etc.\n4. Various events - Festive events with local characteristics are held regularly.\n5. Up to 30K free Golds every day.\n\nIn America and Spain, Parchisi is played with two dice, four tokens per player, and the first player who moves four tokens to the end wins. In Colombia, the Parchis board game is also called \"Parqués\".\nAs one of the most popular Parchis games, we are not only committed to bringing the classic Parchis gameplay from memory to online, but also to innovating while respecting tradition.\nOn the subway, in the park, at home, at any time and place, you can quickly start an amazing Parchis journey and make new friends in chat rooms, from online to offline. If you are looking for a high-quality casual game to enjoy your leisure time, Yalla Parchis will never disappoint you.\n\nEnjoy life, enjoy online Parchis!","rating":4.8,"ratingCount":"5","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1542713951&pricingParameters=STDQ&pg=default&appExtVrsId=883660267"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1542713951"},{"locationPosition":6,"locationType":"lockup","name":"Yalla Parchis","idType":"its_id","id":"1542713951"},{"locationPosition":12,"locationType":"swoosh","name":"More by Yalla Technology FZ-LLC","idType":"sequential","id":"30"}],"jet_adamId":"1542713951","eventType":"click","targetType":"button","targetId":"1542713951","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1542713951"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1542713951","purchas