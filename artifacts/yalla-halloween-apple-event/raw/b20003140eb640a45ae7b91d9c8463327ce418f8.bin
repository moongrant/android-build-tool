nutes later a guy in a car pulls up and ask them if they want a ride and they said it was the same guy that they talked to on holla. So be very careful pls and thank you","rating":5,"reviewerName":"Jeanbaptiste Lowey","dateAuthorText":"* null * · Jeanbaptiste Lowey","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"8","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4286843147","title":".","date":"2019-06-09T03:56:03.000Z","dateText":"* null *","contents":"My sister was on this app and she was talking to guys and she’s only 12 and a couple minutes later a guy in a car pulls up and ask them if they want a ride and they said it was the same guy that they talked to on holla. So be very careful pls and thank you","rating":5,"reviewerName":"Jeanbaptiste Lowey","dateAuthorText":"* null * · Jeanbaptiste Lowey"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1091902866","targetReviewId":"4286843147"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":6}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"4285012808","title":"Has some issues","date":"2019-06-08T19:00:39.000Z","dateText":"* null *","contents":"I had been waiting along time for the fix the app so it stops dropping calls. Other than that I have no other problems.","rating":5,"reviewerName":"Anindita Belsey","dateAuthorText":"* null * · Anindita Belsey","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"9","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4285012808","title":"Has some issues","date":"2019-06-08T19:00:39.000Z","dateText":"* null *","contents":"I had been waiting along time for the fix the app so it stops dropping calls. Other than that I have no other problems.","rating":5,"reviewerName":"Anindita Belsey","dateAuthorText":"* null * · Anindita Belsey"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1091902866","targetReviewId":"4285012808"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":7}}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"allProductReviews"},"userProductReviews":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"21","name":"Most Helpful Reviews","impressionType":"mostHelpfulReviews","idType":"sequential","impressionIndex":2}},"contentType":"productReview","marker":null,"items":[{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"4277751062","title":"Lights off?","date":"2019-06-07T12:55:34.000Z","dateText":"* null *","contents":"I really love FaceTiming all of my friends at once, but I cannot do it on my own phone. When I am house partying on my phone other people can not hear me but I can hear them perfectly fine. I enabled everything except for the Facebook, I’ve uninstalled then reinstalled the app, and I restarted my phone. I even made a new account but it still won’t work! I highly recommend everyone to try the app because it is very safe and I am literally the only one having this problem. But if u could somehow fix this problem, then I would love this app forever and it would deserve a five star review. Sorry for the long review but I really want this fixed. In return it will be five stars ??","rating":5,"reviewerName":"Gabrialla Grombridge","dateAuthorText":"* null * · Gabrialla Grombridge","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"10","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4277751062","title":"Lights off?","date":"2019-06-07T12:55:34.000Z","dateText":"* null *","contents":"I really love FaceTiming all of my friends at once, but I cannot do it on my own phone. When I am house partying on my phone other people can not hear me but I can hear them perfectly fine. I enabled everything except for the Facebook, I’ve uninstalled then reinstalled the app, and I restarted my phone. I even made a new account but it still won’t work! I highly recommend everyone to try the app because it is very safe and I am literally the only one having this problem. But if u could somehow fix this problem, then I would love this app forever and it would deserve a five star review. Sorry for the long review but I really want this fixed. In return it will be five stars ??","rating":5,"reviewerName":"Gabrialla Grombridge","dateAuthorText":"* null * · Gabrialla Grombridge"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1091902866","targetReviewId":"4277751062"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":0}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"4275586546","title":"My Opinion of Houseparty","date":"2019-06-07T03:13:37.000Z","dateText":"* null *","contents":"I really like this app because I recently moved schools and I miss all of my friends and especially my best friends. And before I knew about this I wanted to talk to another friend but then someone else wanted to talk to me and FaceTime didn’t have that feature at that time so all of my friends told me to get it and I got it and it was nice because I finally got to talk to all of my best friends that I was missing sooooo much!!!! Although sometimes it would cause me and my friends to get in fights and it wasn’t fun. But other than that it has helped me and my close friends that were drifting apart come together even more!!!!","rating":5,"reviewerName":"Taleigha Titchen","dateAuthorText":"* null * · Taleigha Titchen","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"11","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4275586546","title":"My Opinion of Houseparty","date":"2019-06-07T03:13:37.000Z","dateText":"* null *","contents":"I really like this app because I recently moved schools and I miss all of my friends and especially my best friends. And before I knew about this I wanted to talk to another friend but then someone else wanted to talk to me and FaceTime didn’t have that feature at that time so all of my friends told me to get it and I got it and it was nice because I finally got to talk to all of my best friends that I was missing sooooo much!!!! Although sometimes it would cause me and my friends to get in fights and it wasn’t fun. But other than that it has helped me and my close friends that were drifting apart come together even more!!!!","rating":5,"reviewerName":"Taleigha Titchen","dateAuthorText":"* null * · Taleigha Titchen"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1091902866","targetReviewId":"4275586546"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"1","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":1}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"4272065528","title":"Best","date":"2019-06-06T11:17:05.000Z","dateText":"* null *","contents":"I think this app is very cool. A huge struggle in youth culture is talking to friends all at once over the phone. This app solves the problem by creating a multiple people FaceTime system available for iPhones and Androids. This app also lets you use fun words such as “_____ is in the House” or “_______ wants to join” etc. This app is easy to use and functional while fun. All of my friends have it and it doesn’t go to waste. You should totally download this app, ASAP!!!","rating":5,"reviewerName":"Tsuyuko Biglin","dateAuthorText":"* null * · Tsuyuko Biglin","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"12","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4272065528","title":"Best","date":"2019-06-06T11:17:05.000Z","dateText":"* null *","contents":"I think this app is very cool. A huge struggle in youth culture is talking to friends all at once over the phone. This app solves the problem by creating a multiple people FaceTime system available for iPhones and Androids. This app also lets you use fun words such as “_____ is in the House” or “_______ wants to join” etc. This app is easy to use and functional while fun. All of my friends have it and it doesn’t go to waste. You should totally download this app, ASAP!!!","rating":5,"reviewerName":"Tsuyuko Biglin","dateAuthorText":"* null * · Tsuyuko Biglin"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1091902866","targetReviewId":"4272065528"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":2}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"9410709314","title":"الاحتيال","date":"2022-12-18T22:22:56.000Z","dateText":"* null *","contents":"تعتبر هذي الشركة غير صادقة في سياساتها . حيث قامت باخذ اموال طائلة مني بدون جدوى من فتح حسابي الجديد ارجو من شركة ابل النظرة في خلفية هذه الشركة حيث تسئ لسمعة المتجر . انصح كل من يقراء هذي الرسالة ان يكون حذر وشكراً\nThis company is not honest in its policies.  As it downloaded a lot of money from me without success in opening my new account. I ask Apple to look into th