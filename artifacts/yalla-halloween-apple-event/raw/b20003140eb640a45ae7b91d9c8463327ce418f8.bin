588235294118,"blue":0.984313725490196,"type":"rgb"},"textColor":{"red":0.0784313725490196,"green":0.08627450980392157,"blue":0.08627450980392157,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/09/50/95/0950951e-e6f0-2867-39b2-d810793079e1/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Hiya - Group Voice Chatroom","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Live Party, Enjoy chat","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Live Party, Enjoy chat","ageRating":"16+","productDescription":"Hiya is a fantastic voice chat app. You can share your life with people all over the world, talk freely to your friends, and enjoy an online party anytime and anywhere. Exciting in-app features are provided to enrich your experience. \n\nVoice Chat Room \nJoin a group chat room and enjoy your live party with friends.  Hiya is an amazing app to let you talk to interesting people easily. Whatever you are passionate about, we have a chat room for you.\n\nGame Center\nPlay games together in a chat group. With awesome leisure games, you will never get bored.\n\nVoice Show \nCreate your own voice profile and find your perfect voice. \n\nRespectful Community\nIn our community which is based on mutual respect among users, you can spend an enjoyable and relaxing time here.\n\nFast And Easy Login\nHiya supports login with your Facebook, Google accounts or your phone number.\n\nGet ready to have an amazing voice chat with your friends.\nIf you have any feedback or questions, please contact: support@mehiya.com\nFeel free to leave any comments.","rating":4.5,"ratingCount":"690","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{