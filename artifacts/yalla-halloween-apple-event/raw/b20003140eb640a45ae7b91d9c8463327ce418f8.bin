://is1-ssl.mzstatic.com/image/thumb/kcZdWRSoerw11J-sBaBHDA/{w}x{h}{c}.{f}","width":1920,"height":1080,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla Season","subtitle":"Join in Yalla Season for Surprise Benefits!","detail":"The limited-time event has begun. Join in the carnival, and win exclusive rewards in the Yalla Season!","startDate":"2026-04-23T02:00:00.000Z","endDate":"2026-05-06T22:00:00.000Z","appEventBadgeKind":"happening","kind":"SPECIAL EVENT","lockup":{"$kind":"Lockup","adamId":"1091902866","bundleId":"com.weieyu.yalla","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.5176470588235295,"green":0.984313725490196,"blue":0.6666666666666666,"type":"rgb"},"textColor":{"red":0.1450980392156863,"green":0.25098039215686274,"blue":0.1843137254901961,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/2c/9d/a8/2c9da851-5ee2-13f6-3ff5-3283cb0ff245/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Yalla - Play Game & Voice Chat","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Game Together, Chat Anytime","tertiaryTitle":"Designed for iPhone.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Game Together, Chat Anytime","editorialTagline":"Chat with friends","ageRating":"13+","productDescription":"Play, Chat, and Connect – All in One Place!\nLooking for a fun, engaging way to play games and chat with friends? Yalla brings together casual games and voice chat rooms, creating an unmatched social experience. Whether you're a fan of classic games or love connecting with new people, we’ve got you covered!\n\nKey Features:\nCasual Games to Enjoy Anytime\n- Play popular games like Ludo, Carrom, UMO, and Baloot with friends or other players worldwide.\n- Immerse yourself in friendly competitions, challenge players worldwide, and climb the leaderboards to prove your skills.\n- Stay tuned—more exciting games are coming soon!\n\nVoice Chat Rooms\n- Join voice chat rooms to talk, laugh, and make new friends. Thousands of voice chat rooms are waiting for you.\n- Go on the mic, send messages in chat, or exchange virtual gifts to enhance the fun.\n- Play mini-games directly in the room for a lively group experience.\n\n1-on-1 Private Chat\n- Connect deeper with friends through private chat. Share messages, voice notes, and more in a personal space.\n\nPost and Share\n- Share your thoughts, game achievements, or fun moments with the community posts feature. Let others know what you're up to!\n\nWhy Choose Our App?\n- All-in-One Experience: Play games, chat, and socialize in one seamless app.\n- Global Community: Meet and interact with people from around the world.\n- Fun and Interactive: Voice chat, gifts, and games make every moment exciting.\n\nFollow us to get the latest news, updates and events:\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\nWebsite: www.yalla.live\nDear YALLA users, your feedback and suggestions are welcome to: yallasupport@yalla.com","rating":4.4,"ratingCount":"1.8k","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"OfferStateAction","actionClass":"OfferStateAction","adamId":"1091902866","defaultAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1091902866&pricingParameters=STDQ&pg=default&appExtVrsId=883495121&mtInAppEventId=6760640722"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","idType":"its_id","id":"1091902866","inAppEventId":"6760640722","relatedSubjectIds":["1091902866"]},{"locationPosition":0,"locationTyp