y","inputType":"decimalPad","isRequired":true,"maximumLength":null}],"isStoreRequest":true,"needsAuthentication":false,"needsMediaToken":false,"retryCount":0,"disableCache":true,"successAction":{"title":"Submitted","artwork":{"$kind":"Artwork","backgroundColor":null,"textColor":null,"style":null,"crop":"bb","contentMode":null,"imageScale":null,"template":"resource://ToastStar.png","width":95,"height":90,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"AlertAction","actionClass":"AlertAction","style":"toast","message":"Thanks for your feedback.","isCancelable":false,"cancelTitle":null,"cancelAction":null,"buttonActions":[],"buttonTitles":[],"destructiveActionIndex":null,"imageName":null},"failureAction":null,"useModernRatingsAPI":false,"adamId":"1091902866"}},"productAction":{"title":"Yalla - Play Game & Voice Chat","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"product","pageUrl":"https://apps.apple.com/ae/app/1091902866?platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"ae","language":"en-GB","$kind":"ProductPageIntent","id":"1091902866","platform":"iphone"}},"writeReviewAction":{"title":"Write a Review","artwork":{"$kind":"Artwork","backgroundColor":null,"textColor":null,"style":null,"crop":"bb","contentMode":null,"imageScale":null,"template":"systemimage://square.and.pencil","width":0,"height":0,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"WriteReviewAction","actionClass":"WriteReviewAction","adamId":"1091902866","url":"?id=1091902866","appName":"Yalla - Play Game & Voice Chat","itemDescription":"Game Together, Chat Anytime","appIcon":{"$kind":"Artwork","backgroundColor":{"red":0.5176470588235295,"green":0.984313725490196,"blue":0.6666666666666666,"type":"rgb"},"textColor":{"red":0,"green":0.03529411764705882,"blue":0.0196078431372549,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/2c/9d/a8/2c9da851-5ee2-13f6-3ff5-3283cb0ff245/Placeholder.mill/{w}x{h}bb-70.png","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]}},"supportAction":{"title":"App Support","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"http://www.yalla.live","isSensitive":false},"alwaysAllowReviews":false}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false},{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"23","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":2}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4277751062","title":"Lights off?","date":"2019-06-07T12:55:34.000Z","dateText":"* null *","contents":"I really love FaceTiming all of my friends at once, but I cannot do it on my own phone. When I am house partying on my phone other people can not hear me but I can hear them perfectly fine. I enabled everything except for the Facebook, I’ve uninstalled then reinstalled the app, and I restarted my phone. I even made a new account but it still won’t work! I highly recommend everyone to try the app because it is very safe and I am literally the only one having this problem. But if u could somehow fix this problem, then I would love this app forever and it would deserve a five star review. Sorry for the long review but I really want this fixed. In return it will be five stars ??","rating":5,"reviewerName":"Gabrialla Grombridge","dateAuthorText":"* null * · Gabrialla Grombridge"},{"$kind":"Review","id":"4275586546","title":"My Opinion of Houseparty","date":"2019-06-07T03:13:37.000Z","dateText":"* null *","contents":"I really like this app because I recently moved schools and I miss all of my friends and especially my best friends. And before I knew about this I wanted to talk to another friend but then someone else wanted to talk to me and FaceTime didn’t have that feature at that time so all of my friends told me to get it and I got it and it was nice because I finally got to talk to all of my best friends that I was missing sooooo much!!!! Although sometimes it would cause me and my friends to get in fights and it wasn’t fun. But other than that it has helped me and my close friends that were drifting apart come together even more!!!!","rating":5,"reviewerName":"Taleigha Titchen","dateAuthorText":"* null * · Taleigha Titchen"},{"$kind":"Review","id":"4272065528","title":"Best","date":"2019-06-06T11:17:05.000Z","dateText":"* null *","contents":"I think this app is very cool. A huge struggle in youth culture is talking to friends all at once over the phone. This app solves the problem by creating a multiple people FaceTime system available for iPhones and Androids. This app also lets you use fun words such as “_____ is in the House” or “_______ wants to join” etc. This app is easy to use and functional while fun. All of my friends have it and it doesn’t go to waste. You should totally download this app, ASAP!!!","rating":5,"reviewerName":"Tsuyuko Biglin","dateAuthorText":"* null * · Tsuyuko Biglin"},{"$kind":"Review","id":"9410709314","title":"الاحتيال","date":"2022-12-18T22:22:56.000Z","dateText":"* null *","contents":"تعتبر هذي الشركة غير صادقة في سياساتها . حيث قامت باخذ اموال طائلة مني بدون جدوى من فتح حسابي الجديد ارجو من شركة ابل النظرة في خلفية هذه الشركة حيث تسئ لسمعة المتجر . انصح كل من يقراء هذي الرسالة ان يكون حذر وشكراً\nThis company is not honest in its policies.  As it downloaded a lot of money from me without success in opening my new account. I ask Apple to look into the background of this company, as it harms the reputation of the store.  I advise everyone who reads this message to be careful and thank you","rating":5,"reviewerName":"Ail gooooo","dateAuthorText":"* null * · Ail gooooo","response":{"$kind":"Response","id":"33889799","contents":"أعزائي المستخدم ، موقع يلا لن يخدع مستخدمي منصتنا أبدًا ، فنحن ملتزمون بإنشاء منصة متناغمة عبر الإنترنت للمستخدمين. إذا واجهت أي مشاكل ، يمكنك إبداء رأيك في التعليقات في التطبيق ، وسنساعدك على حلها في أقرب وقت ممكن ، وأخيرًا نتمنى لك وقتًا سعيدًا في يلا.","date":"2022-12-23T02:53:52.000Z","dateText":"* null *"}},{"$kind":"Review","id":"4272423403","title":"Great","date":"2019-06-06T12:37:00.000Z","dateText":"* null *","contents":"Every time I use Houseparty I am amazed at how good the quality is. On other apps you may use you think the quality is good but with Houseparty the quality is amazing. Other than the quality Houseparty is so easy to use. Also on Houseparty you can talk to as many as you want!! I once talked to 7 people at once. As you can see Houseparty is the best app you can use to talk to your friends...or at least in my opinion.","rating":5,"reviewerName":"Issel MacGarrity","dateAuthorText":"* null * · Issel MacGarrity"},{"$kind":"Review","id":"1957129838","title":"Connection failed","date":"2017-11-29T10:49:41.000Z","dateText":"* null *","contents":"It was working couple months ago and now doesn’t wanna connect it always say connection failed my internet is full and I also used my 4g still not working something went wrong \n\nThe dns doesn’t work 8.8.8.8 please help me out","rating":5,"reviewerName":"Inuttin","dateAuthorText":"* null * · Inuttin","response":{"$kind":"Response","id":"1891617","contents":"Dear, thanks for your kind feedback and wish your find friends here. Please ensure you are using latest version of 2.4.1(old version before 2.4 cannot work now, check APP Store-Update or click the following link directly https://itunes.apple.com/cn/app/yalla.live/id1091902866?l=en&mt=8).","date":"2017-11-30T23:16:11.000Z","dateText":"* null *"}},{"$kind":"Review","id":"4286843147","title":".","date":"2019-06-09T03:56:03.000Z","dateText":"* null *","contents":"My sister was on this app and she was talking to guys and she’s only 12 and a couple minutes later a guy in a car pulls up and ask them if they want a ride and they said it was the same guy that they talked to on holla. So be very careful pls and thank you","rating":5,"reviewerName":"Jeanbaptiste Lowey","dateAuthorText":"* null * · Jeanbaptiste Lowey"},{"$kind":"Review","id":"4285012808","title":"Has some issues","date":"2019-06-08T19:00:39.000Z","dateText":"* null *","contents":"I had been waiting along time for the fix the app so it stops dropping calls. Other than that I have no other problems.","rating":5,"reviewerName":"Anindita Belsey","dateAuthorText":"* null * · Anindita Belsey"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"ReviewsPage.ShelfId.helpful","presentationHints":{"isSortable":true,"isSeeAllContext":true}}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPag