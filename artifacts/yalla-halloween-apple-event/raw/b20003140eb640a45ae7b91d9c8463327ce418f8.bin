gh-quality and stable voice chat through the Internet.\n\n-Online party\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\n\n-Gorgeous gifts\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\n\n-Chat with friends\nYou can chat with friends, texting, sending pictures and voice message. ","rating":4.4,"ratingCount":"273","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1560121894&pricingParameters=STDQ&pg=default&appExtVrsId=884151160"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1560121894"},{"locationPosition":1,"locationType":"lockup","name":"Falla-Make new friends","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1560121894"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1560121894","eventType":"click","targetType":"button","targetId":"1560121894","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"1560121894"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1560121894","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1560121894&pricingParameters=STDQ&pg=default&appExtVrsId=884151160","vendor":"VoiceLeap (Hong Kong) Limited","appName":"Falla-Make new friends","bundleId":"com.yinguo.falla","appPlat