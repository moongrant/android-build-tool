rseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-GB","destination":{"storefront":"ae","language":"en-GB","$kind":"ProductPageIntent","id":"6740395595","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"6740395595","name":"SOYOU: Real Voice Connections","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":8,"contentRating":618,"bundleId":"com.d4.j6"}}},{"$kind":"Lockup","adamId":"1534252521","bundleId":"com.spreadfun.4fun","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9921568627450981,"green":0.8862745098039215,"blue":0.29411764705882354,"type":"rgb"},"textColor":{"red":0.07058823529411765,"green":0.07058823529411765,"blue":0.07058823529411765,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/91/79/5c/91795c61-6d08-193c-0088-10ec557d1d31/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"4Fun - Live Voice, Play Ludo","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Just talk, Join party room","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Just talk, Join party room","ageRating":"18+","productDescription":"The app that people in Saudi Arabia and the UAE are paying attention to! 4Fun is a popular group voice chat app for arabs in KSA and UAE.\n\n\nRAMADAN KAREEM! As Ramadhan approaches, 4Fun will add audio rooms for Quran recitation, hadith explanation, charity, zakat, and Ramadan content. Let's spend Ramadan online together, enjoy the peaceful Ramadan, and relax yourself.\n\n\nRecommended community to make friends:\nExplore friends and chat rooms that interest you. Make friends with interesting souls through your voice. It's a safe, warm and stress-free community.\n\n\nOnline Party to entertain with your friends:\nWhy not try to have a fun online party? You can chat with friends of the arab world anytime and anywhere about hot trends, emotions, fashion, football, work...\n\n\nPlay Mdagsh with your friends:\nMdagsh is a local KSA game. In the game, the banker need to choose question other players or not according to their own cards, while other players can choose to accept or increase. They compare the cards to decide which one is the winner, it’s depends on luck and their choices.\n\n\nVarious Games that Saudis are playing:\nLudo, , Uno……Nearly 10 popular local games for you to choose from! 4fun provides everyone with a wonderful gaming world.\n\n\nFEATURES:\n\nMAKE FRIENDS- Meet friends that suit you instantly and easily! Friends are crowded into ROOMs, MOMENT & PRIVATE CHAT. On 4Fun, you never know who you might meet!\n\nDELICATE DESIGN- Stunning animated gifts, vehicles, headwears for you to show your taste and personality.\n\nUNIQUE HONOR-Special id, beautiful badges, SVIP, luxury ranking, Customized Gifts for you to show your uniqueness.\n\nROOM PARTY-Attend parties with different themes: Chat, Singles Club, Couples, Girls, Travel, AFC.\n\nGAMES- Play games with different arabs!\n\nMessage us: support@spread-fun.com","rating":4.2,"ratingCount":"39","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1534252521&pricingParameters=STDQ&pg=default&appExtVrsId=884889903"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1534252521"},{"locationPosition":9,"locationType":"lockup","name":"4Fun - Live Voice, Play Ludo","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its