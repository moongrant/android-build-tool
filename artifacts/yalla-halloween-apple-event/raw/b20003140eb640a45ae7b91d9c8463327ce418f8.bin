ments","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","userProductReviews","editorsChoiceProductReviews","productReviewsFooter","tapToRateProductReviewAction","writeAReviewProductReviewAction","tapToRateProductReviewAction","userProductReviews","editorsChoiceProductReviews","writeAReviewProductReviewAction","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper"]},"shelfMapping":{"topLockup":{"$kind":"Shelf","impressionMetrics":null,"contentType":"marker","marker":"productTopLockup","items":[],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"topLockup"},"description":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"description","idType":"sequential","impressionIndex":0}},"contentType":"productDescription","marker":null,"items":[{"$kind":"ProductDescription","paragraph":{"$kind":"Paragraph","text":"Play, Chat, and Connect – All in One Place!\nLooking for a fun, engaging way to play games and chat with friends? Yalla brings together casual games and voice chat rooms, creating an unmatched social experience. Whether you're a fan of classic games or love connecting with new people, we’ve got you covered!\n\nKey Features:\nCasual Games to Enjoy Anytime\n- Play popular games like Ludo, Carrom, UMO, and Baloot with friends or other players worldwide.\n- Immerse yourself in friendly competitions, challenge players worldwide, and climb the leaderboards to prove your skills.\n- Stay tuned—more exciting games are coming soon!\n\nVoice Chat Rooms\n- Join voice chat rooms to talk, laugh, and make new friends. Thousands of voice chat rooms are waiting for you.\n- Go on the mic, send messages in chat, or exchange virtual gifts to enhance the fun.\n- Play mini-games directly in the room for a lively group experience.\n\n1-on-1 Private Chat\n- Connect deeper with friends through private chat. Share messages, voice notes, and more in a personal space.\n\nPost and Share\n- Share your thoughts, game achievements, or fun moments with the community posts feature. Let others know what you're up to!\n\nWhy Choose Our App?\n- All-in-One Experience: Play games, chat, and socialize in one seamless app.\n- Global Community: Meet and interact with people from around the world.\n- Fun and Interactive: Voice chat, gifts, and games make every moment exciting.\n\nFollow us to get the latest news, updates and events:\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\nWebsite: www.yalla.live\nDear YALLA users, your feedback and suggestions are welcome to: yallasupport@yalla.com","mediaType":"text/plain","style":"standard","alignment":"localized","isCollapsed":true,"suppressVerticalMargins":false,"wantsCollapsedNewlines":true},"developerAction":{"title":"Yalla Technology FZ-LLC","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/ae/developer/yalla-technology-fz-llc/id1444567250","location":[{"locationPosition":0,"locationType":"button","name":"Yalla Technology FZ-LLC","idType":"its_id","id":"1444567250"}],"eventType":"click","targetType":"button","targetId":"1444567250","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","p