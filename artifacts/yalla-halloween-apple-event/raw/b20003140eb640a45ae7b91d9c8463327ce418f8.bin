rl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=top-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-GB","destination":{"storefront":"ae","language":"en-GB","$kind":"ProductPageIntent","id":"1519557264","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1519557264","name":"Hawa - Group Voice Chat Rooms","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":7,"contentRating":618,"bundleId":"com.hawatalk.live"}}},{"$kind":"Lockup","adamId":"6740395595","bundleId":"com.d4.j6","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.17647058823529413,"green":0.17647058823529413,"blue":0.17647058823529413,"type":"rgb"},"textColor":{"red":0.8705882352941177,"green":0.8705882352941177,"blue":0.8705882352941177,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/41/2a/69/412a690f-fbfb-ae70-7ed0-56822a22909a/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"SOYOU: Real Voice Connections","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Voice Rooms & Social Spaces","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Voice Rooms & Social Spaces","ageRating":"18+","productDescription":"SOYOU is a community where people connect through real conversations and shared interests.\r\n\r\nIt’s built for open interaction, voice discussions, and meaningful exchanges in a comfortable social environment.\r\n\r\nNo pressure. No complicated steps. Just spaces where people can talk and share ideas naturally.\r\n\r\nKey Features\r\n\r\n- Voice Rooms\r\nJoin topic-based voice rooms to discuss hobbies, trends, and daily life with others in real time.\r\n\r\n- Social Spaces\r\nExplore communities built around shared interests and participate in open conversations.\r\n\r\n- Authentic Profiles\r\nConnect with real users in a transparent and respectful environment.\r\n\r\n- Safe & Controlled\r\nPrivacy tools and moderation features help maintain a healthy community experience.\r\n\r\nSOYOU focuses on communication and shared expression — creating spaces where voices can be heard.\r\n\r\nDownload and explore open conversations today!\r\n\r\nSOYOU Support Email: support@pokabb.com\r\nPrivacy Policy: https://www.pokabb.com/user/privPolicy\r\nTerms of Use: https://www.pokabb.com/user/termService","rating":3.5,"ratingCount":"19","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=6740395595&pricingParameters=STDQ&pg=default&appExtVrsId=885073468"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6740395595"},{"locationPosition":8,"locationType":"lockup","name":"SOYOU: Real Voice Connections","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"6740395595"},{"locationPosition":13,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"6740395595","eventType":"click","targetType":"button","targetId":"67