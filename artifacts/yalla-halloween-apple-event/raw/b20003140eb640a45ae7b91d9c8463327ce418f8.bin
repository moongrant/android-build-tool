itemDescription":"Game Together, Chat Anytime","appIcon":{"$kind":"Artwork","backgroundColor":{"red":0.5176470588235295,"green":0.984313725490196,"blue":0.6666666666666666,"type":"rgb"},"textColor":{"red":0,"green":0.03529411764705882,"blue":0.0196078431372549,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/2c/9d/a8/2c9da851-5ee2-13f6-3ff5-3283cb0ff245/Placeholder.mill/{w}x{h}bb-70.png","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]}},"supportAction":{"title":"App Support","artwork":{"$kind":"Artwork","backgroundColor":null,"textColor":null,"style":null,"crop":"bb","contentMode":null,"imageScale":null,"template":"systemimage://questionmark.circle","width":0,"height":0,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"http://www.yalla.live","isSensitive":false}}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"writeAReviewProductReviewAction"},"mostRecentVersion":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"24","name":"What’s New","impressionType":"versionHistory","idType":"sequential","impressionIndex":2}},"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"1. تم إطلاق مجموعات جديدة لمواضيع المواعدة والحفلات لإنشاء أجواء خاصة بغرفتك\n2. تمت إضافة صفحة تزيين الغرفة حيث يمكنك تغيير المجموعات والخلفيات وتأثيرات الميكروفون وأنماطه بسهولة\n3. تحسينات أخرى\n\n1. New dating and party theme sets are now available to help you create a personalized room atmosphere\n2. Added a room decoration page where you can change theme sets, room backgrounds, mic wave effects, and mic styles in one place\n3. Other optimizations","style":"overview","wantsCollapsedNewlines":true,"primarySubtitle":"Version 3.3.1","secondarySubtitle":"Thu Mar 26 2026 01:49:45 GMT+0000 (Coordinated Universal Time)"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"Version History","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"location":[{"locationPosition":2,"locationType":"button","name":"Version History"}],"actionType":"navigate","target":"button_See All","eventType":"click","targetType":"button","targetId":"See All","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"versionHistory","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":null,"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"1. تم إطلاق مجموعات جديدة لمواضيع المواعدة والحفلات لإنشاء أجواء خاصة بغرفتك\n2. تمت إضافة صفحة تزيين الغرفة حيث يمكنك تغيير المجموعات والخلفيات وتأثيرات الميكروفون وأنماطه بسهولة\n3. تحسينات أخرى\n\n1. New dating and party theme sets are now available to help you create a personalized room atmosphere\n2. Added a room decoration page where you can change theme sets, room backgrounds, mic wave effects, and mic styles in one place\n3. Other optimizations","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.3.1","secondarySubtitle":"Thu Mar 26 2026 01:49:45 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تم إضافة لعبة \"تحدي المعرفة\" إلى الغرف.\r\n2. تم تحسين الصفحة الرئيسية لمستخدمي VIP.\r\n3. تحسينات أخرى.\n\n1. Quiz Master game added to rooms.\r\n2. VIP homepage optimized.\r\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.2.0","secondarySubtitle":"Wed Feb 04 2026 08:01:21 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.1.1","secondarySubtitle":"Wed Dec 17 2025 02:00:06 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تمت إضافة ميزة تسجيل الهدايا.\n2. تحسينات أخرى وإصلاح الأخطاء.\n\n1. Added Gift Scoring feature.\r\n2. Other optimizations and bug fixes.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.1.0","secondarySubtitle":"Wed Nov 26 2025 01:58:02 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.0.4","secondarySubtitle":"Thu Sep 25 2025 01:44:35 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.0.3","secondarySubtitle":"Thu Sep 11 2025 10:34:20 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.0.2","secondarySubtitle":"Wed Sep 03 2025 01:50:45 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.0.1","secondarySubtitle":"Wed Aug 27 2025 01:45:32 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تم إطلاق ألعاب جديدة رائعة، اجعل وقت فراغك أكثر تنوعًا ومتعة!\r\n2. أصبح من الأسهل الآن اختيار الغرف في بلدان مختلفة.\n\n1. New casual games are launched, enriching your entertainment time!\r\n2. It's more convenient to select rooms in different countries.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"3.0.0","secondarySubtitle":"Wed Jul 23 2025 01:45:58 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.31.3","secondarySubtitle":"Sat May 24 2025 03:55:37 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.31.2","secondarySubtitle":"Mon May 19 2025 01:54:02 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.31.1","secondarySubtitle":"Wed Apr 16 2025 01:52:57 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تم تحسين صفحة الغرف.\r\n2. يمكن لمستخدمي VIP تخصيص أيديات خاصة بهم.\r\n3. تحسينات أخرى.\n\n1. Room page has been optimized.\r\n2. VIP users can customize their own IDs.\r\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.31.0","secondarySubtitle":"Wed Mar 26 2025 01:52:43 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.30.1","secondarySubtitle":"Sun Feb 23 2025 06:09:58 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.30.0","secondarySubtitle":"Wed Feb 05 2025 08:26:33 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. التسجيل عبر البريد الإلكتروني وتسجيل الدخول متاح الآن.\n2. تمت إضافة منشور الشرف عند ترقية الـ VIP والحفاظ على المستوى.\n3. تحسينات أخرى.\n\n1. Registration and login via email are supported now.\n2. Added VIP upgrade and maintenance honor post.\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.29.2","secondarySubtitle":"Wed Jan 08 2025 01:45:17 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.29.1","secondarySubtitle":"Mon Dec 09 2024 01:47:23 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تمت إضافة ميزة موضوع المايك - زين غرفتك بموضوعات مايك مختلفة.\r\n2. تحسين وتطوير برنامج VIP - رسوم متحركة حصرية للمايك وموضوع المايك لجميع مستخدمي VIP، وخفض متطلبات VIP9 - VIP4، وإجراء تغيير مهم: لن يتم إعادة تعيين نقاط VIP إلى 0 بعد ترقية مستوى VIP.\r\n3. تحسينات أخرى.\n\n1. Added Mic Theme feature - Decorate your room with different mic themes. \r\n2. Improved VIP program - Exclusive mic animation and mic theme for all VIP users, lowered VIP 4 - VIP 9 requirements, and an important change: VIP points won't be reset to 0 after a VIP level upgrade. \r\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.29.0","secondarySubtitle":"Wed Nov 27 2024 01:54:10 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. البطاقة الشهرية - قم بشرائها لتحصل على المزيد من القطع الذهبية بتكلفة أقل.\r\n2. مكافآت استدعاء الأصدقاء - قم بدعوة أصدقائك للعودة إلى يلا للحصول على مكافآت مختلفة.\r\n3. تحسينات أخرى.\n\n1. Month Card - Buy it to get more golds with less money.\r\n2. Recall Friends Rewards - Invite your friends to return to Yalla to get various rewards.\r\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.28.0","secondarySubtitle":"Fri Sep 27 2024 15:19:38 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.27.1","secondarySubtitle":"Mon Jul 29 2024 01:36:13 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. تم إطلاق قاعة معرض الهدايا. قم بإضاءة هدايا المعرض لفتح شارات المعرض.\r\n2. تمت إضافة أخبار المنصة لعرض الأحداث المهمة في الوقت الفعلي مثل إرسال هدايا المنصة، وترقية مستوى VIP، وما إلى ذلك.\r\n3. تحسينات أخرى.\n\n1. Gift Exhibition Hall is launched. Light up exhibition gifts to unlock exhibition badges.\r\n2. Added platform news to display important real-time events like sending platform gifts, upgrading VIP level, etc.\r\n3. Other improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.27.0","secondarySubtitle":"Fri Jun 28 2024 01:50:28 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.26.2","secondarySubtitle":"Thu Jun 06 2024 01:47:13 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. يمكنك إرسال الهدايا لجميع أعضاء الفريق في وقت واحد في لعبة كرة القدم المجنونة.\n2. تحسينات أخرى\n\n1. You can give gifts to all team members at once in the Crazy Football game.\n2. Other improvements","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.26.1","secondarySubtitle":"Wed May 08 2024 01:59:23 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.26.0","secondarySubtitle":"Thu Apr 11 2024 01:56:32 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"1. إصلاح العديد من الأخطاء\r\n2. تحسين تجربة المستخدم\n\n1. Fixed several bugs\r\n2. Improved user experience","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"2.25.0","secondarySubtitle":"Tue Feb 06 2024 01:47:59 GMT+0000 (Coordinated Universal Time)"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"title":"Version History","presentationOptions":["prefersLargeTitle"],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[{"data":{"fields":{"eventType":"impressions","impressionQueue":"data-metrics","eventVersion":4,"platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressions","pageFields","pageReferrer","contentRestrictionReasons","impressionsAppendix"],"excludingFields":["eventVersion","amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false},"invocationPoints":["appExit","pageExit"]},{"data":{"fields"