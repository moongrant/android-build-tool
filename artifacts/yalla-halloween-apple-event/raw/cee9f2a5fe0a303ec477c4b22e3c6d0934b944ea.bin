impressionMetrics":null,"id":"12929154971","title":"O","date":"2025-07-24T03:33:10.000Z","dateText":"* null *","contents":"My Yalla account was linked to my Twitter (@3jmi*7_7) and it worked before, but now it says “invalid link” and won’t open the app.\nI don’t own the phone number linked to the account and I can’t log in. Please help me recover or protect my account before I lose it","rating":5,"reviewerName":"Hwhw67","dateAuthorText":"* null * · Hwhw67","response":{"id":"54458628","contents":"Dear user, the account login function of Yalla has been adjusted. You can also register and log in through third-party applications. Sorry for the inconvenience. If you have any questions, please contact us through the yallasupport customer service email. wish you a happy experience in Yalla.","date":"2025-07-28T02:56:11.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null,"moreAction":{"impressionMetrics":null,"title":"Ratings & Reviews","artwork":null,"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowAction","actionMetrics":{"data":[],"custom":{}},"page":"reviews","pageData":{"shelves":[{"impressionMetrics":{"fields":{"id":"11","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":1}},"contentType":"reviews","marker":null,"items":[{"impressionMetrics":null,"id":"12929154971","title":"O","date":"2025-07-24T03:33:10.000Z","dateText":"* null *","contents":"My Yalla account was linked to my Twitter (@3jmi*7_7) and it worked before, but now it says “invalid link” and won’t open the app.\nI don’t own the phone number linked to the account and I can’t log in. Please help me recover or protect my account before I lose it","rating":5,"reviewerName":"Hwhw67","dateAuthorText":"* null * · Hwhw67","response":{"id":"54458628","contents":"Dear user, the account login function of Yalla has been adjusted. You can also register and log in through third-party applications. Sorry for the inconvenience. If you have any questions, please contact us through the yallasupport customer service email. wish you a happy experience in Yalla.","date":"2025-07-28T02:56:11.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"instructions":[],"custom":{}},"adamId":"1091902866","targetReviewId":"12929154971"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}}},{"impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"helpfulReview","idType":"sequential","impressionIndex":5}},"componentType":"productReview","sourceType":"user","review":{"impressionMetrics":null,"id":"3930709153","title":"Stealing money","date":"2019-03-26T22:39:24.000Z","dateText":"* null *","contents":"I paid 8.99$ for recharging 1000 coins and didn’t get it until now for the fourth day of waiting and app support didn’t help for this problem they asked me to contact their EMAIL and never respond I contact apple support and waiting for action.","rating":5,"reviewerName":"raed al enazi","dateAuthorText":"* null * · raed al enazi","response":{"id":"7924420","contents":"Dear user,sorry for the inconvenience , please send the payment receipt and attach your ID to yallasupport@yalla.live And I will remind the relevant staff to deal with it as soon as possible.We're always here to help you solve any app problem.","date":"2019-03-27T05:26:29.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null,"moreAction":{"impressionMetrics":null,"title":"Ratings & Reviews","artwork":null,"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowA