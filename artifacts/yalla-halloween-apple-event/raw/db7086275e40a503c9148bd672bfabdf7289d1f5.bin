ue\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Profanity or Crude Humour\",\"Frequent/Intense Simulated Gambling\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Unrestricted Web Access\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.4,\"ratingCount\":597,\"ratingCountList\":[63,17,19,36,462],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Falla-Make new friends\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1560121894\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=860214373\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":411963392}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1560121894\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=860214373\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":411963392}]}],\"minimumMacOSVersion\":\"11.0\",\"requires32bit\":false,\"releaseDate\":\"2021-04-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yinguo.falla\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/2e/41/21/2e4121e5-aafa-b8cc-38d4-90c7c7f634c2/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fdb100\",\"textColor1\":\"010a04\",\"textColor2\":\"2e1f00\",\"textColor3\":\"342b03\",\"textColor4\":\"583c00\"},\"videoPreviewsByType\":{},\"privacyPolicyUrl\":\"https://web.falla.live/#/app/policy\",\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"http://www.falla.live/\",\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"6.4.6\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-10-08\",\"releaseTimestamp\":\"2023-10-08T10:05:11Z\"},{\"versionDisplay\":\"6.4.4\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-09-26\",\"releaseTimestamp\":\"2023-09-26T08:34:22Z\"},{\"versionDisplay\":\"6.4.3\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2023-09-18\",\"releaseTimestamp\":\"2023-09-18T02:41:34Z\"},{\"versionDisplay\":\"6.4.2\",\"releaseNotes\":\"1. Optimized user ex