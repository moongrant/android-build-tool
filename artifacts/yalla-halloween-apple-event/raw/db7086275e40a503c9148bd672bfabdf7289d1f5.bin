TD":"Game of the Day: @@appName@@","WEA.EditorialItemProductPages.Social.title.IAP":"In-App Purchase: @@appName@@","WEA.Error.Carrier.Install.AM":"To start listening, install Apple Music on your device.","WEA.Error.Carrier.Installed":"Already have the app?","WEA.Error.Carrier.Open.Action":"Get it on @@appname@@","WEA.Error.Generic.AppleMusicLogo.Text":"Apple Music","WEA.Error.Generic.GooglePlay":"Google Play","WEA.Error.Generic.Install.AM":"If this link does not work, you might need to @@installLink@@.","WEA.Error.Generic.Install.AM.Link.Text":"install Apple Music","WEA.Error.Generic.Meta.PageKeywords":"Apple Music","WEA.Error.Generic.Meta.PageKeywords.AppleBooks":"Apple Books","WEA.Error.Generic.Meta.PageKeywords.iTunes":"iTunes Store","WEA.Error.Generic.Meta.PageTitle":"Connecting to Apple Music","WEA.Error.Generic.Open.AM":"Open in Apple Music","WEA.Error.Generic.Open.Action.AM":"Open in","WEA.Error.Generic.Subtitle":"If you do not have iTunes, @@downloadLink@@. If you have iTunes and it does not open automatically, try opening it from your dock or Windows task bar.","WEA.Error.Generic.Subtitle.DownloadLink.Text":"download it for free","WEA.Error.Generic.Subtitle.DownloadLink.URL":"http://www.apple.com/uk/itunes/download/","WEA.Error.Generic.Title":"Connecting to Apple Music","WEA.Error.Generic.Title.AppleBooks":"Connecting to Apple Books","WEA.Error.Generic.Title.Apps":"Connecting to the App Store","WEA.Error.Generic.Title.Connecting":"Connecting","WEA.Error.Generic.Title.Podcasts":"Connecting to Apple Podcasts","WEA.Error.Generic.Title.iTunes":"Connecting to the iTunes Store.","WEA.Error.NativeMissing.AM.Subtitle":"You need iTunes to use Apple Music","WEA.Error.NativeMissing.Other.AM":"Get Apple Music on iOS, Android, Mac and Windows","WEA.Error.NativeMissing.Other.LearnMore.link":"https://www.apple.com/itunes/download/","WEA.Error.NativeMissing.Other.iTunes":"Get iTunes on iOS, Android, Mac and Windows","WEA.Error.NativeMissing.iTunes.Download.link":"https://www.apple.com/itunes/download/","WEA.Error.NativeMissing.iTunes.Download.text":"Download iTunes","WEA.Error.NativeMissing.iTunes.TV.Subtitle":"Download iTunes below to start watching.","WEA.Error.NativeMissing.iTunes.Title":"We could not find iTunes on your computer.","WEA.Error.NotFound.Meta.Title":"This content can’t be found.","WEA.Error.NotFound.general":"The page you're looking for cannot be found.","WEA.GroupingPages.CTA.GoToWebsite":"Go to","WEA.InvoicePages.Receipts.Instructions":"Try again on an iPhone, iPad or Mac, or use iTunes on a PC","WEA.InvoicePages.Receipts.Meta.Description":"You cannot turn off receipts on this device.","WEA.InvoicePages.Receipts.Meta.Title":"Receipts","WEA.InvoicePages.Receipts.Title":"You cannot turn off receipts on this device","WEA.LocalNav.CTA.AppName.TV":"Apple TV App","WEA.LocalNav.CTA.DownloadiTunes":"Download iTunes","WEA.LocalNav.CTA.DownloadiTunes.url":"https://www.apple.com/itunes/download/","WEA.LocalNav.CTA.FreeTrial":"Try It Now","WEA.LocalNav.CTA.FreeTrial.url":"https://itunes.apple.com/subscribe?app=music","WEA.LocalNav.CTA.iTunesStore.TV":"Learn More","WEA.LocalNav.Preview.AM":"Preview","WEA.LocalNav.Preview.AppStore":"Preview","WEA.LocalNav.Preview.Books":"Preview","WEA.LocalNav.Preview.MAS":"Preview","WEA.LocalNav.Preview.Podcasts":"Preview","WEA.LocalNav.Preview.TV":"Preview","WEA.LocalNav.Preview.iBooks":"Preview","WEA.LocalNav.Preview.iTunes":"Preview","WEA.LocalNav.Store.AM":"Apple Music","WEA.LocalNav.Store.AppStore":"App Store","WEA.LocalNav.Store.Books":"Apple Books","WEA.LocalNav.Store.MAS":"Mac App Store","WEA.LocalNav.Store.Podcasts":"Apple Podcasts","WEA.LocalNav.Store.TV":"Apple TV","WEA.LocalNav.Store.iBooks":"Apple Books","WEA.LocalNav.Store.iTunes":"iTunes","WEA.LocalNav.Title.Preview.AM":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.AppStore":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.Books":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.MAS":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.Podcasts":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.TV":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iBooks":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iTunes":"@@product@@ @@qualifier@@","WEA.MusicPages.Riaa.Explicit.AX":"Parental Advisory Explicit Content","WEA.PaddleNav.Next.AX":"Next","WEA.PaddleNav.Previous.AX":"Previous","WEA.StarRating.Separator":" • ","WFA.Common.Meta.Twitter.site":"@Apple"}}</script><script type="fastboot/shoebox" id="shoebox-media-api-cache-apps">{".v1.catalog.sa.apps.1091902866.l.en-gb.platform.web.additionalplatforms.appletv.2cipad.2ciphone.2cmac.extend.custompromotionaltext.2ccustomscreenshotsbytype.2cdescription.2cdeveloperinfo.2cdistributionkind.2ceditorialvideo.2cfilesizebydevice.2cmessagesscreenshots.2cprivacy.2cprivacypolicyurl.2crequirementsbydevicefamily.2csupporturlforlanguage.2cversionhistory.2cwebsiteurl.2cvideopreviewsbytype.include.app-events.2cgenres.2cdeveloper.2creviews.2cmerchandised-in-apps.2ccustomers-also-bought-apps.2cdeveloper-other-apps.2ctop-in-apps.2crelated-editorial-items.limit.5bmerchandised-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1696850129047,\"d\":[{\"id\":\"1091902866\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1091902866?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Sexual Content and Nudity\",\"Unrestricted Web Access\",\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":56,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/yalla-group-voice-chat-rooms/id1091902866\",\"usesLocationBackgroundMode\":false,\"userRating\":{\"value\":4.2,\"ratingCount\":24466,\"ratingCountList\":[3217,909,1087,1862,17391],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"2.4.0\",\"name\":\"Yalla - Group Voice Chat Rooms\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"sellerLabel\":\"Provider\",\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"hasEula\":true,\"platformAttributes\":{\"ios\":{\"seller\":\"Yalla Technology FZ-LLC\",\"copyright\":\"© 2023 Yalla Technology FZ-LLC\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla is the most popular Live Group Voice Talking and Entertaining Community. Voice Chat and play games with people from nearby or all over the world.\\n\\nMeet new friends is never easier:\\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries has already been covered, while tons of topics are available to choose.\\n\\nParty with friends with no distances:\\nGroup voice talk with friends no matter where they are, broadcast your favorite musics inside the room, sing karaokes together, and play a range of games directly in group chat. Let's get the party started.\\n\\nFEATURES:\\n\\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE or Wi-Fi.\\n\\nPUBLIC CHAT ROOMS — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \\n\\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\\n\\nCHAT GAMES — Play games together directly in your chat group!\\n\\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\\n\\nSHARE and FOLLOW — Share your favorite ROOMS on Facebook, Twitter, Instagram, Snapchat and more, inviting friends and new followers.\\n\\nFollow us to get the latest news, updates and events:\\nFacebook: https://www.facebook.com/YallaVoiceChatRooms\\nWebsite: www.yalla.live\\n\\nDear YALLA users, your feedback and suggestions are welcomed to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"is32bitOnly\":false,\"versionHistory\":[{\"versionDisplay\":\"2.23.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T01:29:21Z\"},{\"versionDisplay\":\"2.22.2\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-08-02\",\"releaseTimestamp\":\"2023-08-02T01:31:28Z\"},{\"versionDisplay\":\"2.22.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-16\",\"releaseTimestamp\":\"2023-06-16T16:14:48Z\"},{\"versionDisplay\":\"2.22.0\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-06-14\",\"releaseTimestamp\":\"2023-06-14T01:56:09Z\"},{\"versionDisplay\":\"2.21.0\",\"releaseNotes\":\"1. مستوى الثروة - افتح مستوى ثروتك واستمتع بامتيازات خاصة. \\r\\n2. تحسينات أخرى\\n\\n1. Wealth Level - Unlock your wealth level and enjoy distinguished privileges.\\r\\n2. Other improvements\",\"releaseDate\":\"2023-05-09\",\"releaseTimestamp\":\"2023-05-09T08:34:42Z\"},{\"versionDisplay\":\"2.20.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T01:28:32Z\"},{\"versionDisplay\":\"2.20.0\",\"releaseNotes\":\"1. VIP 6 -قم بالوصول إلى المستوى VIP 6 للاستمتاع بمزايا حصرية رائعة!                       \\r\\n2. تحسينات أخرى\\n\\n1. VIP 6 - Level up to VIP 6 to enjoy fantastic exclusive benefits!\\r\\n2. Other Improvements\",\"releaseDate\":\"2023-03-07\",\"releaseTimestamp\":\"2023-03-07T02:33:13Z\"},{\"versionDisplay\":\"2.19.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T01:10:00Z\"},{\"versionDisplay\":\"2.19.0\",\"releaseNotes\":\"1. تصميم لحظات جديدة: تمتع بتصميم محسّن وجمالي حديثًا.\\r\\n2. سجلات إجراءات الغرفة: تمت إضافة سجلات لحظر الدردشة / إلغاء الحظر وإزالة من الميكروفون.\\r\\n3. الإبلاغ عم طلبات الصداقة: يمكن للمستخدمين الآن الإبلاغ عن طلبات الصداقة من أسفل صفحة طلب الصداقة.\\n\\n1. New Moments design: Enjoy a newly improved and aesthetic design.\\r\\n2. Room action records: Added records for chat ban/unban and removal from the mic.\\r\\n3. Friend request report: Users can now report friend requests from the bottom of the friend request page.\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T01:32:16Z\"},{\"versionDisplay\":\"2.18.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2022-11-29\",\"releaseTimestamp\":\"2022-11-29T01:48:20Z\"},{\"versionDisplay\":\"2.18.0\",\"releaseNotes\":\"1. تصميم الصفحة الرئيسية - استمتع بتحسين تصميم الصفحة الرئيسية.\\n2. شارة الشرف - يمكن الآن لأفضل 10 مجموعات أعضاء الغرفة الحصول على شارات الشرف.\\n3. طلب الميكروفون - تمت إضافة ميزة التحكم في الميكروفون من خلال التقدم بطلب للحصول عليها!\\n\\n1. Home Page Design - Enjoy a newly upgraded and aesthetic design. \\n2. Honor Badge - The top 10 Room Member Groups can now get awarded honor badges. \\n3. Microphone Application - This new feature in the chat room allows users to apply for a mic!\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:49:18Z\"},{\"versionDisplay\":\"2.17.0\",\"releaseNotes\":\"1. مجموعة الأعضاء - من خلال الانضمام إلى مجموعة الأعضاء، يمكنك الحصول علي النقاط ورفع المستوى لكسب المزيد من امتيازات الأعضاء!\\r\\n2. الإبلاغ عن الرسائل الخاصة - يمكنك الآن الإبلاغ عن رسالة خاصة بالضغط عليها لفترة قصيرة.\\n\\n1. Member Group - By joining the member group, you can gain points and level up to earn more member privileges!\\r\\n2. Report Private Messages - You can now report a private message by holding down on it.\",\"releaseDate\":\"2022-09-21\",\"releaseTimestamp\":\"2022-09-21T01:44:47Z\"},{\"versionDisplay\":\"2.16.0\",\"releaseNotes\":\"1. الهدايا الجديدة، صناديق الدردشة ومزايا حصرية لأعضاء VIP - تم أضافة هدايا جديدة، والقدرة على شراء صناديق الدردشة، وصناديق الدردشة الحصرية للمستخدمين VIP.\\n2. تعديل المنشور - يمكن لأعضاء يلا بريميم تعديل المنشور ما يصل إلى 5 مرات.\\r\\n3. دردشة جماعية - يمكن لمضيفي المواضيع إنشاء دردشة جماعية على YallaChat.\\n\\n1. New Gifts, Chat Boxes and VIP Benefits - Added new gifts with the ability to purchase chat boxes, and exclusive chat boxes for VIP users.\\r\\n2. Edit your Posts - Yalla Premium members can edit a post up to 5 times.\\r\\n3. Group Chat - Topic hosts can create a YallaChat group chat.\",\"releaseDate\":\"2022-07-20\",\"releaseTimestamp\":\"2022-07-20T01:53:22Z\"},{\"versionDisplay\":\"2.15.0\",\"releaseNotes\":\"1. يمكن لمالك الغرفة الآن إنشاء ما يصل إلى 10 أنشطة يوميا، ويمكن منح المشرفين الإذن لإنشاء أنشطة.\\n2. يمكن للمستخدمين VIP3- VIP5 الحصول على أي دي شخصي مميز مجانًا.\\n3. ملصقات متحركة جديدة.\\n4. تحسينات أخرى في الأداء.\\n\\n1. Room owners can now create up to 10 events per day, and room admins can be given permission to create events.\\n2. VIP 3 - VIP 5 users can get a Unique Personal ID for free.\\n3. New animated stickers\\n4. Other performance improvements.\",\"releaseDate\":\"2022-05-17\",\"releaseTimestamp\":\"2022-05-17T01:42:08Z\"},{\"versionDisplay\":\"2.14.0\",\"releaseNotes\":\"1. إنشاء استطلاع - يمكنك إنشاء استطلاعات في اللحظات الآن.\\n2. تحسين البث المباشر لارسال الهدايا - تم تحسين تصميم البث المباشر لارسال الهدايا.\\n3. تسجيل الدخول إلى YallaChat - يمكنك الآن تسجيل الدخول عبر YallaChat.\\n\\n1. Create Polls - You can create polls in Moments now.\\n2. Optimized Gifting Broadcasts - The designs of gifting broadcasts are improved.\\n3. YallaChat Login - You can log in via YallaChat now.\",\"releaseDate\":\"2022-04-06\",\"releaseTimestamp\":\"2022-04-06T02:22:05Z\"},{\"versionDisplay\":\"2.13.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2022-02-23\",\"releaseTimestamp\":\"2022-02-23T02:31:56Z\"},{\"versionDisplay\":\"2.13.0\",\"releaseNotes\":\"1. إنشاء نشاطات: يمكنك جدولة نشاطات غرفتك إذا كان مستوى غرفتك لا يقل عن 10.\\n2. أرسل القبعات إلى جميع من على المايك: الآن يمكنك إرسال قبعة إلى جميع من على المايك مره واحدة. القبعات هي زينة فريدة لصور الملف الشخصي، يمكن إهدائها للمستخدمين الآخرين بصلاحية فعالة تبلغ 15 دقيقة.\\n3. تحسينات أخرى في الأداء.\\n\\n1. Create Events: You can schedule events for your room if your room level is not lower than 10. \\n2. Send Hats to Everyone on Mic: Now you can send a hat to everyone on Mic at once. Hats are unique profile photo decorations that can be gifted to other users with an effective validity of 15 minutes.\\n3. Other performance improvements.\",\"releaseDate\":\"2022-01-19\",\"releaseTimestamp\":\"2022-01-19T01:32:14Z\"},{\"versionDisplay\":\"2.12.1\",\"releaseNotes\":\"نقدم في هذا التحديث ميزات إضافية لأعضاء VIP لدينا، بما في ذلك:\\n- بطاقات شخصية حصرية\\n- تأثيرات الدخول الجديدة\\n- مقاعد الصف الأمامي على القائمة الموجودة اونلاين\\n\\nبالإضافة إلى ذلك، يمكن لجميع المستخدمين تجربة الميزات التالية لأول مرة:\\n- ميزة الرد: يمكنك الآن الرد على الرسائل في الغرفة.\\n- ملصقات جديدة: عبّر عن نفسك باستخدام ملصقات متحركة جديدة.\\n- عناصر جديدة في متجر الكريستال.\\n\\nIn this update we are introducing additional features to our VIP members, including:\\n- Exclusive profile cards\\n- New entrance effects\\n- Front row seats on the online list\\n\\nIn addition to that, all users can experience the following features for the first time:\\n- Reply Feature: You can now reply to messages in room.\\n- New Stickers: Express yourself with new animated stickers.\\n- New items in the Crystal Store.\",\"releaseDate\":\"2021-12-03\",\"releaseTimestamp\":\"2021-12-03T09:16:16Z\"},{\"versionDisplay\":\"2.12.0\",\"releaseNotes\":\"1. نظام VIP مضاف - برنامج يوفر مزايا مجانية للمستخدمين الذين تصل إعادة شحنهم إلى مبلغ محدد.\\n2. تحسينات أخرى في الأداء\\n1.  Added VIP System - a program that provides free benefits for users whose recharge reaches a specified amount.\\n2. Other performance improvements\",\"releaseDate\":\"2021-10-12\",\"releaseTimestamp\":\"2021-10-12T01:59:05Z\"},{\"versionDisplay\":\"2.11.16\",\"releaseNotes\":\"1. صناديق الكنز - الغرف التي تصل إلى المستوى 10 ستحتوى علي صناديق كنز. إرسل الهدايا لفتحها والحصول على مكافآت.\\r\\n2. إرسل هدايا إلى الجميع على المايك - يمكنك الآن إرسال الهدايا إلى الجميع على المايك في كل مرة.\\r\\n3. الإبلاغ عن الرسائل - يمكنك الإبلاغ عن رسالة بالضغط عليها لفترة طويلة عندما تكون في غرفة الدردشة.\\r\\n4. متجر موضوع الغرفة المحسن - من الأسهل عندما تصفح موضوع الغرفة الآن.\\r\\n5. تحسينات أخرى في الأداء.\\n\\n1. Treasure Chests - Rooms that reach Level 10 have treasure chests. Send gifts to open them and get rewards.\\r\\n2. Send Gifts to Everyone on Mic - Now you can send gifts to everyone on Mic at a time.\\r\\n3. Report Messages - You can report a message by long pressing it when in a chat room.\\r\\n4. Optimized Room Theme Store - It's easier for you to browse room themes now.\\r\\n5. Other performance improvements.\",\"releaseDate\":\"2021-08-12\",\"releaseTimestamp\":\"2021-08-12T06:42:05Z\"},{\"versionDisplay\":\"2.11.15\",\"releaseNotes\":\"1.الفارس- عضوية يلا بريميم: اشترك الآن لتحصل على معاملة كبار الشخصيات والقطع الذهبية الشهرية. \\n2.استطلاعات الرأي- يمكنك الآن إنشاء استطلاعات الرأي في الغرفة التي تديرها وكذلك التصويت في استطلاعات الرأي في أي غرفة.\\n3.مكافأة التعليق- يمكنك الآن مكافأة التعليق عدة مرات كما تريد.\\n4.حالة المستخدم- عند تصفح قائمة المنشورات \\\"المتابعة\\\"، سوف يظهر لك أن شخصًا ما متواجد في غرفة من خلال أيقونة متحركة على صورة ملفه الشخصي.\\n5.تحسينات أخرى في الأداء.\\n\\n1. Knight - Premium Membership: subscribe now to get VIP treatment and monthly gold coins. \\n2. Polls - now you can create polls in rooms you manage and also vote in polls in any rooms.\\n3. Reward Comment - now you can reward a comment as many times as you like.\\n4. In-Room Status - when browsing the \\\"Following\\\" post list, you'll know someone is in a room from the In-Room icon on their profile photos.\\n5. Other performance improvements.\\n\",\"releaseDate\":\"2021-06-29\",\"releaseTimestamp\":\"2021-06-29T06:22:15Z\"},{\"versionDisplay\":\"2.11.14\",\"releaseNotes\":\"1.المصادقة الثنائية - فهي تحمي حسابك من خلال طلب رمز تحقق إضافي عند تسجيل الدخول على جهاز لا نتعرف عليه.\\n2.شارات الإنجازات الجديدة -  كن أول من يحصل على هذه الشارات.\\n3.إضافة موضوع - يمكنك الآن إضافة موضوع عند إعادة نشر منشور.\\n4.فئة الموضوع الجديد - يمكنك العثور على الموضوعات التي تم إنشاؤها حديثا في الفئة \\\"جديد\\\".\\n5.تحسينات أخرى في الأداء.\\n\\n1. Two-Factor Authentication - it protects your account by requiring an additional verification code when you log in on a device we don’t recognize. \\n\u20282. New Achievement Badges - be the first one to get these badges. \u2028\\n3. Add a Topic - you can now add a topic when you repost a post. \u2028\\n4. New Topic Category - you can find newly created topics in the “New” category. \u2028\\n5. Other performance improvements.\\n\",\"releaseDate\":\"2021-05-17\",\"releaseTimestamp\":\"2021-05-17T02:58:13Z\"},{\"versionDisplay\":\"2.11.13\",\"releaseNotes\":\"1.واجهة المستخدم الخاصة بشهر رمضان - تم تحديث يلا بزخارف رمضان.\\n2.شارات الإنجازات الجديدة - كن أول من يحصل على هذه الشارات.\\n3.رموز تعبيرية متحركة على المايك - عبر عن نفسك باالرموز التعبيرية التي ستظهر على المايك.\\n4.تحسينات أخرى في الأداء.\\n\\n\\n\\n1. Ramadan Themed UI - Yalla is updated with Ramadan decorations.\\n2. New Achievement Badges - be the first one to get these badges.\\n3. Animated Stickers on Mic - express yourself with stickers that will show on Mic.\\n4. Other performance improvements.\\n\",\"releaseDate\":\"2021-04-06\",\"releaseTimestamp\":\"2021-04-06T07:41:43Z\"},{\"versionDisplay\":\"2.11.12\",\"releaseNotes\":\"1. الوضع الليلي - الآن يمكنك استخدام يلا مع الوضع الليلي. قم بإعداده في الإعدادات.\\n2. قفل وفتح الميكروفون - يمكن لمالكي الغرف الآن منح هذا الإذن لمشرفي الغرفة.\\n3. فئات الموضوعات ومشرفين الموضوعات - يمكنك عرض الموضوعات حسب الفئة وإضافة ما يصل إلى 5 مشرفين لموضوعك.\\n4. تحسينات أخرى في الأداء.\\n\\n\\n1. Dark Mode - now you can use Yalla with Dark Mode. Set it up in Settings.\\n2. Lock and Unlock Microphones - room owners can now grant this permission to room admins.\\n3. Topics Categories \u0026 Topic Admins - you can view topics by category and add up to 5 admins to your topic.\\n4. Other performance improvements\",\"releaseDate\":\"2021-02-02\",\"releaseTimestamp\":\"2021-02-02T02:59:38Z\"},{\"versionDisplay\":\"2.11.11\",\"releaseNotes\":\"1. إعادة تصميم الصفحة الرئيسية للشارة. تمت إضافة تصنيف الرتب الفصلي وتصنيف الرتب الأصدقاء للشارة الإنجازات.\\n2. تحسينات الأداء الأخرى\\n\\n1. Redesigned the Badge homepage. Added Achievement Badge Seasonal Ranking and Friends Ranking.\\n2. Other performance improvements\\n\",\"releaseDate\":\"2020-12-08\",\"releaseTimestamp\":\"2020-12-08T06:43:44Z\"}],\"websiteUrl\":\"http://www.yalla.live\",\"languageList\":[\"English\",\"Arabic\",\"Hindi\",\"Indonesian\",\"Portuguese\",\"Spanish\",\"Turkish\",\"Urdu\"],\"editorialNotes\":{\"tagline\":\"Chat with friends\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=859954007\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":316295168}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=859954007\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":316295168}]}],\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"requires32bit\":false,\"isGameCenterEnabled\":false,\"isSiriSupported\":false,\"releaseDate\":\"2016-04-19\",\"minimumOSVersion\":\"11.0\",\"hasInAppPurchases\":true,\"bundleId\":\"com.weieyu.yalla\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/64/44/ea/6444eac1-4f0f-619b-24db-638440ebc2d8/AppIcon-Yalla-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00d8c8\",\"textColor1\":\"161616\",\"textColor2\":\"161616\",\"textColor3\":\"123d3a\",\"textColor4\":\"123d3a\"},\"supportsGameController\":false,\"privacyPolicyUrl\":\"https://apiv2.yalla.live/web/Agreement.html?type=2\",\"videoPreviewsByType\":{},\"hasFamilyShareableInAppPurchases\":false,\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"http://www.yalla.live\",\"isDeliveredInIOSAppForWatchOS\":false,\"hasPrivacyPolicyText\":true,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features125/v4/69/22/bb/6922bb60-5310-9efa-2580-59565aa0cd0b/QlUtQVAtV1ctWWFsbGFfR3JvdXBfVm9pY2VfQ2hhdC5wbmc.png/{w}x{h}sr.{f}\",\"bgColor\":\"1e4d5a\",\"textColor1\":\"90fdb1\",\"textColor2\":\"90f0cd\",\"textColor3\":\"76d69e\",\"textColor4\":\"76ccb4\"},\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667