hone10,5\":465655808,\"iPhone10,4\":442664960,\"iPhone7,1\":465668096,\"iPad13,19\":429835264,\"iPhone14,7\":451634176,\"iPad14,5-A\":429839360,\"iPad14,5-B\":429839360,\"iPhone14,6\":429835264,\"iPhone14,5\":451634176,\"iPad13,11\":430255104,\"iPhone14,4\":451634176,\"iPad13,17\":429839360,\"iPad13,18\":429835264,\"universal\":567982080,\"iPod9,1\":434024448,\"iPhone14,8\":451634176,\"iPad13,16\":429839360,\"iPad6,7\":442664960,\"iPad6,4\":442664960,\"iPad6,3\":442664960,\"iPad6,8\":442664960,\"iPad13,8\":430255104,\"iPad13,9\":430255104,\"iPad13,4\":430255104,\"iPad13,5\":430255104,\"iPad13,6\":430255104,\"iPad13,7\":430255104,\"iPad13,1\":430255104,\"iPad13,2\":430255104}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/sa/apps/1377028992/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/sa/apps/1377028992/developer?l=en-GB\",\"data\":[{\"id\":\"1377028991\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/1377028991?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Stonemobile India Private Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/stonemobile-india-private-limited/id1377028991\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1696538324746,\"RTCI\":0}}},{\"id\":\"1562989000\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1562989000?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Contacts\",\"identifier\":\"CONTACTS\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Medical/Treatment Information\",\"Infrequent/Mild Sexual Content and Nudity\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/monkeychat-make-new-friends/id1562989000\",\"userRating\":{\"value\":3.1,\"ratingCount\":507,\"ratingCountList\":[199,34,25,21,228],\"ariaLabelForRatings\":\"3.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.5\",\"genreDisplayName\":\"Entertainment\",\"name\":\"MonkeyChat - Make new friends\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Chatwith Inc\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Welcome to MonkeyChat, the ultimate hangout spot for GenZ'ers like you! Connect with fellow young minds around the globe and bond over shared interests, whether it's music, memes, or mental health. Discover new friends, engage in exciting conversations, and expand your social circle like never before!\\n\\nKey Features:\\n- Instantly connect with real users from around the world\\n- Engage in lively video \u0026 text conversations and exchange ideas\\n- Discover diverse cultures, languages, and perspectives\\n- Create a profile that reflects your unique personality\\n- Customize your chat experience with emojis\\n- Stay connected on-the-go with our user-friendly interface\\n- Make lasting friendships that span across continents\\n\\nWith MonkeyChat, you can break barriers and forge meaningful connections with people from diverse backgrounds and cultures. Whether you're looking to make new friends, practice a new language, or explore different perspectives, MonkeyChat is your gateway to a global community of like-minded individuals. \\n\\nExperience the thrill of connecting with real people in real-time. Dive into vibrant discussions and share your thoughts, interests, and moments with a global audience. MonkeyChat brings people together, fostering a sense of belonging and creating unforgettable memories.\\n\\nDownload MonkeyChat now and join the vibrant community of global explorers, trendsetters, and genuine individuals. Embrace the world, connect with others, and make unforgettable connections on MonkeyChat!\\n\\nTerms of Service: https://www.monkeychat.app/TermsofService.html\\nPrivacy Policy: https://www.monkeychat.app/PrivacyPolicy.html\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://www.monkeychat.app\",\"versionHistory\":[{\"versionDisplay\":\"3.0.0\",\"releaseNotes\":\"Important update! We have solved the problem of program crashes!\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T08:10:21Z\"},{\"versionDisp