"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Sexual Content and Nudity\",\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":139,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/hiya-group-voice-chatroom/id1526086695\",\"userRating\":{\"value\":4.2,\"ratingCount\":921,\"ratingCountList\":[100,39,62,98,622],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.3\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Hiya - Group Voice Chatroom\",\"isPreorder\":false,\"artistName\":\"FUNI.PTE.LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Hiya is a fantastic Group Voice chat app! Share your life with others all over the world.You will talk with others by sharing your stories or your ideas.Join an online party in Hiya anytime anywhere.Use exciting in-app features to make your party more excited!\\n\\nFree Group voice chat\\nJoin a group chat room and start a voice chat party, have fun with  your friends.Hiya is an amazing app to let you talk with a lot of interesting people easily.Whatever you are passionate about, we have a chat room for you. \\n\\nExceptional gifts\\nHiya extraordinary and stunning gifts are provided for you to express your wishes to your friends.\\n\\nGame center\\nPlay games together directly in a chat group! Come here and have fun playing awesome leisure games.\\n\\nEntertaining community \\nA community based on mutual respect among users, to  have fun and spend an enjoyable and relaxing time. With many gorgeous people by your side, you will never get bored.\\n\\nFast and easy Login\\nHiya support login with your Facebook , google or phone number. \\n\\nGet ready to have an amazing audio chat with your friends!\\nFor any feedback \u0026 inquiries: Official Customer Service\\nLeave your precious suggestions without any hesitation!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"4.7.2\",\"releaseNotes\":\"iOS 17 FIX\",\"releaseDate\":\"2023-09-27\",\"releaseTimestamp\":\"2023-09-27T02:05:06Z\"},{\"versionDisplay\":\"4.7.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2023-09-23\",\"releaseTimestamp\":\"2023-09-23T01:19:09Z\"},{\"versionDisplay\":\"4.6.2\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2023-09-14\",\"releaseTimestamp\":\"2023-09-14T11:28:53Z\"},{\"versionDisplay\":\"4.6.0\",\"releaseNotes\":\"BUG FIX\",\"releaseDate\":\"2023-09-13\",\"releaseTimestamp\":\"2023-09-13T01:50:49Z\"},{\"versionDisplay\":\"4.5.2\",\"releaseNotes\":\"BUG FIX\",\"