,\"textColor3\":\"b5b5b5\",\"textColor4\":\"a9a9a9\"}},\"subtitle\":\"Enjoy party\u0026Play Turkish okey\",\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/5d/88/fc/5d88fc7d-b697-47c3-ccbd-c7ba90f6f739/3c3c9657-c916-4ee3-bb87-32046b6c11ef_1.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f7f3cd\",\"textColor2\":\"c5c5f8\",\"textColor3\":\"e0d0ae\",\"textColor4\":\"b7abd1\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/18/e7/5c/18e75c21-2ac1-7079-3f27-0015e05e823e/d3cd4730-a495-47dd-b654-c24c4c57598d_8.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"e0d7c3\",\"textColor4\":\"e0d0ae\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ec/0a/02/ec0a021c-f14c-3032-34fb-f85350854c7a/5e7fb6d9-bfe9-4af8-942f-ac6af6ee7cae_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"48447f\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"d5d7d1\",\"textColor4\":\"d4d0bd\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ff/f7/99/fff79966-f3b0-5fcb-4113-f78582da3817/bfb766e0-150c-4a71-9136-ffca2d8eb62a_3.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"131421\",\"textColor1\":\"ffffff\",\"textColor2\":\"ababed\",\"textColor3\":\"cfd0d2\",\"textColor4\":\"8c8dc4\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/6c/d3/ab/6cd3abda-1ba7-0c56-5b68-3d7fb692f9ad/9f12910d-e057-4176-8654-4bfa62f6e468_4.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"e0d7c3\",\"textColor4\":\"e0d0ae\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/9f/85/de/9f85de1c-