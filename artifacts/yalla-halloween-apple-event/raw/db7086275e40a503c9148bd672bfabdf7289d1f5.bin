hone10,2\":164534272,\"iPhone10,1\":164558848,\"iPhone14,3\":164114432,\"iPhone14,2\":164114432,\"iPhone10,6\":164534272,\"iPhone10,5\":164534272,\"iPhone10,4\":164558848,\"iPad13,19\":164139008,\"iPad14,5-A\":164139008,\"iPhone14,7\":164114432,\"iPhone14,6\":164139008,\"iPad14,5-B\":164139008,\"iPhone14,5\":164114432,\"iPad13,11\":164558848,\"iPhone14,4\":164114432,\"iPad13,17\":164139008,\"iPad13,18\":164139008,\"universal\":167183360,\"iPod9,1\":164558848,\"iPad13,16\":164139008,\"iPhone14,8\":164114432,\"iPad6,7\":164558848,\"iPad6,4\":164558848,\"iPad6,3\":164558848,\"iPad6,8\":164558848,\"iPad13,8\":164558848,\"iPad13,9\":164558848,\"iPad13,4\":164558848,\"iPad13,5\":164558848,\"iPad13,6\":164558848,\"iPad13,7\":164558848,\"iPad13,1\":164558848,\"iPad13,2\":164558848}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/sa/apps/6447761097/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/sa/apps/6447761097/developer?l=en-GB\",\"data\":[{\"id\":\"1541590522\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/1541590522?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"WEO technology limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/weo-technology-limited/id1541590522\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1696687185574,\"RTCI\":0}}},{\"id\":\"1509626067\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1509626067?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Simulated Gambling\",\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Frequent/Intense Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/sango/id1509626067\",\"userRating\":{\"value\":4,\"ratingCount\":110,\"ratingCountList\":[18,3,8,9,72],\"ariaLabelForRatings\":\"4.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"Sango\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"MQJC TECHNOLOGY PTE. LTD.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Sango is the best place to go live and voice chat! Join now to meet awesome friends worldwide, showcase talents, and support artists! Share your life with others all over the world. You will talk with others by sharing your stories or your ideas. Join an online party in Sango!\\r\\n\\r\\nEnjoy your day with us!\\r\\n\\r\\n\\r\\nWith Sango you can: \\r\\n\\r\\n- have a funny encounter\\r\\n\\r\\n- have a deep conversation\\r\\n\\r\\n- make new friends\\r\\n\\r\\n\\r\\n---------Why Sango？---------\\r\\n\\r\\n\\r\\nLive Voice Chat \\r\\n\\r\\n- Create a High-quality voice chat with up to 10 people in your Room.\\r\\n\\r\\n- Chat with strangers to expand your social community network.\\r\\n\\r\\n- Make use of our live voice chat with interactive voice emojis to have fun.\\r\\n\\r\\n\\r\\nEntertaining Community \\r\\n\\r\\n-Create rooms more convenient \\r\\n\\r\\n-Sango is filled with diverse, voice content streaming every second!\\r\\n\\r\\n\\r\\nWant more features? Get Sango right now!\\r\\n\\r\\n\\r\\nFunny Tribal Theme\\r\\n\\r\\n-There are three tribes of Lion, Eagle, and Shark for you to join us. \\r\\n\\r\\n-Join a ‘Tribal’ and invite your friends and families too. More fun activities are waiting for you.\\r\\n\\r\\n\\r\\nLIVE PK\\r\\n\\r\\n-You can challenge anyone by on click the button. The winner will get more awards, and the loser will accept funny punishment. \\r\\n\\r\\nHave PK with your friends and punish those who lose!\\r\\n\\r\\n\\r\\nMini Games in Real-time\\r\\n\\r\\n-Sango Game box has more fun games waiting for you\\r\\n\\r\\n-Games can make you happier while chatting online. Find friends through playing games!\\r\\n\\r\\n\\r\\nStatus symbol\\r\\n\\r\\n-Aristocrat is the exclusive status symbol of sango. There are different levels of aristocrat which has corresponding privileges, you can get the aristocrat and enjoy the privileges by paying monthly to activate it!\\r\\n\\r\\n\\r\\nBECOME PART OF OUR SANGO SOCIAL COMMUNITY\\r\\n\\r\\n\\r\\nSharing Moment\\r\\n\\r\\n-No matter daily life or mood quotes, sharing your life, Live your moments to Sango Instantly.\\r\\n\\r\\n-Send comments and express likes to your friends.\\r\\n\\r\\n\\r\\nDiscover More Friends\\r\\n\\r\\n-You can easily change the country for the recommended content.\\r\\n\\r\\n-Don’t just listen to others’ Rooms! Share your thoughts in the chat, and support the one you like by sending comments and Gifts!\\r\\n\\r\\n\\r\\nA diversity of gifts\\r\\n\\r\\n-We have animated gifts, festival gifts and gifts for specific events to show your adoration!\\r\\n\\r\\n-Here on Sango, you can not only express your likes but also receive likes from others. Come to Sango to see the new world!\\r\\n\\r\\n\\r\\nCommon Interests Groups\\r\\n\\r\\n-Choose the topic you are interested in and talk with a group of like-minded friends!\\r\\n\\r\\n-Create a topic you are interested in and invite your friends and family to interact with you!\\r\\n\\r\\n\\r\\nTalk and chat with talented people nearby or from all over the world.\\r\\n\\r\\nShare your special stories and promote social events on your profile page for everyone to see!\\r\\nParticipate in online live stream events: Singing contests (Song Contests), Music Competitions\\r\\n\\r\\nVIP status for the best fans: Follow your favourite streamers and be the first to know when they go live.\\r\\n\\r\\n\\r\\nSAY HELLO:\\r\\n\\r\\nIf you have any questions when using the app: support@sango.sg.\\r\\n\\r\\nIf you want to be our partner: marketing@sango.sg\\r\\n\\r\\nsango offers a premium subscription plan to provide a more personalized experience, with prices ranging from $1.99 to $191.99 per month。\\r\\n--Payment: Users confirm their purchase and payment is sent to their ITunes account\\r\\n-- Cancellation: To cancel, please manually turn off auto-renewal in iTunes/Apple ID settings management 24 hours prior to the expiration of your current subscription cycle.\\r\\n--Renewal: Apple iTunes account will be debited within 24 hours before expiration, after successful debit, the subscription cycle will be extended by one subscription cycle.\\r\\n--First Month Offer: Each Apple account enjoys one first month offer.\\r\\n--Privacy Policy: https://h5.meiqijiacheng.com/to-h5/noble/agreementPage\\r\\n--User Agreement: https://h5.meiqijiacheng.com/to-h5/noble/agreementPage\\r\\n--Subscription Agreement: https://h5.meiqijiacheng.com/to-h5/noble/agreementPage\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://sango.sg\",\"versionHistory\":[{\"versionDisplay\":\"5.7.1\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-08-30\",\"releaseTimestamp\":\"2023-08-30T02:22:53Z\"},{\"versionDisplay\":\"5.7.0\",\"releaseNotes\":\"NEW Functions in Tribe chat group is online!\",\"releaseDate\":\"2023-08-03\",\"releaseTimestamp\":\"2023-08-03T11:13:39Z\"},{\"versionDisplay\":\"5.6.5\",\"releaseNotes\":\"-Improve user experience\",\"releaseDate\":\"2023-07-28\",\"releaseTimestamp\":\"2023-07-28T12:43:27Z\"},{\"versionDisplay\":\"5.6.3\",\"releaseNotes\":\"- Room entry experience upgrade\\r\\nNo more waiting, speed up for room entry\\r\\n\\r\\n- New Room Structure\\r\\nMore effective and attractive interaction experience\\r\\n\\r\\n- New GameBox\\r\\nVarious games for playing anytime\\r\\nUpdate of Magic Cube \\r\\n\\r\\n- Bugs fixed\\r\\n\",\"releaseDate\":\"2023-07-19\",\"releaseTimestamp\":\"2023-07-19T07:39:48Z\"},{\"versionDisplay\":\"5.6.2\",\"releaseNotes\":\"- Room entry experience upgrade\\nNo more waiting, speed up for room entry\\n\\n- New Room Structure\\nMore effective and attractive interaction experience\\n\\n- New GameBox\\nVarious games for playing anytime\\nUpdate of Magic Cube \\n\\n- Bugs fixed\\n\",\"releaseDate\":\"2023-07-11\",\"releaseTimestamp\":\"2023-07-11T12:42:36Z\"},{\"versionDisplay\":\"5.6.1\",\"releaseNotes\":\"- Room entry experience upgrade\\nNo more waiting, speed up for room entry\\n\\n- New Room Structure\\nMore effective and attractive interaction experience\\n\\n- New GameBox\\nVarious games for playing anytime\\nUpdate of Magic Cube \\n\\n- Bugs fixed\",\"releaseDate\":\"2023-07-03\",\"releaseTimestamp\":\"2023-07-03T01:54:34Z\"},{\"versionDisplay\":\"5.6.0\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-06-27\",\"releaseTimestamp\":\"2023-06-27T08:04:22Z\"},{\"versionDisplay\":\"5.5.6\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-06-20\",\"releaseTimestamp\":\"2023-06-20T01:57:34Z\"},{\"versionDisplay\":\"5.5.5\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-06-13\",\"releaseTimestamp\":\"2023-06-13T15:52:06Z\"},{\"versionDisplay\":\"5.5.4\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-06-09\",\"releaseTimestamp\":\"2023-06-09T14:09:51Z\"},{\"versionDisplay\":\"5.5.3\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-06-05\",\"releaseTimestamp\":\"2023-06-05T02:22:05Z\"},{\"versionDisplay\":\"5.5.2\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-05-29\",\"releaseTimestamp\":\"2023-05-29T09:43:26Z\"},{\"versionDisplay\":\"5.5.1\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-05-26\",\"releaseTimestamp\":\"2023-05-26T08:24:57Z\"},{\"versionDisplay\":\"5.5.0\",\"releaseNotes\":\"- Voice Chat Private Space is now available, come and meet interesting friend nearby, show your personal style!\\n- Minor bugs fixes\",\"releaseDate\":\"2023-05-19\",\"releaseTimestamp\":\"2023-05-19T06:07:12Z\"},{\"versionDisplay\":\"5.4.0\",\"releaseNotes\":\"- New nobles are coming online, come to get your honorable status\\n- Great upgrade of privileges, rich privileges to help you create a shining character\\n- Minor bugs fixes\",\"releaseDate\":\"2023-05-13\",\"releaseTimestamp\":\"2023-05-13T11:04:28Z\"},{\"versionDisplay\":\"5.3.5\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-04-27\",\"releaseTimestamp\":\"2023-04-27T02:08:53Z\"},{\"versionDisplay\":\"5.3.4\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-04-20\",\"releaseTimestamp\":\"2023-04-20T03:34:59Z\"},{\"versionDisplay\":\"5.3.2\",\"releaseNotes\":\"\\\"Tribe Level\\\" is now online! \\nFriends who join the same tribe are like a big family. Singing, playing games, and chatting with other people in the tribe, while having a good time, can also increase the prosperity of your tribe.\\nThe most prosperous tribes will occupy the Tribe cover. Come and contribute to the tribe with your friends!\\n\\n\\\"Chat Head\\\" is now available!\\nThe Chat Heads allow you to quickly view and reply to messages anytime, anywhere on any page in Sango\",\"releaseDate\":\"2023-04-01\",\"releaseTimestamp\":\"2023-04-01T14:32:05Z\"},{\"versionDisplay\":\"5.3.1\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-03-26\",\"releaseTimestamp\":\"2023-03-26T14:57:28Z\"},{\"versionDisplay\":\"5.3.0\",\"releaseNotes\":\"‒ The room is fully upgraded to a tribe, come and experience the voice room and chat group.\\n‒ Join a friend's tribe and hang out together.\\n‒ Now you can quickly enter the tribe's chat group in the chat list.\\n‒ The Story upgrade, come and promote your favorite stories to get more people to see them! \\n‒ You can now also permanently display your stories on your profile.\\n‒ Minor bugs fixes.\",\"releaseDate\":\"2023-03-16\",\"releaseTimestamp\":\"2023-03-16T14:41:55Z\"},{\"versionDisplay\":\"5.2.3\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T18:17:06Z\"},{\"versionDisplay\":\"5.2.2\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-03-01\",\"releaseTimestamp\":\"2023-03-01T14:35:57Z\"},{\"versionDisplay\":\"5.2.1\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T17:05:25Z\"},{\"versi