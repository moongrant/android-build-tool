pe\":\"apps\",\"href\":\"/v1/catalog/sa/apps/1488887716?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/yalla-lite-group-voice-chat/id1488887716\",\"userRating\":{\"value\":4.4,\"ratingCount\":1084,\"ratingCountList\":[95,34,43,60,852],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Yalla Lite - Group Voice Chat\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Lite is the lightweight version of Yalla, which is the most popular Live Group Voice Talking and Entertaining Community.\\n\\nAdvantages of Yalla Lite:\\n- Less Size: Faster to install and saves space on your phone\\n- Faster Speed: Enjoy classic features at a faster speed\\n\\nMeet new friends is never easier:\\nChoose group voice rooms from THOUSANDS live rooms daily, filter rooms by Countries or Topics. 50+ Countries have already been covered, while tons of topics are available to choose from.\\n\\nParty with friends with no distance:\\nGroup voice talk with friends no matter where they are, broadcast your favorite music inside the room, sing karaoke together, and play a range of games directly in group chat. Let's get the party started.\\n\\nFEATURES:\\n\\nTOTALLY FREE — Enjoy free live voice chat over 3G, 4G, LTE, or Wi-Fi.\\n\\nPUBLIC CHAT ROOMS — Browse THOUSANDS live chat rooms from NEARBY or AROUND THE WORLD that cover thousands of topics. \\n\\nPRIVATE CONVERSATIONS — Start private one-on-one text and voice conversations with your friends from anywhere in the world.\\n\\nVIRTUAL GIFTS — Stunning animated gifts can be sent out to express your love.\\n\\nFollow us to get the latest news, updates and events:\\nWebsite: www.yalla.live\\n\\nDear users, your feedback and suggestions are welcomed to: yallasupport@yalla.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-07-12\",\"releaseTimestamp\":\"2023-07-12T01:34:52Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\r\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\r\\n2. Improved user experience\",\"releaseDate\":\"2022-07-12\",\"releaseTimestamp\":\"2022-07-12T01:49:57Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"1. تمت إضافة عنصر جديد في المتجر: أي دي غرفة مميز.\\r\\n2. يمكنك تغيير اسم العرض لأصدقائك حتى تتمكن من التعرف عليهم بسهولة.\\r\\n3. يمكنك الآن تعيين سعر محدد ونطاق عدد لرقم الحظ في غرفتك.\\r\\n4. يمكنك الآن إرفاق ما يصل إلى 3 لقطات شاشة في وقت واحد عند إرسال اشتكاء أو الأسئلة الشائعة والانطباعات.\\r\\n5. تحسينات أخرى في الأداء.\\r\\n\\n1. Added a new item in the store: Unique Room ID\\n2. You can change the display name for your friends so you can easily recognize them.\\n3. You can now set the price and number range of Lucky Number in your room.\\n4. You can now attach up to 3 screenshots at a time when submitting report or feedback.\\n5. Other performance improvements.\",\"releaseDate\":\"2020-09-28\",\"releaseTimestamp\":\"2020-09-28T02:10:53Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"1. يحتوي مشغل موسيقى الغرفة الآن على شريط تحكم وزر تكرار الأغنية. \\r\\n2. تباع الآن أقفال الغرفة كعناصر اشتراك. \\r\\n3. يتم عرض أسعار عمليات الشراء داخل التطبيق بالعملة المحلية. \\r\\n4. تحسينات الأداء الأخرى\\n\\n1. The room music player now has a seekbar and a song repeat button.\\n2. Room locks are now sold as subscription items.\\n3. Prices for in-app purchases are displayed in local currency. \\n4. Other performance improvements.\\n\",\"releaseDate\":\"2020-06-22\",\"releaseTimestamp\":\"2020-06-22T01:52:12Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2020-01-14\",\"releaseTimestamp\":\"2020-01-14T01:54:01Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2020-01-06\",\"releaseTimestamp\":\"2020-01-06T01:51:21Z\"}],\"websiteUrl\":\"https://www.yalla.live\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1488887716\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=858171233\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":86962176}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1488887716\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=858171233\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":86962176}]}],\"requires32bit\":false,\"releaseDate\":\"2020-01-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallalite\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/c4/f2/71/c4f27119-8bde-7efa-021b-dca2cbff393e/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00d8c8\",\"textColor1\":\"161616\",\"textColor2\":\"161616\",\"textColor3\":\"123d3a\",\"textColor4\":\"123d3a\"},\"videoPreviewsByType\":{},\"privacyPolicyUrl\":\"https://liteapi.yalla.live/web/Agreement.html\",\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://www.yalla.live\",\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features122/v4/fc/66/99/fc6699fa-3d54-7d24-9d78-7ab18d2a6b62/cbf2b92a-fdd8-46b1-bb83-f0087c93f7ea.png/{w}x{h}sr.{f}\",\"bgColor\":\"acf9c1\",\"textColor1\":\"031110\",\"textColor2\":\"0a100f\",\"textColor3\":\"1d332a\",\"textColor4\":\"21332a\"},\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},