:116218880,\"iPad13,5\":116218880,\"iPad13,6\":116218880,\"iPad13,7\":116218880,\"iPad13,1\":116218880,\"iPad13,2\":116218880}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/sa/apps/286274367/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"url\":\"https://itunes.apple.com/sa/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/sa/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"url\":\"https://itunes.apple.com/sa/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/sa/apps/286274367/developer?l=en-GB\",\"data\":[{\"id\":\"284965852\",\"type\":\"developers\",\"href\":\"/v1/catalog/sa/developers/284965852?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Palringo Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/sa/developer/palringo-limited/id284965852\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1696536971815,\"RTCI\":0}}},{\"id\":\"6447761097\",\"type\":\"apps\",\"href\":\"/v1/catalog/sa/apps/6447761097?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Frequent/Intense Profanity or Crude Humour\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":1,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/sa/charts/iphone/entertainment-apps/6016\"}},\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/sa/app/jaco-%D8%AC%D8%A7%D9%83%D9%88/id6447761097\",\"userRating\":{\"value\":4.5,\"ratingCount\":1961,\"ratingCountList\":[158,50,60,74,1619],\"ariaLabelForRatings\":\"4.5 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"JACO جاكو\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"WEO technology limited\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6447761097\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=860329279\",\"type\":\"get\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":167183360}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6447761097\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=860329279\",\"type\":\"update\",\"priceFormatted\":\"SAR 0.00\",\"price\":0,\"currencyCode\":\"SAR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":167183360}]}],\"requires32bit\":false,\"minimumMacOSVersion\":\"11.0\",\"releaseDate\":\"2023-06-16\",\"hasInAppPurchases\":true,\"bundleId\":\"com.weo.projectz\",\"description\":{\"standard\":\"Jaco is the perfect blend of luxury and live streaming app. It's a place where different communities - entertainment, sports, music, gaming - come together for a good time. On jaco, you can discover live streaming, audio chat, and PK to experience the unique cultural atmosphere. Whether you want to be an audience or a streamer, Jaco is the spot to be for a fun and engaging experience. \\n\\nWe offer dozens of beauty effects and filters to make it easier for you to go live in a personalized way. Jaco is where you can \\\"Livin Live\\\". Join us to share life and become a part of the new era live streaming app.\\n\\nExperience the best of live streaming with Jaco! Here's what you can do on the platform\\n• Watch famous streamers go live in real-time.\\n• Explore a diverse range of shows and discover new talents.\\n• Link and PK with mystery guests.\\n• Share your life and story by starting your own live streams.\\n• Share your streams on social media and grow your following!\\n\\n‣ Arabic Style Gifts\\nWe specially customize gifts with our cultural characteristics for all of you. Kleeja, Arabic coffee, Falcon, Wolf, and Leopard in Al Ula. We will continue to create more special gifts to make you feel at home on Jaco. Stay tuned for more surprises.\\n\\n‣ Quick Invitation\\nElevate the excitement and engagement of your livestreams by inviting a random viewer to chat or compete with you in a PK game using Jaco's exciting random invitation feature. Keep your audience on their toes with an unexpected twist.\\n\\n‣ Solid Community\\nConnect with like-minded individuals on the app. Our cool community is waiting for you to join us and experience the power of connection on our livestreaming platform.\\n\\n‣ Customize Your Profile\\nShow off your unique personality and interests by customizing your Jaco profile with up to 5 photos. Whether you're showcasing your hobbies, travels, or daily life, Jaco gives you the flexibility to create a profile that truly represents who you are.\\n\\n‣ Best DM Experience\\nConnect with your followers and friends like never before using Jaco's direct messaging feature. Our app supports groups, voice memos, images, and videos, providing the best DM experience possible.\\n\\n‣ Best Gaming Experience\\nGamers can enjoy live streaming their games with OBS tool provided by JACO. \\n\\nDownload Jaco now and join our dynamic and vibrant community of livestreams!\\n\\nIf you have any questions or queries, please feel free to contact us at our email: contact@jaco.live or @Hey_Jaco on Twitter, Instagram, TikTok, SnapChat.\"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/4d/c6/19/4dc6197b-7300-94da-9627-9c54478de216/AppIcon-1x_U007ephone-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"3c1172\",\"textColor2\":\"431e72\",\"textColor3\":\"63418e\",\"textColor4\":\"694b8e\"},\"videoPreviewsByType\":{},\"privacyPolicyUrl\":\"https://jaco.live/privacy/en\",\"isAppleWatchSupported\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://jaco.live\",\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-10-02\",\"releaseTimestamp\":\"2023-10-02T14:08:23Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-09-28\",\"releaseTimestamp\":\"2023-09-28T17:09:19Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"1. Streamers can now access settings before starting a live, including comments, invitations, and moderators settings.\\n2. In-App notifications! Users can customize message alerts for inside and outside live rooms.\\n3. Viewers can now enlarge comments, while streamers can filter enlarged comments.\\n4. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T19:57:28Z\"},{\"versionDisplay\":\"1.3.2\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-09-15\",\"releaseTimestamp\":\"2023-09-15T17:51:13Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-09-08\",\"releaseTimestamp\":\"2023-09-08T16:43:44Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"1. Added new live features including Autofocus, Exposure Compensation, and Screen Zoom.\\n2. Added a feature allowing streamers to appoint up to 5 live room moderators to assist in maintaining a positive atmosphere within the live room.\\n3. Upgraded the user privileges system by adding new features such as personalized usernames (at level 40), exclusive custom gifts (at level 50), separate user announcements with each level-up (starting from level 20), and distinctive presentation of comments and other privileges.\\n4. Added the clear mode to enhance the experience of the live room audience.\\n5. Enhanced the display of essential information and the streamer's visual screen before starting co-streaming.\\n6. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-09-05\",\"releaseTimestamp\":\"2023-09-05T08:16:24Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-08-19\",\"releaseTimestamp\":\"2023-08-19T21:50:11Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-08-16\",\"releaseTimestamp\":\"2023-08-16T05:50:31Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"1.Ready for Challenge?\\n2. Fixed the issue with the camera permission access \\n3. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-08-14\",\"releaseTimestamp\":\"2023-08-14T16:11:28Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-08-09\",\"releaseTimestamp\":\"2023-08-09T08:35:47Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-08-04\",\"releaseTimestamp\":\"2023-08-04T19:15:14Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"1. Open JACO box! and Try your luck.\\n2. Launched the special follow feature.\\n3. Added a new withdrawal bank channel.\\n4. High-value gifts and announcement feature in every live room!\\n5. Improved Streamer Tools: Streamers now have enhanced control! Customize blocked words, delete comments, report users with specific reasons, manage co-streamers' cameras and microphones, and control audience comments and kick-out options\\n6. Fix some bugs and made some improvements.\",\"releaseDate\":\"2023-08-01\",\"releaseTimestamp\":\"2023-08-01T16:23:14Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-07-21\",\"releaseTimestamp\":\"2023-07-21T23:21:51Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-07-16\",\"releaseTimestamp\":\"2023-07-16T10:05:01Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1. Launched the Official Verification System.\\n2. Launched the badge system according to the supporter's level.\\n3. Released PK speed challenge feature.\\n4. Added the feature of replying to a specific comment in the live room.\\n5. Optimized live audio quality.\\n6. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-07-12\",\"releaseTimestamp\":\"2023-07-12T14:01:59Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. Squashed some bugs and made some improvements.\",\"releaseDate\":\"2023-06-22\",\"releaseTimestamp\":\"2023-06-22T09:33:31Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2023-06-16\",\"releaseTimestamp\":\"2023-06-16T19:06:45Z\"}],\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/fb/1d/8d/fb1d8d13-8d9b-4667-4632-979fcce14060/7842b9eb-ef81-48c7-82c1-fee36005ca00.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":758,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/b9/df/22/b9df22e4-d410-273a-f990-87ef45dc326b/53b5c834-2546-4ab9-b26a-5c5126c6851e.png/{w}x{h}{c}.{f}\",\"bgColor\":\"b6030c\",\"textColor1\":\"febc00\",\"textColor2\":\"febc00\",\"textColor3\":\"f09702\",\"textColor4\":\"f09702\"},\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/28/59/ee/2859eebe-20ac-7814-ec46-0fce7ce3d567/12fc09db-ce0f-4c5f-a841-6866788e0179.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"efefef\",\"textColor2\":\"dfdfdf\",\"textColor3\":\"b5b5b5\",\"textColor4\":\"a9a9a9\"}},\"subtitle\":\"Livin Live\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/3c/3d/e6/3c3de680-5134-681d-38a4-93e50673f8d4/05d0d92a-c62e-4fc7-8f72-d5d320ce57e4_English.jpeg/{w}x{h}{c}.{f}\",\"bgColor\":\"8412fc\",\"textColor1\":\"fffcff\",\"textColor2\":\"e3e1e7\",\"textColor3\":\"e6cdfe\",\"textColor4\":\"d0b8eb\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mz