:166212608,\"iPad6,3\":166212608,\"iPad6,8\":166212608,\"iPad13,8\":156994560,\"iPad13,9\":156994560,\"iPad13,4\":156994560,\"iPad13,5\":156994560,\"iPad13,6\":156994560,\"iPad13,7\":156994560,\"iPad13,1\":156994560,\"iPad13,2\":156994560}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/tr/apps/1534252521/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6016\"}}]},\"developer\":{\"href\":\"/v1/catalog/tr/apps/1534252521/developer?l=en-GB\",\"data\":[{\"id\":\"1533642207\",\"type\":\"developers\",\"href\":\"/v1/catalog/tr/developers/1533642207?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"SPREADFUN\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/tr/developer/spreadfun/id1533642207\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1738479488781,\"RTCI\":1737372696611}}},{\"id\":\"286274367\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/286274367?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Frequent/Intense Profanity or Crude Humour\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/wolf-qanawat/id286274367\",\"userRating\":{\"value\":4.3,\"ratingCount\":77,\"ratingCountList\":[10,1,3,6,57],\"ariaLabelForRatings\":\"4.3 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"11.0\",\"name\":\"WOLF Qanawat\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Palringo Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 15.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 15.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 15.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Join the Biggest Arabic Audio Entertainment Community!\\n\\n\\nWOLF Qanawat is the go-to app for diverse Audio communities, covering everything from entertainment and games to sports. You’ll find thousands of Channels full of all sorts of topics from podcasts, lifestyle tips, fashion and celebrity news, poetry, singing, competitions and regular daily chats. Meet friends from all over the Arab region, connect with them anytime, anywhere, and enjoy group or private conversations!\\n\\nFeatures:\\n\\nChoose Your Favourite Community. WOLF gives you the opportunity to choose your favourite community based on your interests whether it's entertainment, sports football, or gaming - WOLF has something for everyone! Enjoy every community's unique features and products; including Charms, hosted competitions and challenges, in addition to programmes that run around the clock, covering topics specific to each Channel.\\n\\nDiscover New Friendships Across the Arab Region. The WOLF community includes thousands of users from all over the Arab world. Making it easy to form friendships, share ideas, and have fun.\\n\\nFree Audio Channels. Discover thousands of open or private Channels with diverse content. Dive into the conversation with audio chats and messaging. \\n\\nLive Games and Competitions. Play with different WOLF games available in the store and earn prizes and achievements that will boost your reputation level and make you stand out in the community! Participate in ongoing competitions and challenges for a chance to win awesome prizes.\\n\\nStages and Talents. Follow your favourite celebrities and talents on WOLF Stages. Interact with them live and show your support with our Charm gifting feature! It doesn't stop here at WOLF - your voice is heard! Jump on Stage and share your thoughts and talents with the world. \\n\\n\\nFor more info, check out our website:\\nhttps://company.wolf.live/ar/\\n\\nGot questions? Reach out to us at: support@wolf.live\\n\\nFollow us on social media: \\nInstagram: https://www.instagram.com/wolfapparabic/\\nTikTok: https://www.tiktok.com/@wolfliveapp?lang=en\\nFacebook: https://www.facebook.com/wolfapparabic/?locale=ar_AR\\nTwitter: https://x.com/wolfapparabic\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\"