p\":\"2023-06-14T01:56:09Z\"},{\"versionDisplay\":\"2.21.0\",\"releaseNotes\":\"1. مستوى الثروة - افتح مستوى ثروتك واستمتع بامتيازات خاصة. \\r\\n2. تحسينات أخرى\\n\\n1. Wealth Level - Unlock your wealth level and enjoy distinguished privileges.\\r\\n2. Other improvements\",\"releaseDate\":\"2023-05-09\",\"releaseTimestamp\":\"2023-05-09T08:34:42Z\"},{\"versionDisplay\":\"2.20.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T01:28:32Z\"}],\"websiteUrl\":\"http://www.yalla.live\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"languageList\":[\"English\",\"Arabic\",\"Hindi\",\"Indonesian\",\"Portuguese\",\"Spanish\",\"Turkish\",\"Urdu\"],\"editorialNotes\":{\"tagline\":\"Chat with friends\"},\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=871880091\",\"type\":\"get\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":355145728}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1091902866\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=871880091\",\"type\":\"update\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":355145728}]}],\"requires32bit\":false,\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"isSiriSupported\":false,\"isGameCenterEnabled\":fal