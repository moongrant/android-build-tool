enres\":{\"href\":\"/v1/catalog/tr/apps/1489566586/genres?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6005\"}}]},\"developer\":{\"href\":\"/v1/catalog/tr/apps/1489566586/developer?l=en-GB\",\"data\":[{\"id\":\"1242210509\",\"type\":\"developers\",\"href\":\"/v1/catalog/tr/developers/1242210509?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"思伟 邹\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/tr/developer/%E6%80%9D%E4%BC%9F-%E9%82%B9/id1242210509\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1737681835160,\"RTCI\":1737635609318}}},{\"id\":\"1571242274\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/1571242274?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Simulated Gambling\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humour\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/party-star-live-chat-games/id1571242274\",\"userRating\":{\"value\":4.4,\"ratingCount\":218,\"ratingCountList\":[18,8,8,11,173],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Party Star -Live, Chat \u0026 Games\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"GUMDROP ENTERTAINMENT PTE. LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Good news for everyone, there is a chance to become star for free!\\nDo you want to be a star who attract everyone's attention? Come to Party Star! \\nThere are not only wonderful live stream, totally free group voice chat rooms, 1v1 private conversation, multiple funny activities and various games, but also exquisite gifts and magical entry effects that will surprise you, so come and join in! \\n\\nFeatures:\\n「Wonderful live stream」\\n- You can go live and watch live stream whenever you want.\\n- There are various types of live stream here, you can chat with the hosts in real time, watch wonderful dances, listen to beautiful singing, enjoy talk shows and so on.Features \\n\\n「Free group voice chat rooms」\\n- A variety of content rooms include singing, poems, games, making friends and more high- quality content rooms are waiting for you to choose. Thousands of broadcasters are always ready to welcome you.\\n- Join a group voice chat room and start your voice journey. Here, you can share your life with friends and make new friends around the world through your voice.\\n\\n「Game center」\\n- There are various games in Party Star, for instance, Ludo, Billiards, Carrom and other games for Arabs,  with perfect and high-quality voice chat when playing.\\n\\n「Private conversation」\\n- Create your own private room, invite your love into the room to chat in real time, use voice to convey thoughts on days when you can't see each other, and close the distance between love.\\n\\n「Exceptional gifts and entrance effects」\\n- Send your love unique gifts to show love, use gifts to maintain the emotional bond between you and your new or old friends, everyone is eager to receive gifts from others, and every gift sent to you by friends is a wish for your happiness!\\n\\nWhat are you waiting for, click to download Party Star. Party Star provides you with a platform to create a star identity, Party Star welcomes everyone to join, and builds a beautiful entertainment community!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://partystar.live\",\"versionHistory\":[{\"versionDisplay\":\"2.47.0\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2025-01-17\",\"releaseTimestamp\":\"2025-01-17T02:40:35Z\"},{\"versionDisplay\":\"2.46.1\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T13:11:12Z\"},{\"versionDisplay\":\"2.46.0\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T02:04:56Z\"},{\"versionDisplay\":\"2.45.1\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2025-01-02\",\"releaseTimestamp\":\"2025-01-02T16:08:31Z\"},{\"versionDisplay\":\"2.45.0\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2024-12-19\",\"releaseTimestamp\":\"2024-12-19T02:46:26Z\"},{\"versionDisplay\":\"2.44.0\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2024-12-06\",\"releaseTimestamp\":\"2024-12-06T16:46:49Z\"},{\"versionDisplay\":\"2.43.5\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwide\",\"releaseDate\":\"2024-11-30\",\"releaseTimestamp\":\"2024-11-30T17:31:54Z\"},{\"versionDisplay\":\"2.43.4\",\"releaseNotes\":\"New Party Star! Get ready for the new update!\\n- Better experience in the voice room\\n- Bug fixes\\nBe the Star of the Party! Meet new friends from worldwid