tem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Profanity or Crude Humour\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/fadfadah-chat/id1659937451\",\"userRating\":{\"value\":4.3,\"ratingCount\":20,\"ratingCountList\":[3,0,0,1,16],\"ariaLabelForRatings\":\"4.3 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.0.2\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Fadfadah Chat\",\"isPreorder\":false,\"artistName\":\"VioDev LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 13.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Fadfadah Chat, allows you to meet new people and make random conversations with them, you also can send a link to your friends friends to start a conversation with you, without revealing their identity.\\n\\nIt also allows you to frankly express your feelings and fears to others by using random conversations, to talk to thousands of online users from around the world.\\n\\nReceive constructive criticism in an interactive and fun way.\\n\\nReveal what others think of you to improve your weaknesses and correct how you deal with them.\\n\\nDownload the app now, to enjoy all its features. you can do so using your email, facebook, apple, or twitter account.\\n\\nOur App Includes:\\n• Auto-renewable subscription\\n• 1 week, 1 month and 3 month durations\\n• Your subscription will be charged to your iTunes account at confirmation of purchase and will automatically renew (at the duration selected) unless auto-renew is turned off at least 24 hours before the end of the current period.\\n• Current subscription may not be cancelled during the active subscription period; however, you can manage your subscription and/or turn off auto-renewal by visiting your iTunes Account Settings after purchase\\n\\n• End User License Agreement Link:\\nhttps://www.apple.com/legal/internet-services/itunes/dev/stdeula/\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"3.3.1\",\"releaseNotes\":\"Many improvements to user experience and app performance\",\"releaseDate\":\"2023-04-23\",\"releaseTimestamp\":\"2023-04-23T14:37:27Z\"},{\"versionDisplay\":\"3.3.0\",\"releaseNotes\":\"Many improvements to user experience and app performance\",\"releaseDate\":\"2023-04-09\",\"releaseTimestamp\":\"2023-04-09T05:15:40Z\"},{\"versionDisplay\":\"3.2.15\",\"releaseNotes\":\"Many improvements to user experience and app performance\\nAdding a way to buy points to support the app developers \",\"releaseDate\":\"2023-03-07\",\"releaseTimestamp\":\"2023-03-07T08:40:36Z\"},{\"versionDisplay\":\"3.2.14\",\"releaseNotes\":\"Many improvements to user experience and app performance\",\"releaseDate\":\"2023-03-06\",\"releaseTimestamp\":\"2023-03-06T07:57:36Z\"},{\"versionDisplay\":\"3.2.7\",\"releaseNotes\":\"Many improvements to user experience and app performance\",\"releaseDate\":\"2023-03-03\",\"releaseTimestamp\":\"2023-03-03T09:39:51Z\"},{\"versionDisplay\":\"3.2.5\",\"releaseNotes\":\"Many improvements to user experience and app performance\",\"releaseDate\":\"2023-03-01\",\"releaseTimestamp\":\"2023-03-01T02:17:10Z\"},{\"versionDispl