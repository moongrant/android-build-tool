7796366\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/6737796366?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Contests\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/yalla-jackaroo/id6737796366\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Yalla Jackaroo\",\"genreDisplayName\":\"Board\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Jackaroo: The most popular ad-free, free voice chat Jackaroo game in the Gulf Six Countries! Challenge and adventure with your friends in Yalla Jackaroo!\\n\\nMultiple Modes \\nTradition and innovation are all in Yalla Jackaroo, which can meet your gaming needs in all aspects!\\nBasic: Return to the classic and play easily! Traditional classic rules, enjoy the most original and pure game fun. \\nComplex: Double the strategy, upgrade the challenge! Explore infinite possibilities in the upgraded rules, every game is full of strategy and surprises!\\n\\nFree Voice Chat\\nReal-time voice communication, cooperate more tacitly with teammates, chat with friends more happily, making every game more interesting!\\n\\nRoom Mode\\nChoose teammates or invite friends to compete. Enjoy the fun of strategy and social interaction anytime, anywhere! \\nPublic Room: Team up online, find your peers, choose teammates and opponents, straight battle, double the excitement.\\nFriends Room: Create a dedicated room, chat and interact with friends, and enjoy the relaxing time of private games.\\n\\nLeague \u0026 Rank\\nCompete with the whole server, become the undisputed Jackaroo legend king! \\nLeague: Upgrade league, become the king of winning streaks, unlock exclusive rewards for high leagues. \\nRank: Compete with global players, view rankings in real time, strive for the top, become a Jackaroo legend.\\n\\nWhat are you waiting for? Come and experience it now! If you have any questions or suggestions, feel free to contact us at any time. We are committed to providing you with the best experience, ensuring that every moment is full of joy!\\n\\nContact Information: \\nWebsite: www.yallajackaroo.com\\nEmail: jackaroo.support@yalla.com\\nFacebook: Yalla Jackaroo-يلا جاكارو\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"websiteUrl\":\"https://www.yallajackaroo.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2025-01-27\",\"releaseTimestamp\":\"2025-01-27T15:07:38Z\"}],\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6737796366\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=870203057\",\"type\":\"get\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":161017856}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6737796366\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=870203057\",\"type\":\"update\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":161017856}]}],\"requires32bit\":false,\"releaseDate\":\"2025-01-27\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallajackaroo\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/b0/d1/c7/b0d1c78e-3f75-c9e3-42c3-1c0131c8ba23/AppIcon-1x_U007emarketing-0-5-0-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ce6e22\",\"textColor1\":\"070302\",\"textColor2\":\"080301\",\"textColor3\":\"2f1808\",\"textColor4\":\"2f1808\"},\"videoPreviewsByType\":{},\"privacyPolicyUrl\":\"https://www.yallajackaroo.com/agreements/en/privacy.html\",\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://www.yallajackaroo.com/\",\"isStandaloneForW