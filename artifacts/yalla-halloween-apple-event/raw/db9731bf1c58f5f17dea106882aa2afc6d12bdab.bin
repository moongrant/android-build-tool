\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6005\"}}]},\"developer\":{\"href\":\"/v1/catalog/tr/apps/1544887147/developer?l=en-GB\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/tr/developers/1444567250?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/tr/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1738551192536,\"RTCI\":1737454799691}}},{\"id\":\"1419536376\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/1419536376?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":46,\"genreName\":\"Family\",\"genre\":7009,\"chart\":\"top-free\",\"genreShortName\":\"Family\",\"chartLink\":\"https://apps.apple.com/tr/charts/iphone/family-games/7009\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/yalla-ludo-ludo-domino/id1419536376\",\"userRating\":{\"value\":4.1,\"ratingCount\":326,\"ratingCountList\":[56,7,15,26,222],\"ariaLabelForRatings\":\"4.1 stars\"},\"genreDisplayName\":\"Board\",\"name\":\"Yalla Ludo - Ludo\u0026Domino\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Yalla Ludo, featuring real-time voice chat, enables you to enjoy Ludo and Domino games with your friends online.\\n\\nReal-time voice chat\\nEngage in real-time voice chats with fellow players anytime, make new friends, and enjoy every moment of the game!\\n\\nVarious game modes\\nLudo: This includes 2 \u0026 4 Player modes and Team mode. Each mode has 4 gameplay styles: Classic, Master, Quick, and Arrow. \\nYou can also play the enchanting Magic mode. \\nDomino: This includes 2 \u0026 4 Player modes, with each mode having two gameplay styles: Draw Game and All Five. \\nOther games: A variety of new and exciting games await your discovery!\\n\\nHave fun with friends\\nTeam mode, private rooms, and local rooms offer the flexibility to play with friends both online and offline. Invite your friends and enjoy gaming together!\\n\\nVoice chat Room\\nThe chat room opens up a world where you can interact with gamers globally. Share gaming tips, send adorable gifts, and invite others to join you in Ludo \u0026 Domino. Grab the mic and experience fantastic moments in Yalla Ludo!\\n\\nLooking for extra game bonuses? Discover them with Yalla Ludo VIP.\\nSubscribe to Yalla Ludo VIP to unlock additional advanced features:\\nCollect free daily golds, diamonds, and daily VIP benefits.\\nEnjoy access to privileged game rooms: create your own room in the VIP room, invite friends for shared gameplay, and explore enhanced betting options.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Ludo VIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nLudo VIP includes two types: Knight and Baron. The price for Knight is USD 11.99/month and the price for Baron is USD 39.99/month. Prices are in U.S. dollars, may vary in countries other than the U.S., and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo without becoming a Yalla Ludo VIP.\\n\\nWe are committed to giving our all in delivering more entertaining games that will enrich your daily experiences!\\n\\n\\nPrivacy Policy：https://www.fyxtechhk.com/term/EN/TermOfService.html\\n\\nTerms of Service：https://www.fyxtechhk.com/term/EN/TermOfService.html#TermsOfService\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.4.2.2\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2025-01-23\",\"releaseTimestamp\":\"2025-01-23T01:59:00Z\"},{\"versionDisplay\":\"1.4.2.1\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-12-23\",\"releaseTimestamp\":\"2024-12-23T01:51:50Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"Updates:\\r\\n1.New Royal Privileges: You can customize the room theme. Moreover, you can also set the room theme image you uploaded as the background for private chats. Go try it out now~\\r\\n2.Brand new items: Room entry effects. Use them to match your vehicles and become a superstar in the room.\\r\\n3.New ranking - Room Likes Ranking List is here! Give Likes to your favorite rooms and help them get on the list.\\r\\n \\r\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-12-05\",\"releaseTimestamp\":\"2024-12-05T08:52:18Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"Updates:\\n1. Royal 5 Super Privileges are coming: Exclusive skins, vehicles, profile cards, and other privileges!\\n2. Sign-in benefits: The higher your level, the more sign-in rewards you can collect daily.\\n3. Feed list for chat rooms is coming soon.\\n4. Fixed the issue of being unable to log in to the game with X account and optimized the gaming experience. \\n\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T00:01:14Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"Updates:\\n1. Great news! The Royal Level has been upgraded to include Holiday Surprises and the Fortune Store. Claim holiday rewards and redeem exclusive skins and items with Fortune Coins.\\n2. Skin Fragments Exchange: Now you can exchange your excess skin fragments for higher-tier skins or golds.\\n3. Room Battle mode is coming soon: Join your preferred team within rooms. Try to win more battle points to earn glory.\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-07-17\",\"releaseTimestamp\":\"2024-07-17T08:00:43Z\"},{\"versionDisplay\":\"1.3.9.5\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-06-18\",\"releaseTimestamp\":\"2024-06-18T06:02:54Z\"},{\"versionDisplay\":\"1.3.9.4\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-05-28\",\"releaseTimestamp\":\"2024-05-28T10:06:58Z\"},{\"versionDisplay\":\"1.3.9.3\",\"releaseNotes\":\"Updates:\\r\\n1.Great news! Unique IDs now include new animation effects and extra 8-digit IDs. You can purchase and switch Unique IDs more easily. \\r\\n2.Color-customized gifts are now available. You can customize the gift color to your liking!\\r\\n3. Mic numbers have increased. A mode with 15 microphones is now available. Invite more friends on the mic to chat and enjoy more fun!\\r\\nThere's more content for you to explore and enjoy!\",\"releaseDate\":\"2024-05-09\",\"releaseTimestamp\":\"2024-05-09T02:34:28Z\"},{\"versionDisplay\":\"1.3.9.2\",\"releaseNotes\":\"Updates:\\r\\n1. Get ready for Jungle Ludo! The jungle is packed with secrets and spectacular items. Warriors, gear up for some adventures!\\r\\n \\r\\n2. Double-tap to like a Chat Room! Want to show some love? Just double-tap on an empty spot in the room. The more taps, the bigger the combo effects. Help your favorite rooms shine!\\r\\n \\r\\n3. Introducing Crocodile Dentist, a new mini-game, in chat rooms! Gather your friends for a game, take turns, and see who’s daring enough to face the bite. Who will it be?\\r\\n \\r\\nRamadan's Coming! We've got lots of new stuff for you to check out and enjoy. Stay tuned!\",\"releaseDate\":\"2024-03-07\",\"releaseTimestamp\":\"2024-03-07T01:59:54Z\"},{\"versionDisplay\":\"1.3.9.1\",\"releaseNotes\":\"Updates:\\n1. Bug Fixed.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2024-01-18\",\"releaseTimestamp\":\"2024-01-18T06:43:30Z\"},{\"versionDisplay\":\"1.3.9.0\",\"releaseNotes\":\"Updates:\\r\\n1. Introducing a brand-new profile page! Decorate your profile page with ornaments, profile themes, and profile cards to express your personality. Explore additional details such as game records, gift walls, and badges when you visit your profile page.\\r\\n\\r\\n2. Visit the Rank list to view the Achievement badge wall. Check out the rankings and see who's on top.\\r\\n\\r\\n3. We've added Gift Scoring to the chat room! Earn points by receiving gifts while on the mic. Come and give it a try!\\r\\n\\r\\nThe 5th anniversary is approaching! Take a look at our new logo, launch page, and background image. Join us for our anniversary celebration. There's more content for you to explore and enjoy!\",\"releaseDate\":\"2023-12-26\",\"releaseTimestamp\":\"2023-12-26T00:35:11Z\"},{\"versionDisplay\":\"1.3.8.2\",\"releaseNotes\":\"Updates:\\r\\n1. Bug Fixed.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-11-16\",\"releaseTimestamp\":\"2023-11-16T07:15:51Z\"},{\"versionDisplay\":\"1.3.8.1\",\"releaseNotes\":\"Updates:\\r\\n1. Fixed X login issues and game experience optimization.\\r\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-10-20\",\"releaseTimestamp\":\"2023-10-20T00:59:47Z\"},{\"versionDisplay\":\"1.3.8.0\",\"releaseNotes\":\"Updates:\\n1. Generous Login Rewards: Log in monthly for profile frames and collect 12 months to unlock a bonus permanent limited profile frame.\\n2. Room Activity Notice: Create notices for activities and invite others to join your party.\\n3. Personalized Playlists: Take control of your music with our playlist management feature. Organize your favorite songs effortlessly.\\nExplore more updates in Yalla Ludo!\",\"releaseDate\":\"2023-09-25\",\"releaseTimestamp\":\"2023-09-25T02:51:33Z\"},{\"versionDisplay\":\"1.3.7.0\",\"releaseNotes\":\"Updates:\\n1. Fight Ludo - Kill the maximum tokens within a specific time limit and emerge as the champion!\\n2. Happy Birthday - Set your birthday, and come to Yalla Ludo on your birthday to collect gifts and throw joyous parties in the room! \\n3. Room Pass - Engage with your friends in the room for a chance to win special rewards! (Refreshed every 14 days)\",\"releaseDate\":\"2023-07-20\",\"releaseTimestamp\":\"2023-07-20T02:31:32Z\"},{\"versionDisplay\":\"1.3.6.0\",\"releaseNotes\":\"Updates:\\r\\n1. Elite Rewards Tower - Unlock the Elite Reward Tower to receive even more rewards!\\r\\n2. New Stickers - Utilize stickers in games, private conversations, and chat rooms!\\r\\n3. Personalized Gifts - Send gifts that feature recipients' profile pictures to show your appreciation!\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T01:33:00Z\"},{\"versionDisplay\":\"1.3.5.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T10:38:09Z\"},{\"versionDisplay\":\"1.3.5.0\",\"releaseNotes\":\"Updates:\\r\\n1. Ramadan UI Design - Enjoy the new user interface designed for Ramadan and celebrate together!\\r\\n2. Arrow Mode - Experience a new game mode in Ludo that is more exciting!\\r\\n3. Higher Max Level - Play games to reach a higher max level of 80 at an optimized upgrade speed!\",\"releaseDate\":\"2023-03-17\",\"releaseTimestamp\":\"2023-03-17T06:26:34Z\"},{\"versionDisplay\":\"1.3.4.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T10:53:16Z\"},{\"versionDisplay\":\"1.3.4.0\",\"releaseNotes\":\"Updates:\\r\\n1. Snakes \u0026 Ladders - Enjoy the newly added classic game of Snakes \u0026 Ladders. You'll love the excitement and thrill of this timeless game!\\r\\n2. Champion Challenge - Get ready for the new Domino Champion Challenge! Play now and win free Domino skins!\\r\\n3. Random Wheel – This newly added mini-game lets you spin the wheel to have more fun with friends in the chat rooms!\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T01:57:38Z\"},{\"versionDisplay\":\"1.3.3.0\",\"releaseNotes\":\"Updates:\\r\\n1. Optimized Royal Privilege - You can choose the room theme you like as the private chat theme;\\r\\n2. Optimized Restart the Journey - More missions are waiting for you to explore;\\r\\n3. Added Backpack System - You can obtain gifts and magic cards in the backpacks through activities and tasks.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T05:47:02Z\"},{\"versionDisplay\":\"1.3.2.1\",\"releaseNotes\":\"Updates:\\n1. Bug fixed - The sound issue in the room has been resolved.\\n2. Royal Privileges -  You can enrich your bio and use your dice skins in the Chat Room.\\n3. Optimized Member System - Owners of the top 10 member clubs can obtain honor badges.\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T00:50:17Z\"},{\"versionDisplay\":\"1.3.2.0\",\"releaseNotes\":\"Updates:\\r\\n1. New Login Method - Login with YallaChat and get an exclusive profile frame.\\r\\n2. Royal Privileges -  You can enrich your bio and use your dice skins in the Chat Room.\\r\\n3. Optimized Member System - Owners of the top 10 member clubs can obtain honor badges.\",\"releaseDate\":\"2022-07-29\",\"releaseTimestamp\":\"2022-07-29T03:59:52Z\"},{\"versionDisplay\":\"1.3.1.0\",\"releaseNotes\":\"Updates:\\r\\n1.Restart the journey : special missions for players who return after 30-days offline. \\r\\n2.Added in-game interactive stickers.\\r\\n3.Added royal privileges and optimized gifts in Chat Room.\",\"releaseDate\":\"2022-05-09\",\"releaseTimestamp\":\"2022-05-09T05:46:32Z\"},{\"versionDisplay\":\"1.3.0.0\",\"releaseNotes\":\"Updates:\\n1. Newly designed Ramadan User Interface.\\n2. Added Reward Tower: You can now collect Plentiful new rewards.\\n3. Optimized Royal system: Added new exclusive Royal vehicles and tips on how to maintain your Royal Level.\",\"releaseDate\":\"2022-03-25\",\"releaseTimestamp\":\"2022-03-25T02:41:48Z\"}],\"websiteUrl\":\"https://www.yallaludo.com/\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"editorialNotes\":{\"short\":\"Every day brings new rewards, just complete your tasks.\",\"tagline\":\"It's in the Cards\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=871763184\",\"type\":\"get\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":447572992}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=871763184\",\"type\":\"update\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":447572992}]}],\"requires32bit\":false,\"releaseDate\":\"2018-09-27\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallagame\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f8/45/de/f845de80-64a9-458f-650e-e50d184078e0/AppIcon-1x_U007emarketing-0-7-0-0-sRGB-85-220-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fefefe\",\"textColor1\":\"271538\",\"textColor2\":\"0a222d\",\"textColor3\":\"524460\",\"textColor4\":\"3b4e56\"},\"privacyPolicyUrl\":\"https://www.fyxtechhk.com/term/EN/TermOfService.html\",\"videoPreviewsByType\":{\"iphone_d74\":[{\"previewFrame\":{\"width\":886,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo221/v4/07/bf/70/07bf7027-79ce-5b71-0445-91c32f391b55/Job60a9e38c-7baf-4433-b678-619b93b641ae-175528850-PreviewImage_Preview_Image_Interm