ype\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unrestricted Web Access\",\"Infrequent/Mild Mature/Suggestive Themes\",\"Infrequent/Mild Profanity or Crude Humour\",\"Frequent/Intense Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.5,\"ratingCount\":325,\"ratingCountList\":[25,4,14,13,269],\"ariaLabelForRatings\":\"4.5 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"Falla-Make new friends\",\"isPreorder\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.3.2\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-01-13\",\"releaseTimestamp\":\"2025-01-13T03:34:04Z\"},{\"versionDisplay\":\"8.3.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T06:13:18Z\"},{\"versionDisplay\":\"8.3.0\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2024-12-20\",\"releaseTimestamp\":\"2024-12-20T03:10:39Z\"},{\"versionDisplay\":\"8.2.2\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2024-12-05\",\"releaseTimestamp\":\"2024-12-05T08:12:29Z\"},{\"versionDisplay\":\"8.2.1\",\"releaseNotes\":\"1. Optimized user experience\\n2. Fixed some problems\",\"releaseDate\":\"2024-11-29\",\"releaseTimestamp\":\"2024-11-29T03:10:25Z\"