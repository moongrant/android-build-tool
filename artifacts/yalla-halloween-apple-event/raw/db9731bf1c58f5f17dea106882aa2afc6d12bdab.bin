s?l=en-GB\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6016?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/tr/genres/6005?l=en-GB\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/tr/genre/id6005\"}}]},\"developer\":{\"href\":\"/v1/catalog/tr/apps/1519557264/developer?l=en-GB\",\"data\":[{\"id\":\"1516091259\",\"type\":\"developers\",\"href\":\"/v1/catalog/tr/developers/1516091259?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Hawa Technology Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/tr/developer/hawa-technology-limited/id1516091259\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1738419028903,\"RTCI\":1737587333409}}},{\"id\":\"1377028992\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/1377028992?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Sexual Content and Nudity\",\"Frequent/Intense Profanity or Crude Humour\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Realistic Violence\",\"Infrequent/Mild Simulated Gambling\",\"Infrequent/Mild Medical/Treatment Information\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/youstar-group-voice-chat-room/id1377028992\",\"userRating\":{\"value\":3.9,\"ratingCount\":19,\"ratingCountList\":[3,1,1,4,10],\"ariaLabelForRatings\":\"3.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"7.5.8\",\"genreDisplayName\":\"Entertainment\",\"name\":\"YouStar-Group Voice Chat Room\",\"isPreorder\":false,\"artistName\":\"GOOD ONLINE TECHNOLOGY PTE.LTD.\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Youstar is a free multiplayer voice chat and entertainment community, chat with people nearby or around the world, and play a variety of interesting social games.\\n\\nFree voice chat room\\nYoustar has the safest and smoothest voice group chat room. No matter where you are, you can chat safely with Arab friends all over the world for free. Supports enjoying real-time voice chat using 3G, 4G, LTE or WI-FI networks.\\n\\n\\nFree online party\\nYou can hold free parties for birthdays, National Day, and Eid al-Fitr, or watch football matches in the room with like-minded friends for real-time commentary, or discuss the zodiac explanation to answer the zodiac password for you.\\n\\nCool virtual gifts\\nIn the chat room you can exchange cool gifts with your friends. There are stunning animated special effects to suit your needs.\\n\\nWonderful game\\nAlthough life is busy with trivial matters, Youstar will bring you a one-stop entertainment experience. In this app, you can play various exciting and fun mini-games such as Ludo, UMO, Crush, Lucky wheel, Fruit Party... and unlock endless gaming fun. From casual elimination to strategic competition, whether you are a newbie or an expert, you can find a game world that belongs to you.\\n\\nWatch rich video content\\nIn addition to games, YouStar can also enables you to watch various music MVs and video content from Youtube. Welcome to enjoy music from all over the world anytime and anywhere. Whether it is a popular hit or a retro classic, there is always a song that will suit your mood. The rich video content covers various fields such as comedy, food, tourism, technology, culture, etc., allowing you to travel around the world and experience different wonderful lives in just a few minutes.\\n\\nCommunity accessibility\\nYoustar is not only entertainment, but also a warm social circle. Here, you can meet like-minded friends and share the joy of entertainment and life with each other. Adding friends, instant chat, and interactive comments all reflect the warmth of friendship and the power of care. You can also show your talents here, share your mood text, and share the beauty of life with everyone.\\n\\nPersonalized recommendation\\nWe have carefully designed a personalized push function to recommend more entertainment content and social activities that suit your tastes based on your interests and usage habits. Whether you are a warrior who likes to challenge yourself, or an artistic youth who enjoys tranquility, YouStar can find the most suitable content for you, allowing you to find a sense of belonging and resonance here.\\n\\nLive video\\nAt the same time, our live broadcast function will also give you an immersive viewing experience. Watch the wonderful live broadcast, interact with everyone, become a member of the fan circle, and feel the real and beautiful emotional resonance.\\n\\nJoin Youstar now! Here, you will no longer be alone, because there is always a group of people in the world waiting to meet you and explore unlimited joy and passion together. Let us create our own new era of entertainment and social interaction together!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"8.2.4\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2025-01-20\",\"releaseTimestamp\":\"2025-01-20T01:07:15Z\"},{\"versionDisplay\":\"8.2.2\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-12-30\",\"releaseTimestamp\":\"2024-12-30T01:13:53Z\"},{\"versionDisplay\":\"8.2.1\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-12-19\",\"releaseTimestamp\":\"2024-12-19T11:50:37Z\"},{\"versionDisplay\":\"8.2.0\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-12-18\",\"releaseTimestamp\":\"2024-12-18T02:23:23Z\"},{\"versionDisplay\":\"8.1.9\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-11-22\",\"releaseTimestamp\":\"2024-11-22T23:06:27Z\"},{\"versionDisplay\":\"8.1.8\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-11-22\",\"releaseTimestamp\":\"2024-11-22T01:23:01Z\"},{\"versionDisplay\":\"8.1.7\",\"releaseNotes\":\"1) Optimize product experience and fix some issues\",\"releaseDate\":\"2024-11-07\",\"releaseTimestamp\":\"2024-11-07T12:05:51Z\"},{\"versionDisplay\":\"