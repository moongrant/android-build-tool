\":\"genres\",\"href\":\"/v1/catalog/tr/genres/7005?l=en-GB\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Card\",\"url\":\"https://itunes.apple.com/tr/genre/id7005\",\"parentId\":\"6014\"}}]},\"developer\":{\"href\":\"/v1/catalog/tr/apps/1513504421/developer?l=en-GB\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/tr/developers/1444567250?l=en-GB\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/0a/5d/94/0a5d949b-23eb-d333-dbed-69805e02936e/3358e551-817e-4d31-9c3d-7ab84479420b.png/{w}x{h}sr.{f}\",\"bgColor\":\"65dbcf\",\"textColor1\":\"081110\",\"textColor2\":\"081110\",\"textColor3\":\"1a3936\",\"textColor4\":\"1a3936\"}},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/tr/developer/yalla-technology-fz-llc/id1444567250\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1738837112584,\"RTCI\":1736814982186}}},{\"id\":\"6444792857\",\"type\":\"apps\",\"href\":\"/v1/catalog/tr/apps/6444792857?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/tr/app/yalla-match-vogue-star/id6444792857\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.5\",\"name\":\"Yalla Match - Vogue Star\",\"genreDisplayName\":\"Puzzle\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Features:\\n- No ADs\\n- No internet connection required, play offline anytime, anywhere!\\n- Enjoy a unique fashion-themed match-3 game with amusing obstacles and fun levels. It's suitable for both experts and beginners!\\n- Unlock and activate the powerful boosters! Experience the unique time freeze booster!\\n- Open mysterious treasure chests to get gold coins, unlimited lives and power-ups!\\n- Set up personal image studio and earn extra coins!\\n- Help helpless customers reshape their image and give them the confidence to pursue their dreams!\\n- Drama is everywhere, get ready to meet some dramatic characters!\\n\\n\\n\\nWelcome to Yalla Match – a personal fashion studio that gives customers new looks!\\n\\nAre you ready? College graduate new to society, music teacher chasing rock'n'roll dreams, painter who has lost his inspiration... helpless customers are waiting for your help! Start your career as a fashion stylist now! Develop a plan for each customer to help them rebuild their image, regain their confidence and start a new life full of hope! Stay alert of the conceited Kamila, she will interfere with your work, don't let her destroy your customers' confidence!\\n\\n\\nOn this fun-filled journey, you can earn coins by beating match-3 levels, complete makeovers to get props to continue your journey. You can also participate in activities such as Mystic Masquerade, Best Popularity, Club Battle, etc. to compete with other stylists and win rich rewards! There is no end to the fun and challenges!\\n\\n\\nEmbark on an epic journey as a stylist! Download now and start the challenge!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 metal \",\"websiteUrl\":\"https://www.yallamatch3.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.0.6.1\",\"releaseNotes\":\"Comprehensive upgrade of the Game UI.\\nBug fixes and experience improvements.\\nPerformance optimization targeted for most devices.\",\"releaseDate\":\"2024-06-03\",\"releaseTimestamp\":\"2024-06-03T08:30:29Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Comprehensive upgrade of the Game UI.\\nAdded Mini Games.\\nBug fixes and experience improvements.\\nPerformance optimization targeted for most devices.\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T10:41:49Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":null,\"releaseDate\":\"2024-03-08\",\"releaseTimestamp\":\"2024-03-08T00:41:44Z\"}],\"isXROSCompatible\":false,\"minimumXROSVersion\":\"1.0\",\"editorialNotes\":{\"tagline\":\"Polish your look with every win\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=866344865\",\"type\":\"get\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276151296}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6444792857\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=866344865\",\"type\":\"update\",\"priceFormatted\":\"₺0,00\",\"price\":0,\"currencyCode\":\"TRY\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276151296}]}],\"requires32bit\":false,\"releaseDat