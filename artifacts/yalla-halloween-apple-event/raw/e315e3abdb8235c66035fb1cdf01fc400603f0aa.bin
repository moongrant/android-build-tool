Phone14,2\":162154496,\"iPhone10,6\":162574336,\"iPhone10,5\":162574336,\"iPhone10,4\":161673216,\"iPad13,19\":161253376,\"iPhone14,7\":162154496,\"iPad14,5-A\":161253376,\"iPad14,5-B\":161253376,\"iPhone14,6\":161253376,\"iPhone14,5\":162154496,\"iPad13,11\":161673216,\"iPhone14,4\":162154496,\"iPad13,17\":161253376,\"iPad13,18\":161253376,\"universal\":166889472,\"iPod9,1\":161673216,\"iPhone14,8\":162154496,\"iPad13,16\":161253376,\"iPad6,7\":161673216,\"iPad6,4\":161673216,\"iPad6,3\":161673216,\"iPad6,8\":161673216,\"iPad13,8\":161673216,\"iPad13,9\":161673216,\"iPad13,4\":161673216,\"iPad13,5\":161673216,\"iPad13,6\":161673216,\"iPad13,7\":161673216,\"iPad13,1\":161673216,\"iPad13,2\":161673216}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1509626067/developer?l=en-US\",\"data\":[{\"id\":\"1505294156\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1505294156?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"MQJC TECHNOLOGY PTE. LTD.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/mqjc-technology-pte-ltd/id1505294156\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1509626067/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}}]}}},{\"id\":\"1489566586\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1489566586?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\",\"Unrestricted Web Access\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/bobo-group-voice-chat-rooms/id1489566586\",\"userRating\":{\"value\":3.8,\"ratingCount\":90,\"ratingCountList\":[17,5,5,14,49],\"ariaLabelForRatings\":\"3.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Entertainment\",\"name\":\"BoBo - Group Voice Chat Rooms\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"思伟 邹\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"BoBo is a global free voice chat app that supports Group voice chat rooms, you can chat and play games with your friends, even share your voice to make new friends.\\nDownload BoBo App and join the most interesting social party!\\n \\nWhy BoBo is the best social app for you?\\n \\nFree voice chat\\nYou can voice chat at any time, anywhere with a mobile data or WIFI, with us, you can meet the one you like.\\n \\nVoice chat rooms\\nChat with new friends all over the world.\\nJoin the most interesting magic social community in the world. Here you can introduce yourself to everyone, singing and sharing your interesting daily, and also make new friends all over the world.\\n \\nVirtual gifts\\nIf you meet someone but you don't know how to express your feelings? Just send a small gift to let him/her notice you.\\n \\nInteresting chat journey\\nBoBo has more than 6 types of rooms, you can find whatever you need\\nEmotional radio station: let you have a friend who will listen to you on the Internet and share your happiness; you will also meet new friends who have common interests with you here.\\nGame/Task room: let you relax and have fun with online games and some interesting task.\\nStill, there are other interesting chat rooms waiting for you to experience.\\n \\nBoBo requests the following permissions:\\nMicrophone: Delivering sound during live broadcast\\nCamera: Take photos and videos\\nAuthorization Request: BoBo needs your permission to obtain storage space that helps you to get a better experience and ensure the normal use of the app\\n \\nCome to join our big family and follow us to get the latest news, updates and also activity in the application. We Appreciate your support, And we will continue to improve and update BoBo to give you the best experience.\\nEmail: dev@chucp.mobi\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"2.41.0\",\"releaseNotes\":\"1. Added points mall, which can be exchanged for many new things\\n2. Added an official anchor, which can be exchanged for more gold coins, come and sign the contract\\n3. The room supports posting pictures\\n4. Posts can post videos\\n5. Egg optimization\",\"releaseDate\":\"2023-04-03\",\"releaseTimestamp\":\"2023-04-03T01:39:11Z\"},{\"versionDisplay\":\"2.40.1\",\"releaseNotes\":\"1. The room music has been greatly revised, and it is more convenient to play music\\n2. Optimize the gameplay of Ludo and other games\\n3. More new optimizations are waiting for you to discover\",\"releaseDate\":\"2023-03-17\",\"releaseTimestamp\":\"2023-03-17T01:40:53Z\"},{\"versionDisplay\":\"2.40.0\",\"releaseNotes\":\"1. The room music has been greatly revised, and it is more convenient to play music\\n2. Optimize the gameplay of Ludo and other games\\n3. More new optimizations are waiting for you to discover\",\"releaseDate\":\"2023-03-15\",\"releaseTimestamp\":\"2023-03-15T01:22:37Z\"},{\"versionDisplay\":\"2.39.1\",\"releaseNotes\":\"1. It is more convenient to select a country on the home page~\\n2. The wallet page looks better~\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-25\",\"releaseTimestamp\":\"2023-02-25T08:08:07Z\"},{\"versionDisplay\":\"2.39.0\",\"releaseNotes\":\"1. It is more convenient to select a country on the home page~\\n2. The wallet page looks better~\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T00:16:03Z\"},{\"versionDisplay\":\"2.38.0\",\"releaseNotes\":\"1. Gifts can be combo~\\n2. New way of smashing eggs\\n3. More new ways to play are waiting for you to discover\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T23:55:15Z\"},{\"versionDisplay\":\"2.37.1\",\"releaseNotes\":\"1. New recharge package waiting for you~\\n2. You can add your favorite tags~\\n3. More new ways to play are waiting for you to discover~\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T04:44:06Z\"},{\"versionDisplay\":\"2.37.0\",\"releaseNotes\":\"1. New recharge package waiting for you~\\n2. You can add your favorite tags~\\n3. More new ways to play are waiting for you to discover~\",\"releaseDate\":\"2023-01-13\",\"releaseTimestamp\":\"2023-01-13T01:47:52Z\"},{\"versionDisplay\":\"2.36.1\",\"releaseNotes\":\"1. Added room Lucky pack function! Everyone can give out Lucky packs\\n2. The room global list and regional list are online! Come and win super rewards!\\n3. The lottery has been improved, new prizes have been added, come and collect crystal and exchange rare gifts!\\n4. The dynamic room background is online, everyone pay attention to the event to get it!\\n5. It is more secure to bind the account to the email address, and you can also log in with the email address!\\n6. Exclusive customer service is online~ User feedback is more convenient\",\"releaseDate\":\"2022-12-21\",\"releaseTimestamp\":\"2022-12-21T10:31:40Z\"},{\"versionDisplay\":\"2.36.0\",\"releaseNotes\":\"1. Added room Lucky pack function! Everyone can give out Lucky packs\\n2. The room global list and regional list are online! Come and win super rewards!\\n3. The lottery has been improved, new prizes have been added, come and collect crystal and exchange rare gifts!\\n4. The dynamic room background is online, everyone pay attention to the event to get it!\\n5. It is more secure to bind the account to the email address, and you can also log in with the email address!\\n6. Exclusive customer service is online~ User feedback is more convenient\",\"releaseDate\":\"2022-12-19\",\"releaseTimestamp\":\"2022-12-19T17:05:52Z\"},{\"versionDisplay\":\"2.35.4\",\"releaseNotes\":\"1. The home page has added a day mode, and you can also choose your favorite country room~\\n2. A new discovery page has been added, where you can find like-minded friends\\n3. You can Multi approve friend requests become more easier~\\n4. More experience optimization, waiting for you to discover\",\"releaseDate\":\"2022-11-20\",\"releaseTimestamp\":\"2022-11-20T19:13:44Z\"},{\"versionDisplay\":\"2.35.3\",\"releaseNotes\":\"1. The home page has added a day mode, and you can also choose your favorite country room~\\n2. A new discovery page has been added, where you can find like-minded friends\\n3. You can Multi approve friend requests become more easier~\\n4. More experience optimization, waiting for you to discover\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T18:24:10Z\"},{\"versionDisplay\":\"2.35.0\",\"releaseNotes\":\"1. The home page has added a day mode, and you can also choose your favorite country room~\\n2. A new discovery page has been added, where you can find like-minded friends\\n3. You can Multi approve friend requests become more easier~\\n4. More experience optimization, waiting for you to discover\",\"releaseDate\":\"2022-10-26\",\"releaseTimestamp\":\"2022-10-26T17:10:45Z\"},{\"versionDisplay\":\"2.34.0\",\"releaseNotes\":\"1. New features! The room PK is here, you can interact with your friend's room PK, and you will be punished if you lose!\\n2. There are also a series of small optimizations\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T01:41:27Z\"},{\"versionDisplay\":\"2.33.0\",\"releaseNotes\":\"1. The relationship card function has been optimized, you can more easily receive binding invitations from friends~\\n2. The family group chat has added speech management, which can better manage the family group chat~\\n3. The room game is smoother, come and have a fun game with your friends\",\"releaseDate\":\"2022-09-09\",\"releaseTimestamp\":\"2022-09-09T02:32:57Z\"},{\"versionDisplay\":\"2.32.1\",\"releaseNotes\":\"1. The homepage has been greatly upgraded, join the party quickly, come and explore!\\n2. New video room, let's watch the video together!\\n3. The sound of smashing eggs supports opening and closing\\n4. You can control the display of supporter information on your personal homepage\",\"releaseDate\":\"2022-08-26\",\"releaseTimestamp\":\"2022-08-26T09:49:55Z\"},{\"versionDisplay\":\"2.32.0\",\"releaseNotes\":\"1. The homepage has been greatly upgraded, join the party quickly, come and explore!\\n2. New video room, let's watch the video together!\\n3. The sound of smashing eggs supports opening and closing\\n4. You can control the display of supporter information on your personal homepage\",\"releaseDate\":\"2022-08-23\",\"releaseTimestamp\":\"2022-08-23T02:44:45Z\"},{\"versionDisplay\":\"2.31.0\",\"releaseNotes\":\"1. The relationship card is now available, everyone can bind relationships with friends, and upgrade together to get rewards~\\n2. There are also a series of small optimizations\",\"releaseDate\":\"2022-08-03\",\"releaseTimestamp\":\"2022-08-03T16:23:54Z\"},{\"versionDisplay\":\"2.30.1\",\"releaseNotes\":\"1. The family has added a group chat function, let's play together\\n2. The family adds its own territory, come and seize it\",\"releaseDate\":\"2022-07-01\",\"releaseTimestamp\":\"2022-07-01T18:14:00Z\"},{\"versionDisplay\":\"2.30.0\",\"releaseNotes\":\"1. The family has added a group chat function, let's play together\\n2. The family adds its own territory, come and seize it\",\"releaseDate\":\"2022-06-30\",\"releaseTimestamp\":\"2022-06-30T06:11:03Z\"},{\"versionDisplay\":\"2.29.5\",\"releaseNotes\":\"1. New games Ludo, UNO, and Crash are available. You can play now in the rooms and meet more friends;\\n2. Small optimization of smashing eggs, new prize record;\",\"releaseDate\":\"2022-05-30\",\"releaseTimestamp\":\"2022-05-30T09:43:54Z\"},{\"versionDisplay\":\"2.29.0\",\"releaseNotes\":\"1. New games Ludo, UNO, and Crash are available. You can play now in the rooms and meet more friends;\\n2. Small optimization of smashing eggs, new prize record;\",\"releaseDate\":\"2022-05-18\",\"releaseTimestamp\":\"2022-05-18T07:48:17Z\"},{\"versionDisplay\":\"2.28.0\",\"releaseNotes\":\"1. Host Center;\\n2. feeds added new categories;\",\"releaseDate\":\"2022-04-19\",\"releaseTimestamp\":\"2022-04-19T11:28:38Z\"},{\"versionDisplay\":\"2.27.0\",\"releaseNotes\":\"1.The Family function added, come and experience it!\",\"releaseDate\":\"2022-03-29\",\"releaseTimestamp\":\"2022-03-29T12:48:52Z\"},{\"versionDisplay\":\"2.25.0\",\"releaseNotes\":\"1. Capsule machine \\n2. Room level treasure chest \\n3. Personal homepage gift list \\n4. List UI optimization \\n5. New Year icon\",\"releaseDate\":\"2022-01-26\",\"releas