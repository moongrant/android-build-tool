\":219460608,\"iPad4,3\":219460608,\"iPad4,2\":219460608,\"iPad8,9\":206143488,\"iPad8,8\":216605696,\"iPad8,7\":216605696,\"iPad8,6\":216605696,\"iPad7,11\":206143488,\"iPad11,6\":206143488,\"iPad4,1\":219460608,\"iPad11,7\":206143488,\"iPad11,2\":208124928,\"iPad11,3\":208124928,\"iPad11,4\":208124928,\"iPhone11,2\":221787136,\"iPhone11,6\":221787136,\"iPhone15,2\":211083264,\"iPhone8,4\":219460608,\"iPhone8,1\":219460608,\"iPhone11,4\":221787136,\"iPhone8,2\":227611648,\"iPad14,4-B\":206143488,\"iPhone11,8\":216699904,\"iPhone15,3\":211083264,\"iPad14,4-A\":206143488,\"iPad5,4\":219460608,\"iPad5,3\":219460608,\"iPad13,10\":206143488,\"iPad5,2\":219460608,\"iPad5,1\":219460608,\"iPad6,11\":219460608,\"iPad6,12\":219460608,\"MacFamily20,1\":206143488,\"iPad12,1\":206143488,\"iPad12,2\":206143488,\"iPhone10,3\":227611648,\"iPhone10,2\":227611648,\"iPhone10,1\":219460608,\"iPhone14,3\":211083264,\"iPhone10,6\":227611648,\"iPhone14,2\":211083264,\"iPhone7,2\":219460608,\"iPhone10,5\":227611648,\"iPhone10,4\":219460608,\"iPhone7,1\":227611648,\"iPad13,19\":206143488,\"iPhone14,7\":211083264,\"iPad14,5-A\":206143488,\"iPhone14,6\":206143488,\"iPad14,5-B\":206143488,\"iPhone14,5\":211083264,\"iPad13,11\":206143488,\"iPhone14,4\":211083264,\"iPad13,17\":206143488,\"iPad13,18\":206143488,\"universal\":269575168,\"iPod9,1\":208124928,\"iPhone14,8\":211083264,\"iPad13,16\":206143488,\"iPad6,7\":219460608,\"iPad6,4\":219460608,\"iPad6,3\":219460608,\"iPad6,8\":219460608,\"iPad13,8\":206143488,\"iPad13,9\":206143488,\"iPad13,4\":206143488,\"iPad13,5\":206143488,\"iPad13,6\":206143488,\"iPad13,7\":206143488,\"iPad13,1\":206143488,\"iPad13,2\":206143488}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1594494132/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1594494132/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}}]}}},{\"id\":\"1544887147\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1544887147?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Simulated Gambling\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/101-okey-yalla-ramazan-%C3%B6zel/id1544887147\",\"userRating\":{\"value\":4.4,\"ratingCount\":7,\"ratingCountList\":[1,0,0,0,6],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.1\",\"name\":\"101 Okey Yalla - Ramazan Özel\",\"genreDisplayName\":\"Board\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"A brand new lobby interface of Ramadan, a variety of exciting time-limited Ramadan events and great many of eye-catching rewards are waiting for you to experience here!\\n\\nYou can voice chat while playing games for free in 101 Okey Yalla, gaining more fun. Only in 101 Okey Yalla can you experience the same game atmosphere as the offline game.\\n\\n1. Free 101 Okey Game\\nExperience the classic 101 Okey game for free and battle with multiple players matched in real time.\\n\\n2. Real-Time Voice Chat\\nEnjoy real-time voice chat in the game scenes perfectly imitated as the real life. Offer you an easier way to make friends from all over the world.\\n\\n3. Self-Created Room\\nInvite friends to play together or team up to win the victory. Game modes can be chosen as you like: Team, multiple rounds, high bets, etc.\\n\\n4. In-Game Interaction\\nSend funny emojis to express your complement and collect free golds given by friends\\n\\n5. Plentiful Game Modes\\nTurbo mode: Experience the excitement of multiplying bets and win more free golds\\nLeague: Defeat the opponents to show your superb skills and realize your legend dream in 101 Okey Yalla! More gameplays are waiting for you to explore!\\n\\n101 Okey Yalla team will commit to creating a supreme game and social experience for you.\\n\\nIf you choose to subscribe to 101 Okey Yalla VIP, the purchase will be billed to your iTunes account.\\nYour iTunes account will be charged automatically for the renewal within 24 hours prior to the end of the current period.\\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nThe price for VIP is USD 7.99/month. Prices are in U.S. dollars, may vary in countries/regions other than the U.S., and are subject to change without notice.\\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in 101 Okey Yalla without becoming a 101 Okey Yalla VIP.\\n\\nPrivacy Policy: https://www.yallaokey101.com/term/EN/TermOfService.html#TermsOfService\\nTerms of Service: https://www.yallaokey101.com/term/EN/TermOfService.html#PrivacyPolicy\\n\\nFor more information or suggestions, please join our social media communities to get the latest game news!\\nFacebook: https://www.facebook.com/yallaokey/\\nİnstagram: https://www.instagram.com/yallaokey101/?igshid=YmMyMTA2M2Y=\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.10.1\",\"releaseNotes\":\"101 Okey Yalla wishes you and your loved ones a happy Ramadan! \\n\\n1. To welcome and celebrate the holy month of Ramadan, we have specially updated the new time-limited lobby theme.\\n2. A variety of fun activities where you can win great prizes by logging in every day or preparing special Ramadan dishes will be online soon.\\n3. We have prepared 3 new gifts design exclusively for Ramadan and fun room parties for you to attend in chatroom. Come and join us!\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T01:40:33Z\"},{\"versionDisplay\":\"1.10.0\",\"releaseNotes\":\"Updates:\\n1. Free Game Mode: don't worry for the coins, earn your rewards in the Free Game Mode!\\n2. Tournament: Compete with other players in the tournament and win the first place！\\n3. Member Group: join a group in Chat Room, exclusive badges and emojis are waiting for you!\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T02:45:21Z\"},{\"versionDisplay\":\"1.9.1\",\"releaseNotes\":\"Updates:\\n1. Optimized voice chat experience;\\n2. Added gift in Chat room;            \\n3. Bug fixes and performance improvements; \\nPray for Turkey! \",\"releaseDate\":\"2023-02-09\",\"releaseTimestamp\":\"2023-02-09T02:58:03Z\"},{\"versionDisplay\":\"1.9.0\",\"releaseNotes\":\"Updates:\\n1. Gift System: Send gifts to your friends and get a chance to collect the gold reward!\\n2. Glamour Ranking: Receive gifts to get glamour points. Let’s see who’s the most popular one!\\n3. Rich Ranking: A new ranking exclusive for players who have recharged. Become the top to show your wealth with honor!\\n4. Features upgraded and experience improved.\\n5. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-12-21\",\"releaseTimestamp\":\"2022-12-21T03:39:57Z\"},{\"versionDisplay\":\"1.8.0\",\"releaseNotes\":\"Updates:\\n1. Classic Okey: Classic Okey is available for a limited time. Explore the new mode with your friends!\\n2. Yalla Bank: Save money while playing games . The more you save, the more you can get.\\n3. Novice Ranking: A new ranking exclusive for new players. Let's see who's the best novice!\\n4. Chat Room Theme: Come and try the new room theme for free.\\n5. Private Chat: You can send private messages in the chatroom now.\\n6. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T03:32:21Z\"},{\"versionDisplay\":\"1.7.1\",\"releaseNotes\":\"Updates:\\n1. Novice Events - Sign-in and missions exclusive for novice players. Join now to collect plentiful rewards!\\n2. Cheat Detection - Provide you with a more fair game environment!\\n3. New features in Chatroom!\\n‒ Added weekly gifts and free gifts\\n‒ Added features of friends adding and private chat\\n‒ Added on-mic emojis and Lucky Number\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-09-28\",\"releaseTimestamp\":\"2022-09-28T01:58:38Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"Updates:\\r\\n1. Novice Events - Sign-in and missions exclusive for novice players. Join now to collect plentiful rewards!\\r\\n2. Three Tiles Okey - Guess the right tile type to win gold up to 1000 times the amount you put in! \\r\\n3. Cheat Detection - Provide you with a more fair game environment!\\r\\n4. New features in Chatroom!\\r\\n‒ Added weekly gifts and free gifts\\r\\n‒ Added features of friends adding and private chat\\r\\n‒ Added on-mic emojis and Lucky Number\\r\\n5. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-09-01\",\"releaseTimestamp\":\"2022-09-01T01:42:53Z\"},{\"versionDisplay\":\"1.6.1\",\"releaseNotes\":\"Updates:\\n1. Shorter game load time. Optimized network connection will enable you to enjoy a more smooth game experience.\\n2. Fixed some problems in Chatroom. Invite your friends to the chatroom and have fun together!\\n3. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-07-12\",\"releaseTimestamp\":\"2022-07-12T01:37:31Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"Updates:\\r\\n1. Chatroom-Have a real-time chat with global users in different rooms for free! Plentiful gifts and fun games are waiting for you!\\r\\n2. New skins- Bid farewell to the old theme and embrace new backgrounds and shelves.\\r\\n3. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-06-28\",\"releaseTimestamp\":\"2022-06-28T02:11:16Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"Updates:\\r\\n1. Added VIP system. Subscribe to get daily rewards and 8 exclusive privileges.\\r\\n2. Upgraded League system. Introduces Star Shield with overall enhanced League experience.\\r\\n3. Added Chests Booster feature. Helps you unlock more chests.\\r\\n4. Added Deck Tracker. Helps you record remaining tiles for higher winning chances.\\r\\n5. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-04-01\",\"releaseTimestamp\":\"2022-04-01T02:25:08Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"V1.4 Updates:\\r\\n1.Added High Bets Room. Higher bets come with more excitement. Invite your friends to get early access to the game!\\r\\n2.Battle Pass, Lucky 1+1, and more events will open. Stay tuned for more fun games and plentiful free golds are waiting for you!\\r\\n3.Exquisite chat bubbles, clocks, and more skins are coming. Choose what you like to distinguish yourself from others!\\r\\n4.Art effect optimization, bug fixes, and performance improvements.\",\"releaseDate\":\"2022-01-25\",\"releaseTimestamp\":\"2022-01-25T01:18:27Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Updates:\\r\\n1.Added Team mode in Room. Explore with your friends and enjoy the fun together. \\r\\n2.Added League Ranking. Limited profile frames are waiting for you.\\r\\n3.Less data consumption. Don't have to worry about the data anymore.\\r\\n4.Added Magnifier. You can see tiles more clearly when adding tiles manually.\\r\\n5.Optimized game animation. Smoother operations are waiting for you to experience.\\r\\n6.Bug fixes and performance improvements.\",\"releaseDate\":\"2021-12-15\",\"releaseTimestamp\":\"2021-12-15T01:26:54Z\"},{\"versionDisplay\":\"1.3\",\"releaseNotes\":\"Updates:\\r\\n1. Added League system. Come play and become a legend;\\r\\n2. Added Chest system. You have a chance to get a chest in each game;\\r\\n3. Added decoration system. Exquisite skins are waiting for you;\\r\\n4. Added report system. Please report indecent behaviors in time;\\r\\n5. Bug fixes and performance improvements.\",\"releaseDate\":\"2021-11-09\",\"releaseTimestamp\":\"2021-11-09T12:14:19Z\"},{\"versionDisplay\":\"1.2\",\"releaseNotes\":\"Updates:\\r\\n1. Added Bonus System. Try to win the game by melding special Okey hands and collect extra free golds. \\r\\n2. Added Multiple-Round in Room. Lose the first round? Never mind! You can make it next round!\\r\\n3. Added Golds-Chest Activity. Want more golds? Just stay in the game, free golds are waiting for you!\\r\\n4. Bug fixes and performance improvements.\",\"releaseDate\":\"2021-08-24\",\"releaseTimestamp\":\"2021-08-24T02:02:17Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"Updates:\\r\\n1.Optimized in-game experience: you will have more accurate sorting results;\\r\\n2.Optimized room system: add the ready button for a better game experience and you can see all rooms;\\r\\n3.Added link mobile function: link your mobile number to get rewards;\\r\\n4.Added log out button for Guest players: it’s more convenient for users to switch accounts; \\r\\n5.Optimized in-game voice chat: you can communicate with friends fluently; \\r\\n6.Bugs fixed and performance improvement.\",\"releaseDate\":\"2021-06-24\",\"releaseTimestamp\":\"2021-06-24T02:12:06Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"v1.1.1 Updates:\\n1.Added brand-new 101 Okey Room. Try to customize the gameplay and enjoy voice chat with friends while gaming;\\n2.Added the Ranking system. Compete with global 101 Okey players right now;\\n3.Added interesting limited events. Get lucky tickets from game to win a big prize;\\n4.Added Mission system which can enrich players' game experience;\\n5.Bugs fixed and performance improvement.\",\"releaseDate\":\"2021-05-26\",\"releaseTimestamp\":\"2021-05-26T01:51:38Z\"},{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"Updates:\\n1.Added brand-new 101 Okey Room. Try to customize the gameplay and enjoy voice chat with friends while gaming;\\n2.Added the Ranking system. Compete with global 101 Okey players right now;\\n3.Added interesting limited events. Get lucky tickets from game to win a big prize;\\n4.Added Mission system which can enrich players' game experience;\\n5.Bugs fixed and performance improvement.\",\"releaseDate\":\"2021-05-01\",\"releaseTimestamp\":\"2021-05-01T00:59:27Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"Bug fixed\\n1.Optimized voice chat, you can chat with friends more fluently.\\n2.Optimized the algorithm of sorting tiles.\\n3.Fixed incorrect display of golds on some pages.\\n4.Fixed crash issues when opening some pages.\\n5.User experience optimization.\",\"releaseDate\":\"2021-03-02\",\"releaseTimestamp\":\"2021-03-02T01:28:22Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":null,\"releaseDate\":\"2021-02-10\",\"releaseTimestamp\":\"2021-02-10T01:20:05Z\"}],\"websiteUrl\":\"https://www.yallaokey101.com/\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"editorialNotes\":{\"tagline\":\"Challenge your friends!\"},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1544887147\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855668110\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":254697472}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1544887147\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855668110\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":254697472}]}],\"requires32bit\":false,\"releaseDate\":\"2021-02-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.okey101yalla\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/86/2a/bf/862abfe3-5a26-5c40-e3c5-c4cc71f86ed4/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"176a56\",\"textColor1\":\"f7f5f5\",\"textColor2\":\"eaf6aa\",\"textColor3\":\"cad9d5\",\"textColor4\":\"c0da99\"},\"privacyPolicyUrl\":\"https://www.yallaokey101.com/term/EN/TermOfService.html?TermsOfService\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://www.yallaokey101.com/\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Features112/v4/33/8a/c1/338ac10f-b59c-e1a1-6deb-af53a95f859d/debe4a9c-3bd8-483b-b7a0-0d896f88fcd1.png/{w}x{h}sr.{f}\",\"bgColor\":\"cca9aa\",\"textColor1\":\"12182c\",\"textColor2\":\"19182c\",\"textColor3\":\"2f2f42\",\"textColor4\":\"352f42\"},\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Features123/v4/1e/e5/40/1ee540bc-9af5-4801-ac2d-f1583572674d/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"subtitle\":\"Limited Ramadan Lobby \u0026 Events\",\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/5d/88/fc/5d88fc7d-b697-47c3-ccbd-c7ba90f6f739/3c3c9657-c916-4ee3-bb87-32046b6c11ef_1.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f7f3cd\",\"textColor2\":\"c5c5f8\",\"textColor3\":\"e0d0ae\",\"textColor4\":\"b7abd1\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/18/e7/5c/18e75c21-2ac1-7079-3f27-0015e05e823e/d3cd4730-a495-47dd-b654-c24c4c57598d_8.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"e0d7c3\",\"textColor4\":\"e0d0ae\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ec/0a/02/ec0a021c-f14c-3032-34fb-f85350854c7a/5e7fb6d9-bfe9-4af8-942f-ac6af6ee7cae_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"48447f\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"d5d7d1\",\"textColor4\":\"d4d0bd\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ff/f7/99/fff79966-f3b0-5fcb-4113-f78582da3817/bfb766e0-150c-4a71-9136-ffca2d8eb62a_3.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"131421\",\"textColor1\":\"ffffff\",\"textColor2\":\"ababed\",\"textColor3\":\"cfd0d2\",\"textColor4\":\"8c8dc4\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/6c/d3/ab/6cd3abda-1ba7-0c56-5b68-3d7fb692f9ad/9f12910d-e057-4176-8654-4bfa62f6e468_4.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f8fbe6\",\"textColor2\":\"f7f3cd\",\"textColor3\":\"e0d7c3\",\"textColor4\":\"e0d0ae\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/9f/85/de/9f85de1c-797f-8e9e-5f27-848ffb8643aa/cbb8c4c4-f0f2-4038-9bf7-122be5973998_5.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"f5edeb\",\"textColor2\":\"b7e5ff\",\"textColor3\":\"decbc6\",\"textColor4\":\"acc5d6\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/9c/3f/b2/9c3fb213-5f2f-83d5-9fb4-978e4a16a21b/c75e09dc-ea76-4e5d-9f7f-154a46d79eec_6.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"3b071d\",\"textColor1\":\"bebee7\",\"textColor2\":\"bbb5dc\",\"textColor3\":\"a499bf\",\"textColor4\":\"a192b6\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/84/56/47/84564753-b075-3311-a832-9efec80e7ff4/ff508d29-cfe1-4b5f-8b3d-4c37646bcbe7_7.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"814535\",\"textColor1\":\"fef3bb\",\"textColor2\":\"e9eae5\",\"textColor3\":\"e5d0a0\",\"textColor4\":\"d4c9c1\"}],\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/76/9f/65/769f6568-e4e0-c7ea-467b-df3f9db17958/e9af3bcf-b071-4d91-8727-9760a0c3e324_1.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"804535\",\"textColor1\":\"fffffa\",\"textColor2\":\"ecc7a2\",\"textColor3\":\"e5d9d2\",\"textColor4\":\"d6ad8c\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/ac/e7/a4/ace7a452-a021-24d6-5497-e07bf89a9e65/1ffa80ce-6c54-433f-825e-260d517dacf2_8.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"804535\",\"textColor1\":\"fffffa\",\"textColor2\":\"f6f9db\",\"textColor3\":\"e5d9d2\",\"textColor4\":\"ded5ba\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/13/be/6c/13be6c74-9dfd-38c5-16cb-a562c580a96b/a8450b56-2379-4954-9430-b1f60fdd6a08_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"48447f\",\"textColor1\":\"f6f9db\",\"textColor2\":\"c9b7f1\",\"textColor3\":\"d3d4c8\",\"textColor4\":\"afa0da\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/f3/d9/66/f3d96611-6b92-95b7-0234-f0f187bdabcd/422927fa-3d56-4541-af4b-a56d7e57e127_3.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"161824\",\"textColor1\":\"fffffa\",\"textColor2\":\"c3c3f7\",\"textColor3\":\"d0d0cf\",\"textColor4\":\"a0a1cd\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/6e/a3/af/6ea3af5c-d5d7-fa26-5c4e-510455fb460a/3b965de9-3db5-40d8-91c6-3ab08d3d1c35_4.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"804535\",\"textColor1\":\"f6f9db\",\"textColor2\":\"fed853\",\"textColor3\":\"ded5ba\",\"textColor4\":\"e5bb4d\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/66/55/48/665548c4-5097-fa9a-6258-ff9e1b7f1106/41e4a6b9-aa86-4711-9b08-35c2140a5797_5.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"205692\",\"textColor1\":\"fffffa\",\"textColor2\":\"b6e3ff\",\"textColor3\":\"d2dde5\",\"textColor4\":\"97c6e9\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/21/48/c8/2148c81d-c1bd-0552-1ea9-ca5df90968fe/052b69d4-8e33-4ce8-ae61-82614614246b_6.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"3c081e\",\"textColor1\":\"b5b2e2\",\"textColor2\":\"df8f65\",\"textColor3\":\"9c90bb\",\"textColor4\":\"be7457\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/1c/52/5e/1c525e49-2664-7faa-37ce-a0338c6e3cb4/4f960110-ae4e-4efc-8996-0afc59a77ebf_7.jpg/{w}x{h}{c}