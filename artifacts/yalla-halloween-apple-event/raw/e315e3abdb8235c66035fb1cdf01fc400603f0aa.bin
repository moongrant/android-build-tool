\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1542713951/genres?l=en-US\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6014?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6014\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}},{\"id\":\"7009\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7009?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Family\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/us/genre/id7009\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7004?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/us/genre/id7004\"}}]}}},{\"id\":\"1513504421\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1513504421?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Cartoon or Fantasy Violence\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/yalla-baloot-hand/id1513504421\",\"userRating\":{\"value\":4.4,\"ratingCount\":323,\"ratingCountList\":[31,4,20,20,248],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.0\",\"name\":\"Yalla Baloot \u0026 Hand\",\"genreDisplayName\":\"Card\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Do you miss the simple times of playing baloot with your friends? Regardless of the distance, you can now play together with Yalla Baloot \u0026 Hand!\\r\\n\\r\\nYalla Baloot \u0026 Hand is a casual online game where you can play with your friends or make new friends who also enjoy the game! \\r\\n\\r\\nFeatures:\\r\\n\\r\\nClassic Baloot\\r\\nClassic online Baloot game with a real game atmosphere that includes real-time voice chat, making the game more competitive and exciting.\\r\\n\\r\\nVariety of Hand Game Modes\\r\\nPlay online Hand games, that imitate real-life conditions, with your friends. The game includes Hand and Hand Saudi.\\r\\n\\r\\nLeague Match\\r\\nPlay with high-level players on a competitive level and show off your game skills. Earn a variety of rewards and compete to be champion!\\r\\n\\r\\nPublic Room\\r\\nCreate your own room, personalize room rules and enjoy the game with friends.\\r\\n\\r\\nBeautiful Skins\\r\\nA variety of personalized skins to choose from. You can choose your favourite card and theme and use them in the game.\\r\\n\\r\\nRich Social Elements\\r\\nThe lively global chat and private personal chat provide you with multiple options to communicate with your friends.\\r\\n\\r\\nWe will try our best to improve your game experience, provide you with fun and excitement, and make your life full of joy. \\r\\n\\r\\nAny suggestions or questions, please contact our feedback team: balootsupport@yalla.live\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"1. Achievement Badges - Earn achievements to unlock badges, and show off your collection by wearing them!\\r\\n2. Chatroom Update - Member club feature added. Join with friends and make your room the most popular!\\r\\n3. Performance optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\"},{\"versionDisplay\":\"1.5.1.1\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"1. Upgraded Challenge - Two challenge matches of different levels have been added, giving users more exciting games to enjoy! \\r\\n2. Interface Optimization - Buttons on the main interface have been optimized to improve the user experience!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1. Chatrooms – Experience the newly added chatrooms! Create your own room or join a public one and make new friends! \\r\\n2. Upgraded Global Chat - Experience a smoother global chat with newly added message notifications! \\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\"},{\"versionDisplay\":\"1.4.9.11\",\"releaseNotes\":\"1. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T01:50:12Z\"},{\"versionDisplay\":\"1.4.9.10\",\"releaseNotes\":\"1. New Game Rule - Enjoy the most authentic Baloot experience with the newly added \\\"Gaid\\\" rules in the Public Room!\\r\\n2. Chat Bubbles – Show off your bubble collection by using personalized chat bubbles!\\r\\n3. Performance Optimization - Enjoy an enhanced and smoother gaming experience!\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T09:05:56Z\"},{\"versionDisplay\":\"1.4.9.9\",\"releaseNotes\":\"1. New Game Rules - Enjoy the most authentic Baloot experience, with the newly added \\\"Kashu\\\" rules! \\r\\n2. Public Room - Create private or public \\\"Hand\\\" game rooms or join other user's rooms by accessing the game mode's \\\"Public Room\\\"!\\r\\n3. Challenge Notification Feature - With newly added notifications in global chat, you will never miss any challenge match!\",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T01:46:58Z\"},{\"versionDisplay\":\"1.4.9.8\",\"releaseNotes\":\"1. Interface Optimization - Enjoy the newly upgraded interface in \\\"Challenge mode\\\"!\\r\\n2. Challenge Registration Reminder - Never miss out on any of the daily rewards with the new Challenge registration reminder feature!\\r\\n3. Performance Optimization - Enjoy a much smoother gaming experience!\",\"releaseDate\":\"2022-09-01\",\"releaseTimestamp\":\"2022-09-01T01:05:52Z\"},{\"versionDisplay\":\"1.4.9.7\",\"releaseNotes\":\"1. New Challenge Match - Enjoy exciting competitions with plenty of rewards. Compete to become the champion!\\n2. Quick Play Upgrade - Experience faster Baloot games and choose different skill grades based on your own expertise!\\n3. New Rankings System - Play games to gain your spot on the ranking list and win exclusive profile frames!\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T10:55:25Z\"},{\"versionDisplay\":\"1.4.9.6\",\"releaseNotes\":\"1.Upgrade to Quick mode in championship tryouts, with more chances to hit the championship every day!\\r\\n2.Voice quality improvement and overall optimizations. Enter app in seconds and have a quick start!\",\"releaseDate\":\"2022-06-25\",\"releaseTimestamp\":\"2022-06-25T08:51:38Z\"},{\"versionDisplay\":\"1.4.9.5.1\",\"releaseNotes\":\"1. Team up with friends to join the new competitive championship.\\r\\n2. Public rooms have been enhanced to support multiple spectators.\\r\\n3.Voice quality improvement and overall optimization. \",\"releaseDate\":\"2022-06-06\",\"releaseTimestamp\":\"2022-06-06T12:34:09Z\"},{\"versionDisplay\":\"1.4.9.4\",\"releaseNotes\":\"1. Added New Star Rank. You can be the top even as a new player!\\n2. Get VIP when you bind your account!\\n3. New announcement after upgrading to Master and above. \\n4. Voice quality improvement and overall optimizations. \",\"releaseDate\":\"2022-04-20\",\"releaseTimestamp\":\"2022-04-20T02:05:26Z\"},{\"versionDisplay\":\"1.4.9.3\",\"releaseNotes\":\"1. Brand new Public Room. You can use golds now to play games.\\n2. App optimizations and voice quality improvement.\\n3. Enhanced user experience and added confirmation for golds exchange in Store.\",\"releaseDate\":\"2022-03-21\",\"releaseTimestamp\":\"2022-03-21T14:27:05Z\"},{\"versionDisplay\":\"1.4.9.2\",\"releaseNotes\":\"1. Added Global Chat. You can now chat with more friends;\\r\\n2. You can now get the chests immediately once you win a \\\"Quick Play\\\";\\r\\n3. Free Public Room for all players. Create or join any public room to play with friends;\\r\\n4. Overall optimization of the game;\\r\\n5. Bug fixed.\",\"releaseDate\":\"2022-03-08\",\"releaseTimestamp\":\"2022-03-08T01:46:12Z\"},{\"versionDisplay\":\"1.4.9.1\",\"releaseNotes\":\"Some bugs were fixed according to user feedback. The quality of Voice Chat is optimized.\",\"releaseDate\":\"2022-02-09\",\"releaseTimestamp\":\"2022-02-09T00:47:18Z\"},{\"versionDisplay\":\"1.4.9\",\"releaseNotes\":\"Yalla Baloot team sincerely invites you to experience the new version of Baloot in 2022.\\r\\n1.Add Hand game. Variety of Hand games for 2 \u0026 4 players;\\r\\n2.Users can send interactive props in the game;\\r\\n3.Add winning streak chests in CASUAL. The more you win, the better rewards you will get;\\r\\n4.Overall optimization of the game;\\r\\n5.Bug fixed\\r\\nThanks for your patience in reading this. See you in the next version.\",\"releaseDate\":\"2022-01-28\",\"releaseTimestamp\":\"2022-01-28T13:56:23Z\"},{\"versionDisplay\":\"1.4.8.1\",\"releaseNotes\":\"1.Brand new UI design, better game experience;\\r\\n2.Overall optimization of the game;\\r\\n3.Bug fixed\",\"releaseDate\":\"2021-12-11\",\"releaseTimestamp\":\"2021-12-11T10:25:37Z\"},{\"versionDisplay\":\"1.4.8\",\"releaseNotes\":\"1.Added Novice Pass. You can get plentiful rewards by playing games, including golds, diamonds, skins, and VIP;\\r\\n2.Added Level Reward with brand-new level badges. You can check it on Events page;\\r\\n3.Added friends Spectating;\\r\\n4.Added Bubble Skins;\\r\\n5.Overall optimization of the game;\\r\\n6.Bug fixed\",\"releaseDate\":\"2021-10-01\",\"releaseTimestamp\":\"2021-10-01T00:46:55Z\"},{\"versionDisplay\":\"1.4.7\",\"releaseNotes\":\"1.Brand-new League: change participation rules. More free challenge times and more plentiful rewards;\\r\\n2.Exquisite Skins: a variety of personalized skins. You can choose your favorite card and theme, and use them in the game;\\r\\n3.Rank upgrade: add Game Star rank and limited-time profile frame reward;\\r\\n4.Overall optimization of the game: smoother game experience;\\r\\n5.Bug fixed.\",\"releaseDate\":\"2021-08-09\",\"releaseTimestamp\":\"2021-08-09T14:25:07Z\"},{\"versionDisplay\":\"1.4.6\",\"releaseNotes\":\"Bug fixed.\",\"releaseDate\":\"2021-06-21\",\"releaseTimestamp\":\"2021-06-21T09:02:26Z\"},{\"versionDisplay\":\"1.4.5\",\"releaseNotes\":\"1.Overall optimization of the game: smoother game experience;\\r\\n2.Global Chat: chat with all players and invite them to play games together;\\r\\n3.Bug fixed\",\"releaseDate\":\"2021-05-31\",\"releaseTimestamp\":\"2021-05-31T03:58:21Z\"},{\"versionDisplay\":\"1.4.4\",\"releaseNotes\":\"1.Optimize image resources;\\n2.Bug fixed\",\"releaseDate\":\"2021-04-11\",\"releaseTimestamp\":\"2021-04-11T12:57:29Z\"},{\"versionDisplay\":\"1.4.3\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2021-04-10\",\"releaseTimestamp\":\"2021-04-10T03:34:35Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"1.Daily Reward: sign in to get extra rewards;\\r\\n2.Add Ramadan decoration;\\r\\n3.Bug fixed\",\"releaseDate\":\"2021-03-31\",\"releaseTimestamp\":\"2021-03-31T10:30:47Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"1.7-Day Login Rewards: sign in to get extra rewards;\\r\\n2.New tutorials: learn Baloot rules in Training;\\r\\n3.Screen mode: choose landscape or portrait mode in Settings;\\r\\n4.Bug fixed\",\"releaseDate\":\"2021-02-05\",\"releaseTimestamp\":\"2021-02-05T23:11:04Z\"}],\"websiteUrl\":\"https://www.yallabaloot.com/\",\"editorialNotes\":{\"tagline\":\"Play your cards right\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855524873\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":287458304}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855524873\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":287458304}]}],\"requires32bit\":false,\"releaseDate\":\"2020-08-07\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallabaloot\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":10