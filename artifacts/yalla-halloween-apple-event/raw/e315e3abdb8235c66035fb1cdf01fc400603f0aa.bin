18\":113739776,\"universal\":141593600,\"iPod9,1\":115651584,\"iPhone14,8\":116369408,\"iPad13,16\":113739776,\"iPad6,7\":124992512,\"iPad6,4\":124992512,\"iPad6,3\":124992512,\"iPad6,8\":124992512,\"iPad13,8\":114159616,\"iPad13,9\":114159616,\"iPad13,4\":114159616,\"iPad13,5\":114159616,\"iPad13,6\":114159616,\"iPad13,7\":114159616,\"iPad13,1\":114159616,\"iPad13,2\":114159616}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1539388601/developer?l=en-US\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1444567250?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/yalla-technology-fz-llc/id1444567250\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1539388601/genres?l=en-US\",\"data\":[{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6012?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6012\"}}]}}},{\"id\":\"1542713951\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1542713951?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/yalla-parchis-parchis-bingo/id1542713951\",\"userRating\":{\"value\":4.1,\"ratingCount\":507,\"ratingCountList\":[84,15,18,31,359],\"ariaLabelForRatings\":\"4.1 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0.4\",\"name\":\"Yalla Parchis - Parchis\u0026Bingo\",\"genreDisplayName\":\"Board\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Parchis allows you to voice chat with your friends in real-time while playing the game.\\n\\nConvenient real-time voice chat\\nVoice chat with other players anytime and anywhere. Meet new friends and enjoy the game.\\n\\nMultiple game modes\\nYalla Parchis includes 3 game modes: 1V1, 4 Players and Team up. Each mode has three different rules: Classic, Spanish and Quick.\\n\\nEasy to play with friends\\nYou can play games with your friends in the team up mode, private room or VIP room. What are you waiting for? Let's play together!\\n\\nWe will try our best to provide you with more interesting games, enriching your daily life.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"1.Piggy Bank – Play Parchis or Bingo to earn diamonds, which are stored in your Piggy Bank. When it's full, you can open it to collect all the diamonds!\\n2.Fragments Fusion Optimization - You can now use fragments of locked skins to fuse them together!\\n3.Truth or Dare - Join in on the fun with our new in-room gameplay: \\\"Truth or Dare.\\\" Experience it with your friends today!\",\"releaseDate\":\"2023-03-30\",\"releaseTimestamp\":\"2023-03-30T07:00:59Z\"},{\"versionDisplay\":\"1.1.4.1\",\"releaseNotes\":\"1.New Game Mode: Experience the excitement of the newly added game mode, Magic - it's more fun and fast-paced!\\n2.Skin Fragment Fusion: Get the chance to receive skin fragments when you use the ‘Fusion’ function!\\n3.New In-Room Feature: Enjoy the newly added Light Show Ranking in the chat rooms.\",\"releaseDate\":\"2023-02-08\",\"releaseTimestamp\":\"2023-02-08T01:30:01Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"1.New Game Mode: Experience the excitement of the newly added game mode, Magic - it's more fun and fast-paced!\\r\\n2.Skin Fragment Fusion: Get the chance to receive skin fragments when you use the ‘Fusion’ function!\\r\\n3.New In-Room Feature: Enjoy the newly added Light Show Ranking in the chat rooms.\",\"releaseDate\":\"2023-01-18\",\"releaseTimestamp\":\"2023-01-18T14:37:19Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1.VIP3 Privileges: Become a VIP3 member to unlock exclusive benefits such as faster EXP gain, comments with special effects, and much more! \\r\\n2.VIP Room Gameplay: Now you have the option to play a Parchis game in the VIP Room without ‘undo’ or ‘block’.\\r\\n3.Chat Emoticons: You can now choose from a wide range of dynamic emoticons and use them in chat rooms!\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:19:50Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"Welcome to YallaParchis, updates are as follows:\\r\\n1.New skins: Skin store is upgraded, and new skins of Bingo games are available now.\\r\\n2.New VIP room for Bingo games: You can chat with friends while playing.\\r\\n3.New function: You can start a light show in the chat room.\",\"releaseDate\":\"2022-09-28\",\"releaseTimestamp\":\"2022-09-28T03:24:55Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows:\\r\\n1. VIP3 Level- Subscribe to the newly added VIP3 level and enjoy more privileges and benefits!\\r\\n2. New Feature \\\"Gift Gameplay\\\" - Join the excitement with the newly added gifting feature 'heat progress bar' in chatrooms.\\r\\n3. Backpack \u0026 Luxury Vehicles - Use backpacks to store gifts \u0026 items. And use the new luxury vehicles to enter chatrooms with dazzling special effects.\",\"releaseDate\":\"2022-08-22\",\"releaseTimestamp\":\"2022-08-22T11:30:04Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1. Bingo Game - Enjoy a different game experience in the fast and exciting brand new game, Bingo! You can switch to the Bingo by [Battle] - [Bingo icon].\\n2. Member Club - Added a new 'Member Club' feature in the Chatrooms. Form a club with your closest friends and team up to reach the top.\\n3. Room Theme - Newly added 'Room Theme' feature in the Chatroom.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T22:14:46Z\"},{\"versionDisplay\":\"1.0.8.1\",\"releaseNotes\":\"1. Players can now enjoy additional benefits when subscribing to VIP \\r\\n2. Added the badge system and upgraded the new \\\"personal information\\\" interface.\\r\\n3. Chat room has been enhanced with 1-1 private chat, the ability to invite other users to your room, and on-seat emojis.\\r\\n4. Improved game experience and bug fixes.\",\"releaseDate\":\"2022-05-30\",\"releaseTimestamp\":\"2022-05-30T23:39:00Z\"},{\"versionDisplay\":\"1.0.7.1\",\"releaseNotes\":\"Updates are as follows:\\n1.Add the feature of sending props when spectating. You have more ways to interact with each other in the game.\\n2.Add private chat. You can have a 1-on-1 chat now.\\n3.Add music and Fun Center in the chatroom. You can listen to music and play mini-games when chatting.\\n4.Add Room, Giver, Receiver and other ranking systems in the chatroom. You can enjoy yourself by interacting with others in a more active room.\",\"releaseDate\":\"2022-04-12\",\"releaseTimestamp\":\"2022-04-12T01:25:53Z\"},{\"versionDisplay\":\"1.0.7\",\"releaseNotes\":\"Updates are as follows:\\n1.Add the feature of sending props when spectating. You have more ways to interact with each other in the game.\\n2.Add private chat. You can have a 1-on-1 chat now.\\n3.Add music and Fun Center in the chatroom. You can listen to music and play mini-games when chatting.\\n4.Add Room, Giver, Receiver and other ranking systems in the chatroom. You can enjoy yourself by interacting with others in a more active room.\",\"releaseDate\":\"2022-04-04\",\"releaseTimestamp\":\"2022-04-04T15:53:51Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows:\\n1.A brand new game mode - Quick mode is available now! Come to experience the very different new mode.\\n2.Guest players can take part in and have fun in the Chatroom Party now.\\n3.Add Weekly Gift Star and Contribution in 7 Days in Chatroom Party. You can get plentiful diamonds/dazzling titles by getting on the list, come and join us! \\n4.Optimize game experience and fix bugs.\",\"releaseDate\":\"2022-01-25\",\"releaseTimestamp\":\"2022-01-25T01:24:55Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows.\\r\\n1.The new version of YallaParchis is coming with our much-anticipated Chatroom Party! Chatroom Party supports online live voice and video chat, also more surprises are waiting for you. The entrance to Chatroom Party is in Events, come and enjoy it with your friends!\\r\\n2.Optimize game experience and fix more bugs.\",\"releaseDate\":\"2021-12-02\",\"releaseTimestamp\":\"2021-12-02T14:59:35Z\"},{\"versionDisplay\":\"1.0.4.1\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows.\\r\\n1.Become VIP and enjoy more privileges\\r\\n2.Skin subscription upgrades to VIP 1\\r\\n3.Add VIP Room to fight with your friends in the real high bet game \\r\\n4.Add Rank sharing to share with your friends through more channels\\r\\n5.Optimize game experience and bugs fixed.\",\"releaseDate\":\"2021-10-26\",\"releaseTimestamp\":\"2021-10-26T01:09:34Z\"},{\"versionDisplay\":\"1.0.3.1\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows.\\r\\n1.Add Event Pass to get more free awards.\\r\\n2.Purchase Event Pass to line up in Treasure Chest.\\r\\n3.Users can send interaction props during game.\\r\\n4.Add LIKE to make more friends.\\r\\n5.Add Bio \u0026 Constellation in Basic Information.\\r\\n6.Optimize game experience and bugs fixed.\",\"releaseDate\":\"2021-08-10\",\"releaseTimestamp\":\"2021-08-10T01:05:31Z\"},{\"versionDisplay\":\"1.0.2.2\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows.\\r\\n1.Optimized for versions below iPhone X. \\r\\n2.Bugs fixed.\",\"releaseDate\":\"2021-06-21\",\"releaseTimestamp\":\"2021-06-21T23:15:55Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"Welcome to YallaParchis, a Parchis game supporting real-time online voice chat. Updates are as follows.\\n1. Add skin subscription function: subscribe to enjoy beautiful skins immediately.\\n2. Add user guidance to help new users understand the app quickly.\\n3. Add weekly reward in treasure chest. Get extra reward if you achieve the goal.\\n4. Add legend Star list.\\n5. Spectators can send comments in game.\\n6. Bugs fixed.\",\"releaseDate\":\"2021-05-24\",\"releaseTimestamp\":\"2021-05-24T22:35:32Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"Welcome to Yalla Parchis,let’s enjoy voice chat with friends during game. \\r\\nUpdates:\\r\\n1.Add rank system: raise rank level to get more diamonds.\\r\\n2.Add global rank and friend rank.\\r\\n3.Add mail system: support system messages and reward distribution.\\r\\n4.Recharge is available during game.\\r\\n5.Add push notification function. Never miss game invitation from friends again.\\r\\n6.Add more delicate profile frames.\\r\\n7.Bugs fixes.\",\"releaseDate\":\"2021-03-22\",\"releaseTimestamp\":\"2021-03-22T23:07:56Z\"},{\"versionDisplay\":\"1.0.0.4\",\"releaseNotes\":null,\"releaseDate\":\"2021-02-02\",\"releaseTimestamp\":\"2021-02-02T19:47:37Z\"}],\"websiteUrl\":\"https://www.yallaparchis.com/\",\"editorialNotes\":{\"tagline\":\"Play and chat with friends\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855496029\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276745216}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855496029\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276745216}]}],\"requires32bit\":false,\"releaseDate\":\"2021-02-02\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallaparchisi\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/79/64/db/7964db3d-7c7d-57ec-0130-b42702f8210b/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"592e81\",\"textColor1\":\"ebeff7\",\"textColor2\":\"f4b62c\",\"text