-17\",\"isMerchandisedEnabled\":false,\"description\":{\"standard\":\"Get monthly 2100 Gold Coins \u0026 many privileges\"},\"subscriptionFamilyId\":\"20608200\",\"icuLocale\":\"en_US@currency=USD\",\"url\":\"https://apps.apple.com/us/app/patrician-premium-membership/id1091902866\",\"isSubscription\":true,\"isMerchandisedVisibleByDefault\":false,\"isFamilyShareable\":false,\"name\":\"Patrician - Premium Membership\"}},{\"id\":\"1567843595\",\"type\":\"in-apps\",\"href\":\"/v1/catalog/us/in-apps/1567843595?l=en-US\",\"attributes\":{\"offers\":[{\"buyParams\":\"productType=A\u0026price=39990\u0026salableAdamId=1567843595\u0026pricingParameters=STDQ\u0026pg=default\",\"type\":\"buy\",\"priceFormatted\":\"$39.99\",\"price\":39.99,\"currencyCode\":\"USD\",\"assets\":[],\"recurringSubscriptionPeriod\":\"P1M\"}],\"subscriptionFamilyRank\":1,\"offerName\":\"com.weieyu.yalla.membership.two\",\"releaseDate\":\"2009-06-17\",\"isMerchandisedEnabled\":false,\"description\":{\"standard\":\"Get monthly 4500 gold coins \u0026 many privileges\"},\"subscriptionFamilyId\":\"20608200\",\"icuLocale\":\"en_US@currency=USD\",\"url\":\"https://apps.apple.com/us/app/knight-premium-membership/id1091902866\",\"isSubscription\":true,\"isMerchandisedVisibleByDefault\":false,\"isFamilyShareable\":false,\"name\":\"Knight - Premium Membership\"}}]},\"developer-other-apps\":{\"href\":\"/v1/catalog/us/apps/1091902866/developer-other-apps?l=en-US\",\"data\":[{\"id\":\"1419536376\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1419536376?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":22,\"genreName\":\"Family\",\"genre\":7009,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/us/charts/iphone/family-games/7009\"}},\"url\":\"https://apps.apple.com/us/app/yalla-ludo-ludo-domino/id1419536376\",\"userRating\":{\"value\":3.9,\"ratingCount\":8032,\"ratingCountList\":[1428,447,533,844,4780],\"ariaLabelForRatings\":\"3.9 stars\"},\"genreDisplayName\":\"Board\",\"name\":\"Yalla Ludo - Ludo\u0026Domino\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Ludo, an app with voice chat, allows you to play Ludo or Domino with your friends online.\\n\\nReal-time voice chat\\nTalk with players via voice chat at any time, meet new friends and enjoy the game!\\n\\nVarious game modes\\nLudo includes two modes: 1 ON 1 mode, 4-Player mode. Each mode has four gameplays: Classic, Master, Quick and Magic.\\nDomino: Drew Game and All Five.\\n\\nPlay with friends easily\\nPrivate rooms and local rooms enable you to play with buddies either online or offline. Come and have fun in games together！\\n\\nGroup Voice Chat for Gamers\\r\\nThe chat room allows you to meet more gamers from all over the world and exchange ideas about games with each other. You can also invite friends or anyone else to play Ludo \u0026 Domino by this group chat. Let’s enjoy the happy time in Yalla Ludo!\\r\\n\\nMore game bonus? Find them in Yalla Ludo VIP\\nSubscribe to Yalla Ludo VIP to enjoy the extra advanced features:\\nCollect free daily coins, diamonds and VIP chests.\\nPrivileged game room: create your  room in the VIP room, invite others to play together and more options for bets.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Ludo VIP, the purchase will be billed to your iTunes account. \\nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nCurrent Yalla Ludo VIP subscription price starts at 11.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice. \\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo without becoming a Yalla Ludo VIP.\\n\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\n\\nPrivacy Policy：https://www.fyxtechhk.com/term/EN/TermOfService.html\\n\\nTerms of Service：https://www.fyxtechhk.com/term/EN/TermOfService.html#TermsOfService\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://www.yallaludo.com/\",\"versionHistory\":[{\"versionDisplay\":\"1.3.5.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T10:38:09Z\"},{\"versionDisplay\":\"1.3.5.0\",\"releaseNotes\":\"Updates:\\r\\n1. Ramadan UI Design - Enjoy the new user interface designed for Ramadan and celebrate together!\\r\\n2. Arrow Mode - Experience a new game mode in Ludo that is more exciting!\\r\\n3. Higher Max Level - Play games to reach a higher max level of 80 at an optimized upgrade speed!\",\"releaseDate\":\"2023-03-17\",\"releaseTimestamp\":\"2023-03-17T06:26:34Z\"},{\"versionDisplay\":\"1.3.4.1\",\"releaseNotes\":\"Bug fixed\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T10:53:16Z\"},{\"versionDisplay\":\"1.3.4.0\",\"releaseNotes\":\"Updates:\\r\\n1. Snakes \u0026 Ladders - Enjoy the newly added classic game of Snakes \u0026 Ladders. You'll love the excitement and thrill of this timeless game!\\r\\n2. Champion Challenge - Get ready for the new Domino Champion Challenge! Play now and win free Domino skins!\\r\\n3. Random Wheel – This newly added mini-game lets you spin the wheel to have more fun with friends in the chat rooms!\",\"releaseDate\":\"2023-01-30\",\"releaseTimestamp\":\"2023-01-30T01:57:38Z\"},{\"versionDisplay\":\"1.3.3.0\",\"releaseNotes\":\"Updates:\\r\\n1. Optimized Royal Privilege - You can choose the room theme you like as the private chat theme;\\r\\n2. Optimized Restart the Journey - More missions are waiting for you to explore;\\r\\n3. Added Backpack System - You can obtain gifts and magic cards in the backpacks through activities and tasks.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T05:47:02Z\"},{\"versionDisplay\":\"1.3.2.1\",\"releaseNotes\":\"Updates:\\n1. Bug fixed - The sound issue in the room has been resolved.\\n2. Royal Privileges -  You can enrich your bio and use your dice skins in the Chat Room.\\n3. Optimized Member System - Owners of the top 10 member clubs can obtain honor badges.\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T00:50:17Z\"},{\"versionDisplay\":\"1.3.2.0\",\"releaseNotes\":\"Updates:\\r\\n1. New Login Method - Login with YallaChat and get an exclusive profile frame.\\r\\n2. Royal Privileges -  You can enrich your bio and use your dice skins in the Chat Room.\\r\\n3. Optimized Member System - Owners of the top 10 member clubs can obtain honor badges.\",\"releaseDate\":\"2022-07-29\",\"releaseTimestamp\":\"2022-07-29T03:59:52Z\"},{\"versionDisplay\":\"1.3.1.0\",\"releaseNotes\":\"Updates:\\r\\n1.Restart the journey : special missions for players who return after 30-days offline. \\r\\n2.Added in-game interactive stickers.\\r\\n3.Added royal privileges and optimized gifts in Chat Room.\",\"releaseDate\":\"2022-05-09\",\"releaseTimestamp\":\"2022-05-09T05:46:32Z\"},{\"versionDisplay\":\"1.3.0.0\",\"releaseNotes\":\"Updates:\\n1. Newly designed Ramadan User Interface.\\n2. Added Reward Tower: You can now collect Plentiful new rewards.\\n3. Optimized Royal system: Added new exclusive Royal vehicles and tips on how to maintain your Royal Level.\",\"releaseDate\":\"2022-03-25\",\"releaseTimestamp\":\"2022-03-25T02:41:48Z\"},{\"versionDisplay\":\"1.2.9.0\",\"releaseNotes\":\"Updates:\\r\\n1.Optimized Level Logos: Higher levels will get you more dazzling logos;\\r\\n2.Optimized Global Ranking: You can locate yourself on the ranking by simply tapping your rank;\\r\\n3.Added On-Mic Emojis: You can express yourself even without speaking to others;\\r\\n4.Added Room Operation Records;\\r\\n5.Bugs fixed and performance improved.\\r\",\"releaseDate\":\"2022-01-27\",\"releaseTimestamp\":\"2022-01-27T08:31:43Z\"},{\"versionDisplay\":\"1.2.8.0\",\"releaseNotes\":\"Updates:\\r\\n1.Added Battle Pass: New players can collect plentiful rewards by completing easy tasks. Get even more rewards by upgrading to Elite Pass;\\r\\n2.Brand new Shop system and new items: New Unique IDs and Profile Cards. You can buy and use new items to distinct yourself from others;\\r\\n3.Added Royal privileges: The recharge ticket allows you to get an extra recharge bonus. More limited items including dice skins, room themes, and profile cards for you to choose from;\\r\\n4.Added Stopwatch and Timer: You can use the stopwatch and timer in the Chat room;\\r\\n5.Added Fruit Fight in the Chat Room: In the game, each player will be assigned a fruit by the system randomly. The player needs to tell the host which fruit he wants to slice. The winner is the last player whose fruit is sliced;\\r\\n6.Optimized season settlement page: The final rank of the last season is added to the page;\\r\\n7.Optimized horse image: Hope you will like the new horse image;\\r\\n8.Bugs fixed.\",\"releaseDate\":\"2021-12-15\",\"releaseTimestamp\":\"2021-12-15T03:41:20Z\"},{\"versionDisplay\":\"1.2.7.2\",\"releaseNotes\":\"Updates:\\r\\n1.Changed icon color: to celebrate the 50th UAE National Day, the app icon color is changed;\\r\\n2.Bugs fixed.\",\"releaseDate\":\"2021-10-25\",\"releaseTimestamp\":\"2021-10-25T13:49:15Z\"},{\"versionDisplay\":\"1.2.7.0\",\"releaseNotes\":\"Updates:\\r\\n1.Added Royal Level system: find it on the top of your basic info page;\\r\\n2.Added Spotlight and team mode in Night Ludo: explore with your friends;\\r\\n3.Added Lucky Numbers and Dice in the Chat Room: chat and play;\\r\\n4.Add service: FAQ is upgraded to Support to provide more all-round help service;\\r\\n5.Bugs fixed.\",\"releaseDate\":\"2021-10-08\",\"releaseTimestamp\":\"2021-10-08T06:16:27Z\"},{\"versionDisplay\":\"1.2.6.1\",\"releaseNotes\":\"Updates:\\r\\n1. Bug fixed: optimize the game experience\",\"releaseDate\":\"2021-07-05\",\"releaseTimestamp\":\"2021-07-05T09:29:03Z\"},{\"versionDisplay\":\"1.2.6.0\",\"releaseNotes\":\"Updates\\r\\n1.New game mode- Night Ludo: with Night Ludo you can only see few parts of the board, so be careful of your opponents moves.\\r\\n2.Added Moments - with Moments you can record and share moments in your chat room with everyone.\\r\\n3.Updated Spectate function - turn on the live chat when you are spectating games.\\r\\n4.Added chat bubble in Messages - use your favorite chat bubbles when messaging your friends.\\r\\n5.Bug fixed.\",\"releaseDate\":\"2021-06-15\",\"releaseTimestamp\":\"2021-06-15T02:08:42Z\"},{\"versionDisplay\":\"1.2.5.1\",\"releaseNotes\":\"Updates:\\n1.Optimized the game experience in Team mode.\\n2.Bug fixed.\",\"releaseDate\":\"2021-04-20\",\"releaseTimestamp\":\"2021-04-20T00:16:19Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"Updates:\\r\\n1.UI changed: added Ramadan materials on the game interface;\\r\\n2.Added single-mode in Team-up, you can team-up with strangers now;\\r\\n3.Added exclusive profile frames for VIP and badges for room gifts; \\r\\n4.Bug fixed.\",\"releaseDate\":\"2021-04-05\",\"releaseTimestamp\":\"2021-04-05T09:42:43Z\"},{\"versionDisplay\":\"1.2.4.1\",\"releaseNotes\":\"Fixed the crash issue in the new version.\",\"releaseDate\":\"2021-02-04\",\"releaseTimestamp\":\"2021-02-04T21:22:31Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"Updates：\\r\\n1.Added VIP Baron: You can enjoy more features by subscribing VIP Baron;\\r\\n2.Added room lock in Chat Room;\\r\\n3.Added “pin on top” card: You can pin your room on top with this card;\\r\\n4.You can enter chat room through the entry on the friend list;\\r\\n5.You can send pictures and use @ in Chat Room;\\r\\n6.You can view the rooms which you recently entered on Recently page;\\r\\n7.Bug fixes.\",\"releaseDate\":\"2021-02-01\",\"releaseTimestamp\":\"2021-02-01T14:06:16Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"Updates：\\r\\n1.Added features to personalize the user experience such as badges, magic effect on the profile photo, profile frame, and room theme;\\r\\n2.Added features to engage users such as team mode, sharing favorite rooms with friends in messages and showing the contribution ranking in the Chat room;\\r\\n3.Bug fixes.\",\"releaseDate\":\"2020-11-10\",\"releaseTimestamp\":\"2020-11-10T11:54:54Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"Updates：\\n1. Chat Room entrance is moved to the bottom navigation bar, making it easier for users to enter the room ;\\n2. Added new rankings--Ludo Billionaire and Legend Star;\\n3. Brand new background music and sound effects are used to create immersive experience for players ;\\n4. Fixed bugs.\",\"releaseDate\":\"2020-09-06\",\"releaseTimestamp\":\"2020-09-06T04:11:29Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"Updates：\\r\\n1.Added Music feature in Chat Room: you could now play music in the room;\\r\\n2.Optimized Feedback: you can upload pictures;\\r\\n3.Optimized Notification: shows the exact number of unread messages;\\r\\n4.Fixed bugs.\",\"releaseDate\":\"2020-07-31\",\"releaseTimestamp\":\"2020-07-31T01:53:28Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Updates：\\n1. Brand-new “Majlis”-chat room: Customize your room and voice chat with multiplayer;\\n2. Private chat--the much-expected feature: Chat with your game friends privately in the Messages and invite them to play a game;\\n3. Customize your profile photo: Tap profile photo to upload your unique picture;\\n4. Fixed bugs.\",\"releaseDate\":\"2020-07-08\",\"releaseTimestamp\":\"2020-07-08T08:48:28Z\"},{\"versionDisplay\":\"1.1.10\",\"releaseNotes\":\"Updates：\\n1.Legend League: players who rank high could get more Legend Stars;\\n2.Friends deleted from the Facebook will not show in the Facebook Friends list;\\n3.Players at Level 1 could use \\\"Undo\\\" once for free in each round;\\n4.Top 200 players in each league will show on the board;\\n5.To strengthen the game balance, the \\\"Undo\\\" times for each round are now limited.\\n6.Fixed bugs.\",\"releaseDate\":\"2020-06-05\",\"releaseTimestamp\":\"2020-06-05T06:49:03Z\"},{\"versionDisplay\":\"1.1.9.1\",\"releaseNotes\":\"1. Added VIP feature: You can create a VIP room\\r\\n2. New skins, such as Ramadan-related dices, themes and profile frames\\r\\n3. Exclusive sound effect for some special dices\\r\\n4. Added profile frame for Legend Star\\r\\n5. Expanded the global ranking to 1000\\r\\n6. Fixed bugs\",\"releaseDate\":\"2020-05-13\",\"releaseTimestamp\":\"2020-05-13T00:12:15Z\"}],\"hasSafariExtension\":false,\"editorialNotes\":{\"short\":\"Every day brings new rewards, just complete your tasks.\",\"tagline\":\"It's in the Cards\"},\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855700731\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":418415616}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1419536376\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855700731\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":418415616}]}],\"requires32bit\":false,\"releaseDate\":\"2018-09-27\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallagame\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple126/v4/78/b1/d1/78b1d16c-4da7-760b-fac3-af7e8da37992/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"4c2c75\",\"textColor1\":\"ffffff\",\"textColor2\":\"b3bbe3\",\"textColor3\":\"dbd4e3\",\"textColor4\":\"9e9ecd\"},\"privacyPolicyUrl\":\"https://www.fyxtechhk.com/term/EN/TermOfService.html\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.yallaludo.com/\",\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Features115/v4/04/b7/af/04b7aff1-8a9b-b8df-326c-ad85a8a9563a/QlUtQVAtV1ctWWFsbGFfTHVkby5wbmc.png/{w}x{h}sr.{f}\",\"bgColor\":\"75a8ca\",\"textColor1\":\"121116\",\"textColor2\":\"121a20\",\"textColor3\":\"222832\",\"textColor4\":\"22313b\"},\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is2-ssl.mzstatic.com/