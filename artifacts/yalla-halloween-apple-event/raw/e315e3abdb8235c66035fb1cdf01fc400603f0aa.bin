":2778,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/14/ef/ca/14efca67-b42e-a827-5a95-c0a2ed5655d3/f6978762-66ab-4922-9c2f-7827396738a9_6.5_U5bf8-1-_U82f1_U8bed_U5907_U4efd_2.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"080504\",\"textColor2\":\"120f0d\",\"textColor3\":\"393736\",\"textColor4\":\"413f3d\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/35/8d/f7/358df78a-d466-82c1-294c-f060ff07b81f/be0bdfdb-d906-4900-afcb-110425c8a53a_6.5_U5bf8-2-_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0b0e0f\",\"textColor2\":\"0f1012\",\"textColor3\":\"3c3e3f\",\"textColor4\":\"3f4042\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/b0/16/49/b01649c3-68e9-b791-7c03-73cbc3184658/c04b834a-b5a5-49de-9fa9-cc4b5041f879_6.5_U5bf8-3-_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0f0d14\",\"textColor2\":\"0d0f12\",\"textColor3\":\"3f3d43\",\"textColor4\":\"3e3f41\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/db/2a/9f/db2a9fa1-0e32-d4a6-c211-48f4991be6cf/d7f3eaf5-d534-48d6-981e-c653da54bca8_6.5_U5bf8-4-_U82f1_U8bed_U5907_U4efd_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0d0e10\",\"textColor2\":\"1e2451\",\"textColor3\":\"3e3e40\",\"textColor4\":\"4b4f74\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/76/b2/85/76b285f3-c750-d5c3-2127-10eeca20bb50/7fb909c8-bb55-4075-9f99-613bbf387015_6.5_U5bf8-5-_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"f1fdf9\",\"textColor1\":\"000000\",\"textColor2\":\"0d0f12\",\"textColor3\":\"303231\",\"textColor4\":\"3b3e40\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/b0/33/d8/b033d878-72ec-4032-cd2b-d6879177afa0/2a252b19-3470-4d8f-942e-d6746f814175_6.5_U5bf8-6-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"050505\",\"textColor2\":\"0d0f12\",\"textColor3\":\"373737\",\"textColor4\":\"3e3f41\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/8c/2f/aa/8c2faab9-9a43-ec0e-1184-722120545595/594eb577-5ef3-4708-8e41-91d5df51825c_6.5_U5bf8-7-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f3fefa\",\"textColor1\":\"0d0f12\",\"textColor2\":\"272b2c\",\"textColor3\":\"3b3f40\",\"textColor4\":\"4f5555\"},{\"width\":1284,\"height\":2778,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/24/72/d2/2472d209-4705-e608-4ac6-9564dd20ff07/333e67b5-22f1-471b-9af3-f4c122bbb329_6.5_U5bf8-8-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f7fefc\",\"textColor1\":\"000000\",\"textColor2\":\"0d0f12\",\"textColor3\":\"313232\",\"textColor4\":\"3c3f41\"}],\"iphone6\":[{\"width\":750,\"height\":1334,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple126/v4/12/46/a3/1246a33b-b8e0-9a16-ee35-5d10fe483122/932817da-2a2f-44d3-b4bf-e9e9bc592ae1_4.7-1-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fbfefd\",\"textColor1\":\"0b0806\",\"textColor2\":\"151211\",\"textColor3\":\"3b3938\",\"textColor4\":\"434140\"},{\"width\":750,\"height\":1334,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/73/1e/db/731edbe0-6869-c17c-e537-7ba0a152fd91/0c020cd6-8036-4210-8939-974f60503876_4.7-2-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0c0c0d\",\"textColor2\":\"0d0f12\",\"textColor3\":\"3d3d3d\",\"textColor4\":\"3e3f41\"},{\"width\":750,\"height\":1334,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple116/v4/ad/9e/93/ad9e9304-905a-76cf-ae9e-a495e563cd19/9caf71b8-f444-454a-b2b6-cdcb8b174768_4.7-3-_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"e7fcf5\",\"textColor1\":\"0e0e12\",\"textColor2\":\"411915\",\"textColor3\":\"393d3f\",\"textColor4\":\"624642\"},{\"width\":750,\"height\":1334,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple116/v4/e4/03/00/e403008e-ea59-c17f-e487-a4bbdd7b94f2/681b4ee7-57e4-4409-b261-409f9a4669e6_4.7-4-_U82f1_U8bed_U5907_U4efd_3.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0d0e11\",\"textColor2\":\"1e2354\",\"textColor3\":\"3d3e40\",\"textColor4\":\"4b4f76\"},{\"width\":750,\"height\":1334,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple116/v4/93/7d/7a/937d7a0e-2749-327c-708a-126e618b1dec/b7837e3a-707a-4e5e-a98e-043249ad1f5f_4.7-5-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"fefffe\",\"textColor1\":\"080a0d\",\"textColor2\":\"0d0f12\",\"textColor3\":\"393b3d\",\"textColor4\":\"3d3f41\"},{\"width\":750,\"height\":1334,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/f4/9d/e6/f49de632-b352-5425-f04e-9609fa4e1ccb/1f3f9cad-c6a8-497f-b507-f9cc9131d4c4_4.7-6-_U82f1_U8bed_U5907_U4efd.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0e1014\",\"textColor2\":\"28292b\",\"textColor3\":\"3e3f43\",\"textColor4\":\"535455\"},{\"width\":750,\"height\":1334,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/07/81/0f/07810f59-29ee-74db-931e-43cc36196a8c/82327f0f-d960-4b19-8649-2577dbfd3d77_4.7-7-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f4fefa\",\"textColor1\":\"0d0f12\",\"textColor2\":\"2b2d2f\",\"textColor3\":\"3b3f40\",\"textColor4\":\"535758\"},{\"width\":750,\"height\":1334,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/14/13/7e/14137ef5-964e-ff4b-226b-e7926cb7b89e/af099c84-e26e-4f11-b249-63bf5824460d_4.7-8-_U82f1_U8bed_U5907_U4efd.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"eefdf8\",\"textColor1\":\"000000\",\"textColor2\":\"0d0f12\",\"textColor3\":\"2f3231\",\"textColor4\":\"3a3e40\"}]}}}}}},\"fileSizeByDevice\":{\"iPhone13,4\":116789248,\"iPhone13,3\":116789248,\"iPhone13,2\":116789248,\"iPhone13,1\":116789248,\"iPhone6,1\":124992512,\"iPhone6,2\":124992512,\"iPad8,12\":114159616,\"iPad8,11\":114159616,\"iPad8,10\":114159616,\"iPad14,6-A\":113739776,\"iPad14,6-B\":113739776,\"iPad7,6