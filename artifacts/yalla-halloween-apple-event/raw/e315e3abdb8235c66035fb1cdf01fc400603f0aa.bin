8,\"iPhone10,4\":127309824,\"iPad13,19\":126910464,\"iPhone14,7\":129589248,\"iPad14,5-A\":126910464,\"iPhone14,6\":126889984,\"iPad14,5-B\":126910464,\"iPhone14,5\":129589248,\"iPad13,11\":127330304,\"iPhone14,4\":129589248,\"iPad13,17\":126910464,\"iPad13,18\":126910464,\"universal\":140780544,\"iPod9,1\":127309824,\"iPhone14,8\":129589248,\"iPad13,16\":126910464,\"iPad6,7\":127330304,\"iPad6,4\":127330304,\"iPad6,3\":127330304,\"iPad6,8\":127330304,\"iPad13,8\":127330304,\"iPad13,9\":127330304,\"iPad13,4\":127330304,\"iPad13,5\":127330304,\"iPad13,6\":127330304,\"iPad13,7\":127330304,\"iPad13,1\":127330304,\"iPad13,2\":127330304}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/286274367/developer?l=en-US\",\"data\":[{\"id\":\"284965852\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/284965852?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Palringo Limited\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/palringo-limited/id284965852\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/286274367/genres?l=en-US\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6016?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Entertainment\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6016\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}}]}}},{\"id\":\"1377028992\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1377028992?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Infrequent/Mild Horror/Fear Themes\",\"Infrequent/Mild Sexual Content and Nudity\",\"Infrequent/Mild Simulated Gambling\",\"Infrequent/Mild Realistic Violence\",\"Frequent/Intense Profanity or Crude Humor\",\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\",\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Medical/Treatment Information\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/youstar-group-chat-room/id1377028992\",\"userRating\":{\"value\":4.2,\"ratingCount\":197,\"ratingCountList\":[18,9,17,20,133],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"7.5.8\",\"genreDisplayName\":\"Entertainment\",\"name\":\"YouStar - Group Chat Room\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Stonemobile India Private Limited\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"YouStar is a totally free group voice chat and entertainment community. Voice chat and play games with people nearby or around the world.\\n\\nChat with people who have similar hobbies and taste with you.\\nEvery day people from all over the world create their own rooms on YouStar, or join rooms by country or theme to have party together.\\n\\nWatch Videos Together\\nWatch football matches, live video games, chat about popular movies and TV series with friends to have nice times.\\n\\nChat freely without showing your face\\nIn YouStar, you can make voice chat with friends and groups without showing your face. talk about anything you are interested in - music, travel, food, sports, games, etc. You can also play your favorite music in your room, sing karaoke or play various interesting games.\\n\\nExquisite gift\\nYouStar has designed many beautiful and cool gifts for its users. Everyone likes to receive gifts from others. You can enhance the friendship between you and your friends by sending gifts.\\n\\nPrivate conversation\\nStart one-on-one private text and voice conversations with friends from all over the world. Absolutely protect the privacy of users, especially the privacy of female users.\\n\\nSurprises are everywhere\\nNo matter where you are, you can share interesting and surprising things in life with your friends.\\nHere, you can record every sparkle of life and save the beautiful moments. Share these moments with friends or keep them privately only for yourself.\\n\\nThe App is free to download and use. \\n\\nMore information can be found here:\\nYouStar Terms of Service: https://www.youstar.top/about/terms_of_service.html\\nYouStar Privacy Policy: https://www.youstar.top/about/privacy.html\\n\\nFollow us\\nhttps://www.Facebook.com/youstarvideochatvlogsapp\\n\u2028https://www.Twitter.com/youstarvlogsapp\\n\u2028https://www.Instagram.com/youstar_videochat_vlogs_app/\\n\u2028https://www.Pinterest.com/youstarvideochatvlogs\u2028\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"7.7.1\",\"releaseNotes\":\"1) New gift \\\"Voice changer card\\\"online.\\n2) Room function improved, like automatically repeat massage and so on.\\n3) Friend online notification.\\n4) Discover page can Display online user avatar.\",\"releaseDate\":\"2023-03-14\",\"releaseTimestamp\":\"2023-03-14T11:06:39Z\"},{\"versionDisplay\":\"7.7.0\",\"releaseNotes\":\"1. Room events : owners can create room events .\\n2. Email login\\n3. Fix bugs and optimize experience.\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T01:52:35Z\"},{\"versionDisplay\":\"7.6.9\",\"releaseNotes\":\"1) Store reconstruction\\r\\n2) [Room Game] Launch new game UMO.\\r\\n3) [Moment]support for gift rewards\\r\\n4) [Room] Added The energy rocket function \",\"releaseDate\":\"2023-02-05\",\"releaseTimestamp\":\"2023-02-05T06:59:12Z\"},{\"versionDisplay\":\"7.6.5\",\"releaseNotes\":\"Ludo game fee increased diamond currency.\",\"releaseDate\":\"2022-11-21\",\"releaseTimestamp\":\"2022-11-21T14:00:52Z\"},{\"versionDisplay\":\"7.6.4\",\"releaseNotes\":\"1) [Moment] Top content display and sorting.\\r\\n 2) Optimization of interface interaction without network status.\\r\\n 3) [Room function] Clear the chat information on the public screen of the room.\\r\\n 4) 2022 Qatar World Cup Theme UI.\\r\\n 5) [Room function] The background content of the room has been classified, and diamond purchase is supported.\\r\\n 6) [Relationship Chain] Delete friends, follow and unfollow, delete chat history.\\r\\n 7) Room optimization.\",\"releaseDate\":\"2022-11-11\",\"releaseTimestamp\":\"2022-11-11T01:31:28Z\"},{\"versionDisplay\":\"7.6.2\",\"releaseNotes\":\"Fix known issues\",\"releaseDate\":\"2022-11-02\",\"releaseTimestamp\":\"2022-11-02T10:38:09Z\"},{\"versionDisplay\":\"7.6.1\",\"releaseNotes\":\"fix some problems and add room text limitation\\nmoment updated，come and try it\",\"releaseDate\":\"2022-10-22\",\"releaseTimestamp\":\"2022-10-22T16:25:47Z\"},{\"versionDisplay\":\"7.6.0\",\"releaseNotes\":\"1. Optimize the effect of sending gifts and gift broadcasting\\r\\n2. Support sending 9999 gifts\\r\\n3. Add a game room and a video room on the home page\\r\\n4.Application 5th anniversary theme\\r\\n5. Fix known issues\",\"releaseDate\":\"2022-09-12\",\"releaseTimestamp\":\"2022-09-12T16:32:23Z\"},{\"versionDisplay\":\"7.5.9\",\"releaseNotes\":\"Fixed some bugs and improved user experience\",\"releaseDate\":\"2022-08-25\",\"releaseTimestamp\":\"2022-08-25T23:39:47Z\"},{\"versionDisplay\":\"7.5.8\",\"releaseNotes\":\"1. Heart changed  to Coins, which can be exchanged for diamonds. Added Coins flow record query.\\r\\n2. Modification of gift interface\\r\\n3. Added Room online user page, room contribution list, new room profile page \\r\\n4. We have re-launched the Ludo game, come and play it~\\r\\n5. Optimized the sound quality of the room and fixed bugs.\",\"releaseDate\":\"2022-08-19\",\"releaseTimestamp\":\"2022-08-19T08:08:27Z\"},{\"versionDisplay\":\"7.5.5\",\"releaseNotes\":\"Improve the sound quality and optimize the sound lagging problem\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T17:40:42Z\"},{\"versionDisplay\":\"7.5.4\",\"releaseNotes\":\"1. New homepage design\\r\\n2. Room tag can be chosen when a room created\\r\\n3. Optimized process of phone number login and registration\\r\\n4. Product UI upgrade and user experience optimization\\r\\n5. Optimized message modules and added an event-specific message entry\\r\\n6. Known bug fixes and user experience improvements\",\"releaseDate\":\"2022-07-15\",\"releaseTimestamp\":\"2022-07-15T16:41:08Z\"},{\"versionDisplay\":\"7.5.3\",\"releaseNotes\":\"What's New：\\n1) Add the For You room list and recommendations based on your interests\\r\\n2) New room music player function\\r\\n3) Personal homepage UI update\\r\\n4) My badge page function optimization\\r\\n5) Add sliding switch room switch on me -setting page\\r\\n6) Optimize the weak network experience  \",\"releaseDate\":\"2022-06-16\",\"releaseTimestamp\":\"2022-06-16T15:02:18Z\"},{\"versionDisplay\":\"7.4.8\",\"releaseNotes\":\"Swipe the screen to switch rooms\\nNight mode\",\"releaseDate\":\"2022-03-22\",\"releaseTimestamp\":\"2022-03-22T03:38:50Z\"},{\"versionDisplay\":\"7.4.6\",\"releaseNotes\":\"Grandly update\\nAdded exclusive nobility privileges for female users: Queen\",\"releaseDate\":\"2022-02-13\",\"releaseTimestamp\":\"2022-02-13T11:04:56Z\"},{\"versionDisplay\":\"7.4.5\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2022-01-18\",\"releaseTimestamp\":\"2022-01-18T03:39:37Z\"},{\"versionDisplay\":\"7.4.4\",\"releaseNotes\":\"1.2022 New Year theme\\n2. update new room themes\\n3. Optimize personal information editing\\n4. Optimize the room message function, fix the known problem, and improve the experience\",\"releaseDate\":\"2022-01-02\",\"releaseTimestamp\":\"2022-01-02T03:53:24Z\"},{\"versionDisplay\":\"7.4.3\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-12-16\",\"releaseTimestamp\":\"2021-12-16T02:24:13Z\"},{\"versionDisplay\":\"7.4.2\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-12-01\",\"releaseTimestamp\":\"2021-12-01T10:26:58Z\"},{\"versionDisplay\":\"7.4.1\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-11-23\",\"releaseTimestamp\":\"2021-11-23T08:48:10Z\"},{\"versionDisplay\":\"7.4.0\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-11-03\",\"releaseTimestamp\":\"2021-11-03T15:31:53Z\"},{\"versionDisplay\":\"7.3.9\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-10-13\",\"releaseTimestamp\":\"2021-10-13T06:13:38Z\"},{\"versionDisplay\":\"7.3.8\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-09-26\",\"releaseTimestamp\":\"2021-09-26T14:23:13Z\"},{\"versionDisplay\":\"7.3.7\",\"releaseNotes\":\"What's New：\\nFix some bugs\",\"releaseDate\":\"2021-09-23\",\"releaseTimestamp\":\"2021-09-23T10:17:25Z\"},{\"ve