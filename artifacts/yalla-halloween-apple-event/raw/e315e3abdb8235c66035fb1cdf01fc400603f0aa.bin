":\"/v1/catalog/us/genres/6014?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Games\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6014\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6005?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Social Networking\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6005\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7004?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Board\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/us/genre/id7004\"}},{\"id\":\"7009\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/7009?l=en-US\",\"attributes\":{\"parentName\":\"Games\",\"name\":\"Family\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/us/genre/id7009\"}}]}}},{\"id\":\"1527518551\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1527518551?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Infrequent/Mild Mature/Suggestive Themes\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":197,\"genreName\":\"Family\",\"genre\":7009,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/us/charts/iphone/family-games/7009\"}},\"url\":\"https://apps.apple.com/us/app/yalla-ludo-hd-for-ipad/id1527518551\",\"userRating\":{\"value\":3.9,\"ratingCount\":154,\"ratingCountList\":[26,7,11,22,88],\"ariaLabelForRatings\":\"3.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.1.2\",\"name\":\"Yalla Ludo HD — For iPad\",\"genreDisplayName\":\"Board\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Ludo HD, an app with voice chat, is specially designed for iPad. It enables players to enjoy smooth game experience and fancy game graphics.\\n\\nReal-time voice chat\\nTalk with players via voice chat at any time, meet new friends and enjoy the game!\\n\\nGreat game experience\\nHigh-quality visuals and delicate UI design. Besides, you may have a better experience on the Pad.\\n\\nPlay with friends easily\\nLocal rooms enable you to play with buddies offline. Come and have fun in games together！\\n\\nMore game bonus? Find them in Yalla Ludo VIP\\nSubscribe to Yalla Ludo HD VIP to enjoy the extra advanced features:\\nCollect free daily coins, diamonds and VIP chests.\\nPrivileged game room: create your  room in the VIP room, invite others to play together and more options for bets.\\n\\n-----------------------------------\\n\\nIf you choose to subscribe to Yalla Ludo HD VIP, the purchase will be billed to your iTunes account. \\nYour iTunes account will be charged automatically for renewal within 24 hours prior to the end of the current period. \\nYou can manage and cancel your subscriptions at any time by going to your iTunes Account Settings after purchase.\\nCurrent Yalla Ludo HD VIP subscription price starts at 11.99 USD/month. Prices are in U.S. dollars, may vary in countries other than the U.S. and are subject to change without notice. \\nNo cancellation of the current subscription is allowed during the active subscription period. You could still have great fun in Yalla Ludo HD without becoming a Yalla Ludo HD VIP.\\n\\nWe will continue to give our best shot to provide you with more fun games which will enrich your daily life.\\n\\n\\nPrivacy Policy：https://www.fyxtechhk.com/term/EN/TermOfService.html\\n\\nTerms of Service：https://www.fyxtechhk.com/term/EN/TermOfService.html#TermsOfService\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.1.7.6\",\"releaseNotes\":\"Update:\\nBugs fixed.\",\"releaseDate\":\"2023-02-13\",\"releaseTimestamp\":\"2023-02-13T23:49:09Z\"},{\"versionDisplay\":\"1.1.7.2\",\"releaseNotes\":\"Update:\\nBugs fixed.\",\"releaseDate\":\"2022-04-19\",\"releaseTimestamp\":\"2022-04-19T08:31:31Z\"},{\"versionDisplay\":\"1.1.7.1\",\"releaseNotes\":\"Update:\\nBugs fixed.\",\"releaseDate\":\"2021-10-27\",\"releaseTimestamp\":\"2021-10-27T01:02:53Z\"},{\"versionDisplay\":\"1.1.7\",\"releaseNotes\":\"Updates:\\r\\n1. Added Royal Level system: it shows on the top of your basic info page;\\u000b\\n2. Brand new Night Ludo: new Spotlight prop and allows you to fight with your friends; \\r\\n3. Added game result share: share your winning moment with your friends;\\r\\n4. Bug fixed.\\r\",\"releaseDate\":\"2021-10-09\",\"releaseTimestamp\":\"2021-10-09T01:23:12Z\"},{\"versionDisplay\":\"1.1.6\",\"releaseNotes\":\" 1. New game mode - Night Ludo: in Night Ludo, you can only see few parts of the board. So be careful of your opponents' moves;\\n 2. Updated Spectate function - turn on the live chat when you are spectating games;\\n 3. Added chat bubble in Messages - use your favorite chat bubbles when messaging your friends;\\n 4. Bug fixed.\",\"releaseDate\":\"2021-07-05\",\"releaseTimestamp\":\"2021-07-05T03:19:33Z\"},{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"1. Added single-mode in Team-up, you can team-up with strangers now;\\r\\n2. Other optimizations;\\r\\n3. Bugs fixed.\\r\",\"releaseDate\":\"2021-05-06\",\"releaseTimestamp\":\"2021-05-06T01:30:33Z\"},{\"versionDisplay\":\"1.1.4.2\",\"releaseNotes\":\"1.Added \\\"Team-up\\\" in Ludo: play Ludo with your friends;\\r\\n2.Added \\\"Message\\\" feature: send messages and emojis to your friends;\\r\\n3.Other optimizations;\\r\\n4.Bugs fixed. \",\"releaseDate\":\"2021-04-05\",\"releaseTimestamp\":\"2021-04-05T09:59:38Z\"},{\"versionDisplay\":\"1.1.4.1\",\"releaseNotes\":\"1.Added \\\"Team-up\\\" in Ludo: play Ludo with your friends;\\r\\n2.Added \\\"Message\\\" feature: send messages and emojis to your friends;\\r\\n3.Other optimizations;\\r\\n4.Bugs fixed. \\r\",\"releaseDate\":\"2021-03-18\",\"releaseTimestamp\":\"2021-03-18T06:48:03Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"1. Fixed bugs\",\"releaseDate\":\"2021-01-05\",\"releaseTimestamp\":\"2021-01-05T05:41:09Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"1.Added Billionaire and Legend Star in Rank.\\n2.Added Chat Off in game, you will not receive other players’ text messages after turning it on. \\n3.Bug fixed.\",\"releaseDate\":\"2020-11-26\",\"releaseTimestamp\":\"2020-11-26T01:56:49Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":null,\"releaseDate\":\"2020-09-30\",\"releaseTimestamp\":\"2020-09-30T02:50:27Z\"}],\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1527518551\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=854841651\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":169199616}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1527518551\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=