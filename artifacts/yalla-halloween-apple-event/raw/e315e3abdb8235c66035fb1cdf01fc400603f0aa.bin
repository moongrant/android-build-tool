hases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Frequent/Intense Mature/Suggestive Themes\",\"Infrequent/Mild Simulated Gambling\",\"Infrequent/Mild Cartoon or Fantasy Violence\",\"Infrequent/Mild Profanity or Crude Humor\",\"Infrequent/Mild Contests\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":125,\"genreName\":\"Entertainment\",\"genre\":6016,\"chart\":\"top-free\",\"chartLink\":\"https://apps.apple.com/us/charts/iphone/entertainment-apps/6016\"}},\"url\":\"https://apps.apple.com/us/app/weplay-%D9%88%D9%8A%D8%A8%D9%84%D8%A7%D9%8A-%D8%A3%D9%84%D8%B9%D8%A7%D8%A8-%D9%88%D8%AF%D8%B1%D8%AF%D8%B4%D8%A9/id1589399089\",\"userRating\":{\"value\":4.4,\"ratingCount\":22788,\"ratingCountList\":[1642,714,1042,1930,17460],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.3.0\",\"name\":\"WePlay(ويبلاي) - ألعاب ودردشة\",\"genreDisplayName\":\"Entertainment\",\"isPreorder\":false,\"artistName\":\"WEJOY PTE. LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 11.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 11.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"WePlay is a Party Game app that young people love to play. It offers the most popular casual party games and voice interaction. You will get more fun when playing this games! \\n\\n[Online Party Game Bar]\\nDraw \u0026 Guess: it not only tests your creativity but also your teamwork and drawing skills!\\nWeParty: The most popular game where civilians and killers pit their wits against one another!\\nMore and more new party games will be released in WePlay!\\n\\n[New Interactive Features]\\nImage \u0026 Cloth Changing: Create the 3D image, face pinching, model clothes, show your self-image!\\nVIP gift: Become the VIP of WePlay and get the unique gifts which includes the special rings and other privilege!          \\nPlay games, sing and do interesting things in WePlay!\\nIn WePlay, there are always humorous and friendly games waiting for you.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://weplayapp.com/\",\"versionHistory\":[{\"versionDisplay\":\"3.1.6\",\"releaseNotes\":\"1. Bug fixes and improvements.\",\"releaseDate\":\"2023-04-07\",\"releaseTimestamp\":\"2023-04-07T09:43:32Z\"},{\"versionDisplay\":\"3.1.5\",\"releaseNotes\":\"1. Launched the Voice Room Event Center\\n2. Launched a new version of Ludo\\n3. Bug fixes and performance improvements\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T10:05:45Z\"},{\"versionDisplay\":\"2.9.5\",\"releaseNotes\":\"1. Launched a new Q\u0026A mode of Who's the Spy.\\n2. Upgraded the full server notification to makes it more gorgeous.\\n3. Optimized network settings to reduce data consumed when you use the app.\",\"releaseDate\":\"2023-02-23\",\"releaseTimestamp\":\"2023-02-23T03:37:36Z\"},{\"versionDisplay\":\"2.8.4\",\"releaseNotes\":\"1. Fixed known problem of the gift panel\\n2. Optimize the experience of Crazy Camel\",\"releaseDate\":\"2023-01-10\",\"releaseTimestamp\":\"2023-01-10T15:59:00Z\"},{\"versionDisplay\":\"2.8.2\",\"releaseNotes\":\"1. Optimized the game experience of Who’s the Spy.\\n2. Added the offline mode of Who’s the Spy.\\n3. Bug fixes and improvements.\",\"releaseDate\":\"2023-01-06\",\"releaseTimestamp\":\"2023-01-06T03:35:14Z\"},{\"versionDisplay\":\"2.7.7\",\"releaseNotes\":\"1.Optimized the skin of Red Packet\\n2.Fixed bugs of WeParty\",\"releaseDate\":\"2022-12-27\",\"releaseTimestamp\":\"2022-12-27T16:04:55Z\"},{\"versionDisplay\":\"2.7.6\",\"releaseNotes\":\"1. Bug fixes and improvements.\",\"releaseDate\":\"2022-12-13\",\"releaseTimestamp\":\"2022-12-13T16:14:25Z\"},{\"versionDisplay\":\"2.7.5\",\"releaseNotes\":\"1.Launched skill of Red pockets, a new prop of the Voice Room.\\n2.Launched Mounts, a new prop of the Voice Room.\\n3.Bug fixes and improvements.\",\"releaseDate\":\"2022-12-10\",\"releaseTimestamp\":\"2022-12-10T03:19:27Z\"},{\"versionDisplay\":\"2.6.5\",\"releaseNotes\":\"1.Added a new currency for baloot, optimized matching strategy, and improved the experience for novice.\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T08:13:22Z\"},{\"versionDisplay\":\"2.4.6\",\"releaseNotes\":\"1. Bug fixes and improvements.\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T11:09:11Z\"},{\"versionDisplay\":\"2.4.5\",\"releaseNotes\":\"1. Added the Family Sign \\n2. Optimized the Guard Ranking \u0026 Gift Wall \\n3. Bug fixes and performance improvem\",\"releaseDate\":\"2022-11-11\",\"releaseTimestamp\":\"2022-11-11T02:25:04Z\"},{\"versionDisplay\":\"2.3.6\",\"releaseNotes\":\"1.Bug fixes and improvements\",\"releaseDate\":\"2022-09-30\",\"releaseTimestamp\":\"2022-09-30T10:49:36Z\"},{\"versionDisplay\":\"2.3.5\",\"releaseNotes\":\"1. Launched the new gameplay of Galactic Flag.\\n2. Optimized the gameplay experience of Who's the Spy and Baloot.\\n3. Bug fixes and improvements.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T13:44:53Z\"},{\"versionDisplay\":\"2.1.8\",\"releaseNotes\":\"1.Bug fixes and improvements\",\"releaseDate\":\"2022-09-15\",\"releaseTimestamp\":\"2022-09-15T09:40:44Z\"},{\"versionDisplay\":\"2.0.5\",\"releaseNotes\":\"1. Introduce the new game Baloot\",\"releaseDate\":\"2022-09-07\",\"releaseTimestamp\":\"2022-09-07T02:08:01Z\"},{\"versionDisplay\":\"1.10.8\",\"releaseNotes\":\"1. Bug fixes and improvements\",\"releaseDate\":\"2022-09-02\",\"releaseTimestamp\":\"2022-09-02T02:31:52Z\"},{\"versionDisplay\":\"1.10.6\",\"releaseNotes\":\"1.New game launched: Who is the Spy? Find the spy and become a hero!\\n2.Bug fixes and improvements\",\"releaseDate\":\"2022-08-17\",\"releaseTimestamp\":\"2022-08-17T11:24:02Z\"},{\"versionDisplay\":\"1.10.5\",\"releaseNotes\":\"1.New game launched: Who is the Spy? Find the spy and become a hero!\\n2.Bug fixes and improvements\",\"releaseDate\":\"2022-08-10\",\"releaseTimestamp\":\"2022-08-10T03:29:21Z\"},{\"versionDisplay\":\"1.9.6\",\"releaseNotes\":\"1. Optimized the level of the Advanced Voice Room, and added bonus for Voice Room upgrade\\n2. Optimized the Lucky Spinning Wheel of Voice Room \\n3. Bug fixes and improvements\",\"releaseDate\":\"2022-07-15\",\"releaseTimestamp\":\"2022-07-15T17:34:59Z\"},{\"versionDisplay\":\"1.9.5\",\"releaseNotes\":\"1. Optimized the level of the Advanced Voice Room, and added bonus for Voice Room upgrade\\n2. Optimized the Lucky Spinning Wheel of Voice Room \\n3. Bug fixes and improvements\",\"releaseDate\":\"2022-07-13\",\"releaseTimestamp\":\"2022-07-13T03:59:56Z\"},{\"versionDisplay\":\"1.8.8\",\"releaseNotes\":\"1. Bug fixes and performance improvements.\",\"releaseDate\":\"2022-06-28\",\"releaseTimestamp\":\"2022-06-28T02:31:57Z\"},{\"versionDisplay\":\"1.8.5\",\"releaseNotes\":\"1. Added Lucky Account Number.\\n2. The Owner's national flag will be displayed in the Advanced Voice Room.\\n3. New upgrade of Play Show Store and Avatar.\",\"releaseDate\":\"2022-06-14\",\"releaseTimestamp\":\"2022-06-14T10:57:14Z\"},{\"versionDisplay\":\"1.7.5\",\"releaseNotes\":\"1.Optimized  the gift-giving interface for a better gift giving experience\\n2.Bug fixes and improvements\",\"releaseDate\":\"2022-05-20\",\"releaseTimestamp\":\"2022-05-20T19:48:42Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"1. Optimized the Ranking UI, and added a new annual list\\n2. Icon optimizations of the homepage and the discovery page\\n3. Badges will be displayed in more scenes\\n4. Added new game - WeParty\\n5. Added Avatar Store - Play Show\",\"releaseDate\":\"2022-05-12\",\"releaseTimestamp\":\"2022-05-12T20:47:40Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"1. Added achievement system\\n2. Fixed known bugs\",\"releaseDate\":\"2022-05-12\",\"releaseTimestamp\":\"2022-05-12T08:25:01Z\"}],\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1589399089\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=856050807\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":766546944}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1589399089\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=856050807\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":766546944}]}],\"requires32bit\":false,\"releaseDate\":\"2021-12-08\",\"hasInAppPurchases\":true,\"bundleId\":\"com.wejoy.weplay.ar\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/52/24/ff/5224ff09-02ac-025f-a203-cdaf8020db19/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"146a44\",\"textColor1\":\"bcf6ff\",\"textColor2\":\"ffe5a1\",\"textColor3\":\"9adad9\",\"textColor4\":\"d0cc8e\"},\"privacyPolicyUrl\":\"https://weplayapp.com/protocol-yszc-ios\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://weplayapp.com/\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"brandLogo\":{\"width\":1080