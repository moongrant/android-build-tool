ageMetaKeywords.Collection.One":"@@storyTitle@@, @@featuredAppName1@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes, Mac","WEA.EditorialItemProductPages.MacAppStore.Meta.PageMetaKeywords.Collection.Three":"@@storyTitle@@, @@featuredAppName1@@, @@featuredAppName2@@, @@featuredAppName3@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes, Mac","WEA.EditorialItemProductPages.MacAppStore.Meta.PageMetaKeywords.Collection.Two":"@@storyTitle@@, @@featuredAppName1@@, @@featuredAppName2@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes, Mac","WEA.EditorialItemProductPages.Meta.PageMetaDescription":"Learn about @@storyTitle@@ on App Store. ","WEA.EditorialItemProductPages.Meta.PageMetaDescription.Collection.ManyMore":"Learn about collection @@storyTitle@@ featuring @@featuredAppName1@@, @@featuredAppName2@@, @@featuredAppName3@@ and many more on App Store. Enjoy these apps on your iPhone, iPad and iPod touch.","WEA.EditorialItemProductPages.Meta.PageMetaDescription.Collection.One":"Learn about collection @@storyTitle@@ featuring @@featuredAppName1@@ and many more on App Store. Enjoy these apps on your iPhone, iPad and iPod touch.","WEA.EditorialItemProductPages.Meta.PageMetaDescription.Collection.Three":"Learn about collection @@storyTitle@@ featuring @@featuredAppName1@@, @@featuredAppName2@@ and @@featuredAppName3@@ on App Store. Enjoy these apps on your iPhone, iPad and iPod touch.","WEA.EditorialItemProductPages.Meta.PageMetaDescription.Collection.Two":"Learn about collection @@storyTitle@@ featuring @@featuredAppName1@@, @@featuredAppName2@@ and many more on App Store. Enjoy these apps on your iPhone, iPad and iPod touch.","WEA.EditorialItemProductPages.Meta.PageMetaKeywords":"@@storyTitle@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes","WEA.EditorialItemProductPages.Meta.PageMetaKeywords.Collection.One":"@@storyTitle@@, @@featuredAppName1@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes","WEA.EditorialItemProductPages.Meta.PageMetaKeywords.Collection.Three":"@@storyTitle@@, @@featuredAppName1@@, @@featuredAppName2@@, @@featuredAppName3@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes","WEA.EditorialItemProductPages.Meta.PageMetaKeywords.Collection.Two":"@@storyTitle@@, @@featuredAppName1@@, @@featuredAppName2@@, @@applicationCategory@@, ios apps, app, appstore, app store, iphone, ipad, ipod touch, itouch, itunes","WEA.EditorialItemProductPages.Meta.title":"@@storyTitle@@ : App Store Story","WEA.EditorialItemProductPages.Social.title.AOTD":"App of the Day: @@appName@@","WEA.EditorialItemProductPages.Social.title.GOTD":"Game of the Day: @@appName@@","WEA.EditorialItemProductPages.Social.title.IAP":"In-App Purchase: @@appName@@","WEA.Error.Carrier.Install.AM":"To start listening, install Apple Music on your device.","WEA.Error.Carrier.Installed":"Already have the app?","WEA.Error.Carrier.Open.Action":"Get it on @@appname@@","WEA.Error.Generic.AppleMusicLogo.Text":"Apple Music","WEA.Error.Generic.GooglePlay":"Google Play","WEA.Error.Generic.Install.AM":"If this link does not work, you might need to @@installLink@@.","WEA.Error.Generic.Install.AM.Link.Text":"install Apple Music","WEA.Error.Generic.Meta.PageKeywords":"Apple Music","WEA.Error.Generic.Meta.PageKeywords.AppleBooks":"Apple Books","WEA.Error.Generic.Meta.PageKeywords.iTunes":"iTunes Store","WEA.Error.Generic.Meta.PageTitle":"Connecting to Apple Music","WEA.Error.Generic.Open.AM":"Open in Apple Music","WEA.Error.Generic.Open.Action.AM":"Open in","WEA.Error.Generic.Subtitle":"If you do not have iTunes, @@downloadLink@@. If you have iTunes and it does not open automatically, try opening it from your dock or Windows task bar.","WEA.Error.Generic.Subtitle.DownloadLink.Text":"download it for free","WEA.Error.Generic.Subtitle.DownloadLink.URL":"http://www.apple.com/uk/itunes/download/","WEA.Error.Generic.Title":"Connecting to Apple Music","WEA.Error.Generic.Title.AppleBooks":"Connecting to Apple Books","WEA.Error.Generic.Title.Apps":"Connecting to the App Store","WEA.Error.Generic.Title.Connecting":"Connecting","WEA.Error.Generic.Title.Podcasts":"Connecting to Apple Podcasts","WEA.Error.Generic.Title.iTunes":"Connecting to the iTunes Store.","WEA.Error.NativeMissing.AM.Subtitle":"You need iTunes to use Apple Music","WEA.Error.NativeMissing.Other.AM":"Get Apple Music on iOS, Android, Mac and Windows","WEA.Error.NativeMissing.Other.LearnMore.link":"https://www.apple.com/itunes/download/","WEA.Error.NativeMissing.Other.iTunes":"Get iTunes on iOS, Android, Mac and Windows","WEA.Error.NativeMissing.iTunes.Download.link":"https://www.apple.com/itunes/download/","WEA.Error.NativeMissing.iTunes.Download.text":"Download iTunes","WEA.Error.NativeMissing.iTunes.TV.Subtitle":"Download iTunes below to start watching.","WEA.Error.NativeMissing.iTunes.Title":"We could not find iTunes on your computer.","WEA.Error.NotFound.Meta.Title":"This content can’t be found.","WEA.Error.NotFound.general":"The page you're looking for cannot be found.","WEA.GroupingPages.CTA.GoToWebsite":"Go to","WEA.InvoicePages.Receipts.Instructions":"Try again on an iPhone, iPad or Mac, or use iTunes on a PC","WEA.InvoicePages.Receipts.Meta.Description":"You cannot turn off receipts on this device.","WEA.InvoicePages.Receipts.Meta.Title":"Receipts","WEA.InvoicePages.Receipts.Title":"You cannot turn off receipts on this device","WEA.LocalNav.CTA.AppName.TV":"Apple TV App","WEA.LocalNav.CTA.DownloadiTunes":"Download iTunes","WEA.LocalNav.CTA.DownloadiTunes.url":"https://www.apple.com/itunes/download/","WEA.LocalNav.CTA.FreeTrial":"Try It Now","WEA.LocalNav.CTA.FreeTrial.url":"https://itunes.apple.com/subscribe?app=music","WEA.LocalNav.CTA.iTunesStore.TV":"Learn More","WEA.LocalNav.Preview.AM":"Preview","WEA.LocalNav.Preview.AppStore":"Preview","WEA.LocalNav.Preview.Books":"Preview","WEA.LocalNav.Preview.MAS":"Preview","WEA.LocalNav.Preview.Podcasts":"Preview","WEA.LocalNav.Preview.TV":"Preview","WEA.LocalNav.Preview.iBooks":"Preview","WEA.LocalNav.Preview.iTunes":"Preview","WEA.LocalNav.Store.AM":"Apple Music","WEA.LocalNav.Store.AppStore":"App Store","WEA.LocalNav.Store.Books":"Apple Books","WEA.LocalNav.Store.MAS":"Mac App Store","WEA.LocalNav.Store.Podcasts":"Apple Podcasts","WEA.LocalNav.Store.TV":"Apple TV","WEA.LocalNav.Store.iBooks":"Apple Books","WEA.LocalNav.Store.iTunes":"iTunes","WEA.LocalNav.Title.Preview.AM":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.AppStore":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.Books":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.MAS":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.Podcasts":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.TV":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iBooks":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iTunes":"@@product@@ @@qualifier@@","WEA.PaddleNav.Next.AX":"Next","WEA.PaddleNav.Previous.AX":"Previous","WEA.StarRating.Separator":" • "}}</script><script type="fastboot/shoebox" id="shoebox-media-api-cache-apps">{".v1.catalog.gb.apps.1091902866.l.en-gb.platform.web.additionalplatforms.appletv.2cipad.2ciphone.2cmac.extend.custompromotionaltext.2ccustomscreenshotsbytype.2cdescription.2cdeveloperinfo.2cdistributionkind.2ceditorialvideo.2cfilesizebydevice.2cmessagesscreenshots.2cprivacy.2cprivacypolicyurl.2crequirementsbydevicefamily.2csupporturlforlanguage.2cversionhistory.2cwebsiteurl.include.app-events.2cgenres.2cdeveloper.2creviews.2cmerchandised-in-apps.2ccustomers-also-bought-apps.2cdeveloper-other-apps.2ctop-in-apps.2crelated-editorial-items.limit.5bmerchandised-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.10":"{\"x\":1643110744515,\"d\":[{\"id\":\"1091902866\",\"type\":\"apps\",\"href\":\"/v1/catalog/gb/apps/1091902866?l=en-GB\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"artistName\":\"Yalla Technology FZ-LLC\",\"firstVersionSupportingInAppPurchaseApi\":\"2.4.0\",\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"url\":\"https://apps.apple.com/gb/app/yalla-group-voice-chat-rooms/id1091902866\",\"isIOSBinaryMacOSCompatible\":true,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Used to Track You\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"The following data may be used to track you across apps and websites owned by other companies:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Contact Info\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"User Content\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Search History\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"reviewsRestricted\":false,\"deviceFamilies\":[\"iphone\",\"ipod\"],\"isPreorder\":false,\"platformAttributes\":{\"ios\":{\"requires32bit\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/78/11/d8/7811d849-b053-2389-bbb8-4c6e5165a9b4/AppIcon-Yalla-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00d8c8\",\"textColor1\":\"161616\",\"textColor2\":\"161616\",\"textColor3\":\"123d3a\",\"textColor4\":\"123d3a\"},\"hasMessagesExtension\":false,\"versionHistory\":[{\"versionDisplay\":\"2.13.0\",\"releaseNotes\":\"1. إنشاء نشاطات: يمكنك جدولة نشاطات غرفتك إذا كان مستوى غرفتك لا يقل عن 10.\\n2. أرسل القبعات إلى جميع من على المايك: الآن يمكنك إرسال قبعة إلى جميع من على المايك مره واحدة. القبعات هي زينة فريدة لصور الملف الشخصي، يمكن إهدائها للمستخدمين الآخرين بصلاحية فعالة تبلغ 15 دقيقة.\\n3. تحسينات أخرى في الأداء.\\n\\n1. Create Events: You can schedule events for your room if your room level is not lower than 10. \\n2. Send Hats to Everyone on Mic: Now you can send a hat to everyone on Mic at once. Hats are unique profile photo decorations that can be gifted to other users with an effective validity of 15 minutes.\\n3. Other performance improvements.\",\"releaseDate\":\"2022-01-19\"},{\"versionDisplay\":\"2.12.1\",\"releaseNotes\":\"نقدم في هذا التحديث ميزات إضافية لأعضاء VIP لدينا، بما في ذلك:\\n- بطاقات شخصية حصرية\\n- تأثيرات الدخول الجديدة\\n- مقاعد الصف الأمامي على القائمة الموجودة اونلاين\\n\\nبالإضافة إلى ذلك، يمكن لجميع المستخدمين تجربة الميزات التالية لأول مرة:\\n- ميزة الرد: يمكنك الآن الرد على الرسائل في الغرفة.\\n- ملصقات جديدة: عبّر عن نفسك باستخدام ملصقات متحركة جديدة.\\n- عناصر جديدة في متجر الكريستال.\\n\\nIn this update we are introducing additional features to our VIP members, including:\\n- Exclusive profile cards\\n- New entrance effects\\n- Front row seats on the online list\\n\\nIn addition to that, all users can experience the following features for the first time:\\n- Reply Feature: You can now reply to messages in room.\\n- New Stickers: Express yourself with new animated stickers.\\n- New items in the Crystal Store.\",\"releaseDate\":\"2021-12-03\"},{\"versionDisplay\":\"2.12.0\",\"releaseNotes\":\"1. نظام VIP مضاف - برنامج يوفر مزايا مجانية للمستخدمين الذين تصل إعادة شحنهم إلى مبلغ محدد.\\n2. تحسينات أخرى في الأداء\\n1.  Added VIP System - a program that provides free benefits for users whose recharge reaches a specified amount.\\n2. Other performance improvements\",\"releaseDate\":\"2021-10-12\"},{\"versionDisplay\":\"2.11.16\",\"releaseNotes\":\"1. صناديق الكنز - الغرف التي تصل إلى المستوى 10 ستحتوى علي صناديق كنز. إرسل الهدايا لفتحها والحصول على مكافآت.\\r\\n2. إرسل هدايا إلى الجميع على المايك - يمكنك الآن إرسال الهدايا إلى الجميع على المايك في كل مرة.\\r\\n3. الإبلاغ عن الرسائل - يمكنك الإبلاغ عن رسالة بالضغط عليها لفترة طويلة عندما تكون في غرفة الدردشة.\\r\\n4. متجر موضوع الغرفة المحسن - من الأسهل عندما تصفح موضوع الغرفة الآن.\\r\\n5. تحسينات أخرى في الأداء.\\n\\n1. Treasure Chests - Rooms that reach Level 10 have treasure chests. Send gifts to open them and get rewards.\\r\\n2. Send Gifts to Everyone on Mic - Now you can send gifts to everyone on Mic at a time.\\r\\n3. Report Messages - You can report a message by long pressing it when in a chat room.\\r\\n4. Optimized Room Theme Store - It's easier for you to browse room themes now.\\r\\n5. Other performance improvements.\",\"releaseDate\":\"2021-08-12\"},{\"versionDisplay\":\"2.11.15\",\"releaseNotes\":\"1.الفارس- عضوية يلا بريميم: اشترك الآن لتحصل على معاملة كبار الشخصيات والقطع الذهبية الشهرية. \\n2.استطلاعات الرأي- يمكنك الآن إنشاء استطلاعات الرأي في الغرفة التي تديرها وكذلك التصويت في استطلاعات الرأي في أي غرفة.\\n3.مكافأة التعليق- يمكنك الآن مكافأة التعليق عدة مرات كما تريد.\\n4.حالة المستخدم- عند تصفح قائمة المنشورات \\\"المتابعة\\\"، سوف يظهر لك أن شخصًا ما متواجد في غرفة من خلال أيقونة متحركة على صورة ملفه الشخصي.\\n5.تحسينات أخرى في الأداء.\\n\\n1. Knight - Premium Membership: subscribe now to get VIP treatment and monthly gold coins. \\n2. Polls - now you can create polls in rooms you manage and also vote in polls in any rooms.\\n3. Reward Comment - now you can reward a comment as many times as you like.\\n4. In-Room Status - when browsing the \\\"Following\\\" post list, you'll know someone is in a room from the In-Room icon on their profile photos.\\n5. Other performance improvements.\\n\",\"releaseDate\":\"2021-06-29\"},{\"versionDisplay\":\"2.11.14\",\"releaseNotes\":\"1.المصادقة الثنائية - فهي تحمي حسابك من خلال طلب رمز تحقق إضافي عند تسجيل الدخول على جهاز لا نتعرف عليه.\\n2.شارات الإنجازات الجديدة -  كن أول من يحصل على هذه الشارات.\\n3.إضافة موضوع - يمكنك الآن إضافة موضوع عند إعادة نشر منشور.\\n4.فئة الموضوع الجديد - يمكنك العثور على الموضوعات التي تم إنشاؤها حديثا في الفئة \\\"جديد\\\".\\n5.تحسينات أخرى في الأداء.\\n\\n1. Two-Factor Authentication - it protects your account by requiring an additional verification code when you log in on a device we don’t recognize. \\n\u20282. New Achievement Badges - be the first one to get these badges. \u2028\\n3. Add a Topic - you can now add a topic when you repost a post. \u2028\\n4. New Topic Category - you can find newly created topics in the “New” category. \u2028\\n5. Other performance improvements.\\n\",\"releaseDate\":\"2021-05-17\"},{\"versionDisplay\":\"2.11.13\",\"releaseNotes\":\"1.واجهة المستخدم الخاصة بشهر رمضان - تم تحديث يلا بزخارف رمضان.\\n2.شارات الإنجازات الجديدة - كن أول من يحصل على هذه الشارات.\\n3.رموز تعبيرية متحركة على المايك - عبر عن نفسك باالرموز التعبيرية التي ستظهر على المايك.\\n4.تحسينات أخرى في الأداء.\\n\\n\\n\\n1. Ramadan Themed UI - Yalla is updated with Ramadan decorations.\\n2. New Achievement Badges - be the first one to get these badges.\\n3. Animated Stickers on Mic - express yourself with stickers that will show on Mic.\\n4. Other performance improvements.\\n\",\"releaseDate\":\"2021-04-06\"},{\"versionDisplay\":\"2.11.12\",\"releaseNotes\":\"1. الوضع الليلي - الآن يمكنك استخدام يلا مع الوضع الليلي. قم بإعداده في الإعدادات.\\n2. قفل وفتح الميكروفون - يمكن لمالكي الغرف الآن منح هذا الإذن لمشرفي الغرفة.\\n3. فئات الموضوعات ومشرفين الموضوعات - يمكنك عرض الموضوعات حسب الفئة وإضافة ما يصل إلى 5 مشرفين لموضوعك.\\n4. تحسينات أخرى في الأداء.\\n\\n\\n1. Dark Mode - now you can use Yalla with Dark Mode. Set it up in Settings.\\n2. Lock and Unlock Microphones - room owners can now grant this permission to room admins.\\n3. Topics Categories \u0026 Topic Admins - you can view topics by category and add up to 5 admins to your topic.\\n4. Other performance improvements\",\"releaseDate\":\"2021-02-02\"},{\"versionDisplay\":\"2.11.11\",\"releaseNotes\":\"1. إعادة تصميم الصفحة الرئيسية للشارة. تمت إضافة تصنيف الرتب الفصلي وتصنيف الرتب الأصدقاء للشارة الإنجازات.\\n2. تحسينات الأداء الأخرى\\n\\n1. Redesigned the Badge homepage. Added Achievement Badge Seasonal Ranking and Friends Ranking.\\n2. Other performance improvements\\n\",\"releaseDate\":\"2020-12-08\"},{\"versionDisplay\":\"2.11.10\",\"releaseNotes\":\"1. تمت ترقية \\\"قطع الحظ الذهبية\\\" إلى \\\"حقيبة الحظ\\\": يمكنك إرسال حقيبة الحظ تحتوي على قطع ذهبية أو هدايا.\\n2. يمكنك مشاركة الملف الشخصي الآخرين مع أصدقائك.\\n3. يتم عرض أفضل واحد تعليق مميز على منشور في اللحظات.\\n4. يمكنك خلع الشارات التي ترتديها.\\n5. تحسينات الأداء الأخرى\\n\\n1. \\\"Lucky Golds\\\" is upgraded to \\\"Lucky Bag\\\": You can send a lucky bag containing golds or gifts.\\n2. You can share the profile of others with your friends.\\n3. The Top 1 featured comment on a post is now displayed in Moments.\\n4. You can take off the badges you're wearing.\\n5. Other performance improvements\\n\",\"releaseDate\":\"2020-11-09\"},{\"versionDisplay\":\"2.11.9\",\"releaseNotes\":\"1. تمت إضافة عنصرجديد في المتجر: مركبات.\\n2. يمكنك الآن تعيين سعر محدد ونطاق عدد لرقم الحظ في غرفتك.\\n3. يمكنك الآن تثبيت ما يصل إلى 5 محادثات في أعلى قائمة الدردشة حتى تتمكن من العثور عليها بسرعة.\\n4. تمت إضافة  \\\"كبار الداعمين\\\" على صفحة الملف الشخصي.\\n5. يمكنك الآن إرفاق ما يصل إلى 3 لقطات شاشة في وقت واحد عند إرسال اشتكاء أو الأسئلة الشائعة والانطباعات.\\n6. تحسينات أخرى في الأداء.\\n\\n1. Added a new item in the store: Vehicles.\\n2. You can now set the price and number range of Lucky Number in your room.\\n3. You can now pin up to 5 chats to the top of your chat list so you can quickly find them.\\n4. Added \\\"Top Supporters\\\" on the profile page.\\n5. You can now attach up to 3 screenshots at a time when submitting report or feedback.\\n6. Other performance improvements.\\n\",\"releaseDate\":\"2020-10-30\"},{\"versionDisplay\":\"2.11.7\",\"releaseNotes\":\"1. تمت إضافة عنصر جديد في المتجر: أي دي غرفة مميز.\\n2. يمكنك تعديل الاسم المعروض لأصدقائك حتى تتمكن من التعرف عليهم بسهولة.\\n3. مظهر جديد الآن لقوائم الترتيب.\\n4. تمت إضافة مهمتين جديدتين.\\n5. تمت إضافة شارة جديدة.\\n6. تحسينات الأداء الأخرى\\n\\n1. Added a new store item: Unique Room ID\\n2. You can change the display name for your friends so you can easily recognize them.\\n3. The ranking lists now have a fresh new look.\\n4. Added two new achievement tasks.\\n5. Added a new badge.\\n6. Other performance improvements\\n\",\"releaseDate\":\"2020-08-18\"},{\"versionDisplay\":\"2.11.6\",\"releaseNotes\":\"1. تم إضافة وضع الزائر ، والذي يسمح لك باستخدام بعض الميزات دون تسجيل الدخول.\\n2. يمكنك إلغاء متابعة شخص في قائمتك التالية بالنقر على أيقونة القلب.\\n3. تم تصنيف موضوعات الغرف بحيث يمكنك الاختيار من بينها بسهولة أكبر.\\n4. تم تصنيف إشعارات اللحظات. حيث يمكنك اختيار عرض أنواع مختلفة من الإشعارات.\\n5. تحسينات الأداء الأخرى\\n\\n1. Added guest mode, which allows you to use some features without logging in.\\n2. You can unfollow someone on your following list by tapping the heart icon. \\n3. Room themes are categorized so you can choose from them more easily.\\n4. Moments notifications are categorized. You can choose to view different types of notifications. \\n5. Other performance improvements\\n\",\"releaseDate\":\"2020-07-06\"},{\"versionDisplay\":\"2.11.5\",\"releaseNotes\":\"1. يتم عرض أسعار عمليات الشراء داخل التطبيق بالعملة المحلية. \\n2. إضافة شارة جديدة \\n3. تحسينات الأداء الأخرى\\n\\n1. Prices for in-app purchases are displayed in local currency. \\n2. Added a new badge\\n3. Other performance improvements\\n\",\"releaseDate\":\"2020-06-15\"},{\"versionDisplay\":\"2.11.4\",\"releaseNotes\":\"1. تزيين التطبيق بموضوعات رمضان.\\n2. إضافة ميزة شريط التحكم وتكرار الأغنية في مشغل الموسيقى.\\n3. يمكنك إلغاء المتابعة أو الإنضمام لأي غرفة مقفلة بدون الحاجة للدخول إليها.\\n4. يباع قفل الغرفة الآن كعنصر اشتراك يمكنك شراؤه مباشرة دون استخدام القطع الذهبية كعملة وسيطة.\\n5. إضافة ست شارات جديدة.\\n6. يمكنك الآن تسجيل الدخول باستخدام Apple ID.\\n7. تحسينات الأداء الأخرى.\\n\\n1. Dressed up the app with Ramadan theme.\\n2. Added seekbar and song repeat feature in the music player.\\n3. You can unfollow or unjoin a locked room outside the room.\\n4. Room locks are now sold as subscription items that you can purchase directly without using golds as intermediary currency.\\n5. Added six badges.\\n6. You can now sign in with Apple ID.\\n7. Other performance improvements\\n\",\"releaseDate\":\"2020-04-10\"},{\"versionDisplay\":\"2.11.3\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\\n\",\"releaseDate\":\"2020-03-27\"},{\"versionDisplay\":\"2.11.2\",\"releaseNotes\":\"1. تم تحديث وظيفة المواضيع. حيث يمكنك الآن إنشاء الموضوع الخاص بك وإدارته كمضيّف.\u2028\\n2. يمكنك الآن إرسال الهدايا إلى المنشورات والإعجاب بالتعليقات. \\n\u20283. إضافة ميزة اختبار الشبكة\u2028\\n4. تحسينات الأداء الأخرى\\n\\n1. Topic feature is updated. You can now create your own topic and manage it as host.\\n2. You can now send gifts to posts and like comments.\\n3. Added network test feature\\n4. Other performance improvements\\n\",\"releaseDate\":\"2020-01-10\"},{\"versionDisplay\":\"2.11.1\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n\\n1. Fixed several bugs\\n2. Improved user experience\\n\",\"releaseDate\":\"2019-12-05\"},{\"versionDisplay\":\"2.11.0\",\"releaseNotes\":\"1. سيتم عرض إطارات الملف الشخصي في قوائم الأصدقاء\\n2.إصلاح العديد من الأخطاء\\n3. تحسين تجربة المستخدم\\n\\n1. Profile frames will be displayed on friend lists.\\n2. Fixed several bugs\\n3. Improved user experience\\n\",\"releaseDate\":\"2019-12-02\"},{\"versionDisplay\":\"2.10.6\",\"releaseNotes\":\"1. إصلاح العديد من الأخطاء\\n2. تحسين تجربة المستخدم\\n1. Fixed several bugs\\n2. Improved user experience\\n\",\"releaseDate\":\"2019-10-11\"},{\"versionDisplay\":\"2.10.5\",\"releaseNotes\":\"1.قمنا بإضافة مجموعة جديدة من الملصقات.\\n2. يمكنك مشاركة الغرف مع أصدقائك في يلا.\\n3. عرض قواعد مكافأة الغرفة الآن بشكل واضح.\\n4. يمكنك منع شخص من الدخول إلى الغرفة بشكل دائم عندما تطرده من الغرفة.\\n5. تم تحسين عملية إنشاء الغرفة.\\n6. تم تحسين ميزة الحظر.\\n7. تحسينات الأداء الأخرى.\\n\\n1. We’ve added an animated sticker pack. \\n2. You can share rooms with your Yalla friends.\\n3. The rules for room bonus are now clearly introduced.\\n4. You can forbid someone from entering room permanently when you kick this person out of room.\\n5. The process of creating room is improved. \\n6. The block feature is improved.\\n7. Other performance improvements\\n\",\"releaseDate\":\"2019-10-10\"},{\"versionDisplay\":\"2.10.4\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2019-09-19\"},{\"versionDisplay\":\"2.10.3\",\"releaseNotes\":\"1. Fixed several bugs\\n2. Improved user experience\",\"releaseDate\":\"2019-09-12\"},{\"versionDisplay\":\"2.10.2\",\"releaseNotes\":\"1. You can now play Roshambo (Rock-paper-scissors) in the room to win gifts. \\n2. You can use Voice Changer Cards to change the voice of people on Mic.\\n3. You can check your room’s daily Exp progression anytime.\\n4. You can use profile frames you’ve unlocked to decorate your profile photo.\\n5. Your friends’ bio will be displayed on your friend list.\\n6. Other performance improvements\\n\",\"releaseDate\":\"2019-09-09\"},{\"versionDisplay\":\"2.10.1\",\"releaseNotes\":\"1. Fixed several bugs\\r\\n2. Improved user experience\\r\",\"releaseDate\":\"2019-08-21\"}],\"hasPrivacyPolicyText\":true,\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"},{\"name\":\"Arabic\",\"tag\":\"ar\"},{\"name\":\"Hindi\",\"tag\":\"hi\"},{\"name\":\"Indonesian\",\"tag\":\"id\"},{\"name\":\"Portuguese\",\"tag\":\"pt-PT\"},{\"name\":\"Spanish\",\"tag\":\"es-ES\"},{\"name\":\"Turkish\",\"tag\":\"tr\"},{\"name\":\"Urdu\",\"tag\":\"ur\"}],\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple113/v4/ea/78/19/ea78198b-1965-1154-f46b-6bfe3395fe31/mzl.pzeslqiw.png/{w}x{h}{c}.{f}\",\"bgColor\":\"0fb3f8\",\"textColor1\":\"0b0606\",\"textColor2\":\"241b19\",\"textColor3\":\"0c2937\",\"textColor4\":\"203a46\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple123/v4/e2/b3/08/e2b3085f-e981-324b-4b2c-9a4abf3511e5/mzl.djgobldx.png/{w}x{h}{c}.{f}\",\"bgColor\":\"dbe1ff\",\"textColor1\":\"080808\",\"textColor2\":\"272045\",\"textColor3\":\"323339\",\"textColor4\":\"4b466a\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple113/v4/39/0f/9d/390f9d7f-d563-9719-9a7b-ecedcfdf68b7/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"e6fff9\",\"textColor1\":\"20150e\",\"textColor2\":\"332011\",\"textColor3\":\"47433d\",\"textColor4\":\"574c3f\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple113/v4/05/2c/85/052c8529-0d9e-b1aa-6586-d1550915457f/mzl.fyiqzxlb.png/{w}x{h}{c}.{f}\",\"bgColor\":\"beedff\",\"textColor1\":\"131521\",\"textColor2\":\"1e1e2f\",\"textColor3\":\"35404e\",\"textColor4\":\"3e4758\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/8f/7c/2a/8f7c2a9e-95c8-b6e2-525a-d5bc6ed847fc/mzl.ylhhfmzc.png/{w}x{h}{c}.{f}\",\"bgColor\":\"dce1ff\",\"textColor1\":\"0c0a0c\",\"textColor2\":\"2f284e\",\"textColor3\":\"36353d\",\"textColor4\":\"524d71\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple123/v4/02/23/c5/0223c509-1ab3-89d5-4c79-8d34844ce207/mzl.qbssbtsy.png/{w}x{h}{c}.{f}\",\"bgColor\":\"e8fefa\",\"textColor1\":\"1a1919\",\"textColor2\"