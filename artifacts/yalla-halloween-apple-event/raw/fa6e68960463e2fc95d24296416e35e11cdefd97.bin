\",\"bgColor\":\"251425\",\"textColor1\":\"ffffda\",\"textColor2\":\"efe8f1\",\"textColor3\":\"d3cfb5\",\"textColor4\":\"c6bec8\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple122/v4/41/a8/0b/41a80b09-b6c1-488f-9744-94e82d962d8f/1b4358bb-e557-417a-9ac4-1767aa3b7899__U8bed_U97f33.png/{w}x{h}{c}.{f}\",\"bgColor\":\"522e56\",\"textColor1\":\"f3eef3\",\"textColor2\":\"ffe400\",\"textColor3\":\"d3c7d4\",\"textColor4\":\"dcc011\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple112/v4/40/3f/b8/403fb84e-1ae2-d009-a56b-fbb3486dd2cb/88f7c98e-2056-40ac-9aed-6adaaf18e799__U804a_U5929_U5ba4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"522e56\",\"textColor1\":\"fffdff\",\"textColor2\":\"fdb92f\",\"textColor3\":\"dcd3dd\",\"textColor4\":\"db9d37\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple112/v4/78/8a/eb/788aebfd-50e9-6153-3c73-8fad49dd438b/f87dae5d-a9f5-470c-a19a-bdd303eba0d2__U597d_U53cb.png/{w}x{h}{c}.{f}\",\"bgColor\":\"241022\",\"textColor1\":\"ffffff\",\"textColor2\":\"ffc130\",\"textColor3\":\"d3cfd2\",\"textColor4\":\"d39d2d\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple112/v4/76/c1/15/76c11582-f384-9184-a767-bd701b9ff619/2f99db3c-ee65-40bd-b846-727a304084f5__U76ae_U80a4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"532f59\",\"textColor1\":\"ffffff\",\"textColor2\":\"fcbc2b\",\"textColor3\":\"dcd5dd\",\"textColor4\":\"da9f34\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple122/v4/23/ca/a6/23caa63f-1a71-9c78-a8cd-7fd8f8bb1bc3/05ef108c-22a2-4ba0-bbe6-eb30649ad189__U5b9d_U7bb1.png/{w}x{h}{c}.{f}\",\"bgColor\":\"52315b\",\"textColor1\":\"ffff92\",\"textColor2\":\"fabe29\",\"textColor3\":\"dcd586\",\"textColor4\":\"d8a133\"}],\"ipadPro\":[{\"width\":2048,\"height\":2732,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/94/d8/ba/94d8badd-a10b-20dc-c778-8d04e07b0274/f