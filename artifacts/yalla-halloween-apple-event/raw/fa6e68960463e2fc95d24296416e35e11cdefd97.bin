"type\":\"developers\",\"href\":\"/v1/catalog/de/developers/1444567250?l=de-DE\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/de/developer/yalla-technology-fz-llc/id1444567250\"}}]}}}]},\"related-editorial-items\":{\"href\":\"/v1/catalog/de/apps/1091902866/related-editorial-items?l=de-DE\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/de/apps/1091902866/customers-also-bought-apps?l=de-DE\",\"next\":\"/v1/catalog/de/apps/1091902866/customers-also-bought-apps?l=de-DE\u0026offset=10\",\"data\":[{\"id\":\"1514418573\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1514418573?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Keine Daten erfasst\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"Der Entwickler erfasst keine Daten von dieser App.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Unbeschränkter Zugang zum Web\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/whisper-group-voice-chat-room/id1514418573\",\"userRating\":{\"value\":4.9,\"ratingCount\":21,\"ratingCountList\":[0,0,1,1,19],\"ariaLabelForRatings\":\"4.9 Sterne\"},\"genreDisplayName\":\"Unterhaltung\",\"name\":\"Whisper-Group Voice Chat Room\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"BLAGOL TECHNOLOGY CO., LIMITED\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 12.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 12.0 oder neuer.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Erfordert macOS 11.0 (oder neuer) und einen Mac mit Apple M1-Chip (oder neuer).\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Whisper – Group Voice Chat Room\\n\\nWhisper is a free live entertainment community for voice chat.\\n\\nConnection with friends without barriers\\nWhisper is the most popular voice chat community, here you can chat safely with friends from all over the world, USA, UK, Saudi Arabia, UAE, Qatar, China, Germany... Language speaking, distance is never a barrier for your connection with them, totally free!\\n\\nMake friends safely\\nIn Whisper, you can chat with family, friends, and strangers, and have live party with them. Whenever you feel the need for peace, spiritual comfort, self-control, confidence, contentment or anything else, you can talk to your friends here secretly and safely, and you will get comforted.\\n\\nDistinctive features:\\nFree voice chat room – Whisper is an absolutely free voice chat app! you can connect with friends in Whisper using 3G, 4G, LTE or Wi-Fi internet, you can enjoy a super-fast, high-quality voice chat in the chat room.\\nFree online party – You can hold free party for birthday, wedding, Eid, or just real-time comments on football games or any other topic, enjoy your time here!\\nFast entry – registration will be done in 5 seconds, you can enter into Whisper to have fun with friends fastly.\\nWonderful moments – You can view moments posted by Whisper friends, and you can post your own to show your cool life moments.\\nCool effect gifts – In live chat room or direct chatting you can exchange cool effect gifts with your friends.\\nText message communication – you can communicate with people by adding friends and sending text messages to each other.\\nExciting games – There are many wonderful entertainment games in Whisper for free, you can play games with friends in voice chat room. \\nSpecific leaderboards – you can find the most popular Whisper users/rooms in leaderboards easily, and you can make yourself on the leaderboards also.\\n\\nGroup chat \u0026 direct connection\\nIf you prefer group chatting, join Whisper and you can connect with many friends at the same time and in one chat room. You can hold live parties, play awesome games with them, exchange gifts and happiness. If you prefer direct chat, join Whisper and you can make friends and talk with him by voice or text safely, let your heart to be comforted here.\\n\\nBest online social connection community\\nStill feeling shy to talk with strangers? Still worrying about long distance communication with friends? Still annoyed by language speaking difficulties during online chat with new friends from other countries? Whisper has solved these inconvenient connections for you, join Whisper to have the best online social connection, and have voice chat with new friends freely.\\n\\nDear friends, you can follow us by following official pages: \\nFacebook: https://www.facebook.com/Whisper-03177-108024924700488\\n\\nIf you have any suggestions or feedback, please feel free to contact us at: whisperfeedback@gmail.com\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://whisper.cc/app-ads.txt\",\"versionHistory\":[{\"versionDisplay\":\"1.5.701\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-03-29\",\"releaseTimestamp\":\"2023-03-29T02:37:32Z\"},{\"versionDisplay\":\"1.5.700\",\"releaseNotes\":\"1. Added Ramadan app appearance.\\n2. Added Queen for girl aristocracy, if you are a girl, the King level of aristocracy will be shown as Queen, and the design is totally different from King.\\n3. Optimized user experience.\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T10:40:54Z\"},{\"versionDisplay\":\"1.5.600\",\"releaseNotes\":\"1. Optimized the experience in the room, you can open user profile cards  and online lists more quickly.\\n2. You can wear Ludo-related decorations in \\\"My Decorations\\\".\",\"releaseDate\":\"2023-03-14\",\"releaseTimestamp\":\"2023-03-14T09:51:43Z\"},{\"versionDisplay\":\"1.5.501\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-03-06\",\"releaseTimestamp\":\"2023-03-06T15:23:28Z\"},{\"versionDisplay\":\"1.5.500\",\"releaseNotes\":\"1. Pass system updated\\n2. New design of \\\"Me\\\" page\",\"releaseDate\":\"2023-02-26\",\"releaseTimestamp\":\"2023-02-26T12:25:36Z\"},{\"versionDisplay\":\"1.5.460\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-02-23\",\"releaseTimestamp\":\"2023-02-23T01:36:58Z\"},{\"versionDisplay\":\"1.5.450\",\"releaseNotes\":\"1. Optimized music uploading, you can coordinate the music list and batch delete\\n2. Optimized ban chat\\n3. Other experience optimizations\",\"releaseDate\":\"2023-02-17\",\"releaseTimestamp\":\"2023-02-17T17:18:49Z\"},{\"versionDisplay\":\"1.5.400\",\"releaseNotes\":\"1. Optimized music uploading, you can coordinate the music list and batch delete\\n2. Optimized ban chat\\n3. Other experience optimizations\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T02:17:46Z\"},{\"versionDisplay\":\"1.5.301\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2023-01-11\",\"releaseTimestamp\":\"2023-01-11T11:11:24Z\"},{\"versionDisplay\":\"1.5.300\",\"releaseNotes\":\"Improved user experience\",\"releaseDate\":\"2022-12-28\",\"releaseTimestamp\":\"2022-12-28T01:47:38Z\"},{\"versionDisplay\":\"1.5.202\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-12-08\",\"releaseTimestamp\":\"2022-12-08T02:01:49Z\"},{\"versionDisplay\":\"1.5.201\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-11-30\",\"releaseTimestamp\":\"2022-11-30T12:35:47Z\"},{\"versionDisplay\":\"1.5.200\",\"releaseNotes\":\"Fix some bugs\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T16:45:40Z\"},{\"versionDisplay\":\"1.5.101\",\"releaseNotes\":\"1. Added blocking function, you can block other users, moments and hashtags for yourself\\n2. Activity subscription feature is back\\n3. User level privileges updated\",\"releaseDate\":\"2022-11-11\",\"releaseTimestamp\":\"2022-11-11T11:14:39Z\"},{\"versionDisplay\":\"1.5.100\",\"releaseNotes\":\"1. Added blocking function, you can block other users, moments and hashtags for yourself\\n2. Activity subscription feature is back\\n3. User level privileges updated\",\"releaseDate\":\"2022-11-10\",\"releaseTimestamp\":\"2022-11-10T14:00:46Z\"},{\"versionDisplay\":\"1.5.001\",\"releaseNotes\":\"Fix some bugs\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T10:11:57Z\"},{\"versionDisplay\":\"1.5.000\",\"releaseNotes\":\"1. Added voting in the room.\\n2. Room owner can check room operation records in the room.\\n3. Weekly rewards system for the tribes.\",\"releaseDate\":\"2022-10-17\",\"releaseTimestamp\":\"2022-10-17T01:36:30Z\"},{\"versionDisplay\":\"1.4.900\",\"releaseNotes\":\"Added feature of \\\"Tribe\\\", you can create or join a tribe.\",\"releaseDate\":\"2022-09-14\",\"releaseTimestamp\":\"2022-09-14T02:17:01Z\"},{\"versionDisplay\":\"1.4.800\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-08-17\",\"releaseTimestamp\":\"2022-08-17T01:48:04Z\"},{\"versionDisplay\":\"1.4.700\",\"releaseNotes\":\"Added dark mode, you can set it in \\\" Settings - Appearance\\\".\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T09:54:02Z\"},{\"versionDisplay\":\"1.4.64\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-07-08\",\"releaseTimestamp\":\"2022-07-08T03:41:55Z\"},{\"versionDisplay\":\"1.4.63\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-07-07\",\"releaseTimestamp\":\"2022-07-07T10:10:30Z\"},{\"versionDisplay\":\"1.4.62\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-07-06\",\"releaseTimestamp\":\"2022-07-06T08:21:20Z\"},{\"versionDisplay\":\"1.4.61\",\"releaseNotes\":\"Bugs fixed to improve user experience\",\"releaseDate\":\"2022-06-29\",\"releaseTimestamp\":\"2022-06-29T09:38:51Z\"},{\"versionDisplay\":\"1.4.60\",\"releaseNotes\":\"1. Room level online\\n2. Voting of moments\\n3. Improved user experience\",\"releaseDate\":\"2022-06-24\",\"releaseTimestamp\":\"2022-06-24T03:21:55Z\"}],\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514418573\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855847148\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":291584000}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514418573\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855847148\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":291584000}]}],\"requires32bit\":false,\"releaseDate\":\"2020-06-06\",\"hasInAppPurchases\":true,\"bundleId\":\"com.chatvoice.whisper\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple116/v4/e4/01/99/e40199ac-7f75-4fd9-36d1-7ff284e6ed3e/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"002303\",\"textColor1\":\"fcc44f\",\"textColor2\":\"f9be2a\",\"textColor3\":\"caa340\",\"textColor4\":\"c79f22\"},\"privacyPolicyUrl\":\"http://www.whisper.cc/privacy.html\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"supportURLForLanguage\":\"http://www.whisper.cc/\",\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Features124/v4/e