\":1334,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/f4/9d/e6/f49de632-b352-5425-f04e-9609fa4e1ccb/1f3f9cad-c6a8-497f-b507-f9cc9131d4c4_4.7-6-_U82f1_U8bed_U5907_U4efd.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0e1014\",\"textColor2\":\"28292b\",\"textColor3\":\"3e3f43\",\"textColor4\":\"535455\"},{\"width\":750,\"height\":1334,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/07/81/0f/07810f59-29ee-74db-931e-43cc36196a8c/82327f0f-d960-4b19-8649-2577dbfd3d77_4.7-7-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"f4fefa\",\"textColor1\":\"0d0f12\",\"textColor2\":\"2b2d2f\",\"textColor3\":\"3b3f40\",\"textColor4\":\"535758\"},{\"width\":750,\"height\":1334,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/14/13/7e/14137ef5-964e-ff4b-226b-e7926cb7b89e/af099c84-e26e-4f11-b249-63bf5824460d_4.7-8-_U82f1_U8bed_U5907_U4efd.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"eefdf8\",\"textColor1\":\"000000\",\"textColor2\":\"0d0f12\",\"textColor3\":\"2f3231\",\"textColor4\":\"3a3e40\"}],\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/3b/a5/22/3ba522e7-cde8-1c53-b777-4335d64902d8/f1e78a85-c530-45aa-a79a-3f0f1d91814c_5.5_U5bf8-1-_U82f1_U6587.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0e0b09\",\"textColor2\":\"131210\",\"textColor3\":\"3e3c3a\",\"textColor4\":\"42413f\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple116/v4/17/60/ef/1760ef5b-406a-87e3-07a7-b86e6e4f93f4/4ae1d3f8-01cd-4721-a497-eabf5dbed4eb_5.5_U5bf8-2-_U82f1_U8bed.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"0a0b0c\",\"textColor2\":\"0d0f12\",\"textColor3\":\"3b3c3d\",\"textColor4\":\"3e3f41\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple116/v4/07/8a/d0/078ad02c-ea30-bf09-f048-49cdd2d4a8d7/d98e06d9-31e2-4594-b7fc-1d54ec2dfd7b_5.5_U5bf8-3-_U82f1_U8bed.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"f