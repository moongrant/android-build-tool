2070400,\"iPad13,6\":49588224,\"iPad2,1\":52070400,\"iPad13,7\":49588224,\"iPad13,1\":49588224,\"iPad13,2\":49588224}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/de/apps/1488887716/genres?l=de-DE\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6016?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Unterhaltung\",\"url\":\"https://itunes.apple.com/de/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6005?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Soziale Netze\",\"url\":\"https://itunes.apple.com/de/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/de/apps/1488887716/developer?l=de-DE\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/de/developers/1444567250?l=de-DE\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/de/developer/yalla-technology-fz-llc/id1444567250\"}}]}}},{\"id\":\"1542713951\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1542713951?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Mit dir verknüpfte Daten\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise erfasst und mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Benutzer­inhalte\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Selten/schwach ausgeprägt: Szenen mit erotischen Anspielungen\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/yalla-parch%C3%ADs-parch%C3%ADs-bingo/id1542713951\",\"userRating\":{\"value\":3,\"ratingCount\":1,\"ratingCountList\":[0,0,1,0,0],\"ariaLabelForRatings\":\"3.0 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0.4\",\"genreDisplayName\":\"Brettspiele\",\"name\":\"Yalla Parchís - Parchís\u0026Bingo\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Erfordert iPadOS 11.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Yalla Parchís es una app con la que puedes chatear por voz con tus amigos mientras juegas.\\n\\nChat de Voz en Tiempo Real\\nChat de voz con otros jugadores en cualquier momento y lugar. Conoce a amigos nuevos y disfruta del juego.\\n\\nModos de Juego Variados\\nYalla Parchís incluye 2 modos: 1VS1, 4 Jugadores. Cada modo tiene dos variaciones: Clásico y Español.\\n\\nFácil de jugar con tus amigos\\nPuedes jugar con tus amigos en equipo y en salas privadas. ¡Juguemos!\\n\\nHaremos todo lo posible para proporcionarte juegos más interesantes, que enriquezcan tu vida cotidiana. \"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"1.Se añadió la nueva función \\\"Alcancía\\\". Puede depositar diamantes con jugar Parchís y Bingo en la Alcancía. Cuando está llenada, puede abrirlo y ganar un montón de diamantes.\\n2.Se mejoró la función de \\\"Fusión de Fragmentos\\\". Ya puede usar piezas de diseños bloqueos para fusinar.\\n3.Se añadió la nueva función \\\"Verdad o Reto\\\" en Salas de Chat. No dude en intentarlo con sus amigos.\",\"releaseDate\":\"2023-03-30\",\"releaseTimestamp\":\"2023-03-30T07:00:59Z\"},{\"versionDisplay\":\"1.1.4.1\",\"releaseNotes\":\"1.Se añadió la nueva regla Mágico en Parchís, ¡es una regla más rápida y divertida!\\n2.Se añadió la Fusión de Fragmentos de diseños. \\n3.Se añadió el ranking de Show de Luces en salas de chat.\",\"releaseDate\":\"2023-02-08\",\"releaseTimestamp\":\"2023-02-08T01:30:01Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"1.Se añadió la nueva regla Mágico en Parchís, ¡es una regla más rápida y divertida!\\r\\n2.Se añadió la Fusión de Fragmentos de diseños. \\r\\n3.Se añadió el ranking de Show de Luces en salas de chat.\",\"releaseDate\":\"2023-01-18\",\"releaseTimestamp\":\"2023-01-18T14:37:19Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"¡Bienvenidos a Yalla Parchís! he aquí los contenidos de actualización:\\r\\n1.Privilegios VIP3: ¡Hazte VIP3 para desbloquear beneficios exclusivos como una ganancia de EXP más rápida, comentarios con efectos especiales y mucho más!\\r\\n2.Juego en Salas VIP: Ahora puedes jugar Parchís en Salas VIP sin 'deshacer' ni 'bloquear'.\\r\\n3.Emoticonos del chat: Ahora puedes elegir y enviar varios emoticones dinámicos en las salas de chat.\",\"releaseDate\":\"2022-11-15\",\"releaseTimestamp\":\"2022-11-15T01:19:50Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"¡Bienvenidos a Yalla Parchís! he aquí los contenidos de actualización:\\r\\n1.Se ajustó la interfaz de Colección de Diseño y se añadieron nuevos diseños de Bingo.\\r\\n2.Se añadió la sala VIP de Bingo, puedes chatear con tus amigos mientras juegas a Bingo.\\r\\n3.Se añadió una nueva función - Show de Luces en salas de chat.\",\"releaseDate\":\"2022-09-28\",\"releaseTimestamp\":\"2022-09-28T03:24:55Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"¡Bienvenidos a Yalla Parchís! he aquí los contenidos de actualización:\\n1.Se añadió VIP3. Suscribes VIP3 para disfrutar de más privilegios.\\n2.Se añadió el nuevo juego ´Termómetro´ en Sala de Chat.\\n3.Se añadió la Mochila en Sala de Chat, donde puedes guardar regalos, accesorios etc.\\n4.Se añadió el ´Vehículo de Lujo´ en Sala de Chat. Úsalo para entrar en la sala de chat con efectos especiales más deslumbrantes.\",\"releaseDate\":\"2022-08-22\",\"releaseTimestamp\":\"2022-08-22T11:30:04Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1.Juego de Bingo - Te ofrecerá una experiencia diferente con partida rápida. Puedes acceder al juego de Bingo a través de hacer clic en [el icono de Bingo] en [Batalla].\\r\\n2.Club de Miembros - Conviértete en un miembro de un club de sala con tus amigos para divertirte mejor.\\r\\n3.Tema de Sala - Se añadió una nueva función \\\"Tema de Sala\\\" en Salas de Chat.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T22:14:46Z\"},{\"versionDisplay\":\"1.0.8.1\",\"releaseNotes\":\"1. Se añadieron más privilegios en VIP. \\r\\n2. Se añadió el sistema de medallas y se mejoró la información personal.\\r\\n3. Las salas de chat se han mejorado con: chat privado 1-1, se puede invitar a otros usuarios a su sala y nuevos emojis al tomar asiento en la sala.\\r\\n4. Se mejoraron las experiencias de juego y se corrigieron los errores.\",\"releaseDate\":\"2022-05-30\",\"releaseTimestamp\":\"2022-05-30T23:39:00Z\"},{\"versionDisplay\":\"1.0.7.1\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. Las actualizaciones son:\\n1. Se añadió la función de enviar accesorios como espectadores en las partidas. Tienes más formas de interactuar con otros.\\n2. Se añadió chat privado. Puedes enviar mensajes privados a otros.\\n3. Se añadieron funciones de música y minijuegos en Salas de Chat. Puedes escuchar música y jugar chateando para divertirte.\\n4. Se añadieron Ranking de Sala, de Regalos enviados y de Regalos recibidos. \",\"releaseDate\":\"2022-04-12\",\"releaseTimestamp\":\"2022-04-12T01:25:53Z\"},{\"versionDisplay\":\"1.0.7\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. Las actualizaciones son:\\n1. Se añadió la función de enviar accesorios como espectadores en las partidas. Tienes más formas de interactuar con otros.\\n2. Se añadió chat privado. Puedes enviar mensajes privados a otros.\\n3. Se añadieron funciones de música y minijuegos en Salas de Chat. Puedes escuchar música y jugar chateando para divertirte.\\n4. Se añadieron Ranking de Sala, de Regalos enviados y de Regalos recibidos. \",\"releaseDate\":\"2022-04-04\",\"releaseTimestamp\":\"2022-04-04T15:53:51Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Bienvenido a Yalla Parchís. Las actualizaciones son:\\n1.Se lanzó de Nuevo modo de juego - Rápido. ¡Ven a experimentar este modo totalmente nuevo y diferente! \\n2.Ahora los invitados también pueden acceder a las salas de chat.\\n3.Se añadieron los Rankings de Estrella Semanal de Regalos y Contribución de 7 días a las salas de chat, podrás obtener abundantes recompensas de diamantes/títulos honorarios por estar en la lista. ¡Ven y únete! \\n4.Se corrigieron errores.\",\"releaseDate\":\"2022-01-25\",\"releaseTimestamp\":\"2022-01-25T01:24:55Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión realizamos las siguientes actualizaciones :\\r\\n1. ¡La versión nueva de Yalla Parchís llega con la tan esperada Fiestas en salas de chat! En ella encontraras funciones como chat de voz, chat de vídeo y muchas sorpresas más. La entrada se encuentra en [Eventos]-[Fiestas en salas de chat], ¡ve a divertirte con tus amigos!\\r\\n2. Se corrigieron algunos errores.\",\"releaseDate\":\"2021-12-02\",\"releaseTimestamp\":\"2021-12-02T14:59:35Z\"},{\"versionDisplay\":\"1.0.4.1\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión, las actualizaciones son:\\r\\n1.Se añadió la función de VIP. ¡Conviértete en VIP para obtener más previlegios! .\\r\\n2.Se actualizó Suscripción de Diseño a VIP 1.\\r\\n3.Se añadieron Salas VIP. ¡Ve a divertirte con tus amigos de VIP 2!\\r\\n4.¡Se puede compartir tu Ranking y Liga! Tendrás más maneras de compartir los contenidos.\\r\\n5.Se corrigieron algunos errores.\",\"releaseDate\":\"2021-10-26\",\"releaseTimestamp\":\"2021-10-26T01:09:34Z\"},{\"versionDisplay\":\"1.0.3.1\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión, las actualizaciones son:\\r\\n1.Se añadió la función de Pase de Evento.\\r\\n2.Tendrá el privilegio de Hacer cola de Cofres de Tesoro si compra el Pase de Evento.\\r\\n3.Se añadió la función de enviar accesorios interactivos durante la partida.\\r\\n4.Se añadió la función de \\\"Me Gusta\\\".\\r\\n5.Se añadieron nuevas funciones de Info Básica.\\r\\n6.Se corrigieron errores.\",\"releaseDate\":\"2021-08-10\",\"releaseTimestamp\":\"2021-08-10T01:05:31Z\"},{\"versionDisplay\":\"1.0.2.2\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión, las actualizaciones son:\\r\\n1. Se realizó el mejoramiento en iPhone X y modelos anteriores.\\r\\n2. Se corrigieron errores.\",\"releaseDate\":\"2021-06-21\",\"releaseTimestamp\":\"2021-06-21T23:15:55Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión, las actualizaciones son:\\n1. Se añadió la Suscripción de Diseño: con la suscripción se puede utilizar más diseños inmediatamente.\\n2. Se añadió el Tutorial para los usuarios nuevos. \\n3. Se añadió el premio semanal para cofres de tesoro.\\n4. Se añadió el Ranking de Estrellas de Leyenda.\\n5. Se añadió la nueva forma de comentario para los espectadores.\\n6. Se corrigieron errores.\",\"releaseDate\":\"2021-05-24\",\"releaseTimestamp\":\"2021-05-24T22:35:32Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"Bienvenidos a Yalla Parchís, en esta nueva versión, las actualizaciones son:\\r\\n1. Se añadió la Liga con premios de diamantes.\\r\\n2. Se añadieron Ranking Global y Ranking de Amigos. \\r\\n3. Se añadió el correo. \\r\\n4. Se añadió la función de recargar durante la partida.\\r\\n5. Se añadió la función de notificaciones push.\\r\\n6. Se añadieron más marcos de perfil.\\r\\n7. Se corrigieron errores.\",\"releaseDate\":\"2021-03-22\",\"releaseTimestamp\":\"2021-03-22T23:07:56Z\"},{\"versionDisplay\":\"1.0.0.4\",\"releaseNotes\":null,\"releaseDate\":\"2021-02-02\",\"releaseTimestamp\":\"2021-02-02T19:47:37Z\"}],\"websiteUrl\":\"https://www.yallaparchis.com/\",\"editorialNotes\":{\"tagline\":\"Miteinander spielen und reden\"},\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855496029\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276745216}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1542713951\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855496029\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":276745216}]}],\"requires32bit\":false,\"releaseDate\":\"2021-02-02\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallaparchisi\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple126/v4/79/64/db/7964db3d-7c7d-57ec-0130-b42702f8210b/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"592e81\",\"textColor1\":\"ebeff7\",\"textColor2\":\"f4b62c\",\"textColor3\":\"cec8e0\",\"textColor4\":\"d59b3d\"},\"privacyPolicyUrl\":\"https://www.yallaparchis.com/term/EN/TermOfService.html\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://www.yallaparchis.com/\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is5-ssl.mzstat