:274848768,\"iPhone8,2\":274848768,\"iPad14,4-B\":264484864,\"iPhone11,8\":274848768,\"iPad14,4-A\":264484864,\"iPhone15,3\":264480768,\"iPad5,4\":274852864,\"iPad5,3\":274852864,\"iPad13,10\":264484864,\"iPad5,2\":274852864,\"iPad5,1\":274852864,\"iPad6,11\":274852864,\"iPad6,12\":274852864,\"MacFamily20,1\":264484864,\"iPad12,1\":264480768,\"iPad12,2\":264480768,\"iPhone10,3\":274848768,\"iPhone10,2\":274848768,\"iPhone10,1\":274762752,\"iPhone14,3\":264480768,\"iPhone10,6\":274848768,\"iPhone14,2\":264480768,\"iPhone7,2\":274762752,\"iPhone10,5\":274848768,\"iPhone10,4\":274762752,\"iPhone7,1\":274848768,\"iPad13,19\":264480768,\"iPad14,5-A\":264484864,\"iPhone14,7\":264480768,\"iPad14,5-B\":264484864,\"iPhone14,6\":264390656,\"iPad13,11\":264484864,\"iPhone14,5\":264480768,\"iPhone14,4\":264480768,\"iPad13,17\":264484864,\"iPad13,18\":264480768,\"universal\":276745216,\"iPod9,1\":266445824,\"iPad13,16\":264484864,\"iPhone14,8\":264480768,\"iPad6,7\":274852864,\"iPad6,4\":274852864,\"iPad6,3\":274852864,\"iPad6,8\":274852864,\"iPad13,8\":264484864,\"iPad13,9\":264484864,\"iPad13,4\":264484864,\"iPad13,5\":264484864,\"iPad13,6\":264484864,\"iPad13,7\":264484864,\"iPad13,1\":264484864,\"iPad13,2\":264484864}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/de/apps/1542713951/genres?l=de-DE\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6014?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Spiele\",\"url\":\"https://itunes.apple.com/de/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6005?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Soziale Netze\",\"url\":\"https://itunes.apple.com/de/genre/id6005\",\"parentId\":\"36\"}},{\"id\":\"7009\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/7009?l=de-DE\",\"attributes\":{\"parentName\":\"Spiele\",\"name\":\"Familie\",\"parentId\":\"6014\",\"url\":\"https://itunes.apple.com/de/genre/id7009\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/7004?l=de-DE\",\"attributes\":{\"parentName\":\"Spiele\",\"name\":\"Brettspiele\",\"url\":\"https://itunes.apple.com/de/genre/id7004\",\"parentId\":\"6014\"}}]},\"developer\":{\"href\":\"/v1/catalog/de/apps/1542713951/developer?l=de-DE\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/de/developers/1444567250?l=de-DE\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/de/developer/yalla-technology-fz-llc/id1444567250\"}}]}}},{\"id\":\"1513504421\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1513504421?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Mit dir verknüpfte Daten\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise erfasst und mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Benutzer­inhalte\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"9+\",\"value\":200,\"rank\":2,\"advisories\":[\"Selten/schwach ausgeprägt: Zeichentrick- oder Fantasy-Gewalt\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/%D9%8A%D9%84%D8%A7-%D8%A8%D9%84%D9%88%D8%AA-%D9%88%D9%87%D8%A7%D9%86%D8%AF/id1513504421\",\"userRating\":{\"value\":3,\"ratingCount\":2,\"ratingCountList\":[1,0,0,0,1],\"ariaLabelForRatings\":\"3.0 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.5.0\",\"name\":\"يلا بلوت وهاند\",\"genreDisplayName\":\"Karten\",\"isPreorder\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Erfordert iPadOS 11.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Erfordert macOS 11.0 (oder neuer) und einen Mac mit Apple M1-Chip (oder neuer).\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"هل تشتاقون إلى أيام لعب البلوت مع أصدقائكم؟ مهما كانت المسافة بينكم، يمكنكم الأن تلعبون مع بعض على تطبيق يلا بلوت وهاند!\\r\\n\\r\\nيلا بلوت وهاند هي لعبة خفيفة على الإنترنت. يمكنك مقابلة الكثير من الأصدقاء، أو يمكنك دعوة الأصدقاء للعب الألعاب معًا.\\r\\n\\r\\nالميزات:\\r\\n\\r\\nالبلوت الكلاسيكي\\r\\nلعبة بلوت كلاسيكية على الإنترنت مع أجواء لعب حقيقية. الدردشة الصوتية في اللعبة تجعل المنافسة أكثر إثارة وتشويقا.\\r\\n\\r\\nمجموعة متنوعة من ألعاب هاند\\r\\nالعب ألعاب الهاند عبر الإنترنت مع الأصدقاء والتي تحاكي ظروف الحياة الواقعية. تتضمن هذه اللعبة هاند وهاند سعودي.\\r\\n\\r\\nمباراة الدوري\\r\\nالعب مع لاعبين رفيعي المستوى وأظهر مهاراتك الاستثنائية في اللعب. اكسب مجموعة متنوعة من المكافآت وتنافس لتكون بطلاً!\\r\\n\\r\\nالغرفة العامة\\r\\nقم بإنشاء غرفتك الخاصة، وقم بتخصيص قواعد الغرفة واستمتع بالعب مع الأصدقاء.\\r\\n\\r\\nأغلفة رائعة\\r\\nمجموعة متنوعة من الأغلفة المصممة خصيصا لك. يمكنك اختيار الورق والموضوع واستخدامهما في اللعبة.\\r\\n\\r\\nعناصر اجتماعية غنية\\r\\nتوفر لك الدردشة العالمية الحيوية والدردشة الشخصية الخاصة خيارات متعددة للتواصل مع أصدقائك.\\r\\n\\r\\nسنبذل قصارى جهدنا لتحسين تجربة اللعب، و توفير لك المتعة والإثارة، لنجعل حياتك مليئة بالبهجة.\\r\\n\\r\\nإذا كان لديك أي اقتراحات أو شكاوى ، يرجى التواصل مع فريق الدعم balootsupport@yalla.live\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"1. شارات الإنجاز - حقق إنجازات لتلقي الشارات واعرض مجموعتك من خلال ارتدائها!\\r\\n2. تحديث غرفة الدردشة - تمت إضافة ميزة نادي الأعضاء. انضم إلى أصدقائك واجعل غرفتك الأكثر شعبية! \\r\\n3. تحسين الأداء - استمتع بتجربة لعب أكثر سلاسة!\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T02:07:46Z\"},{\"versionDisplay\":\"1.5.1.1\",\"releaseNotes\":\"1. تحسين الأداء - استمتع بتجربة لعب أكثر سلاسة!\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T14:10:03Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"1. التحدي - تمت إضافة مباراتين من مستويات مختلفة إلى التحدي، مما يمنح المستخدمين ألعابًا أكثر إثارة للاستمتاع بها!\\r\\n2. تحسين الواجهة - تم تحسين الأزرار الموجودة على الواجهة الرئيسية لتحسين تجربة المستخدم!\\r\\n3. تحسين الأداء - استمتع بتجربة لعب أكثر سلاسة!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T10:10:56Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"1. غرف الدردشة - جرب غرف الدردشة المضافة حديثًا! قم بإنشاء غرفتك الخاصة أو انضم إلى غرفة عامة وكون صداقات جديدة!\\r\\n2. دردشة عالمية محدثة - استمتع بدردشة عالمية أكثر سلاسة مع إشعارات الرسائل المضافة حديثًا!\\r\\n3. تحسين الأداء - استمتع بتجربة لعب أكثر سلاسة!\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T09:49:38Z\"},{\"versionDisplay\":\"1.4.9.11\",\"releaseNotes\":\"1. تحسين الأداء - استمتع بتجربة أفضل وأكثر سلاسة.\",\"releaseDate\":\"2022-11-25\",\"releaseTimestamp\":\"2022-11-25T01:50:12Z\"},{\"versionDisplay\":\"1.4.9.10\",\"releaseNotes\":\"1. قواعد جديدة للعبة - استمتع بلعبة بلوت الأكثر أصالة مع قواعد \\\"قيد\\\" المضافة حديثًا في الغرفة العامة!\\r\\n2. فقاعات الدردشة - اعرض مجموعة الفقاعات الخاصة بك باستخدام فقاعات الدردشة المخصصة!\\r\\n3. تحسين الأداء - استمتع بتجربة أفضل وأكثر سلاسة.\",\"releaseDate\":\"2022-11-07\",\"releaseTimestamp\":\"2022-11-07T09:05:56Z\"},{\"versionDisplay\":\"1.4.9.9\",\"releaseNotes\":\"1. قواعد جديدة للعبة بلوت - استمتع بأصالة لا مثيل لها في لعبة بلوت مع قواعد \\\"كاشو\\\"! \\r\\n2. الغرفة العامة - قم بإنشاء غرف خاصة أو عامة في  لعبة \\\"هاند\\\" أو انضم إلى غرف المستخدمين الآخرين عن طريق \\\"الغرفة العامة\\\"!\\r\\n3. ميزة إشعار التحدي - لا تفوت اي مباراة التحدي مع التذكيرات الجديدة داخل \\\"العالمي\\\"!\",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T01:46:58Z\"},{\"versionDisplay\":\"1.4.9.8\",\"releaseNotes\":\"1. تحسين الواجهة - استمتع بالواجهة الجديدة في \\\"وضع التحدي\\\"!\\r\\n2. تذكير تسجيل التحدي - استخدم ميزة تذكير التسجيل الجديدة حتى لا تفوتك أي من المكافآت اليومية!\\r\\n3. تحسين الأداء - استمتع بتجربة لعب أكثر سلاسة!\",\"releaseDate\":\"2022-09-01\",\"releaseTimestamp\":\"2022-09-01T01:05:52Z\"},{\"versionDisplay\":\"1.4.9.7\",\"releaseNotes\":\"1. مباراة التحدي الجديدة - استمتع بالمسابقات المثيرة مع الكثير من المكافآت. تنافس لتصبح البطل!\\n2. تحسین المطابقة السريعة - استمتع بمباريات بلوت سريعة واختار المراحل المهارية المختلفة بناءً على خبرتك الخاصة!\\n3. نظام التصنيف الجديد - العب المباريات لتكون على قائمة الترتيب واربح إطارات الملف الشخصي الحصرية!\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T10:55:25Z\"},{\"versionDisplay\":\"1.4.9.6\",\"releaseNotes\":\"1.قم بالترقية إلى الوضع السريع في تصفيات البطولة، مع المزيد من الفرص لتصبح البطل كل يوم!\\r\\n2.تحسين جودة الصوت والتحسينات الشاملة. دخول التطبيق في ثوانٍ وبداية لعبة سريعًا!\",\"releaseDate\":\"2022-06-25\",\"releaseTimestamp\":\"2022-06-25T08:51:38Z\"},{\"versionDisplay\":\"1.4.9.5.1\",\"releaseNotes\":\"1. كوّن فريقًا مع الأصدقاء للانضمام إلى البطولة التنافسية الجديدة.\\r\\n2. تم تحسين الغرف العامة لدعم العديد من المشاهدين.\\r\\n3. تحسين جودة الصوت وتحسينات عامة.\",\"releaseDate\":\"2022-06-06\",\"releaseTimestamp\":\"2022-06-06T12:34:09Z\"},{\"versionDisplay\":\"1.4.9.4\",\"releaseNotes\":\"1. تمت إضافة ترتيب النجم الجديد. يمكنك أن تكون في القمة حتى كلاعب جديد!\\r\\n2. اربط حسابك الآن لتحصل على VIP!\\r\\n3. تمت إضافة إعلان بعد الترقية إلى الماستر وما فوق. \\r\\n4. تحسين جودة الصوت وتحسينات عامة.\",\"releaseDate\":\"2022-04-20\",\"releaseTimestamp\":\"2022-04-20T02:05:26Z\"},{\"versionDisplay\":\"1.4.9.3\",\"releaseNotes\":\"1- غرفة عامة جديدة تماماً. يمكنك استخدام الذهب الآن للعب الألعاب.\\n2- تحسينات عامة على التطبيق وجودة الصوت.\\n3- تحسين تجربة المستخدم وإضافة تأكيد عند تبديل الذهب في المتجر.\",\"releaseDate\":\"2022-03-21\",\"releaseTimestamp\":\"2022-03-21T14:27:05Z\"},{\"versionDisplay\":\"1.4.9.2\",\"releaseNotes\":\"1. تم إضافة الدردشة العالمية: بإمكانك الآن الدردشة مع أصدقاء أكثر؛\\r\\n2. بإمكانك الآن الحصول على صندوق الفوز المتتالي مباشرة بعد فوزك في المطابقة السريعة ؛\\r\\n3. غرفة عامة مجانية لجميع اللاعبين: بإمكانك الآن إنشاء أو الإنضمام لأي غرفة للعب مع الأصدقاء؛\\r\\n4. تحسين شامل للعبة؛\\r\\n5. إصلاحات الأعطال.\\r\\n\",\"releaseDate\":\"2022-03-08\",\"releaseTimestamp\":\"2022-03-08T01:46:12Z\"},{\"versionDisplay\":\"1.4.9.1\",\"releaseNotes\":\"تم إصلاح بعض الأعطال بسبب ملاحظات المستخدمين وتم تحسين جودة الدردشة الصوتية.\",\"releaseDate\":\"2022-02-09\",\"releaseTimestamp\":\"2022-02-09T00:47:18Z\"},{\"versionDisplay\":\"1.4.9\",\"releaseNotes\":\"فريق يلا بلوت يدعوكم بصدق لتجربة أول نسخة لعام 2022 من بلوت.\\n1.تم إضافة لعبة الهاند. مجموعة متنوعة من ألعاب الهاند للاعبين 2 و 4لاعبين؛\\n2.يمكن للمستخدمين تبادل إرسال الأدوات السحرية في اللعبة؛\\n3.تم إضافة صناديق الفوز المتتالي في الوضع الودي. كلما ربحت أكثر، كلما حصلت على مكافآت أفضل؛\\n4.تحسين شامل للعبة؛\\n5.إصلاحات الأعطال.\\nشكرا لصبرك في قراءة هذا المحتوى .نراكم في الإصدار القادم.\",\"releaseDate\":\"2022-01-28\",\"releaseTimestamp\":\"2022-01-28T13:56:23Z\"},{\"versionDisplay\":\"1.4.8.1\",\"releaseNotes\":\"1.تصميم واجهة مستخدم جديد تماما، وتجربة لعب أفضل؛\\n2.التحسين الشامل للعبة؛\\n3.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-12-11\",\"releaseTimestamp\":\"2021-12-11T10:25:37Z\"},{\"versionDisplay\":\"1.4.8\",\"releaseNotes\":\"\\r\\n1.تم إضافة بطاقة مرور الجدد. يمكنك الحصول على مكافآت وفيرة من خلال لعب الألعاب، بما في ذلك قطع الذهب والماس والأغلفة وVIP؛\\r\\n2.تم إضافة مكافأة المستوى بشارات مستوى جديدة تمامًا. يمكنك التحقق من ذلك على صفحة الأحداث؛\\r\\n3.تم إضافة مشاهدة الأصدقاء؛\\r\\n4.تم إضافة فقاعات الدردشة؛\\r\\n5. التحسين الشامل للعبة؛\\r\\n6.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-10-01\",\"releaseTimestamp\":\"2021-10-01T00:46:55Z\"},{\"versionDisplay\":\"1.4.7\",\"releaseNotes\":\"1.الدوري الجديد كليًا: تم تغيير قواعد المشاركة، وتم إضافة المزيد من مرات التحدي المجانية والمزيد من المكافآت؛\\n2.أغلفة رائعة: مجموعة متنوعة من الأغلفة المصممة خصيصا لك. يمكنك اختيار ورقتك وموضوعك المفضل واستخدامها في اللعبة؛\\n3.ترقية الترتيب: تم إضافة ترتيب نجم اللعبة ومكافأة إطار الملف الشخصي بوقت محدود؛\\n4.التحسين العام للعبة: الحصول على تجربة لعب أكثر سلاسة؛\\n5.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-08-09\",\"releaseTimestamp\":\"2021-08-09T14:25:07Z\"},{\"versionDisplay\":\"1.4.6\",\"releaseNotes\":\"المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-06-21\",\"releaseTimestamp\":\"2021-06-21T09:02:26Z\"},{\"versionDisplay\":\"1.4.5\",\"releaseNotes\":\"\\r\\n1.التحسين العام للعبة :الحصول على تجربة لعب أكثر سلاسة .\\n\\n2.الدردشة العالمية :قم بالدردشة مع جميع الأشخاص وأدعوهم للعب معًا.\\r\\n3.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-05-31\",\"releaseTimestamp\":\"2021-05-31T03:58:21Z\"},{\"versionDisplay\":\"1.4.4\",\"releaseNotes\":\"1.تحسين موارد الصور\\n2.المزيد من الإصلاحات للأعطال. \",\"releaseDate\":\"2021-04-11\",\"releaseTimestamp\":\"2021-04-11T12:57:29Z\"},{\"versionDisplay\":\"1.4.3\",\"releaseNotes\":\"المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-04-10\",\"releaseTimestamp\":\"2021-04-10T03:34:35Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"1.المكافأة اليومية: قم بتسجيل الدخول لتحصل على مكافآت إضافية؛ \\n2.إضافة الزينة الرمضانية؛\\n3.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-03-31\",\"releaseTimestamp\":\"2021-03-31T10:30:47Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"1.مكافأة تسجيل الدخول لمدة 7 أيام :قم بتسجيل الدخول للحصول على مكافآت إضافية .\\n2.تدريبات جديدة :تعلم قواعد بلوت في التدريب.\\n3.نمط الشاشة :قم باختيار شاشة أفقية أو شاشة عمودية في الإعدادات.\\n4.المزيد من الإصلاحات للأعطال.\",\"releaseDate\":\"2021-02-05\",\"releaseTimestamp\":\"2021-02-05T23:11:04Z\"}],\"websiteUrl\":\"https://www.yallabaloot.com/\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855524873\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":287458304}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1513504421\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855524873\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":287458304}]}],\"requires32bit\":false,\"releaseDate\":\"2020-08-07\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.yallabaloot\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple116/v4/e3/ff/83/e3ff834e-2425-7adf-a741-76e19ea8a9ea/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"38c01a\",\"textColor1\":\"061a01\",\"textColor2\":\"042700\",\"textColor3\":\"103b06\",\"textColor4\":\"0e4505\"},\"privacyPolicyUrl\":\"https://h5.yallabaloot.com/privacy_baloot/TermOfService2.html?index=0\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.yallabaloot.com/\",\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"bannerUber\":{\"width\":4320,\"height\":1080,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Features112/v4/4e/4d/f5/4e4df550-9c55-2fc9-2d53-2474e7512256/6d92734e-6dd9-4a6b-b027-85c88e95075c.png/{w}x{h}sr.{f}\",\"bgColor