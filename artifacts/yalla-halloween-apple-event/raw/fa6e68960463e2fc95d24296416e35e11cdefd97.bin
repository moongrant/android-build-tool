ountList\":[6,1,3,3,39],\"ariaLabelForRatings\":\"4.3 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"3.10\",\"name\":\"StarChat-Group Voice Chat Room\",\"genreDisplayName\":\"Unterhaltung\",\"isPreorder\":false,\"artistName\":\"Guangzhou QiaHaoQingChun Information Technology Co., Ltd.\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 10.3 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 10.3 oder neuer.\",\"devices\":[\"iPhone 5S\",\"iPhone 6\",\"iPhone 6 Plus\",\"iPhone 6s\",\"iPhone 6s Plus\",\"iPhone SE (1. Generation)\",\"iPhone 7\",\"iPhone 7 Plus\",\"iPhone 8\",\"iPhone 8 Plus\",\"iPhone X\",\"iPhone XS\",\"iPhone XS Max\",\"iPhone XR\",\"iPhone 11\",\"iPhone 11 Pro\",\"iPhone 11 Pro Max\",\"iPhone SE (2. Generation)\",\"iPhone 12 mini\",\"iPhone 12\",\"iPhone 12 Pro\",\"iPhone 12 Pro Max\",\"iPhone 13 Pro\",\"iPhone 13 Pro Max\",\"iPhone 13 mini\",\"iPhone 13\",\"iPhone SE (3. Generation)\",\"iPhone 14\",\"iPhone 14 Plus\",\"iPhone 14 Pro\",\"iPhone 14 Pro Max\"]},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Erfordert macOS 11.0 (oder neuer) und einen Mac mit Apple M1-Chip (oder neuer).\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1317217120\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855821724\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":312901632}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1317217120\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855821724\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":312901632}]}],\"minimumMacOSVersion\":\"11.0\",\"requires32bit\":false,\"releaseDate\":\"2017-12-08\",\"hasInAppPurchases\":true,\"bundleId\":\"com.gangbeng.miyou\",\"description\":{\"standard\":\"StarChat provides you a wonderful way to communicate with family, friends, and strangers. TOTALLY FREE! \\nYou just need to create a room and invite your friends, then you can hold an online party anytime anywhere. Not only voice chat, but you can also share your favorite songs and sing karaoke with friends. Online games will make your party more excited.\\n\\n6 Reasons you’ll love the StarChat app:\\n\\n1. NO FEES\\nStarChat is an absolutely free voice chat app! Once your phone connects to the internet (4G/3G/2G or WiFi), you can enjoy a really fluent, high-quality voice chat.\\n\\n2. Available in 40+ Countries\\nIf you are away from family or friends, a voice chat room will make you closer. Wherever you are, using StarChat to keep in touch with friends, then you will never miss big moments! \\n\\n3. Secret Room\\nLock the room and set a password, and only your friends could enter, which will be a wonderfully private place for you.\\n\\n4. Online Party\\nCan’t find a suitable place for the party? StarChat provides you an awesome chance to hold an online party. Birthday, wedding, Eid, or just real-time comments on football games, TV Series, girls’ gossip, any topic is fine. Suitable presents like cake, rose, ring, etc. are also provided. It’s a great chance to surprise your friends. \\n\\n5. More Entertainment\\nMore than voice! Text, pictures are also available. You will have fun with friends by playing games and singing karaoke.\\n\\n6. Join another Party\\nThere are many public rooms with different topics. Choose the room according to the topic, then you will find friends with the same interests. Meanwhile, you will feel free to talk with anyone without showing your face.\\n\\nIf you have any problems or feedback, you can contact us by：\\nFacebook: www.facebook.com/StarChatLive/\\nWebsite: www.starchat.live\\nEmail: support@starchat.live\\n\\nDownload StarChat now! Create your own voice chat room and hold an online party!\"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple116/v4/e8/6b/b5/e86bb5be-887f-68a5-4e13-2576e8c477f1/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"be76ef\",\"textColor1\":\"161516\",\"textColor2\":\"161616\",\"textColor3\":\"382842\",\"textColor4\":\"382942\"},\"privacyPolicyUrl\":\"https://www.chathot.me/help/policy/Privacy_Policy.html\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"https://www.starchat.live\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"6.32.1\",\"releaseNotes\":\"Several Bugs fixed.\",\"releaseDate\":\"2023-03-25\",\"releaseTimestamp\":\"2023-03-25T00:59:24Z\"},{\"versionDisplay\":\"6.32\",\"releaseNotes\":\"1. Added CP Zone\\n2. Optimize special relationship function\",\"releaseDate\":\"2023-03-23\",\"releaseTimestamp\":\"2023-03-23T14:38:06Z\"},{\"versionDisplay\":\"6.31\",\"releaseNotes\":\"1. Added Province System\\r\\n2. Party moment is recorded now\\r\\n3. Optimize special relationship function\\n\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T01:24:48Z\"},{\"versionDisplay\":\"6.30.1\",\"releaseNotes\":\"Fix several bugs\\r\\n\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T17:22:17Z\"},{\"versionDisplay\":\"6.30\",\"releaseNotes\":\"bug fixed.\",\"releaseDate\":\"2023-02-14\",\"releaseTimestamp\":\"2023-02-14T23:07:09Z\"},{\"versionDisplay\":\"6.29\",\"releaseNotes\":\"1. Optimize group feature\\r\\n2. Fix several bugs\\n\",\"releaseDate\":\"2023-02-10\",\"releaseTimestamp\":\"2023-02-10T12:37:16Z\"},{\"versionDisplay\":\"6.28\",\"releaseNotes\":\"1. Fix several bugs\\r\\n2. Guild founder can bind a chatting group for members now!\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T23:04:16Z\"},{\"versionDisplay\":\"6.27.0\",\"releaseNotes\":\"1. Added title system.\\r\\n2. Fix several bugs.\",\"releaseDate\":\"2023-01-15\",\"releaseTimestamp\":\"2023-01-15T10:53:10Z\"},{\"versionDisplay\":\"6.26\",\"releaseNotes\":\"Fixed several bugs.\\r\",\"releaseDate\":\"2023-01-07\",\"releaseTimestamp\":\"2023-01-07T12:18:38Z\"},{\"versionDisplay\":\"6.25\",\"releaseNotes\":\"1. Upgrade guild functions\\r\\n2. Added SVIP Privilege\\r\\n3. Fix several bugs\",\"releaseDate\":\"2022-12-30\",\"releaseTimestamp\":\"2022-12-30T02:16:41Z\"},{\"versionDisplay\":\"6.24.1\",\"releaseNotes\":\"1. Fix several bugs\",\"releaseDate\":\"2022-12-16\",\"releaseTimestamp\":\"2022-12-16T10:26:17Z\"},{\"versionDisplay\":\"6.24\",\"releaseNotes\":\"\\r\\n1. Optimize the SVIP system\\r\\n2. Fix several bugs\",\"releaseDate\":\"2022-12-12\",\"releaseTimestamp\":\"2022-12-12T15:21:22Z\"},{\"versionDisplay\":\"6.23.1\",\"releaseNotes\":\"Fix several bugs.\",\"releaseDate\":\"2022-11-17\",\"releaseTimestamp\":\"2022-11-17T12:21:18Z\"},{\"versionDisplay\":\"6.23\",\"releaseNotes\":\"1. Optimize the SVIP function\\n2. Fix several bugs\",\"releaseDate\":\"2022-11-16\",\"releaseTimestamp\":\"2022-11-16T01:37:42Z\"},{\"versionDisplay\":\"6.22\",\"releaseNotes\":\"1.Optimize group chat function.\\r\\n2.Fixed several bugs.\",\"releaseDate\":\"2022-11-01\",\"releaseTimestamp\":\"2022-11-01T14:57:27Z\"},{\"versionDisplay\":\"6.21\",\"releaseNotes\":\"1. Added group chat function.\\n2. Fixed several bugs. \\n\",\"releaseDate\":\"2022-09-27\",\"releaseTimestamp\":\"2022-09-27T23:07:49Z\"},{\"versionDisplay\":\"6.20.0\",\"releaseNotes\":\"Fixed several bugs.\",\"releaseDate\":\"2022-08-24\",\"releaseTimestamp\":\"2022-08-24T23:21:44Z\"},{\"versionDisplay\":\"6.19.0\",\"releaseNotes\":\"1. Added game ranking list\\r\\n2. Added recommended new room\\r\",\"releaseDate\"