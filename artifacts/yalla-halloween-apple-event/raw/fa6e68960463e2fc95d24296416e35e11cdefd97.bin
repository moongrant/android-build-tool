}{c}.{f}\",\"bgColor\":\"304313\",\"textColor1\":\"dfd4c8\",\"textColor2\":\"fcc21a\",\"textColor3\":\"bcb7a4\",\"textColor4\":\"d3a818\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/06/cf/e8/06cfe8cf-85a8-fab2-0873-231299d713cc/b69922e9-5d2c-4c06-9c9d-0084ab3f96ff_6.5__U82f1_U8bed1.png/{w}x{h}{c}.{f}\",\"bgColor\":\"2d95d9\",\"textColor1\":\"060808\",\"textColor2\":\"091316\",\"textColor3\":\"0e2432\",\"textColor4\":\"102d3d\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/72/05/85/720585f2-2968-9d1b-9ca5-f9bec08ab943/ed13beb4-5b24-467e-9ca5-7f01f850a7f5_6.5__U82f1_U8bed3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"c9e2fe\",\"textColor1\":\"0e0d0c\",\"textColor2\":\"252e46\",\"textColor3\":\"33373c\",\"textColor4\":\"46526a\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ac/cf/20/accf2044-cc3a-7250-9692-c4c1952791fd/e8983cde-3425-4b35-ba7e-029bbd10042e_6.5__U82f1_U8bed4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"decaff\",\"textColor1\":\"131216\",\"textColor2\":\"271f5b\",\"textColor3\":\"3b3744\",\"textColor4\":\"4b417c\"}],\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/4f/b2/60/4fb260b9-9915-a0ff-9597-8b24a0f10cae/e1f0e13f-2c19-4986-8699-de08a9f7a01e_5.5__U82f1_U8bed_2.png/{w}x{h}{c}.{f}\",\"bgColor\":\"2c4014\",\"textColor1\":\"d2c9c3\",\"textColor2\":\"f8b20a\",\"textColor3\":\"b0aea0\",\"textColor4\":\"cf9b0c\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/d9/42/1d/d9421d17-7e9f-7f8e-ed05-b4944f9c4f5d/0f79a631-8a65-4dcc-8640-944605791636_5.5__U82f1_U8bed1__U00281_U0029.png/{w}x{h}{c}.{f}\",\"bgColor\":\"834b3b\",\"textColor1\":\"ffffff\",\"textColor2\":\"f2c7b2\",\"textColor3\":\"e6dbd7\",\"textColor4\":\"dcae9b\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is5-ssl.mzstatic.com/