"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Selten/schwach ausgeprägt: Szenen mit erotischen Anspielungen\",\"Selten/schwach ausgeprägt: sexuelle Inhalte oder Nacktheit\",\"Unbeschränkter Zugang zum Web\",\"Selten/schwach ausgeprägt: Gebrauch von Alkohol, Tabak oder Drogen bzw. Verweise hierzu\",\"Häufig/stark ausgeprägt: obszöner oder vulgärer Humor\"]}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/wolf/id286274367\",\"userRating\":{\"value\":4.3,\"ratingCount\":149,\"ratingCountList\":[17,6,5,15,106],\"ariaLabelForRatings\":\"4.3 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"11.0\",\"name\":\"WOLF\",\"genreDisplayName\":\"Unterhaltung\",\"isPreorder\":false,\"artistName\":\"Palringo Limited\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 14.5 oder neuer.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Erfordert iPadOS 14.5 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 14.5 oder neuer.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Erfordert macOS 11.3 (oder neuer) und einen Mac mit Apple M1-Chip (oder neuer).\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=286274367\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855411096\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":140780544}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=286274367\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855411096\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":140780544}]}],\"minimumMacOSVersion\":\"11.3\",\"requires32bit\":false,\"releaseDate\":\"2019-02-01\",\"hasInAppPurchases\":true,\"bundleId\":\"com.palringo.Palringo\",\"description\":{\"standard\":\"Experience the World’s Online Festival - an incredible user-created world filled with Group Chat, Live Audio Shows, Friendship and Entertainment.\\n\\n• Discover a large variety of Chat Groups - find a group where you truly belong - make friendships for life.\\n• Explore Live Audio Stages - watch user-created shows that inspire you, entertain you, delight you, and make you laugh or cry.\\n• Create your own Groups and Shows - attract a following, and express yourself to your new audience.\\n• Play fun Games while you chat - compete with your friends or engage in fun shared experiences.\\n• Earn reputation points and achievements, become a high-level legend amongst the WOLF community.\\n• Express yourself safely in a fun, eclectic community by reinventing yourself with your own WOLF profile, and mix with a culture of like-minded people.\\n\\nWOLF takes the magic of the festival experience, and brings it to your online social life - we unite people across the globe in fun, entertainment and belonging. Join our unique online world today.\\n\\n----\\n\\nLike us on Facebook: facebook.com/wolfliveapp\\n\\nTweet us on Twitter: @wolfliveapp\\n\\nEmail us on support@wolf.live for any questions, problems or feedback.\\n\\n---\\n\\nTerms of Use: https://wolf.live/terms-of-service\"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple126/v4/54/05/11/54051187-524d-4e18-584b-6834a2ee90b1/AppIcon-0-0-1x_U007emarketing-0-7-0-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"1a1a1a\",\"textColor1\":\"ffcc00\",\"textColor2\":\"f10bc1\",\"textColor3\":\"d1a805\",\"textColor4\":\"c60e9f\"},\"privacyPolicyUrl\":\"https://wolf.live/privacy-policy\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"http://support.wolf.live\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"11.3.1\",\"releaseNotes\":\"A number of bug fixes and improvements.\",\"releaseDate\":\"2023-03-13\",\"releaseTimestamp\":\"2023-03-13T09:44:51Z\"},{\"versionDisplay\":\"11.3\",\"releaseNotes\":\"A game-changing update for content creators and music enthusiasts! With the brand new WOLFStars section in Users Profiles featuring show performance stats and the improved DJ Deck which introduces new features such as music playback modules\",\"releaseDate\":\"2023-03-06\",\"releaseTimestamp\":\"2023-03-06T10:37:09Z\"},{\"versionDisplay\":\"11.2.1\",\"releaseNotes\":\"Misc: A number of bug fixes and improvements.\",\"releaseDate\":\"2022-12-19\",\"releaseTimestamp\":\"2022-12-19T10:31:16Z\"},{\"versionDisplay\":\"11.2\",\"releaseNotes\":\"Large Groups - We have made some changes behind the groups that will allow us to raise the group member limit in the future. Users will see some visual improvements to the members list.\",\"releaseDate\":\"2022-11-29\",\"releaseTimestamp\":\"2022-11-29T10:45:28Z\"},{\"versionDisplay\":\"11.1.4\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-10-05\",\"releaseTimestamp\":\"2022-10-05T11:01:08Z\"},{\"versionDisplay\":\"11.1.3\",\"releaseNotes\":\"A number of bug fixes and improvements.\",\"releaseDate\":\"2022-09-06\",\"releaseTimestamp\":\"2022-09-06T12:57:05Z\"},{\"versionDisplay\":\"11.1.2\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-08-18\",\"releaseTimestamp\":\"2022-08-18T14:28:56Z\"},{\"versionDisplay\":\"11.1.1\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-08-11\",\"releaseTimestamp\":\"2022-08-11T08:48:05Z\"},{\"versionDisplay\":\"11.1\",\"releaseNotes\":\"Group Controls - This new features gives Group owners better control on the type of content in their Group, including the rate this content is displayed.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T09:36:44Z\"},{\"versionDisplay\":\"11.0.3\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-06-15\",\"releaseTimestamp\":\"2022-06-15T13:04:23Z\"},{\"versionDisplay\":\"11.0.2\",\"releaseNotes\":\"Improvements to app stability and performance.\",\"releaseDate\":\"2022-05-16\",\"releaseTimestamp\":\"2022-05-16T14:09:05Z\"},{\"versionDisplay\":\"11.0.1\",\"releaseNotes\":\"We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2022-02-24\",\"releaseTimestamp\":\"2022-02-24T11:11:24Z\"},{\"versionDisplay\":\"11.0\",\"releaseNotes\":\"Raise Hands: Now users in the audience can signal those on the Stage to let them know they that they want to jump up.\\n\\nStore: A revamped Store design, making it easier to find and purchase the products you want.\\n\\nMisc:  A number of bug fixes and improvements, including tweaks to the app’s presentation.\",\"releaseDate\":\"2022-02-15\",\"releaseTimestamp\":\"2022-02-15T10:23:32Z\"},{\"versionDisplay\":\"10.13.1\",\"releaseNotes\":\"- We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2021-10-20\",\"releaseTimestamp\":\"2021-10-20T15:16:44Z\"},{\"versionDisplay\":\"10.13\",\"releaseNotes\":\"- You’ll now find a bank of sound effects in the broadcast toolbar which can be played while on Stage. What’s more, you can even swap in new sound effects from our sound bank to replace the 5 default sounds.\\n- We’ve made app performance improvements as well as other general bug fixes.\",\"releaseDate\":\"2021-10-14\",\"releaseTimestamp\":\"2021-10-14T09:07:03Z\"},{\"versionDisplay\":\"10.12\",\"releaseNotes\":\"- The new Broadcast Bar gives you more control over your time on the Stage, such as streamlining picking a Stage theme, controlling when you want to drop from the Stage, and keeping your mic on/off, as well as a simpler push-to-talk interface.\\n- The Achievements section has been redesigned to make them simpler to view, and also includes a celebration screen upon acquisition, so you can see your progress in greater detail.\\n- Various bug fixes\",\"releaseDate\":\"2021-09-08\",\"releaseTimestamp\":\"2021-09-08T08:57:49Z\"},{\"versionDisplay\":\"10.11\",\"releaseNotes\":\"- Improved the flow of the payment process\\n- General bug fixes and improvements \",\"releaseDate\":\"2021-07-26\",\"releaseTimestamp\":\"2021-07-26T09:10:39Z\"},{\"versionDisplay\":\"10.10.1\",\"releaseNotes\":\"- Various bug fixes and improvements\",\"releaseDate\":\"2021-06-22\",\"releaseTimestamp\":\"2021-06-22T08:50:58Z\"},{\"versionDisplay\":\"10.10\",\"releaseNotes\":\"- Revamped Sign-In Screen: Our most popular sign-in methods are now front and centre\\n- Events Enhancement UI: Access events easily and find new ones\\n- GIF Keyboard: Search and send GIFs quicker than ever\\n- Stability Improvements: Handling caching data has been improved, resulting in increased performance\",\"releaseDate\":\"2021-06-17\",\"releaseTimestamp\":\"2021-06-17T13:29:44Z\"},{\"versionDisplay\":\"10.9.1\",\"releaseNotes\":\"Improvements to app stability and performance.\",\"releaseDate\":\"2021-05-24\",\"releaseTimestamp\":\"2021-05-24T13:28:37Z\"},{\"versionDisplay\":\"10.9\",\"releaseNotes\":\"- A totally revamped Discover page to make it even easier to find great Groups to join, events to take part in, and find out what's happening across WOLF!\\n- Posting links have been reworked so that you can choose whether you want to preview content\\n- Various bug fixes and improvements\",\"releaseDate\":\"2021-05-11\",\"releaseTimestamp\":\"2021-05-11T10:59:27Z\"},{\"versionDisplay\":\"10.8.1\",\"releaseNotes\":\"Improvements to app stability and performance.\",\"releaseDate\":\"2021-03-25\",\"releaseTimestamp\":\"2021-03-25T10:28:34Z\"},{\"versionDisplay\":\"10.8\",\"releaseNotes\":\"- You can now earn Achievements for your Group, with the initial offering set to be expanded upon monthly.\\n- Various bug fixes and improvements.\",\"releaseDate\":\"2021-03-17\",\"releaseTimestamp\":\"2021-03-17T09:56:43Z\"},{\"versionDisplay\":\"10.7\",\"releaseNotes\":\"Group Events: If you're a Group Owner, you can now create Events for shows, games–whatever you want! You can share these events in-app and with your friends outside. Users will even get handy reminders that your event is about to begin.\\n\\nFixes: Usual bug fixes and general improvements.\",\"releaseDate\":\"2020-12-16\",\"releaseTimestamp\":\"2020-12-16T15:00:42Z\"},{\"versionDisplay\":\"10.6.1\",\"releaseNotes\":\"- Bug squashing: Various fixes have been implemented\",\"releaseDate\":\"2020-11-18\",\"releaseTimestamp\":\"2020-11-18T10:08:33Z\"}],\"websiteUrl\":\"https://wolf.live\",\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Features124/v4/e4/70/aa/e470aaba-7611-d3bb-ebf3-9b34e2f2d74e/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/3c/ed/c1/3cedc1dd-b983-e70f-9565-b61f273809f1/46efde07-efe3-44e0-a860-a0fc61a57eed_iPhone-6.5_slide_1.png/{w}x{h}{c}.{f}\",\"bgColor\":\"feae00\",\"textColor1\":\"0c0c0c\",\"textColor2\":\"222222\",\"textColor3\":\"3c2c09\",\"textColor4\":\"4e3e1b\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/t