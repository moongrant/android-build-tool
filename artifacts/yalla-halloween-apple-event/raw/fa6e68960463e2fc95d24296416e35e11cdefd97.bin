url\":\"https://apps.apple.com/de/developer/palringo-limited/id284965852\"}}]}}},{\"id\":\"1384325538\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1384325538?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Daten, die zum Tracking deiner Person verwendet werden\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise verwendet, um dich über Apps und Websites anderer Unternehmen hinweg zu verfolgen:\",\"dataCategories\":[{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Mit dir verknüpfte Daten\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise erfasst und mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Gekaufte Artikel\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Finanz­informa­tionen\",\"identifier\":\"FINANCIAL_INFO\"},{\"dataCategory\":\"Standort\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Kontakt­informa­tionen\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Benutzer­inhalte\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Suchverlauf\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Nutzungs­daten\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Sonstige Daten\",\"identifier\":\"OTHER\"}]},{\"privacyType\":\"Nicht mit dir verknüpfte Daten\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden zwar möglicherweise erfasst, aber nicht mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Selten/schwach ausgeprägt: obszöner oder vulgärer Humor\",\"Selten/schwach ausgeprägt: sexuelle Inhalte oder Nacktheit\",\"Häufig/stark ausgeprägt: Szenen mit erotischen Anspielungen\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/hakuna-live-streams-and-chat/id1384325538\",\"userRating\":{\"value\":4.5,\"ratingCount\":400,\"ratingCountList\":[30,10,16,24,320],\"ariaLabelForRatings\":\"4.5 Sterne\"},\"name\":\"Hakuna: Live Streams and Chat\",\"genreDisplayName\":\"Unterhaltung\",\"isPreorder\":false,\"artistName\":\"MOVEFAST Company, K.K.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 13.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 13.0 oder neuer.\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1384325538\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855666138\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":201290752}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1384325538\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855666138\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":201290752}]}],\"minimumMacOSVersion\":\"11.0\",\"requires32bit\":false,\"releaseDate\":\"2018-09-06\",\"hasInAppPurchases\":true,\"bundleId\":\"com.movefastcompany.bora\",\"description\":{\"standard\":\"Calling all livestreaming hosts: enjoy broadcasting in video, audio, or with a guest!\\nCalling all fans: enjoy various mission games and gifting items with your favorite hosts!\\n\\nJoin us in the all-new Hakuna to find your hidden gems.\\nUnleash your talent on Hakuna and build a tight-knit fanbase.\\n* HD, lag-free broadcasts will make you feel like you’re chatting IRL.\\n* Engage with fans through VS Mode games, Mission games, and more.\\n* From video to audio, mobile to desktop, solo-stream to four guests - the (Hakuna) world is your oyster.\\n\\nHundreds of hosts await fans like you to open Hakuna!\\n* Discover your favorite hosts through customized Feeds and explore filters.\\n* Support your hosts with a fun gift. Leave a memorable impression and they’ll call you by your name!\\n* Spice up the fun with our occasional Hakuna Official Broadcasts!\\n\\nLeave a Review!\\n* Your reviews and shares help us tremendously in improving Hakuna.\\nNeed help, or got feedback?\\n* Visit help.hakuna.live, or contact help@hakuna.live.\\nRequired Device Permissions:\\n* Microphone: Captures and delivers your audio to viewers when you host a livestream, or participate as a guest.\\n* Camera: Captures and delivers your video to viewers when you host a livestream, or participate as a guest.\\nOptional Device Permissions:\\n* Storage space: Downloads profile pictures you edited to your device, and to access the saved picture.\\n* You will still be able to use our service even if you don’t grant optional permissions.\"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/Purple126/v4/d5/65/1e/d5651ebf-5a27-51bf-92cf-7bfb8717a8d3/AppIcon-1x_U007emarketing-0-10-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"e0e200\",\"textColor1\":\"100e0c\",\"textColor2\":\"15100d\",\"textColor3\":\"39380a\",\"textColor4\":\"3d3a0a\"},\"privacyPolicyUrl\":\"https://hakuna.live/privacy-policy\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"https://help.hakuna.live/\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"2.0.3\",\"releaseNotes\":\"- We've added a real-time timer so you can know when the rankings are updated. Cheer on your favorite hosts to make it into the top ranks!\\n- To provide a more enjoyable and seamless Hakuna experience, we've fixed various bugs.\",\"releaseDate\":\"2023-03-23\",\"releaseTimestamp\":\"2023-03-23T23:40:04Z\"},{\"versionDisplay\":\"2.0.2\",\"releaseNotes\":\"This update fixes a bug that prevented some users from entering Liverooms based on their settings.\\n\\nIntroducing the all-new Hakuna!\\nDiscover even more hidden gem-like creators in our new, immersive dark mode.\\n\\n1. Uninterrupted HD Broadcasting\u2028\\n- Fans can now meet you in pixel-perfect quality. Broadcast in HD with no complicated extension programs needed!\\n2. New Feed Customized for You\\n- \u2028Get endless recommendations tailored to your interests, or jump to Hakuna’s Official Broadcasts. You can set keywords that peak your interests anytime in your profile.\\n3. Seamless Search \u0026 Discovery\u2028\\n- Explore tabs grouped by popularity, interests, or hosts. Or look up specific users, keywords, and stream titles with our improved Search!\\n4. Call me @username\\n- \u2028So long to random Hakuna IDs — express yourself with a username of your choice! We’ll be introducing more ways to express your personality in the coming months.\\n5. Chat with Teammates right on the app\\n- \u2028Look no further to communicate with other hosts and fans with our new Team bulletin board. Team now has its own tab for quicker access.\\n\\nWant to learn more! See below for a detailed overview of new Hakuna: \\nhttps://web.hakuna.live/event/230206-2_0updateannouncement-en/index.html\",\"releaseDate\":\"2023-03-10\",\"releaseTimestamp\":\"2023-03-10T01:16:36Z\"},{\"versionDisplay\":\"2.0.1\",\"releaseNotes\":\"Introducing the all-new Hakuna!\\nDiscover even more hidden gem-like creators in our new, immersive dark mode.\\n\\n1. Uninterrupted HD Broadcasting\u2028\\n- Fans can now meet you in pixel-perfect quality. Broadcast in HD with no complicated extension programs needed!\\n2. New Feed Customized for You\\n- \u2028Get endless recommendations tailored to your interests, or jump to Hakuna’s Official Broadcasts. You can set keywords that peak your interests anytime in your profile.\\n3. Seamless Search \u0026 Discovery\u2028\\n- Explore tabs grouped by popularity, interests, or hosts. Or look up specific users, keywords, and stream titles with our improved Search!\\n4. Call me @username\\n- \u2028So long to random Hakuna IDs — express yourself with a username of your choice! We’ll be introducing more ways to express your personality in the coming months.\\n5. Chat with Teammates right on the app\\n- \u2028Look no further to communicate with other hosts and fans with our new Team bulletin board. Team now has its own tab for quicker access.\\n\\nWant to learn more! See below for a detailed overview of new Hakuna: \\nhttps://web.hakuna.live/event/230206-2_0updateannouncement-en/index.html\",\"releaseDate\":\"2023-03-02\",\"releaseTimestamp\":\"2023-03-02T01:34:34Z\"},{\"versionDisplay\":\"2.0.0\",\"releaseNotes\":\"Introducing the all-new Hakuna!\\nDiscover even more hidden gem-like creators in our new, immersive dark mode.\\n\\n1. Uninterrupted HD Broadcasting\u2028\\n- Fans can now meet you in pixel-perfect quality. Broadcast in HD with no complicated extension programs needed!\\n2. New Feed Customized for You\\n- \u2028Get endless recommendations tailored to your interests, or jump to Hakuna’s Official Broadcasts. You can set keywords that peak your interests anytime in your profile.\\n3. Seamless Search \u0026 Discovery\u2028\\n- Explore tabs grouped by popularity, interests, or hosts. Or look up specific users, keywords, and stream titles with our improved Search!\\n4. Call me @username\\n- \u2028So long to random Hakuna IDs — express yourself with a username of your choice! We’ll be introducing more ways to express your personality in the coming months.\\n5. Chat with Teammates right on the app\\n- \u2028Look no further to communicate with other hosts and fans with our new Team bulletin board. Team now has its own tab for quicker access.\\n\\nWant to learn more! See below for a detailed overview of new Hakuna: \\nhttps://web.hakuna.live/event/230206-2_0updateannouncement-en/index.html\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T06:32:40Z\"},{\"versionDisplay\":\"1.36.0\",\"releaseNotes\":\"Bug fixes and improved usability.\",\"releaseDate\":\"2023-01-20\",\"releaseTimestamp\":\"2023-01-20T07:49:04Z\"},{\"versionDisplay\":\"1.35.0\",\"releaseNotes\":\"The age of multitasking!\\nDo you want to chat while watching Live?\\nWatch seamlessly with picture-in-picture mode.\\n(Available for iOS 16 or later)\",\"releaseDate\":\"2022-12-01\",\"releaseTimestamp\":\"2022-12-01T23:03:08Z\"},{\"versionDisplay\":\"1.34.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-11-03\",\"releaseTimestamp\":\"2022-11-03T23:58:06Z\"},{\"versionDisplay\":\"1.33.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-10-20\",\"releaseTimestamp\":\"2022-10-20T00:28:51Z\"},{\"versionDisplay\":\"1.32.0\",\"releaseNotes\":\"\\bPhone number login has been more safe and easy!\\n\\n- When you log out, you can log in with just one click when you change your account\\n- Through the first e-mail authentication, there is no need to set the password. You can log in even if your phone number is changed\\n\\nYou can now upload an image in Fan board!\",\"releaseDate\":\"2022-10-12\",\"releaseTimestamp\":\"2022-10-12T06:35:37Z\"},{\"versionDisplay\":\"1.31.1\",\"releaseNotes\":\"- Minor service enhancements\",\"releaseDate\":\"2022-09-08\",\"releaseTimestamp\":\"2022-09-08T01:02:39Z\"},{\"versionDisplay\":\"1.29.0\",\"releaseNotes\":\"A new feature 'Virtual' liveroom has been updated!\\nMake new friends by enjoying quizzes and social live with unique avatars in the virtual world!\",\"releaseDate\":\"2022-08-12\",\"releaseTimestamp\":\"2022-08-12T06:46:03Z\"},{\"versionDisplay\":\"1.28.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-08-02\",\"releaseTimestamp\":\"2022-08-02T00:32:00Z\"},{\"versionDisplay\":\"1.27.0\",\"releaseNotes\":\"-In-room ranking option has been added!\\n-The host can decide whether or not to expose the in-room ranking.\\n-Fixed bugs and improved usability.\",\"releaseDate\":\"2022-07-14\",\"releaseTimestamp\":\"2022-07-14T05:27:57Z\"},{\"versionDisplay\":\"1.26.0\",\"releaseNotes\":\"- Now you can join Hakuna with phone number\\r\\n- Liveroom share feature is improved\",\"releaseDate\":\"2022-06-16\",\"releaseTimestamp\":\"2022-06-16T23:57:51Z\"},{\"versionDisplay\":\"1.25.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-06-12\",\"releaseTimestamp\":\"2022-06-12T07:14:37Z\"},{\"versionDisplay\":\"1.24.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\\n\\n- Liveroom share feature has been improved. Share liveroom to your friends!\\n- Push notification has been improved\",\"releaseDate\":\"2022-05-26\",\"releaseTimestamp\":\"2022-05-26T03:53:16Z\"},{\"versionDisplay\":\"1.23.0\",\"releaseNotes\":\"- \\bVirtual Live Room has released. Enjoy Virtual Live Room with your avatar!\\n\\n- Fixed bugs and improved usability.\",\"releaseDate\":\"2022-05-11\",\"releaseTimestamp\":\"2022-05-11T07:36:00Z\"},{\"versionDisplay\":\"1.22.0\",\"releaseNotes\":\"- \\bVirtual Live Room has released. Enjoy Virtual Live Room with your avatar!\\n\\n- Fixed bugs and improved usability.\",\"releaseDate\":\"2022-05-05\",\"releaseTimestamp\":\"2022-05-05T04:17:57Z\"},{\"versionDisplay\":\"1.21.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-04-27\",\"releaseTimestamp\":\"2022-04-27T05:50:33Z\"},{\"versionDisplay\":\"1.20.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-04-08\",\"releaseTimestamp\":\"2022-04-08T23:23:21Z\"},{\"versionDisplay\":\"1.19.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-03-28\",\"releaseTimestamp\":\"2022-03-28T01:12:09Z\"},{\"versionDisplay\":\"1.18.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-03-14\",\"releaseTimestamp\":\"2022-03-14T01:18:11Z\"},{\"versionDisplay\":\"1.17.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-02-20\",\"releaseTimestamp\":\"2022-02-20T01:47:48Z\"},{\"versionDisplay\":\"1.16.0\",\"releaseNotes\":\"Fixed bugs and improved usability.\",\"releaseDate\":\"2022-01-23\",\"releaseTimestamp\":\"2022-01-23T01:11:07Z\"},{\"versionDisplay\":\"1.15.0\",\"releaseNotes\":\"- iOS minimum version support upgrade (11.0 -\u003e 12.0)\\n\\n- Fixed bugs and improved usability\",\"releaseDate\":\"2022-01-06\",\"releaseTimestamp\":\"2022-01-06T10:25:29Z\"}],\"websiteUrl\":\"https://hakuna.live\",\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Features124/v4/e4/70/aa/e470aaba-7611-d3bb-ebf3-9b34e2f2d74e/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/dc/4d/8e/dc4d8ecb-d2cb-051d-9346-e7484720a953/e3625a4f-42a5-4403-bd22-c2a95e9faae8_iOS5.5_ENG_1.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"191a1e\",\"textColor1\":\"f1f1f1\",\"textColor2\":\"ace6ef\",\"textColor3\":\"c6c6c7\",\"textColor4\":\"8fbdc5\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is2-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/f6/f4/02/f6f40282-3ad7-7cd4-dbb7-3e21a98572ff/85c71fb3-69c4-444f-9758-180f3f6b5d8a_iOS5.5_ENG_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"191a1e\",\"textColor1\":\"ffffff\",\"textColor2\":\"dfc0a8\"