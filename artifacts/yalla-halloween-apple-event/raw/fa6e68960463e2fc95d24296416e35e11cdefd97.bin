52064768,\"iPhone14,3\":243727360,\"iPhone14,2\":243727360,\"iPhone10,6\":257291264,\"iPhone7,2\":252064768,\"iPhone10,5\":257291264,\"iPhone10,4\":252064768,\"iPhone7,1\":257291264,\"iPad13,19\":240401408,\"iPad14,5-A\":240401408,\"iPhone14,7\":243727360,\"iPad14,5-B\":240401408,\"iPhone14,6\":240339968,\"iPhone14,5\":243727360,\"iPad13,11\":240401408,\"iPhone14,4\":243727360,\"iPad13,17\":240401408,\"iPad13,18\":240401408,\"universal\":287458304,\"iPod9,1\":241929216,\"iPad13,16\":240401408,\"iPhone14,8\":243727360,\"iPad6,7\":252126208,\"iPad6,4\":252126208,\"iPad6,3\":252126208,\"iPad6,8\":252126208,\"iPad13,8\":240401408,\"iPad13,9\":240401408,\"iPad13,4\":240401408,\"iPad13,5\":240401408,\"iPad13,6\":240401408,\"iPad13,7\":240401408,\"iPad13,1\":240401408,\"iPad13,2\":240401408}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/de/apps/1513504421/genres?l=de-DE\",\"data\":[{\"id\":\"6014\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6014?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Spiele\",\"url\":\"https://itunes.apple.com/de/genre/id6014\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6005?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Soziale Netze\",\"url\":\"https://itunes.apple.com/de/genre/id6005\",\"parentId\":\"36\"}},{\"id\":\"7004\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/7004?l=de-DE\",\"attributes\":{\"parentName\":\"Spiele\",\"name\":\"Brettspiele\",\"url\":\"https://itunes.apple.com/de/genre/id7004\",\"parentId\":\"6014\"}},{\"id\":\"7005\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/7005?l=de-DE\",\"attributes\":{\"parentName\":\"Spiele\",\"name\":\"Karten\",\"url\":\"https://itunes.apple.com/de/genre/id7005\",\"parentId\":\"6014\"}}]},\"developer\":{\"href\":\"/v1/catalog/de/apps/1513504421/developer?l=de-DE\",\"data\":[{\"id\":\"1444567250\",\"type\":\"developers\",\"href\":\"/v1/catalog/de/developers/1444567250?l=de-DE\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Yalla Technology FZ-LLC\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/de/developer/yalla-technology-fz-llc/id1444567250\"}}]}}},{\"id\":\"1594494132\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1594494132?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Mit dir verknüpfte Daten\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise erfasst und mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Gekaufte Artikel\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Standort\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Kontakt­informa­tionen\",\"identifier\":\"CONTACT_INFO\"},{\"dataCategory\":\"Benutzer­inhalte\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Suchverlauf\",\"identifier\":\"SEARCH_HISTORY\"},{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Nutzungs­daten\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Selten/schwach ausgeprägt: Gebrauch von Alkohol, Tabak oder Drogen bzw. Verweise hierzu\",\"Selten/schwach ausgeprägt: sexuelle Inhalte oder Nacktheit\",\"Selten/schwach ausgeprägt: obszöner oder vulgärer Humor\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/waha-3d-avatar-voice-chat/id1594494132\",\"userRating\":{\"value\":0,\"ratingCount\":0,\"ratingCountList\":[0,0,0,0,0],\"ariaLabelForRatings\":\"Keine Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"Waha - 3D Avatar Voice Chat\",\"genreDisplayName\":\"Unterhaltung\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Yalla Technology FZ-LLC\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Discover a virtual world which connects friends with endless possibilities in Waha!\\n\\n\\nParty \u0026 meetup in virtual 3D scenes\\nExplore fascinating virtual locations curated for you. Start your party and roleplay games in a modern townhouse, isolated island, or in a stunning garden.\\n\\n\\nEnjoy your best times with real-time voice chat\\nFriendships are true in Waha. Join the voice chat, sing songs or discuss your favourite topics and share your feelings. All perfected to offer you the virtual life where you can be as unique as you wish.\\n\\n\\nCustomize the Avatar to express yourself\\nBe as you like, create your dream character, and keep up with fashion trends and dress up with a selection of various unique items, including shiny hairstyles, traditional thobes, trendy jeans, gorgeous one-piece dresses and many more to discover.\\n\\n\\nWe are dedicated to launching more enjoyable features for all of you in the upcoming days. Waha community is your virtual oasis where you will never be alone.\\n\\n\\nFollow us for more updates and news.\\nWebsite: www.wahachat.com\\n\\n\\nYour feedback and advice are vital for our development. Please contact us through Email at: support@wahachat.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"websiteUrl\":\"https://www.wahachat.com\",\"versionHistory\":[{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2023-03-13\",\"releaseTimestamp\":\"2023-03-13T10:14:02Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"1) Interface Update: A brand-new user interface has been added to the rooms, providing a better chat experience.\\r\\n2) Room level: Room owners can now upgrade the levels of their rooms and increase their capacity.\\r\\n3) FAQ Shortcut: If you have any questions about how to use Waha, simply get the answer by clicking on the FAQ button in the Waha Team message.\",\"releaseDate\":\"2023-02-16\",\"releaseTimestamp\":\"2023-02-16T02:03:22Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2023-01-17\",\"releaseTimestamp\":\"2023-01-17T06:03:41Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"1. Capture Photos: Now supporting the ability to capture wonderful moments inside rooms. You can save these photos as memories or set them as room previews!\\r\\n2. Guide Icons: These icons show you the items you can interact with inside the 3D scenes, allowing you to quickly explore Waha’s virtual worlds. \\r\\n3. Performance Enhancement: Bug fixes have been implemented to improve the Waha user experience.\",\"releaseDate\":\"2023-01-03\",\"releaseTimestamp\":\"2023-01-03T01:55:09Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"1. In-Room Message Notifications: Access your private messages from inside rooms and instantly find out who messaged you!\\r\\n2. Next-Day Login Reward: Receive \\\"Tomorrow's Login Invitation\\\" and claim your Next-Day Rewards.\\r\\n3. Bug Fixes: Fixed a few bugs to improve the Waha user experience.\",\"releaseDate\":\"2022-12-10\",\"releaseTimestamp\":\"2022-12-10T13:53:39Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-11-12\",\"releaseTimestamp\":\"2022-11-12T01:17:47Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"1. Face Customization: You can now customize your avatar's face and makeup to create a unique Waha avatar.\\r\\n\\r\\n2. Active Rooms \u0026 Users Rankings: You can now view rankings showcasing the most active rooms and users on the platform.\\r\\n\\r\\n3. Friends Rooms List: This newly added feature allows you to view and enter rooms where you and your friends can easily gather.\",\"releaseDate\":\"2022-11-04\",\"releaseTimestamp\":\"2022-11-04T05:47:14Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-09-29\",\"releaseTimestamp\":\"2022-09-29T02:35:00Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"1-In-Room Features: Watch YouTube videos on a virtual screen, enjoy interactive dances and handshakes with your friends, and enjoy a better 3D gifting experience.\\n2-Level Progress \u0026 Rewards: Level up by completing tasks that get you more rewards and experience. You can also enjoy new rewards daily just by logging in!\\n3-Other Features: You can now find out which of your friends are online and you can also add personal labels to match your interests with that of others! \",\"releaseDate\":\"2022-09-17\",\"releaseTimestamp\":\"2022-09-17T11:06:38Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"We fixed few bugs to make Waha better to use.\",\"releaseDate\":\"2022-08-06\",\"releaseTimestamp\":\"2022-08-06T04:41:18Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"1. Music Feature - Added a 'Play Music' feature in rooms.\\r\\n2. Private Conversations - Now supporting private conversations with users who are outside your friend list.\\r\\n3. Share with your friends - Now you can share Waha rooms via Facebook and WhatsApp.\",\"releaseDate\":\"2022-07-18\",\"releaseTimestamp\":\"2022-07-18T02:00:54Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"1. You can invite friends in Waha to gather in current room.\\n2. In-room Status: you can now have a quick access to rooms that other users have joined.\\n3. Search feature: you can use key words to search for rooms or users.\",\"releaseDate\":\"2022-04-29\",\"releaseTimestamp\":\"2022-04-29T03:36:49Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2022-03-10\",\"releaseTimestamp\":\"2022-03-10T02:29:28Z\"}],\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1594494132\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855422999\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":269575168}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1594494132\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855422999\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":269575168}]}],\"requires32bit\":false,\"releaseDate\":\"2022-03-09\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yalla.wahachat3d\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple126/v4/39/14/6a/39146aa2-01df-2de3-d882-5abd0de1d3c8/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"00ffa2\",\"textColor1\":\"190d0d\",\"textColor2\":\"231613\",\"textColor3\":\"143d2b\",\"textColor4\":\"1c4430\"},\"privacyPolicyUrl\":\"https://www.wahachat.com/policy\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.wahachat.com/\",\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Features124/v4/e4/70/aa/e470aaba-7611-d3bb-ebf3-9b34e2f2d74e/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"subscriptionHero\":{\"width\":4320,\"height\":1080,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Featu