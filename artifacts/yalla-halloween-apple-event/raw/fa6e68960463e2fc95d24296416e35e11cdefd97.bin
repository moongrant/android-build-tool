205394944,\"iPhone7,2\":197366784,\"iPhone10,5\":205394944,\"iPhone10,4\":197366784,\"iPhone7,1\":205394944,\"iPad13,19\":181941248,\"iPad14,5-A\":181941248,\"iPhone14,7\":187397120,\"iPad14,5-B\":181941248,\"iPhone14,6\":181941248,\"iPad13,11\":181941248,\"iPhone14,5\":187397120,\"iPhone14,4\":187397120,\"iPad13,17\":181941248,\"iPad13,18\":181941248,\"universal\":269083648,\"iPod9,1\":184984576,\"iPad13,16\":181941248,\"iPhone14,8\":187397120,\"iPad6,7\":197366784,\"iPad6,4\":197366784,\"iPad6,3\":197366784,\"iPad6,8\":197366784,\"iPad13,8\":181941248,\"iPad13,9\":181941248,\"iPad13,4\":181941248,\"iPad13,5\":181941248,\"iPad13,6\":181941248,\"iPad13,7\":181941248,\"iPad13,1\":181941248,\"iPad13,2\":181941248}},\"relationships\":{\"genres\":{\"href\":\"/v1/catalog/de/apps/1526086695/genres?l=de-DE\",\"data\":[{\"id\":\"6016\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6016?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Unterhaltung\",\"url\":\"https://itunes.apple.com/de/genre/id6016\",\"parentId\":\"36\"}},{\"id\":\"6005\",\"type\":\"genres\",\"href\":\"/v1/catalog/de/genres/6005?l=de-DE\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Soziale Netze\",\"url\":\"https://itunes.apple.com/de/genre/id6005\",\"parentId\":\"36\"}}]},\"developer\":{\"href\":\"/v1/catalog/de/apps/1526086695/developer?l=de-DE\",\"data\":[{\"id\":\"1526086697\",\"type\":\"developers\",\"href\":\"/v1/catalog/de/developers/1526086697?l=de-DE\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"FUNI.PTE.LTD.\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/de/developer/funi-pte-ltd/id1526086697\"}}]}}},{\"id\":\"1509626067\",\"type\":\"apps\",\"href\":\"/v1/catalog/de/apps/1509626067?l=de-DE\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Daten, die zum Tracking deiner Person verwendet werden\",\"identifier\":\"DATA_USED_TO_TRACK_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise verwendet, um dich über Apps und Websites anderer Unternehmen hinweg zu verfolgen:\",\"dataCategories\":[{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Nicht mit dir verknüpfte Daten\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden zwar möglicherweise erfasst, aber nicht mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Benutzer­inhalte\",\"identifier\":\"USER_CONTENT\"},{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Häufig/stark ausgeprägt: Szenen mit erotischen Anspielungen\",\"Selten/schwach ausgeprägt: Zeichentrick- oder Fantasy-Gewalt\",\"Selten/schwach ausgeprägt: obszöner oder vulgärer Humor\",\"Selten/schwach ausgeprägt: simuliertes Glücksspiel\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/sango/id1509626067\",\"userRating\":{\"value\":4,\"ratingCount\":4,\"ratingCountList\":[0,0,2,0,2],\"ariaLabelForRatings\":\"4.0 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Unterhaltung\",\"name\":\"Sango\",\"isPreorder\":false,\"artistName\":\"MQJC TECHNOLOGY PTE. LTD.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 13.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 13.0 oder neuer.\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1509626067\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855845502\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":166889472}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1509626067\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855845502\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":166889472}]}],\"minimumMacOSVersion\":\"11.0\",\"requires32bit\":false,\"releaseDate\":\"2020-04-28\",\"hasInAppPurchases\":true,\"bundleId\":\"Sango.Sango.com\",\"description\":{\"standard\":\"Sango is the best place to go live and voice chat! Join now to meet awesome friends worldwide, showcase talents, and support artists! Share your life with others all over the world. You will talk with others by sharing your stories or your ideas. Join an online party in Sango!\\n\\nEnjoy your day with us!\\n\\n\\nWith Sango you can: \\n\\n- have a funny encounter\\n\\n- have a deep conversation\\n\\n- make new friends\\n\\n\\n---------Why Sango？---------\\n\\n\\nLive Voice Chat \\n\\n- Create a High-quality voice chat with up to 10 people in your Room.\\n\\n- Chat with strangers to expand your social community network.\\n\\n- Make use of our live voice chat with interactive voice emojis to have fun.\\n\\n\\nEntertaining Community \\n\\n-Create rooms more convenient \\n\\n-Sango is filled with diverse, voice content streaming every second!\\n\\n\\nWant more features? Get Sango right now!\\n\\n\\nFunny Tribal Theme\\n\\n-There are three tribes of Lion, Eagle, and Shark for you to join us. \\n\\n-Join a ‘Tribal’ and invite your friends and families too. More fun activities are waiting for you.\\n\\n\\nLIVE PK\\n\\n-You can challenge anyone by on click the button. The winner will get more awards, and the loser will accept funny punishment. \\n\\nHave PK with your friends and punish those who lose!\\n\\n\\nMini Games in Real-time\\n\\n-Sango Game box has more fun games waiting for you\\n\\n-Games can make you happier while chatting online. Find friends through playing games!\\n\\n\\nStatus symbol\\n\\n-Aristocrat is the exclusive status symbol of sango. There are different levels of aristocrat which has corresponding privileges, you can get the aristocrat and enjoy the privileges by paying monthly to activate it!\\n\\n\\nBECOME PART OF OUR SANGO SOCIAL COMMUNITY\\n\\n\\nSharing Moment\\n\\n-No matter daily life or mood quotes, sharing your life, Live your moments to Sango Instantly.\\n\\n-Send comments and express likes to your friends.\\n\\n\\nDiscover More Friends\\n\\n-You can easily change the country for the recommended content.\\n\\n-Don’t just listen to others’ Rooms! Share your thoughts in the chat, and support the one you like by sending comments and Gifts!\\n\\n\\nA diversity of gifts\\n\\n-We have animated gifts, festival gifts and gifts for specific events to show your adoration!\\n\\n-Here on Sango, you can not only express your likes but also receive likes from others. Come to Sango to see the new world!\\n\\n\\nCommon Interests Groups\\n\\n-Choose the topic you are interested in and talk with a group of like-minded friends!\\n\\n-Create a topic you are interested in and invite your friends and family to interact with you!\\n\\n\\nTalk and chat with talented people nearby or from all over the world.\\n\\nShare your special stories and promote social events on your profile page for everyone to see!\\nParticipate in online live stream events: Singing contests (Song Contests), Music Competitions\\n\\nVIP status for the best fans: Follow your favourite streamers and be the first to know when they go live.\\n\\n\\nSAY HELLO:\\n\\nWebsite: Sango.sg\\n\\nFacebook: @sangosocial\\n\\nInstagram: @sango_chat\\n\\nIf you have any questions when using the app: support@sango.sg.\\n\\nIf you want to be our partner: marketing@sango.sg\\n\\n\\nA Voice Chat Streaming app based on mutual respect among users, to have fun and spend an enjoyable and relaxing time. With many gorgeous people by your side, you will never get bored.\\n\\n\\nThis app is the perfect way to dive into the unknown world.\\n\\nMeet and chat with new friends to share your moments and relax!\"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple116/v4/ab/85/c4/ab85c410-ba7a-cde4-eca1-82f00dc53a3f/AppIcon-0-0-1x_U007emarketing-0-5-0-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"00110d\",\"textColor2\":\"01110a\",\"textColor3\":\"33413d\",\"textColor4\":\"34413b\"},\"privacyPolicyUrl\":\"https://h5.meiqijiacheng.com/to-h5/protocol\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"https://sango.sg\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"5.3.2\",\"releaseNotes\":\"\\\"مستوى القبيلة\\\" أصبح متوفر الآن!\\nالقبيلة بمثابة عائلة كبيرة تجمع كل الأصدقاء المنضمين إليها. واستمتاع الأعضاء بوقتهم من خلال الغناء واللعب والدردشة مع بعضهم يزيد من نجاح قبيلتك.\\nالقبائل الأعلى مستوى ستظهر في غلاف القبائل. أسرع وشارك في القبيلة مع أصدقائك!\\n\\n\\\"أيقونات الدردشة\\\" متوفرة الآن!\\nتتيح لك أيقونات الدردشة عرض الرسائل والرد عليها بسرعة في أي وقت وأي مكان من أي صفحة في سانجو.\",\"releaseDate\":\"2023-04-01\",\"releaseTimestamp\":\"2023-04-01T14:32:05Z\"},{\"versionDisplay\":\"5.3.1\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-تحسين تجربة المستخدم\",\"releaseDate\":\"2023-03-26\",\"releaseTimestamp\":\"2023-03-26T14:57:28Z\"},{\"versionDisplay\":\"5.3.0\",\"releaseNotes\":\"‒ تم تحديث الغرفة بالكامل إلى قبيلة، تعال وجرب القناة الصوتية والنصية.\\n‒ انضم إلى قبيلة صديق واستمتعا بوقتكما معًا\\n‒ الآن يمكنك الدخول بسرعة إلى الدردشة الجماعية للقبيلة من قائمة الدردشة.\\n‒ ترقية القصة، تعال وروِّج لقصصك المفضلة لجذب المزيد من الأشخاص لمشاهدتها!\\n‒ يمكنك الآن أيضًا عرض قصصك بشكل دائم في ملفك الشخصي.\\n‒ إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2023-03-16\",\"releaseTimestamp\":\"2023-03-16T14:41:55Z\"},{\"versionDisplay\":\"5.2.3\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-تحسين تجربة المستخدم\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T18:17:06Z\"},{\"versionDisplay\":\"5.2.2\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-صارف کے تجربے کو بہتر بنائیں\",\"releaseDate\":\"2023-03-01\",\"releaseTimestamp\":\"2023-03-01T14:35:57Z\"},{\"versionDisplay\":\"5.2.1\",\"releaseNotes\":\"-Bug fix\\n-Improve user experience\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T17:05:25Z\"},{\"versionDisplay\":\"5.2.0\",\"releaseNotes\":\"‒ رسائل الفيديو أصبحت مدعومة الآن، اذهب وشارك أحداث يومك!\\n‒ أُجريت تحديثات في القبيلة، تتوفر الآن قناة نصية وقناة صوتية في القبيلة.\\n‒ أُتيحت خاصية تثبيت الرسائل في قناة القبيلة. بحيث يمكن الوصول بسرعة إلى المعلومات الهامة بالقناة.\\n‒ يتوفر حساب \\\"الرسائل المحفوظة\\\" لمساعدتك في حفظ الرسائل والعثور عليها مرة أخرى بسرعة.\\n‒ إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2023-02-14\",\"releaseTimestamp\":\"2023-02-14T22:33:23Z\"},{\"versionDisplay\":\"5.1.1\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-تحسين تجربة المستخدم\",\"releaseDate\":\"2023-01-18\",\"releaseTimestamp\":\"2023-01-18T16:17:28Z\"},{\"versionDisplay\":\"5.1.0\",\"releaseNotes\":\"المربع السحري متاح الآن ، تعال واحصل على هدية الصاروخ النادرة!\\nتحديث المكالمات الصوتية ، لتستمتع بالدردشة مع أصدقائك!\\nيمكنك أيضاً الان معاينه الرسائل بروابط بسرعة وبسهوله \\nإصلاحات أخطاء بسيطة\",\"releaseDate\":\"2023-01-15\",\"releaseTimestamp\":\"2023-01-15T12:05:57Z\"},{\"versionDisplay\":\"5.0.4\",\"releaseNotes\":\"‒ سانگو ورژن 5.0 مکمل طور پر لانچ ہو چکا ہے! اپنی سماجی ضروریات کو پورا کریں! آئیے ایک نظر ڈالتے ہیں!\\n‒ ورلڈ کپ ایونٹ آن لائن ہے، جس ٹیم کو آپ سپورٹ کرتے ہیں اسے خوش کریں۔\\n‒ ٹرائب فنکشن نئے سرے سے شروع کیا گیا ہے، آئیے مزید مزے کی تلاش کریں۔\\n‒ چینل چیٹ سسٹم کو اپ ڈیٹ کر دیا گیا ہے، دوستوں کے ساتھ چیٹنگ کی خوشی کا تجربہ کریں۔\\n‒ زندگی میں خوبصورتی کو ریکارڈ کرنے کے لیے کہانی کا فنکشن آن لائن ہے۔\\n‒ آپ کی رازداری کے تحفظ کے لیے چیٹ سسٹم کو اپ گریڈ کیا گیا ہے۔\\n‒ ایکسپلور پیج کو بہتر بنایا گیا ہے، اب آپ تیزی سے دلچسپ کمرے تلاش کر سکتے ہیں۔\",\"releaseDate\":\"2023-01-06\",\"releaseTimestamp\":\"2023-01-06T02:01:46Z\"},{\"versionDisplay\":\"5.0.3\",\"releaseNotes\":\"‒ تم إطلاق الإصدار 5.0 من سانجو! يتوفر به كل الخدمات الاجتماعية التي تحتاجها! لنلقي نظرة!\\n‒ بدأ حدث كأس العالم بقطر، شجع الفرق التي تدعمها!\\n‒ أُضيفت ميزة \\\"القبيلة\\\" التي تمثل عالمًا جديدًا! اذهب للاستكشاف لمزيد من المرح!\\n‒ جرّب نظام الدردشة بالقناة الجديد مع الأصدقاء واستمتع بالدردشة.\\n‒ شارك أحداث حياتك من خلال ميزة القصة الجديدة.\\n‒ تم تحديث نظام الدردشة لتوفير أفضل حماية لخصوصيتك.\\n‒ تم تحسين صفحة الاستكشاف، يمكنك الآن الوصول بسرعة إلى الغرف الممتعة.\",\"releaseDate\":\"2022-12-03\",\"releaseTimestamp\":\"2022-12-03T15:56:41Z\"},{\"versionDisplay\":\"5.0.2\",\"releaseNotes\":\"‒ تم إطلاق الإصدار 5.0 من سانجو! يتوفر به كل الخدمات الاجتماعية التي تحتاجها! لنلقي نظرة!\\n‒ بدأ حدث كأس العالم بقطر، شجع الفرق التي تدعمها!\\n‒ أُضيفت ميزة \\\"القبيلة\\\" التي تمثل عالمًا جديدًا! اذهب للاستكشاف لمزيد من المرح!\\n‒ جرّب نظام الدردشة بالقناة الجديد مع الأصدقاء واستمتع بالدردشة.\\n‒ شارك أحداث حياتك من خلال ميزة القصة الجديدة.\\n‒ تم تحديث نظام الدردشة لتوفير أفضل حماية لخصوصيتك.\\n‒ تم تحسين صفحة الاستكشاف، يمكنك الآن الوصول بسرعة إلى الغرف الممتعة.\",\"releaseDate\":\"2022-11-27\",\"releaseTimestamp\":\"2022-11-27T02:04:19Z\"},{\"versionDisplay\":\"4.5.8\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-تحسين تجربة المستخدم\\n\",\"releaseDate\":\"2022-11-03\",\"releaseTimestamp\":\"2022-11-03T02:02:13Z\"},{\"versionDisplay\":\"4.5.6\",\"releaseNotes\":\"-وظيفة أمنية الهدايا متاحة أونلاين، مما يساعد المضيف على إكمال المهمة معًا.\\n-إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2022-09-30\",\"releaseTimestamp\":\"2022-09-30T08:44:16Z\"},{\"versionDisplay\":\"4.5.5\",\"releaseNotes\":\"-وظيفة أمنية الهدايا متاحة أونلاين، مما يساعد المضيف على إكمال المهمة معًا.\\n-إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2022-09-24\",\"releaseTimestamp\":\"2022-09-24T09:17:21Z\"},{\"versionDisplay\":\"4.5.1\",\"releaseNotes\":\"-تحسين تجربة المستخدم\\n-إصلاح الأخطاء\",\"releaseDate\":\"2022-09-03\",\"releaseTimestamp\":\"2022-09-03T07:43:02Z\"},{\"versionDisplay\":\"4.5.0\",\"releaseNotes\":\"- نمط الصفحة الرئيسية الجديدة، والوصول السريع إلى غرف المرح!\\n- أضف رف هدايا إلى بطاقة ملفك الشخصي في الغرفة لتسهيل تقديم الهدايا! واستمتع بإثارة تأثيرات تقديم الهدايا المستمرة.\\n-العلامة التجارية الجديدة لكرنفال عملة الفاكهة. انضم إلى حزب الفاكهة واربح العملات المعدنية!\\n- النوافذ المنبثقة المحسنة لدخول الغرفة ، والدعوة إلى الميكروفون، وتعديل المعلومات الرسمية وغيرها من الوحدات.\\n- إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2022-08-20\",\"releaseTimestamp\":\"2022-08-20T08:53:34Z\"},{\"versionDisplay\":\"4.4.5\",\"releaseNotes\":\"-إصلاح الأخطاء\\n-تحسين تجربة المستخدم\",\"releaseDate\":\"2022-07-20\",\"releaseTimestamp\":\"2022-07-20T15:19:16Z\"},{\"versionDisplay\":\"4.4.0\",\"releaseNotes\":\"- لعبة أونو مصغرة جديدة! لعبة ورق حماسية وممتعة، اجمع أصدقاءك واستمتع بها!\\n- إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2022-06-24\",\"releaseTimestamp\":\"2022-06-24T19:46:26Z\"},{\"versionDisplay\":\"4.3.23\",\"releaseNotes\":\"- أصبحت خاصية التصويت متوفرة مرة أخرى، تعال وجرب!\\n- PK وقت المعركة الممتع متوفر الآن، ادعم مذيعك المفضل للفوز بالتذكار!\\n- إصلاحات أخطاء بسيطة\",\"releaseDate\":\"2022-06-07\",\"releaseTimestamp\":\"2022-06-07T17:14:06Z\"},{\"versionDisplay\":\"4.3.022\",\"releaseNotes\":\"- تتوفر لعبة لودو المصغرة الجديدة تمامًا، انضم واستمتع بهذه اللعبة المشوقة مع أصدقائك!\\n- كن أفضل مضيف للعبة وفز بجولات وإطارات وعملات يومية!\\n- أرسل هدايا إلى المستخدمين المفضلين لديك واحصل على شارة شرف مميزة لغرفتك.\\n- لوحة نتائج الهدايا متوفرة على الإنترنت، يمكنك التحقق من قيمة الهدايا المستلمة بسهولة!\\n- تم تحسين رمز أنواع الغرف ورفع الصور وتحميلها ومشكلات التجربة الأخرى\",\"releaseDate\":\"2022-05-31\",\"releaseTimestamp\":\"2022-05-31T20:55:02Z\"},{\"versionDisplay\":\