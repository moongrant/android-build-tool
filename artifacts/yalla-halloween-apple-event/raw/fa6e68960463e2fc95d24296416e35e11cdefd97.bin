 hinweg zu verfolgen:\",\"dataCategories\":[{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Mit dir verknüpfte Daten\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden möglicherweise erfasst und mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"}]},{\"privacyType\":\"Nicht mit dir verknüpfte Daten\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"Die folgenden Daten werden zwar möglicherweise erfasst, aber nicht mit deiner Identität verknüpft:\",\"dataCategories\":[{\"dataCategory\":\"Kennungen\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Diagnose\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"17+\",\"value\":600,\"rank\":4,\"advisories\":[\"Häufig/stark ausgeprägt: simuliertes Glücksspiel\",\"Unbeschränkter Zugang zum Web\",\"Selten/schwach ausgeprägt: obszöner oder vulgärer Humor\",\"Selten/schwach ausgeprägt: Szenen mit erotischen Anspielungen\"]}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/de/app/falla-make-new-friends/id1560121894\",\"userRating\":{\"value\":4.1,\"ratingCount\":27,\"ratingCountList\":[4,2,0,2,19],\"ariaLabelForRatings\":\"4.1 Sterne\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"genreDisplayName\":\"Unterhaltung\",\"name\":\"Falla-Make new friends\",\"isPreorder\":false,\"artistName\":\"Shenzhen Yinguo Network Technology Co., Ltd.\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Erfordert iOS 11.0 oder neuer.\"}},\"platformAttributes\":{\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1560121894\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855626481\",\"type\":\"get\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":354852864}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1560121894\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855626481\",\"type\":\"update\",\"priceFormatted\":\"0,00 €\",\"price\":0,\"currencyCode\":\"EUR\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":354852864}]}],\"minimumMacOSVersion\":\"11.0\",\"requires32bit\":false,\"releaseDate\":\"2021-04-05\",\"hasInAppPurchases\":true,\"bundleId\":\"com.yinguo.falla\",\"description\":{\"standard\":\"Falla is a real-time group voice chat application for multiple players. Here we have users from more than 40 countries and they create chat rooms in different topics. You can find new friends who share the same interests with you here, chatting with them and enjoying the party!\\nWe have the following functions:\\n\\n-Free\\nYou can have free, high-quality and stable voice chat through the Internet.\\n\\n-Online party\\nHere we have various online parties, rooms of topics in birthday party, wedding party, war drum game and so on.\\n\\n-Gorgeous gifts\\nWhile enjoying chatting with your friends, you can send them gifts. Gorgeous effects are coming with gift sent. You can have so much fun~\\n\\n-One-on-one private chat\\nYou can have private chat with friends, texting, sending pictures and voice message. \"},\"hasMessagesExtension\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple126/v4/f1/68/43/f168434a-c1f6-cf37-68f1-27c5ff3048c6/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/{w}x{h}{c}.{f}\",\"bgColor\":\"2af8be\",\"textColor1\":\"011312\",\"textColor2\":\"161616\",\"textColor3\":\"0a4134\",\"textColor4\":\"1a4338\"},\"privacyPolicyUrl\":\"https://web.falla.live/#/app/policy\",\"videoPreviewsByType\":