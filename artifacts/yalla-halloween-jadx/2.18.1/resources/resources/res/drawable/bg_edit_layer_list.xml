<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/transparent"/>
            <padding android:left="2dp"/>
        </shape>
    </item>
    <item
        android:top="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_FFFFFFF"/>
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
            <corners android:radius="4dp"/>
            <stroke
                android:width="1px"
                android:color="@color/font_line"/>
        </shape>
    </item>
    <item>
        <shape>
            <padding
                android:left="4dp"
                android:right="4dp"/>
        </shape>
    </item>
</layer-list>
