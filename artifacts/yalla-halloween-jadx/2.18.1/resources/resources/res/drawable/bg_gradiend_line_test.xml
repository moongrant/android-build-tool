<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="360dp"/>
            <gradient
                android:startColor="#ff47dbd5"
                android:endColor="#ffee742f"
                android:useLevel="true"
                android:angle="90"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="1dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="360dp"/>
            <gradient
                android:startColor="#ffdd6cfd"
                android:endColor="#ff3e33b6"
                android:useLevel="true"
                android:angle="180"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
