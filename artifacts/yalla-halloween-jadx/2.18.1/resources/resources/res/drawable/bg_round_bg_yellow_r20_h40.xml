<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#ffdc39"
                android:endColor="#ffb21d"
                android:angle="-90"
                android:type="linear"/>
            <corners android:radius="20dp"/>
            <size
                android:height="40dp"
                android:width="275dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#ffffdc39"/>
            <corners android:radius="20dp"/>
            <size
                android:height="40dp"
                android:width="275dp"/>
        </shape>
    </item>
</selector>
