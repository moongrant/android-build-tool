<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/color_FFE8E8E8"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.app.base.view.FixedTabLayout
        android:id="@+id/tabLayout"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:scrollIndicators="none"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/color_FF5F5F5F"
        app:tabTextAppearance="@style/tabLayout_style_badge"
        app:tabTextColor="@color/color_FFB7B7B7"/>
    <com.app.base.view.ViewPagerFixed
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
