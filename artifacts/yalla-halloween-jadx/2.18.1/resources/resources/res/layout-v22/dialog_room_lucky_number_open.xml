<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="325dp">
    <ImageView
        android:id="@+id/ivBigBg"
        android:background="@drawable/shape_bg_dialog_lucky_open_bg_r16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivBottomBg"
        app:layout_constraintStart_toStartOf="@+id/ivBottomBg"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivBottomBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_lucky_number_open_bg"
        app:layout_constraintBottom_toBottomOf="@+id/ivBigBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivTopBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_lucky_number_open_text_bg"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toTopOf="@+id/ivBigBg"/>
    <ImageView
        android:id="@+id/ivTopFg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_lucky_number_open_fg"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/head"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginTop="5dp"
        android:layout_centerInParent="true"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white_85"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toBottomOf="@+id/head"
        app:layout_constraintWidth="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/white_57"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintWidth="1"/>
    <com.yalla.yalla.ui.view.NumberViews
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toBottomOf="@+id/info"
        app:numData="999"
        app:numSize="XX"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/ok"
        android:background="@drawable/bgs_button_green_r360"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="35dp"
        android:layout_marginRight="25dp"
        android:text="@string/OK"
        android:layout_marginHorizontal="25dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toBottomOf="@+id/number"/>
    <View
        android:id="@+id/bottom"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBigBg"
        app:layout_constraintStart_toStartOf="@+id/ivBigBg"
        app:layout_constraintTop_toBottomOf="@+id/ok"/>
</androidx.constraintlayout.widget.ConstraintLayout>
