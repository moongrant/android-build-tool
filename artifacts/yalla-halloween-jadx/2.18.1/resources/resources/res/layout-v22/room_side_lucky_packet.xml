<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_lucky_packet"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <com.yalla.yalla.common.ui.view.SVGAView
        android:layout_gravity="top"
        android:id="@+id/iv_lucky_packet"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        app:autoPlay="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="5dp"
        app:source="svga/room_lucky_packet_side.svga"/>
    <com.yalla.yalla.common.ui.view.RoomDotView
        android:textSize="11sp"
        android:textColor="@color/color_white"
        android:id="@+id/tv_lucky_packet_num"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:text="@string/single_N"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="@+id/iv_lucky_packet"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/color_white_70"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lucky_Bag"
        android:autoSizeStepGranularity="1dp"
        android:autoSizePresetSizes="9dp"
        android:autoSizeMinTextSize="7dp"
        android:autoSizeMaxTextSize="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_lucky_packet"/>
</androidx.constraintlayout.widget.ConstraintLayout>
