<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/color_333333"
                android:id="@+id/tvDeleteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/Confirmation"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvDeletePrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/delete_your_account_prompt"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeleteTitle"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvDeletePromptContent1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxWidth="307dp"
                android:text="@string/delete_your_account_prompt_content1"
                android:layout_marginStart="33dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeletePrompt"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvDeletePromptContent2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxWidth="307dp"
                android:text="@string/delete_your_account_prompt_content2"
                android:layout_marginStart="33dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent1"/>
            <View
                android:background="@drawable/shape_circle_delete_account_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDeletePromptContent1"/>
            <View
                android:background="@drawable/shape_circle_delete_account_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDeletePromptContent2"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_delete_account_friend"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Friends"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvFriends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llFans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/llFriends"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_delete_account_fans"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/topic_Followers"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvFans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/llFans"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_delete_account_levle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Level"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/llLevel"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_delete_account_badge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Badges"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llCoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/llBadge"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/coin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coin"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvCoin"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llCrystal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:paddingStart="33dp"
                android:paddingEnd="33dp"
                app:layout_constraintTop_toBottomOf="@+id/llCoin"
                app:layout_goneMarginTop="9dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/icon_crystal_main_slide"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent2"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crystal"
                    android:layout_marginStart="5dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvCrystal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="17dp"
                    android:layout_height="9dp"
                    android:src="@drawable/icon_delete_account_jt"
                    android:layout_marginStart="10dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/rec_color_FE6C6C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvDeletePromptContent3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxWidth="307dp"
                android:text="@string/delete_your_account_prompt_content3"
                android:layout_marginStart="33dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCrystal"/>
            <View
                android:background="@drawable/shape_circle_delete_account_point"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDeletePromptContent3"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_666666"
                android:id="@+id/tvDeletePromptContent4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxWidth="307dp"
                android:layout_marginStart="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeletePromptContent3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:id="@+id/tvCancel"
        android:background="@drawable/selector_btn_bg_round_green_h36"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/Cancel"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"/>
    <com.yalla.support.statebutton.StateButton
        android:enabled="false"
        android:textSize="16dp"
        android:textColor="#00d8c9"
        android:gravity="center"
        android:id="@+id/tvConfirmDelete"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:normalStrokeColor="#00d8c9"
        app:normalStrokeWidth="1dp"
        app:pressedStrokeColor="#00d8c9"
        app:pressedStrokeWidth="1dp"
        app:radius="19dp"
        app:unableBackgroundColor="#00000000"
        app:unableStrokeColor="#e2e2e2"
        app:unableStrokeWidth="1dp"
        app:unableTextColor="#cccccc"/>
</LinearLayout>
