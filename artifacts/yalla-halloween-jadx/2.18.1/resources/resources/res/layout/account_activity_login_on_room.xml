<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/account_shape_bg_login_room_activity"
        android:layout_width="280dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@mipmap/account_ic_login_close"
            android:contentDescription="@null"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ivLoginIcon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/icon_default_head_color"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_on_room_tips"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivLoginIcon"/>
        <com.yalla.support.statebutton.StateButton
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btFaceBook"
            android:background="@color/color_902C75BA"
            android:layout_width="215dp"
            android:layout_height="40dp"
            android:layout_marginTop="34dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="Facebook"
            android:drawablePadding="-24dp"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_login_facebook"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            app:layout_constraintBottom_toTopOf="@+id/btLoginPhone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:radius="20dp"/>
        <com.yalla.support.statebutton.StateButton
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btLoginPhone"
            android:background="@color/color_00d8c9"
            android:layout_width="215dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="@string/login_Phone"
            android:drawablePadding="-24dp"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_login_phone"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            app:layout_constraintBottom_toTopOf="@+id/llOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:radius="20dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_5f5f5f"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTermsService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="20dp"
            android:text="@string/login_terms_service"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>
    </LinearLayout>
</FrameLayout>
