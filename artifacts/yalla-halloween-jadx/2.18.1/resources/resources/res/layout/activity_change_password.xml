<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/baseHeaderLayout"
        layout="@layout/base_header_layout"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_alpha_38_A3"
        android:gravity="start|center_vertical"
        android:background="@color/color_f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/set_password_desc"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/color_alpha_87_A1"
            android:textColorHint="@color/color_alpha_38_A3"
            android:gravity="start|center_vertical"
            android:id="@+id/txt_oldpwd"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/old_password"
            android:ems="10"
            android:singleLine="true"
            android:maxLength="24"
            android:layout_weight="1"
            android:inputType="textWebPassword"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"/>
        <ImageView
            android:id="@+id/iv_see_old"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/eye2"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <View style="@style/line_horizontal_1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/color_alpha_87_A1"
            android:textColorHint="@color/color_alpha_38_A3"
            android:gravity="start|center_vertical"
            android:id="@+id/txt_newpwd"
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/new_password"
            android:ems="10"
            android:singleLine="true"
            android:maxLength="24"
            android:layout_weight="1"
            android:inputType="textWebPassword"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"/>
        <ImageView
            android:id="@+id/iv_see_new"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/eye2"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <View style="@style/line_horizontal_1px"/>
    <Button
        android:enabled="false"
        android:textSize="18dp"
        android:textColor="@color/color_white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_submit"
        android:background="@drawable/selector_btn_bg_green_white_gray_r21"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_margin="16dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/Done"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
