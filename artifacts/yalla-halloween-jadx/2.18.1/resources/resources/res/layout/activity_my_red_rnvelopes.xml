<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/APP_THEME_BACKGROUND_COLOR">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <include layout="@layout/base_header_layout"/>
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="30dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_00d8c9"
                android:gravity="center"
                android:id="@+id/tv_received"
                android:background="@drawable/selector_lucky_coin_history_title_received"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/red_myreceived"
                android:paddingEnd="-1px"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_sendout"
                android:background="@drawable/selector_lucky_coin_history_title_sendout"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:text="@string/red_sendout"
                android:layout_marginStart="-1px"/>
        </LinearLayout>
    </FrameLayout>
    <com.app.base.view.ViewPagerFixed
        android:id="@+id/vp_red"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
