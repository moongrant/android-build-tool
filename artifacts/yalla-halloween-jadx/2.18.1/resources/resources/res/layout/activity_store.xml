<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_top_bg"
        android:background="@drawable/shape_store_coin_bg"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include layout="@layout/base_header_layout"/>
    <com.app.base.view.indicator.YlTableLayout
        android:id="@+id/store_magicIndicator"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"/>
    <TextView
        android:textSize="38dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="0"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/v_top_bg"
        app:layout_constraintTop_toBottomOf="@+id/store_magicIndicator"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_recharge"
        android:background="@drawable/shape_bg_store_coin_recharge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:text="@string/Recharge"
        android:drawablePadding="8dp"
        android:drawableEnd="@drawable/icon_recharge_go"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/v_top_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_balance"/>
    <ImageView
        android:id="@+id/iv_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/vp_store"
        app:layout_constraintEnd_toEndOf="@+id/v_top_bg"/>
    <com.app.base.view.ViewPagerFixed
        android:id="@+id/vp_store"
        android:background="@drawable/shape_bg_store_coin_bg_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_recharge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
