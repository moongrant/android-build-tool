<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/activity_test_image"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_margin="18dp"
        android:src="@drawable/icon_room_loading_first"/>
    <com.yalla.yalla.common.ui.view.SVGAView
        android:layout_gravity="center_horizontal"
        android:id="@+id/activity_test_svga"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_margin="18dp"
        android:src="@drawable/icon_room_loading_first"
        app:antiAlias="true"
        app:autoPlay="true"
        app:clearsAfterStop="false"
        app:fillMode="Forward"
        app:loopCount="0"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_test_recycler_view"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
