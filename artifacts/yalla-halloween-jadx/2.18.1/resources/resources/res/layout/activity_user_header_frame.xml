<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/ivBg"
            android:background="@drawable/bg_header_frame_head_bg"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include layout="@layout/base_header_layout"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/ivHeader"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="1dp"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="@+id/svgaHeaderFrame"
            app:layout_constraintEnd_toEndOf="@+id/svgaHeaderFrame"
            app:layout_constraintStart_toStartOf="@+id/svgaHeaderFrame"
            app:layout_constraintTop_toTopOf="@+id/svgaHeaderFrame"/>
        <com.yalla.yalla.common.ui.view.SVGAView
            android:id="@+id/svgaHeaderFrame"
            android:visibility="visible"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginTop="52dp"
            app:autoPlay="true"
            app:fillMode="Forward"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivBg"
            app:loopCount="0"
            style="@style/text_style_z11"/>
        <ImageView
            android:id="@+id/ivLock"
            android:background="@drawable/icon_header_frame_title_unlock"
            android:visibility="visible"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="17dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="@+id/svgaHeaderFrame"
            app:layout_constraintEnd_toEndOf="@+id/svgaHeaderFrame"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_alpha_38"
            android:gravity="center"
            android:id="@+id/tvLockState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_frame_lock_state"
            android:singleLine="true"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/svgaHeaderFrame"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_alpha_87"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tvMedalOfHonor"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_frame_unlock_automatically"
            android:minLines="3"
            android:singleLine="false"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLockState"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTop"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutBelow"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:background="@color/color_e2e2e2"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/bg_round_bg_green_r18_h36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/user_info_header_frame_replace"
            android:singleLine="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
