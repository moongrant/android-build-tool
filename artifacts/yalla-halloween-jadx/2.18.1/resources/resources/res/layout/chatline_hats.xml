<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/ChatItemRoot">
    <include layout="@layout/chatline_msg_user"/>
    <LinearLayout
        android:orientation="horizontal"
        style="@style/ChatItemContent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:id="@+id/tvContentMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send_you"
            android:layout_marginEnd="8dp"/>
        <com.yalla.yalla.common.ui.view.SVGAView
            android:layout_gravity="center"
            android:id="@+id/sdv_content_pic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>
</FrameLayout>
