<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/clRoot"
    android:background="@drawable/bg_shape_sheet_dialog_top"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivClosePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:src="@drawable/icon_dialog_close"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vLine"
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="38dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.rbrooks.indefinitepagerindicator.IndefinitePagerIndicator
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:dotColor="@color/color_e2e2e2"
        app:dotCount="5"
        app:dotRadius="3dp"
        app:dotSeparation="6dp"
        app:fadingDotCount="1"
        app:layout_constraintBottom_toTopOf="@+id/vLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectedDotColor="@color/color_00d8c9"
        app:selectedDotRadius="3.5dp"
        app:supportRTL="true"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/vpUserNewPost"
        android:paddingTop="39dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
