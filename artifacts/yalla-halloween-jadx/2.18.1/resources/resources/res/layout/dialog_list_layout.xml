<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_list_layout_bg"
        android:background="@drawable/bg_round_bg_white_r16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:elevation="4dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/dialog_list_layout_content"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ListView
                android:id="@+id/dialog_list_layout_listView"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/color_12000000"
                android:dividerHeight="0px"
                android:minHeight="56dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
