<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialog_pass_layout_layout_bg"
        android:background="@drawable/bg_round_bg_f7f5f6_r16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:elevation="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/dialog_pass_layout_layout_content"
                android:background="@drawable/bg_round_bg_fffeff_r16"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="8dp">
                <TextView
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_87000000"
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_tv_title"
                    android:padding="24dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_lock_title"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/dialog_pass_layout_lock_all_layout"
                    android:paddingBottom="12dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp">
                    <LinearLayout
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/dialog_pass_layout_lock_layout"
                        android:background="@drawable/icon_lock_close_gray"
                        android:paddingBottom="16.5dp"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/color_ffffff"
                            android:id="@+id/dialog_pass_layout_lock_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lock"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/dialog_pass_layout_unlock_layout"
                        android:background="@drawable/icon_lock_open_green"
                        android:paddingBottom="16.5dp"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/color_ffffff"
                            android:id="@+id/dialog_pass_layout_unlock_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dialog_unlock_tv"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_38000000"
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_tv_info"
                    android:paddingBottom="6dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:text="@string/dialog_lock_tips"
                    android:maxLines="3"
                    android:singleLine="false"/>
                <FrameLayout
                    android:id="@+id/dialog_pass_layout_edit_frameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:layout_marginBottom="12dp"
                    android:layoutDirection="ltr">
                    <EditText
                        android:id="@+id/dialog_pass_layout_edit"
                        android:background="@null"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:cursorVisible="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="4"
                        android:inputType="numberPassword"/>
                    <TableRow
                        android:gravity="center"
                        android:id="@+id/dialog_pass_layout_table"
                        android:background="@drawable/bg_round_bg_white_r4_stroke_cccccc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layoutDirection="ltr">
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/dialog_pass_layout_table_0_iv"
                            android:padding="18dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_room_lock_password"
                            android:layout_weight="1"
                            android:contentDescription="@null"/>
                        <View
                            android:id="@+id/dialog_pass_layout_table_1_line"
                            android:background="@color/color_CCCCCC"
                            android:layout_width="0.5dp"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/dialog_pass_layout_table_1_iv"
                            android:padding="18dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_room_lock_password"
                            android:layout_weight="1"
                            android:contentDescription="@null"/>
                        <View
                            android:id="@+id/dialog_pass_layout_table_2_line"
                            android:background="@color/color_CCCCCC"
                            android:layout_width="0.5dp"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/dialog_pass_layout_table_2_iv"
                            android:padding="18dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_room_lock_password"
                            android:layout_weight="1"
                            android:contentDescription="@null"/>
                        <View
                            android:id="@+id/dialog_pass_layout_table_3_line"
                            android:background="@color/color_CCCCCC"
                            android:layout_width="0.5dp"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/dialog_pass_layout_table_3_iv"
                            android:padding="18dp"
                            android:visibility="invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_room_lock_password"
                            android:layout_weight="1"
                            android:contentDescription="@null"/>
                    </TableRow>
                </FrameLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/color_F61414"
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_error_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/dialog_error_tips"
                    android:drawableLeft="@drawable/icon_error_red"
                    android:drawablePadding="6dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_confirm_layout"
                    android:background="@drawable/selector_btn_bg_round_green_h36"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="24dp"
                    android:layout_marginBottom="24dp"
                    android:minWidth="74dp">
                    <ProgressBar
                        android:id="@+id/dialog_pass_layout_confirm_progress"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:indeterminateTint="@color/white"
                        android:indeterminateTintMode="src_atop"
                        style="?android:attr/progressBarStyle"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/dialog_pass_layout_tv_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/button_CONFIRM"
                        android:textAllCaps="true"/>
                </LinearLayout>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_tv_more_features"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/password_dialog_more_features"
                    android:drawablePadding="3dp"
                    android:drawableEnd="@drawable/icon_password_dialog_bottom"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dialog_pass_layout_layout_follow"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dialog_pass_layout_layout_content">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/color_333333"
                    android:gravity="bottom|center_horizontal"
                    android:id="@+id/dialog_pass_layout_tv_follow_room"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:text="@string/password_dialog_Follow_room"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/color_333333"
                    android:gravity="bottom|center_horizontal"
                    android:id="@+id/dialog_pass_layout_tv_unfollow_room"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:text="@string/password_dialog_unFollow_Room"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/color_333333"
                    android:gravity="bottom|center_horizontal"
                    android:id="@+id/dialog_pass_layout_tv_unjoin_room"
                    android:paddingBottom="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:text="@string/password_dialog_unJoin_room"/>
                <View
                    android:id="@+id/dialog_pass_layout_tv_join_line"
                    style="@style/line_horizontal_1px"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/color_333333"
                    android:gravity="center"
                    android:id="@+id/dialog_pass_layout_tv_unjoin_unfollow"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:text="@string/password_dialog_UnJoin_unFollow"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/dialog_pass_layout_iv_cancel"
            android:padding="12.5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_cancel_gray"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
