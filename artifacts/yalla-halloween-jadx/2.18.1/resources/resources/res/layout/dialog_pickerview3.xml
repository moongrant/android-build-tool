<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layoutTop"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_108EE9"
            android:id="@+id/cancel"
            android:background="@drawable/ripple_borderless"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"
            android:layout_weight="0"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintHorizontal_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_108EE9"
            android:id="@+id/done"
            android:background="@drawable/ripple_borderless"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Done"
            android:layout_weight="0"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="@color/font_line"
        android:layout_height="1dp"
        style="@style/line_horizontal_1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layoutPickerView"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="206dp">
        <com.yalla.yalla.common.ui.view.PickerView
            android:id="@+id/pickerView0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:isCyclic="false"/>
        <com.yalla.yalla.common.ui.view.PickerView
            android:id="@+id/pickerView1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:isCyclic="false"/>
        <com.yalla.yalla.common.ui.view.PickerView
            android:id="@+id/pickerView2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:isCyclic="false"/>
    </LinearLayout>
</LinearLayout>
