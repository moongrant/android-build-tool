<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/niv_header"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_white"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:text="32333333233333323333332333333233333323333332333333233333"
            android:singleLine="true"
            android:layout_weight="0"
            android:layout_marginStart="16dp"/>
        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/iv_mora_gift_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/icon_game_gift_default"/>
        <ImageView
            android:paddingBottom="2dp"
            android:visibility="visible"
            android:layout_width="12dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chatline_gift_x"
            android:scaleType="fitCenter"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/iv_hundred"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_gift_num1"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/iv_ten"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_gift_num7"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/iv_one"
                android:layout_width="12dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_gift_num1"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_mora_pk"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_room_bottom_game_box_mora_pk_1"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="@color/color_3B395D"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</FrameLayout>
