<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_round_bg_white_r16"
        android:layout_width="288dp"
        android:layout_height="wrap_content">
        <Button
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bt_room_join"
            android:background="@drawable/btn_bg_default_r20"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="232dp"
            android:layout_height="35dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_room_join"
            style="?android:attr/borderlessButtonStyle"/>
        <ImageView
            android:id="@+id/room_join_dialog_dismiss"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/icon_room_notification_dialog_dismiss"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_room_join"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="105dp"
            android:minWidth="232dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_87000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/member_privilege"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/member_logo"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_room_member"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/take_mic_freely"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_room_take_mic"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/view_members_posts"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_room_relax"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/have_more_followers"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/icon_room_follow"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_38000000"
            android:id="@+id/room_join_room_max_member"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/room_join_head_image"
            app:layout_constraintTop_toBottomOf="@+id/room_join_room_id"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_87000000"
            android:ellipsize="end"
            android:id="@+id/room_join_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:maxWidth="160dp"
            android:lines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@+id/room_join_head_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_38000000"
            android:id="@+id/room_join_room_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/room_id_icon"
            app:layout_constraintStart_toEndOf="@+id/room_id_icon"
            app:layout_constraintTop_toTopOf="@+id/room_id_icon"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/room_join_head_image"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.yalla.common.ui.view.UserPrettyIdView
            android:id="@+id/room_id_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/room_join_head_image"
            app:layout_constraintStart_toEndOf="@+id/room_join_head_image"
            app:layout_constraintTop_toTopOf="@+id/room_join_head_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
