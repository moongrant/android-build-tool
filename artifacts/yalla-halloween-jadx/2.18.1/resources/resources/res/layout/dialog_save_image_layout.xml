<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialog_save_image_layout_bg"
        android:background="@color/tr_00"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_87000000"
            android:gravity="center"
            android:id="@+id/dialog_save_image_layout_save"
            android:background="@drawable/bg_round_bg_white_r16"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save_image_phone"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>
</LinearLayout>
