<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_room_share_pop_share_bg_layout"
            android:layout_width="300dp"
            android:layout_height="300dp">
            <com.yalla.yalla.util.netimage.NetImageView
                android:id="@+id/layout_room_share_pop_share_bg_iv"
                android:background="@drawable/bg_transparent_stroke_gray"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:background="@drawable/icon_share_instagram_yalla_logo_bg"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_alignParentBottom="true">
                <ImageView
                    android:id="@+id/layout_room_share_pop_share_logo_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/icon_share_instagram_yalla_logo"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="15dp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/color_FFFFFFF"
                    android:id="@+id/layout_room_share_pop_share_id_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Room Id:123456"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/layout_room_share_pop_share_logo_iv"/>
                <ImageView
                    android:id="@+id/layout_room_share_pop_share_app_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/icon_yalla_live"
                    android:layout_above="@+id/layout_room_share_pop_share_id_tv"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/layout_room_share_pop_share_logo_iv"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:background="@color/transparent60"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <EditText
                android:gravity="start|top"
                android:background="@drawable/bg_edit_white"
                android:paddingTop="11dp"
                android:layout_width="276dp"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:hint="Say something…"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="12.5dp"
                android:layout_marginEnd="12.5dp"
                style="@style/text_style_z12"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/color_FFFFFFF"
            android:id="@+id/layout_room_share_pop_share_send_tv"
            android:background="@color/color_00d8c9"
            android:layout_width="300dp"
            android:layout_height="44dp"
            android:text="@string/share"
            style="@style/text_style_z20"/>
    </LinearLayout>
</LinearLayout>
