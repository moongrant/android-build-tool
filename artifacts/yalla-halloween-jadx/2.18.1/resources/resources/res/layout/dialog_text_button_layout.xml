<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/dialog_text_button_layout_layout_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialog_text_button_layout_layout_bg"
        android:background="@drawable/bg_round_bg_white_r16"
        android:paddingTop="4dp"
        android:clickable="true"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="40dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_text_button_layout_layout_content"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/color_87000000"
                android:id="@+id/dialog_text_button_layout_tv_title"
                android:paddingLeft="24dp"
                android:paddingTop="20dp"
                android:paddingRight="24dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_54000000"
                android:id="@+id/dialog_text_button_layout_tv_content"
                android:paddingLeft="24dp"
                android:paddingTop="20dp"
                android:paddingRight="24dp"
                android:paddingBottom="20dp"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content \10Content "
                android:maxLines="6"
                android:singleLine="false"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/dialog_text_button_layout_bt_confirm"
                android:background="@drawable/btn_bg_default_r20"
                android:layout_width="232dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:foreground="@drawable/ripple_border_round"
                android:text="@string/Confirm"
                android:textAllCaps="true"
                style="?attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
