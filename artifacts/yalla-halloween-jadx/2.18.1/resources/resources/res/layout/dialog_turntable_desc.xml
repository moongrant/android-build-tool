<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/circle_coner_turntable_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:background="@drawable/circle_coner_turntable_title_bg"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/turntable_help"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="23dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_B2D8D8D8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/turntable_help_1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_B2D8D8D8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/turntable_help_2"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_B2D8D8D8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/turntable_help_3"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_B2D8D8D8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/turntable_help_4"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="23dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_ffffff"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/turntable_punish"
            android:paddingEnd="10dp"/>
    </LinearLayout>
    <ListView
        android:id="@+id/current_result_listview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="4dp"
        android:listSelector="#00000000"
        android:divider="@null"
        android:paddingStart="20dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/selector_btn_bg_round_green_h44"
        android:layout_width="232dp"
        android:layout_height="44dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/guid_enter"/>
</LinearLayout>
