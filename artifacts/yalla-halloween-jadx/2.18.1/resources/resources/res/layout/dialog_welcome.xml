<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_round_bg_white_r16"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/dialog_welcom_dismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@mipmap/icon_sheet_dialog_close"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="21dp"
            android:textColor="@color/app_color_"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/welcome_yalla"/>
        <TextView
            android:textSize="15dp"
            android:id="@+id/tv_welcome_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/welcome_reward"
            android:layout_marginStart="29dp"
            android:layout_marginEnd="29dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_welcome_conferm"
            android:background="@drawable/btn_bg_default_r20"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="230dp"
            android:layout_height="35dp"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="25dp"
            android:text="@string/sgin_ok"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="122dp"
        android:src="@drawable/welcome_sign"/>
</FrameLayout>
