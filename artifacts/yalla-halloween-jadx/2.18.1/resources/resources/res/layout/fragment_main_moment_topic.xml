<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.app.base.view.indicator.YlTableLayout
            android:id="@+id/tlMomentTopic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_toStartOf="@+id/ivSearch"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/icon_topic_recnmmend_line"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_weight="0"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/ivSearch"/>
        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="43dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_topic_search_gray"
            android:layout_weight="0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.app.base.view.ViewPagerFixed
        android:id="@+id/vpMomentTopic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
