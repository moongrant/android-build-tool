<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_alpha_38_A3"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_tip"
            android:background="@color/APP_THEME_BACKGROUND_COLOR"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="@string/hot"
            android:paddingStart="8dp"/>
        <com.app.base.view.pullrefresh.XRefreshLayout
            android:id="@+id/xrlSearchMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srlEnableRefresh="false">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rec_serach_room"
                android:paddingTop="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </com.app.base.view.pullrefresh.XRefreshLayout>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/nodata_layout"/>
</RelativeLayout>
