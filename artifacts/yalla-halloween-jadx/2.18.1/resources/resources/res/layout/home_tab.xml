<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/nav_home"
        android:background="@drawable/ripple_borderless"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="6dp">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/img_home"
            android:visibility="visible"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:lottie_fileName="lottie/anim_lottie_main_room.json"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_8A000000"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_moment"
        android:background="@drawable/ripple_borderless"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/img_moments"
                android:visibility="visible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:lottie_fileName="lottie/anim_lottie_main_moment.json"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_8A000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_moments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moments"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_moments_tab_new"
            android:background="@drawable/bg_red_point_circle"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="2dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_moment_notice_count"
            android:background="@drawable/bg_red_point_circle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="1dp"
            android:text="@string/single_N"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_message"
        android:background="@drawable/ripple_borderless"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/img_message"
                android:visibility="visible"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:lottie_fileName="lottie/anim_lottie_main_message.json"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/color_8A000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_message"/>
        </LinearLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_message_tab_new"
            android:background="@drawable/bg_red_point_circle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="1dp"
            android:text="@string/single_N"
            android:layout_marginStart="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
