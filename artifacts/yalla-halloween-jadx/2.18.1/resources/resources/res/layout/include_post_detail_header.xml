<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/abl_post_detail"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/activity_post_detail_header_ctl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:collapsedTitleGravity="center"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"
        app:titleEnabled="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yalla.yalla.ui.view.MomentDetailView
                android:id="@+id/activity_post_detail_header_PostDetailHeaderView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"/>
            <com.yalla.yalla.ui.activity.moment.momentDetail.PostDetailTopicHeader
                android:id="@+id/activity_post_detail_header_PostDetailTopicHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
    <com.yalla.yalla.ui.activity.moment.momentDetail.PostDetailListTitleView
        android:id="@+id/activity_post_detail_header_PostDetailListTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/color_alpha_8"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</com.google.android.material.appbar.AppBarLayout>
