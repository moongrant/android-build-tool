<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white_"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/layout"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Following_Topics"
            android:paddingStart="16dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/button_more"
            android:drawableEnd="@drawable/icon_arrow_right"
            android:paddingEnd="4dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/line_horizontal_1px"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_0"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">
            <com.yalla.yalla.util.netimage.NetImageView
                android:id="@+id/head_0"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_head_default"
                android:scaleType="centerCrop"
                android:layout_marginEnd="10dp"
                android:layout_alignParentStart="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/name_0"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="New_TopicNew_TopicNew_TopicNew_TopicNew_TopicNew_Topic"
                android:maxLines="1"
                android:drawablePadding="10dp"
                android:drawableEnd="@drawable/ic_topic_owner"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="95dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/head_0"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/EditText_Alignment"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_0"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1"
                android:maxLines="1"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/member_info_0"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_info_0"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/topic_Followers"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:id="@+id/click_member_0"
                android:background="@color/tr_00"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_1"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">
            <com.yalla.yalla.util.netimage.NetImageView
                android:id="@+id/head_1"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_head_default"
                android:scaleType="centerCrop"
                android:layout_marginEnd="10dp"
                android:layout_alignParentStart="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/name_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="New_TopicNew_TopicNew_TopicNew_TopicNew_TopicNew_Topic"
                android:maxLines="1"
                android:drawablePadding="10dp"
                android:drawableEnd="@drawable/ic_topic_owner"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="95dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/head_1"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/EditText_Alignment"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1"
                android:maxLines="1"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/member_info_1"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_info_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/topic_Followers"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:id="@+id/click_member_1"
                android:background="@color/tr_00"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_2"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">
            <com.yalla.yalla.util.netimage.NetImageView
                android:id="@+id/head_2"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_head_default"
                android:scaleType="centerCrop"
                android:layout_marginEnd="10dp"
                android:layout_alignParentStart="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/name_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="New_TopicNew_TopicNew_TopicNew_TopicNew_TopicNew_Topic"
                android:maxLines="1"
                android:drawablePadding="10dp"
                android:drawableEnd="@drawable/ic_topic_owner"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="95dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/head_2"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/EditText_Alignment"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1"
                android:maxLines="1"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/member_info_2"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/member_info_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/topic_Followers"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageButton
                android:id="@+id/click_member_2"
                android:background="@color/tr_00"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <View
        android:background="@color/color_f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
</LinearLayout>
