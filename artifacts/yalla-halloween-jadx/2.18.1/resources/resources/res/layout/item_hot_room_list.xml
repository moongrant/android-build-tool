<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/item_hot_bg"
    android:duplicateParentState="true"
    android:layout_width="105dp"
    android:layout_height="105dp">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/room_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_room_online"
        android:background="@drawable/bg_online_style"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginTop="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="@+id/room_header"
        app:layout_constraintTop_toTopOf="@+id/room_header">
        <com.yalla.yalla.common.ui.view.SVGAView
            android:id="@+id/lav_hot_room_live"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:autoPlay="true"
            app:source="svga/anim_room_live.svga"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/tv_online_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|top"
        android:orientation="horizontal"
        android:id="@+id/ll_room_name"
        android:background="@drawable/bg_gradient_black"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_honor"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="9dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
