<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|top"
    android:id="@+id/item_image_more_item_layout"
    android:padding="3dp"
    android:focusableInTouchMode="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/item_image_more_item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/icon_picture_default_circluar"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:minWidth="90dp"
        android:minHeight="90dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/item_image_more_item_gif"
        android:background="@drawable/icon_gif_circle"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/single_GIF"
        android:layout_alignBottom="@+id/item_image_more_item_image"
        android:layout_alignEnd="@+id/item_image_more_item_image"/>
</RelativeLayout>
