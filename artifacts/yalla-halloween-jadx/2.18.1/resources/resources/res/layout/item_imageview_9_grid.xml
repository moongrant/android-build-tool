<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|top"
    android:orientation="vertical"
    android:id="@+id/item_imageview_9_grid_layout"
    android:padding="3dp"
    android:focusableInTouchMode="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/item_imageview_9_grid_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:minWidth="80dp"
        android:minHeight="80dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/item_imageview_9_grid_gif"
        android:background="@drawable/icon_gif_circle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/single_GIF"
        android:layout_alignBottom="@+id/item_imageview_9_grid_image"
        android:layout_alignEnd="@+id/item_imageview_9_grid_image"/>
</RelativeLayout>
