<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/item_post_detail_gift_list_message_item_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/head"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/icon_head_default_circle"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/officials"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="16dp"
        android:layout_marginTop="-2dp"
        android:src="@drawable/icon_userinfo_official"
        android:layout_marginEnd="-4.5dp"
        app:layout_constraintEnd_toEndOf="@+id/head"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <com.yalla.yalla.common.ui.view.UserTagView
        android:id="@+id/praise_userTagView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/head"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_height="1px"
        android:layout_marginStart="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/head"
        style="@style/line_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
