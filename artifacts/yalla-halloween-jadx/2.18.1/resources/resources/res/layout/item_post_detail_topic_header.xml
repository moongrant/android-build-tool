<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white_"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_post_detail_topic_header_layout"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/item_post_detail_topic_header_iv_head"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_head_default_circular"
            android:scaleType="fitXY"
            android:layout_weight="0"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:paddingStart="10dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/item_post_detail_topic_header_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="#New Topic Name"
                android:maxLines="1"
                android:drawablePadding="5dp"
                android:drawableEnd="@drawable/ic_topic_owner"
                style="@style/EditText_Alignment"/>
            <com.yalla.yalla.ui.view.TopicFollowPostNumberView
                android:id="@+id/item_post_detail_topic_header_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:id="@+id/item_post_detail_topic_header_info_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="I want to add topicsI 123want to add…"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_arrow_right"
            android:layout_weight="0"/>
    </LinearLayout>
    <View
        android:id="@+id/item_post_detail_topic_header_line"
        android:background="@color/APP_THEME_BACKGROUND_COLOR"
        android:layout_height="4dp"
        style="@style/line_horizontal"/>
</LinearLayout>
