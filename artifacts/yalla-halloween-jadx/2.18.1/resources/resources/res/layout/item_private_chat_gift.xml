<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="95dp">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_FFFFFFF_70"
        android:gravity="center"
        android:id="@+id/item_private_chat_gift_price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="7dp"
        android:text="1"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/item_private_chat_gift_gift_iv"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/icon_gift_default_black"
        android:layout_above="@+id/item_private_chat_gift_price_tv"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/item_private_chat_gift_tag_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_gift_tag_activity"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/item_private_chat_gift_stroke_gray_line"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/item_private_chat_gift_left_line"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"/>
        <View
            android:id="@+id/item_private_chat_gift_top_line"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <View
            android:id="@+id/item_private_chat_gift_bottom_line"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
        <View
            android:id="@+id/item_private_chat_gift_right_line"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/item_private_chat_gift_stroke_green_line"
        android:background="@drawable/gift_select_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
