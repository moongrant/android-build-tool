<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:foreground="@drawable/ripple_border">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/niv_header"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_official"
        android:visibility="visible"
        android:layout_width="27dp"
        android:layout_height="16dp"
        android:src="@drawable/icon_userinfo_official_reverse"
        app:layout_constraintStart_toStartOf="@+id/niv_header"
        app:layout_constraintTop_toTopOf="@+id/niv_header"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_87000000"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:singleLine="true"
        android:drawablePadding="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_bio"
        app:layout_constraintEnd_toStartOf="@+id/iv_sex"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/niv_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/iv_sex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_male"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/iv_vip"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        app:layout_goneMarginEnd="45dp"/>
    <com.yalla.yalla.common.ui.view.UserPremiumView
        android:id="@+id/iv_vip"
        android:visibility="gone"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:src="@drawable/ic_vip2"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/ivKaVip"
        app:layout_constraintStart_toEndOf="@+id/iv_sex"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <ImageView
        android:id="@+id/ivKaVip"
        android:visibility="gone"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginEnd="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_vip"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_38000000"
        android:gravity="center_vertical"
        android:id="@+id/tv_bio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/Userinfo_Sign_Hint"
        android:singleLine="true"
        android:layout_weight="0"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_follow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <ImageView
        android:id="@+id/iv_follow"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
