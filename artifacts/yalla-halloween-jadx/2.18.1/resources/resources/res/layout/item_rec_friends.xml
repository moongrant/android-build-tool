<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_item_layout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:foreground="@drawable/ripple_border">
    <RelativeLayout
        android:id="@+id/v_header"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/niv_header"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_head_default_circle"
            android:layout_centerInParent="true"/>
        <com.yalla.yalla.common.ui.view.SVGAView
            android:id="@+id/niv_head_frame_svga"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerInParent="true"
            app:antiAlias="true"
            app:autoPlay="true"
            app:clearsAfterStop="false"
            app:fillMode="Forward"
            app:loopCount="0"/>
        <ImageView
            android:id="@+id/iv_official"
            android:visibility="visible"
            android:layout_width="25dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/icon_userinfo_official_reverse"
            android:layout_marginStart="5dp"/>
        <com.yalla.yalla.common.ui.view.UserPremiumView
            android:id="@+id/iv_vip"
            android:visibility="invisible"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_vip2"
            android:layout_alignBottom="@+id/niv_header"
            android:layout_alignEnd="@+id/niv_header"/>
    </RelativeLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_87000000"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/name"
        android:singleLine="true"
        android:drawablePadding="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_bio"
        app:layout_constraintEnd_toStartOf="@+id/iv_sex"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/v_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="84dp"/>
    <ImageView
        android:id="@+id/iv_sex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_male"
        android:layout_marginEnd="84dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_38000000"
        android:gravity="center_vertical"
        android:id="@+id/tv_bio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/Userinfo_Sign_Hint"
        android:singleLine="true"
        android:layout_weight="0"
        android:layout_marginEnd="84dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <ImageView
        android:id="@+id/iv_room"
        android:background="@drawable/ripple_border_round"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_friends_live"
        android:scaleType="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/color_alpha_12"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
