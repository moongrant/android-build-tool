<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/sdv_top1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="28dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="40dp"/>
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-11dp"
        android:src="@drawable/medalrankingstong_avatar_1"
        android:layout_alignTop="@+id/sdv_top1"
        android:layout_marginStart="-22dp"
        android:layout_toEndOf="@+id/sdv_top1"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/sdv_top2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:layout_alignBottom="@+id/sdv_top1"
        android:layout_centerHorizontal="true"
        android:layout_toStartOf="@+id/sdv_top1"/>
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-11dp"
        android:src="@drawable/medalrankingstong_avatar_2"
        android:layout_alignTop="@+id/sdv_top2"
        android:layout_marginStart="-22dp"
        android:layout_toEndOf="@+id/sdv_top2"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/sdv_top3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:layout_alignBottom="@+id/sdv_top1"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="40dp"
        android:layout_toEndOf="@+id/sdv_top1"/>
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-11dp"
        android:src="@drawable/medalrankingstong_avatar_3"
        android:layout_alignTop="@+id/sdv_top3"
        android:layout_marginStart="-22dp"
        android:layout_toEndOf="@+id/sdv_top3"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="9dp"
        android:layout_below="@+id/sdv_top1">
        <ImageView
            android:layout_width="13dp"
            android:layout_height="15dp"
            android:src="@drawable/me"
            android:layout_marginStart="15dp"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/sdv_me"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="11dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textColor="@color/color_87000000"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_87000000"
            android:gravity="center"
            android:id="@+id/tv_starnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_badge_star"
            android:layout_marginEnd="25dp"/>
    </LinearLayout>
    <View
        android:background="@color/font_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@+id/ll"/>
</RelativeLayout>
