<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/fr_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_officials"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="16dp"
        android:layout_marginTop="-2dp"
        android:src="@drawable/icon_userinfo_official"
        android:layout_marginEnd="-2dp"
        app:layout_constraintEnd_toEndOf="@+id/fr_icon"
        app:layout_constraintTop_toTopOf="@+id/fr_icon"/>
    <com.yalla.yalla.common.ui.view.UserTagView
        android:id="@+id/searchUserTagView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        android:layout_marginStart="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fr_icon"
        style="@style/line_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
