<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="47dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_select_dialog_layout_content"
        android:background="@color/white"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/ripple_border">
        <ImageView
            android:layout_gravity="top"
            android:id="@+id/item_select_dialog_iv_select"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_select_gray_round"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_alpha_54"
            android:id="@+id/item_select_dialog_tv_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/item_select_dialog_view_line"
        android:background="@color/color_12000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="24dp"
        android:layout_alignParentBottom="true"
        style="@style/line_horizontal_1px"/>
</RelativeLayout>
