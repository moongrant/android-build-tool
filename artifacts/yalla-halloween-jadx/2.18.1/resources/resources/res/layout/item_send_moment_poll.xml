<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <EditText
        android:textSize="13sp"
        android:textColor="@color/color_FF5F5F5F"
        android:textColorHint="@color/color_C7C7C7"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/content"
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/send_moment_poll_item_option_XXX"
        android:maxLength="60"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/delete"
        android:background="@drawable/ripple_borderless"
        android:visibility="gone"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:src="@drawable/ic_poll_delete_item"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
