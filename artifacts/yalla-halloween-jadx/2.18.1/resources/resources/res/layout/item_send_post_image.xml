<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/item_send_post_image_layout"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_margin="3dp">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/item_send_post_image_image"
            android:background="@drawable/myinfo_header_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/item_send_post_image_gif"
            android:background="@drawable/icon_gif_circle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/single_GIF"
            android:layout_alignBottom="@+id/item_send_post_image_image"
            android:layout_alignEnd="@+id/item_send_post_image_image"/>
        <ImageView
            android:id="@+id/item_send_post_image_iv_del"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_del_image"
            android:layout_alignTop="@+id/item_send_post_image_image"
            android:layout_alignEnd="@+id/item_send_post_image_image"/>
        <ImageView
            android:id="@+id/item_send_post_image_add"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_photo_add"/>
    </RelativeLayout>
</LinearLayout>
