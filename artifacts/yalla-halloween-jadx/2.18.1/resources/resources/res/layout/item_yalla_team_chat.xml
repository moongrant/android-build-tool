<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/private_chat_time"
        android:background="@drawable/privatechat_time_bg"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/left_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/left_face_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">
            <include layout="@layout/item_sub_left_msg"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/right_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="6dp">
            <include layout="@layout/item_sub_right_msg"/>
        </LinearLayout>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/right_face_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
</LinearLayout>
