<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/select_picture_color_FFFFFFFF"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_all_image_bg"
        android:background="@color/select_picture_color_FFFFFFFF"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/layout_all_image_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_pic"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/layout_all_image_iv_covering"
            android:background="@color/select_picture_color_33000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/layout_all_image_layout_select"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignTop="@+id/layout_all_image_iv"
            android:layout_alignRight="@+id/layout_all_image_iv">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/select_picture_color_FFFFFFFF"
                android:gravity="center"
                android:id="@+id/layout_all_image_tv_select"
                android:background="@drawable/icon_select_gray"
                android:visibility="visible"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_margin="6dp"
                android:text=""/>
        </RelativeLayout>
        <TextView
            android:textSize="8dp"
            android:id="@+id/layout_all_image_name"
            android:background="@color/select_picture_color_7fffffff"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/select_picture_color_FFFFFFFF"
            android:gravity="center"
            android:id="@+id/layout_all_image_tv_gif"
            android:background="@drawable/icon_gif_angle"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_picture_string_GIF"
            android:layout_alignBottom="@+id/layout_all_image_iv"
            android:layout_alignEnd="@+id/layout_all_image_iv"/>
        <ImageButton
            android:id="@+id/layout_all_image_iv_add"
            android:background="@color/select_picture_color_FFFFFFFF"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_add_photo"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
