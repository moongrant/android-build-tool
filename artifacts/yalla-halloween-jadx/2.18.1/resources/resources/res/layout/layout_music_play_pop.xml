<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/layout_music_play_pop_bg_layout"
    android:background="@drawable/shape_bg_room_bottom_menu_dialog"
    android:padding="16dp"
    android:layout_width="334dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_music_play_pop_music_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="36dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/color_FFFFFFF"
                android:gravity="center"
                android:id="@+id/layout_music_play_pop_music_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="currentName"
                android:singleLine="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_white_50"
                android:gravity="center"
                android:id="@+id/layout_music_play_pop_music_name_next"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Next：NextName"
                android:singleLine="true"
                style="@style/text_style_z11"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/layout_music_play_pop_close_iv"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_room_music_dialog_close"
            android:scaleType="center"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_room_music_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_room_music_sound"
            android:layout_marginStart="10dp"/>
        <SeekBar
            android:id="@+id/layout_music_play_pop_sound_seekBar"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="2dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/seekbar_player_progress"
            android:minHeight="2dp"
            android:thumb="@drawable/music_seekbar_thumb"
            android:thumbOffset="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_music_play_pop_music_layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/iv_room_music_dialog_hide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_music_hide"
            android:scaleType="center"/>
        <android.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/layout_music_play_pop_last_iv"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_room_music_last"/>
        <ImageView
            android:id="@+id/layout_music_play_pop_play_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_room_music_play"
            android:scaleType="center"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <ImageView
            android:id="@+id/layout_music_play_pop_next_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_room_music_next"
            android:scaleType="center"/>
        <android.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/layout_music_play_pop_btn_music_list"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_room_music_list"
            android:scaleType="center"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/color_FFFFFFF_50"
        android:id="@+id/layout_music_play_pop_music_empty"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:text="@string/Empty_Playlist"
        android:singleLine="true"
        style="@style/text_style_z18"/>
    <TextView
        android:textColor="@color/color_white"
        android:id="@+id/layout_music_play_pop_tv_add_music"
        android:background="@drawable/selector_btn_bg_round_green_h44"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="55dp"
        android:layout_marginBottom="36dp"
        android:text="@string/add_music"
        style="@style/text_style_z18"/>
</LinearLayout>
