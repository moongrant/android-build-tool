<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="42dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutAddress"
        android:background="@drawable/bg_round_stroke_gray_solid_gray"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:foreground="@drawable/ripple_border_round"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivAddress"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/icon_post_location"
            android:layout_marginStart="8.5dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_38000000"
            android:textColorHint="@color/color_38000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvAddress"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/Location"
            android:maxLines="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="8.5dp"
            android:layout_alignParentStart="true"/>
        <View
            android:id="@+id/viewAddressLine"
            style="@style/line_vertical_1px"/>
        <ImageView
            android:id="@+id/ivAddressCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_address_cancel"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutPower"
        android:background="@drawable/bg_round_stroke_gray_solid_gray"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:foreground="@drawable/ripple_border_round"
        android:paddingStart="8.5dp"
        android:paddingEnd="8.5dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivPower"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/icon_authority_open"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_38000000"
            android:textColorHint="@color/color_38000000"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvPower"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/Public"
            android:maxLines="1"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
