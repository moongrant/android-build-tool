<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/select_picture_color_FF999999"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_show_image_select_layout"
        android:background="@color/select_picture_color_FFFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.app.selectPicture.view.photoview.PhotoView
            android:id="@+id/layout_show_image_select_pic_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_pic"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/select_picture_color_FFFFFFFF"
            android:gravity="center"
            android:id="@+id/layout_show_image_select_tv_select"
            android:background="@drawable/icon_select_gray"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="12dp"
            android:text=""
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="16dp"
            android:gravity="start|center_vertical"
            android:id="@+id/layout_show_image_select_tv_info"
            android:background="@color/select_picture_color_7fffffff"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text=""
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
