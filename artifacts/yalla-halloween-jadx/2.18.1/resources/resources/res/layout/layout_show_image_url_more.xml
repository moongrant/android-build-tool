<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_show_image_url_more_layout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/layout_show_image_url_more_pic_bg"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/layout_show_image_url_more_pic_small"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <com.app.selectPicture.view.photoview.PhotoView
            android:id="@+id/layout_show_image_url_more_pic_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_pic"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:id="@+id/layout_show_image_url_more_progress"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_show_image_url_more_pic_iv_err"
            android:background="#ededed"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_centerInParent="true">
            <ImageView
                android:clickable="false"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/icon_picture_err"
                android:scaleType="centerCrop"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:gravity="start|center_vertical"
            android:id="@+id/layout_show_image_url_more_pic_info"
            android:background="@color/white_50"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text=""
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
