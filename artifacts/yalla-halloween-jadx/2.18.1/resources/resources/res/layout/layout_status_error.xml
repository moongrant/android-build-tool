<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/view_empty_holder_v_error"
    android:paddingBottom="20dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/view_empty_holder_iv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_empty_delete"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/view_empty_holder_tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Network_request_failed"/>
    <Button
        android:textSize="16dp"
        android:textColor="@color/color_white"
        android:id="@+id/view_empty_holder_bt_error"
        android:background="@drawable/selector_btn_bg_ripple"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="70dp"
        android:minWidth="150dp"
        android:text="@string/Try_again"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
