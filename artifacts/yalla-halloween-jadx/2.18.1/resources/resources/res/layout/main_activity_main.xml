<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/main_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/vToolbarBackground"
            android:background="@mipmap/ic_main_header_bg_top"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:scaleType="centerCrop"/>
        <FrameLayout
            android:id="@+id/flMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="49dp"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:layout_gravity="end|bottom"
            android:id="@+id/loginViewStub"
            android:layout="@layout/main_activity_main_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="110dp"/>
        <ViewStub
            android:id="@+id/termsServiceStub"
            android:layout="@layout/main_activity_main_terms_service"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.yalla.yalla.ui.view.RoomMemberConveneCardView
            android:id="@+id/roomMemberConveneCardView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="30dp"/>
    </FrameLayout>
    <ViewStub
        android:layout_gravity="start"
        android:id="@+id/vsDrawer"
        android:layout="@layout/main_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
