<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@color/color_00d8c9"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/tabLayout"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            layout="@layout/base_header_layout"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llSearch"
            android:background="@drawable/shape_bg_edit_search"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <EditText
                android:textSize="14dp"
                android:textColor="@color/color_87000000"
                android:textColorHint="@color/color_38000000"
                android:gravity="start|center_vertical"
                android:id="@+id/etSearch"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:hint="@string/search_room_user"
                android:cursorVisible="true"
                android:singleLine="true"
                android:maxLength="24"
                android:drawablePadding="6dp"
                android:layout_weight="1"
                android:imeOptions="actionSearch"
                android:drawableStart="@drawable/icon_search_edit"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/EditText_Alignment"/>
            <ImageView
                android:id="@+id/ivDelete"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_search_edit_delete"
                android:scaleType="center"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_white_70"
            android:gravity="center"
            android:id="@+id/tvSearch"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/search"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/vSearch"
        app:tabIndicatorColor="@color/color_00d8c9"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/color_white"
        app:tabTextAppearance="@style/TabLayout_Userinfo"
        app:tabTextColor="@color/color_white_70"/>
    <com.app.base.view.ViewPagerFixed
        android:id="@+id/vpSearch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
