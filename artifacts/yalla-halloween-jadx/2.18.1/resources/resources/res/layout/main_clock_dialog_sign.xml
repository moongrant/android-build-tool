            android:id="@+id/ivDoubleReward3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"/>
        <ImageView
            android:id="@+id/ivSigned3"
