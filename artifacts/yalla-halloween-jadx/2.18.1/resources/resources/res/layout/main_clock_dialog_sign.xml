    <androidx.cardview.widget.CardView
        android:id="@+id/flSignIn7"
        android:layout_width="82dp"
        android:layout_height="133dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="@color/color_fff5f5f5"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flSignIn3"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_get7"
            android:background="@drawable/main_clock_dialog_select_red_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_gift_big"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_07"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.5dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#ff5b48"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clock_dialog_SUPRISE"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff5b48"
                android:id="@+id/ivDoubleReward7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/ivSigned7"
            android:background="@drawable/main_clock_dialog_signed_shape"
            android:padding="23dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_signed"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_alpha_54_A2"
        android:gravity="center"
        android:id="@+id/tvSignNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:minHeight="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flSignIn7"/>
    <com.yalla.support.statebutton.StateButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/signIn"
        android:background="@color/color_00d8c9"
        android:layout_width="244dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/clock_in_sign"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSignNum"
        app:pressedBackgroundColor="@color/color_00d8c9"
        app:radius="24dp"
        app:unableBackgroundColor="@color/color_FFF2F3F5"
        app:unableTextColor="@color/color_999999"/>
</androidx.constraintlayout.widget.ConstraintLayout>
