            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_signed"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/flSignIn4"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="@color/color_fff5f5f5"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flSignIn1">
        <ImageView
            android:id="@+id/ivGet4"
            android:background="@drawable/main_clock_dialog_select_green_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_crystal"
            android:scaleType="center"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_04"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_AAA"
            android:layout_gravity="end|bottom"
            android:id="@+id/ivDoubleReward4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"/>
        <ImageView
            android:id="@+id/ivSigned4"
            android:background="@drawable/main_clock_dialog_signed_shape"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_signed"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/flSignIn5"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="3dp"
        app:cardBackgroundColor="@color/color_fff5f5f5"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@+id/flSignIn1"
        app:layout_constraintTop_toBottomOf="@+id/flSignIn2">
        <ImageView
            android:id="@+id/ivGet5"
            android:background="@drawable/main_clock_dialog_select_red_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_gift_small"
            android:scaleType="center"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_05"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_AAA"
            android:layout_gravity="end|bottom"
