<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:paddingBottom="18.5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/flSignIn1"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="10dp"
        app:cardBackgroundColor="@color/color_fff5f5f5"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivGet1"
            android:background="@drawable/main_clock_dialog_select_green_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_crystal"
            android:scaleType="center"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_01"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_AAA"
            android:layout_gravity="end|bottom"
            android:id="@+id/ivDoubleReward1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="5dp"/>
        <ImageView
            android:id="@+id/ivSigned1"
            android:background="@drawable/main_clock_dialog_signed_shape"
            android:padding="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_signed"/>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/flSignIn2"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginStart="3dp"
        app:cardBackgroundColor="@color/color_fff5f5f5"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@+id/flSignIn1"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivGet2"
            android:background="@drawable/main_clock_dialog_select_red_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_clock_dialog_gift_small"
            android:scaleType="center"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_dialog_02"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_AAA"
            android:layout_gravity="end|bottom"
            android:id="@+id/ivDoubleReward2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
