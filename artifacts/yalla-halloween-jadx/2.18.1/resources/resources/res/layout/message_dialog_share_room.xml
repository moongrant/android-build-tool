<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/bg_round_bg_white_r16"
    android:paddingTop="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="25dp"
    android:paddingEnd="25dp">
    <FrameLayout
        android:id="@+id/fl_share_room"
        android:background="@drawable/bg_shape_f5f5f5_6"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/nv_share_room_head_photo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="5dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:singleLine="true"
            android:layout_marginStart="76dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_6D6D6D"
            android:id="@+id/tv_share_room_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginStart="76dp"/>
    </FrameLayout>
    <EditText
        android:textSize="14dp"
        android:textColor="@color/color_5f5f5f"
        android:textColorHint="@color/color_CCCCCC"
        android:id="@+id/et_share_room"
        android:background="@drawable/bg_round_bg_stroke_e2e2e2_r3"
        android:paddingTop="9dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="@string/et_share_leave_message"
        android:maxLines="5"
        android:maxLength="300"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_share_room"/>
</androidx.constraintlayout.widget.ConstraintLayout>
