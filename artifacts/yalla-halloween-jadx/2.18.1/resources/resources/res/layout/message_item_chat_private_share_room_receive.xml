<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_receive"/>
    <RelativeLayout
        android:id="@+id/fl_share_room_receive"
        android:background="@drawable/bg_shape_stroke_f5f5f5_6"
        android:paddingTop="5dp"
        android:layout_width="263dp"
        android:layout_height="95dp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/nv_share_room_head_photo_receive"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_room_name_receive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxWidth="154dp"
            android:maxLines="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@+id/nv_share_room_head_photo_receive"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_room_id_receive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:maxWidth="154dp"
            android:maxLines="1"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/nv_share_room_head_photo_receive"/>
        <View
            android:background="@color/font_line_d5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="65dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_929299"
            android:ellipsize="end"
            android:id="@+id/tv_share_room_sign_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="@string/click_to_enter_room"
            android:singleLine="true"
            android:layout_marginStart="5dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
