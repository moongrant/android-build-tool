<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_send"/>
    <com.yalla.yalla.common.ui.view.SVGAView
        android:id="@+id/svga_message_status"
        android:visibility="visible"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/fl_share_user_send"
        app:layout_constraintEnd_toStartOf="@+id/fl_share_user_send"
        app:layout_constraintTop_toTopOf="@+id/fl_share_user_send"/>
    <RelativeLayout
        android:id="@+id/fl_share_user_send"
        android:background="@drawable/bg_shape_stroke_f5f5f5_6"
        android:paddingTop="5dp"
        android:layout_width="245dp"
        android:layout_height="95dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/nv_share_user_head_photo_send"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_user_name_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxWidth="154dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@+id/nv_share_user_head_photo_send"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_user_id_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:maxWidth="154dp"
            android:maxLines="1"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/nv_share_user_head_photo_send"/>
        <View
            android:background="@color/font_line_d5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="65dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_929299"
            android:id="@+id/tv_share_user_sign_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:layout_marginStart="5dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
