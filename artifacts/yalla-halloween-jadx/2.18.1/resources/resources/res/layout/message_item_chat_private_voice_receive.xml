<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_receive"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_private_chat_item_bg_voice"
        android:background="@drawable/bg_chitchat_receive_seletor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header"
        style="@style/private_chat_item_bg_left">
        <com.yalla.yalla.common.ui.view.SVGAView
            android:id="@+id/svga_chat_voice"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_chitchat_send_play3"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:rotation="180"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/font_black"
            android:id="@+id/tv_chat_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1s"
            android:includeFontPadding="false"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_chat_voice_read"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/bg_red_point_circle"
        android:contentDescription="@null"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/ll_private_chat_item_bg_voice"
        app:layout_constraintTop_toTopOf="@+id/ll_private_chat_item_bg_voice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
