<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvTime"
        android:background="@drawable/privatechat_time_bg"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_marginBaseline="14dp"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:src="@mipmap/icon_yalla_team"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTime"/>
    <View
        android:id="@+id/vHolder"
        android:layout_width="5dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llBg"
        android:background="@drawable/bg_chitchat_receive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vHolder"
        app:layout_constraintTop_toTopOf="@+id/ivIcon">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/yalla_team_satisfaction_survey_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_5f5f5f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/yalla_team_satisfaction_survey_content"/>
        <View
            android:background="@color/color_f5f5f5"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/yalla_team_satisfaction_survey_desc"/>
        <com.yalla.yalla.ui.view.ScoreLayout
            android:id="@+id/scoreLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/color_CCCCCC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/yalla_team_satisfaction_survey_desc2"/>
        <View
            android:background="@color/color_f5f5f5"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_4A90E2"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:text="@string/button_submit"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_CCCCCC"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvSubmitSuccess"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/yalla_team_satisfaction_survey_submit_success"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
