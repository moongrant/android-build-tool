<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/bgTopicName"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:id="@+id/vTopicName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Topic_Name"
            android:paddingStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicName"
            app:layout_constraintStart_toStartOf="@+id/bgTopicName"
            app:layout_constraintTop_toTopOf="@+id/bgTopicName"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_alpha_38"
            android:ellipsize="end"
            android:id="@+id/tvTopicName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicName"
            app:layout_constraintEnd_toEndOf="@+id/bgTopicName"
            app:layout_constraintTop_toTopOf="@+id/bgTopicName"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicName"
            style="@style/line_horizontal_1px"/>
        <View
            android:id="@+id/bgTopicHeader"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bgTopicName"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:id="@+id/vTopicHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Profile_Photo"
            android:paddingStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicHeader"
            app:layout_constraintStart_toStartOf="@+id/bgTopicHeader"
            app:layout_constraintTop_toTopOf="@+id/bgTopicHeader"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/nivTopicHeader"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="31dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicHeader"
            app:layout_constraintEnd_toEndOf="@+id/bgTopicHeader"
            app:layout_constraintTop_toTopOf="@+id/bgTopicHeader"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_arrow_right"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicHeader"
            app:layout_constraintEnd_toEndOf="@+id/bgTopicHeader"
            app:layout_constraintTop_toTopOf="@+id/bgTopicHeader"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/bgTopicHeader"
            style="@style/line_horizontal_1px"/>
        <View
            android:id="@+id/bgTopicDesc"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bgTopicHeader"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:id="@+id/vTopicDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Topic_Description"
            android:paddingStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicDesc"
            app:layout_constraintStart_toStartOf="@+id/bgTopicDesc"
            app:layout_constraintTop_toTopOf="@+id/bgTopicDesc"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_alpha_38"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvTopicDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:text="description-"
            android:hint="@string/topic_description_hint"
            android:maxLines="1"
            android:drawableEnd="@drawable/icon_arrow_right"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicDesc"
            app:layout_constraintEnd_toEndOf="@+id/bgTopicDesc"
            app:layout_constraintTop_toTopOf="@+id/bgTopicDesc"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicDesc"
            style="@style/line_horizontal_1px"/>
        <View
            android:id="@+id/bgTopicRule"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bgTopicDesc"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:id="@+id/vTopicRule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:text="@string/Topic_Rules"
            android:paddingStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicRule"
            app:layout_constraintStart_toStartOf="@+id/bgTopicRule"
            app:layout_constraintTop_toTopOf="@+id/bgTopicRule"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_999999"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tvTopicRule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:hint="@string/topic_rules_hint"
            android:maxLines="1"
            android:drawableEnd="@drawable/icon_arrow_right"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicRule"
            app:layout_constraintEnd_toEndOf="@+id/bgTopicRule"
            app:layout_constraintTop_toTopOf="@+id/bgTopicRule"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/bgTopicRule"
            style="@style/line_horizontal_1px"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/vTopicManager"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/topic_info_setting_Topic_Admins"
            android:drawableEnd="@drawable/icon_arrow_right"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bgTopicRule"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/vTopicManager"
            style="@style/line_horizontal_1px"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/vTopicBlackList"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/Blocked_List"
            android:drawableEnd="@drawable/icon_arrow_right"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vTopicManager"/>
        <View
            android:layout_width="match_parent"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/vTopicBlackList"
            style="@style/line_horizontal_1px"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
