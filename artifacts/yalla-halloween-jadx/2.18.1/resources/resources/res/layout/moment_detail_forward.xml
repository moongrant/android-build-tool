<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_round_bg_f5f5f5_r4"
    android:padding="12dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_38000000"
        android:gravity="center"
        android:id="@+id/deleted"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/This_moment_has_been_deleted"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/icon_exclamation"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_38000000"
        android:gravity="center"
        android:id="@+id/notSupport"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/moment_content_not_support"
        android:drawablePadding="4dp"/>
    <com.yalla.yalla.ui.view.MomentDetailPollView
        android:id="@+id/pollView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yalla.yalla.ui.view.MomentDetailEventView
        android:id="@+id/event"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.yalla.yalla.ui.view.MomentDetailShare
        android:id="@+id/share"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.app.base.view.imageMore.ImageMoreView
        android:id="@+id/imageMoreView"
        android:paddingTop="8.2dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.yalla.yalla.ui.view.MomentDetailText
        android:id="@+id/text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
