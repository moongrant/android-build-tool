<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="37dp">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivGiftGiver2"
        android:visibility="gone"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="-8dp"
        android:layout_toEndOf="@+id/ivGiftGiver1"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivGiftGiver1"
        android:visibility="gone"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="-8dp"
        android:layout_toEndOf="@+id/ivGiftGiver0"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivGiftGiver0"
        android:visibility="gone"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvGifters"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/moment_gift_giver_user_have"
        android:maxLines="1"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/ivGiftGiver2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_999999"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/tvNoGifters"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/moment_gift_giver_user_no"
        android:maxLines="1"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/ivGiftGiver2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_FFFF897E"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/tvGiftTotalProp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/button_send"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:drawableStart="@drawable/ic_moment_gifts"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:layout_toStartOf="@+id/ivArrow"/>
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/ivArrow"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_moment_gifts_arrow_end"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
