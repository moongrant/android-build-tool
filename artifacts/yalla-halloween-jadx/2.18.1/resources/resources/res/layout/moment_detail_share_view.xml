<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="86dp">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivShareItem"
        android:background="@drawable/myinfo_header_bg"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:src="@drawable/icon_head_default"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_87000000"
            android:gravity="start"
            android:id="@+id/tvShareTitleItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:singleLine="true"
            style="@style/text_style_z16"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_54000000"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/tvShareContentItem"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            style="@style/EditText_Alignment"/>
    </LinearLayout>
</LinearLayout>
