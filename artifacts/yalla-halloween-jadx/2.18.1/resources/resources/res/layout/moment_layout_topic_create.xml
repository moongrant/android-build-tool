<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/nivTopicHeader"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivCamera"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="67dp"
        android:src="@drawable/icon_userinfo_edit_photo"
        android:layout_marginStart="67dp"
        app:layout_constraintStart_toStartOf="@+id/nivTopicHeader"
        app:layout_constraintTop_toTopOf="@+id/nivTopicHeader"/>
    <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_topic_create_required"
        app:layout_constraintStart_toEndOf="@+id/ivCamera"
        app:layout_constraintTop_toTopOf="@+id/ivCamera"/>
    <View
        android:id="@+id/vName"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/nivTopicHeader"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Topic_Name"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/vName"
        app:layout_constraintTop_toTopOf="@+id/vName"/>
    <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_topic_create_required"
        app:layout_constraintStart_toEndOf="@+id/tvNameTitle"
        app:layout_constraintTop_toTopOf="@+id/tvNameTitle"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_alpha_87"
        android:textColorHint="@color/color_C7C7CC"
        android:gravity="start"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/Name_your_topic"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/vName"
        app:layout_constraintStart_toStartOf="@+id/vName"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_userinfo_more"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/vName"
        app:layout_constraintEnd_toEndOf="@+id/vName"
        app:layout_constraintTop_toTopOf="@+id/vName"/>
    <View
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/vName"/>
    <View
        android:id="@+id/vIntroduction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/vLine"
        app:layout_constraintTop_toBottomOf="@+id/vName"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvIntroductionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Topic_Description"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/vIntroduction"
        app:layout_constraintTop_toTopOf="@+id/vIntroduction"/>
    <com.app.base.view.FixTextView
        android:textSize="16sp"
        android:textColor="@color/color_alpha_87"
        android:textColorHint="@color/color_C7C7CC"
        android:gravity="start"
        android:id="@+id/tvIntroduction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/create_topic_description_hint"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vIntroduction"
        app:layout_constraintTop_toBottomOf="@+id/tvIntroductionTitle"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_userinfo_more"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/vIntroduction"
        app:layout_constraintEnd_toEndOf="@+id/vIntroduction"
        app:layout_constraintTop_toTopOf="@+id/vIntroduction"/>
    <View
        android:id="@+id/vLine"
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvIntroduction"/>
    <View
        android:orientation="vertical"
        android:id="@+id/vNote"
        android:background="@drawable/shape_bg_topic_create_tips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vLine"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_87"
        android:id="@+id/tvNoteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/Note"
        android:drawablePadding="7dp"
        android:drawableStart="@drawable/common_warning_tip"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/vNote"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNote1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/topic_create_note1"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/vNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toBottomOf="@+id/tvNoteTitle"/>
    <View
        android:background="@drawable/shape_topic_create_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/tvNote1"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNote2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/topic_create_note2"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/vNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toBottomOf="@+id/tvNote1"/>
    <View
        android:background="@drawable/shape_topic_create_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/tvNote2"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNote3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/topic_create_note3"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/vNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toBottomOf="@+id/tvNote2"/>
    <View
        android:background="@drawable/shape_topic_create_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/tvNote3"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNote4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/topic_create_note4"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/vNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toBottomOf="@+id/tvNote3"/>
    <View
        android:background="@drawable/shape_topic_create_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/tvNote4"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_alpha_38"
        android:id="@+id/tvNote5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:text="@string/topic_create_note5"
        android:layout_marginStart="32dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/vNote"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toBottomOf="@+id/tvNote4"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:background="@drawable/shape_topic_create_note"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="@+id/vNote"
        app:layout_constraintTop_toTopOf="@+id/tvNote5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
