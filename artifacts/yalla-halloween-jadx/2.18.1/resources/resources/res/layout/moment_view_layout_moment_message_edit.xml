<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewShade"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:id="@+id/lineTop"
        style="@style/line_horizontal_1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutContent"
        android:background="@color/color_f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/ivAt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/icon_at"
            android:scaleType="center"
            android:layout_weight="0"/>
        <com.app.base.framework.view.editTextSpan.EditTextSpan
            android:textSize="12sp"
            android:textColorHint="@color/color_C7C7CC"
            android:gravity="start|center_vertical"
            android:id="@+id/editContent"
            android:background="@drawable/bg_round_bg_white_stroke_gray"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:hint="@string/hint_say_something"
            android:singleLine="true"
            android:maxLength="200"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:textAlignment="viewStart"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/ivEmoji"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_emoji"
            android:scaleType="center"
            android:layout_weight="0"
            android:paddingStart="14dp"
            android:paddingEnd="7dp"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/ivSend"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_send"
            android:scaleType="center"
            android:layout_weight="0"
            android:paddingStart="7dp"
            android:paddingEnd="14dp"/>
    </LinearLayout>
    <com.yalla.support.keyboardpanel.panel.PanelLayout
        android:orientation="vertical"
        android:id="@+id/faceLayout"
        android:background="@color/color_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp">
        <com.app.base.view.EmojiFaceView
            android:id="@+id/faceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.yalla.support.keyboardpanel.panel.PanelLayout>
    <View
        android:id="@+id/lineBottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
