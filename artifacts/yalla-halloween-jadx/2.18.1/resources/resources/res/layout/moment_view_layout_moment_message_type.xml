<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/typeLayout"
    android:background="@color/transparent30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/color_FFFFFFF"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/type_all"
            android:background="@drawable/bgs_button_green_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:text="@string/moment_notification_type_all"
            app:layout_constraintEnd_toStartOf="@+id/type_like"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/type_like"
            android:background="@drawable/bgs_button_efefef_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:text="@string/moment_notification_type_like"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/type_comment"
            android:background="@drawable/bgs_button_efefef_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:text="@string/moment_notification_type_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/type_like"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/type_at_me"
            android:background="@drawable/bgs_button_efefef_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:layout_marginTop="12dp"
            android:text="@string/moment_notification_type_at"
            app:layout_constraintEnd_toStartOf="@+id/type_gifts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type_all"/>
        <TextView
            android:gravity="center"
            android:id="@+id/type_gifts"
            android:background="@drawable/bgs_button_efefef_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:layout_marginTop="12dp"
            android:text="@string/moment_notification_type_gifts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type_like"/>
        <TextView
            android:gravity="center"
            android:id="@+id/type_other"
            android:background="@drawable/bgs_button_efefef_r6"
            android:layout_width="101dp"
            android:layout_height="31dp"
            android:layout_marginTop="12dp"
            android:text="@string/Other"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/type_gifts"
            app:layout_constraintTop_toBottomOf="@+id/type_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
