<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodata_layout_nodata_root"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nodata_layout_v_error"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp">
            <ImageView
                android:id="@+id/nodata_layout_iv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_empty_delete"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_alpha_38"
                android:id="@+id/nodata_layout_tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="80dp"
                android:text="@string/Network_request_failed"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/color_white"
                android:id="@+id/nodata_layout_bt_error"
                android:background="@drawable/selector_btn_bg_ripple"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="150dp"
                android:text="@string/Try_again"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nodata_layout_v_empty"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="20dp">
            <ImageView
                android:id="@+id/nodata_layout_iv_no_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_empty_room"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_alpha_38"
                android:gravity="center"
                android:id="@+id/nodata_layout_tv_blank_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="46dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="46dp"
                android:layout_marginBottom="80dp"
                android:text="@string/no_data"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/color_white"
                android:id="@+id/nodata_layout_bt_empty"
                android:background="@drawable/selector_btn_bg_ripple"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginBottom="20dp"
                android:minWidth="150dp"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/nodata_layout_v_first"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/nodata_layout_iv_first_loading"
                android:layout_width="90dp"
                android:layout_height="55dp"/>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
