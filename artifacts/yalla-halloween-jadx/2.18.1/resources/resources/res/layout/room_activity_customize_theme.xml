<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <com.yalla.yalla.common.ui.view.StateLayout
        android:id="@+id/slLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llContent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clSelectImage"
                        android:background="@drawable/room_shape_theme_customize_select"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="55dp"
                        android:layout_marginEnd="55dp">
                        <com.yalla.support.statebutton.StateButton
                            android:background="@color/rec_color_00D8C9"
                            android:layout_width="27dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="58dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:radius="1.25dp"/>
                        <com.yalla.support.statebutton.StateButton
                            android:background="@color/rec_color_00D8C9"
                            android:layout_width="3dp"
                            android:layout_height="27dp"
                            android:layout_marginTop="46dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:radius="1.25dp"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/rec_color_00D8C9"
                            android:autoLink="all"
                            android:id="@+id/tvSelect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="88dp"
                            android:text="@string/room_theme_customize_select"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <include
                        android:id="@+id/include"
                        layout="@layout/room_include_theme_room_preview"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/room_theme_customize_description_1"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/room_theme_customize_description_2"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/room_theme_customize_description_3"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/room_theme_customize_description_4"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/room_theme_customize_description_5"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="20dp"
                        android:text="@string/room_theme_customize_description_6"
                        android:layout_marginStart="19dp"
                        android:layout_marginEnd="19dp"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <View
                android:background="@color/color_e2e2e2"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/coin"
                    android:layout_marginStart="17dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_E66"
                    android:id="@+id/tvThemePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="-6dp"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tvThemeDiscountPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"/>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <TextView
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/slConfirm"
                    android:background="@drawable/room_selector_theme_customize_select_pay"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/Pay"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:layout_marginEnd="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.yalla.yalla.common.ui.view.StateLayout>
</FrameLayout>
