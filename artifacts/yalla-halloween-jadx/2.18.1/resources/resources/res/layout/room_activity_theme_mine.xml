<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/base_header_layout"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/shape_whit_radius25_stroke1"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="200dp">
            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/tvMine"
                android:background="@drawable/shape_whit_radius25_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/Mine"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:gravity="center"
                android:id="@+id/tvCustomize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/room_theme_customize"
                android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/flRoomTheme"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.yalla.support.statebutton.StateButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/stCreate"
        android:background="@color/color_00d8c9"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/room_theme_customize_create"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:radius="19dp"/>
</LinearLayout>
