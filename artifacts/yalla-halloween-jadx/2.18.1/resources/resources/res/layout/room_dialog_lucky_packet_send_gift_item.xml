<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="68dp"
    android:layout_height="80dp"
    android:layout_marginEnd="6dp">
    <ImageView
        android:id="@+id/bg"
        android:background="@drawable/room_shape_dialog_lucky_packet_send_gift_item_unselected_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="3dp"
        android:src="@drawable/room_dialog_lucky_golds_send_gift_item_default"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="13sp"
        android:textColor="#fff19f"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="123456"
        android:maxLines="1"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/room_dialog_lucky_golds_send_golds_size_12"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
    <ImageView
        android:id="@+id/content_bg"
        android:background="@drawable/room_shape_dialog_lucky_golds_send_gift_item_content_bg"
        android:layout_width="0dp"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/bg_selected"
        android:background="@drawable/room_dialog_lucky_packet_send_selected_l"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
