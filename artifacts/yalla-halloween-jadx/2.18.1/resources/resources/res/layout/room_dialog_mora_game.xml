<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_dialog_room_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_room_mora_header"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/coin"
            android:scaleType="centerInside"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/color_FAE976"
            android:id="@+id/dialog_mora_game_coin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textColor="@color/color_FAE976"
            android:id="@+id/dialog_mora_game_coin_recharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Recharge_"
            android:layout_marginStart="13dp"/>
        <android.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivGuessRank"
            android:background="@drawable/room_dialog_guessing_rank"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <ImageView
                android:textColor="@color/color_FAE976"
                android:id="@+id/dialog_mora_game_coin_history"
                android:background="@drawable/room_dialog_guessing_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/vMoraPoint"
                android:background="@drawable/bg_red_point_circle"
                android:visibility="visible"
                android:layout_width="6dp"
                android:layout_height="6dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/dialog_mora_game_detail"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_room_bottom_game_box_mora_detail"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/cl_room_mora_body_one"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/color_3B395D"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/color_999999"
            android:id="@+id/internal_gift_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="23dp"
            android:text="@string/winner_gift"
            android:layout_marginStart="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6.5dp"
            android:layout_marginEnd="6.5dp"
            app:layout_constraintTop_toBottomOf="@+id/internal_gift_title"/>
        <View
            android:background="@color/color_3B395D"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="17dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvGift"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_room_mora_body_two"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_CCCCCC"
            android:id="@+id/internal_gift_title2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="@string/winner_gifts"
            android:layout_marginStart="19dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/iv_mora_game_gift"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/icon_vehicle_car_01"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/internal_gift_title2"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/color_coin"
            android:id="@+id/tv_mora_game_gift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_mora_game_gift"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/dialog_mora_game_detail2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/icon_room_bottom_game_box_mora_detail"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="340dp"
            android:layout_height="105dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/icon_room_mora_game_bg"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_mora_game_gift"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/mora_game_user_one"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="92dp"
            android:layout_marginBottom="45dp"
            android:scaleType="centerInside"
            android:layout_marginStart="53dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/mora_game_user_two"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginTop="92dp"
            android:layout_marginBottom="45dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="53dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:enabled="true"
            android:textSize="14dp"
            android:textColor="@color/color_CCCCCC"
            android:id="@+id/mora_game_user_one_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="130dp"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/mora_game_user_one"
            app:layout_constraintStart_toStartOf="@+id/mora_game_user_one"
            app:layout_constraintTop_toBottomOf="@+id/mora_game_user_one"/>
        <TextView
            android:enabled="true"
            android:textSize="14dp"
            android:textColor="@color/color_CCCCCC"
            android:id="@+id/mora_game_user_two_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="130dp"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/mora_game_user_two"
            app:layout_constraintStart_toStartOf="@+id/mora_game_user_two"
            app:layout_constraintTop_toBottomOf="@+id/mora_game_user_two"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_999999"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="9dp"
        android:text="@string/fist_position"
        android:layout_marginStart="13dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:id="@+id/fl_dialog_room_mora_game_stone"
            android:background="@drawable/selector_btn_bg_room_mora_game"
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_stone"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/icon_room_mora_game_stone"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_f5f5f5"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_gift_stone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="84dp"
                android:layout_marginBottom="16dp"
                android:text="@string/stone"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_dialog_room_mora_game_cloth"
            android:background="@drawable/selector_btn_bg_room_mora_game"
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_cloth"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/icon_room_mora_game_scissors"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_f5f5f5"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_gift_cloth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="84dp"
                android:layout_marginBottom="16dp"
                android:text="@string/paper"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_dialog_room_mora_game_scissors"
            android:background="@drawable/selector_btn_bg_room_mora_game"
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="9dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_scissors"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="13dp"
                android:src="@drawable/icon_room_mora_game_cloth"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_f5f5f5"
                android:layout_gravity="center_horizontal"
                android:id="@+id/mora_game_gift_scissors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="84dp"
                android:layout_marginBottom="16dp"
                android:text="@string/scissors"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="@color/color_3B395D"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_mora_game_commit"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="17dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llUserSelect"
            android:background="@drawable/room_shape_dialog_select_guess_people"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.yalla.yalla.util.netimage.NetImageView
                android:id="@+id/ivUserHeader"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_default_head_circle"
                android:layout_marginStart="3dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_FFFFFFF"
                android:ellipsize="end"
                android:id="@+id/tvUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room_dialog_guess_any_one"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/icon_room_gift_top_white"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <Button
            android:textSize="14sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/mora_game_commit"
            android:background="@drawable/btn_bg_default_r15"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="175dp"
            android:text="@string/mora_game_commit"
            android:singleLine="true"
            android:textAllCaps="false"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:layout_marginStart="15dp"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
    <Button
        android:textSize="16dp"
        android:textColor="@color/white"
        android:id="@+id/mora_game_commit2"
        android:background="@drawable/btn_bg_default_r20"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="17dp"
        android:text="@string/mora_game_commit"
        android:textAllCaps="false"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
