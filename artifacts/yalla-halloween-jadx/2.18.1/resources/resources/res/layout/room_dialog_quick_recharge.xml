<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_bg_dialog_room_quick_recharge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close"
        android:padding="12dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/room_dialog_lucky_golds_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_FFC339"
        android:gravity="center"
        android:id="@+id/coin"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:includeFontPadding="false"
        android:drawablePadding="5.5dp"
        android:drawableStart="@drawable/icon_member_manage_gold"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close"
        style="@style/line_horizontal_1px"/>
    <com.yalla.yalla.common.ui.view.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="350dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.yalla.yalla.common.ui.view.StateLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_999999"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvHelp"
        android:layout_width="wrap_content"
        android:layout_height="46.5dp"
        android:text="@string/payment_encountered_problems"
        android:drawablePadding="5.5dp"
        android:drawableEnd="@drawable/room_ic_quick_recharge_right_arrow"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stateLayout"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/tr_00"
        android:gravity="center"
        android:id="@+id/tempText"
        android:background="@drawable/bgs_button_tr00_r360"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:text="HKD 0.99"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stateLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
