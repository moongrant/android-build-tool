<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/room_shape_dialog_treasure_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:background="@drawable/room_shape_dialog_treasure_box_banner_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="24dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivBroadcast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/room_ic_notice"
                android:layout_marginStart="10dp"/>
            <com.youth.banner.Banner
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="18dp"
                app:banner_orientation="vertical"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/room_ic_rule"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivCurrentBg1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/room_ic_dialog_treasure_box_selected_bg"/>
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ivBox1"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/room_ic_treasure_box_1"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivArrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/room_ic_arrow_right"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivCurrentBg2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/room_ic_dialog_treasure_box_selected_bg"/>
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ivBox2"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/room_ic_treasure_box_2"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivArrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/room_ic_arrow_right"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivCurrentBg3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/room_ic_dialog_treasure_box_selected_bg"/>
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ivBox3"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/room_ic_treasure_box_3"/>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="275dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_white_60"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/treasure_box_reset"/>
</androidx.appcompat.widget.LinearLayoutCompat>
