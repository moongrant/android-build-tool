<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="40dp"
    android:layout_marginStart="17dp"
    android:layout_marginEnd="17dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/llBody"
        android:background="@drawable/room_shape_dialog_vote_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:minHeight="100dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:minHeight="128dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/llBottom1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_FFFFFFF_60"
                android:id="@+id/tvMyVote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="15dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_FFFFFFF_60"
                android:gravity="end"
                android:id="@+id/tvVoteTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="15dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_19B"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvEndVote"
            android:background="@drawable/room_shape_dialog_vote_game_end_event"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginBottom="20dp"
            android:text="@string/room_vote_game_ended_vote"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llBottom2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="109dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/color_white_80"
                android:id="@+id/tvEndedTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_vote_game_ended"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_FFFFFFF_60"
                android:id="@+id/tvEndedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/room_dialog_vote_game"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.app.base.framework.view.marqueeText.MarqueeText
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tvTitle"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:maxWidth="164dp"
        android:text=""
        android:singleLine="true"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintBottom_toBottomOf="@+id/ivBackground"
        app:layout_constraintEnd_toEndOf="@+id/ivBackground"
        app:layout_constraintStart_toStartOf="@+id/ivBackground"/>
    <ImageView
        android:id="@+id/ivVoteRules"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/room_vote_game_rules"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llBody"/>
    <ImageView
        android:id="@+id/ivVotPackUp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/room_vote_game_pack_up"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llBody"/>
    <com.yalla.yalla.common.ui.view.SVGAView
        android:id="@+id/svgaView"
        android:layout_width="325dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:autoPlay="true"
        app:clearsAfterStop="true"
        app:layout_constraintBottom_toBottomOf="@+id/llBody"
        app:layout_constraintEnd_toEndOf="@+id/llBody"
        app:layout_constraintStart_toStartOf="@+id/llBody"
        app:layout_constraintTop_toTopOf="@+id/llBody"/>
</androidx.constraintlayout.widget.ConstraintLayout>
