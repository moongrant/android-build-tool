<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_round_bg_whit_top_r16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvFirstPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/room_vote_game_first_period"/>
    <View
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvSecondPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/room_vote_game_second_period"/>
    <View
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvThirdPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/room_vote_game_third_period"/>
    <View
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvFourthPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/room_vote_game_fourth_period"/>
    <View
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvNotPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/room_vote_game_not_period"/>
    <View
        android:background="@drawable/bg_round_bg_f5f5f5_r4"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/tvCancelPeriod"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:text="@string/Cancel"/>
</androidx.appcompat.widget.LinearLayoutCompat>
