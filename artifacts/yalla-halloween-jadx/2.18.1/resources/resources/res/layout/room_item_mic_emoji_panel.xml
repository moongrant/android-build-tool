<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/llRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="10.5dp"
    android:paddingEnd="10.5dp">
    <ImageView
        android:id="@+id/ivItemEmojiPanel"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/color_white_60"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/tvItemEmojiPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lines="2"
        android:includeFontPadding="false"
        android:textDirection="anyRtl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivItemEmojiPanel"/>
    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="3dp"
        android:src="@drawable/room_dialog_mic_emoji_vip_lock"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="@+id/ivItemEmojiPanel"
        app:layout_constraintTop_toTopOf="@+id/ivItemEmojiPanel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
