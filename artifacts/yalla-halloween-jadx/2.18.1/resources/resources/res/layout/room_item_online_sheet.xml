<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ripple_border"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <android.widget.Space
        android:id="@+id/start_space"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginStart="14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_space"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <android.widget.Space
        android:id="@+id/end_space"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sdv_mount"
        app:layout_constraintStart_toEndOf="@+id/start_space"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/sdv_head"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_head_default_circle"
        app:layout_constraintBottom_toBottomOf="@+id/start_space"
        app:layout_constraintEnd_toEndOf="@+id/start_space"
        app:layout_constraintStart_toStartOf="@+id/start_space"
        app:layout_constraintTop_toTopOf="@+id/start_space"/>
    <com.yalla.yalla.common.ui.view.SVGAView
        android:id="@+id/sdv_head_frame_svga"
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:antiAlias="true"
        app:autoPlay="true"
        app:clearsAfterStop="false"
        app:fillMode="Forward"
        app:layout_constraintBottom_toBottomOf="@+id/start_space"
        app:layout_constraintEnd_toEndOf="@+id/start_space"
        app:layout_constraintStart_toStartOf="@+id/start_space"
        app:layout_constraintTop_toTopOf="@+id/start_space"
        app:loopCount="0"/>
    <ImageView
        android:id="@+id/iv_officials"
        android:visibility="visible"
        android:layout_width="25dp"
        android:layout_height="14dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/icon_userinfo_official_reverse"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@+id/start_space"
        app:layout_constraintTop_toTopOf="@+id/start_space"/>
    <com.yalla.yalla.common.ui.view.UserTagView
        android:gravity="start"
        android:id="@+id/topUserTagView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/end_space"
        app:layout_constraintStart_toStartOf="@+id/end_space"
        app:layout_constraintTop_toTopOf="@+id/end_space"/>
    <com.yalla.yalla.common.ui.view.UserTagView
        android:gravity="start"
        android:id="@+id/bottomUserTagView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/end_space"
        app:layout_constraintEnd_toEndOf="@+id/end_space"
        app:layout_constraintStart_toStartOf="@+id/end_space"/>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/sdv_mount"
        android:layout_width="85dp"
        android:layout_height="60dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/end_space"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/color_e2e2e2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
