<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ucrop_photobox"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/ucrop_color_toolbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="?attr/actionBarSize"
        app:theme="@style/ucrop_ToolbarThemeWhite">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ucrop_color_toolbar_widget"
            android:layout_gravity="center"
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ucrop_label_edit_photo"
            style="@style/TextAppearance.Widget.AppCompat.Toolbar.Title"/>
    </androidx.appcompat.widget.Toolbar>
    <include
        android:id="@+id/include_title_layout_title"
        layout="@layout/include_title_select"/>
    <FrameLayout
        android:id="@+id/ucrop_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/controls_wrapper"
        android:layout_below="@+id/include_title_layout_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image_view_logo"
            android:visibility="invisible"
            android:layout_width="@dimen/ucrop_default_crop_logo_size"
            android:layout_height="@dimen/ucrop_default_crop_logo_size"
            app:srcCompat="@drawable/ucrop_vector_ic_crop"/>
        <com.yalantis.ucrop.view.UCropView
            android:id="@+id/ucrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/select_picture_color_FF333333"
            android:layout_gravity="center"
            android:id="@+id/errorText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_picture_string_Load_Err"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/controls_wrapper"
        android:background="@android:color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
