<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="25dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/llTop"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.yalla.yalla.ui.view.MarqueeRecyclerView
                android:id="@+id/rvBanner"
                android:background="@color/color_1000"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="32dp"/>
            <View
                android:layout_gravity="end"
                android:background="@drawable/user_shape_head_shadow"
                android:layout_width="50dp"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/rankUserAll"
            android:background="@color/color_1000"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/user_badge_view_all"
            android:drawablePadding="9dp"
            android:drawableEnd="@drawable/ic_more_user"
            android:paddingStart="1dp"
            android:paddingEnd="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.yalla.yalla.util.netimage.NetImageView
        android:id="@+id/ivUserHead"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="23dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llTop"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="19sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tvWearBadge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ivUserHead"
        app:layout_constraintTop_toTopOf="@+id/ivUserHead"/>
    <com.yalla.yalla.common.ui.view.UserMedalView
        android:id="@+id/medalView"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivUserHead"
        app:layout_constraintStart_toStartOf="@+id/tvUserName"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/rec_color_00D8C9"
        android:gravity="center"
        android:id="@+id/tvWearBadge"
        android:background="@drawable/user_badge_wear_badge"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:foreground="@drawable/ripple_border_round"
        android:text="@string/wearing_medals"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivUserHead"/>
</androidx.constraintlayout.widget.ConstraintLayout>
