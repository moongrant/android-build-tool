<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivGiftNumberX"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_chatline_gift_x"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llGiftNumber"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <ImageView
            android:id="@+id/ivGiftNumberThousand"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_gift_num1"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/ivGiftNumberHundred"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_gift_num2"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/ivGiftNumberTen"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_gift_num3"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/ivGiftNumberOne"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_gift_num4"
            android:adjustViewBounds="true"/>
    </LinearLayout>
</LinearLayout>
