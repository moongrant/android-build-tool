<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutReply"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:paddingStart="13dp"
    android:paddingEnd="13dp">
    <android.widget.Space
        android:id="@+id/tv_reply_start_space"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginEnd="113dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/tvUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_reply_start_space"
        app:layout_constraintEnd_toStartOf="@+id/layoutReplyEnd"
        app:layout_constraintStart_toStartOf="@+id/tv_reply_start_space"/>
    <android.widget.Space
        android:id="@+id/tv_reply_bottom_space"
        android:layout_width="0dp"
        android:layout_height="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_reply_start_space"/>
    <ImageView
        android:id="@+id/ivEmojiTag"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/room_reply_emoji"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_bottom_space"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <TextView
        android:textSize="12sp"
        android:gravity="start"
        android:id="@+id/tvEmojiTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Room_Reply_Emoji"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/ivEmojiTag"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <ImageView
        android:id="@+id/ivPicTag"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/room_reply_pic"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_bottom_space"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <TextView
        android:textSize="12sp"
        android:gravity="start"
        android:id="@+id/tvPicTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Room_Reply_Photo"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/ivPicTag"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <ImageView
        android:id="@+id/ivGiftTag"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/room_reply_gifts"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_bottom_space"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <TextView
        android:textSize="12sp"
        android:gravity="start"
        android:id="@+id/tvGiftTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Room_Reply_Gifts"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/ivGiftTag"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <ImageView
        android:id="@+id/ivToTag"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/room_reply_to"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintStart_toEndOf="@+id/tvGiftTag"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvToTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintEnd_toStartOf="@+id/layoutReplyEnd"
        app:layout_constraintStart_toEndOf="@+id/ivToTag"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/tvText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_bottom_space"
        app:layout_constraintEnd_toStartOf="@+id/layoutReplyEnd"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_bottom_space"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_bottom_space"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutReplyEnd"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivReplyClose"
        app:layout_constraintTop_toTopOf="parent">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/ivReplyPicGif"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/icon_head_default"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.yalla.common.ui.view.SVGAView
            android:id="@+id/ivReplyGift"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_gift_default_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.yalla.yalla.ui.view.GiftNumberView
            android:layout_gravity="center"
            android:id="@+id/numberView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="9dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivReplyClose"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/room_reply_close"
        android:paddingStart="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
