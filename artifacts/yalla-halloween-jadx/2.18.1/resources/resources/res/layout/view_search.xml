<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="14sp"
        android:textColor="@color/color_alpha_87_A1"
        android:textColorHint="@color/color_alpha_38_A3"
        android:gravity="start|center_vertical"
        android:id="@+id/editSearch"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:hint="@string/Search_user_name_or_id"
        android:maxEms="20"
        android:singleLine="true"
        android:includeFontPadding="true"
        android:maxLength="20"
        android:drawablePadding="10dp"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/shape_edit_cursor"
        android:drawableStart="@drawable/search_top_a_magnifying_glass"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <ImageView
        android:id="@+id/ivClear"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/search_edittext_clear"
        android:scaleType="center"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/editSearch"
        app:layout_constraintEnd_toEndOf="@+id/editSearch"
        app:layout_constraintTop_toTopOf="@+id/editSearch"/>
    <View
        android:id="@+id/editLine"
        android:background="@color/color_00d8c9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/viewLine"
        android:background="@color/color_f5f5f5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
