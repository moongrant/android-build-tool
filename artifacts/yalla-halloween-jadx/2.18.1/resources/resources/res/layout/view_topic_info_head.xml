<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="5dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_round_bg_white_r6"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/nivTopicHeader"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/color_333333"
            android:id="@+id/tvTopicName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.5dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@+id/nivTopicHeader"
            app:layout_constraintTop_toTopOf="@+id/nivTopicHeader"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_999999"
            android:id="@+id/tvRegionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.5dp"
            android:text="@string/languge"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/nivTopicHeader"
            app:layout_constraintStart_toEndOf="@+id/nivTopicHeader"/>
        <com.app.base.view.LanguageView
            android:textSize="14sp"
            android:textColor="@color/color_999999"
            android:textColorHint="@color/color_alpha_54"
            android:id="@+id/languageViewTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10.5dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/nivTopicHeader"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/tvRegionTitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:id="@+id/tvInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/Topic_Description"
            android:drawableEnd="@drawable/icon_arrow_bottom_gray"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nivTopicHeader"/>
        <com.app.base.view.FixTextView
            android:textSize="14sp"
            android:textColor="@color/color_999999"
            android:textColorHint="@color/color_alpha_54"
            android:ellipsize="end"
            android:id="@+id/tvTopicDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/topic_description_hint"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInfoTitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:id="@+id/tvRuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/Topic_Rules"
            android:drawableEnd="@drawable/icon_arrow_bottom_gray"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTopicDesc"/>
        <com.app.base.view.FixTextView
            android:textSize="14sp"
            android:textColor="@color/color_999999"
            android:textColorHint="@color/color_alpha_54"
            android:ellipsize="end"
            android:id="@+id/tvRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="15dp"
            android:hint="@string/topic_rules_hint"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRuleTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_round_bg_white_r6"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/tvRule">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tvUserTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/Topic_Host"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.yalla.util.netimage.NetImageView
            android:id="@+id/ownerUserTagHeader"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="@+id/tvUserTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvUserTitle"/>
        <com.yalla.yalla.common.ui.view.UserTagView
            android:id="@+id/ownerUserTagView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ownerUserTagHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ownerUserTagHeader"
            app:layout_constraintTop_toTopOf="@+id/ownerUserTagHeader"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layoutTopicManager"
        android:background="@drawable/bg_round_bg_white_r6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <com.app.base.view.FixTextView
            android:textSize="16sp"
            android:textColor="@color/color_333333"
            android:gravity="center_vertical"
            android:id="@+id/tvTopicManagerInfo"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/topic_info_Topic_Admins"
            android:singleLine="true"
            android:drawablePadding="6dp"
            android:drawableEnd="@drawable/ic_topic_info"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserName"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listManager"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/tvAdminManagerTopView"
            android:background="@color/tr_00"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="13dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvAdminManager"
            android:background="@drawable/bgs_button_green_r360"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="15dp"
            android:text="@string/topic_info_Manage"
            android:layout_marginStart="62.5dp"
            android:layout_marginEnd="62.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTopicManagerInfo"/>
        <View
            android:id="@+id/tvAdminManagerBottomView"
            android:background="@color/tr_00"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
    </LinearLayout>
</LinearLayout>
