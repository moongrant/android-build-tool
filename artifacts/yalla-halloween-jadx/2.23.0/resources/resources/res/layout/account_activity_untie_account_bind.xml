<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/color_f5f5f5"
        android:layout_width="match_parent"
        android:layout_height="190dp">
        <ImageView
            android:id="@+id/ivPlatformBg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="38dp"
            android:scaleType="center"/>
        <TextView
            android:textColor="@color/color_alpha_38"
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            style="@style/text_style_z16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llUntieBind"
        android:background="@color/color_ffffff"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textColor="@color/color_87000000"
            android:clickable="false"
            android:layout_height="match_parent"
            android:text="@string/Unbind"
            android:paddingStart="16dp"
            style="@style/text_style_z16"/>
        <TextView
            android:textColor="@color/color_FE6C6C"
            android:id="@+id/tvUntieBindResult"
            android:clickable="false"
            android:layout_height="match_parent"
            android:text="@string/Failed_to_unbind"
            android:paddingStart="8dp"
            style="@style/text_style_z16"/>
    </LinearLayout>
    <View style="@style/line_horizontal"/>
</LinearLayout>
