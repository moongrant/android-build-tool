<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/APP_THEME_BACKGROUND_COLOR"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <LinearLayout
        android:background="@color/color_white"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <EditText
            android:textColor="@color/color_alpha_87"
            android:textColorHint="@color/color_alpha_38"
            android:gravity="start|center_vertical"
            android:id="@+id/activity_room_re_name_edit"
            android:background="@color/color_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="56dp"
            android:hint="@string/Room_name"
            android:singleLine="true"
            android:maxLength="24"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/text_style_z16"/>
        <ImageView
            android:id="@+id/activity_room_re_name_clean"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_room_edit_close"
            android:layout_weight="0"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textColor="@color/color_alpha_38"
            android:id="@+id/activity_room_re_name_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="24"
            android:layout_weight="0"
            style="@style/text_style_z16"/>
    </LinearLayout>
</LinearLayout>
