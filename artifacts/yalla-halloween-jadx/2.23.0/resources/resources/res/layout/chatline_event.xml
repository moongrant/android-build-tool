<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/ChatItemRoot">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="245dp"
        style="@style/ChatItemSystem">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">
            <com.yalla.netimage.NetImageView
                android:id="@+id/niv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/ivMore"
                android:background="@drawable/event_shape_event_more_bg"
                android:padding="2dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="10dp"
                android:src="@mipmap/ic_more_event"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:id="@+id/ivEventState"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_explore_event_time"/>
            <TextView
                android:textSize="12dp"
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <com.yalla.yalla.ui.view.FixTextView
            android:textSize="13dp"
            android:textColor="@color/color_white"
            android:ellipsize="end"
            android:id="@+id/tvEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="12dp"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llSub"
            android:background="@drawable/shape_corner_solid_00d8c9"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_room_event_msg_sub"/>
            <TextView
                android:textColor="@color/color_white"
                android:id="@+id/tvSubscribe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/event_has_subscribe"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
