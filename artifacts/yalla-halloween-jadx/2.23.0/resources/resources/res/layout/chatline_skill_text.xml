<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout style="@style/ChatItemRoot">
        <include layout="@layout/chatline_msg_user"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ChatItemContent">
            <include
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/chatline_msg_reply"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/color_e2e2e2"
                android:id="@+id/tv_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                android:includeFontPadding="false"
                android:layout_marginStart="20dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/svga_skill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_msg_reply_layout"
                app:layout_goneMarginTop="20dp"/>
            <com.code.android.uikit.svga.SVGAView
                android:id="@+id/svga_skill"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_msg"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <ImageView style="@style/ChatItemReplyTag"/>
</FrameLayout>
