<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_header"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_ffc339"
                android:gravity="center_vertical"
                android:id="@+id/tv_trophy"
                android:background="@drawable/bg_room_contribution"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="123"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/icon_room_contribution_day"
                android:paddingStart="8dp"
                android:paddingEnd="17dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_FFB7B7B7"
                android:id="@+id/tv_contribution_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_room_Contribution_uptime"
                android:layout_centerInParent="true"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34.5dp"
                android:src="@drawable/ic_room_contribution_header"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:src="@drawable/ic_room_contribution_crown"
                android:layout_alignTop="@+id/sdv_header"
                android:layout_alignEnd="@+id/sdv_header"/>
            <com.yalla.netimage.NetImageView
                android:id="@+id/sdv_header"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginTop="26dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:src="@drawable/ic_room_contribution_top1"
                android:layout_below="@+id/sdv_header"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <com.yalla.yalla.ui.view.UserTagView
            android:gravity="center"
            android:id="@+id/headUserTagView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:minHeight="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_FFB7B7B7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_room_Contribution_Contributes"
                android:includeFontPadding="false"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/coin"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_ffc339"
                android:id="@+id/tv_coin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="7dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/color_F8F8F8"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
