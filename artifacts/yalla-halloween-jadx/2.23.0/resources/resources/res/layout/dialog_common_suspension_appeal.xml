<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_round_bg_white_r16"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/color_333333"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/common_dialog_suspension_appeal_title"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/common_dialog_suspension_appeal_blocked_id"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/color_333333"
            android:id="@+id/tvBlockedId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/common_dialog_suspension_appeal_reason"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_bg_transparent_radius4_stroke_999"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="6dp">
            <EditText
                android:textSize="14sp"
                android:textColor="@color/color_333333"
                android:textColorHint="@color/color_CCCCCC"
                android:gravity="start"
                android:id="@+id/etReason"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:hint="@string/common_dialog_suspension_appeal_hint"
                android:maxLines="150"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_999999"
                android:layout_gravity="end"
                android:id="@+id/tvNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <com.yalla.support.statebutton.StateButton
            android:enabled="false"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btConfirm"
            android:background="@color/color_00d8c9"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="5dp"
            android:text="@string/common_dialog_suspension_appeal_submit"
            android:includeFontPadding="false"
            app:radius="19dp"
            app:unableBackgroundColor="@color/color_e2e2e2"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/icon_dialog_close"
        android:layout_marginEnd="15dp"/>
</FrameLayout>
