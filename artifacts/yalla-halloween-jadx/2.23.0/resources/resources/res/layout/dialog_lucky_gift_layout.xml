<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/rl_lucky_gift_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_lucky_gift_content_wrapper"
                android:background="@drawable/bg_round_bg_white_r16"
                android:paddingTop="60dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="160dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_DE000000"
                    android:gravity="center"
                    android:id="@+id/tv_lucky_gift_title"
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/lucky_gift_congratulations"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/color_8A000000"
                    android:gravity="start"
                    android:id="@+id/tv_lucky_gift_content"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="content"
                    android:maxLines="4"
                    android:singleLine="false"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_FAB639"
                    android:gravity="center"
                    android:id="@+id/tv_lucky_gift_multiple"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="multiple"
                    android:maxLines="4"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/color_FFB600"
                    android:id="@+id/tv_lucky_gift_coin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableLeft="@drawable/coin_little"
                    android:drawablePadding="4dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_lucky_gift_confirm"
                    android:background="@drawable/selector_btn_bg_round_green_h36"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:minWidth="74dp"
                    android:text="@string/lucky_gift_confirm"/>
            </LinearLayout>
        </LinearLayout>
        <com.yalla.netimage.NetImageView
            android:id="@+id/iv_lucky_gift_animation"
            android:padding="12.5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_alignParentTop="true"/>
        <com.code.android.uikit.svga.SVGAView
            android:id="@+id/vga_lucky_gift_animation"
            android:layout_width="180dp"
            android:layout_height="240dp"
            android:scaleType="fitCenter"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:autoPlay="true"
            app:clearsAfterStop="false"
            app:loopCount="1"
            app:source="svga/anim_lucky_gift.svga"/>
    </RelativeLayout>
</LinearLayout>
