<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/dialog_open_red_gift_layout_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="40dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/dialog_open_red_gift_layout_layout_content"
                android:background="@drawable/bg_round_bg_white_r16"
                android:padding="24dp"
                android:paddingTop="80dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="20dp">
                <com.yalla.netimage.NetImageView
                    android:id="@+id/dialog_open_red_gift_layout_iv_head"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="56dp"/>
                <TextView
                    android:textColor="@color/color_666666"
                    android:gravity="center"
                    android:id="@+id/dialog_open_red_gift_layout_tv_name"
                    android:paddingTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:maxLines="1"
                    style="@style/text_style_z14"/>
                <TextView
                    android:textColor="@color/color_00d8c9"
                    android:gravity="center"
                    android:id="@+id/dialog_open_red_gift_layout_tv_info"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:text="@string/red_best_wishes"
                    android:maxLines="3"
                    android:singleLine="false"
                    style="@style/text_style_z18"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_999999"
                    android:gravity="center"
                    android:id="@+id/dialog_open_red_gift_layout_tv_detail"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="54.5dp"
                    android:minWidth="74dp"
                    android:text="@string/Lucky_Bag_View_details"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/dialog_open_red_gift_layout_tv_confirm"
                    android:background="@drawable/selector_btn_bg_round_green_h36"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="61dp"
                    android:minWidth="74dp"
                    android:text="@string/open"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/dialog_open_red_gift_layout_iv_title"
            android:padding="12.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_red_wars"
            android:layout_alignParentTop="true"/>
    </RelativeLayout>
</LinearLayout>
