<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_round_bg_white_r16"
        android:paddingBottom="24dp"
        android:layout_width="270dp"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_top"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingStart="24dp"
            android:paddingEnd="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_top"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333"
            android:id="@+id/tv_content"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/BlackList_UnJoin_And_UnFollow_Title"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/bt_unJoinAndUnFollow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/rec_color_00D8C9"
            android:gravity="center"
            android:id="@+id/bt_unJoinAndUnFollow"
            android:background="@drawable/bg_round_bg_transparent_stroke_green_r20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="@string/password_dialog_UnJoin_unFollow"
            android:textAllCaps="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"
            style="?attr/borderlessButtonStyle"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/rec_color_00D8C9"
            android:gravity="center"
            android:id="@+id/bt_unJoin"
            android:background="@drawable/bg_round_bg_transparent_stroke_green_r20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="@string/Unjoin"
            android:textAllCaps="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_unJoinAndUnFollow"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/rec_color_00D8C9"
            android:gravity="center"
            android:id="@+id/bt_unFollow"
            android:background="@drawable/bg_round_bg_transparent_stroke_green_r20"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="@string/Unfollow"
            android:textAllCaps="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_unJoin"
            style="?android:attr/borderlessButtonStyle"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_00d8c9"
            android:gravity="center"
            android:id="@+id/bt_Ok"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/OK"
            android:textAllCaps="true"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_unFollow"/>
        <ImageView
            android:id="@+id/bt_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/icon_dialog_close"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
