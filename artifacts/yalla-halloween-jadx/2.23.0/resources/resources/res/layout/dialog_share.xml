<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/layoutRoot"
    android:background="@drawable/shape_dialog_bg_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/title"
        android:paddingTop="19dp"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:text="@string/share_with_friends"/>
    <HorizontalScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/friends"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/Friends"
                android:drawableTop="@drawable/icon_share_friends"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/moments"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/moments"
                android:drawableTop="@drawable/icon_share_moment"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/facebook"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/single_third_facebook"
                android:drawableTop="@drawable/facebook"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/twitter"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/single_third_twitter"
                android:drawableTop="@drawable/icon_share_twitter"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/instagram"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/single_third_instagram"
                android:drawableTop="@drawable/icon_share_instagram"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
            <TextView
                android:textColor="@color/color_FFFFFFF_70"
                android:id="@+id/whatsApp"
                android:visibility="gone"
                android:layout_width="79dp"
                android:layout_height="match_parent"
                android:text="@string/single_third_whatsApp"
                android:drawableTop="@drawable/icon_share_whatapp"
                android:drawablePadding="10dp"
                style="@style/text_style_z13"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
