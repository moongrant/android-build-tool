<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/dialog_subscription_member_iv_bg"
        android:background="@drawable/shape_bg_dialog_subscription_member_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/dialog_subscription_member_iv_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_dialog_subscription_member_close"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/dialog_subscription_member_iv_bg"
        app:layout_constraintTop_toTopOf="@+id/dialog_subscription_member_iv_bg"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/color_00d8c9"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/dialog_subscription_member_tv_purchase"
        android:background="@drawable/bg_round_bg_transparent_stroke_green_r12"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/Reply_to_purchase"
        android:includeFontPadding="false"
        android:paddingStart="11dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_subscription_member_iv_bg"
        app:layout_constraintTop_toTopOf="@+id/dialog_subscription_member_iv_bg"/>
    <ImageView
        android:id="@+id/dialog_subscription_member_header_bg"
        android:background="@drawable/icon_dialog_subscription_member_header_bg"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/dialog_subscription_member_header"
        android:padding="1dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_vip2"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_333333"
        android:id="@+id/dialog_subscription_member_tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Knight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_header_bg"/>
    <TextView
        android:textSize="25dp"
        android:textColor="@color/color_333333"
        android:id="@+id/dialog_subscription_member_tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="USD XX.XX/1 month"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_tv_name"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_FFFFFFF"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/dialog_subscription_member_tv_subscribe_now"
        android:background="@drawable/bg_round_bg_yellow_r20_h40"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:text="@string/Subscribe"
        android:includeFontPadding="false"
        android:paddingStart="11dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_tv_info"/>
    <View
        android:id="@+id/dialog_subscription_member_view_line"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_tv_subscribe_now"
        style="@style/line_horizontal_1px"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/color_FF5F5F5F"
        android:id="@+id/dialog_subscription_member_tv_instructions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/Recurring_billing_Cancel_anytime"
        android:drawablePadding="3dp"
        android:drawableStart="@drawable/icon_dialog_subscription_member_message_tips"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_view_line"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_999999"
        android:id="@+id/dialog_subscription_member_tv_instructions_content"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.5dp"
        android:text="@string/subscription_member_instructions_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_subscription_member_tv_instructions_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
