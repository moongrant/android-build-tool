<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/composeView"
        app:rcv_topLeftRadiu="16dp"
        app:rcv_topRightRadiu="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/color_content_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/llMainMomentNotice"
                android:background="@mipmap/ic_moment_top_notice_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_h2"
                    android:gravity="center_vertical"
                    android:id="@+id/tvMomentNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/moments_comment_notice"
                    android:includeFontPadding="false"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@mipmap/ic_moment_top_notice_clock"/>
            </LinearLayout>
            <com.booking.rtlviewpager.RtlViewPager
                android:id="@+id/vpMainMoment"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeMomentCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
