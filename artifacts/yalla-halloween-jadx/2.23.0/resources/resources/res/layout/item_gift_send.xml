<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="90dp"
    android:layout_height="101dp">
    <View
        android:id="@+id/selectBg"
        android:background="@drawable/bg_round_bg_transparent_stroke_green_r7"
        android:paddingTop="7dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <com.code.android.uikit.svga.SVGAView
        android:id="@+id/giftImage"
        android:visibility="visible"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:autoPlay="true"
        app:layout_constraintBottom_toTopOf="@+id/price"
        app:layout_constraintEnd_toEndOf="@+id/selectBg"
        app:layout_constraintStart_toStartOf="@+id/selectBg"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/currency"
        android:layout_width="13dp"
        android:layout_height="15.5dp"
        android:layout_marginBottom="8.5dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/selectBg"
        app:layout_constraintEnd_toStartOf="@+id/price"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/selectBg"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_coin"
        android:ellipsize="end"
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="15.5dp"
        android:maxWidth="57dp"
        android:lines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/currency"
        app:layout_constraintEnd_toEndOf="@+id/selectBg"
        app:layout_constraintStart_toEndOf="@+id/currency"
        app:layout_constraintTop_toTopOf="@+id/currency"/>
    <ImageView
        android:id="@+id/ivGiftTag"
        android:visibility="gone"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/selectBg"
        app:layout_constraintTop_toTopOf="@+id/selectBg"/>
    <ImageView
        android:id="@+id/ivGiftNewTag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:src="@drawable/ic_gift_tag_new"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/selectBg"
        app:layout_constraintTop_toTopOf="@+id/selectBg"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#1e1c2f"
        android:id="@+id/tvGiftTag"
        android:background="@drawable/bg_round_gift_member_tag_h13"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/LV_XXX"
        android:layout_marginEnd="10dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/selectBg"
        app:layout_constraintTop_toTopOf="@+id/selectBg"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:id="@+id/tvGiftBackpackTag"
        android:background="@drawable/bg_ffe65993_r360"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="10dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="@+id/selectBg"
        app:layout_constraintTop_toTopOf="@+id/selectBg"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/layoutGiftBackpackTimeTag"
        android:background="@drawable/bg_ff575572_r360"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/giftImage"
        app:layout_constraintEnd_toEndOf="@+id/giftImage"
        app:layout_constraintStart_toStartOf="@+id/giftImage">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ivGiftBackpackTimeTag"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:src="@drawable/ic_gift_backpack_time_red"
            android:layout_weight="0"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="3dp"
            android:layout_marginVertical="1dp"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tvGiftBackpackTimeTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
