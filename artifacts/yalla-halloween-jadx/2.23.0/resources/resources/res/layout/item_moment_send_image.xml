<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_moment_send_image_layout"
    android:layout_width="105dp"
    android:layout_height="105dp"
    android:layout_margin="3dp">
    <com.yalla.netimage.NetImageView
        android:id="@+id/item_moment_send_image_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/item_moment_send_image_gif"
        android:background="@drawable/icon_gif_circle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/single_GIF"
        app:layout_constraintBottom_toBottomOf="@+id/item_moment_send_image_image"
        app:layout_constraintEnd_toEndOf="@+id/item_moment_send_image_image"/>
    <ImageView
        android:id="@+id/item_moment_send_image_del"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="2dp"
        android:src="@mipmap/icon_moment_image_del"
        app:layout_constraintEnd_toEndOf="@+id/item_moment_send_image_image"
        app:layout_constraintTop_toTopOf="@+id/item_moment_send_image_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
