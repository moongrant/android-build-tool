<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/tr_50"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/topBg"
        android:background="@drawable/bg_round_bg_white_top_r24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/itemBg"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/fr_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintStart_toStartOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <ImageView
        android:id="@+id/iv_officials"
        android:visibility="gone"
        android:layout_width="27dp"
        android:layout_height="16dp"
        android:layout_marginTop="-2dp"
        android:src="@drawable/icon_userinfo_official"
        android:layout_marginEnd="-2dp"
        app:layout_constraintEnd_toEndOf="@+id/fr_icon"
        app:layout_constraintTop_toTopOf="@+id/fr_icon"/>
    <com.yalla.yalla.ui.view.UserTagView
        android:id="@+id/searchUserTagView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toEndOf="@+id/fr_icon"
        app:layout_constraintTop_toTopOf="@+id/content"/>
    <View
        android:id="@+id/line"
        android:visibility="gone"
        android:layout_marginStart="72dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="@+id/content"
        app:layout_constraintStart_toEndOf="@+id/fr_icon"
        style="@style/line_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
