<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="13sp"
        android:textColor="@color/color_333333_85"
        android:textColorHint="@color/color_333333_25"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/content"
        android:background="@drawable/bg_round_bg_f5f5f7_r6"
        android:paddingLeft="12dp"
        android:paddingTop="11.5dp"
        android:paddingRight="12dp"
        android:paddingBottom="11.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:hint="@string/send_moment_poll_item_option_XXX"
        android:maxLength="60"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11.5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/delete"
        android:background="@drawable/ripple_borderless"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_poll_delete_item"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/content"
        app:layout_constraintTop_toTopOf="@+id/content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
