<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/select_picture_color_FFFFFFFF"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/layout_image_file_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ucrop_pic"
        android:scaleType="centerCrop"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/RoundedStyle"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="14dp"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/layout_image_file_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="File Name (1)"
        android:maxLines="1"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_image_file_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/select_picture_color_1f000000"
        android:layout_width="0dp"
        android:layout_height="2px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/layout_image_file_name_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
