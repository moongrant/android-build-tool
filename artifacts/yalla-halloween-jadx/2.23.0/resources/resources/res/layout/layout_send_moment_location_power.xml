<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutAddress"
        android:background="@drawable/bg_round_stroke_gray_solid_write"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:foreground="@drawable/ripple_border_round"
        android:layout_marginStart="16dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivAddress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_post_location"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_333333_45"
            android:textColorHint="@color/color_333333_45"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvAddress"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/Location"
            android:maxLines="1"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ivAddressCancel"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_address_cancel"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layoutPower"
        android:background="@drawable/bg_round_stroke_gray_solid_write"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:foreground="@drawable/ripple_border_round"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivPower"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/icon_authority_open"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_333333_45"
            android:textColorHint="@color/color_333333_45"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvPower"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/Public"
            android:maxLines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
