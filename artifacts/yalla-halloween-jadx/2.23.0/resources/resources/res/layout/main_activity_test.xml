<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/base_header_layout"/>
    <View
        android:background="@color/line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"/>
    <com.yalla.yalla.ui.view.SwitchView
        android:id="@+id/switchView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="66dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.yalla.ui.view.ScrollableViews
        android:id="@+id/scrollNumberViewsM"
        android:background="@color/tr_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/switchView"/>
    <com.yalla.yalla.ui.view.ScrollableViews
        android:id="@+id/scrollNumberViewsH"
        android:background="@color/tr_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/scrollNumberViewsM"/>
    <com.yalla.yalla.ui.view.ScrollableViews
        android:id="@+id/scrollNumberViewsX"
        android:background="@color/tr_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/scrollNumberViewsH"/>
    <com.yalla.yalla.ui.view.ScrollableViews
        android:id="@+id/scrollNumberViewsXX"
        android:background="@color/tr_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/scrollNumberViewsX"/>
</androidx.constraintlayout.widget.ConstraintLayout>
