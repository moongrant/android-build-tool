<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="275dp"
    app:layout_constraintTop_toBottomOf="@+id/cLHead">
    <ImageView
        android:id="@+id/ivNetworkFailed"
        android:background="@drawable/icon_conncet_interrupt_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_666666"
        android:gravity="center"
        android:id="@+id/tvNetworkFailed1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="@string/network_failed"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivNetworkFailed"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_666666"
        android:gravity="center"
        android:id="@+id/tvNetworkFailed2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tryAgain"
        android:includeFontPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNetworkFailed1"/>
    <com.yalla.support.statebutton.StateButton
        android:textSize="16sp"
        android:textColor="@color/color_00d8c9"
        android:gravity="center"
        android:id="@+id/tvTryAgain"
        android:background="@color/color_D9F9F7"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="32dp"
        android:text="@string/try_again"
        android:includeFontPadding="false"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/ic_clock_dialog_refresh_not_network"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNetworkFailed2"
        app:radius="22dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
