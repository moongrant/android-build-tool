<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingTop="10dp"
    android:layout_width="228dp"
    android:layout_height="wrap_content"
    android:paddingStart="25dp"
    android:paddingEnd="25dp">
    <ImageView
        android:background="@drawable/bg_shape_stroke_e2e2e2_6"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivEvent"
        app:layout_constraintStart_toStartOf="@+id/ivEvent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivEvent"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="129dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:background="@drawable/shape_event_item_image_shadow"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivEvent"
        app:layout_constraintEnd_toEndOf="@+id/ivEvent"
        app:layout_constraintStart_toStartOf="@+id/ivEvent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivEvent"
        app:layout_constraintStart_toStartOf="@+id/ivEvent">
        <ImageView
            android:id="@+id/ivEventTime"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_event_time"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tvEventTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/color_5f5f5f"
        android:ellipsize="end"
        android:id="@+id/tvEventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/ivEvent"
        app:layout_constraintStart_toStartOf="@+id/ivEvent"
        app:layout_constraintTop_toBottomOf="@+id/ivEvent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEventTitle">
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_event_share_room"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/color_999999"
            android:ellipsize="end"
            android:id="@+id/tvEventRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="86dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
        <androidx.legacy.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@drawable/ic_event_share_id"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/color_999999"
            android:ellipsize="end"
            android:id="@+id/tvEventId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="86dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
