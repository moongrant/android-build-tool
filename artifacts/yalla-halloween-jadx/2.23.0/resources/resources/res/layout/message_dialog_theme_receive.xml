<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBg"
        android:background="@drawable/message_dialog_receive_bg"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/flTheme"
        app:layout_constraintEnd_toEndOf="@+id/flTheme"
        app:layout_constraintStart_toStartOf="@+id/flTheme"
        app:layout_constraintTop_toTopOf="@+id/flTheme"/>
    <ImageView
        android:id="@+id/ivBgShape"
        android:background="@drawable/message_dialog_receive_bg_shape"
        android:layout_width="305dp"
        android:layout_height="515dp"
        app:layout_constraintBottom_toBottomOf="@+id/flTheme"
        app:layout_constraintEnd_toEndOf="@+id/flTheme"
        app:layout_constraintStart_toStartOf="@+id/flTheme"
        app:layout_constraintTop_toTopOf="@+id/flTheme"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/flTheme"
        android:layout_width="270dp"
        android:layout_height="480dp"
        app:cardCornerRadius="7dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">
        <ImageView
            android:id="@+id/ivTheme"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.code.android.videoplayer.view.VideoView
            android:id="@+id/videoView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/ivBgStroke"
        android:layout_width="285dp"
        android:layout_height="497dp"
        android:src="@drawable/message_dialog_receive_bg_stroke"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/flTheme"
        app:layout_constraintEnd_toEndOf="@+id/flTheme"
        app:layout_constraintStart_toStartOf="@+id/flTheme"
        app:layout_constraintTop_toTopOf="@+id/flTheme"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/message_private_chat_dialog_room_theme_close"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="@+id/flTheme"
        app:layout_constraintTop_toTopOf="@+id/flTheme"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:minHeight="50dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTheme">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_673300"
            android:gravity="center"
            android:id="@+id/btConfirm"
            android:background="@drawable/message_shape_give_theme"
            android:visibility="gone"
            android:layout_width="131dp"
            android:layout_height="38dp"
            android:text="@string/message_private_chat_dialog_theme_receive"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tvReceived"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginStart="46dp"
            android:layout_marginEnd="46dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_FC5"
            android:id="@+id/tvView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_theme_view_more"
            android:textAlignment="center"
            android:layout_marginStart="46dp"
            android:layout_marginEnd="46dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
