<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_send"/>
    <com.code.android.uikit.svga.SVGAView
        android:id="@+id/svga_message_status"
        android:visibility="visible"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/clShareEventSend"
        app:layout_constraintEnd_toStartOf="@+id/clShareEventSend"
        app:layout_constraintTop_toTopOf="@+id/clShareEventSend"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clShareEventSend"
        android:layout_width="252dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/bg_shape_stroke_e2e2e2_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.netimage.NetImageView
            android:id="@+id/ivEvent"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="@drawable/shape_event_item_image_shadow"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivEvent">
            <ImageView
                android:id="@+id/ivEventTime"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_event_time"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:layout_marginStart="4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/ivEvent"
            app:layout_constraintStart_toStartOf="@+id/ivEvent"
            app:layout_constraintTop_toBottomOf="@+id/ivEvent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivEvent"
            app:layout_constraintStart_toStartOf="@+id/ivEvent"
            app:layout_constraintTop_toBottomOf="@+id/tvEventName">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_explore_event_room"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:id="@+id/tvRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="115dp"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"/>
            <androidx.legacy.widget.Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_explore_event_id"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_999999"
                android:id="@+id/tvRoomId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.yalla.yalla.ui.view.FixTextView
        android:textSize="14sp"
        android:textColor="#35bba3"
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/tvDeleted"
        android:background="@drawable/bg_chitchat_send"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/niv_chat_message_header"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header"
        style="@style/private_chat_item_bg_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
