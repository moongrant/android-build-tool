<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_receive"/>
    <RelativeLayout
        android:id="@+id/fl_share_topic_receive"
        android:background="@drawable/bg_shape_stroke_f5f5f5_6"
        android:padding="0.5dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header">
        <com.yalla.netimage.NetImageView
            android:id="@+id/nv_share_topic_head_photo_receive"
            android:background="@color/color_EDEDED"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerInside"/>
        <View
            android:background="@color/font_line_d5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/nv_share_topic_head_photo_receive"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_topic_name_receive"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/nv_share_topic_head_photo_receive"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <com.yalla.yalla.ui.view.TopicFollowPostNumberView
            android:id="@+id/tv_share_receive_topic_number"
            android:paddingTop="5dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_share_topic_name_receive"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_share_topic_tag_send"
            android:background="@drawable/bgs_button_tr20_r12"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_margin="6dp"
            android:text="@string/chat_tag_Topic"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:layout_alignParentTop="true"
            android:drawableStart="@drawable/message_ic_chat_share_tag_topic"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
