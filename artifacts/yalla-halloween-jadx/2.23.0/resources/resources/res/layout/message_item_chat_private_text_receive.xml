<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_receive"/>
    <com.yalla.yalla.ui.view.FixTextView
        android:textSize="14sp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_chat_private_text"
        android:background="@drawable/bg_chitchat_receive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:text=""
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header"
        style="@style/private_chat_item_bg_left"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:id="@+id/tv_chat_private_text_privacy"
        android:background="@drawable/bg_shape_chat_privacy"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/private_chat_privacy"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_chat_private_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
