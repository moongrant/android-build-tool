<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/message_item_layout"
    android:background="@drawable/ripple_border"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:paddingEnd="16dp">
    <FrameLayout
        android:id="@+id/v_header"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yalla.netimage.NetImageView
            android:layout_gravity="center"
            android:id="@+id/niv_header"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_head_default_circle"/>
        <com.code.android.uikit.svga.SVGAView
            android:layout_gravity="center"
            android:id="@+id/svgaView"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:antiAlias="true"
            app:autoPlay="true"
            app:clearsAfterStop="false"
            app:fillMode="Forward"
            app:loopCount="0"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/iv_official"
            android:visibility="visible"
            android:layout_width="33dp"
            android:layout_height="17dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/icon_userinfo_official"
            android:layout_marginEnd="2dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="5dp"
                android:layout_weight="1"
                android:textDirection="locale"
                android:textAlignment="viewStart"/>
            <com.yalla.yalla.ui.view.SexView
                android:id="@+id/sexView"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/icon_male"
                android:layout_marginStart="6dp"/>
            <com.yalla.yalla.ui.view.UserWealthTagView
                android:id="@+id/wealthView"
                android:visibility="gone"
                android:layout_width="33dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"/>
            <com.yalla.yalla.ui.view.UserPremiumView
                android:id="@+id/vipView"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_vip2"
                android:layout_marginStart="6dp"/>
            <com.yalla.yalla.ui.view.UserVipView
                android:id="@+id/ivKaVip"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_333333_45"
            android:gravity="center_vertical"
            android:id="@+id/tv_bio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/Userinfo_Sign_Hint"
            android:singleLine="true"
            android:layout_marginEnd="84dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_room"
        android:background="@drawable/ripple_border_round"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_friends_live"
        android:scaleType="center"
        android:layout_marginStart="23dp"/>
</LinearLayout>
