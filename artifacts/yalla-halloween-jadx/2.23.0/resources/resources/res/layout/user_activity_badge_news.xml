<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/base_header_layout"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_radius10_color_whit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/color_666666"
            android:gravity="center"
            android:id="@+id/tvRecentlyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:maxWidth="220dp"
            android:text="@string/user_badge_moment_title"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/user_badge_moment_left"
            android:drawableEnd="@drawable/user_badge_moment_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/vBg"
            android:background="@drawable/shape_radius16_color_ec"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tvRecentlyTitle"/>
        <com.yalla.yalla.ui.view.indicator.YlTableLayout
            android:id="@+id/tlBadgeTable"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/vBg"
            app:layout_constraintEnd_toEndOf="@+id/vBg"
            app:layout_constraintStart_toEndOf="@+id/vBg"
            app:layout_constraintTop_toTopOf="@+id/vBg"/>
        <com.booking.rtlviewpager.RtlViewPager
            android:id="@+id/vpMainMoment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tlBadgeTable"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
