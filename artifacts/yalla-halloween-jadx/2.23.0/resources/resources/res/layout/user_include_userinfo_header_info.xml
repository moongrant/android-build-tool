<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/abl_userinfo"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/ctl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:collapsedTitleGravity="center"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"
        app:titleEnabled="false">
        <include
            android:id="@+id/details"
            layout="@layout/user_include_userinfo_headr_info_details"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_holder"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            app:layout_collapseMode="pin"/>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
    <com.yalla.yalla.ui.view.indicator.YlTableLayout
        android:id="@+id/magicIndicator"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <View
        android:background="@color/color_alpha_8"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</com.google.android.material.appbar.AppBarLayout>
