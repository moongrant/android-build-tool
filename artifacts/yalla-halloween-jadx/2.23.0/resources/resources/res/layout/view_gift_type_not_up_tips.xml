<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/gift_type_tips_bg_vip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivFg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_gift_type_not_up_tips_fg_vip"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivFgStart"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_gift_type_not_up_tips_fg_wealth_start"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivFgEnd"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_gift_type_not_up_tips_fg_wealth_end"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivFlags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:src="@drawable/gift_type_tips_bg_flags"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivType"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@mipmap/ic_gift_type_not_up_vip"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="@+id/ivBg"/>
    <com.code.android.uikit.marquee.MarqueeText
        android:textSize="13sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/tvInfo"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
        app:layout_constraintHorizontal_weight="0"
        app:layout_constraintStart_toEndOf="@+id/ivType"
        app:layout_constraintTop_toTopOf="@+id/ivBg"
        app:layout_constraintWidth="1"/>
    <ImageView
        android:id="@+id/ivArrow"
        android:background="@drawable/bgs_button_write_r360"
        android:padding="4dp"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:src="@mipmap/ic_gift_type_not_up_arrow_vip"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="@+id/ivBg"
        app:layout_constraintTop_toTopOf="@+id/ivBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
