<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="32dp">
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_gift_send_wealth_fg"
        android:scaleType="fitXY"/>
    <View
        android:id="@+id/ivBgContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="60dp"/>
    <com.code.android.uikit.svga.SVGAView
        android:id="@+id/ivLevel"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:autoPlay="true"
        app:fillMode="Forward"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:loopCount="0"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_FFE574_70"
        android:gravity="start|center_vertical"
        android:id="@+id/tvUnlockContent"
        android:paddingLeft="56dp"
        android:paddingRight="56dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/gift_WealthUnlockContent"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="56dp"
        app:layout_constraintHorizontal_bias="0"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/color_white_73"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/tvUpdateContent"
        android:paddingBottom="7.5dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginEnd="48dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivBgContent"
        app:layout_constraintEnd_toEndOf="@+id/ivBgContent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/ivBgContent"/>
    <View
        android:id="@+id/progressWealthBg"
        android:background="@drawable/bg_ffffff_40"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="7.5dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="@+id/ivBgContent"
        app:layout_constraintStart_toStartOf="@+id/ivBgContent"
        app:layout_constraintTop_toTopOf="@+id/ivBgContent"/>
    <View
        android:id="@+id/progressWealth"
        android:background="@drawable/bg_fff090_ffc952"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/progressWealthBg"
        app:layout_constraintEnd_toEndOf="@+id/progressWealthBg"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/progressWealthBg"
        app:layout_constraintTop_toTopOf="@+id/progressWealthBg"/>
    <ImageView
        android:id="@+id/ivWealthUnlockedArrow"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:src="@mipmap/ic_arrow_gray_gift_send"
        android:scaleType="center"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBgContent"
        app:layout_constraintEnd_toEndOf="@+id/ivBgContent"
        app:layout_constraintTop_toTopOf="@+id/ivBgContent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/color_white_57"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/tvFullContent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/gift_WealthFullLevel"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:drawablePadding="8dp"
        android:marqueeRepeatLimit="marquee_forever"
        android:drawableEnd="@mipmap/ic_arrow_gray_gift_send"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/ivBgContent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/ivBgContent"/>
    <ImageView
        android:id="@+id/ivWealthLine"
        android:background="@drawable/bg_line_gray_white_gray_vertical"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivBgContent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivWealthUpdate"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/ic_wealth_update_gift_send"
        android:scaleType="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
