<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/color_FF5F5F5F"
            android:gravity="center"
            android:id="@+id/cancel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/CANCEL"
            android:layout_weight="0"
            android:paddingStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/bg"
            android:background="@drawable/bg_round_gray_true_h44"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/tag"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_search"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintStart_toStartOf="@+id/bg"
            app:layout_constraintTop_toTopOf="@+id/bg"/>
        <ImageView
            android:id="@+id/clear"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_edit_close"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toEndOf="@+id/bg"
            app:layout_constraintTop_toTopOf="@+id/bg"/>
        <EditText
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/edit"
            android:background="@color/transparent"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:hint="@string/Search_user_name_or_id"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:textDirection="anyRtl"
            android:textAlignment="viewStart"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toStartOf="@+id/clear"
            app:layout_constraintStart_toEndOf="@+id/tag"
            app:layout_constraintTop_toTopOf="@+id/bg"
            style="@style/text_style_z13"/>
        <TextView
            android:textColor="@color/color_999999"
            android:gravity="start|center_vertical"
            android:id="@+id/hint"
            android:background="@color/transparent"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:hint="@string/Search_user_name_or_id"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintEnd_toStartOf="@+id/clear"
            app:layout_constraintStart_toEndOf="@+id/tag"
            app:layout_constraintTop_toTopOf="@+id/bg"
            style="@style/text_style_z13"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
