<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffffff"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="25dp"
        android:paddingBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:id="@+id/vCloseHolder"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ff333333"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:includeFontPadding="false"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff5f5f5f"
            android:id="@+id/tvMessage"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <FrameLayout
            android:id="@+id/flCustom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/tvConfirm"
            android:background="@drawable/yl_dialog_confirm_bg_selector"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:foreground="@drawable/yl_dialog_ripple_round"
            android:text="@string/yl_dialog_OK"
            android:includeFontPadding="false"
            android:textAllCaps="false"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff333333"
            android:gravity="center"
            android:id="@+id/tvRefuse"
            android:background="@drawable/yl_dialog_refuse_bg_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="15dp"
            android:foreground="@drawable/yl_dialog_ripple_round"
            android:text="@string/yl_dialog_Cancel"
            android:includeFontPadding="false"
            android:textAllCaps="false"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivClose"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="12dp"
        android:src="@mipmap/yldialog_ic_close"/>
</FrameLayout>
