<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout style="@style/ChatItemRoot">
        <include layout="@layout/chatline_msg_user"/>
        <LinearLayout style="@style/ChatItemContent">
            <com.yalla.netimage.NetImageView
                android:id="@+id/fd_img"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </FrameLayout>
    <ImageView style="@style/ChatItemReplyTag"/>
</FrameLayout>
