<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yalla.yalla.ui.view.gift.GiftTopTipsView
        android:gravity="bottom"
        android:id="@+id/topTipsView"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottom"
        android:background="@drawable/shape_bg_dialog_gift_send_bottom_black"
        android:layout_width="match_parent"
        android:layout_height="411dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:id="@+id/layoutRecharge"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_crystal"
                android:gravity="center"
                android:id="@+id/crystal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/icon_crystal_main_slide"
                android:drawableEnd="@drawable/ic_crystal_arrow"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_coin"
                android:gravity="center"
                android:id="@+id/coin"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:maxLines="1"
                android:singleLine="true"
                android:drawablePadding="4dp"
                android:drawableStart="@drawable/coin_little"
                android:drawableEnd="@drawable/ic_coin_arrow"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/firstChargeReward"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:src="@drawable/ic_recharge_reward"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/layoutRecharge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/layoutRecharge"
            app:layout_constraintTop_toTopOf="@+id/layoutRecharge"/>
        <com.yalla.yalla.ui.view.gift.GiftWealthView
            android:id="@+id/giftWealthView"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutRecharge"/>
        <com.yalla.yalla.ui.view.indicator.YlTableLayout
            android:id="@+id/tabLayout"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/giftWealthView"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="234dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customGiftWarnContainer"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutSelectAndSend"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/send_gift_wan_tv"
            android:background="@drawable/send_gift_warn_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_gift_custom_made_gift_custom_second_warn"
            android:paddingStart="10dp"
            android:paddingEnd="29dp"
            android:paddingVertical="3dp"
            app:layout_constraintEnd_toStartOf="@+id/sendCustomGiftWarn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/sendCustomGiftWarn"
            android:padding="10dp"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:src="@drawable/icv_close"
            app:layout_constraintBottom_toBottomOf="@+id/send_gift_wan_tv"
            app:layout_constraintEnd_toEndOf="@+id/send_gift_wan_tv"
            app:layout_constraintTop_toTopOf="@+id/send_gift_wan_tv"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="8dp"
            android:layout_height="5dp"
            android:layout_marginBottom="5dp"
            android:src="@mipmap/room_menu_change_wan_arrow"
            android:scaleType="fitXY"
            android:layout_marginEnd="29dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/send_gift_wan_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/overrideGiftContainer"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <FrameLayout
        android:id="@+id/layoutShowSelectView"
        android:background="@color/tr_00"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layoutSelectAndSend"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="12.5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutUser"
            android:background="@drawable/shape_bg_gift_dialog_send_user"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:paddingStart="6dp">
            <com.yalla.netimage.NetImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivHead"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-3dp"/>
            <TextView
                android:textColor="@color/color_FFFFFFF"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:autoSizeMaxTextSize="13dp"
                app:autoSizeMinTextSize="11dp"
                app:autoSizeStepGranularity="1dp"
                app:autoSizeTextType="uniform"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/userUp"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_room_gift_top_white"
                android:layout_marginEnd="15dp"
                app:tint="@color/color_white"/>
            <View
                android:id="@+id/vLine"
                android:background="@color/color_00d8c9"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivAllRoom"
                android:background="@drawable/selector_bg_dialog_gift_all"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_room_send_gift_all_room"
                android:paddingEnd="2dp"/>
        </LinearLayout>
        <TextView
            android:enabled="true"
            android:textSize="13sp"
            android:textColor="@color/color_FFFFFFF"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/giftNum"
            android:background="@drawable/bgs_stroke_00d8c9_5f5f5f_end_r16"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:text="1"
            android:drawableEnd="@drawable/icon_room_gift_top_white"
            android:paddingEnd="8dp"
            android:layout_marginStart="16dp"/>
        <TextView
            android:enabled="true"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvSend"
            android:background="@drawable/bgs_00d8c9_5f5f5f_end_r16"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:text="@string/Send"
            android:includeFontPadding="false"
            android:layout_marginStart="-1dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layoutHideSelectView"
        android:background="@color/tr_00"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <LinearLayout
        android:gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/hintFirstSelectTotalGift"
        android:background="@drawable/quik_room_change_room_bg"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="101dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutSelectAndSend"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="end"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/first_select_total_gift"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/switch_close_icon"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/hintFirstSelectAllUser"
        android:background="@drawable/icon_gift_giude_seleted_send_all"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layoutSelectAndSend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/send_gift_everyone_tip"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/switch_close_icon"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSendGiftEffect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="524.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.code.android.uikit.svga.SVGAView
            android:id="@+id/giftEffectImage"
            android:visibility="visible"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="464dp"
            app:autoPlay="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.yalla.yalla.ui.view.gift.GiftNumberView
            android:gravity="center_vertical"
            android:id="@+id/giftCount"
            android:layout_width="wrap_content"
            android:layout_height="54.5dp"
            android:layout_marginBottom="568dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
