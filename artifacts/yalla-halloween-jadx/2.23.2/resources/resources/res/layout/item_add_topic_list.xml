<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/color_999999"
        android:gravity="start|center_vertical"
        android:id="@+id/item_add_topic_local_list_tv_title"
        android:background="@color/color_fff5f5f5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="@string/Recently_Used"
        android:singleLine="true"
        android:paddingStart="20dp"
        style="@style/EditText_Alignment"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/color_333333"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/item_add_topic_local_list_tv_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55.5dp"
        android:text="@string/New_Topic"
        android:singleLine="true"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/icon_topic_color"
        android:paddingStart="16dp"
        style="@style/EditText_Alignment"/>
    <View
        android:id="@+id/item_add_topic_local_list_view_line"
        android:background="@color/color_e2e2e2"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        style="@style/line_horizontal"/>
    <ImageView
        android:id="@+id/item_add_topic_local_list_iv_upDown"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_margin="3dp"
        android:src="@drawable/icon_topic_recently_down"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/item_add_topic_list_layout"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingStart="15dp">
        <com.yalla.netimage.NetImageView
            android:id="@+id/item_add_topic_list_iv_head"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_head_default_circular"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_add_topic_list_layout_content"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:layout_toEndOf="@+id/item_add_topic_list_iv_head">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/item_add_topic_list_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="12.5dp"
                android:text="@string/New_Topic"
                android:singleLine="true"
                android:drawablePadding="5dp"
                android:drawableEnd="@drawable/ic_topic_owner"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/item_add_topic_list_join_tv"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/EditText_Alignment"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/item_add_topic_list_join_tv"
                android:background="@drawable/bg_round_bg_5fbeef_r10_h20"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="12.5dp"
                android:text="@string/Following"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/item_add_topic_list_name_tv"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yalla.yalla.ui.view.TopicFollowPostNumberView
                android:id="@+id/item_add_topic_list_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_add_topic_list_name_tv"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_999999"
                android:ellipsize="end"
                android:id="@+id/item_add_topic_list_info_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12.5dp"
                android:text="@string/topic_description_hint"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/item_add_topic_list_line"
            android:background="@color/color_12000000"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="68dp"
            style="@style/line_horizontal"/>
    </RelativeLayout>
</LinearLayout>
