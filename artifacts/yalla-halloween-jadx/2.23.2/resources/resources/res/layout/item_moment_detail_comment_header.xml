<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:paddingHorizontal="15dp">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_333333_45"
        android:gravity="center"
        android:id="@+id/count"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/switchLayout"
        android:background="@drawable/bg_df5f5f7_r360"
        android:padding="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_marginVertical="7dp"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/popular"
            android:background="@drawable/bg_ffffffff_r360"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Popular"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/latest"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_333333"
            android:gravity="center"
            android:id="@+id/latest"
            android:background="@drawable/bg_tr00_r360"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Latest"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@+id/latest"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
