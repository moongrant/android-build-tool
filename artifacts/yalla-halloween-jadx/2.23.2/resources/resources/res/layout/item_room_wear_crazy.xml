<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="95dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/tv_item_wear_stock"
            android:background="@drawable/bg_ffe65993_r360"
            android:layout_width="wrap_content"
            android:layout_height="12.5dp"
            android:layout_marginTop="6dp"
            android:text="0"
            android:includeFontPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="24dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_242426"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_item_wear_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minWidth="124dp"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_item_wear_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_wear_name">
            <ImageView
                android:id="@+id/wearCoin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/coin"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_FF830D"
                android:id="@+id/tv_item_wear_current_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1000"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_FAE976"
                android:id="@+id/tv_item_wear_current_pprice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2000"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white_30"
            android:id="@+id/tv_item_wear_none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/wear_no_more"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvLimitTime"
            android:background="@drawable/bgs_button_rad_r360_end"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:drawablePadding="2dp"
            android:drawableStart="@drawable/icon_magic_card_time"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/rl_item_wear_normal_wrapper"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view_item_wear_line_left"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"/>
        <View
            android:id="@+id/view_item_wear_line_top"
            android:background="@color/color_white_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <View
            android:id="@+id/view_item_wear_line_bottom"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
        <View
            android:id="@+id/view_item_wear_line_right"
            android:background="@color/color_white_10"
            android:visibility="visible"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_item_wear_selected"
        android:background="@drawable/gift_select_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
