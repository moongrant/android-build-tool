<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="49dp">
    <View
        android:background="@color/color_F1F1F1"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/ivAddImage"
            android:background="@drawable/ripple_borderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="0.5dp"
            android:src="@drawable/ic_moment_add_image"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/ivAddVideo"
            android:background="@drawable/ripple_borderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_moment_add_video"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/ivEmoji"
            android:background="@drawable/ripple_borderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_moment_add_emoji"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/ivAt"
            android:background="@drawable/ripple_borderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_moment_add_at"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
        <ImageView
            android:id="@+id/ivPoll"
            android:background="@drawable/ripple_borderless"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_moment_add_poll"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="20dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
