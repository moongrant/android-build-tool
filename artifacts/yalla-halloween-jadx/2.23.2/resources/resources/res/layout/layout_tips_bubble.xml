<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/tips_bubble_triangle_upward"
        android:background="@drawable/triangle_upward"
        android:layout_width="16dp"
        android:layout_height="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tips_bubble_content"
        android:background="@drawable/bg_tips_bubble"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_tips_bubble_content"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/color_77C3FF"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_tips_bubble_ok"
            android:background="@drawable/circle_tips_bubble_ok_bg"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginBottom="2dp"
            android:text="OK"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <View
        android:id="@+id/tips_bubble_triangle_downward"
        android:background="@drawable/triangle_downward"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_marginTop="-8dp"/>
</merge>
