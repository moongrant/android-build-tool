<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="275dp"
    app:layout_constraintTop_toBottomOf="@+id/cLHead">
    <ImageView
        android:id="@+id/ivAnimBg"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/sign_caizhi_00000"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/llAnim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivCoin"
            android:background="@drawable/icon_sigiin_anim_bg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="70dp"
            android:src="@drawable/icon_signin_anim_bgcoin"
            android:scaleType="center"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
        <ImageView
            android:id="@+id/ivCrystal"
            android:background="@drawable/icon_sigiin_anim_bg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="70dp"
            android:src="@drawable/icon_crystal_bg_dialog"
            android:scaleType="center"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/color_alpha_87_A1"
        android:id="@+id/tvSignDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llAnim"/>
</androidx.constraintlayout.widget.ConstraintLayout>
