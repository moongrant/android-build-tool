<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="25dp"
    android:paddingEnd="25dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dialog_post_share_fl"
        android:background="@drawable/bg_shape_f5f5f5_6"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp">
            <com.yalla.netimage.NetImageView
                android:id="@+id/dialog_post_share_nv_head_photo"
                android:visibility="visible"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/icon_head_default"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivVideo"
                android:background="@mipmap/icon_moment_type_video"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/dialog_post_share_tv_name"
            android:background="@color/tr_00"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/color_5f5f5f"
        android:textColorHint="@color/color_CCCCCC"
        android:gravity="start|top"
        android:id="@+id/dialog_post_share_et"
        android:background="@drawable/bg_round_bg_stroke_e2e2e2_r3"
        android:paddingTop="9dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="@string/et_share_leave_message"
        android:maxLength="300"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_post_share_fl"
        style="@style/EditText_Alignment"/>
</LinearLayout>
