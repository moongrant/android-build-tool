<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_chat_private_message_time"/>
    <include layout="@layout/include_chat_private_message_header_receive"/>
    <RelativeLayout
        android:id="@+id/fl_share_post_receive"
        android:background="@drawable/bg_shape_stroke_f5f5f5_6"
        android:padding="0.5dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/niv_chat_message_header"
        app:layout_constraintTop_toTopOf="@+id/niv_chat_message_header">
        <ImageView
            android:id="@+id/nv_share_post_head_photo_receive_bg"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/bg_shape_stroke_ededed_r6"/>
        <FrameLayout
            android:id="@+id/fl_share_photo"
            android:layout_width="200dp"
            android:layout_height="200dp">
            <com.yalla.netimage.NetImageView
                android:id="@+id/nv_share_post_head_photo_receive"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivVideo"
                android:background="@mipmap/icon_moment_type_video"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
        <View
            android:background="@color/font_line_d5"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/fl_share_photo"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/color_6D6D6D"
            android:ellipsize="end"
            android:id="@+id/tv_share_post_name_receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:maxLines="2"
            android:layout_below="@+id/fl_share_photo"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_share_post_tag_send"
            android:background="@drawable/bgs_button_tr20_r12"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_margin="6dp"
            android:text="@string/chat_tag_Post"
            android:maxLines="1"
            android:drawablePadding="3dp"
            android:layout_alignParentTop="true"
            android:drawableStart="@drawable/message_ic_chat_share_tag_post"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
