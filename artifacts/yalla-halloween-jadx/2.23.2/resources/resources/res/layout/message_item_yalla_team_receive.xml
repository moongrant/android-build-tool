<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvTime"
        android:background="@drawable/privatechat_time_bg"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/ivIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_marginBaseline="14dp"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:src="@mipmap/icon_yalla_team"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTime"/>
    <View
        android:id="@+id/vHolder"
        android:layout_width="5dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toEndOf="@+id/ivIcon"
        app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/llBg"
        android:background="@drawable/bg_item_yalla_team_image"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vHolder"
        app:layout_constraintTop_toTopOf="@+id/ivIcon">
        <com.yalla.netimage.NetImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="122dp"
            app:layout_constraintBaseline_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.yalla.yalla.ui.view.FixTextView
            android:textSize="15sp"
            android:textColor="@color/color_333333"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@+id/ivCover"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_goneMarginTop="10dp">
            <com.yalla.yalla.ui.view.FixTextView
                android:textSize="14sp"
                android:textColor="@color/color_5f5f5f"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivTextMore"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_yalla_team_more"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_00d8c9"
            android:id="@+id/tvViewMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_yalla_team_view"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
