<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:background="@color/color_white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/hot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@mipmap/ic_moment_wonderful_comment"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/head"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/icon_head_default_circle"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hot"/>
    <ImageView
        android:id="@+id/role"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="16dp"
        android:layout_marginTop="-2dp"
        android:src="@drawable/icon_userinfo_official"
        android:layout_marginEnd="-6dp"
        app:layout_constraintEnd_toEndOf="@+id/head"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <com.yalla.yalla.ui.view.UserTagView
        android:id="@+id/userTagView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/head"
        app:layout_constraintTop_toTopOf="@+id/head"/>
    <com.yalla.yalla.ui.view.FixTextView
        android:textSize="14sp"
        android:textColor="@color/color_333333_85"
        android:ellipsize="end"
        android:gravity="start|top"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingMultiplier="1"
        android:textAlignment="textStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/userTagView"
        app:layout_constraintStart_toStartOf="@+id/userTagView"
        app:layout_constraintTop_toBottomOf="@+id/userTagView"
        style="@style/EditText_Alignment"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_333333_45"
        android:gravity="start|center_vertical"
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@+id/userTagView"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/EditText_Alignment"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_333333_65"
        android:gravity="start"
        android:id="@+id/praiseCount"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/praiseTag"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/EditText_Alignment"/>
    <ImageView
        android:id="@+id/praiseIv"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="-18dp"
        android:src="@drawable/ic_moment_comment_praise_color"
        android:scaleType="center"
        android:layout_marginEnd="30dp"
        android:layout_toStartOf="@+id/praiseCount"
        app:layout_constrainedHeight="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/praiseCount"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.code.android.uikit.svga.SVGAView
        android:id="@+id/praiseSvga"
        android:visibility="visible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="-18dp"
        android:scaleType="center"
        android:layout_marginEnd="30dp"
        android:layout_toStartOf="@+id/praiseCount"
        app:autoPlay="false"
        app:layout_constrainedHeight="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/praiseCount"
        app:layout_constraintEnd_toEndOf="parent"
        app:loopCount="1"
        app:source="svga/anim_moment_thumb_up.svga"/>
    <View
        android:id="@+id/praiseTag"
        android:background="@color/rec_color_00D8C9"
        android:visibility="invisible"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/praiseCount"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/rewardIv"
        android:layout_width="22dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_moment_comment_reward_color"
        android:scaleType="center"
        android:layout_marginEnd="108dp"
        android:layout_toStartOf="@+id/rewardCount"
        app:layout_constraintBottom_toBottomOf="@+id/rewardSvga"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.code.android.uikit.svga.SVGAView
        android:id="@+id/rewardSvga"
        android:layout_width="22dp"
        android:layout_height="40dp"
        android:layout_marginTop="-13dp"
        android:layout_marginEnd="108dp"
        android:layout_toStartOf="@+id/rewardCount"
        app:autoPlay="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"
        app:loopCount="1"
        app:source="svga/anim_moment_reward.svga"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_333333_65"
        android:gravity="start"
        android:id="@+id/rewardCount"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/praiseTag"
        app:layout_constraintStart_toEndOf="@+id/rewardIv"
        app:layout_constraintTop_toBottomOf="@+id/content"
        style="@style/EditText_Alignment"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSon"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/head"
        app:layout_constraintTop_toBottomOf="@+id/time">
        <ImageView
            android:id="@+id/bgSon"
            android:background="@drawable/bg_fff5f5f7_r8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yalla.netimage.NetImageView
            android:id="@+id/headSon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/icon_head_default_circle"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/roleSon"
            android:visibility="gone"
            android:layout_width="21dp"
            android:layout_height="13dp"
            android:layout_marginTop="-1dp"
            android:src="@drawable/icon_userinfo_official"
            android:layout_marginEnd="-6dp"
            app:layout_constraintEnd_toEndOf="@+id/headSon"
            app:layout_constraintTop_toTopOf="@+id/headSon"/>
        <com.yalla.yalla.ui.view.UserTagView
            android:id="@+id/userTagViewSon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="14dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/headSon"
            app:layout_constraintTop_toTopOf="@+id/headSon"/>
        <com.yalla.yalla.ui.view.FixTextView
            android:textSize="13sp"
            android:textColor="@color/color_333333_85"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/contentSon"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1"
            android:textIsSelectable="false"
            android:textAlignment="textStart"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/userTagViewSon"
            app:layout_constraintStart_toStartOf="@+id/userTagViewSon"
            app:layout_constraintTop_toBottomOf="@+id/userTagViewSon"
            style="@style/EditText_Alignment"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_333333_45"
            android:gravity="start|center_vertical"
            android:id="@+id/timeSon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@+id/userTagViewSon"
            app:layout_constraintTop_toBottomOf="@+id/contentSon"
            style="@style/EditText_Alignment"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_333333_65"
            android:gravity="start"
            android:id="@+id/praiseCountSon"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/praiseTagSon"
            app:layout_constraintTop_toBottomOf="@+id/contentSon"
            style="@style/EditText_Alignment"/>
        <ImageView
            android:id="@+id/praiseIvSon"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="-18dp"
            android:src="@drawable/ic_moment_comment_praise_color"
            android:scaleType="center"
            android:layout_marginEnd="30dp"
            android:layout_toStartOf="@+id/praiseCountSon"
            app:layout_constrainedHeight="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/praiseCountSon"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.code.android.uikit.svga.SVGAView
            android:id="@+id/praiseSvgaSon"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="-18dp"
            android:scaleType="center"
            android:layout_marginEnd="30dp"
            android:layout_toStartOf="@+id/praiseCountSon"
            app:autoPlay="false"
            app:layout_constrainedHeight="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/praiseCountSon"
            app:layout_constraintEnd_toEndOf="parent"
            app:loopCount="1"
            app:source="svga/anim_moment_thumb_up.svga"/>
        <View
            android:id="@+id/praiseTagSon"
            android:background="@color/rec_color_00D8C9"
            android:visibility="invisible"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/praiseCountSon"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ImageView
            android:id="@+id/rewardIvSon"
            android:layout_width="22dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_moment_comment_reward_color"
            android:scaleType="center"
            android:layout_marginEnd="108dp"
            android:layout_toStartOf="@+id/rewardCountSon"
            app:layout_constraintBottom_toBottomOf="@+id/rewardSvgaSon"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.code.android.uikit.svga.SVGAView
            android:id="@+id/rewardSvgaSon"
            android:layout_width="22dp"
            android:layout_height="40dp"
            android:layout_marginTop="-13dp"
            android:layout_marginEnd="108dp"
            android:layout_toStartOf="@+id/rewardCountSon"
            app:autoPlay="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contentSon"
            app:loopCount="1"
            app:source="svga/anim_moment_reward.svga"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_333333_65"
            android:gravity="start"
            android:id="@+id/rewardCountSon"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@+id/praiseTagSon"
            app:layout_constraintStart_toEndOf="@+id/rewardIvSon"
            app:layout_constraintTop_toBottomOf="@+id/contentSon"
            style="@style/EditText_Alignment"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:id="@+id/contentNumSon"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableEnd="@drawable/icon_xinxi_gengduo"
            app:layout_constraintStart_toStartOf="@+id/timeSon"
            app:layout_constraintTop_toBottomOf="@+id/timeSon"
            style="@style/EditText_Alignment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_height="1px"
        android:layout_marginTop="12dp"
        android:layout_marginStart="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSon"
        style="@style/line_horizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
