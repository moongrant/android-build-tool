<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/typeLayout"
    android:background="@color/transparent30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_ffffff_bottom_r16"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/type_all"
            android:background="@drawable/bg_00d8c9_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:text="@string/moment_notification_type_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/type_like"
            android:background="@drawable/bg_05333333_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:text="@string/Likes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/type_comment"
            android:background="@drawable/bg_05333333_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:text="@string/Comments"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/type_at_me"
            android:background="@drawable/bg_05333333_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="@string/moment_notification_type_at"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type_all"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/type_gifts"
            android:background="@drawable/bg_05333333_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="@string/Gifts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type_like"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_333333_65"
            android:gravity="center"
            android:id="@+id/type_other"
            android:background="@drawable/bg_05333333_r16"
            android:layout_width="101dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="@string/Other"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/type_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
