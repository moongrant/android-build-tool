<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_hot_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:layout_marginTop="12dp"
        android:text="@string/room_type_hot"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/item_hot_bg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.yalla.netimage.NetImageView
                android:id="@+id/room_header1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_room_online1"
                android:background="@drawable/bg_online_style"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="6dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintEnd_toEndOf="@+id/room_header1"
                app:layout_constraintTop_toTopOf="@+id/room_header1">
                <com.code.android.uikit.svga.SVGAView
                    android:id="@+id/lav_hot_room_live1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:autoPlay="true"
                    app:source="svga/anim_room_live.svga"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_online_num1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|top"
                android:orientation="horizontal"
                android:id="@+id/ll_room_name1"
                android:background="@drawable/bg_gradient_black"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_honor1"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="14dp"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_room_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Room Name"
                    android:singleLine="true"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <android.widget.Space
            android:id="@+id/space0"
            android:layout_width="8dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_hot_head_right"
            android:layout_width="105dp"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/item_hot_bg2"
                android:layout_width="106dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.yalla.netimage.NetImageView
                    android:id="@+id/room_header2"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:src="@drawable/icon_head_default"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_room_online2"
                    android:background="@drawable/bg_online_style"
                    android:layout_width="wrap_content"
                    android:layout_height="19dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintEnd_toEndOf="@+id/room_header2"
                    app:layout_constraintTop_toTopOf="@+id/room_header2">
                    <com.code.android.uikit.svga.SVGAView
                        android:id="@+id/lav_hot_room_live2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:autoPlay="true"
                        app:source="svga/anim_room_live.svga"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_online_num2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|top"
                    android:orientation="horizontal"
                    android:id="@+id/ll_room_name2"
                    android:background="@drawable/bg_gradient_black"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/iv_honor2"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="9dp"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tv_room_name2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Room Name"
                        android:singleLine="true"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <android.widget.Space
                android:id="@+id/space1"
                android:layout_width="match_parent"
                android:layout_height="8dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/item_hot_bg3"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:layout_weight="1">
                <com.yalla.netimage.NetImageView
                    android:id="@+id/room_header3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_head_default"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ll_room_online3"
                    android:background="@drawable/bg_online_style"
                    android:layout_width="wrap_content"
                    android:layout_height="19dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintEnd_toEndOf="@+id/room_header3"
                    app:layout_constraintTop_toTopOf="@+id/room_header3">
                    <com.code.android.uikit.svga.SVGAView
                        android:id="@+id/lav_hot_room_live3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        app:autoPlay="true"
                        app:source="svga/anim_room_live.svga"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_online_num3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|top"
                    android:orientation="horizontal"
                    android:id="@+id/ll_room_name3"
                    android:background="@drawable/bg_gradient_black"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/iv_honor3"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="9dp"
                        android:scaleType="fitCenter"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/tv_room_name3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Room Name"
                        android:singleLine="true"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
