<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_bg_dialog_room_quick_recharge"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/color_333333"
        android:gravity="center"
        android:id="@+id/coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:drawablePadding="5.5dp"
        android:drawableStart="@drawable/coin3"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white_"
        android:gravity="center"
        android:id="@+id/money"
        android:background="@drawable/bgs_button_yellow_r360"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:text="$0.99"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/line"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/line_horizontal_1px"/>
</androidx.constraintlayout.widget.ConstraintLayout>
