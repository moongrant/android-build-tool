<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_f5f5f7_top_round_r20"
    android:paddingLeft="16dp"
    android:paddingTop="4dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_333333_45"
        android:id="@+id/tvBalanceTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivBalance"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/coin3"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvBalanceTag"
        app:layout_constraintStart_toEndOf="@+id/tvBalanceTag"
        app:layout_constraintTop_toTopOf="@+id/tvBalanceTag"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/color_333333"
        android:id="@+id/tvBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvBalanceTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ivBalance"
        app:layout_constraintTop_toTopOf="@+id/tvBalanceTag"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/balanceGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvBalanceTag,ivBalance,tvBalance"/>
    <ImageView
        android:id="@+id/firstChargeRewardTop"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_first_charge"
        app:layout_constraintTop_toBottomOf="@+id/tvBalanceTag"/>
    <ImageView
        android:id="@+id/ivWealthBg"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/bg_00ffe8c8_r16"
        app:layout_constraintTop_toBottomOf="@+id/firstChargeRewardTop"/>
    <ImageView
        android:id="@+id/ivWealthTag"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/coin3"
        android:layout_marginStart="16.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWealthBg"
        app:layout_constraintStart_toStartOf="@+id/ivWealthBg"
        app:layout_constraintTop_toTopOf="@+id/ivWealthBg"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/color_ff8b24"
        android:gravity="center_vertical"
        android:id="@+id/tvWealth"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWealthBg"
        app:layout_constraintEnd_toEndOf="@+id/ivWealthBg"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/ivWealthBg"
        app:layout_constraintTop_toTopOf="@+id/ivWealthBg"/>
    <ImageView
        android:id="@+id/ivWealthArrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_arrow_orange"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivWealthBg"
        app:layout_constraintEnd_toEndOf="@+id/ivWealthBg"
        app:layout_constraintTop_toTopOf="@+id/ivWealthBg"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/wealthGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivWealthBg,ivWealthTag,tvWealth,ivWealthArrow"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_333333_65"
        android:id="@+id/tvAreaTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Recharge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivWealthBg"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_333333_65"
        android:gravity="center"
        android:id="@+id/tvArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="3dp"
        android:drawableStart="@drawable/ic_recharge_coin_area"
        app:layout_constraintBottom_toBottomOf="@+id/tvAreaTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvAreaTag"/>
    <com.yalla.yalla.ui.view.StateLayout
        android:id="@+id/stateLayout"
        android:background="@drawable/bg_round_bg_white_r6"
        android:layout_width="380dp"
        android:layout_height="216dp"
        android:layout_marginTop="12dp"
        android:minHeight="236dp"
        android:layout_weight="1"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/tvHelp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAreaTag">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.yalla.yalla.ui.view.StateLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_333333_45"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/payment_encountered_problems"
        android:drawablePadding="8dp"
        android:drawableEnd="@drawable/icon_google_play_details_enter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stateLayout"/>
    <ImageView
        android:id="@+id/firstChargeReward"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_first_charge"
        android:layout_weight="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHelp"/>
    <View
        android:id="@+id/bottomView"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/firstChargeReward"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/rec_color_00D8C9"
        android:id="@+id/tvMinWidth"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
