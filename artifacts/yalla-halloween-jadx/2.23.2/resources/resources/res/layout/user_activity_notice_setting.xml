<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <include layout="@layout/base_header_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/llPermissionTip"
        android:background="@color/color_white"
        android:layout_width="match_parent"
        android:layout_height="136dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Notice_Setting_disabled_tip"/>
        <com.yalla.support.statebutton.StateButton
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btNotice"
            android:background="@color/color_00d8c9"
            android:layout_width="280dp"
            android:layout_height="45dp"
            android:layout_marginTop="15dp"
            android:foreground="@drawable/ripple_border_round"
            android:text="@string/Notice_Setting_button_enable"
            app:radius="22.5dp"/>
    </LinearLayout>
    <com.yalla.yalla.ui.view.ConfigView
        android:id="@+id/cvFriendRequest"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"/>
    <com.yalla.yalla.ui.view.ConfigView
        android:id="@+id/cvPrivateChat"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:src="@drawable/user_ic_notice_tip"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Notice_Setting_tip"
            android:includeFontPadding="false"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
