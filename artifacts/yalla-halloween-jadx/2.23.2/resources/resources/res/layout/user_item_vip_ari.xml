<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_alpha_87_A1"
        android:gravity="center"
        android:id="@+id/item_aristocracy_tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_aristocracy_iv_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_alpha_38_A3"
        android:gravity="center"
        android:id="@+id/item_aristocracy_tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="11dp"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_aristocracy_tv_title"/>
    <com.yalla.netimage.NetImageView
        android:id="@+id/item_aristocracy_iv_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ripple_borderless"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yalla.yalla.ui.view.DotView
        android:id="@+id/item_aristocracy_dot_view"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        app:isPoint="false"
        app:layout_constraintEnd_toEndOf="@+id/item_aristocracy_iv_icon"
        app:layout_constraintTop_toTopOf="@+id/item_aristocracy_iv_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
