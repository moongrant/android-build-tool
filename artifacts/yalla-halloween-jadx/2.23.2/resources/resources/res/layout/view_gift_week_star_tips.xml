<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@mipmap/view_gift_type_tips_week_bg"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivStart"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/dialog_gift_send_weekly_gifts_star"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.code.android.uikit.marquee.MarqueeText
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="start|center_vertical"
        android:id="@+id/content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/weekly_gifts_new"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="8dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="45dp"/>
    <ImageView
        android:id="@+id/ivEnd"
        android:background="@drawable/bg_ffffffff_r360"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/icon_arrow_right_week"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
