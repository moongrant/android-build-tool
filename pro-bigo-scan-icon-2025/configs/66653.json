            {
              "type": "title",
              "value": "⬆️ANZ Host Auto Rebate ⬆️"
            },
            {
              "type": "sub_title",
              "value": "June's auto reward giveaways continue and level-up! 🥳\n🔥More Chances, Higher Rebate! 🔥 \nGo Live now and unlock Beans Back!\n"
            },
            {
              "type": "text",
              "value": "📅 Event run dates: 6/6-6/19\n"
            },
            {
              "type": "text",
              "value": "⏰ Event run time: 1:00 PM - 4:00 PM AEST"
            },
            {
              "frontTextStyle": "default",
              "frontAlignStyle": "left",
              "type": "text",
              "value": ""
            },
            {
              "frontTextStyle": "default",
              "frontAlignStyle": "left",
              "type": "sub_title",
              "value": "🟡 Rewards Structure "
            },
            {
              "frontAlignStyle": "left",
              "frontTextStyle": "default",
              "type": "text",
              "value": "Level 1: if 800 beans received, get 200 beans reward;\n\nLevel 2: if 1,500 beans received, get extra 200 beans;\n\nLevel 3: if 2,500 beans received, get extra 350 beans;\n\nLevel 4: if 3,600 beans received, get extra 350 beans;\n\nLevel 5: if 4,800 beans received, get extra 400 beans;\n\nLevel 6: if 6,000 beans received, get extra 400 beans;\n\nLevel 7: if 9,000 beans received, get extra 1,000 beans;\n\nLevel 8: if 12,000 beans received, get extra 1,000 beans;\n\nLevel 9: if 16,000 beans received, get extra 1,300 beans;\n\nLevel 10: if 21,000 beans received, get extra 1,800 beans;\n\nThe maximum you can get is 7000 beans!"
            },
            {
              "frontAlignStyle": "left",
              "frontTextStyle": "default",
              "type": "sub_title",
              "value": "💃 Go live in Solo or Multiguest Room as a host at least 20 mins within the hour, and you can do all event formats you like!"
            }
          ]
