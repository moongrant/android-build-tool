<!DOCTYPE html><html lang=""><head><meta charset="utf-8"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><meta http-equiv="x-dns-prefetch-control" content="on"><link rel="dns-prefetch" href="//activity2.yalla.live"><link rel="preconnect" href="//activity2.yalla.live"><title></title><style>@-webkit-keyframes test_anim {
      0% {
        background-position: 0 0;
      }

      100% {
        background-position: -2250px 0;
      }
    }

    @keyframes test_anim {
      0% {
        background-position: 0 0;
      }

      100% {
        background-position: -2250px 0;
      }
    }

    #loadingGif {
      width: 75px;
      height: 45px;
      display: block;
      background-image: url('https://file.yalla.live/h5activity/loading.png');
      background-size: 2250px 45px;
      background-repeat: no-repeat;
      -webkit-animation: test_anim 1.2s steps(30) both infinite;
      animation: test_anim 1.2s steps(30) both infinite;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      margin: auto;
      z-index: 10000;
    }

    #finishToast {
      position: fixed;
      width: 100%;
      height: 100%;
      overflow: hidden;
      display: none;
      z-index: 100000;
      background: #fff;
    }

    .xiaoma {
      width: 30%;
      margin: 200px auto 10px;
    }

    #tips1 {
      font-size: 18px;
      color: #666;
      text-align: center;
      padding: 0 10px;
